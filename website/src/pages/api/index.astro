---
// The API reference: the pages `burdin doc` generates for the standard library and each official
// package (scripts/build-api-docs.mjs writes them to public/api/). This page only lists them. The
// packages and their one-line descriptions are read from the repository at build time, so a new
// package appears here without an edit.
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { join, resolve } from 'node:path';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

// Astro runs from the website directory (bun dev, bun run build), and bundles this file, so paths
// are resolved from there rather than from this file.
const site = process.cwd();
const generated = (name: string) => existsSync(join(site, 'public', 'api', name, 'index.html'));

/** The first sentence of a package README's first paragraph, without its issue and spec references. */
function summary(readme: string): string {
	const paragraph = readme
		.split(/\r?\n\r?\n/)
		.map((p) => p.trim())
		.find((p) => p && !p.startsWith('#'));
	if (!paragraph) return '';
	const text = paragraph
		.replace(/\s+/g, ' ')
		.replace(/\s*\([^()]*(?:issue|spec\/)[^()]*\)/g, '')
		.replace(/\s+([.,:;])/g, '$1');
	const end = text.search(/\.(\s|$)/);
	return end === -1 ? text : text.slice(0, end + 1);
}

const packagesDir = resolve(site, '..', 'packages');
const packages = readdirSync(packagesDir, { withFileTypes: true })
	.filter((e) => e.isDirectory() && existsSync(join(packagesDir, e.name, 'burdin.toml')))
	.map((e) => {
		const readme = join(packagesDir, e.name, 'README.md');
		return {
			name: e.name,
			summary: existsSync(readme) ? summary(readFileSync(readme, 'utf8')) : '',
			href: generated(e.name) ? `/api/${e.name}/index.html` : null,
		};
	})
	.sort((a, b) => a.name.localeCompare(b.name));

const stdHref = generated('std') ? '/api/std/index.html' : null;
const missing = packages.some((p) => !p.href);

/** Backticks in a summary become code. The text is escaped first, so a summary cannot add markup. */
const inline = (text: string) =>
	text
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/`([^`]+)`/g, '<code>$1</code>');
---

<StarlightPage
	frontmatter={{
		title: 'API reference',
		description: 'Every public type, function, and interface of the standard library and the official packages, generated by burdin doc.',
	}}
>
	<p>
		These pages are generated by <code>burdin doc</code> from the doc comments in the source, so they list every public
		item with its exact signature. Each site has its own search.
	</p>

	<h2 id="std">Standard library</h2>
	<div class="entries not-content">
		<a class="entry" href={stdHref ?? '/reference/standard-library/'}>
			<span class="name">std</span>
			<span class="summary">
				Strings, collections, I/O, files, tasks, channels, and the core interfaces. Built into every program.
			</span>
			{!stdHref && <span class="pending">Generated pages are not available yet. This link opens the guide's map of the library.</span>}
		</a>
	</div>

	<h2 id="packages">Official packages</h2>
	<p>
		They ship with the compiler. Add one with <code>burdin add &lt;name&gt;</code>, or with <code>name = true</code> under
		<code>[dependencies]</code>, then <code>use</code> it.
	</p>
	<div class="entries not-content">
		{
			packages.map((p) =>
				p.href ? (
					<a class="entry" href={p.href}>
						<span class="name">{p.name}</span>
						<span class="summary" set:html={inline(p.summary)} />
					</a>
				) : (
					<div class="entry">
						<span class="name">{p.name}</span>
						<span class="summary" set:html={inline(p.summary)} />
						<span class="pending">Not generated in this build.</span>
					</div>
				),
			)
		}
	</div>

	{
		missing && (
			<p class="note">
				Some pages are missing from this build. Run <code>bun run api-docs</code> with <code>burdin</code> on the{' '}
				<code>PATH</code>, then rebuild.
			</p>
		)
	}
</StarlightPage>

<style>
	.entries {
		display: grid;
		margin: 1rem 0 0;
		border-top: 1px solid var(--sl-color-hairline-light);
	}

	.entry {
		display: grid;
		grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
		gap: 0.25rem 1.25rem;
		padding: 0.85rem 0.25rem;
		border-bottom: 1px solid var(--sl-color-hairline-light);
		text-decoration: none;
		color: var(--sl-color-gray-2);
	}

	a.entry:hover .name {
		text-decoration: underline;
		text-decoration-color: var(--burdin-oxide);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 0.25em;
	}

	.name {
		font-family: var(--sl-font-mono);
		font-variant-ligatures: none;
		color: var(--sl-color-white);
	}

	.summary :global(code) {
		padding: 0.1em 0.3em;
		border-radius: 2px;
		font-size: 0.9em;
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}

	.pending {
		grid-column: 2;
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
	}

	@media (max-width: 36rem) {
		.entry {
			grid-template-columns: minmax(0, 1fr);
		}

		.pending {
			grid-column: 1;
		}
	}

	.note {
		font-size: 0.9rem;
		color: var(--sl-color-gray-3);
	}
</style>
