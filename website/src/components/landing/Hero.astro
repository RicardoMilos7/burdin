---
import ProgramPanel from '../examples/ProgramPanel.astro';
import { bySlug, commandFor } from '../../data/examples';

const shapes = bySlug('shapes');
---

<section class="hero">
	<h1>Learn Burdin from programs that run.</h1>
	<p class="lead">
		Burdin is a compiled language with memory safety, no garbage collector, and value semantics. Every example on this
		site is compiled and run when the site is checked, and the output shown is the output the compiler produced.
	</p>
	<div class="actions">
		<a class="button" href="/examples/">Browse the examples</a>
		<a class="button secondary" href="/getting-started/introduction/">Read the docs</a>
		<a class="text-link" href="/getting-started/quickstart/">Start with the quickstart</a>
	</div>
	<p class="note">Burdin is an experiment. It is not meant for production use.</p>
	<div class="program">
		<ProgramPanel file={shapes.file} source={shapes.source} output={shapes.output} command={commandFor(shapes)} />
	</div>
</section>

<style>
	.hero {
		padding: clamp(2.5rem, 7vw, 5.5rem) 0 clamp(3rem, 6vw, 4.5rem);
	}

	h1 {
		max-width: 20ch;
		margin: 0;
		font-family: var(--burdin-display);
		font-weight: 400;
		font-size: clamp(2.1rem, 5.2vw, 3.9rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
	}

	.lead {
		margin: 1.5rem 0 0;
		max-width: 40rem;
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.75rem;
		margin: 2rem 0 0;
	}

	.button {
		display: inline-flex;
		padding: 0.75rem 1.2rem;
		border-radius: 2px;
		font-weight: 500;
		text-decoration: none;
		color: var(--burdin-button-fg);
		background: var(--burdin-button-bg);
	}

	.button:hover {
		background: var(--burdin-oxide);
		color: #111416;
	}

	/* The second button is an outline in the text color, so the examples stay the first choice. */
	.button.secondary {
		color: var(--sl-color-white);
		background: transparent;
		box-shadow: inset 0 0 0 1px var(--sl-color-gray-4);
	}

	.button.secondary:hover {
		color: var(--sl-color-white);
		background: transparent;
		box-shadow: inset 0 0 0 1px var(--sl-color-white);
	}

	.text-link {
		font-weight: 500;
		color: var(--sl-color-white);
		text-decoration: underline;
		text-decoration-color: var(--burdin-oxide);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 0.3em;
	}

	.note {
		margin: 1.25rem 0 3rem;
		font-size: 0.88rem;
		color: var(--sl-color-gray-3);
	}
</style>
