---
import { Code } from '@astrojs/starlight/components';

interface Props {
	/** The program's file name, shown as the source pane's title. */
	file: string;
	source: string;
	output: string;
	/** The command that produced the output, shown above the output. */
	command: string;
	/**
	 * `split` puts the output beside the source on a wide screen (the landing page, which has the
	 * width). `stack` always puts it under the source (the docs column, which is too narrow for two).
	 */
	layout?: 'split' | 'stack';
}

const { file, source, output, command, layout = 'split' } = Astro.props;
---

<div class:list={['program', layout]}>
	<div class="source">
		<Code code={source} lang="burdin" title={file} wrap preserveIndent />
	</div>
	<div class="result">
		<p class="command"><span aria-hidden="true">$</span> {command}</p>
		<div class="output">
			<Code code={output} lang="text" wrap />
		</div>
	</div>
</div>

<style>
	.program {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.25rem;
		align-items: start;
	}

	@media (min-width: 60rem) {
		.program.split {
			grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		}

		/* Beside the source, the output stays in view while the reader scrolls through the code. */
		.program.split .result {
			position: sticky;
			top: calc(var(--sl-nav-height, 4rem) + 1.5rem);
		}
	}

	/* Starlight spaces consecutive blocks in Markdown; inside the panel the grid gap does that. */
	.result,
	.output {
		margin-top: 0 !important;
	}

	.command {
		margin: 0 0 0.6rem;
		font-family: var(--sl-font-mono);
		font-size: 0.82rem;
		color: var(--sl-color-gray-3);
		overflow-wrap: anywhere;
	}

	.command span {
		margin-right: 0.3rem;
		color: var(--sl-color-gray-4);
	}

	/* The output is the one place the oxide appears as a block mark: it is what the program printed. */
	.output {
		border-inline-start: 3px solid var(--burdin-oxide);
	}

	.output :global(.frame),
	.output :global(pre) {
		border-start-start-radius: 0;
		border-end-start-radius: 0;
	}

	.output :global(pre) {
		border-inline-start: 0;
	}
</style>
