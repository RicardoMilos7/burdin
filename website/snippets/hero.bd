enum Shape {
    Circle(f64)
    Rect { w: f64, h: f64 }
}

fn area(s: Shape): f64 {
    match s {
        Shape.Circle(r) => 3.0 * r * r,
        Shape.Rect { w, h } => w * h,
    }
}

fn main() {
    let shapes = [Shape.Circle(1.5), Shape.Rect { w: 3.0, h: 4.0 }]
    for s in shapes {
        println("area: {area(s)}")
    }
}
