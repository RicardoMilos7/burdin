// Shapes share an interface. A generic function accepts any one shape, and a List<any Shape>
// holds shapes of different types side by side.

interface Shape {
    fn area(self): f64
    fn name(self): String
}

struct Circle {
    radius: f64
}

struct Rect {
    w: f64
    h: f64
}

Circle: Shape {
    fn area(self): f64 { 3.14159 * self.radius * self.radius }
    fn name(self): String { String.from("circle") }
}

Rect: Shape {
    fn area(self): f64 { self.w * self.h }
    fn name(self): String { String.from("rect") }
}

fn describe<T: Shape>(shape: T) {
    println("{shape.name()} with area {shape.area():.2}")
}

fn main() {
    describe(Circle { radius: 2.0 })
    describe(Rect { w: 3.0, h: 4.5 })

    let mut shapes = List<any Shape>.new()
    shapes.push(Circle { radius: 1.0 })
    shapes.push(Rect { w: 2.0, h: 2.0 })

    let mut total = 0.0
    for s in shapes {
        total = total + s.area()
    }
    println("total area {total:.3}")
}
