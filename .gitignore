# Rust
/target/
**/*.rs.bk

# Release archives made by tests/build_release.py
/dist/

# Build outputs
*.exe
*.obj
*.o
*.pdb
*.ilk
*.lib
*.ll
!crates/burdin_codegen/src/taskrt/*.ll
*.bc

# Files the tests create in their working directory
burdin_test_*.txt
burdin_word_count.txt

# Inputs found by tests/fuzz.py; commit them under crates/burdin_fuzz/corpus/syntax/ with the fix
/fuzz-out/

# Python bytecode from the test scripts
__pycache__/
*.pyc

# Editors and OS
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Build-script outputs of packages anywhere in the tree
**/target/

# The website (website/): dependencies, the Astro build, and its cache
website/node_modules/
website/dist/
website/.astro/
# The API reference that `bun run api-docs` generates with `burdin doc`
website/public/api/

# Generated by website/scripts/build-reference-pages.mjs
website/src/content/docs/errors/
website/src/content/docs/lints/
