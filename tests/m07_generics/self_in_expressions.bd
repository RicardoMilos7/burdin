//@ run
//> 7
//> 8
//> true
//> 7
//> 9

// `Self` in expressions, struct literals, variant paths, and patterns, including a generic impl (issue #70).

struct Counter {
    n: i32
}

Counter {
    fn new(n: i32): Self {
        Self { n }
    }

    fn bump(mut self) {
        self.n = self.n + 1
    }

    fn value(self): i32 {
        match self {
            Self { n } => n
        }
    }

    fn twin(self): Self {
        Self { n: self.n }
    }
}

enum Flag {
    On
    Off
}

Flag {
    fn on(): Self {
        Self.On
    }

    fn is_on(self): bool {
        match self {
            Self.On => true
            Self.Off => false
        }
    }
}

struct Boxed<T> {
    value: T
}

Boxed<T> {
    fn wrap(value: T): Self {
        Self { value }
    }

    fn unwrap(self): T {
        match self {
            Self { value } => value
        }
    }
}

fn main() {
    let mut c = Counter.new(7)
    println(c.value().to_string())
    c.bump()
    println(c.value().to_string())

    let f = Flag.on()
    println(f.is_on().to_string())

    let t = Counter.new(7).twin()
    println(t.value().to_string())

    let b = Boxed.wrap(9)
    println(b.unwrap().to_string())
}
