//@ compile-fail

// A type parameter list may not repeat a name, in a type, an impl block, a function, a method, or an interface
// method (E0007).

struct Pair<T, T> { //~ E0007
    a: T
}

Pair<T, T> { //~ E0007
    fn first(self): T {
        self.a
    }
}

fn twice<T, T>(x: T): T { //~ E0007
    x
}

interface Pick {
    fn pick<T, T>(self): T //~ E0007
}

fn main() {}
