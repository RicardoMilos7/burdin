//@ run
//> square: 16
//> rect: 10
//> true

interface Shape {
    fn area(self): i32
    fn name(self): str
}

struct Square {
    side: i32
}

struct Rect {
    w: i32
    h: i32
}

Square: Shape {
    fn area(self): i32 { self.side * self.side }
    fn name(self): str { "square" }
}

Rect: Shape {
    fn area(self): i32 { self.w * self.h }
    fn name(self): str { "rect" }
}

fn show_bool(b: bool) {
    if b { println("true") } else { println("false") }
}

fn report<T: Shape>(s: T) {
    let mut line = String.from(s.name())
    line.push_str(": ")
    line.push_str(s.area().to_string())
    println(line)
}

fn bigger<A: Shape, B: Shape>(a: A, b: B): bool {
    a.area() > b.area()
}

fn main() {
    report(Square { side: 4 })
    report(Rect { w: 2, h: 5 })
    show_bool(bigger(Square { side: 2 }, Rect { w: 1, h: 3 }))
}
