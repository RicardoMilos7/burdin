//@ run
//> true
//> true
//> true

// `==`, `<`, and `hash` work on a generic instance when the type parameter's bounds provide them (issue #69).

struct Wrapper<T>: Eq, Ord, Hash {
    value: T
}

fn same<T: Eq>(a: Wrapper<T>, b: Wrapper<T>): bool {
    a == b
}

fn before<T: Ord>(a: Wrapper<T>, b: Wrapper<T>): bool {
    a < b
}

fn same_hash<T: Hash>(a: Wrapper<T>, b: Wrapper<T>): bool {
    a.hash() == b.hash()
}

fn main() {
    let a = Wrapper { value: 1 }
    let b = Wrapper { value: 1 }
    let c = Wrapper { value: 2 }
    println(same(a, b).to_string())
    println(before(a, c).to_string())
    println(same_hash(a, b).to_string())
}
