//@ run
//> 42
//> 8
//> 5
//> 5
//> hello

// A build script runs `burdin bindgen` over a header; the generated module declares a macro constant, a struct, an
// enum, and a C function that links against libc (spec/build-scripts.md, BS7).

use bindings.{ANSWER, MODE_ON, Pair}

fn main() {
    println("{}", ANSWER)
    println("{}", Pair.size())
    println("{}", MODE_ON)
    unsafe {
        let text = CString.from("hello")
        println("{}", bindings.strlen(text.as_ptr()))
        println(CStr.to_string(text.as_ptr()))
    }
}
