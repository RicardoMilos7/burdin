// A dependency's script gets the same arguments and output directory as the entry package's (BS3).

fn main() {
    let args = env.args()
    let out = args[2]
    let source = "const FROM_LIB: i32 = 7\nconst LABEL: str = \"hand\"\n"
    match write_file("{out}/src/extra.bd", source) {
        Result.Ok(_) => {}
        Result.Err(_) => panic("cannot write the generated module"),
    }
}
