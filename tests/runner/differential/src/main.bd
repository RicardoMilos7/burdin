fn main() {}

fn sum_to(n: i32): i32 {
    let mut total = 0
    let mut i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    total
}

test "agreeing ok" [differential] {
    assert_eq(sum_to(10), 55)?
}

test "agreeing error" [differential] {
    assert(false)?
}

// This body depends on `Map` iteration order, which the language leaves unspecified: comptime iterates in
// insertion order and the compiled hash table does not. The two runs therefore disagree, which is exactly the
// divergence `[differential]` exists to catch. The fixture is deliberately nondeterministic; it proves the check
// reports a mismatch instead of passing.
test "diverges on map order" [differential] {
    let mut m = Map<i32, i32>.new()
    m.insert(0, 10)
    m.insert(1, 11)
    m.insert(2, 12)
    m.insert(3, 13)
    m.insert(4, 14)
    m.insert(5, 15)
    let mut expected = 0
    for (k, v) in m {
        assert(k == expected)?
        expected = expected + 1
    }
}
