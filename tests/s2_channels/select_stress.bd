//@ run
//> 3 producers, 3000 values, sum 1501500

// Many selects waiting while producers wake them: a lost wake-up, or a select that misses a change between looking at its
// arms and parking, shows up as a hang. Three producers feed three capacity-1 channels, and one consumer merges them
// (CH10).

fn produce(out: Channel<i32>, count: i32) {
    let mut i = 1
    while i <= count {
        out.send(i)
        i = i + 1
    }
    out.close()
}

fn main() {
    let a = Channel<i32>.bounded(1)
    let b = Channel<i32>.bounded(1)
    let c = Channel<i32>.bounded(1)
    let a_tx = a.clone()
    let b_tx = b.clone()
    let c_tx = c.clone()
    let pa = task.spawn(|| produce(a_tx, 1000))
    let pb = task.spawn(|| produce(b_tx, 1000))
    let pc = task.spawn(|| produce(c_tx, 1000))
    let mut count = 0
    let mut sum = 0
    let mut a_open = true
    let mut b_open = true
    let mut c_open = true
    while a_open || b_open || c_open {
        select {
            x = a.recv() if a_open => match x {
                Some(v) => { count = count + 1; sum = sum + v }
                None => a_open = false,
            }
            y = b.recv() if b_open => match y {
                Some(v) => { count = count + 1; sum = sum + v }
                None => b_open = false,
            }
            z = c.recv() if c_open => match z {
                Some(v) => { count = count + 1; sum = sum + v }
                None => c_open = false,
            }
        }
    }
    pa.join()
    pb.join()
    pc.join()
    println("3 producers, {} values, sum {}", count, sum)
}
