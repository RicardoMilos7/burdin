//@ run
//> 4 producers, 4 consumers, 20000 values, sum 200010000

// Four producers and four consumers share one small channel on four workers. Every value must arrive exactly once: a
// lost wake-up hangs the test, a double delivery or a lost value changes the count or the sum (CH10).

fn main() {
    task.set_workers(4)
    let jobs = Channel<i64>.bounded(3)
    let done = Channel<(i64, i64)>.unbounded()
    let mut producers = List<task.JoinHandle<()>>.new()
    let mut consumers = List<task.JoinHandle<()>>.new()
    let mut p = 0
    while p < 4 {
        let tx = jobs.clone()
        let base = (p * 5000) as i64
        producers.push(task.spawn(|| {
            let mut i: i64 = 1
            while i <= 5000 {
                tx.send(base + i)
                i = i + 1
            }
        }))
        p = p + 1
    }
    let mut c = 0
    while c < 4 {
        let rx = jobs.clone()
        let out = done.clone()
        consumers.push(task.spawn(|| {
            let mut count: i64 = 0
            let mut sum: i64 = 0
            for v in rx {
                count = count + 1
                sum = sum + v
            }
            let _ = out.send((count, sum))
        }))
        c = c + 1
    }
    for h in producers.into_iter() {
        h.join()
    }
    jobs.close()
    for h in consumers.into_iter() {
        h.join()
    }
    let mut count: i64 = 0
    let mut sum: i64 = 0
    let mut k = 0
    while k < 4 {
        let (c_count, c_sum) = done.recv().unwrap()
        count = count + c_count
        sum = sum + c_sum
        k = k + 1
    }
    println("4 producers, 4 consumers, {} values, sum {}", count, sum)
}
