//@ run
//> capacity None
//> len 5
//> 10
//> 20
//> 30
//> 40
//> 50
//> len 0

// An unbounded channel never makes a sender wait, and values come out in the order they went in (CH1, CH2).

fn main() {
    let ch = Channel<i32>.unbounded()
    println("capacity {:?}", ch.capacity())
    let mut i = 1
    while i <= 5 {
        ch.send(i * 10)
        i = i + 1
    }
    println("len {}", ch.len())
    while ch.len() > 0 {
        println("{}", ch.recv().unwrap())
    }
    println("len {}", ch.len())
}
