//@ compile-fail

// The first argument is the receiver, checked against the extension's receiver type: a `String` is not a `Point`
// (EX9, E0003).

struct Point {
    x: i32,
    y: i32,
}

fn Point.manhattan(self): i32 {
    self.x.abs() + self.y.abs()
}

fn main() {
    let s = String.from("x")
    println(Point.manhattan(s).to_string()) //~ E0003
}
