//@ test-compile-fail

// `assert_eq` formats both values, so the test-build assertion needs `Debug` of their type
// (spec/errors.md, ERR9). The missing bound is E0141.

struct Point derives (Eq) {
    x: i32
}

test "no debug" {
    assert_eq(Point { x: 1 }, Point { x: 1 })? //~ E0141
}

fn main() {}
