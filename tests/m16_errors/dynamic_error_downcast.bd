//@ run
//> true
//> wrong
//> cannot read cfg.toml: not found
//> missing key port
//> key port
//> true
//> key y

// A dynamic error keeps the original error boxed, so `is` and `downcast` inspect it (spec/errors.md, ERR4).

error enum ConfigError {
    Missing(String) "missing key {0}"
}

fn into_dynamic(ok: bool): Result<i32> {
    if ok {
        Result.Ok(7)
    } else {
        Result.Err(ConfigError.Missing("port".to_string()))
    }
}

fn main() {
    let io: AnyError = IoError.Read {
        path: "cfg.toml".to_string(),
        kind: IoErrorKind.NotFound,
        os_code: Option.None,
    }
    println("{}", io.is<IoError>())
    match io.downcast<ConfigError>() {
        Option.Some(_) => println("config"),
        Option.None => println("wrong"),
    }

    let io2: AnyError = IoError.Read {
        path: "cfg.toml".to_string(),
        kind: IoErrorKind.NotFound,
        os_code: Option.None,
    }
    match io2.downcast<IoError>() {
        Option.Some(e) => println("{e}"),
        Option.None => println("no"),
    }

    match into_dynamic(false) {
        Result.Ok(_) => println("ok"),
        Result.Err(e) => {
            println("{e}")
            match e.downcast<ConfigError>() {
                Option.Some(ConfigError.Missing(key)) => println("key {key}"),
                Option.Some(_) => println("other"),
                Option.None => println("no"),
            }
        }
    }

    let mut values: List<AnyError> = List<AnyError>.new()
    values.push(ConfigError.Missing("x".to_string()))
    let first = values.pop().unwrap()
    println("{}", first.is<ConfigError>())

    let boxed: AnyError = ConfigError.Missing("y".to_string())
    match boxed.downcast<ConfigError>() {
        Option.Some(ConfigError.Missing(key)) => println("key {key}"),
        _ => println("no"),
    }
}
