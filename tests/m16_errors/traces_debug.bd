//@ run
//@ debug-only
//> frames 2
//> 15:13
//> 15:47

// A debug build records the creation site and the propagation site of a dynamic error
// (spec/errors.md, ERR7). Only the line and column are printed, because the file path is a temporary path.

fn read(): Result<i32, IoError> {
    Err(IoError.Read { path: "cfg.toml".to_string(), kind: IoErrorKind.NotFound, os_code: None })
}

fn load(): Result<i32> {
    let n = read().context("loading settings")?
    Ok(n)
}

fn main() {
    match load() {
        Ok(_) => println("ok"),
        Err(e) => {
            println("frames {}", e.frames.len())
            for f in e.frames {
                println("{f.line}:{f.col}")
            }
        }
    }
}
