//@ run
//@ debug-only
//> frames 2
//> load 17:13
//> load 17:47

// A debug build records the creation site and the propagation site of a dynamic error (spec/errors.md, ERR7),
// and each frame also names the function the error passed through (`spec/debug.md`, DBG3): here the error is
// boxed into the dynamic `AnyError` by `.context` in `load` and propagated by the `?` in `load`, so both frames
// name `load`. Only the line and column are printed as text, because the file path is a temporary path.

fn read(): Result<i32, IoError> {
    Result.Err(IoError.Read { path: "cfg.toml".to_string(), kind: IoErrorKind.NotFound, os_code: Option.None })
}

fn load(): Result<i32> {
    let n = read().context("loading settings")?
    Result.Ok(n)
}

fn main() {
    match load() {
        Result.Ok(_) => println("ok"),
        Result.Err(e) => {
            println("frames {}", e.frames.len())
            for f in e.frames {
                println("{f.func} {f.line}:{f.col}")
            }
        }
    }
}
