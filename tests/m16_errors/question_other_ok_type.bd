//@ run
//> 7 1
//> missing
//> no value
//> no number: cannot read cfg.toml

// `?` unwraps its operand whatever the success type is: only the error side has to fit the enclosing function's
// result. A `Result<usize, E>` can be unwrapped inside a function that returns `Result<(), E>`, and an
// `Option<i32>` inside one that returns `Option<String>`.

fn count(ok: bool): Result<usize, IoError> {
    if ok {
        Ok(7)
    } else {
        Err(IoError.Read { path: String.from("cfg.toml") })
    }
}

fn report(ok: bool): Result<(), IoError> {
    let n = count(ok)?
    println("{} 1", n)
    Ok(())
}

fn describe(text: str): Option<String> {
    let n = text.find_str("=")?
    Some(String.from("found"))
}

fn lookup(opt: Option<i32>): Option<String> {
    let v = opt?
    Some(v.to_string())
}

fn number(ok: bool): Result<String> {
    let n = count(ok).context("no number")?
    Ok(n.to_string())
}

fn main() {
    let _ = report(true)
    match lookup(None) {
        Some(_) => println("unexpected"),
        None => println("missing"),
    }
    match describe("abc") {
        Some(_) => println("unexpected"),
        None => println("no value"),
    }
    match number(false) {
        Ok(_) => println("unexpected"),
        Err(e) => println("{}", e),
    }
}
