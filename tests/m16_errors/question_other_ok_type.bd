//@ run
//> 7 1
//> missing
//> no value
//> no number: cannot read cfg.toml: not found

// `?` unwraps its operand whatever the success type is: only the error side has to fit the enclosing function's
// result. A `Result<usize, E>` can be unwrapped inside a function that returns `Result<(), E>`, and an
// `Option<i32>` inside one that returns `Option<String>`.

fn count(ok: bool): Result<usize, IoError> {
    if ok {
        Result.Ok(7)
    } else {
        Result.Err(IoError.Read { path: String.from("cfg.toml"), kind: IoErrorKind.NotFound, os_code: Option.None })
    }
}

fn report(ok: bool): Result<(), IoError> {
    let n = count(ok)?
    println("{} 1", n)
    Result.Ok(())
}

fn describe(text: str): Option<String> {
    let n = text.find_str("=")?
    Option.Some(String.from("found"))
}

fn lookup(opt: Option<i32>): Option<String> {
    let v = opt?
    Option.Some(v.to_string())
}

fn number(ok: bool): Result<String> {
    let n = count(ok).context("no number")?
    Result.Ok(n.to_string())
}

fn main() {
    let _ = report(true)
    match lookup(Option.None) {
        Option.Some(_) => println("unexpected"),
        Option.None => println("missing"),
    }
    match describe("abc") {
        Option.Some(_) => println("unexpected"),
        Option.None => println("no value"),
    }
    match number(false) {
        Result.Ok(_) => println("unexpected"),
        Result.Err(e) => println("{}", e),
    }
}
