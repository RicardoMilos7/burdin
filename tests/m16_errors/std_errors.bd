//@ run
//> invalid integer
//> true
//> cannot read missing.txt: not found
//> true

// The standard-library errors are real error types with messages (spec/errors.md, ERR10).

fn main() {
    match i32.parse("nope") {
        Result.Ok(n) => println("ok {n}"),
        Result.Err(e) => println("{e}"),
    }
    println("{}", i32.parse("nope").is_err())

    match read_to_string("missing.txt") {
        Result.Ok(text) => println("read {text.len()}"),
        Result.Err(e) => println("{e}"),
    }
    println("{}", read_to_string("missing.txt").is_err())
}
