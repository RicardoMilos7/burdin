// Division and remainder truncate toward zero, including divisors above 2^64, which take the long-division path
// (spec/int128.md, I128-3).

fn main() {
    let a: i128 = -170141183460469231731687303715884105728
    let three: i128 = 3
    println((a / three).to_string())
    println((a % three).to_string())
    let big: i128 = 170141183460469231731687303715884105727
    let d: i128 = 100000000000000000000000000000000000001
    println((big / d).to_string())
    println((big % d).to_string())
    let u: u128 = 340282366920938463463374607431768211455
    let v: u128 = 18446744073709551617
    println((u / v).to_string())
    println((u % v).to_string())
    let w: u128 = 18446744073709551616
    println((u / w).to_string())
    println((u % w).to_string())
    let s: i128 = 7
    let t: i128 = -2
    println((s / t).to_string())
    println((s % t).to_string())
    let n: i128 = -7
    println((n / 2).to_string())
    println((n % 2).to_string())
    println(n.div_euclid(2).to_string())
    println(n.rem_euclid(2).to_string())
}
