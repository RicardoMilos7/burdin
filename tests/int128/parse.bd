//@ run
//> -170141183460469231731687303715884105728
//> 340282366920938463463374607431768211455
//> true
//> true
//> true
//> true
//> true
//> true
//> 0

// `parse` accepts exactly the values of its type: the two ends of each range parse, and one past either end, a
// negative unsigned value, an empty string, and a non-digit are errors (spec/int128.md, I128-6).

fn main() {
    match i128.parse("-170141183460469231731687303715884105728") {
        Ok(v) => println(v.to_string()),
        Err(_) => println("bad"),
    }
    match u128.parse("340282366920938463463374607431768211455") {
        Ok(v) => println(v.to_string()),
        Err(_) => println("bad"),
    }
    println(u128.parse("340282366920938463463374607431768211456").is_err().to_string())
    println(u128.parse("-1").is_err().to_string())
    println(i128.parse("170141183460469231731687303715884105728").is_err().to_string())
    println(i128.parse("-170141183460469231731687303715884105729").is_err().to_string())
    println(i128.parse("").is_err().to_string())
    println(i128.parse("12x").is_err().to_string())
    println(u128.parse("0").unwrap().to_string())
}
