//@ run-abort
//@ debug-only
//@ stderr: attempt to negate with overflow
//> before

// Negating `i128::MIN` has no 128-bit result; it panics in a debug build (spec/int128.md, I128-4).

fn main() {
    let m: i128 = -170141183460469231731687303715884105728
    println("before")
    println((-m).to_string())
    println("after")
}
