//@ run-abort
//@ debug-only
//@ stderr: attempt to subtract with overflow
//> before

// An `i128` subtraction below `i128::MIN` panics in a debug build (spec/int128.md, I128-4).

fn main() {
    let m: i128 = -170141183460469231731687303715884105728
    let one: i128 = 1
    println("before")
    println((m - one).to_string())
    println("after")
}
