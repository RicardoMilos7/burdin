//@ compile-fail

interface Shape {
    fn area(self): i32
}

struct Rect {
    w: i32
    h: i32
}

Rect: Shape {
    fn area(self): i32 {
        self.w * self.h
    }
}

fn make(): impl Shape { //~ E0201
    Rect { w: 1, h: 2 }
}

fn main() {
    let local: impl Shape = Rect { w: 1, h: 1 } //~ E0201
    let _ = make()
    let _ = local
}
