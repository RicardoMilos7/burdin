//@ run
//> 6
//> 9

interface Shape {
    fn area(self): i32
}

struct Rect {
    w: i32
    h: i32
}

Rect: Shape {
    fn area(self): i32 {
        self.w * self.h
    }
}

struct Square {
    side: i32
}

Square: Shape {
    fn area(self): i32 {
        self.side * self.side
    }
}

struct Painter {
    calls: i32
}

Painter {
    fn draw(self, shape: impl Shape): i32 {
        shape.area()
    }
}

fn main() {
    let painter = Painter { calls: 0 }
    println(painter.draw(Rect { w: 2, h: 3 }).to_string())
    println(painter.draw(Square { side: 3 }).to_string())
}
