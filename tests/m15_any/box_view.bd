//@ compile-fail

interface Shown {
    fn show(self): String
}

struct Item {
    v: i32
}

Item: Shown {
    fn show(self): String {
        String.from("item")
    }
}

fn main() {
    let text: str = "hello"
    let boxed: any Shown = text //~ E0120
    let item: any Shown = Item { v: 1 }
    let target = item.downcast<str>() //~ E0120
    let _ = boxed
    let _ = target
}
