//@ compile-fail

interface Shape {
    fn area(self): i32
}

struct Rect {
    w: i32
    h: i32
}

Rect: Shape {
    fn area(self): i32 {
        self.w * self.h
    }
}

fn make(): impl Shape {
    Rect { w: 2, h: 3 }
}

fn main() {
    let r: Rect = make() //~ E0003
    let _ = r
    println("{make().perimeter()}") //~ E0002
    let same = make() == make() //~ E0141
    println("{make()}") //~ E0193
    let _ = same
}
