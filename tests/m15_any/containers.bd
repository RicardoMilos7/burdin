//@ run
//> rect 6
//> circle 9
//> arr rect
//> arr circle

interface Shape {
    fn area(self): i32
    fn name(self): String
}

struct Rect {
    w: i32
    h: i32
}

Rect: Shape {
    fn area(self): i32 {
        self.w * self.h
    }
    fn name(self): String {
        String.from("rect")
    }
}

struct Circle {
    r: i32
}

Circle: Shape {
    fn area(self): i32 {
        self.r * self.r
    }
    fn name(self): String {
        String.from("circle")
    }
}

fn show(shape: any Shape) {
    println("{shape.name()} {shape.area()}")
}

fn main() {
    let mut map: Map<String, any Shape> = Map<String, any Shape>.new()
    map.insert(String.from("r"), Rect { w: 2, h: 3 })
    map.insert(String.from("c"), Circle { r: 3 })
    match map.get(String.from("r")) {
        Some(shape) => show(*shape),
        None => println("none"),
    }
    for (key, shape) in map {
        if key.as_str() == "c" {
            show(shape)
        }
    }
    let arr: [any Shape; 2] = [Rect { w: 2, h: 3 }, Circle { r: 3 }]
    for shape in arr {
        println("arr {shape.name()}")
    }
}
