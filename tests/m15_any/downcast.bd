//@ run
//> rect
//> none
//> true
//> moved 7

interface Named {
    fn label(self): String
}

struct Rect {
    w: i32
    h: i32
}

Rect: Named {
    fn label(self): String {
        String.from("rect")
    }
}

struct Square {
    side: i32
}

Square: Named {
    fn label(self): String {
        String.from("square")
    }
}

fn main() {
    let a: any Named = Rect { w: 1, h: 2 }
    match a.downcast<Rect>() {
        Some(rect) => println(rect.label()),
        None => println("none"),
    }
    let b: any Named = Square { side: 3 }
    match b.downcast<Rect>() {
        Some(rect) => println(rect.label()),
        None => println("none"),
    }
    let c: any Named = Rect { w: 3, h: 4 }
    println(c.is<Rect>().to_string())
    match c.downcast<Rect>() {
        Some(rect) => println("moved {rect.w + rect.h}"),
        None => println("none"),
    }
}
