//@ compile-fail

interface Shape {
    fn area(self): i32
}

struct Rect {
    w: i32
    h: i32
}

Rect: Shape {
    fn area(self): i32 {
        self.w * self.h
    }
}

fn make(): impl Shape {
    Rect { w: 2, h: 3 }
}

fn main() {
    let a = make()
    let b = a
    println("{a.area()} {b.area()}") //~ E0100
}
