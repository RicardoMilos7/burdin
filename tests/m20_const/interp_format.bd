//@ run
//> x=42 y=-7 pi=3.14159 c=z ok=true
//> x=42 y=-7 pi=3.14159 c=z ok=true
//> 0.1 1000000000000000000000 2.5
//> 0.1 1000000000000000000000 2.5
//> [   7] [ff] [3.50]
//> [   7] [ff] [3.50]

// Interpolation, `Display`, and format specifiers run at compile time through the same standard library code, so
// a constant `String` matches the run-time text (spec/const-eval.md, CE1; spec/format.md).

fn text(): String {
    let x = 42
    let y: i64 = -7
    let pi = 3.14159
    let c = 'z'
    let ok = true
    "x={x} y={y} pi={pi} c={c} ok={ok}"
}

fn floats(): String {
    let a = 0.1
    let b = 1e21
    let c: f32 = 2.5
    "{a} {b} {c}"
}

fn specs(): String {
    let n = 7
    let h = 255
    let f = 3.5
    "[{n:4}] [{h:x}] [{f:.2}]"
}

const TEXT: String = text()
const FLOATS: String = floats()
const SPECS: String = specs()

fn main() {
    println(TEXT)
    println(text())
    println(FLOATS)
    println(floats())
    println(SPECS)
    println(specs())
}
