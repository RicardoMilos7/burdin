//@ run
//> 12 12
//> 2 2
//> -1 -1

// `any` values with dynamic dispatch, `Result` with `?`, and integer parsing at compile time (spec/const-eval.md,
// CE1).

interface Area {
    fn area(self): i32
}

struct Square {
    side: i32
}

Square: Area {
    fn area(self): i32 {
        self.side * self.side
    }
}

struct Line {
    len: i32
}

Line: Area {
    fn area(self): i32 {
        0 * self.len
    }
}

fn areas(): i32 {
    let shapes: [any Area; 3] = [Square { side: 2 }, Line { len: 5 }, Square { side: 2 }]
    let mut total = 0
    for s in shapes {
        total = total + s.area()
    }
    total + 4
}

fn parse_sum(a: str, b: str): Result<i32, ParseIntError> {
    let x = i32.parse(a)?
    let y = i32.parse(b)?
    Result.Ok(x + y)
}

fn sum_or(a: str, b: str): i32 {
    match parse_sum(a, b) {
        Result.Ok(v) => v,
        Result.Err(_) => -1,
    }
}

const AREAS: i32 = areas()
const PARSED: i32 = sum_or("1", "1")
const FAILED: i32 = sum_or("1", "x")

fn main() {
    println("{AREAS} {areas()}")
    println("{PARSED} {sum_or("1", "1")}")
    println("{FAILED} {sum_or("1", "x")}")
}
