}

fn write_env(): bool {
    env.set("BURDIN_TEST_ENV_412", "x").is_ok()
}

fn read_dir(): String {
    env.current_dir().unwrap()
}

const A: Option<String> = read_env() //~ E0224
const B: bool = write_env() //~ E0224
