//@ run
//> 00000000 77073096 ee0e612c
//> cbf43926

// The classic CRC-32 lookup table, computed while compiling (spec/const-eval.md, CE2), then used at run time.

fn crc_table(): [u32; 256] {
    let mut table = [0 as u32; 256]
    for n in 0..256 as u32 {
        let mut c = n
        for _ in 0..8 {
            if c & 1 == 1 {
                c = 0xedb88320 ^ (c >> 1)
            } else {
                c = c >> 1
            }
        }
        table[n as usize] = c
    }
    table
}

const CRC_TABLE: [u32; 256] = crc_table()

fn crc32(data: str): u32 {
    let mut crc: u32 = 0xffffffff
    for c in data.chars() {
        let byte = c as u32
        crc = CRC_TABLE[((crc ^ byte) & 0xff) as usize] ^ (crc >> 8)
    }
    crc ^ 0xffffffff
}

fn hex(v: u32): String {
    let digits = "0123456789abcdef"
    let mut out = String.new()
    let mut shift: u32 = 28
    loop {
        let d = ((v >> shift) & 0xf) as usize
        out.push_str(digits[d..d + 1])
        if shift == 0 {
            break
        }
        shift = shift - 4
    }
    out
}

fn main() {
    println("{hex(CRC_TABLE[0])} {hex(CRC_TABLE[1])} {hex(CRC_TABLE[2])}")
    println(hex(crc32("123456789")))
}
