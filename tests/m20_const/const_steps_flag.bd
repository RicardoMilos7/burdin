// The default step budget is large enough for ordinary table-building and recursion (spec/const-eval.md, CE8).

fn fib(n: u64): u64 {
    let mut a: u64 = 0
    let mut b: u64 = 1
    let mut i: u64 = 0
    while i < n {
        let t = a + b
        a = b
        b = t
        i = i + 1
    }
    a
}

const FIB50: u64 = fib(50)

fn main() {
    println("{FIB50}")
}
