//@ run
//> 0 1 4 9 16 25 36 49
//> 8
//> 140

// A `const` initializer is any expression of a materializable type: it can call functions, declare locals, and
// loop, and the result is built into the program (spec/const-eval.md, CE2).

fn squares(): [u32; 8] {
    let mut table = [0 as u32; 8]
    let mut i: usize = 0
    while i < 8 {
        table[i] = (i * i) as u32
        i = i + 1
    }
    table
}

const SQUARES: [u32; 8] = squares()
const SUM: u32 = {
    let mut total: u32 = 0
    for v in SQUARES {
        total = total + v
    }
    total
}

fn main() {
    let mut line = String.new()
    for i in 0..8 as usize {
        if i > 0 {
            line.push_str(" ")
        }
        line.push_str(SQUARES[i].to_string().as_str())
    }
    println(line)
    println("{SQUARES.len()}")
    println("{SUM}")
}
