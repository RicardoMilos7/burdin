//@ compile-fail
//@ stderr: index out of bounds: the index is 5 but the length is 3
//@ stderr: called `unwrap` on a `None` value
//@ stderr: the table is empty

// A panic during constant evaluation is E0222 at the constant, with the panic message (spec/const-eval.md, CE7).

fn pick(i: usize): i32 {
    let xs = [1, 2, 3]
    xs[i]
}

fn first(): i32 {
    let xs: List<i32> = List<i32>.new()
    *xs.last().unwrap()
}

fn check(): i32 {
    panic("the table is empty")
}

const BAD: i32 = pick(5) //~ E0222
const EMPTY: i32 = first() //~ E0222
const MESSAGE: i32 = check() //~ E0222

fn main() {
    println("{BAD} {EMPTY} {MESSAGE}")
}
