//@ run
//> 5
//> 6
//> 60
//> 6
//> 2
//> now a string
//> 1234567890123
//> 10
//> 20

const BASE: i32 = 10
const DOUBLE: i32 = BASE * 2

fn show(n: i32) {
    println(n.to_string())
}

fn main() {
    let x = 5
    show(x)
    let x = x + 1
    show(x)
    {
        let x = x * 10
        show(x)
    }
    show(x)
    let mut count = 0
    count = count + 1
    count = count + 1
    show(count)
    let x = "now a string"
    println(x)
    let y: i64 = 1234567890123
    println(y.to_string())
    show(BASE)
    show(DOUBLE)
}
