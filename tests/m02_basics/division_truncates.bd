//@ run
//> -3
//> -3
//> -1
//> 1
//> 3
//> 1

fn main() {
    println((-7 / 2).to_string())
    println((7 / -2).to_string())
    println((-7 % 2).to_string())
    println((7 % -2).to_string())
    let a: i32 = 7
    let b: i32 = 2
    println((a / b).to_string())
    println((a % b).to_string())
}
