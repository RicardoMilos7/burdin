//@ run-abort
//@ stderr: panic: boom
//@ stderr: stack backtrace:
//@ stderr: panic_backtrace(

// A panic prints a symbolized backtrace after its message, in both profiles. Optimized builds may inline the
// functions around the panic, so this test only requires the trace and a symbolized frame; the names of the
// unoptimized frames are checked by `panic_backtrace_names.bd` (debug-only).

fn innermost(x: i32) {
    if x > 0 {
        panic("boom")
    }
    println("not reached")
}

fn outer() {
    innermost(1)
}

fn main() {
    outer()
}
