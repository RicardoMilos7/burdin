//@ run-abort
//@ stderr: panic: boom
//@ stderr: stack backtrace:
//@ stderr: 0x

// A panic prints a backtrace after its message, in both profiles. Symbolization differs by platform (names on
// ELF and Mach-O, addresses only on Windows without a PDB), and optimized builds may inline the functions around
// the panic, so this test requires the trace and one frame address. `panic_backtrace_names.bd` checks the
// unoptimized frame names (debug-only, not on Windows).

fn innermost(x: i32) {
    if x > 0 {
        panic("boom")
    }
    println("not reached")
}

fn outer() {
    innermost(1)
}

fn main() {
    outer()
}
