//@ run
//> 55
//> 3628800
//> 6
//> 111
//> true
//> false
//> -1
//> 0
//> 1

fn show(n: i32) {
    println(n.to_string())
}

fn show_bool(b: bool) {
    if b { println("true") } else { println("false") }
}

fn fib(n: i32): i32 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn fact(n: i32): i32 {
    if n <= 1 { 1 } else { n * fact(n - 1) }
}

fn gcd(a: i32, b: i32): i32 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn collatz_steps(start: i32): i32 {
    let mut n = start
    let mut steps = 0
    while n != 1 {
        n = if n % 2 == 0 { n / 2 } else { 3 * n + 1 }
        steps = steps + 1
    }
    steps
}

// mutual recursion: is_even uses is_odd, which is declared later
fn is_even(n: i32): bool {
    if n == 0 { true } else { is_odd(n - 1) }
}

fn is_odd(n: i32): bool {
    if n == 0 { false } else { is_even(n - 1) }
}

fn sign(n: i32): i32 {
    if n < 0 { return -1 }
    if n > 0 { return 1 }
    0
}

fn main() {
    show(fib(10))
    show(fact(10))
    show(gcd(48, 18))
    show(collatz_steps(27))
    show_bool(is_even(10))
    show_bool(is_odd(10))
    show(sign(-9))
    show(sign(0))
    show(sign(4))
}
