//@ run
//> negative
//> zero
//> positive
//> 10
//> 1
//> 2
//> 4
//> 5
//> 0
//> 1
//> 2
//> 0
//> 1
//> 2
//> 3
//> 5050
//> big

fn show(n: i32) {
    println(n.to_string())
}

fn classify(n: i32): str {
    if n < 0 { "negative" } else if n == 0 { "zero" } else { "positive" }
}

fn main() {
    println(classify(-5))
    println(classify(0))
    println(classify(9))

    let mut i = 0
    let mut sum = 0
    while i < 5 {
        sum = sum + i
        i = i + 1
    }
    show(sum)

    let mut n = 0
    loop {
        n = n + 1
        if n == 3 { continue }
        if n > 5 { break }
        show(n)
    }

    for k in 0..3 {
        show(k)
    }
    for k in 0..=3 {
        show(k)
    }

    let mut total = 0
    for k in 1..=100 {
        total = total + k
    }
    show(total)
    let label = if total > 5000 { "big" } else { "small" }
    println(label)
}
