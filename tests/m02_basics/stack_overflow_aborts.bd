//@ run-abort
//@ stderr: panic: stack overflow

// The main thread has a signal/exception guard: unbounded recursion ends with a clear message instead of a raw
// fault. The frame is small enough that a million frames overrun the 8 MiB default stack.

fn down(n: i32): i32 {
    if n == 0 { 0 } else { 1 + down(n - 1) }
}

fn main() {
    println(down(1000000).to_string())
}
