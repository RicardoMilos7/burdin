//@ run-abort
//@ stderr: panic: stack overflow
//@ skip-sanitize: address leak thread

// The main thread has a signal/exception guard: unbounded recursion ends with a clear message instead of a raw
// fault. The frame is small enough that a million frames overrun the 8 MiB default stack. Dividing the recursive
// result keeps the release optimizer from turning the accumulator into a loop, so the test still recurses at -O2.

fn down(n: i32): i32 {
    if n == 0 { 0 } else { down(n - 1) / 2 + n }
}

fn main() {
    println(down(1000000).to_string())
}
