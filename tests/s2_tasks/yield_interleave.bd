//@ run
//> A1
//> B1
//> A2
//> B2
//> A3
//> B3
//> done

// `yield` gives the worker to another task. With one worker the two tasks take turns, because a task that yields goes
// to the back of the line. The parent starts both tasks from inside a task so that neither can begin before the other
// exists (spec/tasks.md, TK6).

fn runner(name: str): i32 {
    let mut i = 1
    while i <= 3 {
        println("{}{}", name, i)
        task.yield()
        i = i + 1
    }
    i
}

fn main() {
    task.set_workers(1)
    let parent = task.spawn(|| {
        let a = task.spawn(|| runner("A"))
        let b = task.spawn(|| runner("B"))
        a.join() + b.join()
    })
    let _ = parent.join()
    println("done")
}
