// Two tasks run and each returns a value through its handle. `join` waits for the task and hands back its result;
// the order of the two joins is the order the program prints in, whichever task finished first (spec/tasks.md, TK1).

fn sum_to(n: i32): i32 {
    let mut total = 0
    let mut i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    total
}

fn main() {
    let a = task.spawn(|| sum_to(100))
    let b = task.spawn(|| sum_to(200))
    println("{} {}", a.join(), b.join())
    let c = task.spawn(|| 1 + 2)
    println("{}", c.join())
}
