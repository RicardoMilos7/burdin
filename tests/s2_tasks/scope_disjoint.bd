//@ run
//> 11 22 7
//> 5 42

// Scoped tasks may borrow places of the code around the scope, because `scope` waits for them. Each task here borrows
// a different variable, so the borrows are disjoint; the read-only `base` is shared by all of them. When the scope
// returns, the writes are visible and the borrows are over (spec/tasks.md, TK7).

fn main() {
    let base = 7
    let mut a = 1
    let mut b = 2
    scope(|s| {
        s.spawn(|| { a = a + 10 })
        s.spawn(|| { b = b + 20 })
        s.spawn(|| { println_base(base) })
    })
    println("{} {} {}", a, b, base)

    let mut c = 0
    let r = scope(|s| {
        s.spawn(|| { c = 5 })
        42
    })
    println("{} {}", c, r)
}

fn println_base(base: i32) {
    // Only reads, and prints nothing that depends on timing.
    if base != 7 {
        panic("the shared value changed")
    }
}
