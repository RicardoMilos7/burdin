//@ run
//> 0 0 0 false true None None
//> 1 true true Some(42)
//> [42]
//> 7

// Empty and single-item pipelines, and one below the chunk threshold: no task starts, and the answers are the
// sequential ones (spec/parallel.md, PR4).

fn main() {
    let empty = List<i64>.new()
    let zero: i64 = 0
    println(
        "{} {} {} {} {} {:?} {:?}",
        empty.par_iter().count(),
        empty.par_iter().fold(zero, |a, x| a + *x, |a, b| a + b),
        empty.par_iter().map(|x| *x).collect().len(),
        empty.par_iter().any(|x| *x > 0),
        empty.par_iter().all(|x| *x > 0),
        empty.par_iter().map(|x| *x).find(|x| *x > 0),
        empty.par_iter().map(|x| *x).max_by_key(|x| *x),
    )
    let mut one = List<i64>.new()
    one.push(42)
    println(
        "{} {} {} {:?}",
        one.par_iter().count(),
        one.par_iter().any(|x| *x == 42),
        one.par_iter().all(|x| *x == 42),
        one.par_iter().map(|x| *x).find(|x| *x == 42),
    )
    println("{:?}", one.par_iter().map(|x| *x).collect())
    let few = par_range(0, 5).map(|x| x + 1).reduce(|| 0, |a, b| a + b) - 8
    println("{}", few)
}
