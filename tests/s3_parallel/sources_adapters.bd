//@ run
//> 10000
//> 0
//> [10, 11, 12, 13, 14]
//> [5, 6, 7]
//> 24495100
//> 3000 2999
//> 10890
//> Some(19999)
//> Some(0)
//> Some(7)
//> Some(25)

// Sources and adapters: `par_range`, `skip`/`take` in either order, `enumerate`, `map` to owned items, `par_into_iter`
// moving strings out of a list, and the order-dependent consumers (spec/parallel.md, PR2, PR5).

fn main() {
    println("{}", par_range(0, 10000).map(|x| x * 2).count())
    println("{}", par_range(5, 5).count())
    println("{:?}", par_range(0, 5000).skip(10).take(5).collect())
    println("{:?}", par_range(0, 5000).take(8).skip(5).collect())
    println("{}", par_range(100, 5000).enumerate().map(|p| p.0 as i64 + p.1).reduce(|| 0, |a, b| a + b))
    let xs: List<String> = par_range(0, 3000).map(|i| i.to_string()).collect()
    println("{} {}", xs.len(), xs[2999])
    println("{}", xs.par_into_iter().map(|s| s.len()).reduce(|| 0, |a, b| a + b))
    println("{:?}", par_range(0, 20000).max_by_key(|x| *x % 100))
    println("{:?}", par_range(0, 20000).min_by_key(|x| *x % 100))
    println("{:?}", par_range(0, 20000).filter(|x| *x % 7 == 0 && *x > 0).find(|x| *x > 0))
    println("{:?}", par_range(0, 20000).filter_map(|x| if x % 5 == 0 { Option.Some(x / 5) } else { Option.None }).find(|x| *x > 24))
}
