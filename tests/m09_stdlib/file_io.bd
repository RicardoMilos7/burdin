//@ run
//> written
//> 11
//> alpha
//> missing file is an error

fn show(n: i32) {
    println(n.to_string())
}

fn main() {
    let path = "burdin_test_file_io.txt"
    match write_file(path, "alpha\nbeta\n") {
        Result.Ok(_) => println("written"),
        Result.Err(_) => println("write failed"),
    }
    match read_to_string(path) {
        Result.Ok(text) => {
            show(text.len() as i32)       // 11 bytes: no newline translation on Windows
            match text.find('\n') {
                Option.Some(i) => println(text[0..i]),
                Option.None => println("no newline"),
            }
        },
        Result.Err(_) => println("read failed"),
    }
    match read_to_string("definitely_missing_file.bd") {
        Result.Ok(_) => println("unexpected"),
        Result.Err(_) => println("missing file is an error"),
    }
}
