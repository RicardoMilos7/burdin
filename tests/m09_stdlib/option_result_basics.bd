//@ run
//> 2
//> 1
//> 100
//> 0
//> 1
//> true
//> true
//> 5
//> div by zero
//> -1
//> 3

enum MathError: Copy, Clone, Eq {
    DivideByZero
    Negative
}

fn show(n: i32) {
    println(n.to_string())
}

fn show_bool(b: bool) {
    if b { println("true") } else { println("false") }
}

fn find_index(xs: [i32], target: i32): Option<usize> {
    for i in 0..xs.len() {
        if xs[i] == target { return Option.Some(i) }
    }
    Option.None
}

fn safe_div(a: i32, b: i32): Result<i32, MathError> {
    if b == 0 { Result.Err(MathError.DivideByZero) } else { Result.Ok(a / b) }
}

fn main() {
    let xs = [5, 8, 13]
    let s = xs[0..3]
    match find_index(s, 13) {
        Option.Some(i) => show(i as i32),
        Option.None => println("none"),
    }
    let a = find_index(s, 8) orelse 100
    let b = find_index(s, 9) orelse 100
    show(a as i32)
    show(b as i32)
    show(find_index(s, 5).unwrap() as i32)
    show(find_index(s, 8).expect("present") as i32)
    show_bool(find_index(s, 5).is_some())
    show_bool(find_index(s, 6).is_none())

    match safe_div(10, 2) {
        Result.Ok(v) => show(v),
        Result.Err(_) => println("error"),
    }
    match safe_div(1, 0) {
        Result.Ok(v) => show(v),
        Result.Err(MathError.DivideByZero) => println("div by zero"),
        Result.Err(_) => println("other"),
    }
    let v = safe_div(7, 0) orelse -1
    show(v)
    show(safe_div(9, 3).unwrap())
}
