//> server: client ended cleanly
//> mutual without a certificate: rejected
//> server: handshake failed
//> mutual with an untrusted certificate: rejected
//> server: handshake failed
//> == the end of a stream (TLS5)
//> close_notify: read 7 bytes "goodbye", then 0 and 0
//> server: handshake ok version=TLSv1.3 sni=localhost peer=-
//> truncation: read 7 bytes "partial"
//> truncation: then UnexpectedEof (the connection closed without a TLS close_notify (the data may be truncated))
//> truncation: and then Closed
//> server: handshake ok version=TLSv1.3 sni=localhost peer=-
//> close: ok
//> write after close: Closed
//> read after close: Closed
//> close twice: true
//> server: handshake ok version=TLSv1.3 sni=localhost peer=-
//> server: client ended cleanly
//> == bad peers (TLS6)
//> plain-text peer with a reply: Handshake
//> plain peer that closes: UnexpectedEof (the connection closed without a TLS close_notify (the data may be truncated))
//> garbage record: Handshake
//> silent peer: Io timeout=true
//> read timeout: Io timeout=true
//> after the timeout: read 4 bytes "late"
//> Read: 3 bytes, then UnexpectedEof
//> server: handshake ok version=TLSv1.3 sni=localhost peer=-

// The `tls` package over OpenSSL 3 (issue #262; spec/tls.md, TLS3 to TLS6). `loading` builds certificates, keys, trust
// stores, and configurations; `handshake` connects a client and a server in this process over 127.0.0.1.

use handshake
use loading

fn main() {
    task.set_workers(4)
    let args = env.args()
    let only = if args.len() > 1 { args[1].clone() } else { String.new() }
    if only.is_empty() || only.as_str() == "loading" {
        println("== certificates, keys, and configurations (TLS3, TLS4)")
        loading.run()
    }
    if only.as_str() != "loading" {
        let section = if args.len() > 2 { args[2].clone() } else { String.new() }
        handshake.run(section.as_str())
    }
}
