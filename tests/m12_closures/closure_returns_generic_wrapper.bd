//@ run
//> Some(6)
//> None
//> Some(6)

// A closure bound whose return type wraps a type parameter that only the closure determines
// (`F: FnOnce(T): Option<U>`): the closure's body decides `U`.

fn apply<T, U, F: FnOnce(T): Option<U>>(own o: Option<T>, own f: F): Option<U> {
    match o {
        Option.Some(x) => f(x),
        Option.None => Option.None,
    }
}

fn main() {
    let a: Option<i32> = Option.Some(3)
    println("{apply(a, |x| Option.Some(x * 2)):?}")
    println("{apply(a, |x| if x > 5 { Option.Some(x) } else { Option.None }):?}")
    let c = apply(a, |x| {
        let y = x * 2
        Option.Some(y)
    })
    println("{c:?}")
}
