//@ run
//> 16
//> 10
//> 9
//> 11

// A type parameter with an `Fn` bound is monomorphized for the closure's type. A closure passed to it keeps
// its borrow captures (CL9), and an `Fn` value may be called repeatedly.
fn apply<F: Fn(i32): i32>(f: F, x: i32): i32 {
    f(x)
}

fn twice<F: Fn(i32): i32>(f: F, x: i32): i32 {
    f(f(x))
}

fn main() {
    let base = 10
    let add = |x: i32| x + base
    println(apply(add, 6).to_string())
    println(base.to_string())

    println(twice(|x| x + 1, 7).to_string())
    println((twice(add, 8) - 17).to_string())
}
