//@ run
//> both 1 2
//> one 3
//> none

// Array patterns nest with other patterns: here, the elements are options (AP1, AP2). The three arms cover every pair
// of options, so the match is exhaustive.

fn describe(pair: [Option<i32>; 2]) {
    match pair {
        [Option.Some(a), Option.Some(b)] => println("both {a} {b}")
        [Option.Some(a), Option.None] => println("one {a}")
        [Option.None, _] => println("none")
    }
}

fn main() {
    describe([Option.Some(1), Option.Some(2)])
    describe([Option.Some(3), Option.None])
    describe([Option.None, Option.Some(9)])
}
