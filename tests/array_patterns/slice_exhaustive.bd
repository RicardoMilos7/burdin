//@ run
//> none
//> starts 1
//> starts 2

// Two arms cover every slice: the empty one, and every non-empty one through a rest element (AP8).

fn show(xs: [i32]) {
    match xs {
        [] => println("none")
        [x, ..] => println("starts {x}")
    }
}

fn main() {
    let arr = [1, 2]
    show(arr[0..0])
    show(arr[0..2])
    show(arr[1..2])
}
