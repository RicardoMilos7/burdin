//@ compile-fail

// The eager `filter` clones the items it keeps, so the element type must be `Clone` (E0141). The lazy
// `iter().filter` never clones (lazy_no_clone_plain).

struct Plain {
    v: i32
}

fn main() {
    let mut xs = List<Plain>.new()
    xs.push(Plain { v: 1 })
    let kept = xs.filter(|p| p.v > 0) //~ E0141
    println(kept.len().to_string())
}
