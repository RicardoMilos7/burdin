//@ compile-fail

// `map` (both directly on a `List` and through `iter()`) hands its closure the item itself, so `x` is `i32` and `*x`
// is an error (E0003; spec/iterators.md, IT10).

fn main() {
    let mut xs = List<i32>.new()
    xs.push(1)
    let a = xs.map(|x| *x * 2).to_list() //~ E0003
    let b = xs.iter().map(|x| *x * 2).to_list() //~ E0003
    println("{} {}", a.len(), b.len())
}
