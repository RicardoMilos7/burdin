//@ run
//> 2
//> 2
//> 2
//> 2
//> 3
//> 3

// Lazy `filter` and `find` (both directly on a `List` and through `iter()`) keep views and never clone, so a struct
// that is not `Clone` works with them (spec/iterators.md, IT10).
struct Plain {
    v: i32
}

fn main() {
    let mut xs = List<Plain>.new()
    xs.push(Plain { v: 1 })
    xs.push(Plain { v: 2 })
    xs.push(Plain { v: 3 })

    println(xs.filter(|p| p.v > 1).count().to_string())
    println(xs.iter().filter(|p| p.v > 1).count().to_string())

    match xs.find(|p| p.v == 2) {
        Option.Some(p) => println(p.v.to_string()),
        Option.None => println("none"),
    }
    match xs.iter().find(|p| p.v == 2) {
        Option.Some(p) => println(p.v.to_string()),
        Option.None => println("none"),
    }

    let mut kept = 0
    for p in xs.filter(|p| p.v < 3) {
        kept = kept + 1
    }
    println((kept + 1).to_string())

    let mut kept2 = 0
    for p in xs.iter().filter(|p| p.v < 3) {
        kept2 = kept2 + 1
    }
    println((kept2 + 1).to_string())
}
