//@ run
//> 5
//> h
//> é
//> l
//> l
//> o

// `chars()` returns a `List<char>`; its `into_iter()` is an iterator whose `next()` yields one character at a time.
fn main() {
    let mut it = "héllo".chars().into_iter()
    let mut n = 0
    loop {
        match it.next() {
            Option.Some(_) => n = n + 1,
            Option.None => break,
        }
    }
    println(n.to_string())

    let mut chars = "héllo".chars().into_iter()
    loop {
        match chars.next() {
            Option.Some(c) => println(c.to_string()),
            Option.None => break,
        }
    }
}
