//@ run
//> 5
//> h
//> é
//> l
//> l
//> o

// `Chars` is itself an iterator: `next()` decodes one character and advances by its UTF-8 width.
fn main() {
    let mut it = "héllo".chars()
    let mut n = 0
    loop {
        match it.next() {
            Some(_) => n = n + 1,
            None => break,
        }
    }
    println(n.to_string())

    let mut chars = "héllo".chars()
    loop {
        match chars.next() {
            Some(c) => println(c.to_string()),
            None => break,
        }
    }
}
