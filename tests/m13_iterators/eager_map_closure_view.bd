//@ compile-fail

// The eager `map` hands its closure a view of each element, so `x` is `&i32` and `x * 2` is an error (E0003).
// The lazy `iter().map` takes the item itself (lazy_map_closure_item).

fn main() {
    let mut xs = List<i32>.new()
    xs.push(1)
    let doubled = xs.map(|x| x * 2) //~ E0003
    println(doubled.len().to_string())
}
