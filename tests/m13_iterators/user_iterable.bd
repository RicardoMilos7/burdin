//@ run
//> 3
//> 2
//> 1
//> 4
//> 3
//> 2
//> 1
//> 8
//> 6
//> 4
//> 2
//> 10

// A user type joins `for` by implementing `Iterable<T>` (with an `iter` method) and `Iterator<T>`.
struct Countdown {
    from: i32
}

Countdown: Iterable<i32> {
    fn iter(self): Countdown {
        Countdown { from: self.from }
    }
}

Countdown: Iterator<i32> {
    fn next(mut self): Option<i32> {
        if self.from <= 0 {
            return None
        }
        let v = self.from
        self.from = v - 1
        Some(v)
    }
}

fn main() {
    for x in (Countdown { from: 3 }) {
        println(x.to_string())
    }

    let c = Countdown { from: 4 }
    for x in c {
        println(x.to_string())
    }

    // The protocol also gives a user iterator the lazy adapters.
    let mut chain = (Countdown { from: 4 }).iter().map(|x| x * 2)
    loop {
        match chain.next() {
            Some(x) => println(x.to_string()),
            None => break,
        }
    }
    println((Countdown { from: 4 }).iter().sum().to_string())
}
