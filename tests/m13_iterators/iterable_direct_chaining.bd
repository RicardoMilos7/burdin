//> 12
//> Some(3)
//> true true
//> 11 22 33
//> [3, 2, 1]
//> 3
//> [2, 3]
//> [10, 20, 30]
//> Some(20)
//> 60
//> [30, 20, 10]
//> 30
//> [20, 40, 60]
//> Some(20)
//> 60
//> [30, 20, 10]
//> 30
//> 33
//> true
//> 33
//> [0, 2, 4, 6]
//> 6
//> Some(3)
//> [3, 2, 1, 0]
//> [4, 3, 2, 1]
//> [6, 4, 2]
//> 6
//> Some(2)
//> [6, 4]
//> [2, 4, 6]

// Direct lazy chaining on every `Iterable` (`List`, `[T]`, `[T; N]`, `Map`, `Range`, `RangeInclusive`, and user
// `Iterable`) without `.iter()`, plus `.into_iter()` for the consuming form (`spec/iterators.md`, IT10).

struct Countdown {
    from: i32
}

struct CountdownIter {
    n: i32
}

CountdownIter: Iterator<i32> {
    fn next(mut self): Option<i32> {
        if self.n <= 0 {
            return Option.None
        }
        let v = self.n
        self.n = self.n - 1
        Option.Some(v)
    }
}

Countdown: Iterable<i32> {}

Countdown {
    fn iter(self): CountdownIter {
        CountdownIter { n: self.from }
    }
}

fn check_slice(s: [i32]) {
    println("{:?}", s.map(|x| x).to_list())
    println("{:?}", s.find(|x| *x == 20))
    println("{}", s.fold(0, |a, x| a + x))
    println("{:?}", s.rev().to_list())
    // Slice's own `last` wins over `Iterator.last` (EX3): returns `Option<&i32>`.
    match s.last() {
        Option.Some(v) => println("{}", *v),
        Option.None => println("none"),
    }
}

fn main() {
    // List<i32>
    let xs = List.from([1, 2, 3])
    let ys = List.from([10, 20, 30])
    println("{:?}", xs.map(|x| x * 2).to_list())
    println("{:?}", xs.map(|x| x * 2).filter(|x| *x > 2).to_list())
    println("{}", xs.map(|x| x * 2).sum())
    println("{:?}", xs.find(|x| *x == 3))
    println("{} {}", xs.any(|x| x == 2), xs.all(|x| x > 0))
    let zipped: List<i32> = xs.zip(ys.iter()).map(|p| p.0 + p.1).collect()
    println("{} {} {}", zipped[0], zipped[1], zipped[2])
    println("{:?}", xs.rev().to_list())
    // `List` was borrowed, not consumed.
    println("{}", xs.len())

    // List<String> (non-Copy): `iter()` yields `&String`.
    let mut words = List<String>.new()
    words.push(String.from("a"))
    words.push(String.from("bb"))
    words.push(String.from("ccc"))
    println("{:?}", words.map(|w| w.len()).filter(|n| *n > 1).to_list())

    // Slice [i32]
    let arr = [10, 20, 30]
    check_slice(arr[0..3])

    // Array [i32; 3]
    println("{:?}", arr.map(|x| x * 2).to_list())
    println("{:?}", arr.find(|x| *x == 20))
    println("{}", arr.fold(0, |a, x| a + x))
    println("{:?}", arr.rev().to_list())
    // Array delegates to slice's own `last` (EX3): returns `Option<&i32>`.
    match arr.last() {
        Option.Some(v) => println("{}", *v),
        Option.None => println("none"),
    }

    // Map<i32, i32>
    let mut m = Map<i32, i32>.new()
    m.insert(1, 10)
    m.insert(2, 20)
    println("{}", m.map(|p| *p.0 + *p.1).sum())
    println("{}", m.find(|p| *p.0 == 2).is_some())
    println("{}", m.fold(0, |acc, p| acc + *p.0 + *p.1))

    // Range and RangeInclusive
    println("{:?}", (0..4).map(|x| x * 2).to_list())
    println("{}", (1..4).filter(|x| *x > 0).sum())
    println("{:?}", (1..5).find(|x| *x == 3))
    let mut rev_r = List<i32>.new()
    for x in (0..4).rev() {
        rev_r.push(x)
    }
    println("{:?}", rev_r)
    println("{:?}", (1..=4).rev().to_list())

    // User Iterable
    let cd = Countdown { from: 3 }
    println("{:?}", cd.map(|x| x * 2).to_list())
    println("{}", cd.fold(0, |a, x| a + x))
    println("{:?}", cd.find(|x| *x == 2))
    println("{:?}", cd.filter(|x| *x > 1).map(|x| x * 2).to_list())

    // Consuming form stays `.into_iter()`
    println("{:?}", xs.into_iter().map(|x| x * 2).to_list())
}
