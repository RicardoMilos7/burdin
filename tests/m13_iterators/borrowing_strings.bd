//@ run
//> a
//> bb
//> 3

// A borrowing collection yields a view of a non-`Copy` element, and `into_iter` moves it out.
fn main() {
    let mut xs = List<String>.new()
    xs.push(String.from("a"))
    xs.push(String.from("bb"))
    for s in xs.iter() {
        println(s.as_str())
    }
    let mut n: usize = 0
    for s in xs.into_iter() {
        n = n + s.len()
    }
    println(n.to_string())
}
