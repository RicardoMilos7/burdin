//@ run
//> 2
//> 4
//> 6
//> 2
//> 4
//> 6
//> 2
//> 3
//> 2
//> 3
//> 6
//> 6
//> true
//> true
//> 3
//> 3

// Direct adapters on a `List` (`xs.map(f)`) and explicit `xs.iter().map(f)` have the same lazy meaning and yield
// the same items; `to_list()` collects the eager `List` result (spec/iterators.md, IT10).
fn show(xs: List<i32>) {
    for x in xs {
        println(x.to_string())
    }
}

fn main() {
    let mut xs = List<i32>.new()
    xs.push(1)
    xs.push(2)
    xs.push(3)

    show(xs.map(|x| x * 2).to_list())
    show(xs.iter().map(|x| x * 2).to_list())

    show(xs.filter(|x| *x > 1).to_list())
    show(xs.iter().filter(|x| *x > 1).to_list())

    println(xs.fold(0, |acc, x| acc + x).to_string())
    println(xs.iter().fold(0, |acc, x| acc + x).to_string())

    println(xs.any(|x| x == 2).to_string())
    println(xs.iter().any(|x| x == 2).to_string())

    match xs.find(|x| *x == 3) {
        Option.Some(v) => println(v.to_string()),
        Option.None => println("none"),
    }
    match xs.iter().find(|x| *x == 3) {
        Option.Some(v) => println(v.to_string()),
        Option.None => println("none"),
    }
}
