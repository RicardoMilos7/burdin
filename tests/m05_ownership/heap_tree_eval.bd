//@ run
//> -10
//> 1000

enum Expr {
    Num(i32)
    Add(Heap<Expr>, Heap<Expr>)
    Mul(Heap<Expr>, Heap<Expr>)
    Neg(Heap<Expr>)
}

fn show(n: i32) {
    println(n.to_string())
}

fn eval(e: Expr): i32 {
    match e {
        Expr.Num(n) => n,
        Expr.Add(a, b) => eval(*a) + eval(*b),
        Expr.Mul(a, b) => eval(*a) * eval(*b),
        Expr.Neg(a) => -eval(*a),
    }
}

fn main() {
    // 2 + 3 * -4
    let e = Expr.Add(
        Heap.new(Expr.Num(2)),
        Heap.new(Expr.Mul(
            Heap.new(Expr.Num(3)),
            Heap.new(Expr.Neg(Heap.new(Expr.Num(4))))
        ))
    )
    show(eval(e))

    // a deep chain built in a loop: acc is moved into the new node and reassigned
    let mut acc = Expr.Num(0)
    for _ in 0..1000 {
        acc = Expr.Add(Heap.new(acc), Heap.new(Expr.Num(1)))
    }
    show(eval(acc))
}
