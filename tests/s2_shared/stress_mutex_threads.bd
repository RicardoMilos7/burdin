//@ run
//> 4 tasks and 4 threads x 1500 increments: 12000

// Tasks and operating-system threads contend for one mutex (spec/shared.md, SH9): a waiting task parks and a waiting
// thread blocks, and the one that releases the lock wakes both kinds. A wake-up that reached only one kind would hang the
// test. The threads do not yield; the tasks do, inside the lock.

fn main() {
    task.set_workers(3)
    let counter = Shared.new(Mutex.new(0))
    let mut tasks = List<task.JoinHandle<()>>.new()
    let mut threads = List<thread.Thread<()>>.new()
    let mut t = 0
    while t < 4 {
        let for_task = counter.clone()
        tasks.push(task.spawn(|| {
            let mut i = 0
            while i < 1500 {
                for_task.get().lock(|n| {
                    let seen = *n
                    if i % 9 == 0 {
                        task.yield()
                    }
                    *n = seen + 1
                })
                i = i + 1
            }
        }))
        let for_thread = counter.clone()
        threads.push(thread.spawn(|| {
            let mut i = 0
            while i < 1500 {
                for_thread.get().lock(|n| { *n = *n + 1 })
                i = i + 1
            }
        }))
        t = t + 1
    }
    for h in tasks.into_iter() {
        h.join()
    }
    for h in threads.into_iter() {
        h.join()
    }
    println("4 tasks and 4 threads x 1500 increments: {}", counter.get().lock(|n| *n))
}
