//@ compile-fail

// The constant interpreter models containers but not allocation with an explicit allocator: `new_in` is an
// impure operation there (E0224, `spec/allocators.md` AL10).

const N: usize = { //~ E0224
    let xs = List<i32>.new_in(Global { })
    xs.len()
}

fn main() {
    println(N.to_string())
}
