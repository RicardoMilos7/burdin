//@ run
//> 4

// The compile-time interpreter models a `Shared<T>` as the value it holds; a comptime expression may create,
// clone, and read one as long as the result itself can be materialized (`spec/allocators.md`, AL10).

const N: i32 = comptime {
    let s = Shared.new(3)
    let t = s.clone()
    *t.get() + 1
}

fn main() {
    println(N.to_string())
}
