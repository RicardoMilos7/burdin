//@ run
//> 4950
//> 100

// Growing an arena-backed list past its first buffer calls the arena's `reallocate`, which copies the elements
// into fresh arena memory (`spec/allocators.md`, AL6-AL7).

fn main() {
    let mut xs = List<i32>.new_in(Arena.new())
    let mut i = 0
    while i < 100 {
        xs.push(i)
        i = i + 1
    }
    let mut sum = 0
    for x in xs.iter() {
        sum = sum + x
    }
    println(sum.to_string())
    println(xs.len().to_string())
}
