//@ compile-fail

// A generator may not call a function that another generator declares: the first generator's text is not visible
// while generation runs, so the reference is E0002 and generation stops (spec/generate.md, GN3, GN5, GN7).

comptime generate {
    String.from("fn first(): i32 {{ 1 }}\n")
}

comptime generate {
    let x = first() //~ E0002
    String.from("fn second(): i32 {{ 2 }}\n")
}

fn main() {
}
