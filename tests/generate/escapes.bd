//@ run
//> a { b }

// Braces and quotes in the generated text: `{{{{` in a literal is `{{` in the text, which the generated string
// literal then reads as one `{` (spec/generate.md, GN2; spec/format.md FM2).

comptime generate {
    String.from("fn label(): String {{\n    String.from(\"a {{{{ b }}}}\")\n}}\n")
}

fn main() {
    println(label())
}
