//@ run
//> dist2 = 25

// A generated struct and a function that uses it (spec/generate.md, GN1, GN4).

comptime generate {
    String.from("struct Point {{\n    x: i32\n    y: i32\n}}\n\nfn dist2(p: Point): i32 {{\n    p.x * p.x + p.y * p.y\n}}\n")
}

fn main() {
    println(format("dist2 = {}", dist2(Point { x: 3, y: 4 })))
}
