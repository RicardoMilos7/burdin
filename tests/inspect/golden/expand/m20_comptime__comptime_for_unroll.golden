//@ run
//> field 0: 10
//> field 1: 20
//> field 2: 30
//> first
//> 1 then 2
//> 60

// `comptime for` repeats its body once per item in the generated code; each copy's binding is compile-time known
// (spec/comptime.md, CT6).

const WEIGHTS: [i32; 3] = [10, 20, 30]

fn main() {
    {
        let i = (0 as usize)
        { println("field {i}: {(10)}") }
    }
    {
        let i = (1 as usize)
        { println("field {i}: {(20)}") }
    }
    {
        let i = (2 as usize)
        { println("field {i}: {(30)}") }
    }
    {
        let name = "first"
        { println(name) }
    }
    {
        let (a, b) = (1, 2)
        { println("{a} then {b}") }
    }
    let mut total = 0
    {
        let w = 10
        {
            {}
            total = total + w
        }
    }
    {
        let w = 20
        {
            {}
            total = total + w
        }
    }
    {
        let w = 30
        {
            {}
            total = total + w
        }
    }
    println("{total}")
}
