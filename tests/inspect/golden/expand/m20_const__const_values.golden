//@ run
//> 3.5 -2 x true
//> Point(1, 2)
//> Green
//> 2 3 4 | 1 2 3 4
//> Some(7) None
//> Ok(1) Err(oops)
//> burdin 6
//> 42

// Constants of every materializable kind (spec/const-eval.md, CE3, CE2), including constants built from other
// constants.

struct Point: Copy, Clone, Eq {
    x: i32,
    y: i32,
}
// Copy, Clone, Eq: built in; the compiler implements them structurally, so there is no source form

enum Color: Copy, Clone, Eq {
    Red,
    Green,
}
// Copy, Clone, Eq: built in; the compiler implements them structurally, so there is no source form

const F: f64 = 3.5
const I: i8 = -2
const C: char = 'x'
const B: bool = true
const P: Point = Point { x: 1, y: 2 }
const COLOR: Color = Color.Green
const R: Range<i32> = 2..5
const RI: RangeInclusive<i32> = 1..=4
const SOME: Option<i32> = Option.Some(7)
const NONE: Option<i32> = Option.None
const OK: Result<i32, str> = Result.Ok(1)
const ERR: Result<i32, str> = Result.Err("oops")
const NAME: String = String.from("burdin")
const LEN: usize = 6
const ANSWER: (i32, i32) = (42, 0)

fn main() {
    println("{F} {I} {C} {B}")
    println("Point({P.x}, {P.y})")
    match COLOR {
        Color.Red => println("Red"),
        Color.Green => println("Green"),
    }
    let mut line = String.new()
    for v in R {
        line.push_str(v.to_string().as_str())
        line.push_str(" ")
    }
    line.push_str("|")
    for v in RI {
        line.push_str(" ")
        line.push_str(v.to_string().as_str())
    }
    println(line)
    let s = match SOME {
        Option.Some(v) => v.to_string(),
        Option.None => String.from("None"),
    }
    let n = match NONE {
        Option.Some(v) => v.to_string(),
        Option.None => String.from("None"),
    }
    println("Some({s}) {n}")
    let o = match OK {
        Result.Ok(v) => v.to_string(),
        Result.Err(e) => String.from(e),
    }
    let e = match ERR {
        Result.Ok(v) => v.to_string(),
        Result.Err(e) => String.from(e),
    }
    println("Ok({o}) Err({e})")
    println("{NAME} {LEN}")
    println("{ANSWER.0}")
}
