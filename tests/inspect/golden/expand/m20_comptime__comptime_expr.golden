//@ run
//> 6765
//> 89
//> true
//> (3, 4)
//> Some(5)

// `comptime E` evaluates one expression while compiling and puts its value in its place (spec/comptime.md, CT2).
// Each appearance is evaluated once, not each time the surrounding code runs.

fn fib(n: u32): u32 {
    if n < 2 {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

fn main() {
    println("{comptime fib(20)}")
    let mut total: u32 = 0
    for _ in 0..3 {
        total = (89 as u32)
    }
    println("{total}")
    let flag: bool = (5 as u32) == 5
    println("{flag}")
    let pair: (i32, i32) = (3, 4)
    println("({pair.0}, {pair.1})")
    let found: Option<i32> = Some(5)
    match found {
        Some(v) => println("Some({v})"),
        None => println("None"),
    }
}
