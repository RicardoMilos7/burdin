//@ compile-fail

// A const-specific impl covers only its instance (`spec/impls.md`, IM2): `Grid<3>`'s method is not a method of
// `Grid<2>`, so the call on the two-cell grid names an unknown method (E0002).

struct Grid<const N: usize> {
    cells: [i32; N]
}

Grid<3> {
    fn third(self): i32 { self.cells[2] }
}

fn main() {
    let h = Grid { cells: [1, 3] }
    println(h.third().to_string()) //~ E0002
}
