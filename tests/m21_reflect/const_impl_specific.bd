//@ run
//> 9
//> 30

// An impl block can name a const argument, like a literal type argument (`spec/impls.md`, IM1): `Grid<3> { ... }`
// adds a method that only the three-cell grid has, and `Grid<2> { ... }` one that only the two-cell grid has
// (`spec/const-generics.md`, CG8).

struct Grid<const N: usize> {
    cells: [i32; N]
}

Grid<3> {
    fn third(self): i32 { self.cells[2] }
}

Grid<2> {
    fn second_times_ten(self): i32 { self.cells[1] * 10 }
}

fn main() {
    let g = Grid { cells: [7, 8, 9] }
    println(g.third().to_string())
    let h = Grid { cells: [1, 3] }
    println(h.second_times_ten().to_string())
}
