//@ run
//> 3 4
//> 2
//> 0 1
//> 12

// A type alias can have parameters: `Pair<i32>` is the tuple `(i32, i32)` wherever a type is written, aliases can
// name aliases, and a const parameter works too (spec/type-aliases.md, AL1-AL5).

type Pair<T> = (T, T)
type Grid<T, const N: usize> = [T; N]
type Names = List<String>
type Table<V> = Map<String, V>
type Twice<T> = Pair<Pair<T>>

struct Holder<T> {
    pair: Pair<T>
}

fn swap_pair(p: Pair<i32>): Pair<i32> {
    (p.1, p.0)
}

fn first_of<T: Copy>(p: Pair<T>): T {
    p.0
}

fn total(g: Grid<i32, 4>): i32 {
    let mut sum = 0
    for i in 0..g.len() {
        sum = sum + g[i]
    }
    sum
}

fn main() {
    let p: Pair<i32> = (4, 3)
    let s = swap_pair(p)
    println("{} {}", s.0, s.1)

    let h: Holder<i32> = Holder { pair: (2, 5) }
    println("{}", first_of(h.pair))

    let mut table: Table<i32> = Table<i32>.new()
    table.insert(String.from("a"), 1)
    let names: Names = Names.new()
    println("{} {}", names.len(), table.len())

    let t: Twice<i32> = ((1, 2), (3, 4))
    println("{}", total([t.0.0, t.0.1, t.1.0, t.1.1]) + 2)
}
