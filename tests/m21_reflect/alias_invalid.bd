//@ compile-fail

// A generic alias needs the right number of arguments, its bounds hold for them, and it cannot expand into
// itself (spec/type-aliases.md, AL3, AL4). The same holds for an impl block written through an alias (AL5).

type Pair<T> = (T, T)
type Sorted<T: Ord> = List<T>
type Loop<T> = Loop<T> //~ E0009

struct Unordered {
    a: i32
}

fn two(p: Pair<i32, i32>) {} //~ E0003

fn none(p: Pair) {} //~ E0003

fn bound(s: Sorted<Unordered>) {} //~ E0141

fn forever(l: Loop<i32>) {}

struct Stack<T> {
    items: List<T>
}

type Stacked<T> = Stack<T>

Stacked<i32, i32> { //~ E0003
    fn size(self): i32 { 0 }
}

Stacked { //~ E0003
    fn other(self): i32 { 0 }
}

Loop<i32> {
    fn spin(self): i32 { 0 }
}

type Ahead = Behind //~ E0009
type Behind = Ahead

Ahead {
    fn stuck(self): i32 { 0 }
}

// An alias of a tuple is a tuple, and methods cannot be added to one.
Pair<i32> { //~ E0003
    fn sum(self): i32 { self.0 + self.1 }
}

fn main() {}
