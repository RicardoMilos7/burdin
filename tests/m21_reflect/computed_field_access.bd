//@ run
//> 10 20
//> 2 3 4
//> 6

// `x.{name}` is a field access whose name is a compile-time string: it can be read, assigned, and borrowed like the
// field itself, and in a derive body the name comes from `Type.fields` (spec/reflection.md, RFL5).

struct Point {
    x: i32
    y: i32
}

struct Triple {
    a: i32
    b: i32
    c: i32
}

interface Bump {
    fn bump(mut self)
}

derive Bump {
    fn bump(mut self) {
        comptime for field in Self.fields {
            self.{field.name} = self.{field.name} + 1
        }
    }
}

struct Counter derives (Bump) {
    low: i32
    high: i32
}

fn main() {
    let mut p = Point { x: 1, y: 2 }
    p.{"x"} = 10
    let r = &mut p.{"y"}
    *r = 20
    println("{} {}", p.x, p.y)

    let mut t = Triple { a: 1, b: 2, c: 3 }
    let a = t.{"a"} + 1
    println("{} {} {}", a, t.{"b"} + 1, t.{"c"} + 1)

    let mut c = Counter { low: 1, high: 3 }
    c.bump()
    println("{}", c.low + c.high)
}
