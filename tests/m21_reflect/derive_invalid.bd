//@ compile-fail

// A user derive cannot take a built-in derive's name, and `struct T: Name` with a user derive needs the interface
// in scope (spec/reflection.md, RFL8, RFL9).

derive Clone { //~ E0233
    fn clone(self): Self { self }
}

derive Shout {
    fn shout(self): String { String.from("!") }
}

struct Thing: Shout { a: i32 } //~ E0233

fn main() {}
