//@ compile-fail

// A derive on a generic type holds for the instances whose parts allow it: `Wrapper<i32>` is `Eq` and `Clone`
// because `i32` is, and `Wrapper<NoEq>` is neither, so each use of the missing capability is an error at the use
// (spec/impls.md, IM8).

struct Wrapper<T>: Eq, Clone {
    value: T
}

struct NoEq {
    n: i32
}

fn same<T: Eq>(a: T, b: T): bool {
    a == b
}

fn main() {
    let a = Wrapper { value: 1 }
    let b = Wrapper { value: 1 }
    println("{}", a == b)
    println("{}", same(a.clone(), b))

    let c = Wrapper { value: NoEq { n: 1 } }
    let d = Wrapper { value: NoEq { n: 1 } }
    println("{}", c == d) //~ E0003
    println("{}", same(c, d)) //~ E0141
    let e = c.clone() //~ E0002
}
