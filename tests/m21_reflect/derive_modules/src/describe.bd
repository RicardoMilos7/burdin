interface Describe {
    fn describe(self): String
}

derive Describe {
    fn describe(self): String {
        let mut out = String.from(Self.name)
        out.push_str(":")
        for field in Self.fields {
            if field.index > 0 { out.push_str(",") }
            out.push_str(" ")
            out.push_str(field.name)
        }
        out
    }
}
