//@ run
//> 1
//> 3
//> 9
//> 1
//> 3

// A Vec-like type with `+` and `[]` (milestone 19's exit criterion). `Add`, `Index`, and `IndexMut` are ordinary
// interfaces from std, visible through the prelude (spec/operators.md OP1-OP3, OP9-OP10).

struct IntVec {
    items: List<i32>
}

IntVec: Add {
    fn add(self, other: IntVec): IntVec {
        let mut out = IntVec { items: self.items.clone() }
        let mut i: usize = 0
        while i < other.items.len() {
            out.items.push(other.items[i])
            i = i + 1
        }
        out
    }
}

IntVec: Index<i32> {
    fn index(self, i: usize): &i32 {
        &self.items[i]
    }
}

IntVec: IndexMut<i32> {
    fn index_mut(mut self, i: usize): &mut i32 {
        &mut self.items[i]
    }
}

fn main() {
    let mut a = IntVec { items: List<i32>.new() }
    a.items.push(1)
    a.items.push(2)
    let mut b = IntVec { items: List<i32>.new() }
    b.items.push(3)
    let mut c = a + b
    println(c[0].to_string())
    println(c[2].to_string())
    c[1] = 9
    println(c[1].to_string())
    // `+` borrowed both operands, so they are still usable.
    println(a[0].to_string())
    println(b[0].to_string())
}
