// The stage 0 operators are unchanged by milestone 19 (spec/operators.md OP12; issue #155): integers, floats,
// `str`/`String`, tuples, derived structs, shifts, and bool logic.

struct Pair: Eq, Ord {
    a: i32
    b: i32
}

fn show(n: i32) {
    println(n.to_string())
}

fn main() {
    show(2 + 3 * 4)
    show(10 % 3)
    show(-7 / 2)
    show(-7 % 2)
    show(6 & 3)
    show(6 | 3)
    show(6 ^ 3)
    show(1 << 4)
    show(256 >> 2)

    println((1.5 + 2.25).to_string())
    println((3.0 > 2.0).to_string())
    println(("abc" < "abd").to_string())
    println((String.from("abc") == String.from("abc")).to_string())
    println(((1, "a") == (1, "a")).to_string())

    let p = Pair { a: 1, b: 2 }
    println((p == Pair { a: 1, b: 2 }).to_string())
    println((p < Pair { a: 1, b: 3 }).to_string())

    println((true && false).to_string())
    println((true || false).to_string())
    println((!false).to_string())

    let u: u8 = 255
    println((u >> 4).to_string())
}
