//@ compile-fail

// A user type without the operator's interface has no `+=`: the compound form is `a = a + a`, which needs `Add`, so it is
// E0141 (spec/compound-assignment.md, CA5). The built-in forms are in tests/compound_assign/.

struct Counter {
    n: i32
}

fn main() {
    let mut a = Counter { n: 1 }
    a += a //~ E0141
}
