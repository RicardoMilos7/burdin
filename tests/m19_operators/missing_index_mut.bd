//@ compile-fail

// Reading needs only `Index`; writing through the same type needs `IndexMut` (E0141, spec/operators.md OP10).

struct Row {
    cells: [i32; 3]
}

Row: Index<i32> {
    fn index(self, i: usize): &i32 {
        &self.cells[i]
    }
}

fn main() {
    let mut r = Row { cells: [1, 2, 3] }
    let x = r[0]
    println(x.to_string())
    r[0] = 5 //~ E0141
}
