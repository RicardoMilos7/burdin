//@ run
//> true
//> false
//> true
//> true
//> false
//> false

// The stage 0 derive always wins over a hand-written comparison interface (spec/operators.md OP3, OP5): a
// type that derives `Eq`/`Ord` compares structurally even when it also implements `PartialEq`/`PartialOrd`.

struct P derives (Eq, Ord) {
    n: i32
}

P: PartialEq {
    fn eq(self, other: P): bool {
        false
    }
}

P: PartialOrd {
    fn lt(self, other: P): bool {
        false
    }
}

fn main() {
    let a = P { n: 1 }
    let b = P { n: 2 }
    println((a == a).to_string())
    println((a < a).to_string())
    println((a <= a).to_string())
    println((a < b).to_string())
    // The interface methods themselves are ordinary methods and can still be called.
    println(a.eq(a).to_string())
    println(a.lt(a).to_string())
}
