// Code the compiler generates is never linted (spec/lint.md LN11): derived impls, the impls of an `error enum`, the
// type parameter of an `impl` argument, and the wrapper around `test` bodies. Nothing here is
// reported, although the generated names (`impl0`) and statements would break several lints.

interface Shape {
    fn area(self): i32
}

struct Square: Copy, Clone, Eq, Debug {
    side: i32
}

Square: Shape {
    fn area(self): i32 {
        self.side * self.side
    }
}

error enum ConfigError {
    Missing(String) "missing key {0}"
    Invalid(i32) "invalid value {0}"
}

const BUFFER_SIZE: usize = 256


fn total(shape: impl Shape): i32 {
    shape.area()
}

fn lookup(ok: bool): Result<i32> {
    if ok { Ok(1) } else { Err(ConfigError.Missing("port".to_string())) }
}

test "panics at the end" [should_panic] {
    panic("boom")
}

test "returns a value" {
    assert_eq(total(Square { side: 2 }), 4)?
}

fn main() {
    assert(BUFFER_SIZE / 64 == 4)
    let s = Square { side: 3 }
    println("{} {:?} {}", total(s), s, lookup(true).is_ok())
}
