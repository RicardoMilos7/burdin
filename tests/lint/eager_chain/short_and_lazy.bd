// What the eager-chain lint leaves alone (spec/lint.md LN20): a chain of one or two, a lazy chain that starts with
// `.iter()`, and steps separated by `let` so each list is used on its own.

fn main() {
    let xs: List<i32> = [1, 2, 3, 4].iter().to_list()
    let two = xs.map(|x| *x + 1).filter(|x| *x > 1)
    let lazy = xs.iter().map(|x| x + 1).filter(|x| *x > 1).map(|x| x * 2).to_list()
    let first = xs.map(|x| *x + 1)
    let second = first.filter(|x| *x > 1)
    let third = second.map(|x| *x * 2)
    println("{} {} {}", two.len(), lazy.len(), third.len())
    // lint: allow(eager_chain)
    let allowed = xs.map(|x| *x + 1).filter(|x| *x > 1).map(|x| *x * 2)
    println("{}", allowed.len())
}
