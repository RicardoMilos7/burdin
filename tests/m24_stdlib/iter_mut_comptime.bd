//@ compile-fail

// A mutable iterator writes through a view of a run-time collection, so it is impure at compile time (CT9).

const N: i32 = comptime { //~ E0224
    let mut xs = List<i32>.new()
    xs.push(1)
    for x in mut xs {
        *x = 4
    }
    4
}

fn main() {
    println(N.to_string())
}
