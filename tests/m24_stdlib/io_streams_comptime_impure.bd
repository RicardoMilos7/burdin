//@ compile-fail

// The stream handles are impure operations (`spec/comptime.md`, CT9): writing, reading, and asking whether a
// stream is a terminal are all E0224 at the comptime expression.

fn main() {
    comptime { //~ E0224
        stdout().write_text("x")
    }
    comptime { //~ E0224
        let mut input = stdin()
        let line = input.read_line()
    }
}
