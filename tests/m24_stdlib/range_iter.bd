//@ run
//> 10
//> 2
//> 3
//> 4
//> [0, 2, 4, 6]
//> Some(3)
//> Some(1)
//> 253
//> 254
//> 255
//> Some(255)
//> Some(0)
//> true
//> false

// `Range`, `RangeInclusive`, and their iterators are structs in `std`: a range walks without overflowing at the top
// of its integer type, walks from both ends, and is `Copy`, `Clone`, and `Eq`.

fn main() {
    let mut total = 0
    for i in 0..5 {
        total += i
    }
    println("{total}")
    let r = 2..=4
    for (i) in r {
        println("{i}")
    }
    let v = (0..4).iter().map(|x| x * 2).collect<List<i32>>()
    println("{v:?}")
    let mut it = (1..=3).iter()
    println("{it.next_back():?}")
    println("{it.next():?}")
    let top: u8 = 255
    for x in (253..=top).iter() {
        println("{x}")
    }
    let mut e = (0..=top).iter()
    println("{e.next_back():?}")
    println("{e.next():?}")
    let a = 1..3
    let b = a
    println("{a == b}")
    let c = 1..4
    println("{a == c}")
}
