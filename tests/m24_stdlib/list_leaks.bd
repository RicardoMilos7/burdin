//@ burdin-test passed=7 failed=0

// A `burdin test` build allocates through a checking allocator (`spec/allocators.md`, AL9): a buffer or an element
// that any of the bulk edits leaks fails its test. These tests pass, so `drain`, `truncate`, `split_off`,
// `swap_remove`, `extend_from_slice`, and the capacity methods free everything they take over.

test "drain frees the removed range's buffer" {
    let mut xs = List<String>.new()
    xs.push(String.from("a"))
    xs.push(String.from("b"))
    xs.push(String.from("c"))
    xs.push(String.from("d"))
    xs.reserve(32)
    let removed = xs.drain(1..3)
    for s in removed {
        assert_eq(s.len(), 1)?
    }
    assert_eq(xs.len(), 2)?
}

test "a drained iterator dropped early frees the rest" {
    let mut xs = List<String>.new()
    xs.push(String.from("a"))
    xs.push(String.from("b"))
    xs.push(String.from("c"))
    let end = xs.len()
    let mut removed = xs.drain(0..end)
    let first = removed.next().unwrap()
    assert_eq(first.len(), 1)?
    assert_eq(xs.len(), 0)?
}

test "truncate and shrink_to_fit free what they give up" {
    let mut xs = List<String>.new()
    let mut i = 0
    while i < 8 {
        xs.push(String.from("x"))
        i = i + 1
    }
    xs.reserve(64)
    xs.shrink_to_fit()
    xs.truncate(3)
    assert_eq(xs.len(), 3)?
}

test "split_off moves the elements into a new buffer" {
    let mut xs = List<String>.new()
    xs.push(String.from("a"))
    xs.push(String.from("b"))
    xs.push(String.from("c"))
    let mut tail = xs.split_off(1)
    assert_eq(tail.len(), 2)?
    tail.push(String.from("d"))
    xs.append(tail)
    assert_eq(xs.len(), 4)?
}

test "swap_remove returns the element to the caller" {
    let mut xs = List<String>.new()
    xs.push(String.from("a"))
    xs.push(String.from("b"))
    let b = xs.swap_remove(0)
    assert_eq(b.len(), 1)?
    assert_eq(xs.len(), 1)?
}

test "extend_from_slice clones each element" {
    let mut xs = List<String>.new()
    let mut ys = List<String>.new()
    ys.push(String.from("a"))
    ys.push(String.from("b"))
    xs.extend_from_slice(ys[0..ys.len()])
    assert_eq(xs.len(), 2)?
}

test "with_capacity_in frees its arena and buffer" {
    let mut xs = List<String>.with_capacity_in(16, Arena.new())
    xs.push(String.from("hello"))
    let mut ys = List<String>.new_in(Arena.new())
    ys.push(String.from("world"))
    xs.append(ys)
    xs.reserve(4)
    let tail = xs.split_off(1)
    assert_eq(tail.len(), 1)?
    assert_eq(xs.len(), 1)?
}
