//> Some(1) Some(5) Some(2) Some(4) Some(3) None None
//> Some(4) Some(1) Some(3) Some(2) None
//> Some('b') Some('a') None

// `rev` walks a double-ended iterator from the back. The built-in slice, range, and `Chars` iterators are
// double-ended, so are `Deque`'s, and a user type implements `DoubleEndedIterator<T>` to join them. `rev` passes
// through the adapters that keep the order of their source.

struct Span {
    lo: i32
    hi: i32
}

Span: Iterator<i32> {
    fn next(mut self): Option<i32> {
        if self.lo >= self.hi {
            return None
        }
        let v = self.lo
        self.lo = v + 1
        Some(v)
    }
}

Span: DoubleEndedIterator<i32> {
    fn next_back(mut self): Option<i32> {
        if self.lo >= self.hi {
            return None
        }
        self.hi = self.hi - 1
        Some(self.hi)
    }
}

fn main() {
    // An array, a list, and a range, in reverse.
    let array = [1, 2, 3]
    for x in array.iter().rev() {
        println("{x}")
    }
    let mut names = List<String>.new()
    names.push(String.from("a"))
    names.push(String.from("b"))
    names.push(String.from("c"))
    for s in names.iter().rev() {
        println("{s}")
    }
    for i in (0..4).iter().rev() {
        println("{i}")
    }
    // An inclusive range includes its upper endpoint, and reaches the limits of its type without overflowing.
    for i in (1..=3).iter().rev() {
        println("{i}")
    }
    println("{((250 as u8)..=(255 as u8)).iter().rev().count()}")
    println("{((0 as u8)..=(0 as u8)).iter().rev().count()}")
    println("{(0..0).iter().rev().count()}")
    // A string is walked by scalar value, backwards.
    for c in "añ😀z".chars().rev() {
        println("{c}")
    }
    // A user iterator and a deque.
    for x in (Span { lo: 0, hi: 3 }).rev() {
        println("{x}")
    }
    let mut d = Deque<i32>.new()
    d.push_back(2)
    d.push_back(3)
    d.push_front(1)
    d.push_front(0)
    for x in d.iter().rev() {
        println("{x}")
    }
    // The adapters that keep the order: `map`, `filter`, `inspect`, `chain`, `cloned`, `copied`, and `rev` itself.
    for x in (1..5).iter().map(|n| n * 10).rev() {
        println("{x}")
    }
    for x in (1..8).iter().filter(|n| *n % 3 == 0).rev() {
        println("{x}")
    }
    let low = [1, 2]
    let high = [3, 4]
    for x in low.iter().chain(high.iter()).rev() {
        println("{x}")
    }
    for s in names.iter().cloned().rev() {
        println("{s}")
    }
    for x in d.iter().copied().rev().rev() {
        println("{x}")
    }
    // `rev` is lazy and composes with the consumers.
    println("{(0..100).iter().rev().take(3).sum()}")
    println("{(0..10).iter().rev().skip(8).count()}")
    // `next` and `next_back` take from the two ends and meet in the middle.
    let mut r = (1..=5).iter()
    println("{r.next():?} {r.next_back():?} {r.next():?} {r.next_back():?} {r.next():?} {r.next():?} {r.next_back():?}")
    let xs = [1, 2, 3, 4]
    let mut s = xs.iter()
    println("{s.next_back():?} {s.next():?} {s.next_back():?} {s.next_back():?} {s.next():?}")
    let mut c = "ab".chars()
    println("{c.next_back():?} {c.next():?} {c.next_back():?}")
}
