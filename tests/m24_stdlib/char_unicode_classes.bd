//@ run
//> true true true true true
//> false false false
//> true true false
//> true false true
//> true true false

// The Unicode predicates know letters, decimal digits, and white space beyond ASCII.

fn main() {
    println("{'a'.is_alphabetic()} {'é'.is_alphabetic()} {'λ'.is_alphabetic()} {'я'.is_alphabetic()} {'中'.is_alphabetic()}")
    println("{'1'.is_alphabetic()} {'-'.is_alphabetic()} {' '.is_alphabetic()}")
    println("{'1'.is_numeric()} {'٣'.is_numeric()} {'a'.is_numeric()}")
    println("{' '.is_whitespace()} {'x'.is_whitespace()} {'　'.is_whitespace()}")
    println("{'é'.is_alphanumeric()} {'9'.is_alphanumeric()} {'?'.is_alphanumeric()}")
}
