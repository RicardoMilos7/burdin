//@ run
//> 5
//> 7
//> 9
//> 3
//> 11 11

// The entry type is nameable, so a function may take or return `MapEntry<K, V>`; the view an entry operation
// hands back stays a loan of the map across the function boundary. An entry on a map with a stored allocator
// inserts and grows through that allocator.

fn pending<K: Eq, V>(mut m: Map<K, V>, key: K): MapEntry<K, V> {
    m.entry(key)
}

fn fill<K: Eq, V>(mut m: Map<K, V>, key: K, value: V): &mut V {
    m.entry(key).or_insert(value)
}

fn fill_with<K: Eq, V, F: FnOnce(): V>(mut m: Map<K, V>, key: K, own make: F): &mut V {
    m.entry(key).or_insert_with(make)
}

fn arena_entries() {
    let mut m = Map<String, i32>.new_in(Arena.new())
    m.entry("a".to_string()).or_insert(1)
    m.entry("b".to_string()).or_insert(2)
    m.entry("c".to_string()).or_insert(3)
    m.entry("d".to_string()).or_insert(4)
    m.entry("e".to_string()).or_insert(5)
    m.entry("f".to_string()).or_insert(6)
    m.entry("g".to_string()).or_insert(7)
    m.entry("h".to_string()).or_insert(8)
    m.entry("i".to_string()).or_insert(9)
    m.entry("j".to_string()).or_insert(10)
    m.entry("k".to_string()).or_insert(11)
    let last = *m.get("k".to_string()).unwrap()
    println("{} {}", m.len(), last)
}

fn main() {
    let mut m = Map<i32, i32>.new()
    let e = pending(mut m, 1)
    let v = e.or_insert(5)
    let got = *v
    println("{}", got)
    let w = fill(mut m, 2, 7)
    let got2 = *w
    println("{}", got2)
    let x = fill_with(mut m, 3, || 9)
    let got3 = *x
    println("{}", got3)
    println("{}", m.len())

    arena_entries()
}
