//@ run
//> Some(15) None Some(7) None
//> true false
//> Some('b') None Some('1')
//> 1 2 3 4
//> Some('λ') None
//> A é

// Digit conversion goes both ways, and a code point becomes a character only when it is a Unicode scalar value.

fn main() {
    println("{'f'.to_digit(16):?} {'g'.to_digit(16):?} {'7'.to_digit(8):?} {'8'.to_digit(8):?}")
    println("{'z'.is_digit(36)} {'z'.is_digit(10)}")
    let eleven: u32 = 11
    let three: u32 = 3
    let one: u32 = 1
    println("{eleven.digit_char(16):?} {three.digit_char(2):?} {one.digit_char(10):?}")
    println("{'a'.len_utf8()} {'é'.len_utf8()} {'中'.len_utf8()} {'😀'.len_utf8()}")
    let lambda: u32 = 955
    let surrogate: u32 = 55300
    println("{lambda.to_char():?} {surrogate.to_char():?}")
    let a: u32 = 65
    let e: u8 = 233
    println("{a as char} {e as char}")
}
