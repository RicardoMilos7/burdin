//@ run
//> 8 8
//> [97, 195, 169, 240, 159, 152, 128, 122]
//> 8
//> 8

// `as_bytes` is a `[u8]` view of the text's storage, so it copies nothing; `bytes` is the iterator spelling and
// `into_bytes` copies the bytes into an owned list. `len` counts bytes, not characters.

fn main() {
    let s = String.from("aé😀z")
    println("{} {}", s.len(), s.as_bytes().len())

    let mut bytes = List<u8>.new()
    for byte in s.bytes() {
        bytes.push(byte)
    }
    println("{:?}", bytes)

    let view = "aé😀z"
    println("{}", view.as_bytes().len())

    println("{}", s.into_bytes().len())
}
