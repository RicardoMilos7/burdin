//@ run
//> 1 2 3 1
//> a b a
//> true

// `dedup` removes consecutive duplicates only, so a repeated value that is not adjacent stays.

fn show(xs: List<i32>) {
    let mut out = String.new()
    let mut first = true
    for x in xs {
        if !first {
            out.push(' ')
        }
        out.push_str(x.to_string())
        first = false
    }
    println(out)
}

fn main() {
    let mut xs = List<i32>.new()
    for x in [1, 1, 2, 2, 2, 3, 1, 1] {
        xs.push(x)
    }
    xs.dedup()
    show(xs)

    let mut words = List<String>.new()
    words.push(String.from("a"))
    words.push(String.from("a"))
    words.push(String.from("b"))
    words.push(String.from("a"))
    words.dedup()
    println("{words[0]} {words[1]} {words[2]}")

    let mut empty = List<i32>.new()
    empty.dedup()
    println("{empty.is_empty()}")
}
