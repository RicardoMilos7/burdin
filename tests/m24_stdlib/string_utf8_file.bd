//@ run
//> invalid UTF-8 at byte 2
//> ["ab", "cd"]
//> école

// Invalid UTF-8 read through `fs.read` is reported by the offset of its first bad byte, and text read from a
// file with `\r\n` line endings is split at the line feeds with the carriage returns removed.

fn bytes(values: [i32]): List<u8> {
    let mut out = List<u8>.new()
    for value in values {
        out.push(value as u8)
    }
    out
}

fn main() {
    let raw = [97, 98, 255, 100]
    let bad = bytes(raw[0..4])
    fs.write("bad.bin", bad[0..bad.len()]).unwrap()
    let read = fs.read("bad.bin").unwrap()
    match String.from_utf8(read) {
        Ok(text) => println("unexpectedly valid: {text}"),
        Err(reason) => println("{reason}"),
    }

    let raw_lines = [97, 98, 13, 10, 99, 100, 13, 10]
    let lines = bytes(raw_lines[0..8])
    fs.write("lines.txt", lines[0..lines.len()]).unwrap()
    let text = read_to_string("lines.txt").unwrap()
    println("{:?}", text.lines())

    let raw_text = [195, 169, 99, 111, 108, 101]
    let text = bytes(raw_text[0..6])
    fs.write("text.txt", text[0..text.len()]).unwrap()
    let back = fs.read("text.txt").unwrap()
    println("{}", String.from_utf8(back).unwrap())
}
