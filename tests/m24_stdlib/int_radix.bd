//@ run
//> 11111111 377 ff 73
//> -ff -11111111
//> 0
//> -8000000000000000
//> ffffffffffffffff 3w5e11264sgsf
//> 255 255
//> -255 1295
//> 255 -128
//> -9223372036854775808
//> 18446744073709551615
//> true true true true
//> true true true
//> true true true
//> true true

// `to_string_radix` writes a number in base 2 to 36 with lowercase digits, and `parse_radix` reads one back. A
// failure of any kind is `ParseIntError.Invalid`.

fn main() {
    let n: i32 = 255
    println("{} {} {} {}", n.to_string_radix(2), n.to_string_radix(8), n.to_string_radix(16), n.to_string_radix(36))
    let neg: i32 = -255
    println("{} {}", neg.to_string_radix(16), neg.to_string_radix(2))
    let zero: u8 = 0
    println("{}", zero.to_string_radix(2))
    let min: i64 = i64.MIN
    println("{}", min.to_string_radix(16))
    let max: u64 = u64.MAX
    println("{} {}", max.to_string_radix(16), max.to_string_radix(36))
    println("{} {}", i32.parse_radix("ff", 16).unwrap(), i32.parse_radix("FF", 16).unwrap())
    println("{} {}", i32.parse_radix("-ff", 16).unwrap(), i32.parse_radix("zz", 36).unwrap())
    println("{} {}", u8.parse_radix("11111111", 2).unwrap(), i8.parse_radix("-80", 16).unwrap())
    println("{}", i64.parse_radix("-8000000000000000", 16).unwrap())
    println("{}", u64.parse_radix("ffffffffffffffff", 16).unwrap())
    // Bad input: nothing, a stray sign or space, a digit of a bigger base, a value out of range.
    println("{} {} {} {}", i32.parse_radix("", 10).is_err(), i32.parse_radix("-", 10).is_err(), i32.parse_radix("+5", 10).is_err(), i32.parse_radix(" 5", 10).is_err())
    println("{} {} {}", i32.parse_radix("12", 2).is_err(), i32.parse_radix("g", 16).is_err(), u8.parse_radix("-1", 10).is_err())
    println("{} {} {}", u8.parse_radix("100", 16).is_err(), i8.parse_radix("80", 16).is_err(), i64.parse_radix("8000000000000000", 16).is_err())
    println("{} {}", u64.parse_radix("10000000000000000", 16).is_err(), i32.parse_radix("2147483648", 10).is_err())
}
