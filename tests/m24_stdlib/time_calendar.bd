//@ run
//> 2023-11-14T22:13:20Z Tuesday 318 false
//> 1970-01-01T00:00:00Z Thursday
//> 1969-12-31T23:59:59Z 1969-12-31T00:00:00Z
//> 2000-02-29T00:00:00Z Tuesday
//> 2100-03-01T00:00:00Z 1900-01-01T00:00:00Z
//> 2023-11-14T22:13:20.12345Z 123450000 22:13:20.123450000
//> 1969-12-31T23:59:59.999999999Z 999999999 -1
//> 2024-02-29T23:59:59Z true 60 Thursday 1709251199
//> None true true
//> true true true
//> true true true true
//> true true 1794908467 true
//> 2026/11/17 09-41-07 day 321 100% %q %
//> 0005-01-02T03:04:05Z
//> true
//> Some(6s) None
//> 15 -5

// `SystemTime` is nanoseconds since the Unix epoch, and `DateTime` is the same moment as a calendar date and a
// time of day in UTC. The conversions are exact for the whole proleptic Gregorian calendar, before 1970 too
// (spec/stdlib.md, "Time").

fn main() {
    let t = SystemTime.from_unix_secs(1_700_000_000)
    let dt = t.to_utc()
    println("{dt} {dt.weekday()} {dt.ordinal()} {dt.is_leap_year()}")
    println("{SystemTime.unix_epoch().to_utc()} {SystemTime.unix_epoch().to_utc().weekday()}")
    println("{SystemTime.from_unix_secs(-1).to_utc()} {SystemTime.from_unix_secs(-86_400).to_utc()}")
    println("{DateTime.from_unix_secs(951_782_400)} {DateTime.from_unix_secs(951_782_400).weekday()}")
    println("{DateTime.from_unix_secs(4_107_542_400)} {DateTime.from_unix_secs(-2_208_988_800)}")
    let frac = SystemTime.from_unix_nanos(1_700_000_000_123_450_000).to_utc()
    let pattern = "%H:%M:%S.%f"
    println("{frac} {frac.nanosecond} {frac.format(pattern)}")
    println("{SystemTime.from_unix_nanos(-1).to_utc()} {SystemTime.from_unix_nanos(-1).subsec_nanos()} {SystemTime.from_unix_nanos(-1).unix_secs()}")
    let leap = DateTime.new(2024, 2, 29, 23, 59, 59, 0).unwrap()
    println("{leap} {leap.is_leap_year()} {leap.ordinal()} {leap.weekday()} {leap.to_unix_secs()}")
    println("{DateTime.new(2023, 2, 29, 0, 0, 0, 0):?} {DateTime.new(1900, 2, 29, 0, 0, 0, 0).is_none()} {DateTime.new(2000, 2, 29, 0, 0, 0, 0).is_some()}")
    println("{DateTime.new(2024, 13, 1, 0, 0, 0, 0).is_none()} {DateTime.new(2024, 0, 1, 0, 0, 0, 0).is_none()} {DateTime.new(2024, 4, 31, 0, 0, 0, 0).is_none()}")
    println("{DateTime.new(2024, 4, 30, 24, 0, 0, 0).is_none()} {DateTime.new(2024, 4, 30, 0, 60, 0, 0).is_none()} {DateTime.new(2024, 4, 30, 0, 0, 60, 0).is_none()} {DateTime.new(2024, 4, 30, 0, 0, 0, 1_000_000_000).is_none()}")
    let a = DateTime.new(2026, 11, 17, 9, 41, 7, 0).unwrap()
    let b = DateTime.new(2026, 11, 17, 9, 41, 8, 0).unwrap()
    println("{a < b} {a == a} {a.to_system_time().unix_secs()} {a.to_system_time().to_utc() == a}")
    println(a.format("%Y/%m/%d %H-%M-%S day %j 100%% %q %"))
    println("{DateTime.new(5, 1, 2, 3, 4, 5, 0).unwrap()}")
    let mut all_round = true
    let mut secs: i64 = -4_000_000_000
    while secs < 4_000_000_000 {
        if DateTime.from_unix_secs(secs).to_unix_secs() != secs {
            all_round = false
        }
        secs = secs + 99_999_937
    }
    println("{all_round}")
    println("{SystemTime.from_unix_secs(10).duration_since(SystemTime.from_unix_secs(4)):?} {SystemTime.from_unix_secs(4).duration_since(SystemTime.from_unix_secs(10)):?}")
    println("{SystemTime.from_unix_secs(10).checked_add(Duration.from_secs(5)).unwrap().unix_secs()} {SystemTime.from_unix_secs(10).checked_sub(Duration.from_secs(15)).unwrap().unix_secs()}")
}
