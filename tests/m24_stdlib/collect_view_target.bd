//@ compile-fail

// A chain over borrowed items yields views, and a list or a map cannot hold a view, so these targets do not implement
// `FromIterator` for them (IT18).

fn main() {
    let words: List<String> = [String.from("a")].into_iter().collect()
    let names: Map<String, i32> = [(String.from("a"), 1)].into_iter().collect()
    let by_name: Map<String, i32> = names.iter().collect() //~ E0141
    let again: List<String> = words.iter().collect() //~ E0141
    println("{by_name.len()} {again.len()}")
}
