//@ run
//> 5 2 3 4 1
//> 2
//> 5 1 3 4
//> 5 1
//> 5
//> 1
//> 5 1
//> 5 1 7 8
//> 5 8
//> 1
//> 7
//> 8
//> 5
//> 0

// The bulk edits: `swap` exchanges two elements, `swap_remove` fills a hole with the last element, `truncate`
// cuts the list, `split_off` moves the tail into a new list, `append` moves another list's elements in,
// `extend_from_slice` clones a slice view, and `drain` removes a range and yields it.

fn show(xs: List<i32>) {
    let mut out = String.new()
    let mut first = true
    for x in xs {
        if !first {
            out.push_str(" ")
        }
        out.push_str(x.to_string())
        first = false
    }
    println(out)
}

fn main() {
    let mut xs = List<i32>.new()
    for i in 1..=5 {
        xs.push(i)
    }
    xs.swap(0, 4)
    show(xs)
    println("{xs.swap_remove(1)}")
    show(xs)
    xs.truncate(2)
    show(xs)

    let tail = xs.split_off(1)
    show(xs)
    show(tail)
    xs.append(tail)
    show(xs)

    let mut more = List<i32>.new()
    more.push(7)
    more.push(8)
    xs.extend_from_slice(more[0..more.len()])
    show(xs)

    let removed = xs.drain(1..3)
    show(xs)
    for x in removed {
        println("{x}")
    }

    let gone = xs.drain(0..=0)
    show(xs)
    for x in gone {
        println("{x}")
    }

    // A range at the end removes nothing and an index at the end splits an empty tail.
    let nothing = xs.drain(1..1)
    xs.truncate(10)
    let end = xs.len()
    let empty = xs.split_off(end)
    let mut count = 0
    for _ in nothing {
        count = count + 1
    }
    println("{count}")
}
