//@ run
//> accepted [3, 3, 3, 1]
//> written 10 abcdefghij
//> flushes 1
//> empty write is fine
//> zero: the writer accepted no bytes
//> line: one|two|
//> text: héllo

// `write_all` calls `write` until every byte is taken, so a sink that accepts only a prefix still gets all of them;
// a sink that takes nothing is `IoError.WriteZero`. `write_text` and `write_line` are built on it.

struct Slow {
    out: List<u8>
    sizes: List<usize>
    limit: usize
    flushes: i32
}

Slow: Write {
    fn write(mut self, data: [u8]): Result<usize, IoError> {
        let mut n = data.len()
        if n > self.limit {
            n = self.limit
        }
        let mut i: usize = 0
        while i < n {
            self.out.push(data[i])
            i = i + 1
        }
        self.sizes.push(n)
        Ok(n)
    }

    fn flush(mut self): Result<(), IoError> {
        self.flushes = self.flushes + 1
        Ok(())
    }
}

fn slow(limit: usize): Slow {
    Slow { out: List<u8>.new(), sizes: List<usize>.new(), limit: limit, flushes: 0 }
}

fn text(bytes: List<u8>): String {
    from_utf8(bytes[0..bytes.len()]).unwrap()
}

fn main() {
    let mut s = slow(3)
    s.write_text("abcdefghij").unwrap()
    println("accepted {:?}", s.sizes)
    s.flush().unwrap()
    println("written {} {}", s.out.len(), text(s.out))
    println("flushes {}", s.flushes)

    let mut z = slow(0)
    let none = List<u8>.new()
    match z.write_all(none[0..0]) {
        Ok(_) => println("empty write is fine"),
        Err(e) => println("empty: {}", e),
    }
    match z.write_text("x") {
        Ok(_) => println("unexpected"),
        Err(e) => println("zero: {}", e),
    }

    let mut l = slow(100)
    l.write_line("one").unwrap()
    l.write_text("two").unwrap()
    l.write_line("").unwrap()
    println("line: {}", text(l.out).replace("\n", "|"))

    let mut u = slow(2)
    u.write_text("héllo").unwrap()
    println("text: {}", text(u.out))
}
