//@ run
//> 1
//> 2
//> 3
//> 1
//> 2
//> 3
//> 1
//> a
//> b
//> a
//> b
//> a
//> r0
//> r1
//> r0
//> r1
//> r0
//> x
//> y
//> x
//> y
//> x
//> cd2
//> cd1
//> cd2
//> cd1
//> cd2
//> s1
//> s3
//> s1
//> s3
//> 0:2
//> 1:3
//> 2:1
//> 0
//> 0
//> Some(0) Some(1) Some(0) Some(1) Some(0)

// `cycle` repeats a clonable iterator forever, so it is used with `take`, `zip`, or an early `break`. A slice, a
// range, `Chars`, and a user iterator that derives `Clone` can be cycled, and so can the chains built from them that
// hold no closure (a closure cannot be cloned).

struct Countdown derives (Clone) {
    from: i32
}

Countdown: Iterator<i32> {
    fn next(mut self): Option<i32> {
        if self.from <= 0 {
            return None
        }
        let v = self.from
        self.from = v - 1
        Some(v)
    }
}

fn main() {
    let xs = [1, 2, 3]
    for x in xs.iter().cycle().take(7) {
        println("{x}")
    }
    let mut names = List<String>.new()
    names.push(String.from("a"))
    names.push(String.from("b"))
    for s in names.iter().cycle().take(5) {
        println("{s}")
    }
    for x in (0..2).iter().cycle().take(5) {
        println("r{x}")
    }
    for c in "xy".chars().cycle().take(5) {
        println("{c}")
    }
    for x in (Countdown { from: 2 }).cycle().take(5) {
        println("cd{x}")
    }
    // A cycle of a chain, and a cycle that is zipped with a finite source.
    for x in xs.iter().step_by(2).cycle().take(4) {
        println("s{x}")
    }
    for (i, x) in (0..3).iter().zip(xs.iter().cycle().skip(1)) {
        println("{i}:{x}")
    }
    // An empty source cycles to nothing instead of looping forever.
    let empty = List<i32>.new()
    println("{empty.iter().cycle().take(3).count()}")
    println("{(0..0).iter().cycle().count()}")
    // Each pass starts from the source as it was.
    let mut c = (0..2).iter().cycle()
    println("{c.next():?} {c.next():?} {c.next():?} {c.next():?} {c.next():?}")
}
