//@ run
//> ["a", "b", "", "c"]
//> ["c", "", "b", "a"]
//> ["añb", "c"]
//> ["a", "b"]
//> ["b", "a"]
//> ["", ""]
//> ["abc"]
//> ["x", "y"]

// `split` keeps the empty pieces between separators; `rsplit` gives the same pieces last first. A separator may be
// a character or a longer string, and a multi-byte separator is matched on character boundaries.

fn main() {
    println("{"a,b,,c".split(","):?}")
    println("{"a,b,,c".rsplit(","):?}")
    println("{"añb, c".split(", "):?}")
    println("{"añb".split_char('ñ'):?}")
    println("{"añb".rsplit_char('ñ'):?}")
    println("{",".split(","):?}")
    println("{"abc".split(","):?}")
    let s = String.from("x--y")
    println("{s.split("--"):?}")
}
