//@ run
//> ["a", "b", "", "c"]
//> ["c", "", "b", "a"]
//> ["añb", "c"]
//> ["a", "b"]
//> ["b", "a"]
//> ["", ""]
//> ["abc"]
//> ["x", "y"]

// `split` keeps the empty pieces between separators; `rsplit` gives the same pieces last first. A separator may be
// a character or a longer string, and a multi-byte separator is matched on character boundaries.

fn main() {
    println("{"a,b,,c".split(",").collect<List<String>>():?}")
    println("{"a,b,,c".rsplit(",").collect<List<String>>():?}")
    println("{"añb, c".split(", ").collect<List<String>>():?}")
    println("{"añb".split_char('ñ').collect<List<String>>():?}")
    println("{"añb".rsplit_char('ñ').collect<List<String>>():?}")
    println("{",".split(",").collect<List<String>>():?}")
    println("{"abc".split(",").collect<List<String>>():?}")
    let s = String.from("x--y")
    println("{s.split("--").collect<List<String>>():?}")
}
