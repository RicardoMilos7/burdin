//@ run
//> 10 20 30
//> 11 21 31
//> a! b! c!
//> 1 1 2
//> 4 0 3
//> 0
//> 5 6

// `for x in mut xs` walks a `List` and yields `&mut T`: every element is rewritten in place (IT15). `xs.iter_mut()`
// is the same walk written out. The collection is usable again once the loop ends, and `break` and `continue` work as
// in every other loop.

struct Pair {
    a: i32
    b: i32
}

fn show(xs: List<i32>) {
    println("{xs[0]} {xs[1]} {xs[2]}")
}

fn main() {
    let mut xs = List<i32>.new()
    xs.push(1)
    xs.push(2)
    xs.push(3)
    for x in mut xs {
        *x = *x * 10
    }
    show(xs)
    let mut it = xs.iter_mut()
    loop {
        match it.next() {
            Some(x) => {
                *x = *x + 1
            }
            None => break,
        }
    }
    show(xs)

    // An element that is not `Copy` is written through the same view, and methods work through it.
    let mut names = List<String>.new()
    names.push(String.from("a"))
    names.push(String.from("b"))
    names.push(String.from("c"))
    for name in mut names {
        name.push_str("!")
    }
    println("{names[0]} {names[1]} {names[2]}")

    // Struct fields are reached through the view without a `*`.
    let mut pairs = List<Pair>.new()
    pairs.push(Pair { a: 1, b: 0 })
    pairs.push(Pair { a: 1, b: 0 })
    pairs.push(Pair { a: 2, b: 0 })
    for p in mut pairs {
        p.b = p.a
    }
    println("{pairs[0].b} {pairs[1].b} {pairs[2].b}")

    // `continue` skips an element, `break` stops the walk.
    let mut ys = List<i32>.new()
    ys.push(4)
    ys.push(0)
    ys.push(3)
    ys.push(7)
    for y in mut ys {
        if *y == 0 {
            continue
        }
        if *y == 7 {
            break
        }
        *y = *y
    }
    println("{ys[0]} {ys[1]} {ys[2]}")

    // An empty list runs the body zero times.
    let mut empty = List<i32>.new()
    let mut seen = 0
    for e in mut empty {
        *e = 9
        seen = seen + 1
    }
    println("{seen}")
    empty.push(5)
    empty.push(6)
    println("{empty[0]} {empty[1]}")
}
