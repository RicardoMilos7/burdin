//@ run
//> 18165194896842380836 true
//> 3753867429526904406
//> true false
//> true

// `Hash` works as a bound (HS2): `hash()`, `hash_from`, `Hasher.write`, and `hash_of` accept a type parameter, and a
// generic struct derives `Hash` when its parameter is `Hash`.

struct Tag: Eq, Hash {
    name: String
    id: i32
}

struct Wrapper<T>: Eq, Hash {
    inner: T
}

fn fingerprint<T: Hash>(value: T): u64 {
    let mut h = Hasher.new()
    h.write(value)
    h.finish()
}

fn seeded_in<T: Hash>(seed: u64, value: T): u64 {
    let mut h = Hasher.with_seed(seed)
    h.write(value)
    h.finish()
}

fn same<T: Hash>(a: T, b: T): bool {
    hash_of(a) == b.hash()
}

fn from_state<T: Hash>(value: T, state: u64): u64 {
    value.hash_from(state)
}

fn main() {
    let tag = Tag { name: String.from("abc"), id: 7 }
    println("{fingerprint(tag)} {fingerprint(tag) == hash_of(tag)}")
    println("{seeded_in(3, "abc")}")
    let w1 = Wrapper { inner: String.from("x") }
    let w2 = Wrapper { inner: String.from("y") }
    println("{same(w1, Wrapper { inner: String.from("x") })} {same(w1, w2)}")
    println("{from_state("c", "ab".hash()) == "abc".hash()}")
}
