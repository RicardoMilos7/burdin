//@ run
//> read_exact 7: abcdefg
//> to_end: 7 bytes in 8 reads
//> text: abcdefg
//> invalid: the bytes are not valid text
//> line invalid: the bytes are not valid text

// A reader may return fewer bytes than asked for. `read_exact`, `read_to_end`, and `read_to_string` keep reading until
// they have what they need; text that is not valid UTF-8 is `IoError.InvalidData`.

struct Trickle {
    data: List<u8>
    pos: usize
    reads: i32
}

Trickle: Read {
    fn read(mut self, mut buf: List<u8>, max: usize): Result<usize, IoError> {
        self.reads = self.reads + 1
        if max == 0 || self.pos >= self.data.len() {
            return Result.Ok(0)
        }
        buf.push(self.data[self.pos])
        self.pos = self.pos + 1
        Result.Ok(1)
    }
}

fn trickle(own bytes: List<u8>): Trickle {
    Trickle { data: bytes, pos: 0, reads: 0 }
}

fn main() {
    let mut a = trickle("abcdefgh".to_utf8())
    let mut buf = List<u8>.new()
    a.read_exact(mut buf, 7).unwrap()
    println("read_exact 7: {}", from_utf8(buf[0..buf.len()]).unwrap())

    let mut b = trickle("abcdefg".to_utf8())
    let mut all = List<u8>.new()
    let n = b.read_to_end(mut all).unwrap()
    println("to_end: {} bytes in {} reads", n, b.reads)

    let mut c = trickle("abcdefg".to_utf8())
    println("text: {}", c.read_to_string().unwrap())

    let mut bad = List<u8>.new()
    bad.push(97)
    bad.push(255)
    let mut d = trickle(bad)
    match d.read_to_string() {
        Result.Ok(_) => println("unexpected"),
        Result.Err(e) => println("invalid: {}", e),
    }

    let mut worse = List<u8>.new()
    worse.push(255)
    worse.push(10)
    let mut e = BufReader.new(trickle(worse))
    match e.read_line() {
        Result.Ok(_) => println("unexpected"),
        Result.Err(err) => println("line invalid: {}", err),
    }
}
