//@ run
//> 5
//> 5
//> Some(5) None
//> 2 [1, 3]
//> Some((3, 30))
//> None
//> [10, 20, 30, 40]
//> 0 true
//> Some(99) Some(20)
//> 2

// `get_or` stores its default only for an absent key; `retain` keeps the entries its predicate accepts;
// `remove_entry` hands back the stored key and value; `drain` empties the map and yields its entries; and
// `extend` inserts every `(key, value)` of an iterator, replacing the value of a key that is already there.

fn sorted_keys(m: Map<i32, i32>): List<i32> {
    let mut keys = List<i32>.new()
    for key in m.keys() {
        keys.push(*key)
    }
    keys.sort()
    keys
}

fn main() {
    let mut m = Map<i32, i32>.new()
    let first = m.get_or(1, 5)
    println("{}", *first)
    let again = m.get_or(1, 99)
    println("{}", *again)
    println("{:?} {:?}", m.get(1), m.get(2))

    let mut kept = Map<i32, i32>.new()
    kept.insert(1, 10)
    kept.insert(2, 20)
    kept.insert(3, 30)
    kept.insert(4, 40)
    kept.retain(|key, value| *key % 2 == 1)
    println("{} {:?}", kept.len(), sorted_keys(kept))

    let removed = kept.remove_entry(3)
    println("{:?}", removed)
    println("{:?}", kept.remove_entry(3))

    let mut drained_map = Map<i32, i32>.new()
    drained_map.insert(1, 10)
    drained_map.insert(2, 20)
    drained_map.insert(3, 30)
    drained_map.insert(4, 40)
    let mut drained = List<i32>.new()
    for (_, value) in drained_map.drain() {
        drained.push(value)
    }
    drained.sort()
    println("{:?}", drained)
    println("{} {}", drained_map.len(), drained_map.is_empty())

    let mut extended = Map<i32, i32>.new()
    let mut pairs = List<(i32, i32)>.new()
    pairs.push((1, 10))
    pairs.push((2, 20))
    pairs.push((1, 99))
    extended.extend(pairs.into_iter())
    println("{:?} {:?}", extended.get(1), extended.get(2))
    println("{}", extended.len())
}
