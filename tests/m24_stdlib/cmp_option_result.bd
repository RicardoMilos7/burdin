//@ run
//> Less
//> Greater
//> Equal
//> Less
//> Greater
//> Less
//> Greater
//> Equal
//> Less

// `Option` is ordered with `None` first; `Result` with every `Ok` before every `Err`.

fn show(o: Ordering) {
    println("{o:?}")
}

fn main() {
    let none: Option<i32> = Option.None
    show(none.cmp(Option.Some(0)))
    show((Option.Some(5)).cmp(none))
    show(none.cmp(none))
    show((Option.Some(1)).cmp(Option.Some(2)))
    show((Option.Some("b")).cmp(Option.Some("a")))

    let ok1: Result<i32, String> = Result.Ok(1)
    let ok2: Result<i32, String> = Result.Ok(2)
    let err: Result<i32, String> = Result.Err(String.from("x"))
    show(ok1.cmp(err))
    show(err.cmp(ok2))
    show(err.cmp(err))
    show(ok1.cmp(ok2))
}
