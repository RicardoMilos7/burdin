//@ compile-fail

// A `MapEntry` views the map it came from, so it cannot be stored in a field or a container (SC2), and it may
// not outlive the map it reads (RT5).

struct Holder {
    entry: MapEntry<i32, i32>, //~ E0120
}

fn main() {
    let mut list = List<MapEntry<i32, i32>>.new() //~ E0120
    let dangling = { //~ E0123
        let mut m = Map<i32, i32>.new()
        m.entry(1)
    }
    let v = dangling.or_insert(0) //~ E0123
    *v = 1
}
