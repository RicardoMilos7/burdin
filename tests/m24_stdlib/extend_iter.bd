//@ run
//> [1, 2, 3, 40, 50]
//> 3 true
//> [10, 20, 30]
//> abcd
//> [1, 3]
//> [3, 2, 1]
//> 2 b

// Every collection takes the items of any iterator with `extend_iter`: a list appends them in order, a set and a map
// add them (a repeated element is kept once, a repeated key takes the new value), a deque appends at the back, a
// priority heap pushes them, and a string appends characters (IT17).

fn main() {
    let mut list = List.from([1, 2, 3])
    list.extend_iter([4, 5].into_iter().map(|x| x * 10))
    println("{list:?}")

    let mut set = Set<i32>.from([1, 2])
    set.extend_iter(list.into_iter())
    println("{set.len() - 2} {set.contains(50)}")

    let mut deque = Deque<i32>.new()
    deque.extend_iter([10, 20].into_iter())
    deque.push_back(30)
    println("{deque:?}")

    let mut text = String.from("ab")
    text.extend_iter("cd".chars())
    println("{text}")

    let mut odds = Deque<i32>.new()
    odds.extend_iter((1..4).into_iter().filter(|x| *x % 2 == 1))
    println("{odds:?}")

    let mut heap = PriorityHeap<i32>.new()
    heap.extend_iter([2, 3, 1].into_iter())
    println("{heap.into_sorted_list():?}")

    let mut map = Map<i32, String>.new()
    map.insert(1, String.from("a"))
    map.extend_iter([(2, String.from("b")), (1, String.from("c"))].into_iter())
    map.extend_iter([(1, String.from("d"))].into_iter().skip(1))
    println("{map.len()} {map.get(2).unwrap()}")
}
