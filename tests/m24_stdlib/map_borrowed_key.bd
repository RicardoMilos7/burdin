//@ run
//> Some(10)
//> true
//> Some(11)
//> false
//> true
//> None
//> 2
//> Some(20)
//> 1

// A `Map<String, V>` takes a `str` for its read-only lookups (`get`, `get_mut`, `contains_key`, `remove`,
// `remove_entry`), so `m.get("x")` hashes and compares the bytes without allocating a `String`. A `String`
// argument still works: it converts to `str` through the one implicit conversion.

fn main() {
    let mut m = Map<String, i32>.new()
    m.insert("a".to_string(), 10)
    m.insert("bb".to_string(), 20)
    println("{:?}", m.get("a"))
    println("{}", m.contains_key("bb"))
    match m.get_mut("a") {
        Some(value) => {
            *value = *value + 1
        }
        None => {}
    }
    println("{:?}", m.get("a"))
    println("{}", m.contains_key("zzz"))

    let key = String.from("a")
    println("{}", m.contains_key(key))
    println("{:?}", m.remove("missing"))
    println("{}", m.len())
    println("{:?}", m.remove("bb"))
    println("{}", m.len())
}
