//@ run
//> [1, 2, 3]
//> 3 true false
//> [1, 2, 3]
//> [9, 5, 1]
//> cba
//> abc
//> a-b
//> héllo
//> 6
//> 2 9

// `collect` builds the collection the context asks for: the expected type names the target (IT14, IT15).

fn first_three(): List<i32> {
    [1, 2, 3, 4].into_iter().take(3).collect()
}

fn count_distinct(items: Set<i32>): usize {
    items.len()
}

fn main() {
    // A list, from the return type.
    println("{first_three():?}")

    // A set drops repeats; the target is the annotation.
    let set: Set<i32> = [1, 2, 3, 2, 1, 3].into_iter().collect()
    println("{set.len()} {set.contains(2)} {set.contains(7)}")

    // A deque keeps the order; a priority heap hands out the greatest first.
    let deque: Deque<i32> = [1, 2, 3].into_iter().collect()
    println("{deque:?}")
    let heap: PriorityHeap<i32> = [5, 9, 1].into_iter().collect()
    println("{heap.into_sorted_list():?}")

    // A string, from `char`, `str`, `String`, and views of `String` items.
    let from_chars: String = "cba".chars().collect()
    println("{from_chars}")
    let mut reversed = List<char>.new()
    for c in "cba".chars() {
        reversed.insert(0, c)
    }
    let from_list: String = reversed.into_iter().collect()
    println("{from_list}")
    let from_strs: String = ["a", "-", "b"].into_iter().collect()
    println("{from_strs}")
    let words = ["h", "é", "llo"].into_iter().map(|s| String.from(s)).to_list()
    let views: String = words.iter().collect()
    println("{views}")
    let owned: String = words.into_iter().collect()
    println("{owned.len()}")

    // A map, from pairs; the argument position is an expected type too.
    let squares: Map<i32, i32> = [1, 2, 3].into_iter().map(|x| (x, x * x)).collect()
    println("{count_distinct([4, 4, 5].into_iter().collect())} {squares.get(3).unwrap()}")
}
