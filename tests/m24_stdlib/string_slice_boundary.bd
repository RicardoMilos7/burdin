//@ run
//> a ñ añb b ñ 0 0
//> ñ a
//> 😀
//> 2
//> ñb
//> a

// `s[a..b]` and `s[a..=b]` on `str` and `String` are views when both ends are character boundaries: the start and
// the end of the text, and any byte that does not continue a multi-byte character (issue #916). The ends below all
// fall on boundaries, so each slice is whole characters. A `[u8]` slice of the bytes checks only its range.

const HEAD: str = "añb"[0..1]

fn main() {
    let s = "añb"
    println("{} {} {} {} {} {} {}", s[0..1], s[1..3], s[0..4], s[3..4], s[1..=2], s[4..4].len(), s[0..0].len())
    let owned = String.from("añb")
    println("{} {}", owned[1..3], owned[0..=0])
    println("{}", "😀!"[0..4])
    println("{}", s.as_bytes()[1..3].len())
    println("{}", owned[1..4])
    println("{HEAD}")
}
