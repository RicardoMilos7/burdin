//@ run
//> cannot read missing.txt: not found
//> not found some
//> cannot write plain: already exists
//> already exists some
//> cannot read plain: not a directory
//> not a directory some
//> cannot write d: directory not empty
//> directory not empty some
//> cannot write plain: not a directory
//> not a directory none
//> cannot run no-such-command: other
//> other none
//> unexpected end of input
//> unexpected end of file none
//> the bytes are not valid text
//> invalid data none
//> the writer accepted no bytes
//> other none
//> seek to a position before the start
//> invalid input none
//> invalid open options
//> invalid input none

// Every I/O failure carries the portable kind and, when a system call reported it, the raw OS code
// (spec/errors.md, ERR10-ERR11). The exact code is the platform's own: `errno` on Linux and macOS, the Win32
// error code on Windows. The reader and writer variants observe their failure themselves, so they have no code
// and `kind()` classifies them.

fn report(failure: IoError) {
    println("{failure}")
    if failure.os_code().is_some() {
        println("{} some", failure.kind())
    } else {
        println("{} none", failure.kind())
    }
}

fn main() {
    match read_to_string("missing.txt") {
        Result.Ok(_) => println("read succeeded"),
        Result.Err(e) => {
            // ENOENT and ERROR_FILE_NOT_FOUND are both 2.
            assert(e.os_code() == Option.Some(2))
            report(e)
        }
    }

    write_file("plain", "x").unwrap()
    match create_dir("plain") {
        Result.Ok(_) => println("create succeeded"),
        Result.Err(e) => {
            if target.os() == target.Os.Windows {
                assert(e.os_code() == Option.Some(183)) // ERROR_ALREADY_EXISTS
            } else {
                assert(e.os_code() == Option.Some(17)) // EEXIST
            }
            report(e)
        }
    }

    match read_dir("plain") {
        Result.Ok(_) => println("read_dir succeeded"),
        Result.Err(e) => {
            if target.os() == target.Os.Windows {
                assert(e.os_code() == Option.Some(267)) // ERROR_DIRECTORY
            } else {
                assert(e.os_code() == Option.Some(20)) // ENOTDIR
            }
            report(e)
        }
    }

    create_dir("d").unwrap()
    write_file("d/f", "x").unwrap()
    match remove_dir("d") {
        Result.Ok(_) => println("remove_dir succeeded"),
        Result.Err(e) => {
            if target.os() == target.Os.Windows {
                assert(e.os_code() == Option.Some(145)) // ERROR_DIR_NOT_EMPTY
            } else if target.os() == target.Os.MacOs {
                assert(e.os_code() == Option.Some(66)) // ENOTEMPTY
            } else {
                assert(e.os_code() == Option.Some(39)) // ENOTEMPTY
            }
            report(e)
        }
    }

    // `std` itself sees that `plain` is not a directory: no system call failed, so there is no code.
    match remove_dir_all("plain") {
        Result.Ok(_) => println("remove_dir_all succeeded"),
        Result.Err(e) => {
            assert(e.os_code().is_none())
            report(e)
        }
    }

    // `process.run` fails only when the shell cannot start, which a test cannot arrange portably, so the third
    // variant is built directly (spec/errors.md, ERR10).
    report(IoError.Run { command: "no-such-command".to_string(), kind: IoErrorKind.Other, os_code: Option.None })

    // The reader and writer failures of #409 and the option rejection of #702 carry no path and no OS code;
    // `kind()` still classifies every one.
    report(IoError.UnexpectedEof)
    report(IoError.InvalidData)
    report(IoError.WriteZero)
    report(IoError.Seek)
    report(IoError.InvalidInput)
}
