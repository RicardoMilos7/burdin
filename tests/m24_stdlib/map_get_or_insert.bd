//@ run
//> Some(10)
//> Some(8) 2
//> true false
//> Some(110) Some(133)
//> Some(3) Some(1) 3

// `get_or_insert` and `get_or_insert_with` find a key and store a value for it in one go; the returned `&mut V`
// points into the map. `update` changes a value that is there, and `upsert` stores a value or changes the one
// that is there.

fn bump(v: &mut i32) {
    *v = *v + 100
}

fn main() {
    let mut m = Map<i32, i32>.new()
    let a = m.get_or_insert(1, 0)
    *a = *a + 5
    let b = m.get_or_insert(1, 0)
    *b = *b + 5
    println("{:?}", m.get(1))
    let c = m.get_or_insert_with(2, || 7)
    *c = *c + 1
    println("{:?} {}", m.get(2), m.len())
    println("{} {}", m.update(1, bump), m.update(9, bump))
    m.upsert(3, 33, bump)
    m.upsert(3, 0, bump)
    println("{:?} {:?}", m.get(1), m.get(3))

    let mut words = Map<String, usize>.new()
    for w in ["a", "b", "a", "c", "a"] {
        words.upsert(w.to_string(), 1, |n| {
            *n = *n + 1
        })
    }
    println("{:?} {:?} {}", words.get("a".to_string()), words.get("b".to_string()), words.len())
}
