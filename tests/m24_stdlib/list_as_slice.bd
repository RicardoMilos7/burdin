//@ run
//> 3 Some(10) Some(30)
//> 20 30
//> Ok(1)
//> 30 20 10
//> 7 7 10
//> 2 1
//> 2 7

// A `List<T>` is viewed as a slice with `as_slice()` and with a range (`spec/stdlib.md`, "Slices"). The view
// borrows the list, so the borrow checker rejects growing the list while the view is used (E0111), and a
// mutating slice method writes into the list's own buffer.

fn show(xs: [i32]) {
    let mut out = String.new()
    let mut first = true
    let mut i: usize = 0
    while i < xs.len() {
        if !first {
            out.push(' ')
        }
        out.push_str(xs[i].to_string())
        first = false
        i = i + 1
    }
    println(out)
}

fn main() {
    let mut xs = List<i32>.new()
    xs.push(10)
    xs.push(20)
    xs.push(30)
    let all = xs.as_slice()
    println("{} {:?} {:?}", all.len(), all.first(), all.last())
    let mid = xs[1..3]
    show(mid)
    println("{:?}", all.binary_search(20))

    // A mutable view writes into the list.
    let mut reversed = xs[0..3]
    reversed.reverse()
    show(xs.as_slice())
    let mut head = xs[0..2]
    head.fill(7)
    show(xs.as_slice())

    let (left, right) = xs.as_slice().split_at_mut(2)
    println("{} {}", left.len(), right.len())

    // A stored `Range<usize>` works with the checked slicing form.
    let middle: Range<usize> = 1..3
    match xs.as_slice().get(middle) {
        Option.Some(part) => println("{} {}", part.len(), part[0]),
        Option.None => println("none"),
    }
}
