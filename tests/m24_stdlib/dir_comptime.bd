//@ compile-fail

// The directory operations reach the operating system, so a comptime evaluation that reaches one is E0224
// (spec/comptime.md, CT9; spec/stdlib.md, "Directories, metadata, and walking"). A helper that calls one is
// impure too, and the error is reported where the comptime evaluation starts.

fn names(): usize {
    read_dir(".").unwrap().len()
}

fn main() {
    let a = comptime read_dir(".").is_ok() //~ E0224
    let b = comptime metadata(".").is_ok() //~ E0224
    let c = comptime canonicalize(".").is_ok() //~ E0224
    let d = comptime create_dir("made").is_ok() //~ E0224
    let e = comptime remove_file("gone").is_ok() //~ E0224
    let f = comptime walk(".").is_ok() //~ E0224
    let g = comptime names() //~ E0224
}
