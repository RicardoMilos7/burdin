//@ run-abort
//@ stderr: clone_from_slice: source and destination lengths differ
//> before

// `clone_from_slice` needs two slices of the same length.

fn main() {
    let mut arr = [1, 2, 3]
    let mut xs = arr[0..3]
    let source = [7, 8]
    println("before")
    xs.clone_from_slice(source[0..2])
}
