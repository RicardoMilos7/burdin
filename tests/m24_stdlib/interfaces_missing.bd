    value: f64 //~ E0130
}

struct CopyList: Copy {
    value: List<i32> //~ E0130
}

struct CopyText: Copy {
    value: String //~ E0130
}

struct DebugArray: Debug {
    value: [i32; 3] //~ E0130
}

struct HashDeque: Hash {
    value: Deque<i32> //~ E0130
}

fn main() { }
