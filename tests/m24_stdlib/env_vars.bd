//@ run
//> none
//> hello
//> world
//> none
//> true
//> 0
//> true
//> true
//> invalid environment variable name A=B
//> true
//> invalid value for environment variable BURDIN_TEST_ENV_412_A
//> Some(Bytes[104, 105])
//> héllo ✓
//> true
//> true

// Reading, setting, and removing environment variables: a missing variable is `None`, a set one replaces the old
// value, an empty value is distinct from a missing one, and a name or value the system cannot store is an error.

fn show(own value: Option<String>): String {
    match value {
        Option.Some(text) => text,
        Option.None => "none".to_string(),
    }
}

fn main() {
    let name = "BURDIN_TEST_ENV_412_A"
    env.remove(name).unwrap()
    println("{}", show(env.get(name)))
    env.set(name, "hello").unwrap()
    println("{}", show(env.get(name)))
    env.set(name, "world").unwrap()
    println("{}", show(env.get(name)))
    env.remove(name).unwrap()
    println("{}", show(env.get(name)))

    env.set(name, "").unwrap()
    println("{}", env.get(name).is_some())
    println("{}", env.get(name).unwrap().len())
    env.remove(name).unwrap()

    // An empty name, a name with `=`, and a value with a NUL byte are invalid on every platform.
    println("{}", env.set("", "x").is_err())
    println("{}", env.set("A=B", "x").is_err())
    match env.set("A=B", "x") {
        Result.Ok(_) => println("ok"),
        Result.Err(e) => println("{e}"),
    }
    let mut nul_bytes = List<u8>.new()
    nul_bytes.push(97)
    nul_bytes.push(0)
    nul_bytes.push(98)
    let nul = from_utf8(nul_bytes[0..nul_bytes.len()]).unwrap()
    println("{}", env.set(name, nul.as_str()).is_err())
    match env.set(name, nul.as_str()) {
        Result.Ok(_) => println("ok"),
        Result.Err(e) => println("{e}"),
    }

    // The byte form reads and writes the same variable.
    let mut raw = List<u8>.new()
    raw.push(104)
    raw.push(105)
    env.set_bytes(name, raw[0..raw.len()]).unwrap()
    println("{:?}", env.get_bytes(name))
    env.remove(name).unwrap()

    // A value outside ASCII survives the Windows UTF-16 conversion.
    env.set(name, "héllo ✓").unwrap()
    println("{}", show(env.get(name)))
    env.remove(name).unwrap()
    println("{}", env.get_bytes(name).is_none())
    println("{}", env.remove(name).is_ok())
}
