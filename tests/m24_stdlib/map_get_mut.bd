//@ run
//> Some(11)
//> true
//> None
//> Some(4)

// `get_mut` gives a mutable view of the value, or `None` for a missing key. `get_or_insert` stores the value only
// when the key is absent, and a present value is kept.

fn main() {
    let mut m = Map<i32, i32>.new()
    m.insert(1, 10)
    match m.get_mut(1) {
        Option.Some(v) => {
            *v = *v + 1
        }
        Option.None => {}
    }
    println("{:?}", m.get(1))
    println("{}", m.get_mut(2).is_none())
    println("{:?}", m.get(2))
    let r = m.get_or_insert(3, 4)
    println("{:?}", Option.Some(*r))
    let again = m.get_or_insert(3, 99)
    *again = *again + 0
}
