//@ run
//> 2 4 6
//> 3
//> 20
//> [3, 2, 1]
//> [1, 4, 9]
//> 1 b

// A chain of adapters collects like any iterator. A later pair of a `Map` replaces an earlier one with the same key,
// like `insert`, and a `PriorityHeap` orders what it collects (IT15).

fn main() {
    let evens: List<i32> = [1, 2, 3, 4, 5, 6].into_iter().filter(|x| *x % 2 == 0).collect()
    println("{evens[0]} {evens[1]} {evens[2]}")

    // Collecting from a borrowed chain: `iter()` of a list of numbers yields the numbers.
    let numbers = List.from([1, 2, 2, 3])
    let doubled: Set<i32> = numbers.iter().map(|x| x * 2).collect()
    println("{doubled.len()}")
    println("{numbers.len() * 5}")

    let heap: PriorityHeap<i32> = [1, 3, 2].into_iter().collect()
    let order: List<i32> = heap.into_sorted_list().into_iter().collect()
    println("{order:?}")

    let squares: List<i32> = (1..4).into_iter().map(|x| x * x).collect()
    println("{squares:?}")

    let pairs: Map<i32, String> = [(1, "a"), (1, "b")].into_iter().map(|p| (p.0, String.from(p.1))).collect()
    println("{pairs.len()} {pairs.get(1).unwrap()}")
}
