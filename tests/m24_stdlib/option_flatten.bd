//@ run
//> Some(4)
//> None
//> None
//> Some("moved")
//> true

// `flatten` gives the inner `Some`; a `None` at either level gives `None`. A non-`Copy` payload moves out.

fn main() {
    let a: Option<Option<i32>> = Option.Some(Option.Some(4))
    let b: Option<Option<i32>> = Option.Some(Option.None)
    let c: Option<Option<i32>> = Option.None
    println("{a.flatten():?}")
    println("{b.flatten():?}")
    println("{c.flatten():?}")

    let s: Option<Option<String>> = Option.Some(Option.Some(String.from("moved")))
    let t = s.flatten()
    println("{t:?}")
    println("{t.is_some()}")
}
