//> [8, 3, 9, 0, 7, 2, 1, 6, 5, 4]

// `Random.seeded(seed)` is a deterministic generator (xoshiro256** seeded through SplitMix64): the same seed gives
// the same numbers on every platform. The known answers below come from an independent implementation
// (spec/stdlib.md, "Random numbers").

fn main() {
    let mut zero = Random.seeded(0)
    println("{zero.next_u64()} {zero.next_u64()} {zero.next_u64()}")
    let mut r = Random.seeded(42)
    println("{r.next_u64()} {r.next_u64()} {r.next_u64()}")
    println("{Random.seeded(42).next_u32()}")
    let mut below = Random.seeded(42)
    let mut drawn = List<u64>.new()
    for i in 0..8 {
        drawn.push(below.below(100))
    }
    println("{drawn:?}")
    let mut f = Random.seeded(42)
    println("{f.next_f64()} {f.next_f64()}")
    let mut ranged = Random.seeded(5)
    let mut values = List<i64>.new()
    for i in 0..8 {
        values.push(ranged.range(-5, 5))
    }
    println("{values:?}")
    let mut bits = Random.seeded(9)
    let mut flags = List<bool>.new()
    for i in 0..8 {
        flags.push(bits.next_bool())
    }
    println("{flags:?}")
    let mut shuffler = Random.seeded(7)
    let mut items = List<i32>.new()
    for i in 0..10 {
        items.push(i)
    }
    shuffler.shuffle(mut items)
    println("{items:?}")
}
