//@ compile-fail

// Reading a clock reaches the operating system, so a comptime evaluation that reaches one is E0224
// (spec/comptime.md, CT9; spec/stdlib.md, "Time"). A helper that reads one is impure too, and the error is
// reported where the comptime evaluation starts.

fn age(): i64 {
    time.unix_seconds()
}

fn main() {
    let a = comptime time.now() //~ E0224
    let b = comptime time.unix_seconds() //~ E0224
    let c = comptime age() //~ E0224
}
