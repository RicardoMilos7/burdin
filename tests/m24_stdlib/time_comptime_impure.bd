//@ compile-fail

// Reading a clock, sleeping, and asking the system for entropy reach the operating system, so a comptime evaluation
// that reaches one is E0224 (spec/comptime.md, CT9; spec/stdlib.md, "Time" and "Random numbers"). A helper that
// calls one is impure too, and the error is reported where the comptime evaluation starts.

fn stamp(): u64 {
    SystemTime.now().unix_nanos() as u64
}

fn main() {
    let a = comptime Instant.now().since_start() //~ E0224
    let b = comptime SystemTime.now().unix_secs() //~ E0224
    let c = comptime sleep(Duration.from_millis(1)) //~ E0224
    let d = comptime random_seed() //~ E0224
    let e = comptime Random.from_entropy().next_u64() //~ E0224
    let f = comptime stamp() //~ E0224
    let g = comptime SystemClock { }.now() //~ E0224
}
