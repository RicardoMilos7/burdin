//@ burdin-test passed=4 failed=0

// The exactly rounded float functions compute the bits the IEEE 754 result has, in compiled code and in
// the constant interpreter alike (issue #703). Every assertion names those bits. The transcendental functions are not checked
// this way: their last bit is the C library's, and `spec/stdlib.md` promises bit-for-bit agreement only where
// IEEE 754 requires it.

test "exactly rounded f64 functions" {
    assert_eq((2.0).sqrt().to_bits(), 0x3ff6a09e667f3bcd)?
    assert_eq((0.5).sqrt().to_bits(), 0x3fe6a09e667f3bcd)?
    assert_eq((1.0e300).sqrt().to_bits(), 0x5f138d352e5096af)?
    assert_eq((0.1).sqrt().to_bits(), 0x3fd43d136248490f)?
    assert_eq((-1.5).floor().to_bits(), 0xc000000000000000)?
    assert_eq((1.5).ceil().to_bits(), 0x4000000000000000)?
    assert_eq((2.5).round().to_bits(), 0x4008000000000000)?
    assert_eq((-2.5).round().to_bits(), 0xc008000000000000)?
    assert_eq((2.5).round_ties_even().to_bits(), 0x4000000000000000)?
    assert_eq((3.5).round_ties_even().to_bits(), 0x4010000000000000)?
    // A tie goes to the even neighbour, and a zero result keeps the input's sign.
    assert_eq((0.5).round_ties_even().to_bits(), 0x0000000000000000)?
    assert_eq((-0.5).round_ties_even().to_bits(), 0x8000000000000000)?
    assert_eq((1.5).round_ties_even().to_bits(), 0x4000000000000000)?
    assert_eq((-1.5).round_ties_even().to_bits(), 0xc000000000000000)?
    assert_eq((-0.49999999999999994).round_ties_even().to_bits(), 0x8000000000000000)?
    assert_eq((-1.9).trunc().to_bits(), 0xbff0000000000000)?
    assert_eq((-0.0).abs().to_bits(), 0x0000000000000000)?
    assert_eq((0.1).abs().to_bits(), 0x3fb999999999999a)?
    // `abs` clears the sign bit of a NaN and keeps its payload.
    assert_eq(f64.from_bits(0xfff8000000000abc).abs().to_bits(), 0x7ff8000000000abc)?
}

test "copysign and mul_add are exact" {
    assert_eq((0.1).copysign(-1.0).to_bits(), 0xbfb999999999999a)?
    assert_eq((-0.1).copysign(1.0).to_bits(), 0x3fb999999999999a)?
    // A fused multiply-add rounds once; the two-step form rounds twice and loses the small product here.
    assert_eq((0.1).mul_add(10.0, -1.0).to_bits(), 0x3c90000000000000)?
    assert_eq((0.1 * 10.0 - 1.0).to_bits(), 0x0000000000000000)?
}

test "exactly rounded f32 functions" {
    let two: f32 = 2.0
    let half: f32 = 0.5
    let minus_one_point_five: f32 = -1.5
    let two_point_five: f32 = 2.5
    let two_point_five_neg: f32 = -2.5
    let neg_one_point_nine: f32 = -1.9
    let tenth: f32 = 0.1
    let neg_zero: f32 = -0.0
    assert_eq(two.sqrt().to_bits(), 0x3fb504f3)?
    assert_eq(half.sqrt().to_bits(), 0x3f3504f3)?
    assert_eq(minus_one_point_five.floor().to_bits(), 0xc0000000)?
    assert_eq(minus_one_point_five.ceil().to_bits(), 0xbf800000)?
    assert_eq(two_point_five.round().to_bits(), 0x40400000)?
    assert_eq(two_point_five_neg.round().to_bits(), 0xc0400000)?
    assert_eq(two_point_five.round_ties_even().to_bits(), 0x40000000)?
    assert_eq(half.round_ties_even().to_bits(), 0x00000000)?
    assert_eq((-half).round_ties_even().to_bits(), 0x80000000)?
    assert_eq(neg_one_point_nine.trunc().to_bits(), 0xbf800000)?
    assert_eq(neg_zero.abs().to_bits(), 0x00000000)?
    assert_eq(tenth.copysign(-1.0).to_bits(), 0xbdcccccd)?
    assert_eq(tenth.mul_add(10.0, -1.0).to_bits(), 0x32800000)?
}

test "the std float helpers agree" {
    // The receiver is returned when the values compare equal, so the signed zeros are deterministic.
    assert_eq((0.0).min(-0.0).to_bits(), 0x0000000000000000)?
    assert_eq((-0.0).min(0.0).to_bits(), 0x8000000000000000)?
    assert_eq((0.0).max(-0.0).to_bits(), 0x0000000000000000)?
    assert_eq((-0.0).max(0.0).to_bits(), 0x8000000000000000)?
    assert_eq(f64.NAN.min(2.0).to_bits(), 0x4000000000000000)?
    assert_eq((2.0).max(f64.NAN).to_bits(), 0x4000000000000000)?
    assert_eq(f64.NAN.min(f64.NAN).is_nan(), true)?
    assert_eq((5.0).clamp(0.0, 3.0).to_bits(), 0x4008000000000000)?
    assert_eq((-1.0).clamp(0.0, 3.0).to_bits(), 0x0000000000000000)?
    assert_eq(f64.NAN.clamp(0.0, 3.0).is_nan(), true)?
    assert_eq((-0.0).signum().to_bits(), 0xbff0000000000000)?
    assert_eq((0.0).signum().to_bits(), 0x3ff0000000000000)?
    assert_eq(f64.NAN.signum().is_nan(), true)?
    assert_eq((-1.75).fract().to_bits(), 0xbfe8000000000000)?
    assert_eq((1.75).fract().to_bits(), 0x3fe8000000000000)?
    assert_eq(f64.PI.to_degrees().to_bits(), 0x4066800000000000)?
    assert_eq((180.0).to_radians().to_bits(), 0x400921fb54442d18)?
    assert_eq(f64.from_bits(0x3ff8000000000000).to_bits(), 0x3ff8000000000000)?
    assert_eq(f64.from_bits(0x7ff0000000000000).is_infinite(), true)?
    assert_eq((-0.0).total_cmp(0.0).is_lt(), true)?
    assert_eq((1.0).total_cmp(1.0).is_eq(), true)?
    assert_eq(f64.from_bits(0xfff8000000000000).total_cmp(f64.NEG_INFINITY).is_lt(), true)?
    assert_eq(f64.INFINITY.total_cmp(f64.from_bits(0x7ff8000000000000)).is_lt(), true)?
    assert_eq(f32.from_bits(0x3fc00000).to_bits(), 0x3fc00000)?
}
