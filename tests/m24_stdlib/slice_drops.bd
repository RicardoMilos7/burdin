//@ run
//> 1 2 3
//> drop 1
//> drop 2
//> drop 3
//> drop 3
//> drop 1
//> drop 2
//> drop 9
//> filled
//> 9 9 9
//> drop 9
//> drop 9
//> drop 9
//> drop 1
//> drop 2
//> 7 8
//> drop 7
//> drop 8
//> drop 7
//> drop 8
//> 3 4
//> drop 3
//> drop 4
//> drop 3
//> drop 4

// The mutating slice methods move and clone elements without losing or duplicating a drop: `sort_by` only
// swaps bytes, `fill` drops each old element before storing a clone, `clone_from_slice` does the same for
// every element, and `to_list` clones into a list that drops its own copies
// (spec/stdlib.md, "Slices"; memory-rules.md, DR).

struct Token derives (Clone) {
    id: i32
}

Token: Drop {
    fn drop(mut self) {
        println("drop {self.id}")
    }
}

fn main() {
    {
        let mut arr = [Token { id: 3 }, Token { id: 1 }, Token { id: 2 }]
        let mut xs = arr[0..3]
        xs.sort_by(|a: &Token, b: &Token| a.id.cmp(b.id))
        println("{} {} {}", xs[0].id, xs[1].id, xs[2].id)
    }
    {
        let mut arr = [Token { id: 3 }, Token { id: 1 }, Token { id: 2 }]
        let mut xs = arr[0..3]
        xs.fill(Token { id: 9 })
        println("filled")
        println("{} {} {}", xs[0].id, xs[1].id, xs[2].id)
    }
    {
        let mut dest = [Token { id: 1 }, Token { id: 2 }]
        let mut xs = dest[0..2]
        let src = [Token { id: 7 }, Token { id: 8 }]
        xs.clone_from_slice(src[0..2])
        println("{} {}", dest[0].id, dest[1].id)
    }
    {
        let arr = [Token { id: 3 }, Token { id: 4 }]
        let list = arr[0..2].to_list()
        println("{} {}", list[0].id, list[1].id)
    }
}
