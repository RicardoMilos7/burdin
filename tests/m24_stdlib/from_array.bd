//@ run
//> [1, 2, 3]
//> [1, 2, 3]
//> 2 true
//> 2
//> [1, 2, 3]
//> [3, 2, 1]
//> 2 2

// A collection is built from an array literal with `from`: `List.from`, `Map.from`, and, with the type arguments
// written, `Set<T>.from`, `Deque<T>.from`, and `PriorityHeap<T>.from`. The element type comes from the array, or from
// the expected type (IT21).

fn main() {
    let list = List.from([1, 2, 3])
    println("{list:?}")

    // The expected type decides the literal's element type.
    let wide: List<i64> = List.from([1, 2, 3])
    println("{wide:?}")

    let map = Map.from([(String.from("a"), 1), (String.from("b"), 2)])
    println("{map.len()} {*map.get(String.from("a")).unwrap() == 1}")

    let typed = Map<i32, i32>.from([(1, 1), (2, 2), (1, 3)])
    println("{typed.len()}")

    let deque = Deque<i32>.from([1, 2, 3])
    println("{deque:?}")

    let heap = PriorityHeap<i32>.from([1, 3, 2])
    println("{heap.into_sorted_list():?}")

    let set = Set<String>.from([String.from("x"), String.from("y"), String.from("x")])
    let copy = List<i32>.from([7, 7])
    println("{set.len()} {copy.len()}")
}
