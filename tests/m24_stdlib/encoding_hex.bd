//@ run
//> 000f10abff
//> 000F10ABFF
//> []
//> ok 5 [000f10abff]
//> ok 0 []
//> err invalid length
//> err invalid character at byte 1
//> err invalid character at byte 2
//> Err(InvalidCharacter { index: 0 })

// `hex_encode` and `hex_decode`: two digits per byte, either case accepted when decoding, with `InvalidLength` for an
// odd count and `InvalidCharacter` (and the byte offset) for a character that is not a digit.

fn show(r: Result<List<u8>, DecodeError>) {
    match r {
        Ok(b) => {
            println("ok {b.len()} [{b.to_hex()}]")
        }
        Err(e) => {
            println("err {e}")
        }
    }
}

fn main() {
    let mut bytes = List<u8>.new()
    bytes.push(0)
    bytes.push(15)
    bytes.push(16)
    bytes.push(171)
    bytes.push(255)
    println("{}", bytes.to_hex())
    println("{}", hex_encode_upper(bytes[0..bytes.len()]))
    println("[{}]", hex_encode(bytes[0..0]))
    show(hex_decode("000f10abFF"))
    show(hex_decode(""))
    show(hex_decode("abc"))
    show(hex_decode("0g"))
    show(hex_decode("00zz"))
    println("{:?}", hex_decode("é"))
}
