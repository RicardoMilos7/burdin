//@ run
//> [9, 6, 1, 5, 2, 5]
//> b 20
//> a 30
//> c 30
//> d 30
//> a 30
//> b 20
//> c 30
//> d 30

// `sort_by_key` is stable: elements with the same key keep their order. A key may be any type that has `Ord`.

struct Person {
    name: String
    age: i32
}

fn main() {
    let mut xs = List<i32>.new()
    for x in [5, 2, 9, 1, 5, 6] {
        xs.push(x)
    }
    xs.sort_by_key(|x| *x % 3)
    println("{xs:?}")

    let mut people = List<Person>.new()
    people.push(Person { name: String.from("a"), age: 30 })
    people.push(Person { name: String.from("b"), age: 20 })
    people.push(Person { name: String.from("c"), age: 30 })
    people.push(Person { name: String.from("d"), age: 30 })
    people.sort_by_key(|p| p.age)
    for p in people {
        println("{p.name} {p.age}")
    }

    people.sort_by_key(|p| p.name.clone())
    let mut by_name = List<String>.new()
    for p in people {
        by_name.push(String.from("{p.name} {p.age}"))
    }
    for line in by_name {
        println("{line}")
    }
}
