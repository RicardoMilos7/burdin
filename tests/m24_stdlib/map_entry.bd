//@ run
//> 7
//> Some(6) Some(7)
//> 10
//> 10
//> 3
//> 8
//> Some(3) Some(1)
//> 3

// `map.entry(key)` borrows the map and returns a `MapEntry` that owns the key; `or_insert` stores a value for an
// absent key and returns a mutable view either way. `or_insert_with` calls its closure only when the key is
// absent. The entry can be held in a local between the two calls.

fn main() {
    let mut m = Map<i32, i32>.new()
    let a = m.entry(1).or_insert(0)
    *a = *a + 5
    let b = m.entry(1).or_insert(99)
    *b = *b + 1
    let c = m.entry(2).or_insert(7)
    println("{}", *c)
    println("{:?} {:?}", m.get(1), m.get(2))

    let d = m.entry(3).or_insert_with(|| 10)
    println("{}", *d)
    let e = m.entry(3).or_insert_with(|| 11)
    println("{}", *e)
    let len = m.len()
    println("{}", len)

    let pending = m.entry(4)
    let f = pending.or_insert(8)
    let got = *f
    println("{}", got)

    let mut words = Map<String, usize>.new()
    for w in ["a", "b", "a", "c", "a"] {
        let count = words.entry(w.to_string()).or_insert(0)
        *count = *count + 1
    }
    println("{:?} {:?}", words.get("a".to_string()), words.get("b".to_string()))
    println("{}", words.len())
}
