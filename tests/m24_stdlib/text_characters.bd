//@ run
//> 7 13
//> true false
//> true true false true
//> Some('λ') None
//> [(0, 'h'), (1, 'é'), (3, '中'), (6, 'x')]
//> x文é
//> éλ
//> añb

// These helpers count and index text by character, where `len` and slicing count bytes. The text mixes one-, two-,
// and three-byte characters.

fn main() {
    let s = "añb→λ文x"
    println("{s.char_count()} {s.len()}")
    println("{"abc".is_ascii()} {s.is_ascii()}")
    println("{"añ".is_char_boundary(0)} {"añ".is_char_boundary(1)} {"añ".is_char_boundary(2)} {"añ".is_char_boundary(3)}")
    println("{"aλ".nth_char(1):?} {"aλ".nth_char(2):?}")
    println("{"hé中x".char_indices():?}")
    println("{"é文x".reverse_chars()}")
    println("{"aéλ中".slice_chars(1, 3)}")
    let letters = "añb".to_char_list()
    println("{letters.collect_string()}")
}
