//@ run
//> [9, 5, 3, 1] 9
//> [9, 5, 3, 1]
//> [8, 6, 4, 2]
//> [] 0 true None
//> [3, 2, 1]
//> [2, 1] [2, 1]

// A heap is built from a list or an array, grown with `extend`, and emptied with `clear`; whichever way it is
// filled, the greatest element is first.

fn main() {
    let from_list = PriorityHeap<i32>.from_list([3, 9, 1, 5].into_iter().collect())
    println("{from_list:?} {from_list[0]}")

    let from_array = PriorityHeap<i32>.from([5, 1, 9, 3])
    println("{from_array:?}")

    let mut grown = PriorityHeap<i32>.from([4, 2])
    let more: List<i32> = [8, 6].into_iter().collect()
    grown.extend(more)
    println("{grown:?}")

    let mut emptied = PriorityHeap<i32>.from([1, 2, 3])
    emptied.clear()
    println("{emptied:?} {emptied.len()} {emptied.is_empty()} {emptied.peek():?}")
    emptied.extend_iter([2, 3, 1].into_iter())
    println("{emptied.into_sorted_list():?}")

    let mut a = PriorityHeap<i32>.new()
    a.push(1)
    a.push(2)
    let mut b = PriorityHeap<i32>.new()
    b.push(2)
    b.push(1)
    println("{a.into_sorted_list():?} {b.into_sorted_list():?}")
}
