//@ run
//> 4
//> a|b||c
//> c||b|a
//> 3 c a
//> a|b|c
//> c|b|a
//> gamma|beta|alpha
//> line3|line1
//> 2 0:ab 4:ab
//> 4:x 0:é
//> true true false true false
//> cba|éλ|ab|abc|ac
//> true true true

// Lazy text iterators (`Split`, `RSplit`, `SplitChar`, `RSplitChar`, `SplitWhitespace`, `Lines`, `MatchIndices`,
// `CharIndices`) yield `str` views or pairs directly, work on both `str` and `String` via the read-only `str`
// extension fallback, and support `DoubleEndedIterator` where order is symmetric (issue #1019).

fn join_views(own it: Split<str>): String {
    let mut it = it
    let mut out = String.new()
    let mut first = true
    loop {
        match it.next() {
            Option.Some(piece) => {
                if !first {
                    out.push('|')
                }
                out.push_str(piece)
                first = false
            }
            Option.None => break,
        }
    }
    out
}

fn main() {
    let text = String.from("a,b,,c")
    println("{text.split(",").count()}")
    println("{join_views(text.split(","))}")

    let mut rev_out = String.new()
    let mut first = true
    for piece in text.rsplit(",") {
        if !first {
            rev_out.push('|')
        }
        rev_out.push_str(piece)
        first = false
    }
    println("{rev_out}")

    // DoubleEndedIterator on `split_char`, `rsplit_char`, `split_whitespace`, `lines`, and `char_indices`.
    let mut sc = "a,b,c".split_char(',')
    let sc_count = sc.clone().count()
    let sc_back = String.from(sc.next_back().unwrap())
    let sc_front = sc.next().unwrap()
    println("{sc_count} {sc_back} {sc_front}")

    let mut parts: List<String> = "a,b,c".split_char(',').collect()
    println("{parts.join("|")}")
    let mut rparts: List<String> = "a,b,c".rsplit_char(',').collect()
    println("{rparts.join("|")}")

    let words_rev: List<String> = " alpha  beta\tgamma ".split_whitespace().rev().collect()
    println("{words_rev.join("|")}")

    let mut lines = "line1\r\nline2\nline3\n".lines()
    let last_line = String.from(lines.next_back().unwrap())
    let first_line = lines.next().unwrap()
    println("{last_line}|{first_line}")

    let mut m_count: usize = 0
    let mut m_first_off: usize = 0
    let mut m_first_txt = String.new()
    let mut m_last_off: usize = 0
    let mut m_last_txt = String.new()
    for (at, hit) in "ab--ab".find_all("ab") {
        if m_count == 0 {
            m_first_off = at
            m_first_txt = String.from(hit)
        }
        m_last_off = at
        m_last_txt = String.from(hit)
        m_count = m_count + 1
    }
    println("{m_count} {m_first_off}:{m_first_txt} {m_last_off}:{m_last_txt}")

    let mut ci = "éλx".char_indices()
    let (back_off, back_c) = ci.next_back().unwrap()
    let (front_off, front_c) = ci.next().unwrap()
    println("{back_off}:{back_c} {front_off}:{front_c}")

    // O(1) `is_char_boundary` on ASCII, multi-byte, start, end, and past-end.
    println(
        "{} {} {} {} {}",
        "éx".is_char_boundary(0),
        "éx".is_char_boundary(2),
        "éx".is_char_boundary(1),
        "éx".is_char_boundary(3),
        "éx".is_char_boundary(4),
    )

    // Optimized string editing and rebuilding.
    let mut ed = String.from("ac")
    ed.insert(1, 'b')
    let ins_s = ed.clone()
    let _ = ed.remove(1)
    let rem_s = ed.clone()
    let _ = ed.pop()
    let mut pop_s = String.from("abc")
    let _ = pop_s.pop()
    println(
        "{}|{}|{}|{}|{}",
        "abc".reverse_chars(),
        "aéλx".slice_chars(1, 3),
        pop_s,
        ins_s,
        rem_s,
    )

    // Capacity reservations avoid growth on `repeat`, `replace`, and `join`.
    let rep = "ab".repeat(10)
    let repl = "a-b-c".replace("-", "+")
    let joined = parts.join("-")
    println("{} {} {}", rep.capacity() >= 20, repl.capacity() >= 5, joined.capacity() >= 5)
}
