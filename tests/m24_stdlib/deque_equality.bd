//@ run
//> true false
//> true
//> false

// A deque is equal to another with the same elements from front to back, whatever the split between its two ends
// (issue #928).

fn main() {
    let mut a = Deque<i32>.new()
    a.push_back(2)
    a.push_front(1)
    let b = Deque<i32>.from([1, 2])
    let c = Deque<i32>.from([1, 3])
    println("{a == b} {a == c}")
    println("{a != c}")
    let short = Deque<i32>.from([1])
    println("{a == short}")
}
