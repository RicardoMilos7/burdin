//@ run
//> 5 hello
//> 3 hEYlo
//> 5
//> 5 hEYlo world
//> 6
//> 11 hEYlo world
//> 16 0 33
//> 2
//> seek error: seek to a position before the start
//> 2
//> 0 hEYlo world

// `Cursor` writes over what is at the position and grows at the end; a write past the end fills the gap with zeros.
// `seek` takes `Start`, `End`, or `Current` and returns the new position; a position before the start is
// `IoError.Seek` and changes nothing.

fn text(c: Cursor): String {
    let bytes = c.get_ref()
    from_utf8(bytes[0..bytes.len()]).unwrap()
}

fn main() {
    let mut c = Cursor.empty()
    c.write_text("hello").unwrap()
    println("{} {}", c.position().unwrap(), text(c))

    c.seek(SeekFrom.Start(1)).unwrap()
    c.write_text("EY").unwrap()
    println("{} {}", c.position().unwrap(), text(c))

    println("{}", c.seek(SeekFrom.End(0)).unwrap())
    c.write_text(" world").unwrap()
    println("{} {}", c.position().unwrap() - 6, text(c))

    println("{}", c.seek(SeekFrom.Current(-5)).unwrap())
    println("{} {}", c.get_ref().len(), text(c))

    c.seek(SeekFrom.Start(15)).unwrap()
    c.write_text("!").unwrap()
    println("{} {} {}", c.get_ref().len(), c.get_ref()[12], c.get_ref()[15])

    c.seek(SeekFrom.Start(2)).unwrap()
    println("{}", c.position().unwrap())
    match c.seek(SeekFrom.Current(-5)) {
        Ok(_) => println("unexpected"),
        Err(e) => println("seek error: {}", e),
    }
    println("{}", c.position().unwrap())

    let mut d = Cursor.from_text("hEYlo world")
    d.seek(SeekFrom.End(-3)).unwrap()
    d.rewind().unwrap()
    println("{} {}", d.position().unwrap(), d.read_to_string().unwrap())
}
