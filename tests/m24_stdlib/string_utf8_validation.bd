//@ run
//> Ok("aé😀z")
//> Ok("aé😀z")
//> Err(Invalid { index: 1 })
//> Err(Invalid { index: 1 })
//> Err(Invalid { index: 1 })
//> Err(Invalid { index: 2 })
//> Err(Invalid { index: 0 })
//> Err(Invalid { index: 0 })
//> Err(Invalid { index: 0 })
//> Err(Invalid { index: 0 })

// `String.from_utf8` and `str.from_utf8` accept exactly the well-formed UTF-8 sequences and report the offset of
// the first byte that is not part of one: a bad lead or continuation byte, an overlong form, a surrogate, a value
// past U+10FFFF, or a sequence cut off by the end.

fn bytes(values: [i32]): List<u8> {
    let mut out = List<u8>.new()
    for value in values {
        out.push(value as u8)
    }
    out
}

fn main() {
    let valid = [97, 195, 169, 240, 159, 152, 128, 122]
    let bom = bytes(valid[0..8])
    println("{:?}", str.from_utf8(bom[0..bom.len()]))
    println("{:?}", String.from_utf8(bom))

    let bad_lead = [97, 255]
    println("{:?}", String.from_utf8(bytes(bad_lead[0..2])))
    let cut_off = [97, 195]
    println("{:?}", String.from_utf8(bytes(cut_off[0..2])))
    let bad_cont = [97, 195, 65]
    println("{:?}", String.from_utf8(bytes(bad_cont[0..3])))
    let late = [97, 98, 240, 159, 152]
    println("{:?}", String.from_utf8(bytes(late[0..5])))
    let overlong = [224, 128, 128]
    println("{:?}", String.from_utf8(bytes(overlong[0..3])))
    let surrogate = [237, 160, 128]
    println("{:?}", String.from_utf8(bytes(surrogate[0..3])))
    let too_high = [244, 144, 128, 128]
    println("{:?}", String.from_utf8(bytes(too_high[0..4])))
    let stray = [128]
    println("{:?}", String.from_utf8(bytes(stray[0..1])))
}
