//@ run
//> [alpha]
//> [beta]
//> []
//> [gamma]
//> end
//> 4 lines: alpha|beta||gamma
//> [a,][bb,][ccc]
//> [x] [y]

// `read_line` drops the `\n` and the `\r` of a `\r\n`, returns `None` at the end of the input, and accepts a last
// line with no terminator. `lines` walks the same lines; `read_until` stops after a delimiter byte.

fn main() {
    let mut r = BufReader.new(Cursor.from_text("alpha\nbeta\r\n\ngamma"))
    loop {
        match r.read_line().unwrap() {
            Option.Some(line) => println("[{}]", line),
            Option.None => {
                println("end")
                break
            }
        }
    }

    let mut joined = String.new()
    let mut count = 0
    for item in BufReader.new(Cursor.from_text("alpha\nbeta\r\n\ngamma")).lines() {
        let line = item.unwrap()
        if count > 0 {
            joined.push_str("|")
        }
        joined.push_str(line)
        count = count + 1
    }
    println("{} lines: {}", count, joined)

    let mut u = BufReader.with_capacity(2, Cursor.from_text("a,bb,ccc"))
    let mut out = String.new()
    loop {
        let mut piece = List<u8>.new()
        let n = u.read_until(44, mut piece).unwrap()
        if n == 0 {
            break
        }
        out.push_str("[")
        out.push_str(from_utf8(piece[0..piece.len()]).unwrap())
        out.push_str("]")
    }
    println("{}", out)

    // A `Cursor` is a `BufRead` itself.
    let mut c = Cursor.from_text("x\ny\n")
    let first = c.read_line().unwrap().unwrap()
    let second = c.read_line().unwrap().unwrap()
    println("[{}] [{}]", first, second)
}
