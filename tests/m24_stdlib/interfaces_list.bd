//@ run
//> 0
//> true true
//> ListHolder { items: [1, 2] }

// `List<T>` implements Clone, Hash (when `T: Hash`), Default (with the default allocator), Debug (when `T: Debug`),
// and Iterable. It deliberately implements neither `Copy` nor `Eq` (`spec/stdlib.md`, "Interface coverage").

struct ListHolder derives (Clone, Hash, Default, Debug) {
    items: List<i32>
}

fn main() {
    let empty = ListHolder.default()
    println("{}", empty.items.len())
    let mut items = List<i32>.new()
    items.push(1)
    items.push(2)
    let held = ListHolder { items }
    // The cloned list owns its own buffer, and equal lists hash alike whatever their capacity.
    println("{} {}", held.hash() == held.clone().hash(), held.items.len() == 2)
    println("{:?}", held)
}
