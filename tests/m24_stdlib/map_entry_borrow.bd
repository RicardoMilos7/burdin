//@ compile-fail

// The view `or_insert` returns keeps the map exclusively borrowed until its last use, and an entry that has not
// been consumed yet holds the map too.

fn chain() {
    let mut m = Map<i32, i32>.new()
    let v = m.entry(1).or_insert(0)
    m.insert(2, 2) //~ E0111
    *v = 5
}

fn held() {
    let mut m = Map<i32, i32>.new()
    let e = m.entry(1)
    m.insert(2, 2) //~ E0111
    let v = e.or_insert(0)
    *v = 5
}

fn main() {
    chain()
    held()
}
