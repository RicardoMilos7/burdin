//@ run
//> 8 false
//> true
//> Some(3) None
//> Some(6) None
//> Some(3) Some(6) None
//> 4 1 5
//> 9 2 6
//> None
//> None
//> 0
//> true false
//> true false
//> true false
//> 3 1 4
//> 1 5 9 2 6
//> 3 7
//> 6 7
//> none
//> 8 3
//> 1 5

// The read methods of a slice: `len`, `is_empty`, `first`, `last`, the checked `get` (an index and a range),
// `contains`, `starts_with`, `ends_with`, `split_at`, `split_first`, `split_last`, `to_list`, and slicing a
// slice (spec/stdlib.md, "Slices").

fn show(xs: [i32]) {
    let mut out = String.new()
    let mut first = true
    let mut i: usize = 0
    while i < xs.len() {
        if !first {
            out.push(' ')
        }
        out.push_str(xs[i].to_string())
        first = false
        i = i + 1
    }
    println(out)
}

fn main() {
    let arr = [3, 1, 4, 1, 5, 9, 2, 6]
    let xs = arr[0..8]
    println("{} {}", xs.len(), xs.is_empty())
    println("{}", arr[2..2].is_empty())
    println("{:?} {:?}", xs.first(), arr[2..2].first())
    println("{:?} {:?}", xs.last(), arr[2..2].last())
    println("{:?} {:?} {:?}", xs.get(0), xs.get(7), xs.get(8))
    match xs.get(2..5) {
        Some(part) => show(part),
        None => println("none"),
    }
    match xs.get(5..=7) {
        Some(part) => show(part),
        None => println("none"),
    }
    match xs.get(5..2) {
        Some(_) => println("bad"),
        None => println("None"),
    }
    match xs.get(3..=9) {
        Some(_) => println("bad"),
        None => println("None"),
    }
    match xs.get(8..8) {
        Some(part) => println("{}", part.len()),
        None => println("bad"),
    }
    println("{} {}", xs.contains(4), xs.contains(7))
    println("{} {}", xs.starts_with(arr[0..3]), xs.starts_with(arr[1..3]))
    println("{} {}", xs.ends_with(arr[5..8]), xs.ends_with(arr[0..2]))
    let (head, tail) = xs.split_at(3)
    show(head)
    show(tail)
    match xs.split_first() {
        Some((first, rest)) => println("{} {}", *first, rest.len()),
        None => println("none"),
    }
    match xs.split_last() {
        Some((last, rest)) => println("{} {}", *last, rest.len()),
        None => println("none"),
    }
    match arr[2..2].split_first() {
        Some(_) => println("bad"),
        None => println("none"),
    }
    let copy = xs.to_list()
    println("{} {}", copy.len(), copy[0])
    // Slicing a slice moves by elements, not bytes.
    let inner = xs[2..6]
    show(inner[1..3])
}
