//@ run
//> true true true
//> true true
//> true true true

// The time and path types (`spec/stdlib.md`, "Interface coverage"): `Duration` is Copy, Clone, Eq, Ord, Hash,
// Default, Display, and Debug; `Instant` and `SystemTime` are Copy, Clone, Eq, Ord, Hash, Debug; `Weekday` is
// Copy, Clone, Eq, Ord, Hash, Debug, and Display; `Path` is Clone, Eq, Debug, and Display.

struct DurationHolder derives (Copy, Clone, Eq, Ord, Hash, Default, Debug) {
    value: Duration
}

struct InstantHolder derives (Copy, Clone, Eq, Ord, Hash, Debug) {
    value: Instant
}

fn main() {
    let one = DurationHolder { value: Duration.from_secs(1) }
    let two = DurationHolder { value: Duration.from_secs(2) }
    println("{} {} {}", one == one.clone(), one < two, one.hash() == DurationHolder { value: Duration.from_secs(1) }.hash())
    println("{} {}", DurationHolder.default().value.as_secs() == 0, format("{}", one.value).as_str() == "1s")
    let now = InstantHolder { value: Instant.now() }
    println(
        "{} {} {}",
        now == now.clone(),
        now.value <= Instant.now(),
        format("{:?}", Weekday.Monday).as_str() == "Monday",
    )
}
