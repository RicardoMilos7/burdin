//! Geometry helpers.
//!
//! Start with [Circle] and [shapes.Shape]; the failures are in [GeometryError], and [`Circle.area`] is the one
//! method most programs call. [Stack] holds values.

pub use shapes.{Circle, GeometryError, Point, Shape}
pub use collections.Stack
pub use shapes

/// The ratio of a circle's circumference to its diameter.
const PI: f64 = 3.14159

/// Returns the squared distance between two points.
///
/// This is cheaper than a distance because it needs no square root.
///
/// # Errors
///
/// It never fails. [Circle.new] is the call that can, with [GeometryError.NegativeRadius].
///
/// ```
/// let d = distance_squared(Point { x: 0, y: 0, tag: 0 }, Point { x: 3, y: 4, tag: 0 })
/// assert_eq(d, 25)
/// ```
fn distance_squared(a: Point, b: Point): i32 {
    let dx = a.x - b.x
    let dy = a.y - b.y
    dx * dx + dy * dy
}

fn undocumented() {}

priv fn helper(): f64 {
    PI
}
