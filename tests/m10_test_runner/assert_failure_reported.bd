//@ burdin-test passed=2 failed=1
//@ failed-test: second one fails

// A failed assert returns an error. The test is reported as failed and the others still run.
test "first passes" {
    assert_eq(1 + 1, 2)?
}

test "second one fails" {
    assert_eq(1 + 1, 3)?
}

test "third passes" {
    assert(true)?
}
