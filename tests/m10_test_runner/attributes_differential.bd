//@ burdin-test passed=3 failed=0

// A `[differential]` test body runs twice: once by the comptime interpreter while the package is compiled, and
// once as the compiled test. The test passes when both produce the same `Ok`/`Err` outcome, whether that outcome
// is `Ok` or `Err` (spec/test-runner.md).

fn sum_to(n: i32): i32 {
    let mut total = 0
    let mut i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    total
}

test "ok both ways" [differential] {
    assert_eq(sum_to(10), 55)?
}

test "error both ways" [differential] {
    assert(false)?
}

test "comptime constructs in the body" [differential] {
    comptime assert(2 + 2 == 4)
    comptime if true {
        assert_eq(sum_to(4), 10)?
    } else {
        assert(false)?
    }
}
