//@ burdin-test passed=4 failed=0

// In a test build the assertions return `AssertError`, and the message form is part of it
// (`spec/errors.md`, ERR9).

test "assert message" {
    let x = 1
    match assert(false, "x is {x}") {
        Err(e) => assert(format("{e}").contains("x is 1"))?,
        Ok(_) => assert(false)?,
    }
}

test "eq message" {
    let expected = 2
    match assert_eq(1, expected, "one is not {expected}") {
        Err(e) => {
            let text = format("{e}")
            assert(text.contains("one is not 2"))?
            assert(text.contains("1 != 2"))?
        }
        Ok(_) => assert(false)?,
    }
}

test "ne without a message" {
    let value = 1
    match assert_ne(value, 1) {
        Err(e) => assert(format("{e}").contains("1 == 1"))?,
        Ok(_) => assert(false)?,
    }
}

test "plain assert without a message" {
    match assert(true == false) {
        Err(e) => assert(format("{e}").contains("assertion failed"))?,
        Ok(_) => assert(false)?,
    }
}
