}

fuzz returns(data: [u8]): i32 { //~ E0173
    0
}

fuzz generic<T>(data: [u8]) { //~ E0173
}

fuzz twice(data: [u8]) {
}

fuzz twice(data: [u8]) { //~ E0173
}

