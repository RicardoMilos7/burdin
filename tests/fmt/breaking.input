fn generic<Key, Value, Hasher>(map: HashMap<Key, Value, Hasher>, key: Key): Option<Value> where Key: Hash + Eq + Clone + Display, Value: Clone + Debug, Hasher: Default {
    map.get(key)
}

fn short_where<T>(x: T): T where T: Copy { x }
