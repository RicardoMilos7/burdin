{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The subset of SARIF 2.1.0 that `--diagnostic-format sarif` writes",
  "description": "A closed description of what the compiler emits, so a change to the log shows up as a test failure. It is a restriction of the official SARIF 2.1.0 schema (https://json.schemastore.org/sarif-2.1.0.json), not a replacement: everything it allows, the official schema allows. Checked by tests/check_diagnostics.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "runs"],
  "properties": {
    "$schema": { "const": "https://json.schemastore.org/sarif-2.1.0.json" },
    "version": { "const": "2.1.0" },
    "runs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "columnKind", "invocations", "results"],
      "properties": {
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver"],
          "properties": { "driver": { "$ref": "#/$defs/driver" } }
        },
        "columnKind": { "const": "unicodeCodePoints" },
        "invocations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["executionSuccessful"],
            "properties": { "executionSuccessful": { "type": "boolean" } }
          }
        },
        "results": { "type": "array", "items": { "$ref": "#/$defs/result" } },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["diagnosticsNotShown"],
          "properties": { "diagnosticsNotShown": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "informationUri", "rules"],
      "properties": {
        "name": { "const": "burdin" },
        "version": { "type": "string", "minLength": 1 },
        "informationUri": { "type": "string", "pattern": "^https://" },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "shortDescription"],
      "properties": {
        "id": { "type": "string", "pattern": "^[EL][0-9]{4}$" },
        "name": { "type": "string", "minLength": 1 },
        "shortDescription": { "$ref": "#/$defs/message" },
        "helpUri": { "type": "string", "pattern": "^https://[^ ]+/(errors/E|lints/L)[0-9]{4}$" },
        "help": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "markdown"],
          "properties": { "text": { "type": "string" }, "markdown": { "type": "string" } }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "type": "string" } }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "level", "message", "locations"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^[EL][0-9]{4}$" },
        "ruleIndex": { "type": "integer", "minimum": 0 },
        "level": { "enum": ["error", "warning"] },
        "message": { "$ref": "#/$defs/message" },
        "locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/location" } },
        "relatedLocations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/related_location" } },
        "fixes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fix" } },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notes": { "type": "array", "items": { "type": "string" } },
            "help": { "type": "array", "items": { "type": "string" } },
            "fixIsMachineApplicable": { "type": "array", "items": { "type": "boolean" } }
          }
        }
      }
    },
    "artifact_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "uriBaseId": { "const": "%SRCROOT%" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startLine", "startColumn", "endLine", "endColumn", "byteOffset", "byteLength"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 },
        "byteOffset": { "type": "integer", "minimum": 0 },
        "byteLength": { "type": "integer", "minimum": 0 }
      }
    },
    "physical_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactLocation", "region"],
      "properties": {
        "artifactLocation": { "$ref": "#/$defs/artifact_location" },
        "region": { "$ref": "#/$defs/region" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalLocation"],
      "properties": { "physicalLocation": { "$ref": "#/$defs/physical_location" } }
    },
    "related_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalLocation", "id", "message"],
      "properties": {
        "physicalLocation": { "$ref": "#/$defs/physical_location" },
        "id": { "type": "integer", "minimum": 0 },
        "message": { "$ref": "#/$defs/message" }
      }
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "artifactChanges"],
      "properties": {
        "description": { "$ref": "#/$defs/message" },
        "artifactChanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifactLocation", "replacements"],
            "properties": {
              "artifactLocation": { "$ref": "#/$defs/artifact_location" },
              "replacements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["deletedRegion", "insertedContent"],
                  "properties": {
                    "deletedRegion": { "$ref": "#/$defs/region" },
                    "insertedContent": { "$ref": "#/$defs/message" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
