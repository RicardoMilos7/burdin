//@ compile-fail

// The type of a literal follows its placeholders (spec/format.md FM1): a plain literal is a `str`, and a literal with a
// placeholder is a `String`. A `str` position takes a `String` by IC1, so the interpolated literal there is a view of a
// temporary (E0122 when returned, E0123 when bound). The other positions take the other form, so each is a type
// mismatch (E0003), or, for a method that only `String` has, an unknown name (E0002).

struct Tag {
    text: String
}

fn plain_as_string(): String {
    "plain" //~ E0003
}

fn label_as_str(n: i32): str {
    "r {n}" //~ E0122
}

fn main() {
    let n = 4
    let a: str = "n = {n}" //~ E0123
    let b: String = "plain" //~ E0003
    let tag = Tag { text: "plain" } //~ E0003
    let mut s = "plain"
    s.push('x') //~ E0002
    let t: str = format("n = {n}") //~ E0123
}
