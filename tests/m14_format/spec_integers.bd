//@ run
//> [42] [   42] [42   ] [ 42  ] [   42]
//> [-42] [   -42] [-42   ] [-00042] [000042]
//> [+42] [-42] [   +42] [+00042]
//> [****42] [42****] [**42**] [--42---]
//> [18446744073709551615] [-9223372036854775808] [42]
//> [2a] [2A] [101010] [52] [0x2a] [0x2A] [0b101010] [0o52]
//> [00101010] [0x0000002a] [0b101010] [0xff] [      2a]
//> [ff] [11111111] [ffff] [ffffffd6] [8000000000000000]
//> [42] [12345]
//> [0] [0] [0] [  0]
fn main() {
    let n = 42
    let neg = -42
    let big: u64 = 18446744073709551615
    let min: i64 = -9223372036854775807 - 1
    println("[{n}] [{n:5}] [{n:<5}] [{n:^5}] [{n:>5}]")
    println("[{neg}] [{neg:6}] [{neg:<6}] [{neg:06}] [{n:06}]")
    println("[{n:+}] [{neg:+}] [{n:+6}] [{n:+06}]")
    println("[{n:*>6}] [{n:*<6}] [{n:*^6}] [{n:-^7}]")
    println("[{big}] [{min}] [{n as u8}]")
    println("[{n:x}] [{n:X}] [{n:b}] [{n:o}] [{n:#x}] [{n:#X}] [{n:#b}] [{n:#o}]")
    let ff = 255
    println("[{n:08b}] [{n:#010x}] [{n:#06b}] [{ff:#x}] [{n:8x}]")
    let small: i8 = -1
    let short: u16 = 65535
    println("[{small:x}] [{small:b}] [{short:x}] [{neg:x}] [{min:x}]")
    let wide = 12345
    println("[{n:2}] [{wide:3}]")
    let z: u8 = 0
    println("[{z}] [{z:x}] [{z:b}] [{z:3}]")
}
