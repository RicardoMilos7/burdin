//@ run
//> [1.5] [2] [-0.25] [100] [0.000001] [1000000000000000000000]
//> [2] [1.5] [1.500] [3.14] [2] [0.12]
//> [     1.5] [1.5     ] [  1.5   ] [    1.50] [00001.50] [-0000.25]
//> [+1.5] [-0.25] [+1.5] [+2]
//> [0.1] [16777216] [0.100]
//> [0.3333333333333333] [0.33333]
//> [NaN] [inf] [-inf] [   inf] [+inf]
//> [1000000000000000] [123456789.125] [0.30000000000000004]
//> [1.5] [2.0] [-0.25] [0.1]
//> [  2.5]
fn main() {
    let a = 1.5
    let b = 2.0
    let c = -0.25
    let d = 100.0
    let tiny = 0.000001
    let huge = 1.0e21
    println("[{a}] [{b}] [{c}] [{d}] [{tiny}] [{huge}]")
    println("[{a:.0}] [{a:.1}] [{a:.3}] [{3.14159:.2}] [{2.5:.0}] [{0.125:.2}]")
    println("[{a:8}] [{a:<8}] [{a:^8}] [{a:8.2}] [{a:08.2}] [{c:08.2}]")
    println("[{a:+}] [{c:+}] [{a:+.1}] [{b:+}]")
    let f: f32 = 0.1
    let g: f32 = 16777216.0
    println("[{f}] [{g}] [{f:.3}]")
    let third = 1.0 / 3.0
    println("[{third}] [{third:.5}]")
    let nan = 0.0 / 0.0
    let inf = 1.0 / 0.0
    let ninf = -1.0 / 0.0
    println("[{nan}] [{inf}] [{ninf}] [{inf:6}] [{inf:+}]")
    println("[{1.0e15}] [{123456789.125}] [{0.1 + 0.2}]")
    println("[{a:?}] [{b:?}] [{c:?}] [{f:?}]")
    println("[{2.5:5.1}]")
}
