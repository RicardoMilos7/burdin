//% stderr: warning[E0215]

// A warning does not fail the check: it is printed, and the exit status is 0.

struct Gadget {
    n: i32,
}

Gadget {
    fn label(self): String {
        String.from("method")
    }
}

fn Gadget.label(self): String {
    String.from("extension")
}

fn main() {
    let g = Gadget { n: 1 }
    println(g.label())
}
