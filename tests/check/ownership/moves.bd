struct Point derives (Clone) {
    x: i32
    y: i32
}

fn take(own p: Point) {}

fn total(a: Point, b: Point): i32 {
    a.x + b.y
}

fn main() {
    let a = Point { x: 1, y: 2 }
    let b = a
    take(b)
    let n = 7
    let m = n
    let p = Point { x: 3, y: 4 }
    let q = p.clone()
    println("{} {}", total(p, q), m)
}
