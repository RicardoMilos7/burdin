//@ compile-fail

// A `comptime for` iterates a compile-time range, array, or `List`; its binding is immutable; and `break` and
// `continue` cannot leave the unrolled body (spec/comptime.md, CT6).

fn main() {
    let n = 3
    comptime for i in 0..n { //~ E0220
        println("{i}")
    }
    comptime for mut i in 0..3 { //~ E0220
        println("{i}")
    }
    comptime for i in 0..3 {
        if i == 1 {
            break //~ E0220
        }
    }
    comptime for i in 0..3 {
        continue //~ E0220
    }
    comptime for c in "abc" { //~ E0003
    }
    comptime for i in 0..2 {
        let mut j = 0
        while j < 2 {
            j = j + 1
            if j == 1 {
                continue
            }
        }
    }
}
