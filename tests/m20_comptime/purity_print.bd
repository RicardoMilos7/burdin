//@ compile-fail
//@ stderr: printing is not allowed at compile time

// Comptime is pure: printing during compile-time evaluation is E0224, but a function that could print may run
// when the path it takes does not (spec/comptime.md, CT9).

fn noisy(loud: bool): i32 {
    if loud {
        println("hello")
    }
    7
}

const QUIET: i32 = noisy(false)
const LOUD: i32 = noisy(true) //~ E0224

fn main() {
    println("{QUIET}")
}
