//@ compile-fail

// A comptime parameter is read-only and materializable, its argument must be compile-time known, and a function
// with comptime parameters cannot be used as a value (spec/comptime.md, CT4).

fn twice(comptime n: i32): i32 {
    n * 2
}

fn bad_mut(comptime mut n: i32) { //~ E0220
}

fn bad_type(comptime xs: List<i32>) { //~ E0221
}

interface Sized {
    fn size(self, comptime n: i32): i32 //~ E0220
}

fn main() {
    let x = 3
    println("{twice(x)}") //~ E0220
    let f = twice //~ E0220
}
