//@ run
//> true true
//> true true
//> -1 -1
//> 3 3

// Derived `Clone`, `Eq`, `Ord`, and `Hash` at compile time give the run-time answers (spec/comptime.md, CT1;
// spec/derives.md).

struct Key derives (Copy, Clone, Eq, Ord, Hash) {
    a: i32
    b: u8
}

fn same_hash(): bool {
    let k1 = Key { a: 7, b: 2 }
    let k2 = k1.clone()
    k1.hash() == k2.hash() && k1 == k2
}

fn ordered(): bool {
    Key { a: 1, b: 9 } < Key { a: 2, b: 0 }
}

fn cmp_strings(): i32 {
    if "apple" < "banana" { -1 } else { 1 }
}

fn cloned_len(): usize {
    let xs = [String.from("a"), String.from("b"), String.from("c")]
    let ys = xs.clone()
    ys.len()
}

const SAME: bool = same_hash()
const ORDERED: bool = ordered()
const CMP: i32 = cmp_strings()
const CLONED: usize = cloned_len()

fn main() {
    println("{SAME} {same_hash()}")
    println("{ORDERED} {ordered()}")
    println("{CMP} {cmp_strings()}")
    println("{CLONED} {cloned_len()}")
}
