//@ compile-fail

// Unbounded recursion at compile time reaches the call-depth limit, and a recursion through a comptime parameter
// with no `comptime if` to end it reaches the specialization limit: both are E0225 (spec/comptime.md, CT4, CT11).

fn down(n: i64): i64 {
    down(n + 1)
}

fn forever(comptime n: i32): i32 {
    forever(n + 1) //~ E0225
}

fn main() {
    let x = comptime down(0) //~ E0225
    println("{forever(0)}")
}
