//@ compile-fail

// Files, the environment, processes, and C are not available at compile time (spec/comptime.md, CT9).

extern "C" {
    fn abs(x: i32): i32
}

fn args_count(): usize {
    env.args().len()
}

fn c_abs(): i32 {
    unsafe { abs(-3) }
}

fn main() {
    let text = comptime read_to_string("data.txt").is_ok() //~ E0224
    let n = comptime args_count() //~ E0224
    let a = comptime c_abs() //~ E0224
}
