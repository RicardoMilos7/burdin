//@ compile-fail
//@ stderr: dropped at the end of its scope

// Drops run at compile time where compiled code runs them (spec/comptime.md, CT12): a `Drop` implementation that
// panics shows when the value was dropped.

struct Guard {
    armed: bool
}

Guard: Drop {
    fn drop(mut self) {
        if self.armed {
            panic("dropped at the end of its scope")
        }
    }
}

fn scoped(): i32 {
    let g = Guard { armed: true }
    1
}

fn disarmed(): i32 {
    let mut g = Guard { armed: true }
    g.armed = false
    2
}

const OK: i32 = disarmed()
const BAD: i32 = scoped() //~ E0222

fn main() {
    println("{OK}")
}
