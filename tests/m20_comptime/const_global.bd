//@ run
//> 3
//> one! one
//> 42
//> 2

// Constants are copied into each use (spec/comptime.md, CT7). A `String` constant is copied into each use, so
// changing one copy leaves the next use unchanged. `static` is not a keyword, so it is still an ordinary local name
// here.

struct Config: Copy, Clone, Eq {
    limit: i32
    scale: i32
}

const LIMIT: i32 = 3
const CONFIG: Config = Config { limit: 2, scale: 21 }
const NAME: String = String.from("one")

fn scaled(): i32 {
    CONFIG.limit * CONFIG.scale
}

fn main() {
    println("{LIMIT}")
    let mut mine = NAME
    mine.push_str("!")
    println("{mine} {NAME}")
    println("{scaled()}")
    let static = CONFIG.limit
    println("{static}")
}
