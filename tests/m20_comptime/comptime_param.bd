//@ run
//> 243
//> 1
//> 1024
//> 8 16

// A `comptime` parameter takes a compile-time value, and each call is specialized for it (spec/comptime.md, CT4).
// The parameter is compile-time known in the body, so `comptime if` can end a recursion through it.

fn power(x: i64, comptime n: u32): i64 {
    comptime if n == 0 { 1 } else { x * power(x, n - 1) }
}

fn scaled(comptime factor: i32, v: i32): i32 {
    // A comptime parameter is also an ordinary read-only value at run time.
    v * factor
}

fn main() {
    println("{power(3, 5)}")
    println("{power(7, 0)}")
    println("{power(2, 10)}")
    println("{scaled(2, 4)} {scaled(4, 4)}")
}
