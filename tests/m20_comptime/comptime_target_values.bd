//@ run
//> true
//> true

// `target.os()` and `target.arch()` are ordinary functions, so comptime code and run-time code see the same target
// (spec/comptime.md, CT5).

const OS: target.Os = target.os()
const ARCH: target.Arch = target.arch()

fn main() {
    println("{OS == target.os()}")
    println("{ARCH == target.arch()}")
}
