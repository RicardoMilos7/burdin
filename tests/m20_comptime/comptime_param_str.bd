//@ run
//> [info] started
//> [warn] low disk
//> 7

// A `str` comptime parameter is copied into a static string literal (spec/comptime.md, CT3, CT4), and a struct
// value can be one too.

fn tagged(comptime tag: str, message: str): String {
    let mut out = String.from("[")
    out.push_str(tag)
    out.push_str("] ")
    out.push_str(message)
    out
}

struct Point: Copy, Clone, Eq {
    x: i32
    y: i32
}

fn manhattan(comptime p: Point): i32 {
    comptime if p.x < 0 { -p.x + p.y } else { p.x + p.y }
}

fn main() {
    println(tagged("info", "started"))
    println(tagged("warn", "low disk"))
    println("{manhattan(Point { x: 3, y: 4 })}")
}
