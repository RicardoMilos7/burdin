//@ run
//> 3 3
//> 11 11
//> circle circle
//> 6 6

// Structs, enums with payloads, tuples, nested matches with guards, `mut` parameters, and `Heap` values, at
// compile time and at run time (spec/comptime.md, CT1).

struct Point: Copy, Clone, Eq {
    x: i32
    y: i32
}

enum Shape {
    Circle(i32)
    Rect { w: i32, h: i32 }
}

fn area(s: Shape): i32 {
    match s {
        Shape.Circle(r) if r > 10 => 1000,
        Shape.Circle(r) => 3 * r * r,
        Shape.Rect { w, h } => w * h,
    }
}

fn name(s: Shape): str {
    match s {
        Shape.Circle(_) => "circle",
        _ => "rect",
    }
}

fn shift(mut p: Point, by: i32) {
    p.x = p.x + by
    p.y = p.y + by
}

fn moved(): i32 {
    let mut p = Point { x: 1, y: 0 }
    shift(mut p, 1)
    p.x + p.y
}

fn total(): i32 {
    let shapes = [Shape.Circle(1), Shape.Rect { w: 2, h: 4 }]
    let mut sum = 0
    for s in shapes {
        sum = sum + area(s)
    }
    sum
}

fn boxed(): i32 {
    let h = Heap.new((1, 2, 3))
    let (a, b, c) = *h
    a + b + c
}

const MOVED: i32 = moved()
const TOTAL: i32 = total()
const NAME: str = name(Shape.Circle(2))
const BOXED: i32 = boxed()

fn main() {
    println("{MOVED} {moved()}")
    println("{TOTAL} {total()}")
    println("{NAME} {name(Shape.Circle(2))}")
    println("{BOXED} {boxed()}")
}
