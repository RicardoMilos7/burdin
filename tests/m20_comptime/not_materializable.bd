//@ compile-fail

// Only values of materializable types can cross from compile time into the program: not a `List`, a `Map`, a
// `Heap`, or a closure (spec/comptime.md, CT3).

fn numbers(): List<i32> {
    let mut xs = List<i32>.new()
    xs.push(1)
    xs
}

const XS: List<i32> = numbers() //~ E0221

fn main() {
    let h = comptime Heap.new(1) //~ E0221
    // A `List` may be built and used inside comptime code; only the result must be materializable.
    let n: usize = comptime numbers().len()
    println("{n}")
}
