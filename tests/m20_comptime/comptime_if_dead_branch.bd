//@ run
//> fine

// The branch that is not selected is type-checked but never evaluated: its panic, failed assertion, and comptime
// expressions have no effect (spec/comptime.md, CT5).

fn boom(): i32 {
    panic("never evaluated")
}

const DEBUG: bool = false

fn main() {
    comptime if DEBUG {
        let x = comptime boom()
        comptime assert(false, "never checked")
        println("{x}")
    } else {
        println("fine")
    }
}
