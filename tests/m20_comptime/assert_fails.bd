//@ compile-fail
//@ stderr: the buffer must be a whole number of cache lines

// A failed `comptime assert` is E0223 at the assertion, with its message (spec/comptime.md, CT8).

const BUFFER_SIZE: usize = 100

comptime assert(BUFFER_SIZE % 64 == 0, "the buffer must be a whole number of cache lines") //~ E0223

fn main() {
    comptime assert(BUFFER_SIZE < 50) //~ E0223
}
