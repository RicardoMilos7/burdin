//@ run
//> 55
//> 0 1 2 3

// The branch `comptime if` does not select is not generated, so a recursion through a comptime parameter ends
// (spec/comptime.md, CT4, CT5).

fn sum_to(comptime n: u32): u32 {
    comptime if n == 0 { 0 } else { n + sum_to(n - 1) }
}

fn count_up(comptime n: i32) {
    comptime if n > 0 {
        count_up(n - 1)
        print(" ")
    }
    print("{n}")
}

fn main() {
    println("{sum_to(10)}")
    count_up(3)
    println("")
}
