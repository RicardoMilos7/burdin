//@ compile-fail

// Comptime code follows the memory rules like any other code: a moved value cannot be used again
// (spec/comptime.md, CT1).

const TWICE: String = {
    let s = String.from("a")
    let t = s
    let u = s //~ E0100
    t
}

fn main() {
    let v = comptime {
        let xs: List<i32> = List<i32>.new()
        let ys = xs
        xs.len() //~ E0100
    }
}
