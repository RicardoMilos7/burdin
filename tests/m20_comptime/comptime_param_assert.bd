//@ compile-fail
//@ stderr: the factor must be positive

// A `comptime assert` in a function with comptime parameters is checked for each specialization, at the assertion
// (spec/comptime.md, CT4, CT8).

fn scale(v: i32, comptime factor: i32): i32 {
    comptime assert(factor > 0, "the factor must be positive") //~ E0223
    v * factor
}

fn main() {
    println("{scale(1, 2)}")
    println("{scale(1, -2)}")
}
