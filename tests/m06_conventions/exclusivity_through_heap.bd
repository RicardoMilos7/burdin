//@ compile-fail

struct Pair {
    a: i32
    b: i32
}

fn swap_vals(mut x: i32, mut y: i32) {
    let t = x
    x = y
    y = t
}

// A field path does not continue through a Heap, so the pointee is one place.
fn main() {
    let mut h = Heap.new(Pair { a: 1, b: 2 })
    swap_vals(mut (*h).a, mut (*h).b) //~ E0110
}
