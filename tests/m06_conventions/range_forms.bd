//@ run
//> 6
//> 6
//> 2
//> 3
//> 4
//> 1

// `a..b` is exclusive and `a..=b` is inclusive; an inclusive range ending at the maximum integer runs once
// without overflowing the loop counter (issue #57).

fn main() {
    let mut total = 0
    for i in 0..4 {
        total = total + i
    }
    println(total.to_string())

    let mut inclusive = 0
    for i in 0..=3 {
        inclusive = inclusive + i
    }
    println(inclusive.to_string())

    for i in 2..5 {
        println(i.to_string())
    }

    let mut last = 0
    for i in 2147483647..=2147483647 {
        last = last + 1
    }
    println(last.to_string())
}
