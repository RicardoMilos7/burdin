//@ run
//> 2
//> 1
//> 20
//> 10
//> 6
//> 5

// Different fields of one local or parameter are different places, so they can be
// passed as mut in the same call. This also works through nested struct fields.

struct Pair {
    a: i32
    b: i32
}

struct Outer {
    inner: Pair
    extra: i32
}

fn show(n: i32) {
    println(n.to_string())
}

fn swap_vals(mut x: i32, mut y: i32) {
    let t = x
    x = y
    y = t
}

fn swap_fields(mut p: Pair) {
    swap_vals(mut p.a, mut p.b)     // a parameter works the same way
}

fn main() {
    let mut p = Pair { a: 1, b: 2 }
    swap_vals(mut p.a, mut p.b)
    show(p.a)
    show(p.b)

    let mut o = Outer { inner: Pair { a: 10, b: 20 }, extra: 0 }
    swap_vals(mut o.inner.a, mut o.inner.b)
    show(o.inner.a)
    show(o.inner.b)

    let mut q = Pair { a: 5, b: 6 }
    swap_fields(mut q)
    show(q.a)
    show(q.b)
}
