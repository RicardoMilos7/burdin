//@ run

// Every scalar of the data model, at every width, plus bytes (spec/serialization.md, SER1, SER2, SER14). The
// hand-written impl calls the per-shape helpers; the compiler's generated impls call the same functions.

struct EveryScalar: Debug {
    unit: ()
    b: bool
    i8v: i8
    i16v: i16
    i32v: i32
    i64v: i64
    isizev: isize
    u8v: u8
    u16v: u16
    u32v: u32
    u64v: u64
    usizev: usize
    f32v: f32
    f64v: f64
    c: char
    s: String
    bytes: List<u8>
}

EveryScalar: Serialize {
    fn serialize<S: Serializer>(self, mut s: S): Result<(), DeError> {
        s.begin_struct("EveryScalar", 17)?
        s.struct_field("unit")?
        serialize_unit(mut s)?
        s.struct_field("b")?
        serialize_bool(mut s, self.b)?
        s.struct_field("i8v")?
        serialize_i8(mut s, self.i8v)?
        s.struct_field("i16v")?
        serialize_i16(mut s, self.i16v)?
        s.struct_field("i32v")?
        serialize_i32(mut s, self.i32v)?
        s.struct_field("i64v")?
        serialize_i64(mut s, self.i64v)?
        s.struct_field("isizev")?
        serialize_isize(mut s, self.isizev)?
        s.struct_field("u8v")?
        serialize_u8(mut s, self.u8v)?
        s.struct_field("u16v")?
        serialize_u16(mut s, self.u16v)?
        s.struct_field("u32v")?
        serialize_u32(mut s, self.u32v)?
        s.struct_field("u64v")?
        serialize_u64(mut s, self.u64v)?
        s.struct_field("usizev")?
        serialize_usize(mut s, self.usizev)?
        s.struct_field("f32v")?
        serialize_f32(mut s, self.f32v)?
        s.struct_field("f64v")?
        serialize_f64(mut s, self.f64v)?
        s.struct_field("c")?
        serialize_char(mut s, self.c)?
        s.struct_field("s")?
        serialize_str(mut s, self.s.as_str())?
        s.struct_field("bytes")?
        serialize_bytes(mut s, self.bytes.as_slice())?
        s.end_struct()
    }
}

EveryScalar: Deserialize {
    fn deserialize<D: Deserializer>(mut d: D): Result<EveryScalar, DeError> {
        d.begin_struct("EveryScalar")?
        let mut unit: () = ()
        let mut b: bool = false
        let mut i8v: i8 = 0
        let mut i16v: i16 = 0
        let mut i32v: i32 = 0
        let mut i64v: i64 = 0
        let mut isizev: isize = 0
        let mut u8v: u8 = 0
        let mut u16v: u16 = 0
        let mut u32v: u32 = 0
        let mut u64v: u64 = 0
        let mut usizev: usize = 0
        let mut f32v: f32 = 0.0
        let mut f64v: f64 = 0.0
        let mut c: char = '\0'
        let mut s = String.new()
        let mut bytes = List<u8>.new()
        loop {
            let more = d.has_next_field()?
            if !more {
                break
            }
            let name = d.field_name()?
            if name.as_str() == "unit" {
                unit = deserialize_unit(mut d)?
            } else if name.as_str() == "b" {
                b = deserialize_bool(mut d)?
            } else if name.as_str() == "i8v" {
                i8v = deserialize_i8(mut d)?
            } else if name.as_str() == "i16v" {
                i16v = deserialize_i16(mut d)?
            } else if name.as_str() == "i32v" {
                i32v = deserialize_i32(mut d)?
            } else if name.as_str() == "i64v" {
                i64v = deserialize_i64(mut d)?
            } else if name.as_str() == "isizev" {
                isizev = deserialize_isize(mut d)?
            } else if name.as_str() == "u8v" {
                u8v = deserialize_u8(mut d)?
            } else if name.as_str() == "u16v" {
                u16v = deserialize_u16(mut d)?
            } else if name.as_str() == "u32v" {
                u32v = deserialize_u32(mut d)?
            } else if name.as_str() == "u64v" {
                u64v = deserialize_u64(mut d)?
            } else if name.as_str() == "usizev" {
                usizev = deserialize_usize(mut d)?
            } else if name.as_str() == "f32v" {
                f32v = deserialize_f32(mut d)?
            } else if name.as_str() == "f64v" {
                f64v = deserialize_f64(mut d)?
            } else if name.as_str() == "c" {
                c = deserialize_char(mut d)?
            } else if name.as_str() == "s" {
                s = deserialize_str(mut d)?
            } else if name.as_str() == "bytes" {
                bytes = deserialize_bytes(mut d)?
            } else {
                let failure = unknown_field(name.as_str())
                return Result.Err(failure.field(name.as_str()))
            }
        }
        d.end_struct()?
        Result.Ok(EveryScalar {
            unit,
            b,
            i8v,
            i16v,
            i32v,
            i64v,
            isizev,
            u8v,
            u16v,
            u32v,
            u64v,
            usizev,
            f32v,
            f64v,
            c,
            s,
            bytes,
        })
    }
}

fn main() {
    let mut bytes = List<u8>.new()
    bytes.push(1)
    bytes.push(2)
    bytes.push(3)
    let value = EveryScalar {
        unit: (),
        b: true,
        i8v: -8,
        i16v: -16,
        i32v: -32,
        i64v: -64,
        isizev: -1,
        u8v: 8,
        u16v: 16,
        u32v: 32,
        u64v: 64,
        usizev: 1,
        f32v: 1.5,
        f64v: 2.5,
        c: 'z',
        s: "text".to_string(),
        bytes,
    }
    let text = to_text(value).unwrap()
    println(text)
    let read: Result<EveryScalar, DeError> = from_text(text)
    println("{:?}", read.unwrap())
}

//> EveryScalar { unit: (), b: true, i8v: -8, i16v: -16, i32v: -32, i64v: -64, isizev: -1, u8v: 8, u16v: 16, u32v: 32, u64v: 64, usizev: 1, f32v: 1.5, f64v: 2.5, c: 'z', s: "text", bytes: [1, 2, 3] }
//> EveryScalar { unit: (), b: true, i8v: -8, i16v: -16, i32v: -32, i64v: -64, isizev: -1, u8v: 8, u16v: 16, u32v: 32, u64v: 64, usizev: 1, f32v: 1.5, f64v: 2.5, c: 'z', s: "text", bytes: [1, 2, 3] }