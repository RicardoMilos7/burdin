//@ run
//> circle
//> 12
//> rect
//> 12
//> square
//> 25
//> point
//> 0

enum Shape derives (Copy, Clone) {
    Circle(i32)
    Rect { w: i32, h: i32 }
    Point
}

fn show(n: i32) {
    println(n.to_string())
}

fn area(s: Shape): i32 {
    match s {
        Shape.Circle(r) => 3 * r * r,
        Shape.Rect { w, h } => w * h,
        Shape.Point => 0,
    }
}

fn name(s: Shape): str {
    match s {
        Shape.Circle(_) => "circle",
        Shape.Rect { w, h } => if w == h { "square" } else { "rect" },
        Shape.Point => "point",
    }
}

fn main() {
    let shapes = [Shape.Circle(2), Shape.Rect { w: 3, h: 4 }, Shape.Rect { w: 5, h: 5 }, Shape.Point]
    for s in shapes {
        println(name(s))
        show(area(s))
    }
}
