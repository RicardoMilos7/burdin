//@ run
//> every file operation finished
//> done

// Many tasks reading and writing files at once: every operation goes through the helper pool, and the results must
// all come back (spec/io.md, IO3). The runner repeats this test in CI.

fn work(index: usize) {
    let mut name = "stress-".to_string()
    name.push_str(index.to_string().as_str())
    name.push_str(".txt")
    let mut file = fs.File.create(name.as_str()).unwrap()
    let data = "0123456789".to_utf8()
    file.write_all(data[0..data.len()]).unwrap()
    let mut read = fs.File.open(name.as_str()).unwrap()
    let mut buf = List<u8>.new()
    let n = read.read(mut buf, 64).unwrap()
    if n != 10 {
        panic("a stress file came back short")
    }
    let mut options = fs.OpenOptions.new()
    options.write(true)
    options.truncate(true)
    let mut again = options.open(name.as_str()).unwrap()
    again.write_all(data[0..data.len()]).unwrap()
    fs.remove_file(name.as_str()).unwrap()
}

fn main() {
    task.set_workers(4)
    let mut handles = List<JoinHandle<()>>.new()
    let mut i: usize = 0
    while i < 8 {
        let handle = task.spawn(|| work(i))
        handles.push(handle)
        i = i + 1
    }
    while handles.len() > 0 {
        let h = handles.pop().unwrap()
        h.join()
    }
    println("every file operation finished")
    println("done")
}
