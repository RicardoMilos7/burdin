//@ run
//> value 7
//> timed out
//> done

// A channel receive with a watchdog: a second task sleeps and then signals a second channel, and a `select` waits
// on both. This is the timeout pattern the asynchronous I/O tests use (spec/io.md, IO7).

fn main() {
    task.set_workers(2)
    let work = Channel<i32>.bounded(1)
    let timer = Channel<()>.bounded(1)
    let worker = work.clone()
    task.spawn(|| {
        time.sleep(Duration.from_millis(30))
        let _ = worker.send(7)
    })
    let tick = timer.clone()
    task.spawn(|| {
        time.sleep(Duration.from_millis(300))
        let _ = tick.send(())
    })
    select {
        v = work.recv() => match v {
            Option.Some(n) => println("value {}", n),
            Option.None => println("closed"),
        }
        _ = timer.recv() => println("timed out"),
    }
    // The timer channel never fires within the second select, so its arm is the timeout.
    let idle = Channel<i32>.bounded(1)
    select {
        v = idle.recv() => match v {
            Option.Some(n) => println("value {}", n),
            Option.None => println("closed"),
        }
        _ = timer.recv() => println("timed out"),
    }
    println("done")
}
