//@ run
//> client got 5 bytes: hello
//> done

// A server task accepts a connection and echoes it, and a client task sends a line and reads it back. The test is
// hermetic: localhost and a port the system assigns (spec/io.md, IO5; issue #225).

fn main() {
    task.set_workers(2)
    let listener = net.TcpListener.bind("127.0.0.1:0").unwrap()
    let port = listener.local_addr().unwrap().port()
    let mut target = "127.0.0.1:".to_string()
    target.push_str(port.to_string().as_str())
    task.scope(|s| {
        s.spawn(|| {
            let (mut conn, _peer) = listener.accept().unwrap()
            let mut buf = List<u8>.new()
            let n = conn.read(mut buf, 5).unwrap()
            conn.write_all(buf[0..n]).unwrap()
            conn.close().unwrap()
        })
        s.spawn(|| {
            let mut client = net.TcpStream.connect(target.clone()).unwrap()
            let data = "hello".to_utf8()
            client.write_all(data[0..data.len()]).unwrap()
            let mut reply = List<u8>.new()
            let n = client.read(mut reply, 16).unwrap()
            let text = from_utf8(reply[0..n]).unwrap()
            println("client got {} bytes: {}", n, text)
            client.close().unwrap()
        })
    })
    println("done")
}
