//@ run
//> 5
//> hello
//> hello

// The C bridge words: `CString.from`, `as_ptr`, `CStr.to_string`, and `CPtr.null`. A raw pointer is only
// used inside `unsafe`.

extern "C" {
    fn strlen(s: CPtr<CChar>): CSize
}

fn main() {
    let text = CString.from("hello")
    unsafe {
        let null: CPtr<CChar> = CPtr.null()
        let len = strlen(text.as_ptr())
        println(len.to_string())
        println(CStr.to_string(text.as_ptr()))
        println(CStr.to_string(text.as_ptr()))
        let _ = null
    }
}
