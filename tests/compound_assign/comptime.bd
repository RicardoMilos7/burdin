//@ run
//> 55
//> 3

// Compound assignment in `comptime` evaluation has the run-time rules (spec/compound-assignment.md, CA6).

fn sum_to(n: i32): i32 {
    let mut total = 0
    let mut i = 1
    while i <= n {
        total += i
        i += 1
    }
    total
}

fn main() {
    let t = comptime { sum_to(10) }
    println("{t}")
    let bits = comptime {
        let mut b = 1
        b <<= 1
        b |= 1
        b
    }
    println("{bits}")
}
