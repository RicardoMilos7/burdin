//@ run
//> 1024
//> -4
//> 12
//> 25
//> 8

// The shift operators take an integer amount of any integer type, as `<<` and `>>` do, and `>>=` on a signed value is
// an arithmetic shift (spec/compound-assignment.md, CA3).

fn main() {
    let mut a: i64 = 1
    let k: u8 = 10
    a <<= k
    println("{a}")

    let mut b: i32 = -16
    let two: u32 = 2
    b >>= two
    println("{b}")

    let mut c: u8 = 3
    c <<= 2
    println("{c}")

    let mut d: u8 = 200
    d >>= 3
    println("{d}")

    let mut e: i64 = 1
    let amt: i64 = 3
    e <<= amt
    println("{e}")
}
