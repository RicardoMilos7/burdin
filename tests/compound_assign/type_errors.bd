//@ compile-fail

// Each operand must have the type the binary operator needs (spec/compound-assignment.md, CA3). A `String` and a tuple
// have no such operator, so they are E0003 too (CA5).

fn main() {
    let mut i = 1
    i += 2.5 //~ E0003
    let mut b = true
    b += true //~ E0003
    let mut f = 1.0
    f &= 2.0 //~ E0003
    let mut k: i32 = 1
    k <<= 1.5 //~ E0003
    k += true //~ E0003
    let mut s = String.from("a")
    s += "b" //~ E0003
    let mut t = (1, 2)
    t += (3, 4) //~ E0003
    println("{i} {k} {s} {t.0}")
}
