{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "burdin",
      "camelcase": "Burdin",
      "scope": "source.burdin",
      "path": ".",
      "file-types": ["bd"],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "Burdin grammar for tree-sitter, for highlighting",
    "links": { "repository": "https://github.com/RicardoMilos7/burdin" }
  },
  "bindings": { "c": false, "go": false, "node": false, "python": false, "rust": false, "swift": false }
}
