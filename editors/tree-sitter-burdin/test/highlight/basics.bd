/// A shape.
// <- comment.doc
enum Shape { Circle(f64), Square(f64) }
// <- keyword
//   ^ type
//           ^ constructor
//                  ^ type.builtin

fn Shape.area(self): f64 {
// <- keyword
// ^ type
//       ^ function
//            ^ variable.special
    match self {
//  ^ keyword
        Shape.Circle(r) => 3.14 * r * r,
//            ^ constructor
//                         ^ number
//                              ^ operator
        Shape.Square(s) => s * s,
    }
}

