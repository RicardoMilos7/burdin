enum Color {
    Red
    Green
}

struct Point {
    x: i32
    y: i32
}

Point {
    fn new(x: i32, y: i32): Point {
        .{ x, y }
    }
}

fn name(c: Color): str {
    match c {
        Color.Red => "red",
        Color.Green => "green",
    }
}

fn main() {
    let explicit = Color.Green
    let leading: Color = .Green
    println(name(.Red))
    let p: Point = .new(1, 2)
    let q: Point = .{ x: 3, y: 4 }
    let r = Point { x: 5, y: 6 }
    println("{p.x} {q.x} {r.x} {name(explicit)} {name(leading)}")
}
