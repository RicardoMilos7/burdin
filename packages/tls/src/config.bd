use certs.{Certificate, PrivateKey, TrustStore}
use errors.TlsError
// Client and server configuration (spec/tls.md, TLS3).
//
// A configuration owns an OpenSSL `SSL_CTX`, which every connection made with it shares (a connection keeps its own
// reference, so a configuration may be dropped while its connections live). It is built once, on one task, with the
// builder methods below, and is then only read: that is why it may be shared between tasks.

use features
use ffi.{bytes_ptr, clear_errors, error_text, no_openssl, or_else}
use openssl.{
    OpenSSL_version_num,
    SSL_CTRL_EXTRA_CHAIN_CERT,
    SSL_CTRL_SET_MAX_PROTO_VERSION,
    SSL_CTRL_SET_MIN_PROTO_VERSION,
    SSL_CTX_check_private_key,
    SSL_CTX_ctrl,
    SSL_CTX_free,
    SSL_CTX_get_cert_store,
    SSL_CTX_new,
    SSL_CTX_set_alpn_protos,
    SSL_CTX_set_default_verify_paths,
    SSL_CTX_set_verify,
    SSL_CTX_use_PrivateKey,
    SSL_CTX_use_certificate,
    SSL_VERIFY_FAIL_IF_NO_PEER_CERT,
    SSL_VERIFY_NONE,
    SSL_VERIFY_PEER,
    SslCtx,
    TLS1_2_VERSION,
    TLS1_3_VERSION,
    TLS_client_method,
    TLS_server_method,
    X509_STORE_add_cert,
    X509_up_ref,
}
use schannel.{
    CertContext,
    KeyBlock,
    MODE_SKIP,
    WinConfig,
    config_free,
    config_new,
    config_set_alpn,
    config_set_identity,
    config_set_trust,
    config_set_version,
}

/// A protocol version a configuration can require. SSL 3, TLS 1.0, and TLS 1.1 are not available.
///
/// ```
/// # use tls
/// # use tls.{TlsVersion}
/// let version = TlsVersion.Tls13
/// assert(version == TlsVersion.Tls13)
/// assert(TlsVersion.Tls12 != TlsVersion.Tls13)
/// ```
enum TlsVersion: Copy, Clone, Eq, Debug {
    Tls12,
    Tls13,
}

TlsVersion {
    priv fn code(self): i64 {
        match self {
            TlsVersion.Tls12 => TLS1_2_VERSION,
            TlsVersion.Tls13 => TLS1_3_VERSION,
        }
    }
}

/// A new context with TLS 1.2 as the lowest version. The library must be OpenSSL 3 or later.
priv unsafe fn new_ctx(server: bool): Result<CPtr<SslCtx>, TlsError> {
    if target.os() == target.Os.Windows {
        // On Windows the "context" is the configuration of schannel.bd.
        let cfg = config_new(server)
        if cfg.is_null() {
            return Err(TlsError.Config("out of memory".to_string()))
        }
        Ok(cfg as CPtr<SslCtx>)
    } else if features.openssl {
        if (OpenSSL_version_num() >> 28) < 3 {
            return Err(TlsError.Unsupported("the linked OpenSSL is older than 3.0".to_string()))
        }
        let ctx = if server { SSL_CTX_new(TLS_server_method()) } else { SSL_CTX_new(TLS_client_method()) }
        if ctx.is_null() {
            return Err(TlsError.Config(or_else(error_text(), "cannot create an SSL context")))
        }
        if SSL_CTX_ctrl(ctx, SSL_CTRL_SET_MIN_PROTO_VERSION, TLS1_2_VERSION, CPtr.null()) != 1 {
            SSL_CTX_free(ctx)
            return Err(TlsError.Config("cannot set the minimum protocol version".to_string()))
        }
        Ok(ctx)
    } else {
        Err(no_openssl())
    }
}

/// Gives `ctx` the roots of `trust`.
priv unsafe fn apply_trust(ctx: CPtr<SslCtx>, trust: TrustStore): Result<(), TlsError> {
    if target.os() == target.Os.Windows {
        let mut roots = List<CPtr<CertContext>>.new()
        for cert in trust.roots.iter() {
            roots.push(cert.handle as CPtr<CertContext>)
        }
        if !config_set_trust(ctx as CPtr<WinConfig>, trust.use_system, roots) {
            return Err(TlsError.Config("cannot load the trust store".to_string()))
        }
        Ok(())
    } else if features.openssl {
        if trust.use_system {
            if SSL_CTX_set_default_verify_paths(ctx) != 1 {
                clear_errors()
                return Err(TlsError.Config("cannot load the system trust store".to_string()))
            }
        }
        let store = SSL_CTX_get_cert_store(ctx)
        for cert in trust.roots.iter() {
            let _ = X509_STORE_add_cert(store, cert.handle)
        }
        // Adding a certificate the store already has is not an error, but may leave a note in the queue.
        clear_errors()
        Ok(())
    } else {
        Err(no_openssl())
    }
}

priv unsafe fn set_version(ctx: CPtr<SslCtx>, command: i32, version: TlsVersion): Result<(), TlsError> {
    if target.os() == target.Os.Windows {
        let code: u32 = if version.code() == TLS1_2_VERSION { 0 } else { 1 }
        if !config_set_version(ctx as CPtr<WinConfig>, command == SSL_CTRL_SET_MIN_PROTO_VERSION, code) {
            return Err(TlsError.Config("the protocol version range is empty".to_string()))
        }
        Ok(())
    } else if features.openssl {
        if SSL_CTX_ctrl(ctx, command, version.code(), CPtr.null()) != 1 {
            clear_errors()
            return Err(TlsError.Config("the protocol version range is empty".to_string()))
        }
        Ok(())
    } else {
        Err(no_openssl())
    }
}

/// The ALPN protocol list in its wire form: each name preceded by its length.
priv fn alpn_wire(protocols: List<String>): Result<List<u8>, TlsError> {
    let mut wire = List<u8>.new()
    for name in protocols.iter() {
        let bytes = name.as_bytes()
        if bytes.len() == 0 || bytes.len() > 255 {
            return Err(TlsError.Config("an ALPN protocol name must be 1 to 255 bytes".to_string()))
        }
        wire.push(bytes.len() as u8)
        wire.extend_from_slice(bytes)
    }
    Ok(wire)
}

priv unsafe fn set_alpn(ctx: CPtr<SslCtx>, protocols: List<String>): Result<(), TlsError> {
    if target.os() == target.Os.Windows {
        let wire = alpn_wire(protocols)?
        if !config_set_alpn(ctx as CPtr<WinConfig>, wire[0..wire.len()]) {
            return Err(TlsError.Config("cannot set the ALPN protocols".to_string()))
        }
        Ok(())
    } else if features.openssl {
        let wire = alpn_wire(protocols)?
        if wire.len() == 0 {
            return Ok(())
        }
        // `SSL_CTX_set_alpn_protos` returns 0 on success.
        if SSL_CTX_set_alpn_protos(ctx, bytes_ptr(wire[0..wire.len()]), wire.len() as u32) != 0 {
            clear_errors()
            return Err(TlsError.Config("cannot set the ALPN protocols".to_string()))
        }
        Ok(())
    } else {
        Err(no_openssl())
    }
}

/// Installs a certificate chain (leaf first) and its key, and checks that they belong together.
priv unsafe fn use_identity(ctx: CPtr<SslCtx>, chain: List<Certificate>, key: PrivateKey): Result<(), TlsError> {
    if target.os() == target.Os.Windows {
        let mut contexts = List<CPtr<CertContext>>.new()
        for cert in chain.iter() {
            contexts.push(cert.handle as CPtr<CertContext>)
        }
        config_set_identity(ctx as CPtr<WinConfig>, contexts, key.handle as CPtr<KeyBlock>)
    } else if features.openssl {
        if chain.is_empty() {
            return Err(TlsError.BadCertificate("the certificate chain is empty".to_string()))
        }
        if SSL_CTX_use_certificate(ctx, chain[0].handle) != 1 {
            return Err(TlsError.BadCertificate(or_else(error_text(), "cannot use the certificate")))
        }
        let mut at: usize = 1
        while at < chain.len() {
            // `SSL_CTRL_EXTRA_CHAIN_CERT` takes ownership of one reference, so give it one.
            if X509_up_ref(chain[at].handle) != 1 {
                return Err(TlsError.BadCertificate("cannot use an intermediate certificate".to_string()))
            }
            if SSL_CTX_ctrl(ctx, SSL_CTRL_EXTRA_CHAIN_CERT, 0, chain[at].handle as CPtr<u8>) != 1 {
                return Err(TlsError.BadCertificate(or_else(error_text(), "cannot use an intermediate certificate")))
            }
            at = at + 1
        }
        if SSL_CTX_use_PrivateKey(ctx, key.handle) != 1 {
            let reason = error_text()
            if reason.contains("match") {
                return Err(TlsError.KeyMismatch)
            }
            return Err(TlsError.BadKey(or_else(reason, "cannot use the private key")))
        }
        if SSL_CTX_check_private_key(ctx) != 1 {
            clear_errors()
            return Err(TlsError.KeyMismatch)
        }
        Ok(())
    } else {
        Err(no_openssl())
    }
}

// ----- the client -----------------------------------------------------------------------------------------------

/// How a client connection is set up. The defaults verify the server's certificate chain against the system's trust
/// store and its name against the host connected to, require TLS 1.2 or later, and offer no ALPN protocol.
///
/// WARNING: `insecure_skip_verify` turns verification off. A connection made with it is encrypted but talks to
/// anyone. It exists to prove that verification is what rejects the connections in this package's tests.
///
/// ```
/// # use tls
/// # use tls.{ClientConfig, TlsVersion}
/// let mut config = ClientConfig.new().unwrap()
/// config.min_version(TlsVersion.Tls12).unwrap()
/// assert(!config.skips_verification())
/// ```
struct ClientConfig {
    priv ctx: CPtr<SslCtx>,
    priv skip_verify: bool,
}

unsafe ClientConfig: Send {}
unsafe ClientConfig: Sync {}

ClientConfig {
    /// A configuration that trusts the system's authorities.
    ///
    /// ```
    /// # use tls
    /// # use tls.{ClientConfig}
    /// let config = ClientConfig.new().unwrap()
    /// assert(!config.skips_verification())
    /// ```
    fn new(): Result<ClientConfig, TlsError> {
        ClientConfig.with_trust(TrustStore.system())
    }

    /// A configuration that trusts exactly the authorities of `trust`.
    ///
    /// ```
    /// # use tls
    /// # use tls.{ClientConfig, TrustStore}
    /// # let cert_pem = "-----BEGIN CERTIFICATE-----\nMIIBczCCARigAwIBAgIBCDAKBggqhkjOPQQDAjAUMRIwEAYDVQQDDAlsb2NhbGhv\nc3QwIBcNMjUxMTIxMTYwMDQ1WhgPMjEyNjEwMjgxNjAwNDVaMBQxEjAQBgNVBAMM\nCWxvY2FsaG9zdDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABLNTRhI9deSqQkH/\nNiFLg+Fe/zaKJC7lI8UTOi2V68Uc3izmbXb5WUJ8AqS+A6igo5a2sQwa94QknXaZ\n83d2N1+jWTBXMAwGA1UdEwEB/wQCMAAwHQYDVR0OBBYEFOcIZAeKeTy0tqIDOlRa\nDO1kZAnzMCgGA1UdEQQhMB+CCWxvY2FsaG9zdIIMZXhhbXBsZS50ZXN0hwR/AAAB\nMAoGCCqGSM49BAMCA0kAMEYCIQDEfYToC6DvEmFBBk0+z914XNS5Vl0O/qrhwl5I\nOvX3UAIhAM64DLHDSAdQc1r4kNgrRuoIGxh+XzAM8JpUn60qQ4DQ\n-----END CERTIFICATE-----\n"
    /// let mut trust = TrustStore.empty()
    /// trust.add_pem(cert_pem).unwrap()
    /// let config = ClientConfig.with_trust(trust).unwrap()
    /// assert(!config.skips_verification())
    /// ```
    fn with_trust(trust: TrustStore): Result<ClientConfig, TlsError> {
        if target.os() == target.Os.Windows {
            unsafe {
                let ctx = new_ctx(false)?
                match apply_trust(ctx, trust) {
                    Ok(()) => {}
                    Err(failure) => {
                        config_free(ctx as CPtr<WinConfig>)
                        return Err(failure)
                    }
                }
                Ok(ClientConfig { ctx: ctx, skip_verify: false })
            }
        } else if features.openssl {
            unsafe {
                let ctx = new_ctx(false)?
                SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, CPtr.null())
                match apply_trust(ctx, trust) {
                    Ok(()) => {}
                    Err(failure) => {
                        SSL_CTX_free(ctx)
                        return Err(failure)
                    }
                }
                Ok(ClientConfig { ctx: ctx, skip_verify: false })
            }
        } else {
            Err(no_openssl())
        }
    }

    /// The lowest protocol version the client accepts (TLS 1.2 unless raised).
    ///
    /// ```
    /// # use tls
    /// # use tls.{ClientConfig, TlsVersion}
    /// let mut config = ClientConfig.new().unwrap()
    /// config.min_version(TlsVersion.Tls13).unwrap()
    /// ```
    fn min_version(mut self, version: TlsVersion): Result<(), TlsError> {
        unsafe { set_version(self.ctx, SSL_CTRL_SET_MIN_PROTO_VERSION, version) }
    }

    /// The highest protocol version the client offers.
    ///
    /// ```
    /// # use tls
    /// # use tls.{ClientConfig, TlsVersion}
    /// let mut config = ClientConfig.new().unwrap()
    /// config.max_version(TlsVersion.Tls13).unwrap()
    /// ```
    fn max_version(mut self, version: TlsVersion): Result<(), TlsError> {
        unsafe { set_version(self.ctx, SSL_CTRL_SET_MAX_PROTO_VERSION, version) }
    }

    /// The application protocols to offer, most preferred first (`h2`, `http/1.1`). `TlsStream.alpn_protocol` reports
    /// the one the server chose, if any.
    ///
    /// ```
    /// # use tls
    /// # use tls.{ClientConfig}
    /// let mut config = ClientConfig.new().unwrap()
    /// let mut protocols = List<String>.new()
    /// protocols.push("h2".to_string())
    /// protocols.push("http/1.1".to_string())
    /// config.alpn(protocols).unwrap()
    /// ```
    fn alpn(mut self, protocols: List<String>): Result<(), TlsError> {
        unsafe { set_alpn(self.ctx, protocols) }
    }

    /// The certificate chain (leaf first) and key to present when the server asks for a client certificate.
    ///
    /// ```
    /// # use tls
    /// # use tls.{Certificate, ClientConfig, PrivateKey}
    /// # let cert_pem = "-----BEGIN CERTIFICATE-----\nMIIBczCCARigAwIBAgIBCDAKBggqhkjOPQQDAjAUMRIwEAYDVQQDDAlsb2NhbGhv\nc3QwIBcNMjUxMTIxMTYwMDQ1WhgPMjEyNjEwMjgxNjAwNDVaMBQxEjAQBgNVBAMM\nCWxvY2FsaG9zdDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABLNTRhI9deSqQkH/\nNiFLg+Fe/zaKJC7lI8UTOi2V68Uc3izmbXb5WUJ8AqS+A6igo5a2sQwa94QknXaZ\n83d2N1+jWTBXMAwGA1UdEwEB/wQCMAAwHQYDVR0OBBYEFOcIZAeKeTy0tqIDOlRa\nDO1kZAnzMCgGA1UdEQQhMB+CCWxvY2FsaG9zdIIMZXhhbXBsZS50ZXN0hwR/AAAB\nMAoGCCqGSM49BAMCA0kAMEYCIQDEfYToC6DvEmFBBk0+z914XNS5Vl0O/qrhwl5I\nOvX3UAIhAM64DLHDSAdQc1r4kNgrRuoIGxh+XzAM8JpUn60qQ4DQ\n-----END CERTIFICATE-----\n"
    /// # let key_pem = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg1tyNCLqQEA/R2tKM\n+KnOalrrIjLeUShT6y4KcwRTObehRANCAASzU0YSPXXkqkJB/zYhS4PhXv82iiQu\n5SPFEzotlevFHN4s5m12+VlCfAKkvgOooKOWtrEMGveEJJ12mfN3djdf\n-----END PRIVATE KEY-----\n"
    /// let mut config = ClientConfig.new().unwrap()
    /// let chain = Certificate.chain_from_pem(cert_pem).unwrap()
    /// let key = PrivateKey.from_pem(key_pem).unwrap()
    /// config.client_certificate(chain, key).unwrap()
    /// ```
    fn client_certificate(mut self, chain: List<Certificate>, key: PrivateKey): Result<(), TlsError> {
        unsafe { use_identity(self.ctx, chain, key) }
    }

    /// Turns certificate and hostname verification off. See the warning on `ClientConfig`.
    ///
    /// ```
    /// # use tls
    /// # use tls.{ClientConfig}
    /// let mut config = ClientConfig.new().unwrap()
    /// config.insecure_skip_verify()
    /// assert(config.skips_verification())
    /// ```
    fn insecure_skip_verify(mut self) {
        if target.os() == target.Os.Windows {
            unsafe { (*(self.ctx as CPtr<WinConfig>)).mode = MODE_SKIP }
            self.skip_verify = true
        } else if features.openssl {
            unsafe { SSL_CTX_set_verify(self.ctx, SSL_VERIFY_NONE, CPtr.null()) }
            self.skip_verify = true
        } else {}
    }

    /// Whether verification was turned off.
    ///
    /// ```
    /// # use tls
    /// # use tls.{ClientConfig}
    /// let config = ClientConfig.new().unwrap()
    /// assert(!config.skips_verification())
    /// ```
    fn skips_verification(self): bool {
        self.skip_verify
    }
}

ClientConfig: Drop {
    fn drop(mut self) {
        if target.os() == target.Os.Windows {
            unsafe { config_free(self.ctx as CPtr<WinConfig>) }
        } else if features.openssl {
            unsafe {
                if !self.ctx.is_null() {
                    SSL_CTX_free(self.ctx)
                }
            }
        } else {}
    }
}

// ----- the server -----------------------------------------------------------------------------------------------

/// How a server connection is set up: one certificate chain and its key. A server speaks no ALPN and serves one
/// certificate per configuration (spec/tls.md, TLS8: both need callbacks the C bridge cannot pass).
///
/// ```
/// # use tls
/// # use tls.{Certificate, PrivateKey, ServerConfig}
/// # let cert_pem = "-----BEGIN CERTIFICATE-----\nMIIBczCCARigAwIBAgIBCDAKBggqhkjOPQQDAjAUMRIwEAYDVQQDDAlsb2NhbGhv\nc3QwIBcNMjUxMTIxMTYwMDQ1WhgPMjEyNjEwMjgxNjAwNDVaMBQxEjAQBgNVBAMM\nCWxvY2FsaG9zdDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABLNTRhI9deSqQkH/\nNiFLg+Fe/zaKJC7lI8UTOi2V68Uc3izmbXb5WUJ8AqS+A6igo5a2sQwa94QknXaZ\n83d2N1+jWTBXMAwGA1UdEwEB/wQCMAAwHQYDVR0OBBYEFOcIZAeKeTy0tqIDOlRa\nDO1kZAnzMCgGA1UdEQQhMB+CCWxvY2FsaG9zdIIMZXhhbXBsZS50ZXN0hwR/AAAB\nMAoGCCqGSM49BAMCA0kAMEYCIQDEfYToC6DvEmFBBk0+z914XNS5Vl0O/qrhwl5I\nOvX3UAIhAM64DLHDSAdQc1r4kNgrRuoIGxh+XzAM8JpUn60qQ4DQ\n-----END CERTIFICATE-----\n"
/// # let key_pem = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg1tyNCLqQEA/R2tKM\n+KnOalrrIjLeUShT6y4KcwRTObehRANCAASzU0YSPXXkqkJB/zYhS4PhXv82iiQu\n5SPFEzotlevFHN4s5m12+VlCfAKkvgOooKOWtrEMGveEJJ12mfN3djdf\n-----END PRIVATE KEY-----\n"
/// let chain = Certificate.chain_from_pem(cert_pem).unwrap()
/// let key = PrivateKey.from_pem(key_pem).unwrap()
/// let _config = ServerConfig.new(chain, key).unwrap()
/// ```
struct ServerConfig {
    priv ctx: CPtr<SslCtx>,
}

unsafe ServerConfig: Send {}
unsafe ServerConfig: Sync {}

ServerConfig {
    /// A configuration serving `chain` (leaf first) with `key`. A key that does not belong to the leaf is
    /// `TlsError.KeyMismatch`.
    ///
    /// ```
    /// # use tls
    /// # use tls.{Certificate, PrivateKey, ServerConfig}
    /// # let cert_pem = "-----BEGIN CERTIFICATE-----\nMIIBczCCARigAwIBAgIBCDAKBggqhkjOPQQDAjAUMRIwEAYDVQQDDAlsb2NhbGhv\nc3QwIBcNMjUxMTIxMTYwMDQ1WhgPMjEyNjEwMjgxNjAwNDVaMBQxEjAQBgNVBAMM\nCWxvY2FsaG9zdDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABLNTRhI9deSqQkH/\nNiFLg+Fe/zaKJC7lI8UTOi2V68Uc3izmbXb5WUJ8AqS+A6igo5a2sQwa94QknXaZ\n83d2N1+jWTBXMAwGA1UdEwEB/wQCMAAwHQYDVR0OBBYEFOcIZAeKeTy0tqIDOlRa\nDO1kZAnzMCgGA1UdEQQhMB+CCWxvY2FsaG9zdIIMZXhhbXBsZS50ZXN0hwR/AAAB\nMAoGCCqGSM49BAMCA0kAMEYCIQDEfYToC6DvEmFBBk0+z914XNS5Vl0O/qrhwl5I\nOvX3UAIhAM64DLHDSAdQc1r4kNgrRuoIGxh+XzAM8JpUn60qQ4DQ\n-----END CERTIFICATE-----\n"
    /// # let key_pem = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg1tyNCLqQEA/R2tKM\n+KnOalrrIjLeUShT6y4KcwRTObehRANCAASzU0YSPXXkqkJB/zYhS4PhXv82iiQu\n5SPFEzotlevFHN4s5m12+VlCfAKkvgOooKOWtrEMGveEJJ12mfN3djdf\n-----END PRIVATE KEY-----\n"
    /// let chain = Certificate.chain_from_pem(cert_pem).unwrap()
    /// let key = PrivateKey.from_pem(key_pem).unwrap()
    /// let _config = ServerConfig.new(chain, key).unwrap()
    /// ```
    fn new(chain: List<Certificate>, key: PrivateKey): Result<ServerConfig, TlsError> {
        if target.os() == target.Os.Windows {
            unsafe {
                let ctx = new_ctx(true)?
                match use_identity(ctx, chain, key) {
                    Ok(()) => {}
                    Err(failure) => {
                        config_free(ctx as CPtr<WinConfig>)
                        return Err(failure)
                    }
                }
                Ok(ServerConfig { ctx: ctx })
            }
        } else if features.openssl {
            unsafe {
                let ctx = new_ctx(true)?
                match use_identity(ctx, chain, key) {
                    Ok(()) => {}
                    Err(failure) => {
                        SSL_CTX_free(ctx)
                        return Err(failure)
                    }
                }
                Ok(ServerConfig { ctx: ctx })
            }
        } else {
            Err(no_openssl())
        }
    }

    /// `new` from PEM texts: the chain (leaf first, then intermediates) and an unencrypted key.
    ///
    /// ```
    /// # use tls
    /// # use tls.{ServerConfig}
    /// # let cert_pem = "-----BEGIN CERTIFICATE-----\nMIIBczCCARigAwIBAgIBCDAKBggqhkjOPQQDAjAUMRIwEAYDVQQDDAlsb2NhbGhv\nc3QwIBcNMjUxMTIxMTYwMDQ1WhgPMjEyNjEwMjgxNjAwNDVaMBQxEjAQBgNVBAMM\nCWxvY2FsaG9zdDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABLNTRhI9deSqQkH/\nNiFLg+Fe/zaKJC7lI8UTOi2V68Uc3izmbXb5WUJ8AqS+A6igo5a2sQwa94QknXaZ\n83d2N1+jWTBXMAwGA1UdEwEB/wQCMAAwHQYDVR0OBBYEFOcIZAeKeTy0tqIDOlRa\nDO1kZAnzMCgGA1UdEQQhMB+CCWxvY2FsaG9zdIIMZXhhbXBsZS50ZXN0hwR/AAAB\nMAoGCCqGSM49BAMCA0kAMEYCIQDEfYToC6DvEmFBBk0+z914XNS5Vl0O/qrhwl5I\nOvX3UAIhAM64DLHDSAdQc1r4kNgrRuoIGxh+XzAM8JpUn60qQ4DQ\n-----END CERTIFICATE-----\n"
    /// # let key_pem = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg1tyNCLqQEA/R2tKM\n+KnOalrrIjLeUShT6y4KcwRTObehRANCAASzU0YSPXXkqkJB/zYhS4PhXv82iiQu\n5SPFEzotlevFHN4s5m12+VlCfAKkvgOooKOWtrEMGveEJJ12mfN3djdf\n-----END PRIVATE KEY-----\n"
    /// let _config = ServerConfig.from_pem(cert_pem, key_pem).unwrap()
    /// ```
    fn from_pem(chain_pem: str, key_pem: str): Result<ServerConfig, TlsError> {
        let chain = Certificate.chain_from_pem(chain_pem)?
        let key = PrivateKey.from_pem(key_pem)?
        ServerConfig.new(chain, key)
    }

    /// The lowest protocol version the server accepts (TLS 1.2 unless raised).
    ///
    /// ```
    /// # use tls
    /// # use tls.{ServerConfig, TlsVersion}
    /// # let cert_pem = "-----BEGIN CERTIFICATE-----\nMIIBczCCARigAwIBAgIBCDAKBggqhkjOPQQDAjAUMRIwEAYDVQQDDAlsb2NhbGhv\nc3QwIBcNMjUxMTIxMTYwMDQ1WhgPMjEyNjEwMjgxNjAwNDVaMBQxEjAQBgNVBAMM\nCWxvY2FsaG9zdDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABLNTRhI9deSqQkH/\nNiFLg+Fe/zaKJC7lI8UTOi2V68Uc3izmbXb5WUJ8AqS+A6igo5a2sQwa94QknXaZ\n83d2N1+jWTBXMAwGA1UdEwEB/wQCMAAwHQYDVR0OBBYEFOcIZAeKeTy0tqIDOlRa\nDO1kZAnzMCgGA1UdEQQhMB+CCWxvY2FsaG9zdIIMZXhhbXBsZS50ZXN0hwR/AAAB\nMAoGCCqGSM49BAMCA0kAMEYCIQDEfYToC6DvEmFBBk0+z914XNS5Vl0O/qrhwl5I\nOvX3UAIhAM64DLHDSAdQc1r4kNgrRuoIGxh+XzAM8JpUn60qQ4DQ\n-----END CERTIFICATE-----\n"
    /// # let key_pem = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg1tyNCLqQEA/R2tKM\n+KnOalrrIjLeUShT6y4KcwRTObehRANCAASzU0YSPXXkqkJB/zYhS4PhXv82iiQu\n5SPFEzotlevFHN4s5m12+VlCfAKkvgOooKOWtrEMGveEJJ12mfN3djdf\n-----END PRIVATE KEY-----\n"
    /// let mut config = ServerConfig.from_pem(cert_pem, key_pem).unwrap()
    /// config.min_version(TlsVersion.Tls13).unwrap()
    /// ```
    fn min_version(mut self, version: TlsVersion): Result<(), TlsError> {
        unsafe { set_version(self.ctx, SSL_CTRL_SET_MIN_PROTO_VERSION, version) }
    }

    /// The highest protocol version the server offers.
    ///
    /// ```
    /// # use tls
    /// # use tls.{ServerConfig, TlsVersion}
    /// # let cert_pem = "-----BEGIN CERTIFICATE-----\nMIIBczCCARigAwIBAgIBCDAKBggqhkjOPQQDAjAUMRIwEAYDVQQDDAlsb2NhbGhv\nc3QwIBcNMjUxMTIxMTYwMDQ1WhgPMjEyNjEwMjgxNjAwNDVaMBQxEjAQBgNVBAMM\nCWxvY2FsaG9zdDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABLNTRhI9deSqQkH/\nNiFLg+Fe/zaKJC7lI8UTOi2V68Uc3izmbXb5WUJ8AqS+A6igo5a2sQwa94QknXaZ\n83d2N1+jWTBXMAwGA1UdEwEB/wQCMAAwHQYDVR0OBBYEFOcIZAeKeTy0tqIDOlRa\nDO1kZAnzMCgGA1UdEQQhMB+CCWxvY2FsaG9zdIIMZXhhbXBsZS50ZXN0hwR/AAAB\nMAoGCCqGSM49BAMCA0kAMEYCIQDEfYToC6DvEmFBBk0+z914XNS5Vl0O/qrhwl5I\nOvX3UAIhAM64DLHDSAdQc1r4kNgrRuoIGxh+XzAM8JpUn60qQ4DQ\n-----END CERTIFICATE-----\n"
    /// # let key_pem = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg1tyNCLqQEA/R2tKM\n+KnOalrrIjLeUShT6y4KcwRTObehRANCAASzU0YSPXXkqkJB/zYhS4PhXv82iiQu\n5SPFEzotlevFHN4s5m12+VlCfAKkvgOooKOWtrEMGveEJJ12mfN3djdf\n-----END PRIVATE KEY-----\n"
    /// let mut config = ServerConfig.from_pem(cert_pem, key_pem).unwrap()
    /// config.max_version(TlsVersion.Tls13).unwrap()
    /// ```
    fn max_version(mut self, version: TlsVersion): Result<(), TlsError> {
        unsafe { set_version(self.ctx, SSL_CTRL_SET_MAX_PROTO_VERSION, version) }
    }

    /// Requires every client to present a certificate that chains to `roots` (mutual TLS).
    ///
    /// ```
    /// # use tls
    /// # use tls.{ServerConfig, TrustStore}
    /// # let cert_pem = "-----BEGIN CERTIFICATE-----\nMIIBczCCARigAwIBAgIBCDAKBggqhkjOPQQDAjAUMRIwEAYDVQQDDAlsb2NhbGhv\nc3QwIBcNMjUxMTIxMTYwMDQ1WhgPMjEyNjEwMjgxNjAwNDVaMBQxEjAQBgNVBAMM\nCWxvY2FsaG9zdDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABLNTRhI9deSqQkH/\nNiFLg+Fe/zaKJC7lI8UTOi2V68Uc3izmbXb5WUJ8AqS+A6igo5a2sQwa94QknXaZ\n83d2N1+jWTBXMAwGA1UdEwEB/wQCMAAwHQYDVR0OBBYEFOcIZAeKeTy0tqIDOlRa\nDO1kZAnzMCgGA1UdEQQhMB+CCWxvY2FsaG9zdIIMZXhhbXBsZS50ZXN0hwR/AAAB\nMAoGCCqGSM49BAMCA0kAMEYCIQDEfYToC6DvEmFBBk0+z914XNS5Vl0O/qrhwl5I\nOvX3UAIhAM64DLHDSAdQc1r4kNgrRuoIGxh+XzAM8JpUn60qQ4DQ\n-----END CERTIFICATE-----\n"
    /// # let key_pem = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg1tyNCLqQEA/R2tKM\n+KnOalrrIjLeUShT6y4KcwRTObehRANCAASzU0YSPXXkqkJB/zYhS4PhXv82iiQu\n5SPFEzotlevFHN4s5m12+VlCfAKkvgOooKOWtrEMGveEJJ12mfN3djdf\n-----END PRIVATE KEY-----\n"
    /// let mut config = ServerConfig.from_pem(cert_pem, key_pem).unwrap()
    /// let mut roots = TrustStore.empty()
    /// roots.add_pem(cert_pem).unwrap()
    /// config.require_client_certificate(roots).unwrap()
    /// ```
    fn require_client_certificate(mut self, roots: TrustStore): Result<(), TlsError> {
        if target.os() == target.Os.Windows {
            unsafe {
                apply_trust(self.ctx, roots)?
                (*(self.ctx as CPtr<WinConfig>)).require_client = 1
            }
            Ok(())
        } else if features.openssl {
            unsafe {
                apply_trust(self.ctx, roots)?
                SSL_CTX_set_verify(self.ctx, SSL_VERIFY_PEER | SSL_VERIFY_FAIL_IF_NO_PEER_CERT, CPtr.null())
            }
            Ok(())
        } else {
            Err(no_openssl())
        }
    }
}

ServerConfig: Drop {
    fn drop(mut self) {
        if target.os() == target.Os.Windows {
            unsafe { config_free(self.ctx as CPtr<WinConfig>) }
        } else if features.openssl {
            unsafe {
                if !self.ctx.is_null() {
                    SSL_CTX_free(self.ctx)
                }
            }
        } else {}
    }
}
