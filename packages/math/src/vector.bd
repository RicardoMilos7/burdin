// Fixed-size vectors of `f64` (spec/math.md, MA6).

/// A vector of `N` components. It is a value: it is copied like a number.
///
/// ```
/// # use math
/// # use math.{DynMatrix, Matrix, Vector}
/// let v = Vector<2>.from_array([3.0, 4.0])
/// assert_eq(v.norm(), 5.0)
/// assert_eq(v.get(0), 3.0)
/// ```
struct Vector<const N: usize>: Copy, Clone {
    data: [f64; N]
}

Vector<N> {
    /// The vector whose components are all zero.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// let z = Vector<3>.zero()
    /// assert_eq(z.get(2), 0.0)
    /// assert_eq(z.len(), 3)
    /// ```
    fn zero(): Vector<N> {
        Vector { data: [0.0; N] }
    }

    /// The vector with the given components.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// let v = Vector<3>.from_array([1.0, 2.0, 3.0])
    /// assert_eq(v.get(1), 2.0)
    /// ```
    fn from_array(values: [f64; N]): Vector<N> {
        Vector { data: values }
    }

    /// The number of components.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// assert_eq(Vector<4>.zero().len(), 4)
    /// ```
    fn len(self): usize {
        N
    }

    /// The component at `i`. Panics when `i` is out of range.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// let v = Vector<2>.from_array([5.0, 6.0])
    /// assert_eq(v.get(1), 6.0)
    /// ```
    fn get(self, i: usize): f64 {
        self.data[i]
    }

    /// The dot product.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// let a = Vector<2>.from_array([1.0, 2.0])
    /// let b = Vector<2>.from_array([3.0, 4.0])
    /// assert_eq(a.dot(b), 11.0)
    /// ```
    fn dot(self, other: Vector<N>): f64 {
        let mut total = 0.0
        for i in 0..N {
            total = total + self.data[i] * other.data[i]
        }
        total
    }

    /// The squared length.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// assert_eq(Vector<2>.from_array([3.0, 4.0]).norm_squared(), 25.0)
    /// ```
    fn norm_squared(self): f64 {
        self.dot(self)
    }

    /// The length.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// assert_eq(Vector<2>.from_array([3.0, 4.0]).norm(), 5.0)
    /// ```
    fn norm(self): f64 {
        self.norm_squared().sqrt()
    }

    /// The distance between the two points.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// let a = Vector<2>.from_array([1.0, 1.0])
    /// let b = Vector<2>.from_array([4.0, 5.0])
    /// assert_eq(a.distance(b), 5.0)
    /// ```
    fn distance(self, other: Vector<N>): f64 {
        (self - other).norm()
    }

    /// Each component times `k`.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// let v = Vector<2>.from_array([1.0, -2.0]).scale(3.0)
    /// assert_eq(v.get(1), -6.0)
    /// ```
    fn scale(self, k: f64): Vector<N> {
        let mut out = Vector<N>.zero()
        for i in 0..N {
            out.data[i] = self.data[i] * k
        }
        out
    }

    /// `f` applied to each component.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// let v = Vector<2>.from_array([1.0, 4.0]).map(|x: f64| x * 2.0)
    /// assert_eq(v.get(1), 8.0)
    /// ```
    fn map<F: Fn(f64): f64>(self, f: F): Vector<N> {
        let mut out = Vector<N>.zero()
        for i in 0..N {
            out.data[i] = f(self.data[i])
        }
        out
    }

    /// The vector of length one in the same direction, or `None` for the zero vector.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// let u = Vector<2>.from_array([3.0, 4.0]).normalized().unwrap()
    /// assert(math.approx_eq(u.get(0), 0.6, 0.000000001, 0.0))
    /// assert(Vector<2>.zero().normalized().is_none())
    /// ```
    fn normalized(self): Option<Vector<N>> {
        let length = self.norm()
        if length == 0.0 {
            return Option.None
        }
        Option.Some(self.scale(1.0 / length))
    }

    /// The angle between the vectors in radians, or `None` when either is the zero vector. The cosine is clamped to
    /// `[-1, 1]` first, so rounding cannot make the angle NaN.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// let x = Vector<2>.from_array([1.0, 0.0])
    /// let y = Vector<2>.from_array([0.0, 1.0])
    /// assert(math.approx_eq(x.angle(y).unwrap(), 1.5707963267948966, 0.000000001, 0.0))
    /// ```
    fn angle(self, other: Vector<N>): Option<f64> {
        let lengths = self.norm() * other.norm()
        if lengths == 0.0 {
            return Option.None
        }
        let cosine = self.dot(other) / lengths
        let clamped = if cosine > 1.0 { 1.0 } else if cosine < -1.0 { -1.0 } else { cosine }
        Option.Some(clamped.acos())
    }

    /// Whether every component differs from `other`'s by at most `tolerance`.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// let a = Vector<2>.from_array([1.0, 2.0])
    /// let b = Vector<2>.from_array([1.0, 2.0000001])
    /// assert(a.approx_eq(b, 0.000001))
    /// assert(!a.approx_eq(Vector<2>.zero(), 0.5))
    /// ```
    fn approx_eq(self, other: Vector<N>, tolerance: f64): bool {
        for i in 0..N {
            if !((self.data[i] - other.data[i]).abs() <= tolerance) {
                return false
            }
        }
        true
    }
}

Vector<N>: Add {
    fn add(self, other: Vector<N>): Vector<N> {
        let mut out = Vector<N>.zero()
        for i in 0..N {
            out.data[i] = self.data[i] + other.data[i]
        }
        out
    }
}

Vector<N>: Sub {
    fn sub(self, other: Vector<N>): Vector<N> {
        let mut out = Vector<N>.zero()
        for i in 0..N {
            out.data[i] = self.data[i] - other.data[i]
        }
        out
    }
}

Vector<N>: Neg {
    fn neg(self): Vector<N> {
        let mut out = Vector<N>.zero()
        for i in 0..N {
            out.data[i] = -self.data[i]
        }
        out
    }
}

Vector<N>: Index<f64> {
    fn index(self, i: usize): &f64 {
        &self.data[i]
    }
}

Vector<N>: IndexMut<f64> {
    fn index_mut(mut self, i: usize): &mut f64 {
        &mut self.data[i]
    }
}

/// The cross product, which exists only in three dimensions.
Vector<3> {
    /// The cross product of two three-dimensional vectors: a vector perpendicular to both, whose length is the area of the
    /// parallelogram they span. Only `Vector<3>` has one.
    ///
    /// ```
    /// # use math
    /// # use math.{DynMatrix, Matrix, Vector}
    /// let x = Vector<3>.from_array([1.0, 0.0, 0.0])
    /// let y = Vector<3>.from_array([0.0, 1.0, 0.0])
    /// assert_eq(x.cross(y).get(2), 1.0)
    /// ```
    fn cross(self, other: Vector<3>): Vector<3> {
        let a = self.data
        let b = other.data
        Vector { data: [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]] }
    }
}
