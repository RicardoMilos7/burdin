// The gamma function and its logarithm (spec/math.md, MA4). For `x` of at least 15, Stirling's series with seven
// terms is exact to double precision; a smaller `x` is raised to that size with the recurrence
// `gamma(x) = gamma(x + 1) / x`. Below zero the reflection formula applies.

/// Whether `x` is zero or a negative whole number, where the gamma function has a pole.
fn at_pole(x: f64): bool {
    x <= 0.0 && x.floor() == x
}

/// `ln gamma(x)` for `x` of at least 15, by Stirling's series. The terms are the Bernoulli numbers over
/// `2k(2k - 1) x^(2k - 1)`, for `k` up to 7.
fn stirling_log_gamma(x: f64): f64 {
    let inv = 1.0 / x
    let inv2 = inv * inv
    let series = inv * (1.0 / 12.0 + inv2 * (-1.0 / 360.0 + inv2 * (1.0 / 1260.0 + inv2 * (-1.0 / 1680.0 + inv2 * (1.0 / 1188.0 + inv2 * (-691.0 / 360360.0 + inv2 * (1.0 / 156.0)))))))
    (x - 0.5) * x.ln() - x + 0.5 * (2.0 * f64.PI).ln() + series
}

/// `ln gamma(x)` for `x > 0`: `x` is raised to at least 15 with the recurrence, and the product of the steps is taken
/// as a sum of logarithms, so a small `x` cannot underflow.
fn log_gamma_positive(x: f64): f64 {
    let mut shifted = x
    let mut log_steps = 0.0
    while shifted < 15.0 {
        log_steps = log_steps + shifted.ln()
        shifted = shifted + 1.0
    }
    stirling_log_gamma(shifted) - log_steps
}

/// The gamma function. `NaN` at a non-positive integer, where it has a pole.
fn gamma(x: f64): f64 {
    if at_pole(x) {
        return f64.NAN
    }
    if x < 0.0 {
        return f64.PI / ((f64.PI * x).sin() * gamma(1.0 - x))
    }
    log_gamma_positive(x).exp()
}

/// `ln |gamma(x)|`. `INFINITY` at a non-positive integer, where the gamma function has a pole.
fn ln_gamma(x: f64): f64 {
    if at_pole(x) {
        return f64.INFINITY
    }
    if x < 0.0 {
        return f64.PI.ln() - (f64.PI * x).sin().abs().ln() - log_gamma_positive(1.0 - x)
    }
    log_gamma_positive(x)
}
