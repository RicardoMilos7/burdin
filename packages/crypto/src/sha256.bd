// SHA-224 and SHA-256 (FIPS 180-4), in pure Burdin. Not constant time with respect to the message length, which is
// public in every use here; the compression function has no secret-dependent branches or table lookups.

const SHA256_K: [u32; 64] = [
    0x428a2f98,
    0x71374491,
    0xb5c0fbcf,
    0xe9b5dba5,
    0x3956c25b,
    0x59f111f1,
    0x923f82a4,
    0xab1c5ed5,
    0xd807aa98,
    0x12835b01,
    0x243185be,
    0x550c7dc3,
    0x72be5d74,
    0x80deb1fe,
    0x9bdc06a7,
    0xc19bf174,
    0xe49b69c1,
    0xefbe4786,
    0x0fc19dc6,
    0x240ca1cc,
    0x2de92c6f,
    0x4a7484aa,
    0x5cb0a9dc,
    0x76f988da,
    0x983e5152,
    0xa831c66d,
    0xb00327c8,
    0xbf597fc7,
    0xc6e00bf3,
    0xd5a79147,
    0x06ca6351,
    0x14292967,
    0x27b70a85,
    0x2e1b2138,
    0x4d2c6dfc,
    0x53380d13,
    0x650a7354,
    0x766a0abb,
    0x81c2c92e,
    0x92722c85,
    0xa2bfe8a1,
    0xa81a664b,
    0xc24b8b70,
    0xc76c51a3,
    0xd192e819,
    0xd6990624,
    0xf40e3585,
    0x106aa070,
    0x19a4c116,
    0x1e376c08,
    0x2748774c,
    0x34b0bcb5,
    0x391c0cb3,
    0x4ed8aa4a,
    0x5b9cca4f,
    0x682e6ff3,
    0x748f82ee,
    0x78a5636f,
    0x84c87814,
    0x8cc70208,
    0x90befffa,
    0xa4506ceb,
    0xbef9a3f7,
    0xc67178f2,
]

/// An incremental SHA-256 (or SHA-224) hasher.
struct Sha256 {
    h: [u32; 8],
    buf: List<u8>,
    total: u64,
    out_len: usize,
}

Sha256 {
    /// A SHA-256 hasher (32-byte digest).
    fn new(): Sha256 {
        Sha256 {
            h: [
                0x6a09e667,
                0xbb67ae85,
                0x3c6ef372,
                0xa54ff53a,
                0x510e527f,
                0x9b05688c,
                0x1f83d9ab,
                0x5be0cd19,
            ],
            buf: List<u8>.new(),
            total: 0,
            out_len: 32,
        }
    }

    /// A SHA-224 hasher (28-byte digest).
    fn new224(): Sha256 {
        Sha256 {
            h: [
                0xc1059ed8,
                0x367cd507,
                0x3070dd17,
                0xf70e5939,
                0xffc00b31,
                0x68581511,
                0x64f98fa7,
                0xbefa4fa4,
            ],
            buf: List<u8>.new(),
            total: 0,
            out_len: 28,
        }
    }

    /// The block size in bytes (64).
    fn block_len(self): usize {
        64
    }

    /// The digest size in bytes.
    fn output_len(self): usize {
        self.out_len
    }

    /// Hashes more input.
    fn update(mut self, data: [u8]) {
        self.total = self.total.wrapping_add(data.len() as u64)
        let mut pos: usize = 0
        if self.buf.len() > 0 {
            while pos < data.len() && self.buf.len() < 64 {
                self.buf.push(data[pos])
                pos = pos + 1
            }
            if self.buf.len() == 64 {
                let block = self.buf.clone()
                self.compress(block.as_slice())
                self.buf.clear()
            }
        }
        while pos + 64 <= data.len() {
            self.compress(data[pos..pos + 64])
            pos = pos + 64
        }
        while pos < data.len() {
            self.buf.push(data[pos])
            pos = pos + 1
        }
    }

    /// Ends the hash and returns the digest. The hasher must not be used afterwards.
    fn finish(mut self): List<u8> {
        let bits = self.total.wrapping_mul(8)
        self.update_padding(bits)
        let mut out = List<u8>.new()
        let mut i: usize = 0
        while i < 8 {
            let word = self.h[i]
            out.push((word >> 24) as u8)
            out.push((word >> 16) as u8)
            out.push((word >> 8) as u8)
            out.push(word as u8)
            i = i + 1
        }
        out.truncate(self.out_len)
        out
    }

    fn update_padding(mut self, bits: u64) {
        let mut pad = List<u8>.new()
        pad.push(0x80)
        while (self.buf.len() + pad.len()) % 64 != 56 {
            pad.push(0)
        }
        let mut shift: u32 = 56
        loop {
            pad.push((bits >> shift) as u8)
            if shift == 0 {
                break
            }
            shift = shift - 8
        }
        // The length is already counted; feed the padding without changing `total`.
        let keep = self.total
        self.update(pad.as_slice())
        self.total = keep
    }

    fn compress(mut self, block: [u8]) {
        let mut w: [u32; 64] = [0; 64]
        let mut t: usize = 0
        while t < 16 {
            let j = t * 4
            w[t] =
                ((block[j] as u32) << 24) |
                ((block[j + 1] as u32) << 16) |
                ((block[j + 2] as u32) << 8) |
                (block[j + 3] as u32)
            t = t + 1
        }
        while t < 64 {
            let w15 = w[t - 15]
            let w2 = w[t - 2]
            let s0 = w15.rotate_right(7) ^ w15.rotate_right(18) ^ (w15 >> 3)
            let s1 = w2.rotate_right(17) ^ w2.rotate_right(19) ^ (w2 >> 10)
            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1)
            t = t + 1
        }
        let mut a = self.h[0]
        let mut b = self.h[1]
        let mut c = self.h[2]
        let mut d = self.h[3]
        let mut e = self.h[4]
        let mut f = self.h[5]
        let mut g = self.h[6]
        let mut h = self.h[7]
        t = 0
        while t < 64 {
            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25)
            let ch = (e & f) ^ ((e ^ 0xffffffff) & g)
            let t1 = h.wrapping_add(s1).wrapping_add(ch).wrapping_add(SHA256_K[t]).wrapping_add(w[t])
            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let t2 = s0.wrapping_add(maj)
            h = g
            g = f
            f = e
            e = d.wrapping_add(t1)
            d = c
            c = b
            b = a
            a = t1.wrapping_add(t2)
            t = t + 1
        }
        self.h[0] = self.h[0].wrapping_add(a)
        self.h[1] = self.h[1].wrapping_add(b)
        self.h[2] = self.h[2].wrapping_add(c)
        self.h[3] = self.h[3].wrapping_add(d)
        self.h[4] = self.h[4].wrapping_add(e)
        self.h[5] = self.h[5].wrapping_add(f)
        self.h[6] = self.h[6].wrapping_add(g)
        self.h[7] = self.h[7].wrapping_add(h)
    }
}

/// The SHA-256 digest of `data`.
fn sha256(data: [u8]): List<u8> {
    let mut h = Sha256.new()
    h.update(data)
    h.finish()
}

/// The SHA-224 digest of `data`.
fn sha224(data: [u8]): List<u8> {
    let mut h = Sha256.new224()
    h.update(data)
    h.finish()
}
