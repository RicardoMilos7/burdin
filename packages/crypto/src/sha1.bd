// SHA-1 (FIPS 180-4). BROKEN for collision resistance (SHAttered, 2017). Provided for interoperability (Git object
// names, old signatures, HMAC-SHA1 in legacy protocols); do not use it where an attacker can choose the input.

/// An incremental SHA-1 hasher (insecure for collisions; see the file comment).
///
/// ```
/// # use crypto
/// # use crypto.{Sha1}
/// let mut hasher = Sha1.new()
/// hasher.update("abc".as_bytes())
/// assert_eq(hasher.finish().to_hex().as_str(), "a9993e364706816aba3e25717850c26c9cd0d89d")
/// ```
struct Sha1 {
    h: [u32; 5],
    buf: List<u8>,
    total: u64,
}

Sha1 {
    /// A new SHA-1 hasher, which produces a 20-byte digest. SHA-1 is broken for collision resistance; see the file comment.
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Sha1}
    /// assert_eq(Sha1.new().output_len(), 20)
    /// ```
    fn new(): Sha1 {
        Sha1 { h: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0], buf: List<u8>.new(), total: 0 }
    }

    /// The block size in bytes (64).
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Sha1}
    /// assert_eq(Sha1.new().block_len(), 64)
    /// ```
    fn block_len(self): usize {
        64
    }

    /// The digest size in bytes (20).
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Sha1}
    /// assert_eq(Sha1.new().output_len(), 20)
    /// ```
    fn output_len(self): usize {
        20
    }

    /// Hashes more input.
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Sha1}
    /// let mut hasher = Sha1.new()
    /// hasher.update("a".as_bytes())
    /// hasher.update("bc".as_bytes())
    /// assert_eq(hasher.finish().to_hex().as_str(), "a9993e364706816aba3e25717850c26c9cd0d89d")
    /// ```
    fn update(mut self, data: [u8]) {
        self.total = self.total.wrapping_add(data.len() as u64)
        let mut pos: usize = 0
        if self.buf.len() > 0 {
            while pos < data.len() && self.buf.len() < 64 {
                self.buf.push(data[pos])
                pos = pos + 1
            }
            if self.buf.len() == 64 {
                let block = self.buf.clone()
                self.compress(block.as_slice())
                self.buf.clear()
            }
        }
        while pos + 64 <= data.len() {
            self.compress(data[pos..pos + 64])
            pos = pos + 64
        }
        while pos < data.len() {
            self.buf.push(data[pos])
            pos = pos + 1
        }
    }

    /// Ends the hash and returns the digest. The hasher must not be used afterwards.
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Sha1}
    /// let mut hasher = Sha1.new()
    /// assert_eq(hasher.finish().to_hex().as_str(), "da39a3ee5e6b4b0d3255bfef95601890afd80709")
    /// ```
    fn finish(mut self): List<u8> {
        let bits = self.total.wrapping_mul(8)
        let keep = self.total
        let mut pad = List<u8>.new()
        pad.push(0x80)
        while (self.buf.len() + pad.len()) % 64 != 56 {
            pad.push(0)
        }
        let mut shift: u32 = 56
        loop {
            pad.push((bits >> shift) as u8)
            if shift == 0 {
                break
            }
            shift = shift - 8
        }
        self.update(pad.as_slice())
        self.total = keep
        let mut out = List<u8>.new()
        let mut k: usize = 0
        while k < 5 {
            let word = self.h[k]
            out.push((word >> 24) as u8)
            out.push((word >> 16) as u8)
            out.push((word >> 8) as u8)
            out.push(word as u8)
            k = k + 1
        }
        out
    }

    priv fn compress(mut self, block: [u8]) {
        let mut w: [u32; 80] = [0; 80]
        let mut t: usize = 0
        while t < 16 {
            let j = t * 4
            w[t] =
                ((block[j] as u32) << 24) |
                ((block[j + 1] as u32) << 16) |
                ((block[j + 2] as u32) << 8) |
                (block[j + 3] as u32)
            t = t + 1
        }
        while t < 80 {
            w[t] = (w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]).rotate_left(1)
            t = t + 1
        }
        let mut a = self.h[0]
        let mut b = self.h[1]
        let mut c = self.h[2]
        let mut d = self.h[3]
        let mut e = self.h[4]
        t = 0
        while t < 80 {
            let mut f: u32 = 0
            let mut k: u32 = 0
            if t < 20 {
                f = (b & c) | ((b ^ 0xffffffff) & d)
                k = 0x5a827999
            } else if t < 40 {
                f = b ^ c ^ d
                k = 0x6ed9eba1
            } else if t < 60 {
                f = (b & c) | (b & d) | (c & d)
                k = 0x8f1bbcdc
            } else {
                f = b ^ c ^ d
                k = 0xca62c1d6
            }
            let temp = a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(w[t])
            e = d
            d = c
            c = b.rotate_left(30)
            b = a
            a = temp
            t = t + 1
        }
        self.h[0] = self.h[0].wrapping_add(a)
        self.h[1] = self.h[1].wrapping_add(b)
        self.h[2] = self.h[2].wrapping_add(c)
        self.h[3] = self.h[3].wrapping_add(d)
        self.h[4] = self.h[4].wrapping_add(e)
    }
}

/// The SHA-1 digest of `data` (insecure for collisions; see the file comment).
///
/// ```
/// # use crypto
/// # use crypto.{sha1}
/// assert_eq(sha1("abc".as_bytes()).to_hex().as_str(), "a9993e364706816aba3e25717850c26c9cd0d89d")
/// ```
fn sha1(data: [u8]): List<u8> {
    let mut h = Sha1.new()
    h.update(data)
    h.finish()
}
