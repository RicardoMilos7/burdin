/// An incremental SHA-512 (or SHA-384) hasher.
///
/// ```
/// # use crypto
/// # use crypto.{Sha512}
/// let mut hasher = Sha512.new()
/// hasher.update("abc".as_bytes())
/// assert_eq(hasher.finish().to_hex().as_str(), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
/// ```
struct Sha512 {
    h: [u64; 8],
    buf: List<u8>,
    total: u64,
    out_len: usize,
}

Sha512 {
    /// A SHA-512 hasher (64-byte digest).
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Sha512}
    /// assert_eq(Sha512.new().output_len(), 64)
    /// ```
    fn new(): Sha512 {
        Sha512 {
            h: [
                0x6a09e667f3bcc908,
                0xbb67ae8584caa73b,
                0x3c6ef372fe94f82b,
                0xa54ff53a5f1d36f1,
                0x510e527fade682d1,
                0x9b05688c2b3e6c1f,
                0x1f83d9abfb41bd6b,
                0x5be0cd19137e2179,
            ],
            buf: List<u8>.new(),
            total: 0,
            out_len: 64,
        }
    }

    /// A SHA-384 hasher (48-byte digest).
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Sha512}
    /// assert_eq(Sha512.new384().output_len(), 48)
    /// ```
    fn new384(): Sha512 {
        Sha512 {
            h: [
                0xcbbb9d5dc1059ed8,
                0x629a292a367cd507,
                0x9159015a3070dd17,
                0x152fecd8f70e5939,
                0x67332667ffc00b31,
                0x8eb44a8768581511,
                0xdb0c2e0d64f98fa7,
                0x47b5481dbefa4fa4,
            ],
            buf: List<u8>.new(),
            total: 0,
            out_len: 48,
        }
    }

    /// The block size in bytes (128).
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Sha512}
    /// assert_eq(Sha512.new().block_len(), 128)
    /// ```
    fn block_len(self): usize {
        128
    }

    /// The digest size in bytes.
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Sha512}
    /// assert_eq(Sha512.new384().output_len(), 48)
    /// ```
    fn output_len(self): usize {
        self.out_len
    }

    /// Hashes more input.
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Sha512}
    /// let mut hasher = Sha512.new()
    /// hasher.update("a".as_bytes())
    /// hasher.update("bc".as_bytes())
    /// assert_eq(hasher.finish().to_hex().as_str(), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
    /// ```
    fn update(mut self, data: [u8]) {
        self.total = self.total.wrapping_add(data.len() as u64)
        let mut pos: usize = 0
        if self.buf.len() > 0 {
            while pos < data.len() && self.buf.len() < 128 {
                self.buf.push(data[pos])
                pos = pos + 1
            }
            if self.buf.len() == 128 {
                let block = self.buf.clone()
                self.compress(block.as_slice())
                self.buf.clear()
            }
        }
        while pos + 128 <= data.len() {
            self.compress(data[pos..pos + 128])
            pos = pos + 128
        }
        while pos < data.len() {
            self.buf.push(data[pos])
            pos = pos + 1
        }
    }

    /// Ends the hash and returns the digest. The hasher must not be used afterwards.
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Sha512}
    /// let mut hasher = Sha512.new()
    /// assert_eq(hasher.finish().len(), 64)
    /// ```
    fn finish(mut self): List<u8> {
        let bits = self.total.wrapping_mul(8)
        let high = self.total >> 61
        let keep = self.total
        let mut pad = List<u8>.new()
        pad.push(0x80)
        while (self.buf.len() + pad.len()) % 128 != 112 {
            pad.push(0)
        }
        let mut shift: u32 = 56
        loop {
            pad.push((high >> shift) as u8)
            if shift == 0 {
                break
            }
            shift = shift - 8
        }
        shift = 56
        loop {
            pad.push((bits >> shift) as u8)
            if shift == 0 {
                break
            }
            shift = shift - 8
        }
        self.update(pad.as_slice())
        self.total = keep
        let mut out = List<u8>.new()
        let mut i: usize = 0
        while i < 8 {
            let word = self.h[i]
            let mut s: u32 = 56
            loop {
                out.push((word >> s) as u8)
                if s == 0 {
                    break
                }
                s = s - 8
            }
            i = i + 1
        }
        out.truncate(self.out_len)
        out
    }

    priv fn compress(mut self, block: [u8]) {
        let mut w: [u64; 80] = [0; 80]
        let mut t: usize = 0
        while t < 16 {
            let j = t * 8
            let mut word: u64 = 0
            let mut k: usize = 0
            while k < 8 {
                word = (word << 8) | (block[j + k] as u64)
                k = k + 1
            }
            w[t] = word
            t = t + 1
        }
        while t < 80 {
            let w15 = w[t - 15]
            let w2 = w[t - 2]
            let s0 = w15.rotate_right(1) ^ w15.rotate_right(8) ^ (w15 >> 7)
            let s1 = w2.rotate_right(19) ^ w2.rotate_right(61) ^ (w2 >> 6)
            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1)
            t = t + 1
        }
        let mut a = self.h[0]
        let mut b = self.h[1]
        let mut c = self.h[2]
        let mut d = self.h[3]
        let mut e = self.h[4]
        let mut f = self.h[5]
        let mut g = self.h[6]
        let mut h = self.h[7]
        t = 0
        while t < 80 {
            let s1 = e.rotate_right(14) ^ e.rotate_right(18) ^ e.rotate_right(41)
            let ch = (e & f) ^ ((e ^ 0xffffffffffffffff) & g)
            let t1 = h.wrapping_add(s1).wrapping_add(ch).wrapping_add(SHA512_K[t]).wrapping_add(w[t])
            let s0 = a.rotate_right(28) ^ a.rotate_right(34) ^ a.rotate_right(39)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let t2 = s0.wrapping_add(maj)
            h = g
            g = f
            f = e
            e = d.wrapping_add(t1)
            d = c
            c = b
            b = a
            a = t1.wrapping_add(t2)
            t = t + 1
        }
        self.h[0] = self.h[0].wrapping_add(a)
        self.h[1] = self.h[1].wrapping_add(b)
        self.h[2] = self.h[2].wrapping_add(c)
        self.h[3] = self.h[3].wrapping_add(d)
        self.h[4] = self.h[4].wrapping_add(e)
        self.h[5] = self.h[5].wrapping_add(f)
        self.h[6] = self.h[6].wrapping_add(g)
        self.h[7] = self.h[7].wrapping_add(h)
    }
}

/// The SHA-512 digest of `data`.
///
/// ```
/// # use crypto
/// # use crypto.{sha512}
/// assert_eq(sha512("abc".as_bytes()).to_hex().as_str(), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
/// ```
fn sha512(data: [u8]): List<u8> {
    let mut h = Sha512.new()
    h.update(data)
    h.finish()
}

/// The SHA-384 digest of `data`.
///
/// ```
/// # use crypto
/// # use crypto.{sha384}
/// assert_eq(sha384("abc".as_bytes()).to_hex().as_str(), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
/// ```
fn sha384(data: [u8]): List<u8> {
    let mut h = Sha512.new384()
    h.update(data)
    h.finish()
}
