/// An incremental MD5 hasher (insecure; see the file comment).
///
/// ```
/// # use crypto
/// # use crypto.{Md5}
/// let mut hasher = Md5.new()
/// hasher.update("abc".as_bytes())
/// assert_eq(hasher.finish().to_hex().as_str(), "900150983cd24fb0d6963f7d28e17f72")
/// ```
struct Md5 {
    h: [u32; 4],
    buf: List<u8>,
    total: u64,
}

Md5 {
    /// A new MD5 hasher, which produces a 16-byte digest. MD5 is broken for collision resistance; see the file comment.
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Md5}
    /// assert_eq(Md5.new().output_len(), 16)
    /// ```
    fn new(): Md5 {
        Md5 { h: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476], buf: List<u8>.new(), total: 0 }
    }

    /// The block size in bytes (64).
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Md5}
    /// assert_eq(Md5.new().block_len(), 64)
    /// ```
    fn block_len(self): usize {
        64
    }

    /// The digest size in bytes (16).
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Md5}
    /// assert_eq(Md5.new().output_len(), 16)
    /// ```
    fn output_len(self): usize {
        16
    }

    /// Hashes more input.
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Md5}
    /// let mut hasher = Md5.new()
    /// hasher.update("a".as_bytes())
    /// hasher.update("bc".as_bytes())
    /// assert_eq(hasher.finish().to_hex().as_str(), "900150983cd24fb0d6963f7d28e17f72")
    /// ```
    fn update(mut self, data: [u8]) {
        self.total = self.total.wrapping_add(data.len() as u64)
        let mut pos: usize = 0
        if self.buf.len() > 0 {
            while pos < data.len() && self.buf.len() < 64 {
                self.buf.push(data[pos])
                pos = pos + 1
            }
            if self.buf.len() == 64 {
                let block = self.buf.clone()
                self.compress(block.as_slice())
                self.buf.clear()
            }
        }
        while pos + 64 <= data.len() {
            self.compress(data[pos..pos + 64])
            pos = pos + 64
        }
        while pos < data.len() {
            self.buf.push(data[pos])
            pos = pos + 1
        }
    }

    /// Ends the hash and returns the digest. The hasher must not be used afterwards.
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Md5}
    /// let mut hasher = Md5.new()
    /// assert_eq(hasher.finish().to_hex().as_str(), "d41d8cd98f00b204e9800998ecf8427e")
    /// ```
    fn finish(mut self): List<u8> {
        let bits = self.total.wrapping_mul(8)
        let keep = self.total
        let mut pad = List<u8>.new()
        pad.push(0x80)
        while (self.buf.len() + pad.len()) % 64 != 56 {
            pad.push(0)
        }
        let mut i: u32 = 0
        while i < 8 {
            pad.push((bits >> (i * 8)) as u8)
            i = i + 1
        }
        self.update(pad.as_slice())
        self.total = keep
        let mut out = List<u8>.new()
        let mut k: usize = 0
        while k < 4 {
            let word = self.h[k]
            out.push(word as u8)
            out.push((word >> 8) as u8)
            out.push((word >> 16) as u8)
            out.push((word >> 24) as u8)
            k = k + 1
        }
        out
    }

    priv fn compress(mut self, block: [u8]) {
        let mut m: [u32; 16] = [0; 16]
        let mut t: usize = 0
        while t < 16 {
            let j = t * 4
            m[t] =
                (block[j] as u32) |
                ((block[j + 1] as u32) << 8) |
                ((block[j + 2] as u32) << 16) |
                ((block[j + 3] as u32) << 24)
            t = t + 1
        }
        let mut a = self.h[0]
        let mut b = self.h[1]
        let mut c = self.h[2]
        let mut d = self.h[3]
        let mut i: usize = 0
        while i < 64 {
            let mut f: u32 = 0
            let mut g: usize = 0
            if i < 16 {
                f = (b & c) | ((b ^ 0xffffffff) & d)
                g = i
            } else if i < 32 {
                f = (d & b) | ((d ^ 0xffffffff) & c)
                g = (5 * i + 1) % 16
            } else if i < 48 {
                f = b ^ c ^ d
                g = (3 * i + 5) % 16
            } else {
                f = c ^ (b | (d ^ 0xffffffff))
                g = (7 * i) % 16
            }
            let sum = f.wrapping_add(a).wrapping_add(MD5_T[i]).wrapping_add(m[g])
            a = d
            d = c
            c = b
            b = b.wrapping_add(sum.rotate_left(MD5_S[i]))
            i = i + 1
        }
        self.h[0] = self.h[0].wrapping_add(a)
        self.h[1] = self.h[1].wrapping_add(b)
        self.h[2] = self.h[2].wrapping_add(c)
        self.h[3] = self.h[3].wrapping_add(d)
    }
}

/// The MD5 digest of `data` (insecure; see the file comment).
///
/// ```
/// # use crypto
/// # use crypto.{md5}
/// assert_eq(md5("abc".as_bytes()).to_hex().as_str(), "900150983cd24fb0d6963f7d28e17f72")
/// ```
fn md5(data: [u8]): List<u8> {
    let mut h = Md5.new()
    h.update(data)
    h.finish()
}
