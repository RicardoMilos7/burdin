priv const GCM_ONE: [u8; 4] = [0, 0, 0, 1]
priv const GCM_TWO: [u8; 4] = [0, 0, 0, 2]
priv const AES_RCON: [u8; 10] = [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36]

priv fn xtime(a: u8): u8 {
    let doubled = (a << 1) as u8
    if (a & 0x80) != 0 {
        return doubled ^ 0x1b
    }
    doubled
}

priv fn gmul(a: u8, b: u8): u8 {
    let mut x = a
    let mut y = b
    let mut r: u8 = 0
    let mut i: usize = 0
    while i < 8 {
        if (y & 1) != 0 {
            r = r ^ x
        }
        x = xtime(x)
        y = y >> 1
        i = i + 1
    }
    r
}

/// An AES key schedule for a 128-, 192-, or 256-bit key.
///
/// ```
/// # use crypto
/// # use crypto.{Aes}
/// let key = hex_decode("000102030405060708090a0b0c0d0e0f").unwrap()
/// let aes = Aes.new(key.as_slice()).unwrap()
/// let block = aes.encrypt_block(hex_decode("00112233445566778899aabbccddeeff").unwrap().as_slice())
/// assert_eq(block.to_hex().as_str(), "69c4e0d86a7b0430d8cdb78070b4c55a")
/// ```
struct Aes {
    rk: List<u8>,
    rounds: usize,
}

Aes {
    /// Expands a 16-, 24-, or 32-byte key.
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Aes}
    /// assert(Aes.new("0123456789abcdef".as_bytes()).is_ok())
    /// assert(Aes.new("short".as_bytes()).is_err())
    /// ```
    fn new(key: [u8]): Result<Aes, CryptoError> {
        if key.len() != 16 && key.len() != 24 && key.len() != 32 {
            return Result.Err(CryptoError.InvalidLength { what: "an AES key is 16, 24, or 32 bytes".to_string() })
        }
        let nk = key.len() / 4
        let rounds = nk + 6
        let total = 4 * (rounds + 1)
        let mut w = List<u8>.new()
        w.extend_from_slice(key)
        let mut i: usize = nk
        while i < total {
            let mut t0 = w[(i - 1) * 4]
            let mut t1 = w[(i - 1) * 4 + 1]
            let mut t2 = w[(i - 1) * 4 + 2]
            let mut t3 = w[(i - 1) * 4 + 3]
            if i % nk == 0 {
                let r0 = AES_SBOX[t1 as usize] ^ AES_RCON[i / nk - 1]
                let r1 = AES_SBOX[t2 as usize]
                let r2 = AES_SBOX[t3 as usize]
                let r3 = AES_SBOX[t0 as usize]
                t0 = r0
                t1 = r1
                t2 = r2
                t3 = r3
            } else if nk > 6 && i % nk == 4 {
                t0 = AES_SBOX[t0 as usize]
                t1 = AES_SBOX[t1 as usize]
                t2 = AES_SBOX[t2 as usize]
                t3 = AES_SBOX[t3 as usize]
            }
            let p0 = w[(i - nk) * 4] ^ t0
            let p1 = w[(i - nk) * 4 + 1] ^ t1
            let p2 = w[(i - nk) * 4 + 2] ^ t2
            let p3 = w[(i - nk) * 4 + 3] ^ t3
            w.push(p0)
            w.push(p1)
            w.push(p2)
            w.push(p3)
            i = i + 1
        }
        Result.Ok(Aes { rk: w, rounds: rounds })
    }

    priv fn add_round_key(self, mut s: [u8; 16], round: usize) {
        let mut i: usize = 0
        while i < 16 {
            s[i] = s[i] ^ self.rk[round * 16 + i]
            i = i + 1
        }
    }

    /// Encrypts one 16-byte block.
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Aes}
    /// let aes = Aes.new(hex_decode("000102030405060708090a0b0c0d0e0f").unwrap().as_slice()).unwrap()
    /// let block = aes.encrypt_block(hex_decode("00112233445566778899aabbccddeeff").unwrap().as_slice())
    /// assert_eq(block.to_hex().as_str(), "69c4e0d86a7b0430d8cdb78070b4c55a")
    /// ```
    fn encrypt_block(self, block: [u8]): List<u8> {
        let mut s: [u8; 16] = [0; 16]
        let mut i: usize = 0
        while i < 16 {
            s[i] = block[i]
            i = i + 1
        }
        self.encrypt_state(mut s)
        let mut out = List<u8>.new()
        i = 0
        while i < 16 {
            out.push(s[i])
            i = i + 1
        }
        out
    }

    priv fn encrypt_state(self, mut s: [u8; 16]) {
        self.add_round_key(mut s, 0)
        let mut round: usize = 1
        while round <= self.rounds {
            let mut i: usize = 0
            while i < 16 {
                s[i] = AES_SBOX[s[i] as usize]
                i = i + 1
            }
            // ShiftRows
            let t = s
            let mut c: usize = 0
            while c < 4 {
                let mut r: usize = 1
                while r < 4 {
                    s[c * 4 + r] = t[((c + r) % 4) * 4 + r]
                    r = r + 1
                }
                c = c + 1
            }
            if round < self.rounds {
                // MixColumns
                c = 0
                while c < 4 {
                    let a0 = s[c * 4]
                    let a1 = s[c * 4 + 1]
                    let a2 = s[c * 4 + 2]
                    let a3 = s[c * 4 + 3]
                    s[c * 4] = xtime(a0) ^ (xtime(a1) ^ a1) ^ a2 ^ a3
                    s[c * 4 + 1] = a0 ^ xtime(a1) ^ (xtime(a2) ^ a2) ^ a3
                    s[c * 4 + 2] = a0 ^ a1 ^ xtime(a2) ^ (xtime(a3) ^ a3)
                    s[c * 4 + 3] = (xtime(a0) ^ a0) ^ a1 ^ a2 ^ xtime(a3)
                    c = c + 1
                }
            }
            self.add_round_key(mut s, round)
            round = round + 1
        }
    }

    /// Decrypts one 16-byte block.
    ///
    /// ```
    /// # use crypto
    /// # use crypto.{Aes}
    /// let aes = Aes.new(hex_decode("000102030405060708090a0b0c0d0e0f").unwrap().as_slice()).unwrap()
    /// let block = aes.decrypt_block(hex_decode("69c4e0d86a7b0430d8cdb78070b4c55a").unwrap().as_slice())
    /// assert_eq(block.to_hex().as_str(), "00112233445566778899aabbccddeeff")
    /// ```
    fn decrypt_block(self, block: [u8]): List<u8> {
        let mut s: [u8; 16] = [0; 16]
        let mut i: usize = 0
        while i < 16 {
            s[i] = block[i]
            i = i + 1
        }
        self.add_round_key(mut s, self.rounds)
        let mut round: usize = self.rounds
        while round >= 1 {
            // InvShiftRows
            let t = s
            let mut c: usize = 0
            while c < 4 {
                let mut r: usize = 1
                while r < 4 {
                    s[((c + r) % 4) * 4 + r] = t[c * 4 + r]
                    r = r + 1
                }
                c = c + 1
            }
            i = 0
            while i < 16 {
                s[i] = AES_INV_SBOX[s[i] as usize]
                i = i + 1
            }
            self.add_round_key(mut s, round - 1)
            if round > 1 {
                // InvMixColumns
                c = 0
                while c < 4 {
                    let a0 = s[c * 4]
                    let a1 = s[c * 4 + 1]
                    let a2 = s[c * 4 + 2]
                    let a3 = s[c * 4 + 3]
                    s[c * 4] = gmul(a0, 14) ^ gmul(a1, 11) ^ gmul(a2, 13) ^ gmul(a3, 9)
                    s[c * 4 + 1] = gmul(a0, 9) ^ gmul(a1, 14) ^ gmul(a2, 11) ^ gmul(a3, 13)
                    s[c * 4 + 2] = gmul(a0, 13) ^ gmul(a1, 9) ^ gmul(a2, 14) ^ gmul(a3, 11)
                    s[c * 4 + 3] = gmul(a0, 11) ^ gmul(a1, 13) ^ gmul(a2, 9) ^ gmul(a3, 14)
                    c = c + 1
                }
            }
            round = round - 1
        }
        let mut out = List<u8>.new()
        i = 0
        while i < 16 {
            out.push(s[i])
            i = i + 1
        }
        out
    }
}

// ----- CTR ----------------------------------------------------------------------------------------------------

priv fn increment_be(mut counter: List<u8>, from: usize) {
    // Adds one to the big-endian number in counter[from..], wrapping at its width.
    let mut i = counter.len()
    while i > from {
        i = i - 1
        counter[i] = counter[i].wrapping_add(1)
        if counter[i] != 0 {
            break
        }
    }
}

/// AES-CTR (SP 800-38A): XORs `data` with the keystream of a 16-byte initial counter block, incremented as a
/// big-endian 128-bit number. Encryption and decryption are the same call. CTR does not authenticate: pair it with
/// a MAC, or use `aes_gcm_seal`.
///
/// ```
/// # use crypto
/// # use crypto.{aes_ctr_xor}
/// let key = hex_decode("000102030405060708090a0b0c0d0e0f").unwrap()
/// let iv = hex_decode("00000000000000000000000000000000").unwrap()
/// let sealed = aes_ctr_xor(key.as_slice(), iv.as_slice(), "hello".as_bytes()).unwrap()
/// let plain = aes_ctr_xor(key.as_slice(), iv.as_slice(), sealed.as_slice()).unwrap()
/// assert_eq(plain.to_hex().as_str(), "68656c6c6f")
/// ```
fn aes_ctr_xor(key: [u8], iv: [u8], data: [u8]): Result<List<u8>, CryptoError> {
    let aes = Aes.new(key)?
    if iv.len() != 16 {
        return Result.Err(CryptoError.InvalidNonceLength { expected: 16, got: iv.len() })
    }
    let mut counter = iv.to_list()
    let mut out = List<u8>.new()
    let mut pos: usize = 0
    while pos < data.len() {
        let input = counter.clone()
        let stream = aes.encrypt_block(input.as_slice())
        let mut i: usize = 0
        while i < 16 && pos + i < data.len() {
            out.push(data[pos + i] ^ stream[i])
            i = i + 1
        }
        increment_be(mut counter, 0)
        pos = pos + 16
    }
    Result.Ok(out)
}

// ----- CBC ----------------------------------------------------------------------------------------------------

/// AES-CBC with PKCS#7 padding. The result is the ciphertext, a multiple of 16 bytes, longer than `plaintext`.
/// CBC does not authenticate: a decryptor that reveals padding errors is a padding oracle, so MAC the ciphertext
/// (encrypt-then-MAC) or use `aes_gcm_seal`.
///
/// ```
/// # use crypto
/// # use crypto.{aes_cbc_encrypt, aes_cbc_decrypt}
/// let key = hex_decode("000102030405060708090a0b0c0d0e0f").unwrap()
/// let iv = hex_decode("00000000000000000000000000000000").unwrap()
/// let ciphertext = aes_cbc_encrypt(key.as_slice(), iv.as_slice(), "hello".as_bytes()).unwrap()
/// assert_eq(ciphertext.len(), 16)
/// assert_eq(aes_cbc_decrypt(key.as_slice(), iv.as_slice(), ciphertext.as_slice()).unwrap().to_hex().as_str(), "68656c6c6f")
/// ```
fn aes_cbc_encrypt(key: [u8], iv: [u8], plaintext: [u8]): Result<List<u8>, CryptoError> {
    let aes = Aes.new(key)?
    if iv.len() != 16 {
        return Result.Err(CryptoError.InvalidNonceLength { expected: 16, got: iv.len() })
    }
    let mut padded = plaintext.to_list()
    let pad = 16 - plaintext.len() % 16
    let mut i: usize = 0
    while i < pad {
        padded.push(pad as u8)
        i = i + 1
    }
    let mut previous = iv.to_list()
    let mut out = List<u8>.new()
    let mut pos: usize = 0
    while pos < padded.len() {
        let mut block = List<u8>.new()
        i = 0
        while i < 16 {
            block.push(padded[pos + i] ^ previous[i])
            i = i + 1
        }
        previous = aes.encrypt_block(block.as_slice())
        out.extend_from_slice(previous.as_slice())
        pos = pos + 16
    }
    Result.Ok(out)
}

/// Decrypts `aes_cbc_encrypt` output and removes the padding; bad padding is `InvalidPadding`.
///
/// ```
/// # use crypto
/// # use crypto.{aes_cbc_encrypt, aes_cbc_decrypt}
/// let key = hex_decode("000102030405060708090a0b0c0d0e0f").unwrap()
/// let iv = hex_decode("00000000000000000000000000000000").unwrap()
/// let ciphertext = aes_cbc_encrypt(key.as_slice(), iv.as_slice(), "secret".as_bytes()).unwrap()
/// let plain = aes_cbc_decrypt(key.as_slice(), iv.as_slice(), ciphertext.as_slice()).unwrap()
/// assert_eq(plain.to_hex().as_str(), "736563726574")
/// ```
fn aes_cbc_decrypt(key: [u8], iv: [u8], ciphertext: [u8]): Result<List<u8>, CryptoError> {
    let aes = Aes.new(key)?
    if iv.len() != 16 {
        return Result.Err(CryptoError.InvalidNonceLength { expected: 16, got: iv.len() })
    }
    if ciphertext.len() == 0 || ciphertext.len() % 16 != 0 {
        return Result.Err(
            CryptoError.InvalidLength { what: "a CBC ciphertext is a non-empty multiple of 16 bytes".to_string() },
        )
    }
    let mut previous = iv.to_list()
    let mut out = List<u8>.new()
    let mut pos: usize = 0
    while pos < ciphertext.len() {
        let block = ciphertext[pos..pos + 16]
        let plain = aes.decrypt_block(block)
        let mut i: usize = 0
        while i < 16 {
            out.push(plain[i] ^ previous[i])
            i = i + 1
        }
        previous = block.to_list()
        pos = pos + 16
    }
    let pad = out[out.len() - 1] as usize
    if pad == 0 || pad > 16 || pad > out.len() {
        return Result.Err(CryptoError.InvalidPadding)
    }
    let mut bad: u8 = 0
    let mut i: usize = 0
    while i < pad {
        bad = bad | (out[out.len() - 1 - i] ^ (pad as u8))
        i = i + 1
    }
    if bad != 0 {
        return Result.Err(CryptoError.InvalidPadding)
    }
    let keep = out.len() - pad
    out.truncate(keep)
    Result.Ok(out)
}

// ----- GCM ----------------------------------------------------------------------------------------------------

priv fn be64(data: [u8], at: usize): u64 {
    let mut v: u64 = 0
    let mut i: usize = 0
    while i < 8 {
        v = (v << 8) | (data[at + i] as u64)
        i = i + 1
    }
    v
}

priv fn push_be64(mut out: List<u8>, v: u64) {
    let mut i: u32 = 8
    while i > 0 {
        i = i - 1
        out.push((v >> (i * 8)) as u8)
    }
}

/// Multiplies two elements of GF(2^128) as GCM defines (bit-reflected), without secret-dependent branches.
priv fn ghash_mul(xh: u64, xl: u64, yh: u64, yl: u64): (u64, u64) {
    let mut zh: u64 = 0
    let mut zl: u64 = 0
    let mut vh = yh
    let mut vl = yl
    let mut i: u32 = 0
    while i < 128 {
        let mut bit: u64 = 0
        if i < 64 {
            let sh: u32 = 63 - i
            bit = (xh >> sh) & 1
        } else {
            let sh: u32 = 127 - i
            bit = (xl >> sh) & 1
        }
        let m = (0 as u64).wrapping_sub(bit)
        zh = zh ^ (vh & m)
        zl = zl ^ (vl & m)
        let lsb = vl & 1
        vl = (vl >> 1) | (vh << 63)
        vh = vh >> 1
        vh = vh ^ (0xe100000000000000 & (0 as u64).wrapping_sub(lsb))
        i = i + 1
    }
    (zh, zl)
}

priv fn ghash(hh: u64, hl: u64, aad: [u8], ciphertext: [u8]): (u64, u64) {
    let mut yh: u64 = 0
    let mut yl: u64 = 0
    let mut part: usize = 0
    while part < 2 {
        let data = if part == 0 { aad } else { ciphertext }
        let mut pos: usize = 0
        while pos < data.len() {
            let mut block = List<u8>.new()
            let mut i: usize = 0
            while i < 16 {
                if pos + i < data.len() {
                    block.push(data[pos + i])
                } else {
                    block.push(0)
                }
                i = i + 1
            }
            yh = yh ^ be64(block.as_slice(), 0)
            yl = yl ^ be64(block.as_slice(), 8)
            let product = ghash_mul(yh, yl, hh, hl)
            yh = product.0
            yl = product.1
            pos = pos + 16
        }
        part = part + 1
    }
    yh = yh ^ ((aad.len() as u64) * 8)
    yl = yl ^ ((ciphertext.len() as u64) * 8)
    // The length block is (len(aad) in bits) || (len(ciphertext) in bits), each 64-bit big-endian: aad bits are the
    // high half, ciphertext bits the low half.
    let product = ghash_mul(yh, yl, hh, hl)
    product
}

priv fn gcm_tag(aes: Aes, nonce: [u8], aad: [u8], ciphertext: [u8]): List<u8> {
    let zero: [u8; 16] = [0; 16]
    let h = aes.encrypt_block(zero[0..16])
    let hh = be64(h.as_slice(), 0)
    let hl = be64(h.as_slice(), 8)
    let mut j0 = nonce.to_list()
    j0.extend_from_slice(GCM_ONE[0..4])
    let mask = aes.encrypt_block(j0.as_slice())
    let s = ghash(hh, hl, aad, ciphertext)
    let mut sb = List<u8>.new()
    push_be64(mut sb, s.0)
    push_be64(mut sb, s.1)
    let mut tag = List<u8>.new()
    let mut i: usize = 0
    while i < 16 {
        tag.push(sb[i] ^ mask[i])
        i = i + 1
    }
    tag
}

priv fn gcm_crypt(aes: Aes, nonce: [u8], data: [u8]): List<u8> {
    let mut counter = nonce.to_list()
    counter.extend_from_slice(GCM_TWO[0..4])
    let mut out = List<u8>.new()
    let mut pos: usize = 0
    while pos < data.len() {
        let input = counter.clone()
        let stream = aes.encrypt_block(input.as_slice())
        let mut i: usize = 0
        while i < 16 && pos + i < data.len() {
            out.push(data[pos + i] ^ stream[i])
            i = i + 1
        }
        increment_be(mut counter, 12)
        pos = pos + 16
    }
    out
}

/// AES-GCM (SP 800-38D) with a 12-byte nonce and a 16-byte tag: encrypts `plaintext` and authenticates it together
/// with `aad`. The result is the ciphertext followed by the tag. Never reuse a (key, nonce) pair: that breaks both
/// confidentiality and authenticity.
///
/// ```
/// # use crypto
/// # use crypto.{aes_gcm_seal, aes_gcm_open}
/// let key = hex_decode("000102030405060708090a0b0c0d0e0f").unwrap()
/// let nonce = hex_decode("000000000000000000000000").unwrap()
/// let sealed = aes_gcm_seal(key.as_slice(), nonce.as_slice(), "header".as_bytes(), "secret".as_bytes()).unwrap()
/// assert_eq(sealed.len(), 22)
/// assert_eq(aes_gcm_open(key.as_slice(), nonce.as_slice(), "header".as_bytes(), sealed.as_slice()).unwrap().to_hex().as_str(), "736563726574")
/// ```
fn aes_gcm_seal(key: [u8], nonce: [u8], aad: [u8], plaintext: [u8]): Result<List<u8>, CryptoError> {
    let aes = Aes.new(key)?
    if nonce.len() != 12 {
        return Result.Err(CryptoError.InvalidNonceLength { expected: 12, got: nonce.len() })
    }
    let mut sealed = gcm_crypt(aes, nonce, plaintext)
    let tag = gcm_tag(aes, nonce, aad, sealed.as_slice())
    sealed.extend_from_slice(tag.as_slice())
    Result.Ok(sealed)
}

/// Verifies and decrypts `aes_gcm_seal` output; a wrong tag is `AuthenticationFailed` and no plaintext is released.
///
/// ```
/// # use crypto
/// # use crypto.{aes_gcm_seal, aes_gcm_open}
/// let key = hex_decode("000102030405060708090a0b0c0d0e0f").unwrap()
/// let nonce = hex_decode("000000000000000000000000").unwrap()
/// let sealed = aes_gcm_seal(key.as_slice(), nonce.as_slice(), "header".as_bytes(), "secret".as_bytes()).unwrap()
/// assert(aes_gcm_open(key.as_slice(), nonce.as_slice(), "other".as_bytes(), sealed.as_slice()).is_err())
/// ```
fn aes_gcm_open(key: [u8], nonce: [u8], aad: [u8], sealed: [u8]): Result<List<u8>, CryptoError> {
    let aes = Aes.new(key)?
    if nonce.len() != 12 {
        return Result.Err(CryptoError.InvalidNonceLength { expected: 12, got: nonce.len() })
    }
    if sealed.len() < 16 {
        return Result.Err(CryptoError.InvalidLength { what: "a sealed message is at least 16 bytes (the tag)".to_string() })
    }
    let split = sealed.len() - 16
    let ciphertext = sealed[0..split]
    let expected = gcm_tag(aes, nonce, aad, ciphertext)
    if !constant_time_eq(expected.as_slice(), sealed[split..sealed.len()]) {
        return Result.Err(CryptoError.AuthenticationFailed)
    }
    Result.Ok(gcm_crypt(aes, nonce, ciphertext))
}
