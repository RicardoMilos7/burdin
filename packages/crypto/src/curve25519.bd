// X25519 (RFC 7748) and Ed25519 (RFC 8032) in pure Burdin, ported from the compact TweetNaCl design: field elements
// are sixteen 16-bit limbs in `i64`, every conditional is a mask, and the secret scalar never selects a branch or an
// index. It is slow next to an optimized implementation and has had no audit; see the package README.

use errors.CryptoError
use sha512.sha512
use util.{constant_time_eq, random_bytes}

priv const ED_D: [i64; 16] = [
    0x78a3,
    0x1359,
    0x4dca,
    0x75eb,
    0xd8ab,
    0x4141,
    0x0a4d,
    0x0070,
    0xe898,
    0x7779,
    0x4079,
    0x8cc7,
    0xfe73,
    0x2b6f,
    0x6cee,
    0x5203,
]
