// ----- the field GF(2^255 - 19) -------------------------------------------------------------------------------

priv fn gf_zero(): [i64; 16] {
    [0; 16]
}

priv fn gf_one(): [i64; 16] {
    let mut r: [i64; 16] = [0; 16]
    r[0] = 1
    r
}

priv fn gf_car(o: [i64; 16]): [i64; 16] {
    let mut r = o
    let mut i: usize = 0
    while i < 16 {
        r[i] = r[i] + 65536
        let c = r[i] >> 16
        if i < 15 {
            r[i + 1] = r[i + 1] + c - 1
        } else {
            r[0] = r[0] + 38 * (c - 1)
        }
        r[i] = r[i] - (c << 16)
        i = i + 1
    }
    r
}

priv fn gf_add(a: [i64; 16], b: [i64; 16]): [i64; 16] {
    let mut r: [i64; 16] = [0; 16]
    let mut i: usize = 0
    while i < 16 {
        r[i] = a[i] + b[i]
        i = i + 1
    }
    r
}

priv fn gf_sub(a: [i64; 16], b: [i64; 16]): [i64; 16] {
    let mut r: [i64; 16] = [0; 16]
    let mut i: usize = 0
    while i < 16 {
        r[i] = a[i] - b[i]
        i = i + 1
    }
    r
}

priv fn gf_mul(a: [i64; 16], b: [i64; 16]): [i64; 16] {
    let mut t: [i64; 31] = [0; 31]
    let mut i: usize = 0
    while i < 16 {
        let mut j: usize = 0
        while j < 16 {
            t[i + j] = t[i + j] + a[i] * b[j]
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < 15 {
        t[i] = t[i] + 38 * t[i + 16]
        i = i + 1
    }
    let mut r: [i64; 16] = [0; 16]
    i = 0
    while i < 16 {
        r[i] = t[i]
        i = i + 1
    }
    gf_car(gf_car(r))
}

priv fn gf_sq(a: [i64; 16]): [i64; 16] {
    gf_mul(a, a)
}

/// Swaps `p` and `q` when `b` is 1 and leaves them when `b` is 0, without a branch.
priv fn gf_sel(mut p: [i64; 16], mut q: [i64; 16], b: i64) {
    let c = 0 - b
    let mut i: usize = 0
    while i < 16 {
        let t = c & (p[i] ^ q[i])
        p[i] = p[i] ^ t
        q[i] = q[i] ^ t
        i = i + 1
    }
}

priv fn gf_pack(n: [i64; 16]): List<u8> {
    let mut t = gf_car(gf_car(gf_car(n)))
    let mut j: usize = 0
    while j < 2 {
        let mut m: [i64; 16] = [0; 16]
        m[0] = t[0] - 0xffed
        let mut i: usize = 1
        while i < 15 {
            m[i] = t[i] - 0xffff - ((m[i - 1] >> 16) & 1)
            m[i - 1] = m[i - 1] & 0xffff
            i = i + 1
        }
        m[15] = t[15] - 0x7fff - ((m[14] >> 16) & 1)
        let b = (m[15] >> 16) & 1
        m[14] = m[14] & 0xffff
        gf_sel(mut t, mut m, 1 - b)
        j = j + 1
    }
    let mut out = List<u8>.new()
    let mut i: usize = 0
    while i < 16 {
        out.push((t[i] & 0xff) as u8)
        out.push((t[i] >> 8) as u8)
        i = i + 1
    }
    out
}

priv fn gf_unpack(n: [u8]): [i64; 16] {
    let mut o: [i64; 16] = [0; 16]
    let mut i: usize = 0
    while i < 16 {
        o[i] = (n[2 * i] as i64) + ((n[2 * i + 1] as i64) << 8)
        i = i + 1
    }
    o[15] = o[15] & 0x7fff
    o
}

priv fn gf_neq(a: [i64; 16], b: [i64; 16]): bool {
    let x = gf_pack(a)
    let y = gf_pack(b)
    !constant_time_eq(x.as_slice(), y.as_slice())
}

priv fn gf_parity(a: [i64; 16]): u8 {
    let d = gf_pack(a)
    d[0] & 1
}

priv fn gf_inv(i: [i64; 16]): [i64; 16] {
    let mut c = i
    let mut a: i32 = 253
    while a >= 0 {
        c = gf_sq(c)
        if a != 2 && a != 4 {
            c = gf_mul(c, i)
        }
        a = a - 1
    }
    c
}

priv fn gf_pow2523(i: [i64; 16]): [i64; 16] {
    let mut c = i
    let mut a: i32 = 250
    while a >= 0 {
        c = gf_sq(c)
        if a != 1 {
            c = gf_mul(c, i)
        }
        a = a - 1
    }
    c
}

// ----- X25519 -------------------------------------------------------------------------------------------------

priv fn scalarmult_montgomery(n: [u8], p: [u8]): List<u8> {
    let mut z: [u8; 32] = [0; 32]
    let mut i: usize = 0
    while i < 32 {
        z[i] = n[i]
        i = i + 1
    }
    z[31] = (z[31] & 127) | 64
    z[0] = z[0] & 248
    let x = gf_unpack(p)
    let mut a = gf_one()
    let mut b = x
    let mut c = gf_zero()
    let mut d = gf_one()
    let mut bit: i32 = 254
    while bit >= 0 {
        let r = ((z[(bit / 8) as usize] >> ((bit % 8) as u32)) & 1) as i64
        gf_sel(mut a, mut b, r)
        gf_sel(mut c, mut d, r)
        let e = gf_add(a, c)
        a = gf_sub(a, c)
        c = gf_add(b, d)
        b = gf_sub(b, d)
        d = gf_sq(e)
        let f = gf_sq(a)
        a = gf_mul(c, a)
        c = gf_mul(b, e)
        let e2 = gf_add(a, c)
        a = gf_sub(a, c)
        b = gf_sq(a)
        c = gf_sub(d, f)
        a = gf_mul(c, GF_121665)
        a = gf_add(a, d)
        c = gf_mul(c, a)
        a = gf_mul(d, f)
        d = gf_mul(b, x)
        b = gf_sq(e2)
        gf_sel(mut a, mut b, r)
        gf_sel(mut c, mut d, r)
        bit = bit - 1
    }
    let inverse = gf_inv(c)
    gf_pack(gf_mul(a, inverse))
}

/// X25519 (RFC 7748): the Diffie-Hellman function on Curve25519. `scalar` is a 32-byte secret (it is clamped here)
/// and `point` the peer's 32-byte u-coordinate; the result is the 32-byte shared secret. An all-zero result (the
/// peer sent a low-order point) is reported as `InvalidPoint`; run the secret through HKDF before using it as a key.
///
/// ```
/// # use crypto
/// # use crypto.{x25519}
/// let scalar = hex_decode("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4").unwrap()
/// let point = hex_decode("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c").unwrap()
/// assert_eq(x25519(scalar.as_slice(), point.as_slice()).unwrap().to_hex().as_str(), "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552")
/// ```
fn x25519(scalar: [u8], point: [u8]): Result<List<u8>, CryptoError> {
    if scalar.len() != 32 {
        return Err(CryptoError.InvalidKeyLength { expected: 32, got: scalar.len() })
    }
    if point.len() != 32 {
        return Err(CryptoError.InvalidLength { what: "an X25519 point is 32 bytes".to_string() })
    }
    let out = scalarmult_montgomery(scalar, point)
    let mut acc: u8 = 0
    let mut i: usize = 0
    while i < 32 {
        acc = acc | out[i]
        i = i + 1
    }
    if acc == 0 {
        return Err(CryptoError.InvalidPoint)
    }
    Ok(out)
}

/// The X25519 public key for a 32-byte secret: the scalar times the base point (u = 9).
///
/// ```
/// # use crypto
/// # use crypto.{x25519_public_key}
/// let secret = hex_decode("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a").unwrap()
/// assert_eq(x25519_public_key(secret.as_slice()).unwrap().to_hex().as_str(), "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a")
/// ```
fn x25519_public_key(scalar: [u8]): Result<List<u8>, CryptoError> {
    if scalar.len() != 32 {
        return Err(CryptoError.InvalidKeyLength { expected: 32, got: scalar.len() })
    }
    let mut base: [u8; 32] = [0; 32]
    base[0] = 9
    Ok(scalarmult_montgomery(scalar, base[0..32]))
}

/// A new random X25519 secret key (32 bytes from the OS entropy source).
///
/// ```
/// # use crypto
/// # use crypto.{x25519_generate_secret, x25519_public_key}
/// let secret = x25519_generate_secret()
/// assert_eq(secret.len(), 32)
/// assert_eq(x25519_public_key(secret.as_slice()).unwrap().len(), 32)
/// ```
fn x25519_generate_secret(): List<u8> {
    random_bytes(32)
}

// ----- Ed25519 ------------------------------------------------------------------------------------------------

priv struct Point: Copy, Clone {
    x: [i64; 16],
    y: [i64; 16],
    z: [i64; 16],
    t: [i64; 16],
}

priv fn point_identity(): Point {
    Point { x: gf_zero(), y: gf_one(), z: gf_one(), t: gf_zero() }
}

priv fn point_add(p: Point, q: Point): Point {
    let a = gf_mul(gf_sub(p.y, p.x), gf_sub(q.y, q.x))
    let b = gf_mul(gf_add(p.x, p.y), gf_add(q.x, q.y))
    let c = gf_mul(gf_mul(p.t, q.t), ED_D2)
    let d0 = gf_mul(p.z, q.z)
    let d = gf_add(d0, d0)
    let e = gf_sub(b, a)
    let f = gf_sub(d, c)
    let g = gf_add(d, c)
    let h = gf_add(b, a)
    Point { x: gf_mul(e, f), y: gf_mul(h, g), z: gf_mul(g, f), t: gf_mul(e, h) }
}

priv fn point_cswap(mut p: Point, mut q: Point, b: i64) {
    gf_sel(mut p.x, mut q.x, b)
    gf_sel(mut p.y, mut q.y, b)
    gf_sel(mut p.z, mut q.z, b)
    gf_sel(mut p.t, mut q.t, b)
}

priv fn point_pack(p: Point): List<u8> {
    let zi = gf_inv(p.z)
    let tx = gf_mul(p.x, zi)
    let ty = gf_mul(p.y, zi)
    let mut r = gf_pack(ty)
    r[31] = r[31] ^ (gf_parity(tx) << 7)
    r
}

priv fn point_scalarmult(q0: Point, s: [u8]): Point {
    let mut p = point_identity()
    let mut q = q0
    let mut i: i32 = 255
    while i >= 0 {
        let b = ((s[(i / 8) as usize] >> ((i % 8) as u32)) & 1) as i64
        point_cswap(mut p, mut q, b)
        let nq = point_add(q, p)
        let np = point_add(p, p)
        q = nq
        p = np
        point_cswap(mut p, mut q, b)
        i = i - 1
    }
    p
}

priv fn point_base(s: [u8]): Point {
    let base = Point { x: ED_X, y: ED_Y, z: gf_one(), t: gf_mul(ED_X, ED_Y) }
    point_scalarmult(base, s)
}

/// Decodes a compressed point and negates it (what verification needs). Returns `None` when it is not on the curve.
priv fn point_unpack_negated(pk: [u8]): Option<Point> {
    let y = gf_unpack(pk)
    let z = gf_one()
    let num0 = gf_sq(y)
    let den0 = gf_mul(num0, ED_D)
    let num = gf_sub(num0, z)
    let den = gf_add(z, den0)
    let den2 = gf_sq(den)
    let den4 = gf_sq(den2)
    let den6 = gf_mul(den4, den2)
    let mut t = gf_mul(gf_mul(den6, num), den)
    t = gf_pow2523(t)
    t = gf_mul(gf_mul(gf_mul(t, num), den), den)
    let mut x = gf_mul(t, den)
    let mut chk = gf_mul(gf_sq(x), den)
    if gf_neq(chk, num) {
        x = gf_mul(x, ED_I)
    }
    chk = gf_mul(gf_sq(x), den)
    if gf_neq(chk, num) {
        return None
    }
    if gf_parity(x) == (pk[31] >> 7) {
        x = gf_sub(gf_zero(), x)
    }
    Some(Point { x: x, y: y, z: z, t: gf_mul(x, y) })
}

/// Reduces a 64-byte little-endian number modulo the group order L, giving 32 bytes.
priv fn mod_l(mut x: [i64; 64]): List<u8> {
    let mut i: usize = 63
    while i >= 32 {
        let mut carry: i64 = 0
        let mut j: usize = i - 32
        while j < i - 12 {
            x[j] = x[j] + carry - 16 * x[i] * ED_L[j - (i - 32)]
            carry = (x[j] + 128) >> 8
            x[j] = x[j] - (carry << 8)
            j = j + 1
        }
        x[j] = x[j] + carry
        x[i] = 0
        i = i - 1
    }
    let mut carry: i64 = 0
    let mut j: usize = 0
    while j < 32 {
        x[j] = x[j] + carry - (x[31] >> 4) * ED_L[j]
        carry = x[j] >> 8
        x[j] = x[j] & 255
        j = j + 1
    }
    j = 0
    while j < 32 {
        x[j] = x[j] - carry * ED_L[j]
        j = j + 1
    }
    let mut out = List<u8>.new()
    let mut k: usize = 0
    while k < 32 {
        x[k + 1] = x[k + 1] + (x[k] >> 8)
        out.push((x[k] & 255) as u8)
        k = k + 1
    }
    out
}

priv fn reduce64(h: [u8]): List<u8> {
    let mut x: [i64; 64] = [0; 64]
    let mut i: usize = 0
    while i < 64 {
        x[i] = h[i] as i64
        i = i + 1
    }
    mod_l(mut x)
}

priv fn expand_seed(seed: [u8]): List<u8> {
    let mut d = sha512(seed)
    d[0] = d[0] & 248
    d[31] = (d[31] & 127) | 64
    d
}

/// The Ed25519 public key (32 bytes) of a 32-byte secret seed.
///
/// ```
/// # use crypto
/// # use crypto.{ed25519_public_key}
/// let seed = hex_decode("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60").unwrap()
/// assert_eq(ed25519_public_key(seed.as_slice()).unwrap().to_hex().as_str(), "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
/// ```
fn ed25519_public_key(seed: [u8]): Result<List<u8>, CryptoError> {
    if seed.len() != 32 {
        return Err(CryptoError.InvalidKeyLength { expected: 32, got: seed.len() })
    }
    let d = expand_seed(seed)
    Ok(point_pack(point_base(d.as_slice()[0..32])))
}

/// A new random Ed25519 key pair: the 32-byte secret seed and the 32-byte public key.
///
/// ```
/// # use crypto
/// # use crypto.{ed25519_generate, ed25519_public_key}
/// let (seed, public_key) = ed25519_generate()
/// assert_eq(seed.len(), 32)
/// assert_eq(ed25519_public_key(seed.as_slice()).unwrap().to_hex().as_str(), public_key.to_hex().as_str())
/// ```
fn ed25519_generate(): (List<u8>, List<u8>) {
    let seed = random_bytes(32)
    let public = ed25519_public_key(seed.as_slice()).unwrap()
    (seed, public)
}

/// Signs `message` with a 32-byte secret seed; the signature is 64 bytes (R, then S). Ed25519 signing is
/// deterministic: the same seed and message give the same signature.
///
/// ```
/// # use crypto
/// # use crypto.{ed25519_sign}
/// let seed = hex_decode("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60").unwrap()
/// let signature = ed25519_sign(seed.as_slice(), "".as_bytes()).unwrap()
/// assert_eq(signature.to_hex().as_str(), "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
/// ```
fn ed25519_sign(seed: [u8], message: [u8]): Result<List<u8>, CryptoError> {
    if seed.len() != 32 {
        return Err(CryptoError.InvalidKeyLength { expected: 32, got: seed.len() })
    }
    let d = expand_seed(seed)
    let public = point_pack(point_base(d.as_slice()[0..32]))
    let mut hr_input = List<u8>.new()
    hr_input.extend_from_slice(d.as_slice()[32..64])
    hr_input.extend_from_slice(message)
    let r = reduce64(sha512(hr_input.as_slice()).as_slice())
    let big_r = point_pack(point_base(r.as_slice()))
    let mut hk_input = List<u8>.new()
    hk_input.extend_from_slice(big_r.as_slice())
    hk_input.extend_from_slice(public.as_slice())
    hk_input.extend_from_slice(message)
    let h = reduce64(sha512(hk_input.as_slice()).as_slice())
    let mut x: [i64; 64] = [0; 64]
    let mut i: usize = 0
    while i < 32 {
        x[i] = r[i] as i64
        i = i + 1
    }
    i = 0
    while i < 32 {
        let mut j: usize = 0
        while j < 32 {
            x[i + j] = x[i + j] + (h[i] as i64) * (d[j] as i64)
            j = j + 1
        }
        i = i + 1
    }
    let s = mod_l(mut x)
    let mut sig = big_r
    sig.extend_from_slice(s.as_slice())
    Ok(sig)
}

/// Whether the little-endian number `s` is smaller than the group order L (a canonical signature scalar).
priv fn scalar_is_canonical(s: [u8]): bool {
    let mut i: usize = 32
    while i > 0 {
        i = i - 1
        let a = s[i] as i64
        let b = ED_L[i]
        if a < b {
            return true
        }
        if a > b {
            return false
        }
    }
    false
}

/// Whether `signature` is a valid Ed25519 signature of `message` under `public_key`. Malformed input (wrong
/// lengths, a point that is not on the curve, a non-canonical scalar) is simply `false`.
///
/// ```
/// # use crypto
/// # use crypto.{ed25519_sign, ed25519_verify, ed25519_public_key}
/// let seed = hex_decode("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60").unwrap()
/// let public_key = ed25519_public_key(seed.as_slice()).unwrap()
/// let signature = ed25519_sign(seed.as_slice(), "hello".as_bytes()).unwrap()
/// assert(ed25519_verify(public_key.as_slice(), "hello".as_bytes(), signature.as_slice()))
/// assert(!ed25519_verify(public_key.as_slice(), "hullo".as_bytes(), signature.as_slice()))
/// ```
fn ed25519_verify(public_key: [u8], message: [u8], signature: [u8]): bool {
    if public_key.len() != 32 || signature.len() != 64 {
        return false
    }
    if !scalar_is_canonical(signature[32..64]) {
        return false
    }
    let negated = match point_unpack_negated(public_key) {
        Some(q) => q,
        None => return false,
    }
    let mut hk_input = List<u8>.new()
    hk_input.extend_from_slice(signature[0..32])
    hk_input.extend_from_slice(public_key)
    hk_input.extend_from_slice(message)
    let h = reduce64(sha512(hk_input.as_slice()).as_slice())
    let p = point_scalarmult(negated, h.as_slice())
    let q = point_base(signature[32..64])
    let sum = point_pack(point_add(p, q))
    constant_time_eq(sum.as_slice(), signature[0..32])
}
