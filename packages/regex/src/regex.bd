// Regular expressions (issue #264; spec/regex.md). A pattern is compiled once with `Regex.new` and then searches any
// number of texts. The engine is a Pike VM, so every search runs in time proportional to the pattern times the text,
// and a pattern that the engine cannot run in that time (a lookaround, a backreference) is rejected when it compiles.
//
// The public types are `Regex`, `Match` (one matched span with its text), `Captures` (the groups of one match), and
// `RegexError` (a bad pattern, with the byte offset of the problem).

pub use errors.RegexError
use compile.{Program, compile}
use parse.parse
use vm.run

/// A compiled regular expression (RX9). It does not change after `new`, so one can serve many searches.
///
/// ```
/// # use regex.{Regex}
/// let re = Regex.new("a+b").unwrap()
/// assert(re.is_match("xaaab"))
/// assert(!re.is_match("ba"))
/// ```
struct Regex {
    priv pattern: String,
    priv prog: Program,
    /// The name of each group: `names[0]` is group 0 (the whole match), which has none.
    priv names: List<Option<String>>,
}

/// One match: the byte offsets of its span in the searched text, and a copy of the matched text (RX14).
///
/// ```
/// # use regex.{Regex}
/// let m = Regex.new("b+").unwrap().find("abbc").unwrap()
/// assert_eq(m.start(), 1)
/// assert_eq(m.end(), 3)
/// assert_eq(m.as_str(), "bb")
/// ```
struct Match: Clone, Eq, Debug {
    span_start: usize,
    span_end: usize,
    text: String,
}

/// The groups of one match (RX8). `spans[i]` is group `i`, and `None` for a group that did not take part.
///
/// ```
/// # use regex.{Regex}
/// let caps = Regex.new("(\\w)(\\w)").unwrap().captures("ab").unwrap()
/// assert_eq(caps.len(), 3)
/// assert_eq(caps.get(2).unwrap().as_str(), "b")
/// ```
struct Captures: Debug {
    priv spans: List<Option<Match>>,
    priv names: List<Option<String>>,
}

Regex {
    /// Compiles `pattern` (RX2), or reports the first problem with its byte offset (RX3).
    ///
    /// ```
    /// # use regex.{Regex}
    /// let re = Regex.new("(\\d+)").unwrap()
    /// assert_eq(re.group_count(), 1)
    /// assert(Regex.new("(").is_err())
    /// ```
    fn new(pattern: str): Result<Regex, RegexError> {
        let parsed = parse(pattern)?
        let mut names = List<Option<String>>.new()
        names.push(Option.None)
        let mut i: usize = 0
        while i < parsed.names.len() {
            match parsed.names[i].clone() {
                Option.Some(label) => names.push(Option.Some(label)),
                Option.None => names.push(Option.None),
            }
            i = i + 1
        }
        let prog = compile(parsed)?
        Result.Ok(Regex { pattern: pattern.to_string(), prog: prog, names: names })
    }

    /// `text` with each metacharacter escaped, so that `Regex.new` of the result matches `text` exactly (RX13).
    ///
    /// ```
    /// # use regex.{Regex}
    /// assert_eq(Regex.escape("a.b").as_str(), "a\\.b")
    /// assert(Regex.new(Regex.escape("1+1")).unwrap().is_match("1+1"))
    /// ```
    fn escape(text: str): String {
        let mut out = String.new()
        for c in text.chars() {
            if is_meta(c) {
                out.push('\\')
            }
            out.push(c)
        }
        out
    }

    /// The pattern this regex was compiled from.
    ///
    /// ```
    /// # use regex.{Regex}
    /// assert_eq(Regex.new("a+").unwrap().as_str(), "a+")
    /// ```
    fn as_str(self): str {
        self.pattern.as_str()
    }

    /// The number of capturing groups, not counting group 0.
    ///
    /// ```
    /// # use regex.{Regex}
    /// assert_eq(Regex.new("(a)(b)").unwrap().group_count(), 2)
    /// assert_eq(Regex.new("ab").unwrap().group_count(), 0)
    /// ```
    fn group_count(self): usize {
        self.names.len() - 1
    }

    /// The number of the group named `name`, if there is one.
    ///
    /// ```
    /// # use regex.{Regex}
    /// let re = Regex.new("(?P<word>\\w+)").unwrap()
    /// assert_eq(re.group_index("word").unwrap(), 1)
    /// assert(re.group_index("missing").is_none())
    /// ```
    fn group_index(self, name: str): Option<usize> {
        name_index(self.names.as_slice(), name)
    }

    /// Whether the pattern matches somewhere in `text`.
    ///
    /// ```
    /// # use regex.{Regex}
    /// let re = Regex.new("^\\d+$").unwrap()
    /// assert(re.is_match("123"))
    /// assert(!re.is_match("12a"))
    /// ```
    fn is_match(self, text: str): bool {
        run(&self.prog, text.as_bytes(), 0, false).is_some()
    }

    /// The leftmost match in `text`.
    ///
    /// ```
    /// # use regex.{Regex}
    /// let m = Regex.new("\\d+").unwrap().find("abc 42").unwrap()
    /// assert_eq(m.as_str(), "42")
    /// assert_eq(m.start(), 4)
    /// ```
    fn find(self, text: str): Option<Match> {
        match run(&self.prog, text.as_bytes(), 0, false) {
            Option.Some(slots) => Option.Some(whole_match(text, slots.as_slice())),
            Option.None => Option.None,
        }
    }

    /// Every match in `text`, from left to right without overlap (RX10).
    ///
    /// ```
    /// # use regex.{Regex}
    /// let words = Regex.new("\\w+").unwrap().find_all("two words")
    /// assert_eq(words.len(), 2)
    /// assert_eq(words[1].as_str(), "words")
    /// ```
    fn find_all(self, text: str): List<Match> {
        let found = self.all_slots(text, Option.None)
        let mut out = List<Match>.new()
        let mut i: usize = 0
        while i < found.len() {
            out.push(whole_match(text, found[i].as_slice()))
            i = i + 1
        }
        out
    }

    /// The leftmost match in `text` with its groups.
    ///
    /// ```
    /// # use regex.{Regex}
    /// let caps = Regex.new("(\\d+)-(\\d+)").unwrap().captures("released 2024-05").unwrap()
    /// assert_eq(caps.get(2).unwrap().as_str(), "05")
    /// ```
    fn captures(self, text: str): Option<Captures> {
        match run(&self.prog, text.as_bytes(), 0, false) {
            Option.Some(slots) => Option.Some(self.captures_of(text, slots.as_slice())),
            Option.None => Option.None,
        }
    }

    /// Every match in `text` with its groups (RX10).
    ///
    /// ```
    /// # use regex.{Regex}
    /// let all = Regex.new("(\\w)=").unwrap().captures_all("a=1 b=2")
    /// assert_eq(all.len(), 2)
    /// assert_eq(all[1].get(1).unwrap().as_str(), "b")
    /// ```
    fn captures_all(self, text: str): List<Captures> {
        let found = self.all_slots(text, Option.None)
        let mut out = List<Captures>.new()
        let mut i: usize = 0
        while i < found.len() {
            out.push(self.captures_of(text, found[i].as_slice()))
            i = i + 1
        }
        out
    }

    /// `text` with its first match replaced by `replacement`, which may use the references of RX11.
    ///
    /// ```
    /// # use regex.{Regex}
    /// assert_eq(Regex.new("o").unwrap().replace("foo", "0").as_str(), "f0o")
    /// ```
    fn replace(self, text: str, replacement: str): String {
        self.replace_with(text, Option.Some(1), replacement)
    }

    /// `text` with its first `limit` matches replaced by `replacement` (RX11).
    ///
    /// ```
    /// # use regex.{Regex}
    /// assert_eq(Regex.new("a").unwrap().replacen("aaa", 2, "b").as_str(), "bba")
    /// ```
    fn replacen(self, text: str, limit: usize, replacement: str): String {
        self.replace_with(text, Option.Some(limit), replacement)
    }

    /// `text` with every match replaced by `replacement` (RX11).
    ///
    /// ```
    /// # use regex.{Regex}
    /// assert_eq(Regex.new("\\s+").unwrap().replace_all("a   b", " ").as_str(), "a b")
    /// ```
    fn replace_all(self, text: str, replacement: str): String {
        self.replace_with(text, Option.None, replacement)
    }

    /// The pieces of `text` between the matches (RX12).
    ///
    /// ```
    /// # use regex.{Regex}
    /// let pieces = Regex.new(",\\s*").unwrap().split("a, b,c")
    /// assert_eq(pieces.len(), 3)
    /// assert_eq(pieces[1].as_str(), "b")
    /// ```
    fn split(self, text: str): List<String> {
        self.split_with(text, Option.None)
    }

    /// At most `limit` pieces of `text`: the last one is the rest of the text (RX12).
    ///
    /// ```
    /// # use regex.{Regex}
    /// let pieces = Regex.new(",").unwrap().splitn("a,b,c", 2)
    /// assert_eq(pieces[1].as_str(), "b,c")
    /// ```
    fn splitn(self, text: str, limit: usize): List<String> {
        self.split_with(text, Option.Some(limit))
    }

    /// The capture slots of every match, from left to right (RX10). At most `limit` of them when one is given.
    priv fn all_slots(self, text: str, limit: Option<usize>): List<List<Option<usize>>> {
        let bytes = text.as_bytes()
        let len = text.len()
        let mut out = List<List<Option<usize>>>.new()
        let mut pos: usize = 0
        let mut after_empty = false
        loop {
            if pos > len {
                break
            }
            if let Option.Some(max) = limit {
                if out.len() >= max {
                    break
                }
            }
            match run(&self.prog, bytes, pos, after_empty) {
                Option.None => break,
                Option.Some(slots) => {
                    let start = slots[0].unwrap()
                    let end = slots[1].unwrap()
                    // After an empty match the next one may not be empty at the same place (Python's `finditer`).
                    after_empty = end == start
                    pos = end
                    out.push(slots)
                }
            }
        }
        out
    }

    priv fn captures_of(self, text: str, slots: [Option<usize>]): Captures {
        let mut spans = List<Option<Match>>.new()
        let groups = self.names.len()
        let mut g: usize = 0
        while g < groups {
            spans.push(span_of(text, slots[2 * g], slots[2 * g + 1]))
            g = g + 1
        }
        let mut names = List<Option<String>>.new()
        let mut i: usize = 0
        while i < groups {
            match self.names[i].clone() {
                Option.Some(label) => names.push(Option.Some(label)),
                Option.None => names.push(Option.None),
            }
            i = i + 1
        }
        Captures { spans: spans, names: names }
    }

    priv fn replace_with(self, text: str, limit: Option<usize>, replacement: str): String {
        let found = self.all_slots(text, limit)
        let mut out = String.new()
        let mut last: usize = 0
        let mut i: usize = 0
        while i < found.len() {
            let slots = found[i].as_slice()
            let start = slots[0].unwrap()
            let end = slots[1].unwrap()
            out.push_str(text[last..start])
            let caps = self.captures_of(text, slots)
            out.push_str(caps.expand(replacement).as_str())
            last = end
            i = i + 1
        }
        out.push_str(text[last..text.len()])
        out
    }

    priv fn split_with(self, text: str, limit: Option<usize>): List<String> {
        let mut pieces = List<String>.new()
        if let Option.Some(n) = limit {
            if n == 0 {
                return pieces
            }
        }
        // `n` pieces take `n - 1` matches.
        let max_matches = match limit {
            Option.Some(n) => Option.Some(n - 1),
            Option.None => Option.None,
        }
        let found = self.all_slots(text, max_matches)
        let mut last: usize = 0
        let mut i: usize = 0
        while i < found.len() {
            let slots = found[i].as_slice()
            pieces.push(text[last..slots[0].unwrap()].to_string())
            last = slots[1].unwrap()
            i = i + 1
        }
        pieces.push(text[last..text.len()].to_string())
        pieces
    }
}

Match {
    /// The byte offset where the match starts.
    ///
    /// ```
    /// # use regex.{Regex}
    /// let m = Regex.new("c").unwrap().find("abc").unwrap()
    /// assert_eq(m.start(), 2)
    /// ```
    fn start(self): usize {
        self.span_start
    }

    /// The byte offset just past the end of the match.
    ///
    /// ```
    /// # use regex.{Regex}
    /// let m = Regex.new("c").unwrap().find("abc").unwrap()
    /// assert_eq(m.end(), 3)
    /// ```
    fn end(self): usize {
        self.span_end
    }

    /// The matched text.
    ///
    /// ```
    /// # use regex.{Regex}
    /// let m = Regex.new("\\d+").unwrap().find("order 66").unwrap()
    /// assert_eq(m.as_str(), "66")
    /// ```
    fn as_str(self): str {
        self.text.as_str()
    }

    /// The length of the match in bytes.
    ///
    /// ```
    /// # use regex.{Regex}
    /// let m = Regex.new("b+").unwrap().find("abbc").unwrap()
    /// assert_eq(m.len(), 2)
    /// ```
    fn len(self): usize {
        self.span_end - self.span_start
    }

    /// Whether the match is empty.
    ///
    /// ```
    /// # use regex.{Regex}
    /// let m = Regex.new("x*").unwrap().find("abc").unwrap()
    /// assert(m.is_empty())
    /// assert(!Regex.new("a").unwrap().find("a").unwrap().is_empty())
    /// ```
    fn is_empty(self): bool {
        self.span_end == self.span_start
    }
}

Captures {
    /// The number of groups, including group 0 (the whole match).
    ///
    /// ```
    /// # use regex.{Regex}
    /// let caps = Regex.new("(\\w)(\\w)").unwrap().captures("ab").unwrap()
    /// assert_eq(caps.len(), 3)
    /// ```
    fn len(self): usize {
        self.spans.len()
    }

    /// Group `index`, or None when there is no such group or it did not take part in the match.
    ///
    /// ```
    /// # use regex.{Regex}
    /// let caps = Regex.new("(a)(x)?").unwrap().captures("a").unwrap()
    /// assert_eq(caps.get(1).unwrap().as_str(), "a")
    /// assert(caps.get(2).is_none())
    /// assert(caps.get(9).is_none())
    /// ```
    fn get(self, index: usize): Option<Match> {
        if index < self.spans.len() {
            self.spans[index].clone()
        } else {
            Option.None
        }
    }

    /// The group named `name`, or None when there is no such group or it did not take part.
    ///
    /// ```
    /// # use regex.{Regex}
    /// let caps = Regex.new("(?P<key>\\w+)=").unwrap().captures("key=").unwrap()
    /// assert_eq(caps.name("key").unwrap().as_str(), "key")
    /// assert(caps.name("other").is_none())
    /// ```
    fn name(self, key: str): Option<Match> {
        match name_index(self.names.as_slice(), key) {
            Option.Some(index) => self.get(index),
            Option.None => Option.None,
        }
    }

    /// `template` with its references replaced by the groups of this match (RX11). A reference is `$N`, `$name`,
    /// `${N}`, or `${name}`, and `$$` is a dollar sign. A reference to a missing or unset group is empty.
    ///
    /// ```
    /// # use regex.{Regex}
    /// let caps = Regex.new("(\\w)(\\w)").unwrap().captures("ab").unwrap()
    /// assert_eq(caps.expand("$2$1").as_str(), "ba")
    /// ```
    fn expand(self, template: str): String {
        let chars = template.to_char_list()
        let mut out = String.new()
        let mut i: usize = 0
        while i < chars.len() {
            let c = chars[i]
            if c != '$' {
                out.push(c)
                i = i + 1
            } else if i + 1 < chars.len() && chars[i + 1] == '$' {
                out.push('$')
                i = i + 2
            } else if i + 1 < chars.len() && chars[i + 1] == '{' {
                let mut close = i + 2
                while close < chars.len() && chars[close] != '}' {
                    close = close + 1
                }
                if close >= chars.len() {
                    out.push('$')
                    i = i + 1
                } else {
                    let key = slice_text(chars.as_slice(), i + 2, close)
                    out.push_str(self.reference(key.as_str()).as_str())
                    i = close + 1
                }
            } else {
                let mut end = i + 1
                if end < chars.len() && chars[end].is_ascii_digit() {
                    while end < chars.len() && chars[end].is_ascii_digit() {
                        end = end + 1
                    }
                } else {
                    while end < chars.len() && (chars[end].is_ascii_alphanumeric() || chars[end] == '_') {
                        end = end + 1
                    }
                }
                if end == i + 1 {
                    out.push('$')
                    i = i + 1
                } else {
                    let key = slice_text(chars.as_slice(), i + 1, end)
                    out.push_str(self.reference(key.as_str()).as_str())
                    i = end
                }
            }
        }
        out
    }

    /// The text of the group a reference names by number or by name, empty when there is no such group.
    priv fn reference(self, key: str): String {
        let index = if all_digits(key) {
            parse_index(key)
        } else {
            name_index(self.names.as_slice(), key)
        }
        match index {
            Option.Some(i) => match self.get(i) {
                Option.Some(m) => m.as_str().to_string(),
                Option.None => String.new(),
            },
            Option.None => String.new(),
        }
    }
}

/// The span `start..end` of `text` as a match, or None when the group did not take part.
priv fn span_of(text: str, start: Option<usize>, end: Option<usize>): Option<Match> {
    match start {
        Option.Some(s) => match end {
            Option.Some(e) => Option.Some(Match { span_start: s, span_end: e, text: text[s..e].to_string() }),
            Option.None => Option.None,
        },
        Option.None => Option.None,
    }
}

/// The match of group 0 in `slots`.
priv fn whole_match(text: str, slots: [Option<usize>]): Match {
    let start = slots[0].unwrap()
    let end = slots[1].unwrap()
    Match { span_start: start, span_end: end, text: text[start..end].to_string() }
}

/// The number of the group named `name` in `names` (where `names[i]` is group `i`).
priv fn name_index(names: [Option<String>], name: str): Option<usize> {
    let wanted = Option.Some(name.to_string())
    let mut i: usize = 0
    while i < names.len() {
        if names[i] == wanted {
            return Option.Some(i)
        }
        i = i + 1
    }
    Option.None
}

/// The characters `Regex.escape` puts a backslash before (RX13).
priv fn is_meta(c: char): bool {
    match c {
        '\\' | '.' | '+' | '*' | '?' | '(' | ')' | '|' | '[' | ']' | '{' | '}' | '^' | '$' | '#' | '&' | '-' | '~' => true,
        _ => false,
    }
}

priv fn all_digits(key: str): bool {
    if key.is_empty() {
        return false
    }
    for c in key.chars() {
        if !c.is_ascii_digit() {
            return false
        }
    }
    true
}

/// The value of a string of decimal digits, or None when it is too large to be a group number.
priv fn parse_index(key: str): Option<usize> {
    let mut value: usize = 0
    for c in key.chars() {
        match c.to_digit(10) {
            Option.Some(d) => {
                if value > 100000 {
                    return Option.None
                }
                value = value * 10 + (d as usize)
            }
            Option.None => return Option.None,
        }
    }
    Option.Some(value)
}

/// The text of the characters `from..to` of `chars`.
priv fn slice_text(chars: [char], begin: usize, finish: usize): String {
    let mut out = String.new()
    let mut i = begin
    while i < finish {
        out.push(chars[i])
        i = i + 1
    }
    out
}
