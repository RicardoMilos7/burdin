// Paths (issue #194; spec/stdlib.md, "Paths").
//
// A `Path` is text plus the rules that read it: Unix rules (`/` is the only separator) or Windows rules (`/` and `\` both
// separate, and a drive such as `C:` is a prefix). There is one module for both: `Path.new` picks the rules of the system
// the program is compiled for, and `Path.unix` and `Path.windows` pick them explicitly, so either set can be used and
// tested on any system. Every operation is lexical: only `exists` looks at the file system, and nothing here resolves
// symbolic links or makes a path absolute.

use fmt.{Debug, Display, Formatter}
use target.{Os, os}
use text.to_char_list

/// A file system path and the rules it follows.
///
/// ```
/// let p = Path.unix("/home/user/notes.txt")
/// assert_eq(p.file_name(), Some(String.from("notes.txt")))
/// let parent = p.parent().unwrap()
/// assert_eq(parent.as_str(), "/home/user")
/// ```
struct Path: Clone, Eq {
    text: String
    is_windows: bool
}

// `access` is the POSIX name; the Windows C runtime spells it `_access`. Only the one for the target is called.
extern "C" {
    priv fn access(path: CPtr<CChar>, mode: i32): i32
    priv fn _access(path: CPtr<CChar>, mode: i32): i32
}

priv fn __is_sep(c: char, windows: bool): bool {
    c == '/' || (windows && c == '\\')
}

/// The length of a Windows drive prefix (`C:`), or zero.
priv fn __prefix_len(chars: List<char>, windows: bool): usize {
    if windows && chars.len() >= 2 && chars[1] == ':' {
        let c = chars[0]
        if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
            return 2
        }
    }
    0
}

/// Whether a separator follows the prefix.
priv fn __is_rooted(chars: List<char>, prefix: usize, windows: bool): bool {
    chars.len() > prefix && __is_sep(chars[prefix], windows)
}

/// Whether the text starts with two separators on Windows (a share such as `\\server\share`).
priv fn __is_unc(chars: List<char>, windows: bool): bool {
    windows && chars.len() >= 2 && __is_sep(chars[0], true) && __is_sep(chars[1], true)
}

/// Whether the last of the names is a real name, not `..`: the one a following `..` cancels.
priv fn __ends_in_name(names: List<String>): bool {
    names.len() > 0 && names[names.len() - 1].as_str() != ".."
}

priv fn __slice(chars: List<char>, from: usize, to: usize): String {
    let mut out = String.new()
    let mut i = from
    while i < to {
        out.push(chars[i])
        i = i + 1
    }
    out
}

/// The character ranges of the components after `start`: empty pieces and `.` are skipped.
priv fn __spans(chars: List<char>, start: usize, windows: bool): List<(usize, usize)> {
    let mut out = List<(usize, usize)>.new()
    let n = chars.len()
    let mut i = start
    while i < n {
        while i < n && __is_sep(chars[i], windows) {
            i = i + 1
        }
        let from = i
        while i < n && !__is_sep(chars[i], windows) {
            i = i + 1
        }
        if i > from && !(i - from == 1 && chars[from] == '.') {
            out.push((from, i))
        }
    }
    out
}

/// The position of the dot that starts the extension of a file name, if it has one. A name that starts with a dot
/// (`.profile`) has no extension.
priv fn __dot(chars: List<char>): Option<usize> {
    let mut i = chars.len()
    while i > 1 {
        i = i - 1
        if chars[i] == '.' {
            return Some(i)
        }
    }
    None
}

priv fn __stem(name: str): String {
    let chars = name.to_char_list()
    match __dot(chars) {
        Some(d) => __slice(chars, 0, d),
        None => String.from(name),
    }
}

priv fn __extension(name: str): Option<String> {
    let chars = name.to_char_list()
    match __dot(chars) {
        Some(d) => Some(__slice(chars, d + 1, chars.len())),
        None => None,
    }
}

Path {
    /// A path that follows the rules of the system the program is compiled for.
    ///
    /// ```
    /// let p = Path.new("a/b")
    /// assert_eq(p.as_str(), "a/b")
    /// ```
    fn new(text: str): Path {
        Path { text: String.from(text), is_windows: os() == Os.Windows }
    }

    /// A path that follows Unix rules.
    ///
    /// ```
    /// let p = Path.unix("/home/user")
    /// assert_eq(p.as_str(), "/home/user")
    /// assert(p.is_absolute())
    /// ```
    fn unix(text: str): Path {
        Path { text: String.from(text), is_windows: false }
    }

    /// A path that follows Windows rules.
    ///
    /// ```
    /// let p = Path.windows("C:\\dir\\f.txt")
    /// assert_eq(p.separator(), '\\')
    /// assert(p.is_absolute())
    /// ```
    fn windows(text: str): Path {
        Path { text: String.from(text), is_windows: true }
    }

    /// The path as text.
    ///
    /// ```
    /// let p = Path.unix("docs/readme.md")
    /// assert_eq(p.as_str(), "docs/readme.md")
    /// ```
    fn as_str(self): str {
        self.text.as_str()
    }

    /// The separator the rules write: `/`, or `\` on Windows.
    ///
    /// ```
    /// assert_eq(Path.unix("a").separator(), '/')
    /// assert_eq(Path.windows("a").separator(), '\\')
    /// ```
    fn separator(self): char {
        if self.is_windows { '\\' } else { '/' }
    }

    /// Whether the path names a place without needing a working directory: it starts with `/` on Unix; on Windows it
    /// is a drive and a separator (`C:\`) or a share (`\\server`). `\temp` and `C:temp` are not absolute.
    ///
    /// ```
    /// assert(Path.unix("/etc").is_absolute())
    /// assert(!Path.unix("etc").is_absolute())
    /// assert(!Path.windows("\\temp").is_absolute())
    /// ```
    fn is_absolute(self): bool {
        let chars = self.text.to_char_list()
        if !self.is_windows {
            return __is_rooted(chars, 0, false)
        }
        let prefix = __prefix_len(chars, true)
        if prefix > 0 {
            return __is_rooted(chars, prefix, true)
        }
        __is_unc(chars, true)
    }

    /// The opposite of `is_absolute`.
    ///
    /// ```
    /// assert(Path.unix("src/main.bd").is_relative())
    /// assert(!Path.unix("/src").is_relative())
    /// ```
    fn is_relative(self): bool {
        !self.is_absolute()
    }

    /// The drive of a Windows path, such as `C:`.
    ///
    /// ```
    /// assert_eq(Path.windows("C:\\dir\\f.txt").drive(), Some(String.from("C:")))
    /// assert_eq(Path.unix("/a").drive(), None)
    /// ```
    fn drive(self): Option<String> {
        let chars = self.text.to_char_list()
        let prefix = __prefix_len(chars, self.is_windows)
        if prefix == 0 {
            return None
        }
        Some(__slice(chars, 0, prefix))
    }

    /// The names in the path, in order, without separators, empty pieces, or `.`. `..` is kept.
    ///
    /// ```
    /// let parts = Path.unix("/usr//lib/./x").components()
    /// assert_eq(parts.len(), 3)
    /// assert_eq(parts[2], String.from("x"))
    /// ```
    fn components(self): List<String> {
        let chars = self.text.to_char_list()
        let prefix = __prefix_len(chars, self.is_windows)
        let spans = __spans(chars, prefix, self.is_windows)
        let mut out = List<String>.new()
        let mut i: usize = 0
        while i < spans.len() {
            out.push(__slice(chars, spans[i].0, spans[i].1))
            i = i + 1
        }
        out
    }

    /// The path with `other` added. An absolute `other` (or, on Windows, one with a drive) replaces the path; on
    /// Windows a rooted `other` such as `\x` keeps the drive. Nothing is added for an empty `other`, and no
    /// separator is added after an empty path, one that ends with a separator, or a bare drive.
    ///
    /// ```
    /// let p = Path.unix("/usr").join("lib")
    /// assert_eq(p.as_str(), "/usr/lib")
    /// let q = Path.unix("a").join("/b")
    /// assert_eq(q.as_str(), "/b")
    /// ```
    fn join(self, other: str): Path {
        let w = self.is_windows
        let given = Path { text: String.from(other), is_windows: w }
        if given.is_absolute() {
            return given
        }
        let given_chars = other.to_char_list()
        if __prefix_len(given_chars, w) > 0 {
            return given
        }
        let chars = self.text.to_char_list()
        let prefix = __prefix_len(chars, w)
        if w && __is_rooted(given_chars, 0, true) {
            let mut out = __slice(chars, 0, prefix)
            out.push_str(other)
            return Path { text: out, is_windows: w }
        }
        let mut out = String.from(self.text.as_str())
        if other.len() == 0 || chars.len() == 0 {
            out.push_str(other)
            return Path { text: out, is_windows: w }
        }
        let last = chars[chars.len() - 1]
        if !__is_sep(last, w) && chars.len() != prefix {
            out.push(self.separator())
        }
        out.push_str(other)
        Path { text: out, is_windows: w }
    }

    /// The path without its last name: `a/b` is `a`, `/a` is `/`, and `a` is the empty path. A path with no names
    /// (`/`, `C:\`, `.`, or the empty path) has none.
    ///
    /// ```
    /// let p = Path.unix("a/b/c").parent().unwrap()
    /// assert_eq(p.as_str(), "a/b")
    /// ```
    fn parent(self): Option<Path> {
        let chars = self.text.to_char_list()
        let prefix = __prefix_len(chars, self.is_windows)
        let spans = __spans(chars, prefix, self.is_windows)
        if spans.len() == 0 {
            return None
        }
        let mut end = prefix
        if spans.len() > 1 {
            end = spans[spans.len() - 2].1
        } else if __is_rooted(chars, prefix, self.is_windows) {
            end = prefix + 1
        }
        Some(Path { text: __slice(chars, 0, end), is_windows: self.is_windows })
    }

    /// The last name, unless the path ends in `..` or has no names.
    ///
    /// ```
    /// assert_eq(Path.unix("a/b.txt").file_name(), Some(String.from("b.txt")))
    /// assert_eq(Path.unix("a/..").file_name(), None)
    /// ```
    fn file_name(self): Option<String> {
        let chars = self.text.to_char_list()
        let prefix = __prefix_len(chars, self.is_windows)
        let spans = __spans(chars, prefix, self.is_windows)
        if spans.len() == 0 {
            return None
        }
        let name = __slice(chars, spans[spans.len() - 1].0, spans[spans.len() - 1].1)
        if name.as_str() == ".." {
            return None
        }
        Some(name)
    }

    /// The last name without its extension: `archive.tar.gz` is `archive.tar`, `.profile` is `.profile`.
    ///
    /// ```
    /// assert_eq(Path.unix("archive.tar.gz").file_stem(), Some(String.from("archive.tar")))
    /// ```
    fn file_stem(self): Option<String> {
        match self.file_name() {
            Some(name) => Some(__stem(name.as_str())),
            None => None,
        }
    }

    /// The extension of the last name, without the dot: `archive.tar.gz` is `gz`. `.profile` and `Makefile` have
    /// none, and `file.` has the empty one.
    ///
    /// ```
    /// assert_eq(Path.unix("archive.tar.gz").extension(), Some(String.from("gz")))
    /// assert_eq(Path.unix("Makefile").extension(), None)
    /// ```
    fn extension(self): Option<String> {
        match self.file_name() {
            Some(name) => __extension(name.as_str()),
            None => None,
        }
    }

    /// The path with its last name replaced by `name`. A path with no names is joined with `name` instead.
    ///
    /// ```
    /// let p = Path.unix("src/old.bd").with_file_name("new.bd")
    /// assert_eq(p.as_str(), "src/new.bd")
    /// ```
    fn with_file_name(self, name: str): Path {
        let chars = self.text.to_char_list()
        let prefix = __prefix_len(chars, self.is_windows)
        let spans = __spans(chars, prefix, self.is_windows)
        if spans.len() == 0 {
            return self.join(name)
        }
        let mut out = __slice(chars, 0, spans[spans.len() - 1].0)
        out.push_str(name)
        Path { text: out, is_windows: self.is_windows }
    }

    /// The path with the extension of its last name replaced by `extension` (no leading dot), or removed when
    /// `extension` is empty. A path with no file name is unchanged.
    ///
    /// ```
    /// let p = Path.unix("notes.txt").with_extension("md")
    /// assert_eq(p.as_str(), "notes.md")
    /// ```
    fn with_extension(self, extension: str): Path {
        match self.file_name() {
            None => self.clone(),
            Some(name) => {
                let mut renamed = __stem(name.as_str())
                if extension.len() > 0 {
                    renamed.push('.')
                    renamed.push_str(extension)
                }
                self.with_file_name(renamed.as_str())
            }
        }
    }

    /// The path with `.` and empty pieces removed and each `name/..` pair cancelled, written with the rules'
    /// separator. A `..` at the start of a relative path stays; one at the root is dropped. An empty result is `.`.
    /// This reads the text only: it does not follow symbolic links, so it can change what a path names.
    ///
    /// ```
    /// let p = Path.unix("a/./b/../c//d").normalize()
    /// assert_eq(p.as_str(), "a/c/d")
    /// ```
    fn normalize(self): Path {
        let w = self.is_windows
        let chars = self.text.to_char_list()
        let prefix = __prefix_len(chars, w)
        let rooted = __is_rooted(chars, prefix, w)
        let unc = __is_unc(chars, w)
        let spans = __spans(chars, prefix, w)
        let mut stack = List<String>.new()
        let mut i: usize = 0
        while i < spans.len() {
            let from = spans[i].0
            let to = spans[i].1
            let is_parent = to - from == 2 && chars[from] == '.' && chars[from + 1] == '.'
            let can_pop = __ends_in_name(stack)
            if is_parent && can_pop {
                let dropped = stack.pop()
            } else if !is_parent || !rooted {
                stack.push(__slice(chars, from, to))
            }
            i = i + 1
        }
        let sep = self.separator()
        let mut out = __slice(chars, 0, prefix)
        if unc {
            out.push(sep)
        }
        if rooted {
            out.push(sep)
        }
        let mut j: usize = 0
        while j < stack.len() {
            if j > 0 {
                out.push(sep)
            }
            out.push_str(stack[j].as_str())
            j = j + 1
        }
        if out.len() == 0 {
            out.push('.')
        }
        Path { text: out, is_windows: w }
    }

    /// Whether something exists at the path. This asks the operating system, so it follows the host's rules (use a
    /// path made with `Path.new`), and it does not run at compile time.
    ///
    /// ```
    /// assert(Path.new(".").exists())
    /// assert(!Path.unix("burdin-doc-no-such-file").exists())
    /// ```
    fn exists(self): bool {
        let text = CString.from(self.text.as_str())
        if os() == Os.Windows {
            let status = unsafe { _access(text.as_ptr(), 0) }
            status == 0
        } else {
            let status = unsafe { access(text.as_ptr(), 0) }
            status == 0
        }
    }
}

Path: Display {
    fn fmt(self, mut f: Formatter) {
        f.write_str(self.text.as_str())
    }
}

Path: Debug {
    fn debug(self, mut f: Formatter) {
        f.write_str("Path(")
        self.text.as_str().debug(mut f)
        f.write_str(")")
    }
}
