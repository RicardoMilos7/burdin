// Paths (issue #194; spec/stdlib.md, "Paths").
//
// A `Path` is text plus the rules that read it: Unix rules (`/` is the only separator) or Windows rules (`/` and `\` both
// separate, and a drive such as `C:` is a prefix). There is one module for both: `Path.new` picks the rules of the system
// the program is compiled for, and `Path.unix` and `Path.windows` pick them explicitly, so either set can be used and
// tested on any system. Every operation is lexical: only `exists` looks at the file system, and nothing here resolves
// symbolic links or makes a path absolute.

use fmt.{Debug, Display, Formatter}
use target.{Os, os}
use std.CString

// Every operation below reads the path's bytes by offset. The separators, the drive colon, and the dots it looks for
// are ASCII, and no byte of a multi-byte UTF-8 character is ASCII, so a byte offset found next to one of them is always
// a character boundary and the text never needs to be decoded (issue #1020). The methods that return a piece of the
// path (`components`, `file_name`, `file_stem`, `extension`, `drive`, `parent`) still return owned values, as
// `spec/stdlib.md` declares them, but each one allocates only its result: the pieces are found as views first.

priv const SLASH: u8 = 47
priv const BACKSLASH: u8 = 92
priv const COLON: u8 = 58
priv const DOT: u8 = 46

/// A file system path and the rules it follows.
///
/// ```
/// let p = Path.unix("/home/user/notes.txt")
/// assert_eq(p.file_name(), Option.Some(String.from("notes.txt")))
/// let parent = p.parent().unwrap()
/// assert_eq(parent.as_str(), "/home/user")
/// ```
struct Path: Clone, Eq {
    text: String
    is_windows: bool
}

// `access` is the POSIX name; the Windows C runtime spells it `_access`. Only the one for the target is called.
extern "C" {
    priv fn access(path: CPtr<CChar>, mode: i32): i32
    priv fn _access(path: CPtr<CChar>, mode: i32): i32
}

priv fn is_sep(b: u8, windows: bool): bool {
    b == SLASH || (windows && b == BACKSLASH)
}

/// The length of a Windows drive prefix (`C:`), or zero.
priv fn prefix_len(text: str, windows: bool): usize {
    let bytes = text.as_bytes()
    if windows && bytes.len() >= 2 && bytes[1] == COLON {
        let c = bytes[0]
        if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) {
            return 2
        }
    }
    0
}

/// Whether a separator follows the prefix.
priv fn is_rooted(text: str, prefix: usize, windows: bool): bool {
    text.len() > prefix && is_sep(text.as_bytes()[prefix], windows)
}

/// Whether the text starts with two separators on Windows (a share such as `\\server\share`).
priv fn is_unc(text: str, windows: bool): bool {
    let bytes = text.as_bytes()
    windows && bytes.len() >= 2 && is_sep(bytes[0], true) && is_sep(bytes[1], true)
}

/// Whether `text` names a place without a working directory (`Path.is_absolute`).
priv fn is_absolute_text(text: str, windows: bool): bool {
    if !windows {
        return is_rooted(text, 0, false)
    }
    let prefix = prefix_len(text, true)
    if prefix > 0 {
        return is_rooted(text, prefix, true)
    }
    is_unc(text, true)
}

/// Whether the bytes `from..to` are a component: not empty and not `.`.
priv fn is_component(bytes: [u8], from: usize, to: usize): bool {
    to > from && !(to - from == 1 && bytes[from] == DOT)
}

/// Whether the bytes `from..to` are `..`.
priv fn is_parent_dir(bytes: [u8], from: usize, to: usize): bool {
    to - from == 2 && bytes[from] == DOT && bytes[from + 1] == DOT
}

/// The byte range of the first component at or after `start`: empty pieces and `.` are skipped.
priv fn next_span(text: str, start: usize, windows: bool): Option<(usize, usize)> {
    let bytes = text.as_bytes()
    let n = bytes.len()
    let mut i = start
    while i < n {
        while i < n && is_sep(bytes[i], windows) {
            i = i + 1
        }
        let from = i
        while i < n && !is_sep(bytes[i], windows) {
            i = i + 1
        }
        if is_component(bytes, from, i) {
            return Option.Some((from, i))
        }
    }
    Option.None
}

/// The byte range of the last component that lies inside `start..end`, read from the end: the same pieces
/// `next_span` finds from the front.
priv fn last_span(text: str, start: usize, end: usize, windows: bool): Option<(usize, usize)> {
    let bytes = text.as_bytes()
    let mut i = end
    while i > start {
        while i > start && is_sep(bytes[i - 1], windows) {
            i = i - 1
        }
        let to = i
        while i > start && !is_sep(bytes[i - 1], windows) {
            i = i - 1
        }
        if is_component(bytes, i, to) {
            return Option.Some((i, to))
        }
    }
    Option.None
}

/// The last name of the path, unless it is `..` or there is none: a view of `text`.
priv fn file_name_of(text: str, windows: bool): Option<str> {
    let prefix = prefix_len(text, windows)
    match last_span(text, prefix, text.len(), windows) {
        Option.Some((from, to)) if !is_parent_dir(text.as_bytes(), from, to) => Option.Some(text[from..to]),
        _ => Option.None,
    }
}

/// The position of the dot that starts the extension of a file name, if it has one. A name that starts with a dot
/// (`.profile`) has no extension.
priv fn dot(name: str): Option<usize> {
    let bytes = name.as_bytes()
    let mut i = bytes.len()
    while i > 1 {
        i = i - 1
        if bytes[i] == DOT {
            return Option.Some(i)
        }
    }
    Option.None
}

/// The file name without its extension: a view of `name`.
priv fn stem(name: str): str {
    match dot(name) {
        Option.Some(d) => name[0..d],
        Option.None => name,
    }
}

Path {
    /// A path that follows the rules of the system the program is compiled for.
    ///
    /// ```
    /// let p = Path.new("a/b")
    /// assert_eq(p.as_str(), "a/b")
    /// ```
    fn new(text: str): Path {
        Path { text: String.from(text), is_windows: os() == Os.Windows }
    }

    /// A path that follows Unix rules.
    ///
    /// ```
    /// let p = Path.unix("/home/user")
    /// assert_eq(p.as_str(), "/home/user")
    /// assert(p.is_absolute())
    /// ```
    fn unix(text: str): Path {
        Path { text: String.from(text), is_windows: false }
    }

    /// A path that follows Windows rules.
    ///
    /// ```
    /// let p = Path.windows("C:\\dir\\f.txt")
    /// assert_eq(p.separator(), '\\')
    /// assert(p.is_absolute())
    /// ```
    fn windows(text: str): Path {
        Path { text: String.from(text), is_windows: true }
    }

    /// The path as text.
    ///
    /// ```
    /// let p = Path.unix("docs/readme.md")
    /// assert_eq(p.as_str(), "docs/readme.md")
    /// ```
    fn as_str(self): str {
        self.text.as_str()
    }

    /// The separator the rules write: `/`, or `\` on Windows.
    ///
    /// ```
    /// assert_eq(Path.unix("a").separator(), '/')
    /// assert_eq(Path.windows("a").separator(), '\\')
    /// ```
    fn separator(self): char {
        if self.is_windows { '\\' } else { '/' }
    }

    /// Whether the path names a place without needing a working directory: it starts with `/` on Unix; on Windows it
    /// is a drive and a separator (`C:\`) or a share (`\\server`). `\temp` and `C:temp` are not absolute.
    ///
    /// ```
    /// assert(Path.unix("/etc").is_absolute())
    /// assert(!Path.unix("etc").is_absolute())
    /// assert(!Path.windows("\\temp").is_absolute())
    /// ```
    fn is_absolute(self): bool {
        is_absolute_text(self.text.as_str(), self.is_windows)
    }

    /// The opposite of `is_absolute`.
    ///
    /// ```
    /// assert(Path.unix("src/main.bd").is_relative())
    /// assert(!Path.unix("/src").is_relative())
    /// ```
    fn is_relative(self): bool {
        !self.is_absolute()
    }

    /// The drive of a Windows path, such as `C:`.
    ///
    /// ```
    /// assert_eq(Path.windows("C:\\dir\\f.txt").drive(), Option.Some(String.from("C:")))
    /// assert_eq(Path.unix("/a").drive(), Option.None)
    /// ```
    fn drive(self): Option<String> {
        let text = self.text.as_str()
        let prefix = prefix_len(text, self.is_windows)
        if prefix == 0 {
            return Option.None
        }
        Option.Some(String.from(text[0..prefix]))
    }

    /// The names in the path, in order, without separators, empty pieces, or `.`. `..` is kept.
    ///
    /// ```
    /// let parts = Path.unix("/usr//lib/./x").components()
    /// assert_eq(parts.len(), 3)
    /// assert_eq(parts[2], String.from("x"))
    /// ```
    fn components(self): List<String> {
        let w = self.is_windows
        let text = self.text.as_str()
        let prefix = prefix_len(text, w)
        // Count first so the list is allocated once, at its final size.
        let mut count: usize = 0
        let mut at = prefix
        while let Option.Some((_, to)) = next_span(text, at, w) {
            count = count + 1
            at = to
        }
        let mut out = List<String>.with_capacity(count)
        at = prefix
        while let Option.Some((from, to)) = next_span(text, at, w) {
            out.push(String.from(text[from..to]))
            at = to
        }
        out
    }

    /// The path with `other` added. An absolute `other` (or, on Windows, one with a drive) replaces the path; on
    /// Windows a rooted `other` such as `\x` keeps the drive. Nothing is added for an empty `other`, and no
    /// separator is added after an empty path, one that ends with a separator, or a bare drive.
    ///
    /// ```
    /// let p = Path.unix("/usr").join("lib")
    /// assert_eq(p.as_str(), "/usr/lib")
    /// let q = Path.unix("a").join("/b")
    /// assert_eq(q.as_str(), "/b")
    /// ```
    fn join(self, other: str): Path {
        let w = self.is_windows
        // An absolute `other`, or on Windows one with a drive, replaces the path.
        if prefix_len(other, w) > 0 || is_absolute_text(other, w) {
            return Path { text: String.from(other), is_windows: w }
        }
        let text = self.text.as_str()
        let prefix = prefix_len(text, w)
        if w && is_rooted(other, 0, true) {
            let mut out = String.with_capacity(prefix + other.len())
            out.push_str(text[0..prefix])
            out.push_str(other)
            return Path { text: out, is_windows: w }
        }
        let n = text.len()
        let needs_sep = other.len() > 0 && n > 0 && n != prefix && !is_sep(text.as_bytes()[n - 1], w)
        let mut out = String.with_capacity(n + other.len() + if needs_sep { 1 } else { 0 })
        out.push_str(text)
        if needs_sep {
            out.push(self.separator())
        }
        out.push_str(other)
        Path { text: out, is_windows: w }
    }

    /// The path without its last name: `a/b` is `a`, `/a` is `/`, and `a` is the empty path. A path with no names
    /// (`/`, `C:\`, `.`, or the empty path) has none.
    ///
    /// ```
    /// let p = Path.unix("a/b/c").parent().unwrap()
    /// assert_eq(p.as_str(), "a/b")
    /// ```
    fn parent(self): Option<Path> {
        let w = self.is_windows
        let text = self.text.as_str()
        let prefix = prefix_len(text, w)
        let last = match last_span(text, prefix, text.len(), w) {
            Option.Some((from, _)) => from,
            Option.None => return Option.None,
        }
        let end = match last_span(text, prefix, last, w) {
            Option.Some((_, to)) => to,
            Option.None if is_rooted(text, prefix, w) => prefix + 1,
            Option.None => prefix,
        }
        Option.Some(Path { text: String.from(text[0..end]), is_windows: w })
    }

    /// The last name, unless the path ends in `..` or has no names.
    ///
    /// ```
    /// assert_eq(Path.unix("a/b.txt").file_name(), Option.Some(String.from("b.txt")))
    /// assert_eq(Path.unix("a/..").file_name(), Option.None)
    /// ```
    fn file_name(self): Option<String> {
        match file_name_of(self.text.as_str(), self.is_windows) {
            Option.Some(name) => Option.Some(String.from(name)),
            Option.None => Option.None,
        }
    }

    /// The last name without its extension: `archive.tar.gz` is `archive.tar`, `.profile` is `.profile`.
    ///
    /// ```
    /// assert_eq(Path.unix("archive.tar.gz").file_stem(), Option.Some(String.from("archive.tar")))
    /// ```
    fn file_stem(self): Option<String> {
        match file_name_of(self.text.as_str(), self.is_windows) {
            Option.Some(name) => Option.Some(String.from(stem(name))),
            Option.None => Option.None,
        }
    }

    /// The extension of the last name, without the dot: `archive.tar.gz` is `gz`. `.profile` and `Makefile` have
    /// none, and `file.` has the empty one.
    ///
    /// ```
    /// assert_eq(Path.unix("archive.tar.gz").extension(), Option.Some(String.from("gz")))
    /// assert_eq(Path.unix("Makefile").extension(), Option.None)
    /// ```
    fn extension(self): Option<String> {
        let name = match file_name_of(self.text.as_str(), self.is_windows) {
            Option.Some(name) => name,
            Option.None => return Option.None,
        }
        match dot(name) {
            Option.Some(d) => Option.Some(String.from(name[d + 1..name.len()])),
            Option.None => Option.None,
        }
    }

    /// The path with its last name replaced by `name`. A path with no names is joined with `name` instead.
    ///
    /// ```
    /// let p = Path.unix("src/old.bd").with_file_name("new.bd")
    /// assert_eq(p.as_str(), "src/new.bd")
    /// ```
    fn with_file_name(self, name: str): Path {
        let w = self.is_windows
        let text = self.text.as_str()
        let from = match last_span(text, prefix_len(text, w), text.len(), w) {
            Option.Some((from, _)) => from,
            Option.None => return self.join(name),
        }
        let mut out = String.with_capacity(from + name.len())
        out.push_str(text[0..from])
        out.push_str(name)
        Path { text: out, is_windows: w }
    }

    /// The path with the extension of its last name replaced by `extension` (no leading dot), or removed when
    /// `extension` is empty. A path with no file name is unchanged.
    ///
    /// ```
    /// let p = Path.unix("notes.txt").with_extension("md")
    /// assert_eq(p.as_str(), "notes.md")
    /// ```
    fn with_extension(self, extension: str): Path {
        let w = self.is_windows
        let text = self.text.as_str()
        // The last name, as `file_name` finds it; with none the path is unchanged.
        let (from, to) = match last_span(text, prefix_len(text, w), text.len(), w) {
            Option.Some((from, to)) if !is_parent_dir(text.as_bytes(), from, to) => (from, to),
            _ => return self.clone(),
        }
        let kept = from + stem(text[from..to]).len()
        let added = if extension.len() > 0 { extension.len() + 1 } else { 0 }
        let mut out = String.with_capacity(kept + added)
        out.push_str(text[0..kept])
        if extension.len() > 0 {
            out.push('.')
            out.push_str(extension)
        }
        Path { text: out, is_windows: w }
    }

    /// The path with `.` and empty pieces removed and each `name/..` pair cancelled, written with the rules'
    /// separator. A `..` at the start of a relative path stays; one at the root is dropped. An empty result is `.`.
    /// This reads the text only: it does not follow symbolic links, so it can change what a path names.
    ///
    /// ```
    /// let p = Path.unix("a/./b/../c//d").normalize()
    /// assert_eq(p.as_str(), "a/c/d")
    /// ```
    fn normalize(self): Path {
        let w = self.is_windows
        let text = self.text.as_str()
        let bytes = text.as_bytes()
        let prefix = prefix_len(text, w)
        let rooted = is_rooted(text, prefix, w)
        let unc = is_unc(text, w)
        // The kept names, as byte ranges of the text: nothing is copied until the result is written. The names are
        // counted first so the list is allocated once.
        let mut count: usize = 0
        let mut at = prefix
        while let Option.Some((_, to)) = next_span(text, at, w) {
            count = count + 1
            at = to
        }
        let mut stack = List<(usize, usize)>.with_capacity(count)
        at = prefix
        while let Option.Some((from, to)) = next_span(text, at, w) {
            let is_parent = is_parent_dir(bytes, from, to)
            let top = stack.len()
            let can_pop = top > 0 && !is_parent_dir(bytes, stack[top - 1].0, stack[top - 1].1)
            if is_parent && can_pop {
                let dropped = stack.pop()
            } else if !is_parent || !rooted {
                stack.push((from, to))
            }
            at = to
        }
        let sep = self.separator()
        // The result is never longer than the text plus the `.` of an empty result.
        let mut out = String.with_capacity(text.len() + 1)
        out.push_str(text[0..prefix])
        if unc {
            out.push(sep)
        }
        if rooted {
            out.push(sep)
        }
        let mut j: usize = 0
        while j < stack.len() {
            if j > 0 {
                out.push(sep)
            }
            out.push_str(text[stack[j].0..stack[j].1])
            j = j + 1
        }
        if out.len() == 0 {
            out.push('.')
        }
        Path { text: out, is_windows: w }
    }

    /// Whether something exists at the path. This asks the operating system, so it follows the host's rules (use a
    /// path made with `Path.new`), and it does not run at compile time.
    ///
    /// ```
    /// assert(Path.new(".").exists())
    /// assert(!Path.unix("burdin-doc-no-such-file").exists())
    /// ```
    fn exists(self): bool {
        let text = CString.from(self.text.as_str())
        if os() == Os.Windows {
            let status = unsafe { _access(text.as_ptr(), 0) }
            status == 0
        } else {
            let status = unsafe { access(text.as_ptr(), 0) }
            status == 0
        }
    }
}

Path: Display {
    fn fmt(self, mut f: Formatter) {
        f.write_str(self.text.as_str())
    }
}

Path: Debug {
    fn debug(self, mut f: Formatter) {
        f.write_str("Path(")
        self.text.as_str().debug(mut f)
        f.write_str(")")
    }
}
