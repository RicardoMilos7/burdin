/// The number to an integer power.
fn f64.powi(self, exp: i32): f64

/// The number to a float power.
fn f64.powf(self, exp: f64): f64

/// `e` to the power of the number.
fn f64.exp(self): f64

/// 2 to the power of the number.
fn f64.exp2(self): f64

/// The natural logarithm.
fn f64.ln(self): f64

/// The base-2 logarithm.
fn f64.log2(self): f64

/// The base-10 logarithm.
fn f64.log10(self): f64

/// The largest integer not above the number.
fn f64.floor(self): f64

/// The smallest integer not below the number.
fn f64.ceil(self): f64

/// The nearest integer, halves away from zero.
fn f64.round(self): f64

/// The nearest integer, halves to even.
fn f64.round_ties_even(self): f64

/// The integer part.
fn f64.trunc(self): f64

/// The sine (radians).
fn f64.sin(self): f64

/// The cosine (radians).
fn f64.cos(self): f64

/// The tangent (radians).
fn f64.tan(self): f64

