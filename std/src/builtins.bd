/// A 32-bit IEEE 754 float.
struct f32 {}

/// The float with these bits (`u32` for `f32`).
fn f32.from_bits(bits: u32): f32

/// The shortest text that reads back as the same number.
fn f32.to_string(self): String

/// The float's bits (`u32` for `f32`).
fn f32.to_bits(self): u32

/// The absolute value.
fn f32.abs(self): f32

/// The square root.
fn f32.sqrt(self): f32

/// The cube root.
fn f32.cbrt(self): f32

/// The number to an integer power.
fn f32.powi(self, exp: i32): f32

/// The number to a float power.
fn f32.powf(self, exp: f32): f32

/// `e` to the power of the number.
fn f32.exp(self): f32

/// 2 to the power of the number.
fn f32.exp2(self): f32

/// The natural logarithm.
fn f32.ln(self): f32

/// The base-2 logarithm.
fn f32.log2(self): f32

/// The base-10 logarithm.
fn f32.log10(self): f32

/// The largest integer not above the number.
fn f32.floor(self): f32

/// The smallest integer not below the number.
fn f32.ceil(self): f32

/// The nearest integer, halves away from zero.
fn f32.round(self): f32

/// The nearest integer, halves to even.
fn f32.round_ties_even(self): f32

/// The integer part.
fn f32.trunc(self): f32

/// The sine (radians).
fn f32.sin(self): f32

/// The cosine (radians).
fn f32.cos(self): f32

/// The tangent (radians).
fn f32.tan(self): f32

/// The arcsine, in radians.
fn f32.asin(self): f32

/// The arccosine, in radians.
fn f32.acos(self): f32

/// The arctangent, in radians.
fn f32.atan(self): f32

/// The angle of the point `(other, self)`, in radians.
fn f32.atan2(self, other: f32): f32

/// The hyperbolic sine.
fn f32.sinh(self): f32

/// The hyperbolic cosine.
fn f32.cosh(self): f32

/// The hyperbolic tangent.
fn f32.tanh(self): f32

/// The length of the hypotenuse.
fn f32.hypot(self, other: f32): f32

/// `self * a + b` with one rounding.
fn f32.mul_add(self, a: f32, b: f32): f32

/// The number with the sign of `sign`.
fn f32.copysign(self, sign: f32): f32

