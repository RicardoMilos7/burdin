/// The sum, wrapping around on overflow.
fn i32.wrapping_add(self, other: i32): i32

/// The difference, wrapping around on overflow.
fn i32.wrapping_sub(self, other: i32): i32

/// The product, wrapping around on overflow.
fn i32.wrapping_mul(self, other: i32): i32

/// The sum, or `None` on overflow.
fn i32.checked_add(self, other: i32): Option<i32>

/// The difference, or `None` on overflow.
fn i32.checked_sub(self, other: i32): Option<i32>

/// The product, or `None` on overflow.
fn i32.checked_mul(self, other: i32): Option<i32>

/// The smaller of the two.
fn i32.min(self, other: i32): i32

/// The larger of the two.
fn i32.max(self, other: i32): i32

/// The absolute value.
fn i32.abs(self): i32

