//! The compiler's built-in functions, types, and methods, written as declarations without bodies
//! (`spec/stdlib.md`). The compiler provides them; this file is not compiled. The tools read it, so hover,
//! completion, signature help, and go to definition find the signature and the documentation of a built-in here.

/// Writes the text to standard output; `{...}` placeholders take the arguments.
fn print(fmt: str, ...)

/// Writes the text and a line feed to standard output.
fn println(fmt: str, ...)

/// Writes the text to standard error.
fn eprint(fmt: str, ...)

/// Writes the text and a line feed to standard error.
fn eprintln(fmt: str, ...)

/// The text, with the placeholders filled in, as a new `String`.
fn format(fmt: str, ...): String

/// Stops the program with a message.
fn panic(message: str): !

/// The owning, growable UTF-8 text.
struct String {}

/// An empty string.
fn String.new(): String

/// A copy of the text.
fn String.from(s: str): String

/// An empty string with room for `capacity` bytes.
fn String.with_capacity(capacity: usize): String

/// Appends the text.
fn String.push_str(mut self, s: str)

/// Appends one character.
fn String.push(mut self, c: char)

/// The length in bytes, not characters.
fn String.len(self): usize

/// Whether the text starts with `prefix`.
fn String.starts_with(self, prefix: str): bool

/// The byte offset of the first `c`.
fn String.find(self, c: char): Option<usize>

/// The byte offset of the first `needle`.
fn String.find_str(self, needle: str): Option<usize>

/// A `str` view of the text.
fn String.as_str(self): str

/// The Unicode scalar values, in order.
fn String.chars(self): Chars

/// A view of the UTF-8 bytes; copies nothing.
fn String.as_bytes(self): [u8]

/// The buffer's capacity in bytes.
fn String.capacity(self): usize

/// Room for `additional` more bytes.
fn String.reserve(mut self, additional: usize)

/// Shrinks the buffer to the length.
fn String.shrink_to_fit(mut self)

/// Inserts the text at a character boundary.
fn String.insert_str(mut self, byte_idx: usize, s: str)

/// Replaces the bytes `from..to` with the text.
fn String.replace_range(mut self, from: usize, to: usize, s: str)

/// A deep copy of the buffer.
fn String.clone(self): String

/// A read-only view of UTF-8 text; a string literal has this type.
struct str {}

/// The length in bytes, not characters.
fn str.len(self): usize

/// Whether the text starts with `prefix`.
fn str.starts_with(self, prefix: str): bool

/// The byte offset of the first `c`.
fn str.find(self, c: char): Option<usize>

/// The byte offset of the first `needle`.
fn str.find_str(self, needle: str): Option<usize>

/// A `str` view of the text.
fn str.as_str(self): str

/// The Unicode scalar values, in order.
fn str.chars(self): Chars

/// A view of the UTF-8 bytes; copies nothing.
fn str.as_bytes(self): [u8]

/// A `String` copy of the text.
fn str.to_string(self): String

/// A signed 8-bit integer.
struct i8 {}

/// The base-10 number in the text (`Self.parse(s)`).
fn i8.parse(s: str): Result<i8, ParseIntError>

/// The number in base 10.
fn i8.to_string(self): String

/// The sum, wrapping around on overflow.
fn i8.wrapping_add(self, other: i8): i8

/// The difference, wrapping around on overflow.
fn i8.wrapping_sub(self, other: i8): i8

/// The product, wrapping around on overflow.
fn i8.wrapping_mul(self, other: i8): i8

/// The sum, or `None` on overflow.
fn i8.checked_add(self, other: i8): Option<i8>

/// The difference, or `None` on overflow.
fn i8.checked_sub(self, other: i8): Option<i8>

/// The product, or `None` on overflow.
fn i8.checked_mul(self, other: i8): Option<i8>

/// The smaller of the two.
fn i8.min(self, other: i8): i8

/// The larger of the two.
fn i8.max(self, other: i8): i8

/// The absolute value.
fn i8.abs(self): i8

/// A signed 16-bit integer.
struct i16 {}

/// The base-10 number in the text (`Self.parse(s)`).
fn i16.parse(s: str): Result<i16, ParseIntError>

/// The number in base 10.
fn i16.to_string(self): String

/// The sum, wrapping around on overflow.
fn i16.wrapping_add(self, other: i16): i16

/// The difference, wrapping around on overflow.
fn i16.wrapping_sub(self, other: i16): i16

/// The product, wrapping around on overflow.
fn i16.wrapping_mul(self, other: i16): i16

/// The sum, or `None` on overflow.
fn i16.checked_add(self, other: i16): Option<i16>

/// The difference, or `None` on overflow.
fn i16.checked_sub(self, other: i16): Option<i16>

/// The product, or `None` on overflow.
fn i16.checked_mul(self, other: i16): Option<i16>

/// The smaller of the two.
fn i16.min(self, other: i16): i16

/// The larger of the two.
fn i16.max(self, other: i16): i16

/// The absolute value.
fn i16.abs(self): i16

