fn f64.copysign(self, sign: f64): f64

/// `true` or `false`.
struct bool {}

/// `true` or `false`.
fn bool.to_string(self): String

/// A Unicode scalar value.
struct char {}

/// The character as a one-character `String`.
fn char.to_string(self): String

/// A hash map from keys to values.
struct Map<K, V> {}

/// An empty map.
fn Map<K, V>.new(): Map<K, V>

/// An empty map with room for `n` entries.
fn Map<K, V>.with_capacity(n: usize): Map<K, V>

/// An empty map that stores the allocator.
fn Map<K, V>.new_in(alloc: A): Map<K, V, A>

/// Inserts the entry, replacing an existing key's value.
fn Map<K, V>.insert(mut self, key: K, value: V)

/// The value of the key.
fn Map<K, V>.get(self, key: K): Option<&V>

/// The value of the key, to change.
fn Map<K, V>.get_mut(mut self, key: K): Option<&mut V>

/// The value of the key, or `fallback`.
fn Map<K, V>.get_or(self, key: K, fallback: V): &V

/// The value of the key, inserted when missing.
fn Map<K, V>.get_or_insert(mut self, key: K, value: V): &mut V

/// Removes the key and returns its value.
fn Map<K, V>.remove(mut self, key: K): Option<V>

/// Removes the key and returns the entry.
fn Map<K, V>.remove_entry(mut self, key: K): Option<(K, V)>

/// Whether the key is in the map.
fn Map<K, V>.contains_key(self, key: K): bool

/// The key's entry, to insert or update in one probe.
fn Map<K, V>.entry(mut self, key: K): MapEntry<K, V>

/// Keeps the entries `keep` accepts.
fn Map<K, V>.retain(mut self, keep: FnMut(&K, &V): bool)

/// Room for `additional` more entries.
fn Map<K, V>.reserve(mut self, additional: usize)

/// Shrinks the table to the entries.
fn Map<K, V>.shrink_to_fit(mut self)

/// Removes every entry.
fn Map<K, V>.clear(mut self)

/// The number of entries.
fn Map<K, V>.len(self): usize

/// Iterates over the entries as `(&K, &V)`.
fn Map<K, V>.iter(self): MapIter<K, V>

/// Iterates over the entries, to change the values.
fn Map<K, V>.iter_mut(mut self): MapIterMut<K, V>

/// Consumes the map, yielding `(K, V)`.
fn Map<K, V>.into_iter(own self): MapIntoIter<K, V>

// `Option` and `Result` are ordinary enums of `std/src/std.bd`, and their methods are written in Burdin in
// `std/src/option.bd`. `context` is the one method of them the compiler provides (`spec/errors.md`, ERR6).

/// Prefixes a context message to the error.
fn Result<T, E>.context(own self, message: str): Result<T, AnyError>

/// One value in its own allocation.
struct Heap<T> {}

/// Moves the value into a new allocation.
fn Heap<T>.new(value: T): Heap<T>

/// `new`, with an allocator.
fn Heap<T>.new_in(alloc: A, value: T): Heap<T, A>

/// The number of values.
fn [T].len(self): usize

/// Iterates over the values: `T` if it is `Copy`, else `&T`.
fn [T].iter(self): [T]

/// The value at `i`, or `None` past the end; a range gives a view.
fn [T].get(self, i: usize): Option<&T>

/// The last value.
fn [T].last(self): Option<&T>

/// A `List` of clones of the values.
fn [T].to_list(self): List<T>

/// Swaps two values; panics when an index is out of bounds.
fn [T].swap(mut self, a: usize, b: usize)

/// Sets every value to a clone of `value`.
fn [T].fill(mut self, value: T)

/// Copies `other` in; panics on a length mismatch.
fn [T].copy_from_slice(mut self, other: [T])

/// Clones `other` in; panics on a length mismatch.
fn [T].clone_from_slice(mut self, other: [T])

/// Views of `n` values at a time; the last may be shorter.
fn [T].chunks(self, n: usize): Chunks<T>

/// Views of exactly `n` values; the rest is left out.
fn [T].chunks_exact(self, n: usize): ChunksExact<T>

/// Every run of `n` consecutive values, as views.
fn [T].windows(self, n: usize): Windows<T>

/// Iterates over the values, to change them.
fn [T; N].iter_mut(mut self): IterMut<T>
