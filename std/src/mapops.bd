// The entry operations of `Map<K, V>` (issue #482; spec/stdlib.md, "Map entry operations"): `entry(key)` probes
// once for a key and returns an entry that `or_insert` or `or_insert_with` fills in.
//
//     let count = counts.entry(word).or_insert(0)
//     *count = *count + 1
//
// The compiler provides `get_mut`, `get_or_insert`, `entry`, and the entry's `or_insert` and `or_insert_with`;
// the rest is written here on top of them.

/// The value for `key`, storing the result of `make` first when there is none. The entry probes the key once and
/// `make` runs only when the key is absent, so it may be expensive. The returned reference keeps the map
/// exclusively borrowed until its last use.
fn Map<K, V>.get_or_insert_with<F: FnOnce(): V>(mut self, own key: K, own make: F): &mut V where K: Eq {
    self.entry(key).or_insert_with(make)
}

/// Runs `change` on the value for `key` and returns `true`, or returns `false` without calling it when the key is
/// absent.
fn Map<K, V>.update<F: FnOnce(&mut V)>(mut self, key: K, own change: F): bool where K: Eq {
    match self.get_mut(key) {
        Some(value) => {
            change(value)
            true
        }
        None => false,
    }
}

/// Stores `value` for `key` when the key is absent, and otherwise runs `change` on the value already there (and
/// drops `value`): `counts.upsert(word, 1, |n| *n = *n + 1)`.
fn Map<K, V>.upsert<F: FnOnce(&mut V)>(mut self, own key: K, own value: V, own change: F) where K: Eq {
    if self.contains_key(key) {
        match self.get_mut(key) {
            Some(existing) => {
                change(existing)
            }
            None => {}
        }
        return
    }
    self.insert(key, value)
}
