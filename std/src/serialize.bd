// Serialization (spec/serialization.md, SER1-SER16).
//
// The framework core: the data model (`Serializer`/`Deserializer`), the two user-facing interfaces (`Serialize` and
// `Deserialize`), the error type with its path, the helper functions an impl block or the compiler-generated derive
// calls, and a tiny human-readable test format. The format packages (json, toml, csv, yaml, xml) implement only the
// format side.
//
// The shape vocabulary is: unit, bool, the sized integers, float, char, string, bytes, sequence, map with `String`
// keys, struct, and externally tagged enum variant. A format may reject a shape it cannot represent.

use alloc.Allocator
use fmt.{Display, Formatter}
use std.Error

/// The format side of writing: a writer implements this interface. Each method borrows the writer exclusively for
/// the call, so a struct or sequence is written with a `begin` call, one call per value, and an `end` call.
interface Serializer {
    /// Writes the unit value.
    fn serialize_unit(mut self): Result<(), DeError>

    /// Writes a `bool`.
    fn serialize_bool(mut self, value: bool): Result<(), DeError>

    /// Writes an `i8`.
    fn serialize_i8(mut self, value: i8): Result<(), DeError>
    /// Writes an `i16`.
    fn serialize_i16(mut self, value: i16): Result<(), DeError>
    /// Writes an `i32`.
    fn serialize_i32(mut self, value: i32): Result<(), DeError>
    /// Writes an `i64`.
    fn serialize_i64(mut self, value: i64): Result<(), DeError>
    /// Writes an `isize`.
    fn serialize_isize(mut self, value: isize): Result<(), DeError>

    /// Writes a `u8`.
    fn serialize_u8(mut self, value: u8): Result<(), DeError>
    /// Writes a `u16`.
    fn serialize_u16(mut self, value: u16): Result<(), DeError>
    /// Writes a `u32`.
    fn serialize_u32(mut self, value: u32): Result<(), DeError>
    /// Writes a `u64`.
    fn serialize_u64(mut self, value: u64): Result<(), DeError>
    /// Writes a `usize`.
    fn serialize_usize(mut self, value: usize): Result<(), DeError>

    /// Writes an `f32`.
    fn serialize_f32(mut self, value: f32): Result<(), DeError>
    /// Writes an `f64`.
    fn serialize_f64(mut self, value: f64): Result<(), DeError>

    /// Writes a `char`.
    fn serialize_char(mut self, value: char): Result<(), DeError>
    /// Writes a `str` (or a `String`, through the one implicit conversion).
    fn serialize_str(mut self, value: str): Result<(), DeError>
    /// Writes a run of bytes.
    fn serialize_bytes(mut self, value: [u8]): Result<(), DeError>

    /// Starts a sequence of exactly `len` values.
    fn begin_seq(mut self, len: usize): Result<(), DeError>
    /// Ends the sequence.
    fn end_seq(mut self): Result<(), DeError>

    /// Starts a map of exactly `len` entries with `String` keys.
    fn begin_map(mut self, len: usize): Result<(), DeError>
    /// Writes the key of the next map entry. The entry's value is the next value written.
    fn map_key(mut self, key: str): Result<(), DeError>
    /// Ends the map.
    fn end_map(mut self): Result<(), DeError>

    /// Starts a struct named `name` with exactly `len` fields.
    fn begin_struct(mut self, name: str, len: usize): Result<(), DeError>
    /// Writes the name of the next field. The field's value is the next value written.
    fn struct_field(mut self, name: str): Result<(), DeError>
    /// Ends the struct.
    fn end_struct(mut self): Result<(), DeError>

    /// Starts an enum variant: the enum's name, the variant's name, its declaration index, and its payload arity.
    fn begin_variant(
        mut self,
        type_name: str,
        variant: str,
        index: usize,
        arity: usize,
    ): Result<(), DeError>
    /// Ends the variant's `arity` payload values.
    fn end_variant(mut self, arity: usize): Result<(), DeError>
}

/// The format side of reading: a reader implements this interface. The data type drives the parse, asking for the
/// next value or the next structural token.
interface Deserializer {
    /// Reads the unit value.
    fn deserialize_unit(mut self): Result<(), DeError>

    /// Reads a `bool`.
    fn deserialize_bool(mut self): Result<bool, DeError>

    /// Reads an `i8`.
    fn deserialize_i8(mut self): Result<i8, DeError>
    /// Reads an `i16`.
    fn deserialize_i16(mut self): Result<i16, DeError>
    /// Reads an `i32`.
    fn deserialize_i32(mut self): Result<i32, DeError>
    /// Reads an `i64`.
    fn deserialize_i64(mut self): Result<i64, DeError>
    /// Reads an `isize`.
    fn deserialize_isize(mut self): Result<isize, DeError>

    /// Reads a `u8`.
    fn deserialize_u8(mut self): Result<u8, DeError>
    /// Reads a `u16`.
    fn deserialize_u16(mut self): Result<u16, DeError>
    /// Reads a `u32`.
    fn deserialize_u32(mut self): Result<u32, DeError>
    /// Reads a `u64`.
    fn deserialize_u64(mut self): Result<u64, DeError>
    /// Reads a `usize`.
    fn deserialize_usize(mut self): Result<usize, DeError>

    /// Reads an `f32`.
    fn deserialize_f32(mut self): Result<f32, DeError>
    /// Reads an `f64`.
    fn deserialize_f64(mut self): Result<f64, DeError>

    /// Reads a `char`.
    fn deserialize_char(mut self): Result<char, DeError>
    /// Reads a string into a new `String`.
    fn deserialize_str(mut self): Result<String, DeError>
    /// Reads a run of bytes into a new `List<u8>`.
    fn deserialize_bytes(mut self): Result<List<u8>, DeError>

    /// Consumes the opening of a sequence.
    fn begin_seq(mut self): Result<(), DeError>
    /// Whether another sequence element follows; consumes the separator between elements.
    fn has_next_seq_element(mut self): Result<bool, DeError>
    /// Consumes the closing of the sequence.
    fn end_seq(mut self): Result<(), DeError>

    /// Consumes the opening of a map.
    fn begin_map(mut self): Result<(), DeError>
    /// Whether another map entry follows; consumes the separator between entries.
    fn has_next_map_entry(mut self): Result<bool, DeError>
    /// Reads the next map entry's key.
    fn map_key(mut self): Result<String, DeError>
    /// Consumes the closing of the map.
    fn end_map(mut self): Result<(), DeError>

    /// Consumes the opening of the struct named `name`.
    fn begin_struct(mut self, name: str): Result<(), DeError>
    /// Whether another field follows; consumes the separator between fields.
    fn has_next_field(mut self): Result<bool, DeError>
    /// Reads the next field's name.
    fn field_name(mut self): Result<String, DeError>
    /// Consumes the closing of the struct.
    fn end_struct(mut self): Result<(), DeError>

    /// Consumes the opening of the enum named `name` and its `.`.
    fn begin_enum(mut self, name: str): Result<(), DeError>
    /// Reads the variant's name.
    fn variant_name(mut self): Result<String, DeError>
    /// Consumes the opening of the variant's `arity` payload values.
    fn begin_variant_payload(mut self, arity: usize): Result<(), DeError>
    /// Consumes what separates payload value `index` from the one before it (for index 0, nothing).
    fn variant_payload_field(mut self, index: usize): Result<(), DeError>
    /// Consumes the closing of the variant's payload.
    fn end_variant_payload(mut self, arity: usize): Result<(), DeError>
}

/// A type that a format can write. `serialize` writes exactly one value. A hand-written impl block implements this
/// for any type, and `struct T: Serialize` makes the compiler generate one (spec/serialization.md, SER12). The
/// primitive types, `String`, `List`, `Map<String, V>`, `Option`, `Result`, and tuples of 2 to 4 implement it without
/// a block, when their parts do (SER3, SER14).
interface Serialize {
    /// Writes the value with `s`.
    fn serialize<S: Serializer>(self, mut s: S): Result<(), DeError>
}

/// A type that a format can read. `deserialize` reads exactly one value and returns it. It is an associated
/// function, so an impl block for `T` returns `Result<T, DeError>` and a call is written `T.deserialize(mut d)`.
/// A hand-written impl block or `struct T: Deserialize` implements it. The built-in types of the `Serialize` note
/// implement it too, without a block (spec/serialization.md, SER12, SER14).
interface Deserialize {
    /// Reads the value with `d`.
    fn deserialize<D: Deserializer>(mut d: D): Result<Self, DeError>
}

/// What a format or a reader reports when a value cannot be written or read (spec/serialization.md, SER9 and SER10).
/// `message` is the format's or the data model's text; `path` is the location of the offending value inside the
/// value being handled (`config.servers[2].port`), empty when the error is at the value itself. The `field`,
/// `index`, `key`, and `variant` methods prepend a segment to the path, so a reader attaches the path as the error
/// unwinds.
struct DeError {
    /// The description, including a `line L, column C: ` prefix for a syntax error.
    message: String
    /// The path to the offending value, outermost segment first; empty at the value itself.
    path: String
}

DeError: Display {
    fn fmt(self, mut f: Formatter) {
        f.write_str(self.message.as_str())
        if self.path.len() > 0 {
            f.write_str(" at ")
            f.write_str(self.path.as_str())
        }
    }
}

DeError: Error { }

DeError {
    /// An error at the value itself, with no path.
    fn new(message: str): DeError {
        DeError { message: message.to_string(), path: String.new() }
    }

    /// A syntax error of the input at `line` and `column` (both 1-based; a column counts Unicode scalar values).
    /// The message becomes `line L, column C: <message>`.
    fn syntax(message: str, line: i32, col: i32): DeError {
        DeError { message: format("line {line}, column {col}: {message}"), path: String.new() }
    }

    /// Prepends the field `name` to the path (spec/serialization.md, SER9).
    fn field(own self, name: str): DeError {
        let path = __prepend(name, self.path.as_str())
        DeError { message: self.message, path }
    }

    /// Prepends the sequence index `index` to the path.
    fn index(own self, index: usize): DeError {
        let segment = format("[{index}]")
        let path = __prepend(segment.as_str(), self.path.as_str())
        DeError { message: self.message, path }
    }

    /// Prepends the map key `key` to the path.
    fn key(own self, key: str): DeError {
        let segment = __key_segment(key)
        let path = __prepend(segment.as_str(), self.path.as_str())
        DeError { message: self.message, path }
    }

    /// Prepends the variant `name` to the path.
    fn variant(own self, name: str): DeError {
        let path = __prepend(name, self.path.as_str())
        DeError { message: self.message, path }
    }
}

/// A field name the reader did not expect (spec/serialization.md, SER6). The caller extends the path with the name.
fn unknown_field(name: str): DeError {
    DeError.new(format("unknown field '{name}'"))
}

/// A field name that appeared twice (spec/serialization.md, SER6). The caller extends the path with the name.
fn duplicate_field(name: str): DeError {
    DeError.new(format("duplicate field '{name}'"))
}

/// A field the reader never saw (spec/serialization.md, SER6). The caller extends the path with the struct's
/// location, not with the field's, because the field is absent from the input.
fn missing_field(name: str): DeError {
    DeError.new(format("missing field '{name}'"))
}

/// A variant name the reader did not expect (spec/serialization.md, SER8).
fn unknown_variant(type_name: str, name: str): DeError {
    DeError.new(format("unknown variant '{name}' of {type_name}"))
}

/// Prepends `segment` to `path`: a field or variant name uses `.` unless the path starts with `[`; an index or key
/// segment (which already starts with `[`) adds nothing before a path that starts with `[`.
priv fn __prepend(segment: str, path: str): String {
    if path.len() == 0 {
        segment.to_string()
    } else if path.starts_with("[") {
        format("{segment}{path}")
    } else {
        format("{segment}.{path}")
    }
}

/// The path segment of a map key: `["key"]`, with the key escaped like a string literal.
priv fn __key_segment(key: str): String {
    let mut out = String.new()
    out.push('[')
    __write_quoted(mut out, key, '"')
    out.push(']')
    out
}

// ----- scalar helpers -----------------------------------------------------------------------------------------

/// Writes the unit value with `s`.
fn serialize_unit<S: Serializer>(mut s: S): Result<(), DeError> {
    s.serialize_unit()
}

/// Writes a `bool` with `s`.
fn serialize_bool<S: Serializer>(mut s: S, value: bool): Result<(), DeError> {
    s.serialize_bool(value)
}

/// Writes an `i8` with `s`.
fn serialize_i8<S: Serializer>(mut s: S, value: i8): Result<(), DeError> {
    s.serialize_i8(value)
}

/// Writes an `i16` with `s`.
fn serialize_i16<S: Serializer>(mut s: S, value: i16): Result<(), DeError> {
    s.serialize_i16(value)
}

/// Writes an `i32` with `s`.
fn serialize_i32<S: Serializer>(mut s: S, value: i32): Result<(), DeError> {
    s.serialize_i32(value)
}

/// Writes an `i64` with `s`.
fn serialize_i64<S: Serializer>(mut s: S, value: i64): Result<(), DeError> {
    s.serialize_i64(value)
}

/// Writes an `isize` with `s`.
fn serialize_isize<S: Serializer>(mut s: S, value: isize): Result<(), DeError> {
    s.serialize_isize(value)
}

/// Writes a `u8` with `s`.
fn serialize_u8<S: Serializer>(mut s: S, value: u8): Result<(), DeError> {
    s.serialize_u8(value)
}

/// Writes a `u16` with `s`.
fn serialize_u16<S: Serializer>(mut s: S, value: u16): Result<(), DeError> {
    s.serialize_u16(value)
}

/// Writes a `u32` with `s`.
fn serialize_u32<S: Serializer>(mut s: S, value: u32): Result<(), DeError> {
    s.serialize_u32(value)
}

/// Writes a `u64` with `s`.
fn serialize_u64<S: Serializer>(mut s: S, value: u64): Result<(), DeError> {
    s.serialize_u64(value)
}

/// Writes a `usize` with `s`.
fn serialize_usize<S: Serializer>(mut s: S, value: usize): Result<(), DeError> {
    s.serialize_usize(value)
}

/// Writes an `f32` with `s`.
fn serialize_f32<S: Serializer>(mut s: S, value: f32): Result<(), DeError> {
    s.serialize_f32(value)
}

/// Writes an `f64` with `s`.
fn serialize_f64<S: Serializer>(mut s: S, value: f64): Result<(), DeError> {
    s.serialize_f64(value)
}

/// Writes a `char` with `s`.
fn serialize_char<S: Serializer>(mut s: S, value: char): Result<(), DeError> {
    s.serialize_char(value)
}

/// Writes a `str` (or a `String`) with `s`.
fn serialize_str<S: Serializer>(mut s: S, value: str): Result<(), DeError> {
    s.serialize_str(value)
}

/// Writes a run of bytes with `s`.
fn serialize_bytes<S: Serializer>(mut s: S, value: [u8]): Result<(), DeError> {
    s.serialize_bytes(value)
}

/// Reads the unit value with `d`.
fn deserialize_unit<D: Deserializer>(mut d: D): Result<(), DeError> {
    d.deserialize_unit()
}

/// Reads a `bool` with `d`.
fn deserialize_bool<D: Deserializer>(mut d: D): Result<bool, DeError> {
    d.deserialize_bool()
}

/// Reads an `i8` with `d`.
fn deserialize_i8<D: Deserializer>(mut d: D): Result<i8, DeError> {
    d.deserialize_i8()
}

/// Reads an `i16` with `d`.
fn deserialize_i16<D: Deserializer>(mut d: D): Result<i16, DeError> {
    d.deserialize_i16()
}

/// Reads an `i32` with `d`.
fn deserialize_i32<D: Deserializer>(mut d: D): Result<i32, DeError> {
    d.deserialize_i32()
}

/// Reads an `i64` with `d`.
fn deserialize_i64<D: Deserializer>(mut d: D): Result<i64, DeError> {
    d.deserialize_i64()
}

/// Reads an `isize` with `d`.
fn deserialize_isize<D: Deserializer>(mut d: D): Result<isize, DeError> {
    d.deserialize_isize()
