/// Reads a `u8` with `d`.
fn deserialize_u8<D: Deserializer>(mut d: D): Result<u8, DeError> {
    d.deserialize_u8()
}

/// Reads a `u16` with `d`.
fn deserialize_u16<D: Deserializer>(mut d: D): Result<u16, DeError> {
    d.deserialize_u16()
}

/// Reads a `u32` with `d`.
fn deserialize_u32<D: Deserializer>(mut d: D): Result<u32, DeError> {
