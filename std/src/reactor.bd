// The reactor and the helper pool (spec/io.md, IO2-IO4, IO7).
//
// A task that waits for a socket, a file operation, a name lookup, or a timer parks: it leaves its worker free to
// run other tasks. Two pieces make that happen. The reactor thread waits on the operating system's event facility
// (epoll, kqueue, or a completion port) and wakes the task whose wait is ready or whose timer expired. The helper
// pool runs calls that block (file operations, name lookups, `blocking` extern functions) on a few threads and
// completes the waiting task when they finish.
//
// The runtime primitives behind this file are `__io_*`, `__pool_submit`, and the scheduler's waiters
// (`spec/tasks.md`, TK2; `spec/io.md`, IO2). A wait record (`Wait`) is linked by the runtime through its first
// word and carries its event kind at offset 24, so its layout is fixed.

use option.take
use task.{Waiter, current_worker, sched_lock, sched_unlock, waiter_block, waiter_free, waiter_new, waiter_notify}

// The reactor lives as long as the process, so its record comes straight from the C allocator; timer nodes are
// per wait and go through the program's allocator, so a test's leak check sees them.
extern "C" {
    priv fn calloc(count: usize, size: usize): CPtr<u8>
}

/// The event kind the runtime writes: a watched descriptor is ready.
priv const KIND_READY: i32 = 1
/// The event kind the runtime writes: a helper call finished.
priv const KIND_DONE: i32 = 2

/// A wait: one task's registration with the reactor. The fields at offsets 0 (`next`) and 24 (`kind`) are read by
/// the runtime, so the two pointers before `kind` and the field order must not change.
priv struct Wait repr(C) {
    next: CPtr<Wait>
    waiter: CPtr<Waiter>
    /// The descriptor being watched, or -1 for a timer or an offloaded call.
    fd: i64
    /// Written by the runtime: 1 ready, 2 completed.
    kind: i32
    /// The timer node while one is linked.
    timer: CPtr<u8>
    /// Who claimed the wait: 0 none, 1 ready, 2 completed, 3 timed out.
    claimed: i32
}

/// One pending deadline, kept in a list sorted by deadline.
priv struct Timer repr(C) {
    deadline: u64
    wait: CPtr<Wait>
    prev: CPtr<Timer>
    next: CPtr<Timer>
}

/// The process-wide reactor: the runtime's event facility, the timer list, and its lock.
priv struct Reactor repr(C) {
    io: CPtr<u8>
    lock: CPtr<u8>
    timers: CPtr<Timer>
    started: usize
}

/// A fresh, unclaimed wait for `fd`; `events` is 1 for readable and 2 for writable, and is ignored for a timer.
priv fn new_wait(fd: i64): Wait {
    unsafe {
        Wait { next: CPtr.null(), waiter: waiter_new(), fd: fd, kind: 0, timer: CPtr.null(), claimed: 0 }
    }
}

/// The reactor, created and started on first use.
priv fn reactor(): CPtr<Reactor> {
    unsafe {
        let existing = __io_global_get() as CPtr<Reactor>
        if !existing.is_null() {
            return existing
        }
        __spin_lock()
        let again = __io_global_get() as CPtr<Reactor>
        if !again.is_null() {
            __spin_unlock()
            return again
        }
        let r = calloc(1, Reactor.size()) as CPtr<Reactor>
        (*r).io = __io_new()
        (*r).lock = __mutex_new()
        (*r).timers = CPtr.null()
        (*r).started = 1
        __io_global_set(r as CPtr<u8>)
        __spin_unlock()
        // The thread is started outside the creation lock: it may need the scheduler's lock, which is taken under
        // this one by nothing else.
        __thread_start(|| {
            reactor_main(r)
        })
        r
    }
}

/// The reactor thread: wait for events or the nearest deadline, claim what fired, and repeat.
priv fn reactor_main(r: CPtr<Reactor>) {
    unsafe {
        loop {
            let timeout = next_timeout(r)
            let mut fired = __io_poll((*r).io, timeout) as CPtr<Wait>
            while !fired.is_null() {
                // Read the link before claiming: the task may free its record as soon as it is woken.
                let next = (*fired).next
                let kind = (*fired).kind
                claim(r, fired, kind)
                fired = next
            }
            expire_timers(r)
        }
    }
}

/// Claims `w` exactly once with `kind`, unlinks its timer, and wakes its task. A wait that another event already
/// claimed is left alone, so a record is never woken twice.
priv fn claim(r: CPtr<Reactor>, w: CPtr<Wait>, kind: i32) {
    unsafe {
        __mutex_lock((*r).lock)
        let mut mine = false
        if (*w).claimed == 0 {
            (*w).claimed = kind
            timer_unlink(r, w)
            mine = true
        }
        __mutex_unlock((*r).lock)
        if !mine {
            return
        }
        sched_lock()
        waiter_notify((*w).waiter)
        sched_unlock()
    }
}

/// Waits until `fd` is ready for `events` (1 readable, 2 writable) or `timeout_nanos` passes (0 waits forever).
/// Returns 0 when the wait is ready; 1 when it timed out; -1 when the reactor could not watch the descriptor.
/// A descriptor of -1 waits on the timer only.
priv fn wait_io(fd: i64, events: i32, timeout_nanos: u64): i32 {
    unsafe {
        let r = reactor()
        let wait = new_wait(fd)
        sched_lock()
        if timeout_nanos > 0 {
            let deadline = (__clock(1) as u64) + timeout_nanos
            timer_add(r, (&wait) as CPtr<Wait>, deadline)
        }
        if fd >= 0 {
            let watched = __io_watch((*r).io, fd, events, (&wait) as CPtr<u8>)
            if watched != 0 {
                __mutex_lock((*r).lock)
                timer_unlink(r, (&wait) as CPtr<Wait>)
                __mutex_unlock((*r).lock)
                sched_unlock()
                waiter_free(wait.waiter)
                return -1
            }
            // The reactor may be waiting with a poll set taken before this registration. epoll and kqueue wake
            // when one is added, but `WSAPoll` keeps waiting on the set it was given, so the reactor is woken
            // explicitly to take a fresh one.
            __io_wake((*r).io)
        }
        waiter_block(wait.waiter)
        waiter_free(wait.waiter)
        match wait.claimed {
            1 => 0,
            2 => 0,
            _ => 1,
        }
    }
}

/// The time until the nearest deadline, in milliseconds, or -1 with no deadline. The reactor waits at most an hour
/// at a time, so the timeout always fits.
priv fn next_timeout(r: CPtr<Reactor>): i64 {
    unsafe {
        __mutex_lock((*r).lock)
        let head = (*r).timers
        let mut timeout: i64 = -1
        if !head.is_null() {
            let now = __clock(1) as u64
            if (*head).deadline <= now {
                timeout = 0
            } else {
                let delta = (*head).deadline - now
                let millis = (delta + 999_999) / 1_000_000
                if millis > 3_600_000 {
                    timeout = 3_600_000
                } else {
                    timeout = millis as i64
                }
            }
        }
        __mutex_unlock((*r).lock)
        timeout
    }
}

/// Links a timer for `w`. The caller holds the scheduler's lock, and the reactor is woken so it recomputes its
/// timeout.
priv fn timer_add(r: CPtr<Reactor>, w: CPtr<Wait>, deadline: u64) {
    unsafe {
        let node = __alloc(Timer.size(), 8) as CPtr<Timer>
        (*node).deadline = deadline
        (*node).wait = w
        (*node).prev = CPtr.null()
        (*node).next = CPtr.null()
        __mutex_lock((*r).lock)
        let mut cur = (*r).timers
        let mut prev: CPtr<Timer> = CPtr.null()
        while !cur.is_null() && (*cur).deadline <= deadline {
            prev = cur
            cur = (*cur).next
        }
        (*node).next = cur
        (*node).prev = prev
        if !cur.is_null() {
            (*cur).prev = node
        }
        if prev.is_null() {
            (*r).timers = node
        } else {
            (*prev).next = node
        }
        (*w).timer = node as CPtr<u8>
        __mutex_unlock((*r).lock)
        __io_wake((*r).io)
    }
}

/// Unlinks and frees the timer of `w`, if it has one. The reactor's lock must be held.
priv fn timer_unlink(r: CPtr<Reactor>, w: CPtr<Wait>) {
    unsafe {
        let node = (*w).timer as CPtr<Timer>
        if node.is_null() {
            return
        }
        if (*node).prev.is_null() {
            (*r).timers = (*node).next
        } else {
            (*(*node).prev).next = (*node).next
        }
        if !(*node).next.is_null() {
            (*(*node).next).prev = (*node).prev
        }
        (*w).timer = CPtr.null()
        __dealloc(node as CPtr<u8>, Timer.size(), 8)
    }
}

/// Wakes every wait whose deadline has passed. A wait that a ready descriptor already claimed is left alone; its
/// timer is unlinked, because the record is about to be freed.
priv fn expire_timers(r: CPtr<Reactor>) {
    unsafe {
        let now = __clock(1) as u64
        let mut due: CPtr<Wait> = CPtr.null()
        __mutex_lock((*r).lock)
        loop {
            let head = (*r).timers
            if head.is_null() {
                break
            }
            if (*head).deadline > now {
                break
            }
            (*r).timers = (*head).next
            if !(*head).next.is_null() {
                (*(*head).next).prev = CPtr.null()
            }
            let w = (*head).wait
            (*w).timer = CPtr.null()
            __dealloc(head as CPtr<u8>, Timer.size(), 8)
            if (*w).claimed == 0 {
                (*w).claimed = 3
                (*w).next = due
                due = w
            }
        }
        __mutex_unlock((*r).lock)
        while !due.is_null() {
            let next = (*due).next
            if (*due).fd >= 0 {
                __io_unwatch((*r).io, (*due).fd)
            }
            sched_lock()
            waiter_notify((*due).waiter)
            sched_unlock()
            due = next
        }
    }
}

// ---- the helper pool --------------------------------------------------------------------------------------------

/// Runs `f` on a helper thread and waits for it, parking the calling task. The compiler checks that what `f` borrows
/// outlives the call, and nothing else can touch those places while `f` runs, because the call does not return before
/// the helper is done. This is why `f` needs no `Send` bound: it is not left running after the call (`spec/io.md`,
/// IO3). Outside a task there is no worker to keep free, and the calling thread would only wait for the helper, so
/// `f` runs right here: the round trip through the pool and the reactor costs about 100 us (issue #1021).
priv fn offload<T, F: FnMut(): T>(own f: F): T {
    if !in_task() {
        let mut f = f
        return f()
    }
    unsafe {
        let r = reactor()
        let slot = __alloc(Option<T>.size(), 8) as CPtr<Option<T>>
        // The slot holds `None` before the helper writes; assigning through the raw pointer would otherwise drop
        // whatever the fresh allocation happened to hold.
        let empty: Option<T> = Option.None
        let src = (&empty) as CPtr<u8>
        let dst = slot as CPtr<u8>
        let mut i: usize = 0
        while i < Option<T>.size() {
            *(dst + i) = *(src + i)
            i = i + 1
        }
        let wait = new_wait(-1)
        // The closure is relabelled as an owned `FnOnce` for the helper: the caller waits for it, so what it
        // borrows outlives it (the same argument as `Scope.spawn`, `spec/tasks.md` TK7).
        let owned = __closure_own(f)
        sched_lock()
        __pool_submit((*r).io, (&wait) as CPtr<u8>, || {
            unsafe {
                let value = owned()
                *slot = Option.Some(value)
            }
        })
        waiter_block(wait.waiter)
        waiter_free(wait.waiter)
        let value = (*slot).take()
        __dealloc(slot as CPtr<u8>, Option<T>.size(), 8)
        match value {
            Option.Some(v) => v,
            Option.None => panic("offload: the helper finished without a value"),
        }
    }
}

/// Runs the raw code and record of a compiler-generated thunk on a helper thread and waits for it. This is what a
/// `blocking` extern call uses: the compiler builds the thunk and the argument block (`spec/io.md`, IO4).
priv fn offload_raw(own code: CPtr<u8>, own env: CPtr<u8>) {
    unsafe {
        let r = reactor()
        let wait = new_wait(-1)
        sched_lock()
        __pool_submit_raw((*r).io, (&wait) as CPtr<u8>, code, env)
        waiter_block(wait.waiter)
        waiter_free(wait.waiter)
    }
}

/// Whether the calling code runs on a scheduler task, which is what decides between a park and a block.
priv fn in_task(): bool {
    unsafe {
        !current_worker().is_null()
    }
}

/// Sleeps for `nanos` on the reactor's timer, so a task does not hold its worker while it waits. Outside a task it
/// blocks the thread, exactly like `__sleep`.
priv fn sleep_async(nanos: u64) {
    if nanos == 0 {
        return
    }
    unsafe {
        let _ = wait_io(-1, 0, nanos)
    }
}
