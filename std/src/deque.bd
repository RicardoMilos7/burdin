// `Deque<T>`: a double-ended queue (spec/stdlib.md).
//
// It is two lists. `front` holds the first elements in reverse order and `back` holds the rest in order, so the
// logical sequence is `front` read from its end to its start, then `back` from start to end. Pushing at either end is
// a `push` on one list; popping from an end whose list is empty first moves the other list over. `List` is unchanged.

use fmt.{Debug, Formatter}
use iter.{Iterable, Iterator}
use ops.{Index, IndexMut, PartialEq}

/// A double-ended queue.
struct Deque<T> {
    front: List<T>
    back: List<T>
}

/// The iterator of `deque.iter()`: it yields a view of each element from the front to the back. `D` is the view of
/// the deque it walks, so the iterator is second-class like every iterator over borrowed storage.
struct DequeIter<D, T> {
    source: D
    next_index: usize
}

/// The iterator of `deque.iter_mut()`: it yields a writable view of each element from the front to the back. `D` is
/// the exclusive view of the deque it walks (spec/iterators.md, IT13).
struct DequeIterMut<D, T> {
    source: D
    next_index: usize
}

/// What `DequeIter` needs from the deque it walks.
interface DequeLen {
    fn deque_len(self): usize
}

Deque<T>: DequeLen {
    fn deque_len(self): usize {
        self.front.len() + self.back.len()
    }
}

Deque<T> {
    /// An empty deque.
    fn new(): Deque<T> {
        Deque { front: List<T>.new(), back: List<T>.new() }
    }

    /// A deque holding the elements of `items`, in order.
    fn from_list(own items: List<T>): Deque<T> {
        let mut out = Deque<T>.new()
        out.extend(items)
        out
    }

    /// The number of elements.
    fn len(self): usize {
        self.front.len() + self.back.len()
    }

    /// Whether the deque has no elements.
    fn is_empty(self): bool {
        self.len() == 0
    }

    /// Adds `value` before the first element.
    fn push_front(mut self, own value: T) {
        self.front.push(value)
    }

    /// Adds `value` after the last element.
    fn push_back(mut self, own value: T) {
        self.back.push(value)
    }

    /// Removes and returns the first element.
    fn pop_front(mut self): Option<T> {
        if self.front.len() == 0 {
            loop {
                match self.back.pop() {
                    Some(x) => self.front.push(x),
                    None => break,
                }
            }
        }
        self.front.pop()
    }

    /// Removes and returns the last element.
    fn pop_back(mut self): Option<T> {
        if self.back.len() == 0 {
            loop {
                match self.front.pop() {
                    Some(x) => self.back.push(x),
                    None => break,
                }
            }
        }
        self.back.pop()
    }

    /// A view of the first element.
    fn front(self): Option<&T> {
        self.get(0)
    }

    /// A view of the last element.
    fn back(self): Option<&T> {
        if self.len() == 0 {
            return None
        }
        self.get(self.len() - 1)
    }

    /// A view of the element at `i`, counting from the front, or `None` when `i` is past the end.
    fn get(self, i: usize): Option<&T> {
        let f = self.front.len()
        if i < f {
            Some(&self.front[f - 1 - i])
        } else if i - f < self.back.len() {
            Some(&self.back[i - f])
        } else {
            None
        }
    }

    /// Removes every element.
    fn clear(mut self) {
        self.front.clear()
        self.back.clear()
    }

    /// Adds every element of `items` at the back, in order.
    fn extend(mut self, own items: List<T>) {
        for x in items.into_iter() {
            self.back.push(x)
        }
    }

    /// The elements as a list, from the front to the back. The deque is consumed.
    fn into_list(own self): List<T> {
        let mut out = List<T>.new()
        let mut deque = self
        loop {
            match deque.pop_front() {
                Some(x) => out.push(x),
                None => break,
            }
        }
        out
    }
}

Deque<T>: Index<T> {
    fn index(self, i: usize): &T {
        let f = self.front.len()
        if i >= f + self.back.len() {
            panic("Deque index out of bounds")
        }
        if i < f {
            &self.front[f - 1 - i]
        } else {
            &self.back[i - f]
        }
    }
}

Deque<T>: IndexMut<T> {
    fn index_mut(mut self, i: usize): &mut T {
        let f = self.front.len()
        if i >= f + self.back.len() {
            panic("Deque index out of bounds")
        }
        if i < f {
            return &mut self.front[f - 1 - i]
        }
        &mut self.back[i - f]
    }
}

Deque<T>: Iterable<&T> {
    /// An iterator over views of the elements, from the front to the back.
    fn iter(self): DequeIter<&Deque<T>, T> {
        DequeIter { source: &self, next_index: 0 }
    }
}

Deque<T> {
    /// An iterator over writable views of the elements, from the front to the back. The deque is borrowed
    /// exclusively until the iterator's last use, so `for x in mut deque` can write every element but cannot push,
    /// pop, or read the deque inside the loop.
    fn iter_mut(mut self): DequeIterMut<&mut Deque<T>, T> {
        DequeIterMut { source: &mut self, next_index: 0 }
    }
}

DequeIterMut<D, T>: Iterator<&mut T> where D: IndexMut<T> + DequeLen {
    fn next(mut self): Option<&mut T> {
        if self.next_index >= self.source.deque_len() {
            return None
        }
        let k = self.next_index
        self.next_index = self.next_index + 1
        Some(&mut self.source[k])
    }
}

DequeIter<D, T>: Iterator<&T> where D: Index<T> + DequeLen {
    fn next(mut self): Option<&T> {
        if self.next_index >= self.source.deque_len() {
            return None
        }
        let k = self.next_index
        self.next_index = self.next_index + 1
        Some(&self.source[k])
    }
}

Deque<T> where T: Clone {
    /// A copy of the deque.
    fn clone(self): Deque<T> {
        let mut out = Deque<T>.new()
        for x in self {
            out.push_back((*x).clone())
        }
        out
    }
}

Deque<T>: PartialEq where T: Eq {
    fn eq(self, other: Deque<T>): bool {
        if self.len() != other.len() {
            return false
        }
        let mut i: usize = 0
        while i < self.len() {
            if self[i] != other[i] {
                return false
            }
            i = i + 1
        }
        true
    }
}

Deque<T>: Debug where T: Debug {
    fn debug(self, mut f: Formatter) {
        f.write_str("[")
        let mut first = true
        for x in self {
            if !first {
                f.write_str(", ")
            }
            first = false
            x.debug(mut f)
        }
        f.write_str("]")
    }
}
