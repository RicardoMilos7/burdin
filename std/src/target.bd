// The system the program is compiled for. The compiler builds for the machine it runs on, so these are known
// while compiling and work in a compile-time `if` (spec/const-eval.md, CE4).

/// An operating system.
///
/// ```
/// let o: Os = os()
/// assert(o == Os.Linux || o == Os.MacOs || o == Os.Windows)
/// ```
enum Os: Copy, Clone, Eq {
    Linux
    MacOs
    Windows
}

/// A processor architecture.
///
/// ```
/// let a: Arch = arch()
/// assert(a == Arch.X86_64 || a == Arch.Aarch64)
/// ```
enum Arch: Copy, Clone, Eq {
    X86_64
    Aarch64
}

/// The operating system the program is compiled for.
///
/// ```
/// let name = match os() {
///     Os.Linux => "linux",
///     Os.MacOs => "macos",
///     Os.Windows => "windows",
/// }
/// assert(name.len() > 0)
/// ```
fn os(): Os {
    match __target_os() {
        "windows" => Os.Windows,
        "macos" => Os.MacOs,
        _ => Os.Linux,
    }
}

/// The processor architecture the program is compiled for.
///
/// ```
/// let a: Arch = arch()
/// assert(a == Arch.X86_64 || a == Arch.Aarch64)
/// ```
fn arch(): Arch {
    match __target_arch() {
        "aarch64" => Arch.Aarch64,
        _ => Arch.X86_64,
    }
}
