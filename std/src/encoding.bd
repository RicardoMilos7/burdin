// Text and binary encodings (issue #414; spec/stdlib.md, "Encodings"): UTF-8 bytes, hexadecimal, base64 (standard and
// URL-safe), and percent-encoding. Encoders return a `String`; decoders return a `Result` whose error says where
// the input went wrong.

use fmt.{Debug, Display, Formatter}
use std.Error
use unicode.{len_utf8, to_char}

/// What went wrong while decoding.
///
/// ```
/// match hex_decode("zz") {
///     Ok(_) => assert(false),
///     Err(e) => assert_eq(e, DecodeError.InvalidCharacter { index: 0 }),
/// }
/// ```
error enum DecodeError: Eq, Debug {
    InvalidLength "invalid length"
    InvalidCharacter { index: usize } "invalid character at byte {index}"
    InvalidUtf8 { index: usize } "invalid UTF-8 at byte {index}"
}

/// Why a byte sequence is not valid UTF-8: the offset of the first byte that is not part of a well-formed
/// sequence (`spec/stdlib.md`, "String bytes and UTF-8 validation").
///
/// ```
/// let mut bad = BytesMut.new()
/// bad.push(255)
/// match String.from_utf8(bad.into_list()) {
///     Ok(_) => assert(false),
///     Err(e) => assert_eq(e, Utf8Error.Invalid { index: 0 }),
/// }
/// ```
error enum Utf8Error: Eq, Debug {
    Invalid { index: usize } "invalid UTF-8 at byte {index}"
}

// ---- UTF-8 ----

/// The byte offset of the first byte that does not start a well-formed UTF-8 sequence, or `None` when every byte
/// belongs to one. The same rules as `from_utf8`: a bad lead or continuation byte, an overlong form, a surrogate,
/// a value past U+10FFFF, or a sequence cut off by the end.
priv fn __utf8_error_at(data: [u8]): Option<usize> {
    let n = data.len()
    let mut i: usize = 0
    while i < n {
        let lead = data[i] as u32
        let mut extra: usize = 0
        let mut cp: u32 = 0
        if lead < 128 {
            cp = lead
        } else if lead >= 194 && lead <= 223 {
            extra = 1
            cp = lead & 31
        } else if lead >= 224 && lead <= 239 {
            extra = 2
            cp = lead & 15
        } else if lead >= 240 && lead <= 244 {
            extra = 3
            cp = lead & 7
        } else {
            return Some(i)
        }
        if i + extra >= n && extra > 0 {
            return Some(i)
        }
        let mut k: usize = 1
        while k <= extra {
            let next = data[i + k] as u32
            if next < 128 || next > 191 {
                return Some(i)
            }
            cp = (cp << 6) | (next & 63)
            k = k + 1
        }
        let overlong = (extra == 2 && cp < 2048) || (extra == 3 && cp < 65536)
        let surrogate = cp >= 55296 && cp <= 57343
        if overlong || surrogate || cp > 1114111 {
            return Some(i)
        }
        i = i + extra + 1
    }
    None
}

/// The character starting at byte `at`, with the number of bytes it takes, or `None` when the bytes there are not
/// a well-formed UTF-8 sequence. Callers know `at < data.len()`.
priv fn __utf8_char_at(data: [u8], at: usize): Option<(char, usize)> {
    let n = data.len()
    let lead = data[at] as u32
    let mut extra: usize = 0
    let mut cp: u32 = 0
    if lead < 128 {
        cp = lead
    } else if lead >= 194 && lead <= 223 {
        extra = 1
        cp = lead & 31
    } else if lead >= 224 && lead <= 239 {
        extra = 2
        cp = lead & 15
    } else if lead >= 240 && lead <= 244 {
        extra = 3
        cp = lead & 7
    } else {
        return None
    }
    if at + extra >= n && extra > 0 {
        return None
    }
    let mut k: usize = 1
    while k <= extra {
        let next = data[at + k] as u32
        if next < 128 || next > 191 {
            return None
        }
        cp = (cp << 6) | (next & 63)
        k = k + 1
    }
    let overlong = (extra == 2 && cp < 2048) || (extra == 3 && cp < 65536)
    let surrogate = cp >= 55296 && cp <= 57343
    if overlong || surrogate || cp > 1114111 {
        return None
    }
    Some((cp as char, extra + 1))
}

/// U+FFFD REPLACEMENT CHARACTER. It is built from its code point because string literals have no `\u` escape.
priv fn __replacement_char(): char {
    match (65533 as u32).to_char() {
        Some(c) => c,
        None => '?',
    }
}

/// Appends the UTF-8 bytes of `c`.
priv fn __push_utf8(mut out: List<u8>, c: char) {
    let n = c as u32
    if n < 128 {
        out.push(n as u8)
    } else if n < 2048 {
        out.push((192 | (n >> 6)) as u8)
        out.push((128 | (n & 63)) as u8)
    } else if n < 65536 {
        out.push((224 | (n >> 12)) as u8)
        out.push((128 | ((n >> 6) & 63)) as u8)
        out.push((128 | (n & 63)) as u8)
    } else {
        out.push((240 | (n >> 18)) as u8)
        out.push((128 | ((n >> 12) & 63)) as u8)
        out.push((128 | ((n >> 6) & 63)) as u8)
        out.push((128 | (n & 63)) as u8)
    }
}

/// The UTF-8 bytes of the text.
///
/// ```
/// let bytes = "é".to_utf8()
/// assert_eq(bytes.len(), 2)
/// assert_eq(bytes[0], 195)
/// ```
fn str.to_utf8(self): List<u8> {
    let mut out = List<u8>.new()
    for c in self.chars() {
        __push_utf8(mut out, c)
    }
    out
}

/// The UTF-8 bytes of the string.
///
/// ```
/// let bytes = String.from("é").to_utf8()
/// assert_eq(bytes.len(), 2)
/// ```
fn String.to_utf8(self): List<u8> {
    self.as_str().to_utf8()
}

/// The text the bytes spell, or `InvalidUtf8` with the offset of the first byte that is not valid UTF-8 (a bad
/// lead or continuation byte, an overlong form, a surrogate, a value past U+10FFFF, or a cut-off sequence).
///
/// ```
/// let b = BytesMut.from_text("hi")
/// assert_eq(from_utf8(b.as_slice()), Ok(String.from("hi")))
/// let mut bad = BytesMut.new()
/// bad.push(255)
/// match from_utf8(bad.as_slice()) {
///     Ok(_) => assert(false),
///     Err(e) => assert_eq(e, DecodeError.InvalidUtf8 { index: 0 }),
/// }
/// ```
fn from_utf8(data: [u8]): Result<String, DecodeError> {
    let mut out = String.new()
    let n = data.len()
    let mut i: usize = 0
    while i < n {
        let lead = data[i] as u32
        let mut extra: usize = 0
        let mut cp: u32 = 0
        if lead < 128 {
            cp = lead
        } else if lead >= 194 && lead <= 223 {
            extra = 1
            cp = lead & 31
        } else if lead >= 224 && lead <= 239 {
            extra = 2
            cp = lead & 15
        } else if lead >= 240 && lead <= 244 {
            extra = 3
            cp = lead & 7
        } else {
            return Err(DecodeError.InvalidUtf8 { index: i })
        }
        if i + extra >= n && extra > 0 {
            return Err(DecodeError.InvalidUtf8 { index: i })
        }
        let mut k: usize = 1
        while k <= extra {
            let next = data[i + k] as u32
            if next < 128 || next > 191 {
                return Err(DecodeError.InvalidUtf8 { index: i })
            }
            cp = (cp << 6) | (next & 63)
            k = k + 1
        }
        let overlong = (extra == 2 && cp < 2048) || (extra == 3 && cp < 65536)
        let surrogate = cp >= 55296 && cp <= 57343
        if overlong || surrogate || cp > 1114111 {
            return Err(DecodeError.InvalidUtf8 { index: i })
        }
        out.push(cp as char)
        i = i + extra + 1
    }
    Ok(out)
}

/// The text `bytes` spell, or the first invalid byte's offset. This is `String.from_utf8`
/// (`spec/stdlib.md`, "String bytes and UTF-8 validation").
fn __string_from_utf8(own bytes: List<u8>): Result<String, Utf8Error> {
    let data = bytes[0..bytes.len()]
    match __utf8_error_at(data) {
        Some(index) => Err(Utf8Error.Invalid { index }),
        // The bytes were just checked, so the unchecked view cast is sound here.
        None => Ok(String.from(unsafe { __view_as_text(data) })),
    }
}

/// A `str` view of `data` when it is valid UTF-8, or the first invalid byte's offset. The view borrows the
/// caller's bytes; the unchecked reinterpretation happens only after the bytes have been checked.
fn __str_from_utf8(data: [u8]): Result<str, Utf8Error> {
    match __utf8_error_at(data) {
        Some(index) => Err(Utf8Error.Invalid { index }),
        None => Ok(unsafe { __view_as_text(data) }),
    }
}

/// The text `data` spells, with every byte that is not part of a well-formed sequence replaced by U+FFFD. One
/// replacement character is emitted per invalid byte (`spec/stdlib.md`).
fn __string_from_utf8_lossy(data: [u8]): String {
    let mut out = String.new()
    let mut i: usize = 0
    while i < data.len() {
        match __utf8_char_at(data, i) {
            Some(pair) => {
                let (c, width) = pair
                out.push(c)
                i = i + width
            }
            None => {
                out.push(__replacement_char())
                i = i + 1
            }
        }
    }
    out
}

// ---- hexadecimal ----

priv fn __hex_char(n: u32, upper: bool): char {
    if n < 10 {
        return (48 + n) as char
    }
    if upper {
        return (55 + n) as char
    }
    (87 + n) as char
}

priv fn __hex_encode(data: [u8], upper: bool): String {
    let mut out = String.new()
    let mut i: usize = 0
    while i < data.len() {
        let b = data[i] as u32
        out.push(__hex_char(b >> 4, upper))
        out.push(__hex_char(b & 15, upper))
        i = i + 1
    }
    out
}

/// The bytes as lowercase hexadecimal, two digits per byte.
///
/// ```
/// let mut m = BytesMut.new()
/// m.push(255)
/// assert_eq(hex_encode(m.as_slice()), String.from("ff"))
/// ```
fn hex_encode(data: [u8]): String {
    __hex_encode(data, false)
}

/// The bytes as uppercase hexadecimal, two digits per byte.
///
/// ```
/// let mut m = BytesMut.new()
/// m.push(255)
/// assert_eq(hex_encode_upper(m.as_slice()), String.from("FF"))
/// ```
fn hex_encode_upper(data: [u8]): String {
    __hex_encode(data, true)
}

/// The value of a hexadecimal digit.
priv fn __hex_value(c: char): Option<u32> {
    let n = c as u32
    if n >= 48 && n <= 57 {
        return Some(n - 48)
    }
    if n >= 97 && n <= 102 {
        return Some(n - 87)
    }
    if n >= 65 && n <= 70 {
        return Some(n - 55)
    }
    None
}

/// The bytes that the hexadecimal text spells; either case is accepted. An odd number of digits is
/// `InvalidLength`, and a character that is not a hexadecimal digit is `InvalidCharacter`.
///
/// ```
/// let bytes = hex_decode("6869").unwrap()
/// assert_eq(bytes.to_text(), Ok(String.from("hi")))
/// match hex_decode("abc") {
///     Ok(_) => assert(false),
///     Err(e) => assert_eq(e, DecodeError.InvalidLength),
/// }
/// ```
fn hex_decode(text: str): Result<List<u8>, DecodeError> {
    let mut out = List<u8>.new()
    let mut high: u32 = 0
    let mut have_high = false
    let mut index: usize = 0
    for c in text.chars() {
        match __hex_value(c) {
            Some(v) => {
                if have_high {
                    out.push(((high << 4) | v) as u8)
                    have_high = false
                } else {
                    high = v
                    have_high = true
                }
            }
            None => {
                return Err(DecodeError.InvalidCharacter { index: index })
            }
        }
        index = index + c.len_utf8()
    }
    if have_high {
        return Err(DecodeError.InvalidLength)
    }
    Ok(out)
}

// ---- base64 ----

priv fn __b64_char(v: u32, url: bool): char {
    if v < 26 {
        return (65 + v) as char
    }
    if v < 52 {
        return (71 + v) as char
    }
    if v < 62 {
        return (v - 4) as char
    }
    if v == 62 {
        if url {
            return '-'
        }
        return '+'
    }
    if url {
        return '_'
    }
    '/'
}

priv fn __b64_value(c: char, url: bool): Option<u32> {
    let n = c as u32
    if n >= 65 && n <= 90 {
        return Some(n - 65)
    }
    if n >= 97 && n <= 122 {
        return Some(n - 71)
    }
    if n >= 48 && n <= 57 {
        return Some(n + 4)
    }
    if url {
        if c == '-' {
            return Some(62)
        }
        if c == '_' {
            return Some(63)
        }
        return None
    }
    if c == '+' {
        return Some(62)
    }
    if c == '/' {
        return Some(63)
    }
    None
}

priv fn __base64_encode(data: [u8], url: bool): String {
    let mut out = String.new()
    let n = data.len()
    let mut i: usize = 0
    while i + 2 < n {
        let v = ((data[i] as u32) << 16) | ((data[i + 1] as u32) << 8) | (data[i + 2] as u32)
        out.push(__b64_char((v >> 18) & 63, url))
        out.push(__b64_char((v >> 12) & 63, url))
        out.push(__b64_char((v >> 6) & 63, url))
        out.push(__b64_char(v & 63, url))
        i = i + 3
    }
    let rest = n - i
    if rest == 1 {
        let v = (data[i] as u32) << 16
        out.push(__b64_char((v >> 18) & 63, url))
        out.push(__b64_char((v >> 12) & 63, url))
        if !url {
            out.push('=')
            out.push('=')
        }
    } else if rest == 2 {
        let v = ((data[i] as u32) << 16) | ((data[i + 1] as u32) << 8)
        out.push(__b64_char((v >> 18) & 63, url))
        out.push(__b64_char((v >> 12) & 63, url))
        out.push(__b64_char((v >> 6) & 63, url))
        if !url {
            out.push('=')
        }
    }
    out
}

/// The bytes in standard base64 (`+` and `/`), padded with `=` to a multiple of four characters.
///
/// ```
/// let b = BytesMut.from_text("hi")
/// assert_eq(base64_encode(b.as_slice()), String.from("aGk="))
/// ```
fn base64_encode(data: [u8]): String {
    __base64_encode(data, false)
}

/// The bytes in URL-safe base64 (`-` and `_`), without padding.
///
/// ```
/// let b = BytesMut.from_text("hi")
/// assert_eq(base64_url_encode(b.as_slice()), String.from("aGk"))
/// ```
fn base64_url_encode(data: [u8]): String {
    __base64_encode(data, true)
}

priv fn __base64_decode(text: str, url: bool): Result<List<u8>, DecodeError> {
    let mut values = List<u32>.new()
    let mut pad: usize = 0
    let mut index: usize = 0
    for c in text.chars() {
        if c == '=' {
            pad = pad + 1
        } else {
            if pad > 0 {
                return Err(DecodeError.InvalidCharacter { index: index })
            }
            match __b64_value(c, url) {
                Some(v) => {
                    values.push(v)
                }
                None => {
                    return Err(DecodeError.InvalidCharacter { index: index })
                }
            }
        }
        index = index + c.len_utf8()
    }
    let rest = values.len() % 4
    if rest == 1 {
        return Err(DecodeError.InvalidLength)
    }
    let want_pad = (4 - rest) % 4
    // Standard base64 needs its padding; the URL-safe form takes it or leaves it.
    if pad != want_pad && !(url && pad == 0) {
        return Err(DecodeError.InvalidLength)
    }
    let mut out = List<u8>.new()
    let n = values.len()
    let mut i: usize = 0
    while i + 3 < n {
        let v = (values[i] << 18) | (values[i + 1] << 12) | (values[i + 2] << 6) | values[i + 3]
        out.push((v >> 16) as u8)
        out.push((v >> 8) as u8)
        out.push(v as u8)
        i = i + 4
    }
    if rest == 2 {
        let v = (values[i] << 18) | (values[i + 1] << 12)
        out.push((v >> 16) as u8)
    } else if rest == 3 {
        let v = (values[i] << 18) | (values[i + 1] << 12) | (values[i + 2] << 6)
        out.push((v >> 16) as u8)
        out.push((v >> 8) as u8)
    }
    Ok(out)
}

/// The bytes of standard base64 text. The text must be padded to a multiple of four characters
/// (`InvalidLength` otherwise); a character outside the alphabet, or data after the padding, is
/// `InvalidCharacter`.
///
/// ```
/// let bytes = base64_decode("aGk=").unwrap()
/// assert_eq(bytes.to_text(), Ok(String.from("hi")))
/// ```
fn base64_decode(text: str): Result<List<u8>, DecodeError> {
    __base64_decode(text, false)
}

/// The bytes of URL-safe base64 text, with or without its padding.
///
/// ```
/// let bytes = base64_url_decode("aGk").unwrap()
/// assert_eq(bytes.to_text(), Ok(String.from("hi")))
/// ```
fn base64_url_decode(text: str): Result<List<u8>, DecodeError> {
    __base64_decode(text, true)
}

// ---- percent-encoding ----

/// Whether the byte stays as it is in a URL component: `A`-`Z`, `a`-`z`, `0`-`9`, `-`, `.`, `_`, and `~`.
priv fn __is_unreserved(b: u32): bool {
    (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45 || b == 46 || b == 95 || b == 126
}

/// The text with every byte of its UTF-8 form except the unreserved ones written as `%XX` (uppercase hexadecimal).
///
/// ```
/// assert_eq(url_encode("a b/c"), String.from("a%20b%2Fc"))
/// assert_eq(url_encode("x-y_z.~"), String.from("x-y_z.~"))
/// ```
fn url_encode(text: str): String {
    let bytes = text.to_utf8()
    let mut out = String.new()
    let mut i: usize = 0
    while i < bytes.len() {
        let b = bytes[i] as u32
        if __is_unreserved(b) {
            out.push(b as char)
        } else {
            out.push('%')
            out.push(__hex_char(b >> 4, true))
            out.push(__hex_char(b & 15, true))
        }
        i = i + 1
    }
    out
}

/// The text a percent-encoded string stands for. `%XX` is the byte `XX` (either case); every other character
/// stands for itself (`+` is not a space). A `%` not followed by two hexadecimal digits is `InvalidCharacter` or,
/// at the end of the text, `InvalidLength`, and bytes that are not UTF-8 are `InvalidUtf8`.
///
/// ```
/// assert_eq(url_decode("a%20b"), Ok(String.from("a b")))
/// assert_eq(url_decode("a+b"), Ok(String.from("a+b")))
/// ```
fn url_decode(text: str): Result<String, DecodeError> {
    let mut bytes = List<u8>.new()
    let mut pending: usize = 0
    let mut high: u32 = 0
    let mut index: usize = 0
    for c in text.chars() {
        if pending > 0 {
            match __hex_value(c) {
                Some(v) => {
                    if pending == 2 {
                        high = v
                        pending = 1
                    } else {
                        bytes.push(((high << 4) | v) as u8)
                        pending = 0
                    }
                }
                None => {
                    return Err(DecodeError.InvalidCharacter { index: index })
                }
            }
        } else if c == '%' {
            pending = 2
        } else {
            __push_utf8(mut bytes, c)
        }
        index = index + c.len_utf8()
    }
    if pending > 0 {
        return Err(DecodeError.InvalidLength)
    }
    from_utf8(bytes[0..bytes.len()])
}

// ---- conveniences on `List<u8>` ----

/// The bytes as lowercase hexadecimal (`hex_encode`).
///
/// ```
/// assert_eq(BytesMut.from_text("hi").to_list().to_hex(), String.from("6869"))
/// ```
fn List<u8>.to_hex(self): String {
    hex_encode(self[0..self.len()])
}

/// The bytes in standard base64 (`base64_encode`).
///
/// ```
/// assert_eq(BytesMut.from_text("hi").to_list().to_base64(), String.from("aGk="))
/// ```
fn List<u8>.to_base64(self): String {
    base64_encode(self[0..self.len()])
}

/// The bytes in URL-safe base64 (`base64_url_encode`).
///
/// ```
/// assert_eq(BytesMut.from_text("hi").to_list().to_base64_url(), String.from("aGk"))
/// ```
fn List<u8>.to_base64_url(self): String {
    base64_url_encode(self[0..self.len()])
}

/// The text the bytes spell (`from_utf8`).
///
/// ```
/// let text = BytesMut.from_text("hi").to_list().to_text()
/// assert_eq(text, Ok(String.from("hi")))
/// ```
fn List<u8>.to_text(self): Result<String, DecodeError> {
    from_utf8(self[0..self.len()])
}
