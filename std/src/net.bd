// TCP and UDP sockets and host-name resolution (spec/io.md, IO5-IO6).
//
// The calls look blocking: `accept`, `read`, and `send_to` return when they are done. Inside a task they park the
// task while they wait, so the worker runs other tasks; on a thread they block that thread. The compiler primitives
// are non-blocking socket calls and the reactor (`reactor.bd`); this file holds the API, the address type, and the
// error values.
//
// A socket descriptor is an `i64`, because a Windows `SOCKET` is pointer-sized.

use fmt.{Debug, Display, Formatter}
use reactor.{__offload, __wait_io}
use rw.{Read, Write}
use std.{IoError, IoErrorKind}
use time.Duration

/// The event mask the reactor wants: the socket is readable.
priv const READABLE: i32 = 1
/// The event mask the reactor wants: the socket is writable.
priv const WRITABLE: i32 = 2
/// The backlog `bind` gives `listen`.
priv const BACKLOG: i32 = 128
/// How much one socket read asks for at a time.
priv const CHUNK: usize = 4096

/// An IPv4 address and a port.
///
/// ```
/// let a = SocketAddr.new(127, 0, 0, 1, 8080)
/// assert_eq(format("{}", a), String.from("127.0.0.1:8080"))
/// ```
struct SocketAddr: Copy, Clone, Eq, Debug {
    priv ip: u32
    priv port: u16
}

SocketAddr {
    /// The address `a.b.c.d` and a port.
    ///
    /// ```
    /// let a = SocketAddr.new(10, 0, 0, 1, 80)
    /// assert_eq(a.octets().0, 10)
    /// assert_eq(a.to_text(), String.from("10.0.0.1:80"))
    /// ```
    fn new(a: u8, b: u8, c: u8, d: u8, port: u16): SocketAddr {
        SocketAddr { ip: ((a as u32) << 24) | ((b as u32) << 16) | ((c as u32) << 8) | (d as u32), port: port }
    }

    /// The address as one number, `a` in the highest byte.
    ///
    /// ```
    /// assert_eq(SocketAddr.new(1, 2, 3, 4, 5).ip(), 16909060)
    /// ```
    fn ip(self): u32 {
        self.ip
    }

    /// The port number.
    ///
    /// ```
    /// assert_eq(SocketAddr.new(127, 0, 0, 1, 8080).port(), 8080)
    /// ```
    fn port(self): u16 {
        self.port
    }

    /// The four bytes of the address.
    ///
    /// ```
    /// assert_eq(SocketAddr.new(192, 168, 0, 1, 1).octets().0, 192)
    /// ```
    fn octets(self): (u8, u8, u8, u8) {
        ((self.ip >> 24) as u8, (self.ip >> 16) as u8, (self.ip >> 8) as u8, self.ip as u8)
    }

    /// The text `a.b.c.d:port`.
    ///
    /// ```
    /// assert_eq(SocketAddr.new(127, 0, 0, 1, 80).to_text(), String.from("127.0.0.1:80"))
    /// ```
    fn to_text(self): String {
        let (a, b, c, d) = self.octets()
        let mut out = a.to_string()
        out.push('.')
        out.push_str(b.to_string().as_str())
        out.push('.')
        out.push_str(c.to_string().as_str())
        out.push('.')
        out.push_str(d.to_string().as_str())
        out.push(':')
        out.push_str(self.port.to_string().as_str())
        out
    }

    /// Parses a numeric `a.b.c.d:port`. A name is not accepted: `lookup_host` resolves names.
    ///
    /// ```
    /// let a = SocketAddr.parse("10.1.2.3:443").unwrap()
    /// assert_eq(a.port(), 443)
    /// assert(SocketAddr.parse("nope").is_err())
    /// ```
    fn parse(text: str): Result<SocketAddr, IoError> {
        let parsed = match __split_addr(text) {
            Some((host, port)) => match __parse_v4(host) {
                Some(addr) => Some(SocketAddr { ip: addr.ip, port: port }),
                None => None,
            },
            None => None,
        }
        match parsed {
            Some(addr) => Ok(addr),
            None => Err(IoError.Net {
                op: "parse".to_string(),
                addr: text.to_string(),
                kind: IoErrorKind.InvalidInput,
                os_code: None,
            }),
        }
    }
}

SocketAddr: Display {
    fn fmt(self, mut f: Formatter) {
        f.pad_plain(self.to_text().as_str())
    }
}

/// The address bytes of a resolved `sockaddr_in`, packed by the runtime: bits 0-31 the IPv4 address in big-endian
/// order and bits 32-63 the port. `-1` (as an `i64`) is a failure.
priv fn __unpack(packed: u64): Option<SocketAddr> {
    if packed as i64 == -1 {
        return None
    }
    let ip = (packed & 0xffff_ffff) as u32
    let port = (packed >> 32) as u16
    Some(SocketAddr { ip: ip, port: port })
}

/// `a.b.c.d`, with each part 0 to 255.
priv fn __parse_v4(text: str): Option<SocketAddr> {
    let mut octets: [u8; 4] = [0, 0, 0, 0]
    let mut index: usize = 0
    let mut value: u32 = 0
    let mut digits: usize = 0
    for c in text.chars() {
        if c == '.' {
            if digits == 0 || index >= 3 || value > 255 {
                return None
            }
            octets[index] = value as u8
            index = index + 1
            value = 0
            digits = 0
            continue
        }
        let d = c as u32
        if d < 48 || d > 57 || digits >= 3 {
            return None
        }
        value = value * 10 + (d - 48)
        digits = digits + 1
    }
    if digits == 0 || index != 3 || value > 255 {
        return None
    }
    octets[3] = value as u8
    Some(SocketAddr { ip: ((octets[0] as u32) << 24) | ((octets[1] as u32) << 16) | ((octets[2] as u32) << 8) | (octets[3] as u32), port: 0 })
}

/// Splits `host:port` at the last colon. An empty host is the wildcard address for `bind`.
priv fn __split_addr(text: str): Option<(str, u16)> {
    let at = match text.find(':') {
        Some(i) => i,
        None => return None,
    }
    let host = text[0..at]
    let port_text = text[at + 1..text.len()]
    if port_text.len() == 0 {
        return None
    }
    let mut port: u32 = 0
    let mut digits: usize = 0
    for c in port_text.chars() {
        let d = c as u32
        if d < 48 || d > 57 || digits >= 5 {
            return None
        }
        port = port * 10 + (d - 48)
        digits = digits + 1
    }
    if port > 65535 {
        return None
    }
    Some((host, port as u16))
}

/// The error a failed socket call reports. `op` names the call and `addr` the address it used.
priv fn __net_failure(op: str, addr: str): IoError {
    let code = __net_last_error()
    IoError.Net { op: op.to_string(), addr: addr.to_string(), kind: __io_kind(code), os_code: Some(code) }
}

/// The error a check `std` makes itself reports: no system call failed, so there is no code.
priv fn __net_invalid(op: str, addr: str): IoError {
    IoError.Net { op: op.to_string(), addr: addr.to_string(), kind: IoErrorKind.InvalidInput, os_code: None }
}

/// The deadline a timeout starts now, or 0 for "no timeout".
priv fn __deadline(timeout_nanos: u64): u64 {
    if timeout_nanos == 0 {
        0
    } else {
        (__clock(1) as u64) + timeout_nanos
    }
}

/// What is left of `timeout` in nanoseconds; 0 when it has passed (and 0 means "no timeout" only when `deadline`
/// itself is 0).
priv fn __remaining(deadline: u64): u64 {
    if deadline == 0 {
        return 0
    }
    let now = __clock(1) as u64
    if now >= deadline {
        0
    } else {
        deadline - now
    }
}

/// How long a write pauses after a wake that made no room before it waits again. On Windows, `WSAPoll` reports a
/// peer's FIN as a hang-up at once for a write wait, even with a full send buffer, so without this pause a writer
/// would wake and re-register in a tight loop (issue #867). The pause is short, so a real wake-up is at most this late.
priv const WRITE_BACKOFF_NANOS: u64 = 10_000_000

/// Pauses a writer for `WRITE_BACKOFF_NANOS`, or until its deadline if that comes sooner. A deadline that has already
/// passed returns at once, and the next wait reports `TimedOut`.
priv fn __write_backoff(deadline: u64) {
    let mut nanos = WRITE_BACKOFF_NANOS
    if deadline != 0 {
        let remaining = __remaining(deadline)
        if remaining == 0 {
            return
        }
        if remaining < nanos {
            nanos = remaining
        }
    }
    let _ = __wait_io(-1, 0, nanos)
}

/// Waits for a socket event. `0` is ready, `1` timed out, and `-1` is a reactor failure.
priv fn __wait_socket(fd: i64, events: i32, deadline: u64, op: str, addr: str): Result<(), IoError> {
    let remaining = __remaining(deadline)
    if deadline != 0 && remaining == 0 {
        return Err(IoError.Net { op: op.to_string(), addr: addr.to_string(), kind: IoErrorKind.TimedOut, os_code: None })
    }
    match __wait_io(fd, events, remaining) {
        0 => Ok(()),
        1 => Err(IoError.Net {
            op: op.to_string(),
            addr: addr.to_string(),
            kind: IoErrorKind.TimedOut,
            os_code: None,
        }),
        _ => Err(__net_failure(op, addr)),
    }
}

// ---- TCP listeners ----------------------------------------------------------------------------------------------

/// A listening TCP socket. Dropping it closes the socket; `close` does the same and reports the failure.
///
/// ```
/// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
/// let text = listener.local_addr().unwrap().to_text()
/// let client = TcpStream.connect(text.as_str()).unwrap()
/// let (conn, peer) = listener.accept().unwrap()
/// assert_eq(peer.ip(), 2130706433)
/// ```
struct TcpListener {
    priv fd: i64
}

TcpListener {
    /// Binds `host:port`. Port 0 asks the system for a free port, which `local_addr` reports.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// assert(listener.local_addr().unwrap().port() > 0)
    /// ```
    fn bind(addr: str): Result<TcpListener, IoError> {
        match __split_addr(addr) {
            Some((host, port)) => unsafe {
                let fd = __net_socket(1)
                if fd < 0 {
                    return Err(__net_failure("bind", addr))
                }
                if __net_bind(fd, host, port as i32) < 0 {
                    let failure = __net_failure("bind", addr)
                    let _ = __net_close(fd)
                    return Err(failure)
                }
                if __net_listen(fd, BACKLOG) < 0 {
                    let failure = __net_failure("listen", addr)
                    let _ = __net_close(fd)
                    return Err(failure)
                }
                Ok(TcpListener { fd: fd })
            },
            None => Err(__net_invalid("bind", addr)),
        }
    }

    /// Waits for a connection and returns it with its peer's address.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// let text = listener.local_addr().unwrap().to_text()
    /// let client = TcpStream.connect(text.as_str()).unwrap()
    /// let (conn, peer) = listener.accept().unwrap()
    /// assert(peer.port() > 0)
    /// ```
    fn accept(self): Result<(TcpStream, SocketAddr), IoError> {
        let addr = match self.local_addr() {
            Ok(a) => a.to_text(),
            Err(_) => "the listener".to_string(),
        }
        loop {
            unsafe {
                let fd = __net_accept(self.fd)
                if fd >= 0 {
                    let peer = match __unpack(__net_peer_addr(fd)) {
                        Some(a) => a,
                        None => SocketAddr.new(0, 0, 0, 0, 0),
                    }
                    return Ok((TcpStream { fd: fd, read_timeout: 0, write_timeout: 0 }, peer))
                }
                if fd != -1 {
                    return Err(__net_failure("accept", addr.as_str()))
                }
            }
            __wait_socket(self.fd, READABLE, 0, "accept", addr.as_str())?
        }
    }

    /// The address the listener is bound to, with the port the system chose.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// assert_eq(listener.local_addr().unwrap().ip(), 2130706433)
    /// ```
    fn local_addr(self): Result<SocketAddr, IoError> {
        unsafe {
            match __unpack(__net_local_addr(self.fd)) {
                Some(addr) => Ok(addr),
                None => Err(__net_failure("local address", "the listener")),
            }
        }
    }

    /// Closes the socket and reports a failure.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// listener.close().unwrap()
    /// ```
    fn close(own self): Result<(), IoError> {
        let mut me = self
        unsafe {
            if me.fd < 0 {
                return Ok(())
            }
            let outcome = __net_close(me.fd)
            me.fd = -1
            if outcome < 0 {
                Err(__net_failure("close", "the listener"))
            } else {
                Ok(())
            }
        }
    }
}

TcpListener: Drop {
    fn drop(mut self) {
        if self.fd >= 0 {
            unsafe {
                let _ = __net_close(self.fd)
            }
        }
    }
}

// ---- TCP streams ------------------------------------------------------------------------------------------------

/// A connected TCP socket. Dropping it closes the socket; `close` does the same and reports the failure.
///
/// ```
/// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
/// let text = listener.local_addr().unwrap().to_text()
/// let mut client = TcpStream.connect(text.as_str()).unwrap()
/// let accepted = listener.accept().unwrap()
/// let mut server = accepted.0
/// client.write("ping".as_bytes()).unwrap()
/// let mut buf = List<u8>.new()
/// server.read(mut buf, 16).unwrap()
/// assert_eq(buf.len(), 4)
/// ```
struct TcpStream {
    priv fd: i64
    /// Zero for no timeout; otherwise the time one read or write may wait.
    priv read_timeout: u64
    priv write_timeout: u64
}

TcpStream {
    /// Connects to `host:port`, waiting until the connection is established or refused.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// let port = listener.local_addr().unwrap().port()
    /// let client = TcpStream.connect(listener.local_addr().unwrap().to_text().as_str()).unwrap()
    /// assert_eq(client.peer_addr().unwrap().port(), port)
    /// ```
    fn connect(addr: str): Result<TcpStream, IoError> {
        TcpStream.__connect(addr, 0)
    }

    /// Connects like `connect`, but gives up with `IoErrorKind.TimedOut` when the connection is not established
    /// within `timeout`. The connection attempt is abandoned and its socket closed.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// let text = listener.local_addr().unwrap().to_text()
    /// let client = TcpStream.connect_timeout(text.as_str(), Duration.from_secs(5)).unwrap()
    /// assert(client.peer_addr().is_ok())
    /// ```
    fn connect_timeout(addr: str, timeout: Duration): Result<TcpStream, IoError> {
        let mut nanos = timeout.as_nanos()
        if nanos == 0 {
            nanos = 1
        }
        TcpStream.__connect(addr, nanos)
    }

    /// The connection attempt behind `connect` and `connect_timeout`; `timeout_nanos` 0 waits forever.
    priv fn __connect(addr: str, timeout_nanos: u64): Result<TcpStream, IoError> {
        match __split_addr(addr) {
            Some((host, port)) => unsafe {
                let fd = __net_socket(1)
                if fd < 0 {
                    return Err(__net_failure("connect", addr))
                }
                let connected = __net_connect(fd, host, port as i32)
                if connected == 0 {
                    return Ok(TcpStream { fd: fd, read_timeout: 0, write_timeout: 0 })
                }
                if connected != -1 {
                    let failure = __net_failure("connect", addr)
                    let _ = __net_close(fd)
                    return Err(failure)
                }
                // In progress: wait until the socket is writable, then read the pending error.
                match __wait_socket(fd, WRITABLE, __deadline(timeout_nanos), "connect", addr) {
                    Ok(()) => {}
                    Err(failure) => {
                        let _ = __net_close(fd)
                        return Err(failure)
                    }
                }
                let code = __net_error(fd)
                if code != 0 {
                    let _ = __net_close(fd)
                    return Err(IoError.Net {
                        op: "connect".to_string(),
                        addr: addr.to_string(),
                        kind: __io_kind(code),
                        os_code: Some(code),
                    })
                }
                Ok(TcpStream { fd: fd, read_timeout: 0, write_timeout: 0 })
            },
            None => Err(__net_invalid("connect", addr)),
        }
    }

    /// The address of the other end.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// let port = listener.local_addr().unwrap().port()
    /// let client = TcpStream.connect(listener.local_addr().unwrap().to_text().as_str()).unwrap()
    /// assert_eq(client.peer_addr().unwrap().port(), port)
    /// ```
    fn peer_addr(self): Result<SocketAddr, IoError> {
        unsafe {
            match __unpack(__net_peer_addr(self.fd)) {
                Some(addr) => Ok(addr),
                None => Err(__net_failure("peer address", "the socket")),
            }
        }
    }

    /// The address of this end.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// let text = listener.local_addr().unwrap().to_text()
    /// let client = TcpStream.connect(text.as_str()).unwrap()
    /// assert(client.local_addr().unwrap().port() > 0)
    /// ```
    fn local_addr(self): Result<SocketAddr, IoError> {
        unsafe {
            match __unpack(__net_local_addr(self.fd)) {
                Some(addr) => Ok(addr),
                None => Err(__net_failure("local address", "the socket")),
            }
        }
    }

    /// How long one read may wait for bytes; `None` waits forever.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// let text = listener.local_addr().unwrap().to_text()
    /// let mut client = TcpStream.connect(text.as_str()).unwrap()
    /// let accepted = listener.accept().unwrap()
    /// client.set_read_timeout(Some(Duration.from_millis(10)))
    /// let mut buf = List<u8>.new()
    /// match client.read(mut buf, 4) {
    ///     Ok(_) => assert(false),
    ///     Err(e) => assert_eq(e.kind(), IoErrorKind.TimedOut),
    /// }
    /// ```
    fn set_read_timeout(mut self, timeout: Option<Duration>) {
        self.read_timeout = match timeout {
            Some(d) => d.as_nanos(),
            None => 0,
        }
    }

    /// How long one write may wait for room; `None` waits forever.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// let text = listener.local_addr().unwrap().to_text()
    /// let mut client = TcpStream.connect(text.as_str()).unwrap()
    /// client.set_write_timeout(Some(Duration.from_secs(1)))
    /// assert_eq(client.write("x".as_bytes()).unwrap(), 1)
    /// ```
    fn set_write_timeout(mut self, timeout: Option<Duration>) {
        self.write_timeout = match timeout {
            Some(d) => d.as_nanos(),
            None => 0,
        }
    }

    /// Disables Nagle's algorithm when `on` is true.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// let text = listener.local_addr().unwrap().to_text()
    /// let client = TcpStream.connect(text.as_str()).unwrap()
    /// client.set_nodelay(true).unwrap()
    /// ```
    fn set_nodelay(self, on: bool): Result<(), IoError> {
        unsafe {
            if __net_set_nodelay(self.fd, if on { 1 } else { 0 }) < 0 {
                return Err(__net_failure("set nodelay", "the socket"))
            }
            Ok(())
        }
    }

    /// Closes the reading side, the writing side, or both; 1, 2, or 3.
    priv fn __shutdown(mut self, how: i32, op: str): Result<(), IoError> {
        unsafe {
            if __net_shutdown(self.fd, how) < 0 {
                return Err(__net_failure(op, "the socket"))
            }
            Ok(())
        }
    }

    /// Tells the other end that nothing more will be written.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// let text = listener.local_addr().unwrap().to_text()
    /// let mut client = TcpStream.connect(text.as_str()).unwrap()
    /// let accepted = listener.accept().unwrap()
    /// let mut server = accepted.0
    /// client.shutdown_write().unwrap()
    /// let mut buf = List<u8>.new()
    /// assert_eq(server.read(mut buf, 4).unwrap(), 0)
    /// ```
    fn shutdown_write(mut self): Result<(), IoError> {
        self.__shutdown(2, "shutdown")
    }

    /// Tells the other end that nothing more will be read.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// let text = listener.local_addr().unwrap().to_text()
    /// let mut client = TcpStream.connect(text.as_str()).unwrap()
    /// client.shutdown_read().unwrap()
    /// ```
    fn shutdown_read(mut self): Result<(), IoError> {
        self.__shutdown(1, "shutdown")
    }

    /// Closes the socket and reports a failure.
    ///
    /// ```
    /// let listener = TcpListener.bind("127.0.0.1:0").unwrap()
    /// let text = listener.local_addr().unwrap().to_text()
    /// let client = TcpStream.connect(text.as_str()).unwrap()
    /// client.close().unwrap()
    /// ```
    fn close(own self): Result<(), IoError> {
        let mut me = self
        unsafe {
            if me.fd < 0 {
                return Ok(())
            }
            let outcome = __net_close(me.fd)
            me.fd = -1
            if outcome < 0 {
                Err(__net_failure("close", "the socket"))
            } else {
                Ok(())
            }
        }
    }
}

TcpStream: Read {
    /// Appends up to `max` bytes to `buf` and returns how many. Zero is the end of the stream (§`spec/io.md`, IO5).
    fn read(mut self, mut buf: List<u8>, max: usize): Result<usize, IoError> {
        let deadline = __deadline(self.read_timeout)
        loop {
            unsafe {
                let n = __net_recv(self.fd, mut buf, max)
                if n >= 0 {
                    return Ok(n as usize)
                }
                if n != -1 {
                    return Err(__net_failure("read", "the socket"))
                }
            }
            __wait_socket(self.fd, READABLE, deadline, "read", "the socket")?
        }
    }
}

TcpStream: Write {
    /// Writes a prefix of `data` and returns how many bytes the socket took.
    fn write(mut self, data: [u8]): Result<usize, IoError> {
        let deadline = __deadline(self.write_timeout)
        let mut waited = false
        loop {
            unsafe {
                let n = __net_send(self.fd, data)
                if n >= 0 {
                    return Ok(n as usize)
                }
                if n != -1 {
                    return Err(__net_failure("write", "the socket"))
                }
            }
            // A wake that made no room is followed by a short pause (issue #867).
            if waited {
                __write_backoff(deadline)
            }
            __wait_socket(self.fd, WRITABLE, deadline, "write", "the socket")?
            waited = true
        }
    }

    /// The socket writes through to the system, so there is nothing buffered to push out.
    fn flush(mut self): Result<(), IoError> {
        Ok(())
    }
}

TcpStream: Drop {
    fn drop(mut self) {
        if self.fd >= 0 {
            unsafe {
                let _ = __net_close(self.fd)
            }
        }
    }
}

// ---- UDP sockets ------------------------------------------------------------------------------------------------

/// A UDP socket. Dropping it closes the socket; `close` does the same and reports the failure.
///
/// ```
/// let sender = UdpSocket.bind("127.0.0.1:0").unwrap()
/// let mut receiver = UdpSocket.bind("127.0.0.1:0").unwrap()
/// let target = receiver.local_addr().unwrap().to_text()
/// sender.send_to("hi".as_bytes(), target.as_str()).unwrap()
/// let mut buf = List<u8>.new()
/// let (n, from) = receiver.recv_from(mut buf, 16).unwrap()
/// assert_eq(n, 2)
/// ```
struct UdpSocket {
    priv fd: i64
    priv read_timeout: u64
}

UdpSocket {
    /// Binds `host:port`. Port 0 asks the system for a free port.
    ///
    /// ```
    /// let s = UdpSocket.bind("127.0.0.1:0").unwrap()
    /// assert_eq(s.local_addr().unwrap().ip(), 2130706433)
    /// ```
    fn bind(addr: str): Result<UdpSocket, IoError> {
        match __split_addr(addr) {
            Some((host, port)) => unsafe {
                let fd = __net_socket(2)
                if fd < 0 {
                    return Err(__net_failure("bind", addr))
                }
                if __net_bind(fd, host, port as i32) < 0 {
                    let failure = __net_failure("bind", addr)
                    let _ = __net_close(fd)
                    return Err(failure)
                }
                Ok(UdpSocket { fd: fd, read_timeout: 0 })
            },
            None => Err(__net_invalid("bind", addr)),
        }
    }

    /// The address the socket is bound to.
    ///
    /// ```
    /// let s = UdpSocket.bind("127.0.0.1:0").unwrap()
    /// assert(s.local_addr().unwrap().port() > 0)
    /// ```
    fn local_addr(self): Result<SocketAddr, IoError> {
        unsafe {
            match __unpack(__net_local_addr(self.fd)) {
                Some(addr) => Ok(addr),
                None => Err(__net_failure("local address", "the socket")),
            }
        }
    }

    /// How long one receive may wait for a datagram; `None` waits forever.
    ///
    /// ```
    /// let mut s = UdpSocket.bind("127.0.0.1:0").unwrap()
    /// s.set_read_timeout(Some(Duration.from_millis(10)))
    /// let mut buf = List<u8>.new()
    /// match s.recv_from(mut buf, 8) {
    ///     Ok(_) => assert(false),
    ///     Err(e) => assert_eq(e.kind(), IoErrorKind.TimedOut),
    /// }
    /// ```
    fn set_read_timeout(mut self, timeout: Option<Duration>) {
        self.read_timeout = match timeout {
            Some(d) => d.as_nanos(),
            None => 0,
        }
    }

    /// Sends one datagram to `host:port` and returns how many bytes the socket took.
    ///
    /// ```
    /// let sender = UdpSocket.bind("127.0.0.1:0").unwrap()
    /// let receiver = UdpSocket.bind("127.0.0.1:0").unwrap()
    /// let target = receiver.local_addr().unwrap().to_text()
    /// assert_eq(sender.send_to("abc".as_bytes(), target.as_str()).unwrap(), 3)
    /// ```
    fn send_to(self, data: [u8], addr: str): Result<usize, IoError> {
        match __split_addr(addr) {
            Some((host, port)) => unsafe {
                let n = __net_send_to(self.fd, data, host, port as i32)
                if n >= 0 {
                    return Ok(n as usize)
                }
                if n == -1 {
                    return Err(IoError.Net {
                        op: "send".to_string(),
                        addr: addr.to_string(),
                        kind: IoErrorKind.WouldBlock,
                        os_code: None,
                    })
                }
                Err(__net_failure("send", addr))
            },
            None => Err(__net_invalid("send", addr)),
        }
    }

    /// Receives one datagram into `buf` and returns its length and the sender's address.
    ///
    /// ```
    /// let sender = UdpSocket.bind("127.0.0.1:0").unwrap()
    /// let mut receiver = UdpSocket.bind("127.0.0.1:0").unwrap()
    /// let target = receiver.local_addr().unwrap().to_text()
    /// sender.send_to("hi".as_bytes(), target.as_str()).unwrap()
    /// let mut buf = List<u8>.new()
    /// let (n, from) = receiver.recv_from(mut buf, 16).unwrap()
    /// assert_eq(n, 2)
    /// assert_eq(buf.len(), 2)
    /// ```
    fn recv_from(mut self, mut buf: List<u8>, max: usize): Result<(usize, SocketAddr), IoError> {
        let deadline = __deadline(self.read_timeout)
        loop {
            unsafe {
                let n = __net_recv_from(self.fd, mut buf, max)
                if n >= 0 {
                    let peer = match __unpack(__net_last_peer()) {
                        Some(a) => a,
                        None => SocketAddr.new(0, 0, 0, 0, 0),
                    }
                    return Ok((n as usize, peer))
                }
                if n != -1 {
                    return Err(__net_failure("receive", "the socket"))
                }
            }
            __wait_socket(self.fd, READABLE, deadline, "receive", "the socket")?
        }
    }

    /// Closes the socket and reports a failure.
    ///
    /// ```
    /// let s = UdpSocket.bind("127.0.0.1:0").unwrap()
    /// s.close().unwrap()
    /// ```
    fn close(own self): Result<(), IoError> {
        let mut me = self
        unsafe {
            if me.fd < 0 {
                return Ok(())
            }
            let outcome = __net_close(me.fd)
            me.fd = -1
            if outcome < 0 {
                Err(__net_failure("close", "the socket"))
            } else {
                Ok(())
            }
        }
    }
}

UdpSocket: Drop {
    fn drop(mut self) {
        if self.fd >= 0 {
            unsafe {
                let _ = __net_close(self.fd)
            }
        }
    }
}

// ---- name resolution ---------------------------------------------------------------------------------------------

/// Resolves `host` to its IPv4 addresses with `port`. The lookup runs on the helper pool, so a slow resolver parks
/// the task instead of holding a worker (`spec/io.md`, IO6).
///
/// ```
/// let addrs = lookup_host("127.0.0.1", 80).unwrap()
/// assert(addrs.len() > 0)
/// ```
fn lookup_host(host: str, port: u16): Result<List<SocketAddr>, IoError> {
    let text = match __offload(|| __dns_lookup(host)) {
        Ok(text) => text,
        Err(code) => {
            return Err(IoError.Net {
                op: "resolve".to_string(),
                addr: host.to_string(),
                kind: __io_kind(code),
                os_code: Some(code),
            })
        }
    }
    let mut addresses = List<SocketAddr>.new()
    let mut line = String.new()
    for c in text.chars() {
        if c == '\n' {
            let done = line
            line = String.new()
            if done.len() > 0 {
                match __parse_v4(done.as_str()) {
                    Some(addr) => addresses.push(SocketAddr { ip: addr.ip, port: port }),
                    None => {}
                }
            }
            continue
        }
        line.push(c)
    }
    if line.len() > 0 {
        match __parse_v4(line.as_str()) {
            Some(addr) => addresses.push(SocketAddr { ip: addr.ip, port: port }),
            None => {}
        }
    }
    if addresses.len() == 0 {
        return Err(IoError.Net {
            op: "resolve".to_string(),
            addr: host.to_string(),
            kind: IoErrorKind.NotFound,
            os_code: None,
        })
    }
    Ok(addresses)
}
