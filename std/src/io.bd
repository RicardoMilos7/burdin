use reactor.offload
use std.IoError
use rw.{BufRead, Read, Write}

// Files. The bytes come from the compiler's file primitives; the signatures and the error type are Burdin.

/// Reads the whole file at `path` as text.
///
/// ```
/// write_file("burdin-doc-read.txt", "text").unwrap()
/// assert_eq(read_to_string("burdin-doc-read.txt").unwrap(), String.from("text"))
/// remove_file("burdin-doc-read.txt").unwrap()
/// ```
fn read_to_string(path: str): Result<String, IoError> {
    match offload(|| __read_to_string(path)) {
        Result.Ok(text) => Result.Ok(text),
        Result.Err(code) => Result.Err(IoError.Read {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Option.Some(code),
        }),
    }
}

/// Writes `text` to `path`, replacing what was there.
///
/// ```
/// write_file("burdin-doc-write.txt", "hi").unwrap()
/// assert_eq(read_to_string("burdin-doc-write.txt").unwrap(), String.from("hi"))
/// remove_file("burdin-doc-write.txt").unwrap()
/// ```
fn write_file(path: str, text: str): Result<(), IoError> {
    match offload(|| __write_file(path, text)) {
        Result.Ok(_) => Result.Ok(()),
        Result.Err(code) => Result.Err(IoError.Write {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Option.Some(code),
        }),
    }
}

// Streams (issue #410; spec/stdlib.md, "Streams"). A handle is a zero-sized value: the buffering state is the
// runtime's, so every handle to one stream shares the same buffer.

/// The handle to standard output. Its writes share the buffer `print` and `println` use, so their bytes stay in
/// the order the program wrote them.
///
/// ```
/// let mut out = stdout()
/// out.write("ok\n".as_bytes()).unwrap()
/// out.flush().unwrap()
/// ```
struct Stdout { }

/// The handle to standard error. Writes are unbuffered and reach the operating system during the call.
///
/// ```
/// let mut err = stderr()
/// assert_eq(err.write("warning\n".as_bytes()).unwrap(), 8)
/// ```
struct Stderr { }

/// The handle to standard input. The runtime reads it a block at a time.
///
/// ```
/// let mut buf = List<u8>.new()
/// assert_eq(stdin().read(mut buf, 0).unwrap(), 0)
/// ```
struct Stdin { }

/// The handle to standard output.
///
/// ```
/// let mut out = stdout()
/// out.write("hello\n".as_bytes()).unwrap()
/// out.flush().unwrap()
/// ```
fn stdout(): Stdout {
    Stdout { }
}

/// The handle to standard error.
///
/// ```
/// let mut err = stderr()
/// assert_eq(err.write("note\n".as_bytes()).unwrap(), 5)
/// ```
fn stderr(): Stderr {
    Stderr { }
}

/// The handle to standard input.
///
/// ```
/// let mut buf = List<u8>.new()
/// assert_eq(stdin().read(mut buf, 0).unwrap(), 0)
/// ```
fn stdin(): Stdin {
    Stdin { }
}

Stdout {
    /// Whether standard output is a terminal. A pipe or a file is not.
    ///
    /// ```
    /// println("stdout is a terminal: {}", stdout().is_terminal())
    /// ```
    fn is_terminal(self): bool {
        __is_terminal(1)
    }
}

Stdout: Write {
    /// Appends `data` to the standard-output buffer, which `print` and `println` share, so the bytes stay in the
    /// order the program wrote them. They reach the operating system when the buffer fills (or, on a terminal,
    /// after a line), at `flush`, or at a flush point of `print`. All of `data` is taken, and a write error is
    /// ignored, as `print` ignores one.
    fn write(mut self, data: [u8]): Result<usize, IoError> {
        __stdout_write_bytes(data)
        Result.Ok(data.len())
    }

    /// Writes everything the buffer holds now, including what `print` and `println` wrote.
    fn flush(mut self): Result<(), IoError> {
        __stdout_flush()
        Result.Ok(())
    }
}

Stderr {
    /// Whether standard error is a terminal.
    ///
    /// ```
    /// println("stderr is a terminal: {}", stderr().is_terminal())
    /// ```
    fn is_terminal(self): bool {
        __is_terminal(2)
    }
}

Stderr: Write {
    /// Writes `data` unbuffered: the bytes reach the operating system during the call and appear before a later
    /// panic message. All of `data` is taken, and a write error is ignored.
    fn write(mut self, data: [u8]): Result<usize, IoError> {
        __stderr_write_bytes(data)
        Result.Ok(data.len())
    }

    /// Does nothing, because standard error is not buffered.
    fn flush(mut self): Result<(), IoError> {
        Result.Ok(())
    }
}

Stdin {
    /// Whether standard input is a terminal.
    ///
    /// ```
    /// println("stdin is a terminal: {}", stdin().is_terminal())
    /// ```
    fn is_terminal(self): bool {
        __is_terminal(0)
    }
}

Stdin: Read {
    /// Appends up to `max` bytes to `buf`. A read takes what the runtime has buffered, reading one block from the
    /// operating system when the buffer is empty, so it returns as soon as some input is there and never waits for
    /// `max` bytes. `Ok(0)` is the end of the input (or a `max` of 0).
    fn read(mut self, mut buf: List<u8>, max: usize): Result<usize, IoError> {
        if max == 0 {
            return Result.Ok(0)
        }
        let avail = __stdin_avail()
        if avail < 0 {
            let code = __stdin_error()
            return Result.Err(IoError.Read {
                path: String.from("<stdin>"),
                kind: __io_kind(code),
                os_code: Option.Some(code),
            })
        }
        let mut n = avail as usize
        if n > max {
            n = max
        }
        let mut i: usize = 0
        while i < n {
            buf.push(__stdin_next_byte())
            i = i + 1
        }
        Result.Ok(n)
    }

    /// Reads everything left, up to the end of the input. The bytes are not checked for UTF-8, like a file's.
    fn read_to_string(mut self): Result<String, IoError> {
        match __stdin_read_to_string() {
            Result.Ok(text) => Result.Ok(text),
            Result.Err(code) => Result.Err(IoError.Read {
                path: String.from("<stdin>"),
                kind: __io_kind(code),
                os_code: Option.Some(code),
            }),
        }
    }
}

Stdin: BufRead {
    /// Appends bytes to `buf` up to and including the first `delim`, or up to the end of the input.
    fn read_until(mut self, delim: u8, mut buf: List<u8>): Result<usize, IoError> {
        let mut total: usize = 0
        loop {
            let avail = __stdin_avail()
            if avail < 0 {
                let code = __stdin_error()
                return Result.Err(IoError.Read {
                    path: String.from("<stdin>"),
                    kind: __io_kind(code),
                    os_code: Option.Some(code),
                })
            }
            if avail == 0 {
                return Result.Ok(total)
            }
            let mut left = avail as usize
            while left > 0 {
                let b = __stdin_next_byte()
                buf.push(b)
                total = total + 1
                left = left - 1
                if b == delim {
                    return Result.Ok(total)
                }
            }
        }
    }

    /// Reads one line without its terminator (a `\n`, or the `\r` of a `\r\n`). `Ok(None)` is the end of the
    /// input; the last line may have no terminator. The bytes are not checked for UTF-8, like a file's.
    fn read_line(mut self): Result<Option<String>, IoError> {
        match __stdin_read_line() {
            Result.Ok(line) => Result.Ok(line),
            Result.Err(code) => Result.Err(IoError.Read {
                path: String.from("<stdin>"),
                kind: __io_kind(code),
                os_code: Option.Some(code),
            }),
        }
    }
}
