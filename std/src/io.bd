use std.IoError

// Files. The bytes come from the compiler's file primitives; the signatures and the error type are Burdin.

/// Reads the whole file at `path` as text.
fn read_to_string(path: str): Result<String, IoError> {
    match __read_to_string(path) {
        Ok(text) => Ok(text),
        Err(_) => Err(IoError.Read { path: path.to_string() }),
    }
}

/// Writes `text` to `path`, replacing what was there.
fn write_file(path: str, text: str): Result<(), IoError> {
    match __write_file(path, text) {
        Ok(_) => Ok(()),
        Err(_) => Err(IoError.Write { path: path.to_string() }),
    }
}

// Streams (issue #410; spec/stdlib.md, "Streams"). A handle is a zero-sized value: the buffering state is the
// runtime's, so every handle to one stream shares the same buffer.

/// The handle to standard output. Its writes share the buffer `print` and `println` use, so their bytes stay in
/// the order the program wrote them.
struct Stdout { }

/// The handle to standard error. Writes are unbuffered and reach the operating system during the call.
struct Stderr { }

/// The handle to standard input. The runtime reads it a block at a time.
struct Stdin { }

/// The handle to standard output.
fn stdout(): Stdout {
    Stdout { }
}

/// The handle to standard error.
fn stderr(): Stderr {
    Stderr { }
}

/// The handle to standard input.
fn stdin(): Stdin {
    Stdin { }
}

Stdout {
    /// Writes `text` exactly as it is. The bytes join the standard-output buffer; they reach the operating system
    /// when the buffer fills (or reaches a line end on a terminal), at `flush`, or at a flush point of `print`.
    fn write(self, text: str) {
        __stdout_write(text)
    }

    /// Writes `text` followed by one `\n`. On a terminal the buffer is flushed after the newline.
    fn write_line(self, text: str) {
        __stdout_write_line(text)
    }

    /// Writes everything the buffer holds now, including what `print` and `println` wrote.
    fn flush(self) {
        __stdout_flush()
    }

    /// Whether standard output is a terminal. A pipe or a file is not.
    fn is_terminal(self): bool {
        __is_terminal(1)
    }
}

Stderr {
    /// Writes `text` exactly as it is. Standard error is unbuffered, so the bytes reach the operating system
    /// during the call and appear before a later panic message.
    fn write(self, text: str) {
        __stderr_write(text)
    }

    /// Writes `text` followed by one `\n`, unbuffered.
    fn write_line(self, text: str) {
        __stderr_write_line(text)
    }

    /// Does nothing, because standard error is not buffered. It exists so the two output handles are used alike.
    fn flush(self) {
    }

    /// Whether standard error is a terminal.
    fn is_terminal(self): bool {
        __is_terminal(2)
    }
}

Stdin {
    /// Reads one line without its terminator (`\n`, or the `\r` of a `\r\n`). `Ok(None)` is the end of the input;
    /// the last line may have no terminator. The bytes are not checked for UTF-8, like a file's.
    fn read_line(self): Result<Option<String>, IoError> {
        match __stdin_read_line() {
            Ok(line) => Ok(line),
            Err(_) => Err(IoError.Read { path: String.from("<stdin>") }),
        }
    }

    /// Reads everything left, up to the end of the input.
    fn read_to_string(self): Result<String, IoError> {
        match __stdin_read_to_string() {
            Ok(text) => Ok(text),
            Err(_) => Err(IoError.Read { path: String.from("<stdin>") }),
        }
    }

    /// Whether standard input is a terminal.
    fn is_terminal(self): bool {
        __is_terminal(0)
    }
}
