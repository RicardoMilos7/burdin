// The iteration protocol (spec/iterators.md).
//
// `Iterator<T>` is the stateful object a chain is made of: `next` advances it and returns its next item.
// `Iterable<T>` is a marker: a type implements it to say that `for` accepts it, and the compiler checks that the
// type provides `iter(self)` (borrowing) and, when it is used, `into_iter(own self)` (consuming) returning an
// `Iterator<T>`. The built-in collections implement both in the compiler; these declarations give user types the
// same surface, with the lazy adapters written here as default methods.
//
use cmp.Ordering
use option.take

// A lazy chain borrows its source: its iterator types carry the source's view type, so a chain is second-class
// (memory-rules SC2/SC3) and cannot be stored in a field or a collection.

/// A stateful iterator. `next` borrows the iterator exclusively and advances it.
///
/// ```
/// fn sum_all<I: Iterator<i32>>(mut iter: I): i32 {
///     iter.fold(0, |acc, x| acc + x)
/// }
/// let mut it = [1, 2, 3].into_iter()
/// assert_eq(sum_all(mut it), 6)
/// ```
interface Iterator<T> {
    /// The next item, or `None` when the iterator is exhausted.
    ///
    /// ```
    /// let mut it = [7].into_iter()
    /// assert_eq(it.next(), Option.Some(7))
    /// assert(it.next().is_none())
    /// ```
    fn next(mut self): Option<T>

    /// A lazy chain that applies `f` to every item. `f` receives each item itself, not a view; call `to_list()` or
    /// `collect()` when an eager collection is wanted.
    ///
    /// ```
    /// assert_eq([1, 2].into_iter().map(|x| x * 3).count(), 2)
    /// ```
    fn map<U, F: FnMut(T): U>(own self, own f: F): MapIter<Self, T, U, F> {
        MapIter { inner: self, f: f }
    }

    /// A lazy chain that keeps the items `f` accepts. `f` receives a view so the item can still be returned, and
    /// the chain never clones; for owned items from a chain of views, use `cloned()` before `to_list()`.
    ///
    /// ```
    /// assert_eq([1, 2, 3, 4].into_iter().filter(|x| *x > 2).count(), 2)
    /// ```
    fn filter<F: FnMut(&T): bool>(own self, own f: F): FilterIter<Self, T, F> {
        FilterIter { inner: self, f: f }
    }

    /// A lazy chain of at most `count` items.
    ///
    /// ```
    /// assert_eq([1, 2, 3].into_iter().take(2).count(), 2)
    /// ```
    fn take(own self, count: usize): TakeIter<Self, T> {
        TakeIter { inner: self, remaining: count }
    }

    /// A lazy chain that drops the first `count` items.
    ///
    /// ```
    /// assert_eq([1, 2, 3].into_iter().skip(2).count(), 1)
    /// ```
    fn skip(own self, count: usize): SkipIter<Self, T> {
        SkipIter { inner: self, remaining: count }
    }

    /// A lazy chain of `(index, item)` pairs, counting from 0.
    ///
    /// ```
    /// assert_eq(['a'].into_iter().enumerate().count(), 1)
    /// ```
    fn enumerate(own self): EnumerateIter<Self, T> {
        EnumerateIter { inner: self, index: 0 }
    }

    /// A lazy chain of pairs, one item from this iterator and one from `other`, ending when either one ends.
    ///
    /// ```
    /// assert_eq([1, 2].into_iter().zip([3, 4].into_iter()).count(), 2)
    /// ```
    fn zip<U, J: Iterator<U>>(own self, own other: J): ZipIter<Self, T, J, U> {
        ZipIter { first: self, second: other }
    }

    /// A lazy chain of this iterator's items followed by the items of `other`.
    ///
    /// ```
    /// assert_eq([1].into_iter().chain([2].into_iter()).count(), 2)
    /// ```
    fn chain<J: Iterator<T>>(own self, own other: J): ChainIter<Self, J, T> {
        ChainIter { first: self, second: other, first_done: false }
    }

    /// A lazy chain of the items of the iterators `f` returns for each item, one after another.
    ///
    /// ```
    /// assert_eq([1, 2].into_iter().flat_map(|x| [x, x].into_iter()).count(), 4)
    /// ```
    fn flat_map<U, J: Iterator<U>, F: FnMut(T): J>(own self, own f: F): FlatMapIter<Self, T, J, U, F> {
        let current: Option<J> = Option.None
        FlatMapIter { inner: self, f: f, current: current }
    }

    /// A lazy chain of the items up to, not including, the first one `f` rejects.
    ///
    /// ```
    /// assert_eq([1, 2, 3, 1].into_iter().take_while(|x| *x < 3).count(), 2)
    /// ```
    fn take_while<F: FnMut(&T): bool>(own self, own f: F): TakeWhileIter<Self, T, F> {
        TakeWhileIter { inner: self, f: f, done: false }
    }

    /// A lazy chain that drops items while `f` accepts them, then yields the rest.
    ///
    /// ```
    /// assert_eq([1, 2, 3, 1].into_iter().skip_while(|x| *x < 2).count(), 3)
    /// ```
    fn skip_while<F: FnMut(&T): bool>(own self, own f: F): SkipWhileIter<Self, T, F> {
        SkipWhileIter { inner: self, f: f, skipping: true }
    }

    /// A lazy chain that applies `f` and stops at the first `None` it returns.
    ///
    /// ```
    /// let v = [1, 2, 0, 4].into_iter().map_while(|x| if x > 0 { Option.Some(x) } else { Option.None }).to_list()
    /// assert_eq(v.len(), 2)
    /// ```
    fn map_while<U, F: FnMut(T): Option<U>>(own self, own f: F): MapWhileIter<Self, T, U, F> {
        MapWhileIter { inner: self, f: f, done: false }
    }

    /// A lazy chain of every `step`th item, starting with the first. A `step` of 0 panics.
    ///
    /// ```
    /// assert_eq([1, 2, 3, 4].into_iter().step_by(2).count(), 2)
    /// ```
    fn step_by(own self, step: usize): StepByIter<Self, T> {
        if step == 0 {
            panic("step_by: the step is 0")
        }
        StepByIter { inner: self, step: step, first: true }
    }

    /// A lazy chain that calls `f` on a view of each item and passes the item on.
    ///
    /// ```
    /// let mut total = 0
    /// let kept = [1, 2].into_iter().inspect(|x| total = total + *x).to_list()
    /// assert_eq(kept.len(), 2)
    /// assert_eq(total, 3)
    /// ```
    fn inspect<F: FnMut(&T)>(own self, own f: F): InspectIter<Self, T, F> {
        InspectIter { inner: self, f: f }
    }

    /// A lazy chain whose next item can be looked at with `peek` before it is taken.
    ///
    /// ```
    /// let mut it = [1].into_iter().peekable()
    /// assert(it.peek().is_some())
    /// ```
    fn peekable(own self): PeekIter<Self, T> {
        PeekIter { inner: self, buffer: List<T>.new(), looked: false }
    }

    /// Folds the items into an accumulator, left to right.
    ///
    /// ```
    /// assert_eq([1, 2, 3].into_iter().fold(10, |acc, x| acc + x), 16)
    /// ```
    fn fold<A, F: FnMut(A, T): A>(mut self, own init: A, own f: F): A {
        let mut acc = init
        let mut f = f
        loop {
            match self.next() {
                Option.Some(x) => {
                    acc = f(acc, x)
                }
                Option.None => {
                    return acc
                }
            }
        }
    }

    /// The number of items left.
    ///
    /// ```
    /// assert_eq([1, 2, 3].into_iter().count(), 3)
    /// ```
    fn count(mut self): usize {
        let mut n: usize = 0
        loop {
            match self.next() {
                Option.Some(_) => {
                    n = n + 1
                }
                Option.None => {
                    return n
                }
            }
        }
    }

    /// Whether `f` accepts any item. Stops at the first one it does.
    ///
    /// ```
    /// assert([1, 2].into_iter().any(|x| x == 2))
    /// ```
    fn any<F: FnMut(T): bool>(mut self, own f: F): bool {
        let mut f = f
        loop {
            match self.next() {
                Option.Some(x) => {
                    if f(x) {
                        return true
                    }
                }
                Option.None => {
                    return false
                }
            }
        }
    }

    /// Whether `f` accepts every item. Stops at the first one it does not.
    ///
    /// ```
    /// assert([2, 4].into_iter().all(|x| x % 2 == 0))
    /// ```
    fn all<F: FnMut(T): bool>(mut self, own f: F): bool {
        let mut f = f
        loop {
            match self.next() {
                Option.Some(x) => {
                    if !f(x) {
                        return false
                    }
                }
                Option.None => {
                    return true
                }
            }
        }
    }

    /// The first item `f` accepts, without cloning.
    ///
    /// ```
    /// assert_eq([5, 6, 7].into_iter().find(|x| *x > 5), Option.Some(6))
    /// ```
    fn find<F: FnMut(&T): bool>(mut self, own f: F): Option<T> {
        let mut f = f
        loop {
            match self.next() {
                Option.Some(x) => {
                    if f(&x) {
                        return Option.Some(x)
                    }
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }

    /// The last item, or `None` when the iterator is empty.
    ///
    /// ```
    /// assert_eq([5, 6, 7].into_iter().last(), Option.Some(7))
    /// ```
    fn last(mut self): Option<T> {
        let mut result: Option<T> = Option.None
        loop {
            match self.next() {
                Option.Some(x) => {
                    result = Option.Some(x)
                }
                Option.None => {
                    return result
                }
            }
        }
    }

    /// The item `n` places on (counting from 0), or `None` when the iterator is shorter; it consumes the items before.
    ///
    /// ```
    /// assert_eq([5, 6, 7].into_iter().nth(1), Option.Some(6))
    /// assert(([5].into_iter()).nth(3).is_none())
    /// ```
    fn nth(mut self, n: usize): Option<T> {
        let mut left = n
        loop {
            match self.next() {
                Option.Some(x) => {
                    if left == 0 {
                        return Option.Some(x)
                    }
                    left = left - 1
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }

    /// The index of the first item `f` accepts.
    ///
    /// ```
    /// assert_eq([5, 6, 7].into_iter().position(|x| x == 6), Option.Some(1))
    /// ```
    fn position<F: FnMut(T): bool>(mut self, own f: F): Option<usize> {
        let mut f = f
        let mut i: usize = 0
        loop {
            match self.next() {
                Option.Some(x) => {
                    if f(x) {
                        return Option.Some(i)
                    }
                    i = i + 1
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }

    /// Calls `f` on every item.
    ///
    /// ```
    /// let mut total = 0
    /// [1, 2, 3].into_iter().for_each(|x| total = total + x)
    /// assert_eq(total, 6)
    /// ```
    fn for_each<F: FnMut(T)>(mut self, own f: F) {
        let mut f = f
        loop {
            match self.next() {
                Option.Some(x) => {
                    f(x)
                }
                Option.None => {
                    return
                }
            }
        }
    }

    /// Combines the items into one with `f`, left to right; `None` when the iterator is empty.
    ///
    /// ```
    /// assert_eq([1, 2, 3].into_iter().reduce(|a, b| a + b), Option.Some(6))
    /// ```
    fn reduce<F: FnMut(T, T): T>(mut self, own f: F): Option<T> {
        let mut f = f
        match self.next() {
            Option.Some(first) => {
                let mut acc = first
                loop {
                    match self.next() {
                        Option.Some(x) => {
                            acc = f(acc, x)
                        }
                        Option.None => {
                            return Option.Some(acc)
                        }
                    }
                }
            }
            Option.None => Option.None,
        }
    }

    /// Splits the items into the ones `f` accepts and the ones it rejects, keeping their order.
    ///
    /// ```
    /// let (even, odd) = [1, 2, 3, 4].into_iter().partition(|x| *x % 2 == 0)
    /// assert_eq(even.len(), 2)
    /// assert_eq(odd.len(), 2)
    /// ```
    fn partition<F: FnMut(&T): bool>(mut self, own f: F): (List<T>, List<T>) {
        let mut f = f
        let mut yes = List<T>.new()
        let mut no = List<T>.new()
        loop {
            match self.next() {
                Option.Some(x) => {
                    if accepts(mut f, x) {
                        yes.push(x)
                    } else {
                        no.push(x)
                    }
                }
                Option.None => {
                    return (yes, no)
                }
            }
        }
    }

    /// The least item under the comparator `f`; the first of equal items. `None` when the iterator is empty.
    ///
    /// ```
    /// assert_eq([1, 3, 2].into_iter().min_by(|a, b| (*a).cmp(*b)), Option.Some(1))
    /// ```
    fn min_by<F: FnMut(&T, &T): Ordering>(mut self, own f: F): Option<T> {
        let mut f = f
        match self.next() {
            Option.Some(first) => {
                let mut best = first
                loop {
                    match self.next() {
                        Option.Some(x) => {
                            if is_less(mut f, x, best) {
                                best = x
                            }
                        }
                        Option.None => {
                            return Option.Some(best)
                        }
                    }
                }
            }
            Option.None => Option.None,
        }
    }

    /// The greatest item under the comparator `f`; the last of equal items. `None` when the iterator is empty.
    ///
    /// ```
    /// assert_eq([1, 3, 2].into_iter().max_by(|a, b| (*a).cmp(*b)), Option.Some(3))
    /// ```
    fn max_by<F: FnMut(&T, &T): Ordering>(mut self, own f: F): Option<T> {
        let mut f = f
        match self.next() {
            Option.Some(first) => {
                let mut best = first
                loop {
                    match self.next() {
                        Option.Some(x) => {
                            if !is_less(mut f, x, best) {
                                best = x
                            }
                        }
                        Option.None => {
                            return Option.Some(best)
                        }
                    }
                }
            }
            Option.None => Option.None,
        }
    }

    /// The item with the least key; the first of equal ones. `None` when the iterator is empty.
    ///
    /// ```
    /// assert_eq([1, -5, 3].into_iter().min_by_key(|x| (*x).abs()), Option.Some(1))
    /// ```
    fn min_by_key<K: Ord, F: FnMut(&T): K>(mut self, own f: F): Option<T> {
        let mut f = f
        match self.next() {
            Option.Some(first) => {
                let mut best_key = f(&first)
                let mut best = first
                loop {
                    match self.next() {
                        Option.Some(x) => {
                            let k = f(&x)
                            if k.cmp(best_key).is_lt() {
                                best = x
                                best_key = k
                            }
                        }
                        Option.None => {
                            return Option.Some(best)
                        }
                    }
                }
            }
            Option.None => Option.None,
        }
    }

    /// The item with the greatest key; the last of equal ones. `None` when the iterator is empty.
    ///
    /// ```
    /// assert_eq([1, -5, 3].into_iter().max_by_key(|x| (*x).abs()), Option.Some(-5))
    /// ```
    fn max_by_key<K: Ord, F: FnMut(&T): K>(mut self, own f: F): Option<T> {
        let mut f = f
        match self.next() {
            Option.Some(first) => {
                let mut best_key = f(&first)
                let mut best = first
                loop {
                    match self.next() {
                        Option.Some(x) => {
                            let k = f(&x)
                            if !k.cmp(best_key).is_lt() {
                                best = x
                                best_key = k
                            }
                        }
                        Option.None => {
                            return Option.Some(best)
                        }
                    }
                }
            }
            Option.None => Option.None,
        }
    }

    /// Folds the items like `fold`, but `f` returns a `Result` and the first `Err` ends the fold and is returned.
    ///
    /// ```
    /// fn add_checked(acc: i32, x: i32): Result<i32, String> {
    ///     Result.Ok(acc + x)
    /// }
    /// let r: Result<i32, String> = [1, 2, 3].into_iter().try_fold(0, add_checked)
    /// assert_eq(r.unwrap(), 6)
    /// ```
    fn try_fold<A, E, F: FnMut(A, T): Result<A, E>>(mut self, own init: A, own f: F): Result<A, E> {
        let mut acc = init
        let mut f = f
        loop {
            match self.next() {
                Option.Some(x) => {
                    match f(acc, x) {
                        Result.Ok(next) => {
                            acc = next
                        }
                        Result.Err(e) => {
                            return Result.Err(e)
                        }
                    }
                }
                Option.None => {
                    return Result.Ok(acc)
                }
            }
        }
    }

    /// Calls `f` on every item, stopping at the first `Err` and returning it.
    ///
    /// ```
    /// fn check_small(x: i32): Result<(), String> {
    ///     if x < 5 {
    ///         Result.Ok(())
    ///     } else {
    ///         Result.Err(String.from("big"))
    ///     }
    /// }
    /// let r: Result<(), String> = [1, 2].into_iter().try_for_each(check_small)
    /// assert(r.is_ok())
    /// ```
    fn try_for_each<E, F: FnMut(T): Result<(), E>>(mut self, own f: F): Result<(), E> {
        let mut f = f
        loop {
            match self.next() {
                Option.Some(x) => {
                    match f(x) {
                        Result.Ok(_) => {}
                        Result.Err(e) => {
                            return Result.Err(e)
                        }
                    }
                }
                Option.None => {
                    return Result.Ok(())
                }
            }
        }
    }

    /// Collects the remaining items into the collection the context asks for: `let names: Set<String> =
    /// it.collect()`. The target type comes from the expected type (the annotation, the parameter, or the return
    /// type), and any type that implements `FromIterator<T>` can be a target (spec/iterators.md, IT17).
    ///
    /// ```
    /// let s: Set<i32> = [1, 2, 2].into_iter().collect()
    /// assert_eq(s.len(), 2)
    /// ```
    fn collect<C: FromIterator<T>>(own self): C {
        C.from_iter(self)
    }

    /// Collects the remaining items into a list. A chain over borrowed items produces a second-class list of
    /// views, which cannot be stored; clone the items first to get an owned list. This is how a lazy chain gives
    /// an eager list: `xs.map(f).to_list()` (`spec/iterators.md`, IT10).
    ///
    /// ```
    /// let xs = [1, 2].into_iter().to_list()
    /// assert_eq(xs.len(), 2)
    /// ```
    fn to_list(mut self): List<T> {
        let mut out: List<T> = List<T>.new()
        loop {
            match self.next() {
                Option.Some(x) => {
                    out.push(x)
                }
                Option.None => {
                    return out
                }
            }
        }
    }
}

/// `it.min()`: the least item; the first of equal items. `None` when the iterator is empty. The compiler supplies `T`.
priv fn iter_min<T: Ord, I: Iterator<T>>(own it: I): Option<T> {
    let mut it = it
    match it.next() {
        Option.Some(first) => {
            let mut best = first
            loop {
                match it.next() {
                    Option.Some(x) => {
                        if x.cmp(best).is_lt() {
                            best = x
                        }
                    }
                    Option.None => {
                        return Option.Some(best)
                    }
                }
            }
        }
        Option.None => Option.None,
    }
}

/// `it.max()`: the greatest item; the last of equal items. `None` when the iterator is empty.
priv fn iter_max<T: Ord, I: Iterator<T>>(own it: I): Option<T> {
    let mut it = it
    match it.next() {
        Option.Some(first) => {
            let mut best = first
            loop {
                match it.next() {
                    Option.Some(x) => {
                        if !x.cmp(best).is_lt() {
                            best = x
                        }
                    }
                    Option.None => {
                        return Option.Some(best)
                    }
                }
            }
        }
        Option.None => Option.None,
    }
}

/// `a.eq(b)`: whether both iterators yield equal items and end together.
priv fn iter_eq<T: Eq, I: Iterator<T>, J: Iterator<T>>(own a: I, own b: J): bool {
    let mut a = a
    let mut b = b
    loop {
        match a.next() {
            Option.Some(x) => {
                match b.next() {
                    Option.Some(y) => {
                        if x != y {
                            return false
                        }
                    }
                    Option.None => {
                        return false
                    }
                }
            }
            Option.None => {
                return b.next().is_none()
            }
        }
    }
}

/// `a.cmp(b)`: compares item by item; the shorter iterator is less when it is a prefix of the other.
priv fn iter_cmp<T: Ord, I: Iterator<T>, J: Iterator<T>>(own a: I, own b: J): Ordering {
    let mut a = a
    let mut b = b
    loop {
        match a.next() {
            Option.Some(x) => {
                match b.next() {
                    Option.Some(y) => {
                        let order = x.cmp(y)
                        if !order.is_eq() {
                            return order
                        }
                    }
                    Option.None => {
                        return Ordering.Greater
                    }
                }
            }
            Option.None => {
                if b.next().is_none() {
                    return Ordering.Equal
                }
                return Ordering.Less
            }
        }
    }
}

/// Whether the comparator `f` puts `a` strictly before `b`. The items are plain (borrowed) parameters, so the views
/// handed to `f` end with the call and the caller can still move the items.
priv fn is_less<T, F: FnMut(&T, &T): Ordering>(mut f: F, a: T, b: T): bool {
    f(&a, &b).is_lt()
}

/// Whether the predicate `f` accepts `x`. `x` is a plain (borrowed) parameter, so the view handed to `f` ends with the
/// call and the caller can still move `x`.
priv fn accepts<T, F: FnMut(&T): bool>(mut f: F, x: T): bool {
    f(&x)
}

/// An iterator that can also take items from its back. `rev` walks such an iterator backwards. The built-in
/// slice and range iterators implement it (spec/iterators.md, IT14).
///
/// ```
/// let xs = [1, 2, 3]
/// let mut it = xs.iter()
/// assert_eq(it.next().unwrap(), 1)
/// assert_eq(it.next_back().unwrap(), 3)
/// ```
interface DoubleEndedIterator<T> {
    /// The last item, or `None` when the iterator is exhausted.
    ///
    /// ```
    /// let xs = [1, 2, 3]
    /// let mut it = xs.iter()
    /// assert_eq(it.next_back().unwrap(), 3)
    /// ```
    fn next_back(mut self): Option<T>
}

/// A collection that `for` can iterate through `iter(self)`.
///
/// ```
/// let mut total = 0
/// for x in [1, 2, 3] {
///     total = total + x
/// }
/// assert_eq(total, 6)
/// ```
interface Iterable<T> {
}

/// A type that can be built from the items of an iterator. `Iterator.collect` calls `from_iter`; the built-in
/// `List`, `Map`, `String`, `Option`, and `Result` implement it in the compiler (spec/iterators.md, IT16).
///
/// ```
/// let s: Set<i32> = [3, 3].into_iter().collect()
/// assert_eq(s.len(), 1)
/// ```
interface FromIterator<T> {
    /// Builds the collection from every item `iter` yields, in order.
    ///
    /// ```
    /// let s = Set<i32>.from_iter([1, 1, 2].into_iter())
    /// assert_eq(s.len(), 2)
    /// ```
    fn from_iter<I: Iterator<T>>(own iter: I): Self
}

/// The lazy `map` chain: `inner` and the closure.
///
/// ```
/// let tripled = [1, 2].into_iter().map(|x| x * 3).to_list()
/// assert_eq(tripled[1], 6)
/// ```
struct MapIter<I, T, U, F: FnMut(T): U> {
    inner: I
    f: F
}

MapIter<I, T, U, F>: Iterator<U> where I: Iterator<T>, F: FnMut(T): U {
    fn next(mut self): Option<U> {
        match self.inner.next() {
            Option.Some(x) => Option.Some(self.f(x)),
            Option.None => Option.None,
        }
    }
}

/// The lazy `filter` chain.
///
/// ```
/// let evens = [1, 2, 3, 4].into_iter().filter(|x| *x % 2 == 0).to_list()
/// assert_eq(evens.len(), 2)
/// ```
struct FilterIter<I, T, F: FnMut(&T): bool> {
    inner: I
    f: F
}

FilterIter<I, T, F>: Iterator<T> where I: Iterator<T>, F: FnMut(&T): bool {
    fn next(mut self): Option<T> {
        loop {
            match self.inner.next() {
                Option.Some(x) => {
                    if self.f(&x) {
                        return Option.Some(x)
                    }
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
}

/// The lazy `take` chain.
///
/// ```
/// let head = [1, 2, 3].into_iter().take(2).to_list()
/// assert_eq(head.len(), 2)
/// ```
struct TakeIter<I, T>: Clone {
    inner: I
    remaining: usize
}

TakeIter<I, T>: Iterator<T> where I: Iterator<T> {
    fn next(mut self): Option<T> {
        if self.remaining == 0 {
            return Option.None
        }
        self.remaining = self.remaining - 1
        self.inner.next()
    }
}

/// The lazy `skip` chain.
///
/// ```
/// let rest = [1, 2, 3].into_iter().skip(1).to_list()
/// assert_eq(rest[0], 2)
/// ```
struct SkipIter<I, T>: Clone {
    inner: I
    remaining: usize
}

SkipIter<I, T>: Iterator<T> where I: Iterator<T> {
    fn next(mut self): Option<T> {
        loop {
            if self.remaining == 0 {
                return self.inner.next()
            }
            self.remaining = self.remaining - 1
            match self.inner.next() {
                Option.Some(_) => {}
                Option.None => {
                    return Option.None
                }
            }
        }
    }
}

/// The lazy `enumerate` chain.
///
/// ```
/// let pairs = ['a', 'b'].into_iter().enumerate().to_list()
/// assert_eq(pairs[1].0, 1)
/// assert_eq(pairs[1].1, 'b')
/// ```
struct EnumerateIter<I, T>: Clone {
    inner: I
    index: usize
}

EnumerateIter<I, T>: Iterator<(usize, T)> where I: Iterator<T> {
    fn next(mut self): Option<(usize, T)> {
        match self.inner.next() {
            Option.Some(x) => {
                let i = self.index
                self.index = self.index + 1
                Option.Some((i, x))
            }
            Option.None => Option.None,
        }
    }
}

/// The lazy `zip` chain.
///
/// ```
/// let pairs = [1, 2].into_iter().zip(['a', 'b'].into_iter()).to_list()
/// assert_eq(pairs[1].0, 2)
/// assert_eq(pairs[1].1, 'b')
/// ```
struct ZipIter<I, T, J, U>: Clone {
    first: I
    second: J
}

ZipIter<I, T, J, U>: Iterator<(T, U)> where I: Iterator<T>, J: Iterator<U> {
    fn next(mut self): Option<(T, U)> {
        match self.first.next() {
            Option.Some(x) => {
                match self.second.next() {
                    Option.Some(y) => Option.Some((x, y)),
                    Option.None => Option.None,
                }
            }
            Option.None => Option.None,
        }
    }
}

/// The lazy `chain` chain.
///
/// ```
/// let all = [1].into_iter().chain([2, 3].into_iter()).to_list()
/// assert_eq(all.len(), 3)
/// ```
struct ChainIter<I, J, T>: Clone {
    first: I
    second: J
    first_done: bool
}

ChainIter<I, J, T>: Iterator<T> where I: Iterator<T>, J: Iterator<T> {
    fn next(mut self): Option<T> {
        if !self.first_done {
            match self.first.next() {
                Option.Some(x) => {
                    return Option.Some(x)
                }
                Option.None => {
                    self.first_done = true
                }
            }
        }
        self.second.next()
    }
}

/// The lazy `flat_map` chain: `current` is the inner iterator being drained, if any.
///
/// ```
/// let pairs = [1, 2].into_iter().flat_map(|x| [x, x * 10].into_iter()).to_list()
/// assert_eq(pairs.len(), 4)
/// assert_eq(pairs[3], 20)
/// ```
struct FlatMapIter<I, T, J, U, F: FnMut(T): J> {
    inner: I
    f: F
    current: Option<J>
}

FlatMapIter<I, T, J, U, F>: Iterator<U> where I: Iterator<T>, J: Iterator<U>, F: FnMut(T): J {
    fn next(mut self): Option<U> {
        loop {
            match self.current.take() {
                Option.Some(it) => {
                    let mut it = it
                    match it.next() {
                        Option.Some(x) => {
                            self.current = Option.Some(it)
                            return Option.Some(x)
                        }
                        Option.None => {}
                    }
                }
                Option.None => {
                    match self.inner.next() {
                        Option.Some(x) => {
                            self.current = Option.Some(self.f(x))
                        }
                        Option.None => {
                            return Option.None
                        }
                    }
                }
            }
        }
    }
}

/// The lazy `flatten` chain: `current` is the inner iterator being drained, if any.
///
/// ```
/// let mut total = 0
/// for x in (0..3).iter().map(|k| (0..k).iter()).flatten() {
///     total = total + x
/// }
/// assert_eq(total, 1)
/// ```
struct FlattenIter<I, J, U>: Clone {
    inner: I
    current: Option<J>
}

FlattenIter<I, J, U>: Iterator<U> where I: Iterator<J>, J: Iterator<U> {
    fn next(mut self): Option<U> {
        loop {
            match self.current.take() {
                Option.Some(it) => {
                    let mut it = it
                    match it.next() {
                        Option.Some(x) => {
                            self.current = Option.Some(it)
                            return Option.Some(x)
                        }
                        Option.None => {}
                    }
                }
                Option.None => {
                    match self.inner.next() {
                        Option.Some(it) => {
                            self.current = Option.Some(it)
                        }
                        Option.None => {
                            return Option.None
                        }
                    }
                }
            }
        }
    }
}

/// The lazy `cloned` chain: an owned copy of each viewed item.
///
/// ```
/// let names = [String.from("a")]
/// let copies = names.iter().cloned().to_list()
/// assert_eq(copies[0], String.from("a"))
/// ```
struct ClonedIter<I, U>: Clone {
    inner: I
}

ClonedIter<I, U>: Iterator<U> where I: Iterator<&U>, U: Clone {
    fn next(mut self): Option<U> {
        match self.inner.next() {
            Option.Some(x) => Option.Some((*x).clone()),
            Option.None => Option.None,
        }
    }
}

/// The lazy `copied` chain: a copy of each viewed item.
///
/// ```
/// let d = Deque<i32>.from([1, 2])
/// let mut total = 0
/// for x in d.iter().copied() {
///     total = total + x
/// }
/// assert_eq(total, 3)
/// ```
struct CopiedIter<I, U>: Clone {
    inner: I
}

CopiedIter<I, U>: Iterator<U> where I: Iterator<&U>, U: Copy {
    fn next(mut self): Option<U> {
        match self.inner.next() {
            Option.Some(x) => Option.Some(*x),
            Option.None => Option.None,
        }
    }
}

/// The lazy `cycle` chain: `current` is the pass being walked and `original` is the pristine copy of the source.
///
/// ```
/// let xs = [1, 2]
/// let mut total = 0
/// for x in xs.iter().cycle().take(5) {
///     total = total + x
/// }
/// assert_eq(total, 7)
/// ```
struct CycleIter<I, T>: Clone {
    original: I
    current: I
}

CycleIter<I, T>: Iterator<T> where I: Iterator<T> + Clone {
    fn next(mut self): Option<T> {
        match self.current.next() {
            Option.Some(x) => Option.Some(x),
            Option.None => {
                self.current = self.original.clone()
                self.current.next()
            }
        }
    }
}

/// The lazy `rev` chain: the source's items from the back.
///
/// ```
/// let xs = [1, 2, 3]
/// let mut seen = List<i32>.new()
/// for x in xs.iter().rev() {
///     seen.push(x)
/// }
/// assert_eq(seen[0], 3)
/// ```
struct RevIter<I, T>: Clone {
    inner: I
}

RevIter<I, T>: Iterator<T> where I: DoubleEndedIterator<T> {
    fn next(mut self): Option<T> {
        self.inner.next_back()
    }
}

RevIter<I, T>: DoubleEndedIterator<T> where I: Iterator<T> + DoubleEndedIterator<T> {
    fn next_back(mut self): Option<T> {
        self.inner.next()
    }
}

MapIter<I, T, U, F>: DoubleEndedIterator<U> where I: DoubleEndedIterator<T>, F: FnMut(T): U {
    fn next_back(mut self): Option<U> {
        match self.inner.next_back() {
            Option.Some(x) => Option.Some(self.f(x)),
            Option.None => Option.None,
        }
    }
}

FilterIter<I, T, F>: DoubleEndedIterator<T> where I: DoubleEndedIterator<T>, F: FnMut(&T): bool {
    fn next_back(mut self): Option<T> {
        loop {
            match self.inner.next_back() {
                Option.Some(x) => {
                    if self.f(&x) {
                        return Option.Some(x)
                    }
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
}

InspectIter<I, T, F>: DoubleEndedIterator<T> where I: DoubleEndedIterator<T>, F: FnMut(&T) {
    fn next_back(mut self): Option<T> {
        match self.inner.next_back() {
            Option.Some(x) => {
                self.f(&x)
                Option.Some(x)
            }
            Option.None => Option.None,
        }
    }
}

ChainIter<I, J, T>: DoubleEndedIterator<T> where I: DoubleEndedIterator<T>, J: DoubleEndedIterator<T> {
    fn next_back(mut self): Option<T> {
        match self.second.next_back() {
            Option.Some(x) => Option.Some(x),
            Option.None => self.first.next_back(),
        }
    }
}

ClonedIter<I, U>: DoubleEndedIterator<U> where I: DoubleEndedIterator<&U>, U: Clone {
    fn next_back(mut self): Option<U> {
        match self.inner.next_back() {
            Option.Some(x) => Option.Some((*x).clone()),
            Option.None => Option.None,
        }
    }
}

CopiedIter<I, U>: DoubleEndedIterator<U> where I: DoubleEndedIterator<&U>, U: Copy {
    fn next_back(mut self): Option<U> {
        match self.inner.next_back() {
            Option.Some(x) => Option.Some(*x),
            Option.None => Option.None,
        }
    }
}

/// The lazy `take_while` chain.
///
/// ```
/// let head = [1, 2, 3, 1].into_iter().take_while(|x| *x < 3).to_list()
/// assert_eq(head.len(), 2)
/// ```
struct TakeWhileIter<I, T, F: FnMut(&T): bool> {
    inner: I
    f: F
    done: bool
}

TakeWhileIter<I, T, F>: Iterator<T> where I: Iterator<T>, F: FnMut(&T): bool {
    fn next(mut self): Option<T> {
        if self.done {
            return Option.None
        }
        match self.inner.next() {
            Option.Some(x) => {
                if self.f(&x) {
                    return Option.Some(x)
                }
                self.done = true
                Option.None
            }
            Option.None => Option.None,
        }
    }
}

/// The lazy `skip_while` chain.
///
/// ```
/// let rest = [1, 2, 3, 1].into_iter().skip_while(|x| *x < 2).to_list()
/// assert_eq(rest.len(), 3)
/// ```
struct SkipWhileIter<I, T, F: FnMut(&T): bool> {
    inner: I
    f: F
    skipping: bool
}

SkipWhileIter<I, T, F>: Iterator<T> where I: Iterator<T>, F: FnMut(&T): bool {
    fn next(mut self): Option<T> {
        loop {
            match self.inner.next() {
                Option.Some(x) => {
                    if self.skipping && self.f(&x) {
                        continue
                    }
                    self.skipping = false
                    return Option.Some(x)
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
}

/// The lazy `map_while` chain.
///
/// ```
/// let doubled = [1, 2, -1, 4].into_iter().map_while(|x| if x > 0 { Option.Some(x * 2) } else { Option.None }).to_list()
/// assert_eq(doubled.len(), 2)
/// ```
struct MapWhileIter<I, T, U, F: FnMut(T): Option<U>> {
    inner: I
    f: F
    done: bool
}

MapWhileIter<I, T, U, F>: Iterator<U> where I: Iterator<T>, F: FnMut(T): Option<U> {
    fn next(mut self): Option<U> {
        if self.done {
            return Option.None
        }
        match self.inner.next() {
            Option.Some(x) => {
                let r = self.f(x)
                if r.is_none() {
                    self.done = true
                }
                r
            }
            Option.None => Option.None,
        }
    }
}

/// The lazy `step_by` chain.
///
/// ```
/// let picked = [1, 2, 3, 4, 5].into_iter().step_by(2).to_list()
/// assert_eq(picked.len(), 3)
/// assert_eq(picked[1], 3)
/// ```
struct StepByIter<I, T>: Clone {
    inner: I
    step: usize
    first: bool
}

StepByIter<I, T>: Iterator<T> where I: Iterator<T> {
    fn next(mut self): Option<T> {
        if self.first {
            self.first = false
            return self.inner.next()
        }
        let mut skipped: usize = 1
        while skipped < self.step {
            match self.inner.next() {
                Option.Some(_) => {}
                Option.None => {
                    return Option.None
                }
            }
            skipped = skipped + 1
        }
        self.inner.next()
    }
}

/// The lazy `inspect` chain.
///
/// ```
/// let mut seen = 0
/// let count = [1, 2, 3].into_iter().inspect(|x| seen = seen + *x).count()
/// assert_eq(seen, 6)
/// assert_eq(count, 3)
/// ```
struct InspectIter<I, T, F: FnMut(&T)> {
    inner: I
    f: F
}

InspectIter<I, T, F>: Iterator<T> where I: Iterator<T>, F: FnMut(&T) {
    fn next(mut self): Option<T> {
        match self.inner.next() {
            Option.Some(x) => {
                self.f(&x)
                Option.Some(x)
            }
            Option.None => Option.None,
        }
    }
}

/// The lazy `peekable` chain: `buffer` holds the item that was looked at, if any.
///
/// ```
/// let mut it = [5].into_iter().peekable()
/// assert_eq(it.next(), Option.Some(5))
/// assert(it.peek().is_none())
/// ```
struct PeekIter<I, T> {
    inner: I
    buffer: List<T>
    looked: bool
}

PeekIter<I, T> where I: Iterator<T> {
    /// A view of the next item without taking it, or `None` when there is none.
    ///
    /// ```
    /// let mut it = [1, 2].into_iter().peekable()
    /// assert_eq(*it.peek().unwrap(), 1)
    /// assert_eq(it.next(), Option.Some(1))
    /// ```
    fn peek(mut self): Option<&T> {
        if !self.looked {
            match self.inner.next() {
                Option.Some(x) => {
                    self.buffer.push(x)
                }
                Option.None => {}
            }
            self.looked = true
        }
        if self.buffer.len() == 0 {
            return Option.None
        }
        Option.Some(&self.buffer[0])
    }
}

PeekIter<I, T>: Iterator<T> where I: Iterator<T> {
    fn next(mut self): Option<T> {
        match self.buffer.pop() {
            Option.Some(x) => {
                self.looked = false
                Option.Some(x)
            }
            Option.None => {
                if self.looked {
                    self.looked = false
                    return Option.None
                }
                self.inner.next()
            }
        }
    }
}

// The adapters whose receiver must be an iterator of a particular shape (items that are iterators, items that are
// views, a source that can be cloned) are not methods of `Iterator<T>`, because a default method cannot put a bound on
// the interface's own item type. The compiler resolves `it.flatten()`, `it.cloned()`, `it.copied()`, and `it.cycle()`
// on any iterator to these functions (spec/iterators.md, IT13).

/// `it.flatten()`: the items of each iterator the source yields.
priv fn iter_flatten<I: Iterator<J>, J: Iterator<U>, U>(own it: I): FlattenIter<I, J, U> {
    let current: Option<J> = Option.None
    FlattenIter { inner: it, current: current }
}

/// `it.cloned()`: owned clones of the items a source of views yields.
priv fn iter_cloned<I: Iterator<&U>, U: Clone>(own it: I): ClonedIter<I, U> {
    ClonedIter { inner: it }
}

/// `it.copied()`: copies of the items a source of views yields.
priv fn iter_copied<I: Iterator<&U>, U: Copy>(own it: I): CopiedIter<I, U> {
    CopiedIter { inner: it }
}

/// `it.rev()`: the items from the back; the source must be double-ended.
priv fn iter_rev<I: Iterator<T> + DoubleEndedIterator<T>, T>(own it: I): RevIter<I, T> {
    RevIter { inner: it }
}

/// `it.cycle()`: the items again and again; the source must be clonable.
priv fn iter_cycle<I: Iterator<T> + Clone, T>(own it: I): CycleIter<I, T> {
    let original = it.clone()
    CycleIter { original: original, current: it }
}

// The `FromIterator` implementations of the built-in collections (spec/iterators.md, IT18). The compiler resolves
// `List<T>.from_iter(it)`, `Map<K, V>.from_iter(it)`, `String.from_iter(it)`, `Option<C>.from_iter(it)`, and
// `Result<C, E>.from_iter(it)` to these functions, and `List<T>.from(array)` and `Map<K, V>.from(array)` to the
// `list_from` and `map_from` pair at the end.

/// `List<T>.from_iter(it)`: every item, in order.
priv fn list_from_iter<T, I: Iterator<T>>(own iter: I): List<T> {
    let mut it = iter
    let mut out = List<T>.new()
    loop {
        match it.next() {
            Option.Some(x) => {
                out.push(x)
            }
            Option.None => {
                return out
            }
        }
    }
}

/// `List<String>.from_iter(it)` over `str` items: copies each view into an owned `String`.
priv fn list_string_from_str_iter<I: Iterator<str>>(own iter: I): List<String> {
    let mut it = iter
    let mut out = List<String>.new()
    loop {
        match it.next() {
            Option.Some(s) => {
                out.push(String.from(s))
            }
            Option.None => {
                return out
            }
        }
    }
}

/// `Map<K, V>.from_iter(it)`: a pair whose key is already there replaces the earlier value, like `insert`.
priv fn map_from_iter<K: Eq, V, I: Iterator<(K, V)>>(own iter: I): Map<K, V> {
    let mut it = iter
    let mut out = Map<K, V>.new()
    loop {
        match it.next() {
            Option.Some((k, v)) => {
                out.insert(k, v)
            }
            Option.None => {
                return out
            }
        }
    }
}

/// `String.from_iter(it)` over `char` items.
priv fn string_from_chars<I: Iterator<char>>(own iter: I): String {
    let mut it = iter
    let mut out = String.new()
    loop {
        match it.next() {
            Option.Some(c) => {
                out.push(c)
            }
            Option.None => {
                return out
            }
        }
    }
}

/// `String.from_iter(it)` over `str` items.
priv fn string_from_strs<I: Iterator<str>>(own iter: I): String {
    let mut it = iter
    let mut out = String.new()
    loop {
        match it.next() {
            Option.Some(s) => {
                out.push_str(s)
            }
            Option.None => {
                return out
            }
        }
    }
}

/// `String.from_iter(it)` over `String` items, which are consumed.
priv fn string_from_strings<I: Iterator<String>>(own iter: I): String {
    let mut it = iter
    let mut out = String.new()
    loop {
        match it.next() {
            Option.Some(s) => {
                out.push_str(s)
            }
            Option.None => {
                return out
            }
        }
    }
}

/// `String.from_iter(it)` over views of `String` items.
priv fn string_from_string_views<I: Iterator<&String>>(own iter: I): String {
    let mut it = iter
    let mut out = String.new()
    loop {
        match it.next() {
            Option.Some(s) => {
                out.push_str(*s)
            }
            Option.None => {
                return out
            }
        }
    }
}

/// `Option<C>.from_iter(it)`: `Some` of the collected items, or `None` at the first `None` item, which stops the
/// iterator there. The items are gathered in a list first, so the target is built only when every item is `Some`.
priv fn option_from_iter<T, C: FromIterator<T>, I: Iterator<Option<T>>>(own iter: I): Option<C> {
    let mut it = iter
    let mut items = List<T>.new()
    loop {
        match it.next() {
            Option.Some(item) => {
                match item {
                    Option.Some(x) => {
                        items.push(x)
                    }
                    Option.None => {
                        return Option.None
                    }
                }
            }
            Option.None => {
                return Option.Some(C.from_iter(items.into_iter()))
            }
        }
    }
}

/// `Result<C, E>.from_iter(it)`: `Ok` of the collected items, or the first `Err` item, which stops the iterator
/// there. The items are gathered in a list first, so the target is built only when every item is `Ok`.
priv fn result_from_iter<T, E, C: FromIterator<T>, I: Iterator<Result<T, E>>>(own iter: I): Result<C, E> {
    let mut it = iter
    let mut items = List<T>.new()
    loop {
        match it.next() {
            Option.Some(item) => {
                match item {
                    Result.Ok(x) => {
                        items.push(x)
                    }
                    Result.Err(e) => {
                        return Result.Err(e)
                    }
                }
            }
            Option.None => {
                return Result.Ok(C.from_iter(items.into_iter()))
            }
        }
    }
}

/// `List<T>.from([a, b, c])`: the elements of an array.
priv fn list_from<T, const N: usize>(own items: [T; N]): List<T> {
    list_from_iter(items.into_iter())
}

/// `Map<K, V>.from([(k, v), ...])`: the pairs of an array, a later pair replacing an earlier one with the same key.
priv fn map_from<K: Eq, V, const N: usize>(own items: [(K, V); N]): Map<K, V> {
    map_from_iter(items.into_iter())
}
