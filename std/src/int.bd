            match result.checked_mul(base) {
                Some(v) => {
                    result = v
                }
                None => {
                    return None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Some(v) => {
                    base = v
                }
                None => {
                    return None
                }
            }
        }
    }
    Some(result)
}

