    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
