// The integer functions of every integer type (spec/stdlib.md, "Integer functions").
//
// GENERATED by tests/gen_int_std.py: edit the templates there, not this file. Burdin has no numeric interface to write
// one body for every type, so the functions exist once per integer type. They are extension methods (spec/extensions.md),
// so the prelude makes them visible everywhere; the methods the compiler provides (`wrapping_add`, `checked_add`,
// `min`, `max`, `abs`, `to_string`, `parse`) win. `u32.MAX`, `u32.from_le_bytes(b)`, and the other associated names
// are the `__<type>_<name>` constants and functions below: the compiler maps `T.name` to `__T_name`.

use std.ParseIntError
use unicode.to_digit

// ---- i8 ----

const __i8_MIN: i8 = -127 - 1
const __i8_MAX: i8 = 127
const __i8_BITS: u32 = 8

/// `self` to the power `exp`. Overflow panics in a debug build and wraps in a release build, like `*`.
///
/// ```
/// let x: i8 = 3
/// assert_eq(x.pow(3), 27)
/// ```
fn i8.pow(self, exp: u32): i8 {
    let mut result: i8 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
///
/// ```
/// let x: i8 = 2
/// assert_eq(x.wrapping_pow(3), 8)
/// ```
fn i8.wrapping_pow(self, exp: u32): i8 {
    let mut result: i8 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result.wrapping_mul(base)
        }
        e = e >> 1
        if e > 0 {
            base = base.wrapping_mul(base)
        }
    }
    result
}

/// `self` to the power `exp`, or `None` on overflow.
///
/// ```
/// let x: i8 = 3
/// assert_eq(x.checked_pow(3), Option.Some(27))
/// ```
fn i8.checked_pow(self, exp: u32): Option<i8> {
    let mut result: i8 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            match result.checked_mul(base) {
                Option.Some(v) => {
                    result = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Option.Some(v) => {
                    base = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
    Option.Some(result)
}

/// `self / other`, or `None` when `other` is 0 or the quotient overflows.
///
/// ```
/// let x: i8 = 7
/// assert_eq(x.checked_div(2), Option.Some(3))
/// assert(x.checked_div(0).is_none())
/// ```
fn i8.checked_div(self, other: i8): Option<i8> {
    if other == 0 || (self == __i8_MIN && other == -1) {
        return Option.None
    }
    Option.Some(self / other)
}

/// `self % other`, or `None` when `other` is 0 or the division overflows.
///
/// ```
/// let x: i8 = 7
/// assert_eq(x.checked_rem(4), Option.Some(3))
/// assert(x.checked_rem(0).is_none())
/// ```
fn i8.checked_rem(self, other: i8): Option<i8> {
    if other == 0 || (self == __i8_MIN && other == -1) {
        return Option.None
    }
    Option.Some(self % other)
}

/// `-self`, or `None` for the minimum value.
///
/// ```
/// let x: i8 = 5
/// assert_eq(x.checked_neg(), Option.Some(-5))
/// ```
fn i8.checked_neg(self): Option<i8> {
    if self == __i8_MIN {
        return Option.None
    }
    Option.Some(0 - self)
}

/// `-self`, wrapping around for the minimum value.
///
/// ```
/// let x: i8 = 1
/// assert_eq(x.wrapping_neg().wrapping_neg(), 1)
/// ```
fn i8.wrapping_neg(self): i8 {
    let zero: i8 = 0
    zero.wrapping_sub(self)
}

/// `self << n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: i8 = 1
/// assert_eq(x.checked_shl(2), Option.Some(4))
/// assert(x.checked_shl(200).is_none())
/// ```
fn i8.checked_shl(self, n: u32): Option<i8> {
    if n >= 8 {
        return Option.None
    }
    Option.Some(self << n)
}

/// `self >> n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: i8 = 8
/// assert_eq(x.checked_shr(2), Option.Some(2))
/// assert(x.checked_shr(200).is_none())
/// ```
fn i8.checked_shr(self, n: u32): Option<i8> {
    if n >= 8 {
        return Option.None
    }
    Option.Some(self >> n)
}

/// `self << (n % bits)`.
///
/// ```
/// let x: i8 = 1
/// assert_eq(x.wrapping_shl(3), 8)
/// ```
fn i8.wrapping_shl(self, n: u32): i8 {
    self << (n % 8)
}

/// `self >> (n % bits)`.
///
/// ```
/// let x: i8 = 16
/// assert_eq(x.wrapping_shr(2), 4)
/// ```
fn i8.wrapping_shr(self, n: u32): i8 {
    self >> (n % 8)
}

/// `self + other`, clamped to the range of the type.
///
/// ```
/// let x: i8 = 2
/// assert_eq(x.saturating_add(3), 5)
/// ```
fn i8.saturating_add(self, other: i8): i8 {
    match self.checked_add(other) {
        Option.Some(v) => v,
        Option.None => {
            if other > 0 {
                __i8_MAX
            } else {
                __i8_MIN
            }
        }
    }
}

/// `self - other`, clamped to the range of the type.
///
/// ```
/// let x: i8 = 5
/// assert_eq(x.saturating_sub(2), 3)
/// ```
fn i8.saturating_sub(self, other: i8): i8 {
    match self.checked_sub(other) {
        Option.Some(v) => v,
        Option.None => {
            if other > 0 {
                __i8_MIN
            } else {
                __i8_MAX
            }
        }
    }
}

/// `self * other`, clamped to the range of the type.
///
/// ```
/// let x: i8 = 2
/// assert_eq(x.saturating_mul(3), 6)
/// ```
fn i8.saturating_mul(self, other: i8): i8 {
    match self.checked_mul(other) {
        Option.Some(v) => v,
        Option.None => {
            if (self < 0) == (other < 0) {
                __i8_MAX
            } else {
                __i8_MIN
            }
        }
    }
}

/// `self` to the power `exp`, clamped to the range of the type.
///
/// ```
/// let x: i8 = 2
/// assert_eq(x.saturating_pow(3), 8)
/// ```
fn i8.saturating_pow(self, exp: u32): i8 {
    match self.checked_pow(exp) {
        Option.Some(v) => v,
        Option.None => {
            if self < 0 && exp % 2 == 1 {
                __i8_MIN
            } else {
                __i8_MAX
            }
        }
    }
}

/// `self + other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i8 = 1
/// assert_eq(x.overflowing_add(2), (3, false))
/// ```
fn i8.overflowing_add(self, other: i8): (i8, bool) {
    (self.wrapping_add(other), self.checked_add(other).is_none())
}

/// `self - other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i8 = 5
/// assert_eq(x.overflowing_sub(2), (3, false))
/// ```
fn i8.overflowing_sub(self, other: i8): (i8, bool) {
    (self.wrapping_sub(other), self.checked_sub(other).is_none())
}

/// `self * other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i8 = 3
/// assert_eq(x.overflowing_mul(4), (12, false))
/// ```
fn i8.overflowing_mul(self, other: i8): (i8, bool) {
    (self.wrapping_mul(other), self.checked_mul(other).is_none())
}

/// The quotient rounded so that the remainder is never negative. Division by 0 panics.
///
/// ```
/// let x: i8 = 7
/// assert_eq(x.div_euclid(2), 3)
/// ```
fn i8.div_euclid(self, other: i8): i8 {
    let q = self / other
    if self % other < 0 {
        if other > 0 {
            return q - 1
        }
        return q + 1
    }
    q
}

/// The remainder, never negative. Division by 0 panics.
///
/// ```
/// let x: i8 = 7
/// assert_eq(x.rem_euclid(4), 3)
/// ```
fn i8.rem_euclid(self, other: i8): i8 {
    let r = self % other
    if r < 0 {
        if other > 0 {
            return r + other
        }
        return r - other
    }
    r
}

/// The distance between `self` and `other`, as the unsigned type.
///
/// ```
/// let x: i8 = 5
/// assert_eq(x.abs_diff(9), 4)
/// ```
fn i8.abs_diff(self, other: i8): u8 {
    if self > other {
        return (self.wrapping_sub(other)) as u8
    }
    (other.wrapping_sub(self)) as u8
}

/// The absolute value as the unsigned type, so the minimum value is representable.
///
/// ```
/// let x: i8 = -4
/// assert_eq(x.unsigned_abs(), 4)
/// ```
fn i8.unsigned_abs(self): u8 {
    if self < 0 {
        let zero: i8 = 0
        return (zero.wrapping_sub(self)) as u8
    }
    self as u8
}

/// `-1`, `0`, or `1` by the sign of `self`.
///
/// ```
/// let x: i8 = -4
/// assert_eq(x.signum(), -1)
/// ```
fn i8.signum(self): i8 {
    if self > 0 {
        return 1
    }
    if self < 0 {
        return 0 - 1
    }
    0
}

/// Whether `self` is greater than 0.
///
/// ```
/// let x: i8 = 3
/// assert(x.is_positive())
/// ```
fn i8.is_positive(self): bool {
    self > 0
}

/// Whether `self` is less than 0.
///
/// ```
/// let x: i8 = -3
/// assert(x.is_negative())
/// assert(!x.is_positive())
/// ```
fn i8.is_negative(self): bool {
    self < 0
}

/// The number of 1 bits.
///
/// ```
/// let x: i8 = 7
/// assert_eq(x.count_ones(), 3)
/// ```
fn i8.count_ones(self): u32 {
    let mut v: u8 = self as u8
    let mut n: u32 = 0
    while v != 0 {
        n = n + (v & 1) as u32
        v = v >> 1
    }
    n
}

/// The number of 0 bits.
///
/// ```
/// let x: i8 = 7
/// assert_eq(x.count_zeros(), 8 - 3)
/// ```
fn i8.count_zeros(self): u32 {
    8 - self.count_ones()
}

/// The number of 0 bits before the first 1 bit, from the top.
///
/// ```
/// let x: i8 = 1
/// assert_eq(x.leading_zeros(), 8 - 1)
/// ```
fn i8.leading_zeros(self): u32 {
    let v: u8 = self as u8
    let mut n: u32 = 0
    let mut i: u32 = 8
    while i > 0 {
        i = i - 1
        if (v >> i) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The number of 0 bits after the last 1 bit, from the bottom.
///
/// ```
/// let x: i8 = 8
/// assert_eq(x.trailing_zeros(), 3)
/// ```
fn i8.trailing_zeros(self): u32 {
    let v: u8 = self as u8
    let mut n: u32 = 0
    while n < 8 {
        if (v >> n) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The bits rotated left by `n % bits` places.
///
/// ```
/// let x: i8 = 1
/// assert_eq(x.rotate_left(1), 2)
/// ```
fn i8.rotate_left(self, n: u32): i8 {
    let v: u8 = self as u8
    let k = n % 8
    if k == 0 {
        return self
    }
    let back: u32 = 8 - k
    ((v << k) | (v >> back)) as i8
}

/// The bits rotated right by `n % bits` places.
///
/// ```
/// let x: i8 = 2
/// assert_eq(x.rotate_right(1), 1)
/// ```
fn i8.rotate_right(self, n: u32): i8 {
    let v: u8 = self as u8
    let k = n % 8
    if k == 0 {
        return self
    }
    let back: u32 = 8 - k
    ((v >> k) | (v << back)) as i8
}

/// The bytes in the opposite order. A type of one byte is unchanged.
///
/// ```
/// let x: i8 = 1
/// assert_eq(x.swap_bytes().swap_bytes(), 1)
/// ```
fn i8.swap_bytes(self): i8 {
    self
}

/// The bits in the opposite order.
///
/// ```
/// let x: i8 = 1
/// assert_eq(x.reverse_bits().reverse_bits(), 1)
/// ```
fn i8.reverse_bits(self): i8 {
    let v: u8 = self as u8
    let mut r: u8 = 0
    let mut i: u32 = 0
    while i < 8 {
        r = (r << 1) | ((v >> i) & 1)
        i = i + 1
    }
    r as i8
}

/// The integer square root: the greatest `r` with `r * r <= self`. A negative `self` panics.
///
/// ```
/// let x: i8 = 17
/// assert_eq(x.isqrt(), 4)
/// ```
fn i8.isqrt(self): i8 {
    if self < 0 {
        panic("isqrt of a negative number")
    }
    let mut n: u8 = self as u8
    let mut result: u8 = 0
    let mut bit: u8 = 1 << 6
    while bit > n {
        bit = bit >> 2
    }
    while bit != 0 {
        if n >= result + bit {
            n = n - (result + bit)
            result = (result >> 1) + bit
        } else {
            result = result >> 1
        }
        bit = bit >> 2
    }
    result as i8
}

/// The base 2 logarithm rounded down. A `self` that is 0 or negative panics.
///
/// ```
/// let x: i8 = 8
/// assert_eq(x.ilog2(), 3)
/// ```
fn i8.ilog2(self): u32 {
    if self <= 0 {
        panic("ilog2 of a number that is not positive")
    }
    7 - self.leading_zeros()
}

/// The base 10 logarithm rounded down. A `self` that is 0 or negative panics.
///
/// ```
/// let x: i8 = 100
/// assert_eq(x.ilog10(), 2)
/// ```
fn i8.ilog10(self): u32 {
    if self <= 0 {
        panic("ilog10 of a number that is not positive")
    }
    let mut v = self
    let mut n: u32 = 0
    while v >= 10 {
        v = v / 10
        n = n + 1
    }
    n
}

/// The number in the text in base `radix` (2 to 36; any other radix panics). An optional leading `-` is allowed. Any failure (no digits, a character that is not a digit of the base, or a value out of range) is `ParseIntError.Invalid`.
fn __i8_parse_radix(s: str, radix: u32): Result<i8, ParseIntError> {
    if radix < 2 || radix > 36 {
        panic("parse_radix: radix must be 2 to 36")
    }
    let base: i8 = radix as i8
    let mut value: i8 = 0
    let mut seen_digit = false
    let mut negative = false
    let mut first = true
    for c in s.chars() {
        if first {
            first = false
            if c == '-' {
                negative = true
                continue
            }
        }
        match c.to_digit(radix) {
            Option.Some(d) => {
                let digit: i8 = d as i8
                let scaled = value.checked_mul(base)
                if scaled.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                let next = if negative { scaled.unwrap().checked_sub(digit) } else { scaled.unwrap().checked_add(digit) }
                if next.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                value = next.unwrap()
                seen_digit = true
            }
            Option.None => {
                return Result.Err(ParseIntError.Invalid)
            }
        }
    }
    if !seen_digit {
        return Result.Err(ParseIntError.Invalid)
    }
    Result.Ok(value)
}

/// The number written in base `radix` (2 to 36, lowercase digits; any other radix panics), with a leading `-` when negative.
///
/// ```
/// let x: i8 = 11
/// assert_eq(x.to_string_radix(2), String.from("1011"))
/// ```
fn i8.to_string_radix(self, radix: u32): String {
    if radix < 2 || radix > 36 {
        panic("to_string_radix: radix must be 2 to 36")
    }
    let mut out = String.new()
    if self < 0 {
        out.push('-')
    }
    let mut v: u8 = self.unsigned_abs()
    if v == 0 {
        out.push('0')
        return out
    }
    let base: u8 = radix as u8
    let mut digits = List<char>.new()
    while v > 0 {
        let d = (v % base) as u32
        if d < 10 {
            digits.push((48 + d) as char)
        } else {
            digits.push((87 + d) as char)
        }
        v = v / base
    }
    let mut i = digits.len()
    while i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    out
}

/// The bytes in little-endian order.
///
/// ```
/// let x: i8 = 1
/// assert_eq(x.to_le_bytes()[0], 1)
/// ```
fn i8.to_le_bytes(self): [u8; 1] {
    let v: u8 = self as u8
    [((v >> 0) & 255) as u8]
}

/// The bytes in big-endian order.
///
/// ```
/// let x: i8 = 1
/// assert_eq(x.to_be_bytes()[1 - 1], 1)
/// ```
fn i8.to_be_bytes(self): [u8; 1] {
    let v: u8 = self as u8
    [((v >> 0) & 255) as u8]
}

/// The bytes in the byte order of the target, which is little-endian on every supported platform.
///
/// ```
/// let x: i8 = 1
/// assert_eq(x.to_ne_bytes()[0], 1)
/// ```
fn i8.to_ne_bytes(self): [u8; 1] {
    self.to_le_bytes()
}

/// The value whose little-endian bytes are `b`.
fn __i8_from_le_bytes(b: [u8; 1]): i8 {
    let v: u8 = ((b[0] as u8) << 0)
    v as i8
}

/// The value whose big-endian bytes are `b`.
fn __i8_from_be_bytes(b: [u8; 1]): i8 {
    let v: u8 = ((b[0] as u8) << 0)
    v as i8
}

/// The value whose native-endian bytes are `b`.
fn __i8_from_ne_bytes(b: [u8; 1]): i8 {
    __i8_from_le_bytes(b)
}

// ---- i16 ----

const __i16_MIN: i16 = -32767 - 1
const __i16_MAX: i16 = 32767
const __i16_BITS: u32 = 16

/// `self` to the power `exp`. Overflow panics in a debug build and wraps in a release build, like `*`.
///
/// ```
/// let x: i16 = 3
/// assert_eq(x.pow(3), 27)
/// ```
fn i16.pow(self, exp: u32): i16 {
    let mut result: i16 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
///
/// ```
/// let x: i16 = 2
/// assert_eq(x.wrapping_pow(3), 8)
/// ```
fn i16.wrapping_pow(self, exp: u32): i16 {
    let mut result: i16 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result.wrapping_mul(base)
        }
        e = e >> 1
        if e > 0 {
            base = base.wrapping_mul(base)
        }
    }
    result
}

/// `self` to the power `exp`, or `None` on overflow.
///
/// ```
/// let x: i16 = 3
/// assert_eq(x.checked_pow(3), Option.Some(27))
/// ```
fn i16.checked_pow(self, exp: u32): Option<i16> {
    let mut result: i16 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            match result.checked_mul(base) {
                Option.Some(v) => {
                    result = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Option.Some(v) => {
                    base = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
    Option.Some(result)
}

/// `self / other`, or `None` when `other` is 0 or the quotient overflows.
///
/// ```
/// let x: i16 = 7
/// assert_eq(x.checked_div(2), Option.Some(3))
/// assert(x.checked_div(0).is_none())
/// ```
fn i16.checked_div(self, other: i16): Option<i16> {
    if other == 0 || (self == __i16_MIN && other == -1) {
        return Option.None
    }
    Option.Some(self / other)
}

/// `self % other`, or `None` when `other` is 0 or the division overflows.
///
/// ```
/// let x: i16 = 7
/// assert_eq(x.checked_rem(4), Option.Some(3))
/// assert(x.checked_rem(0).is_none())
/// ```
fn i16.checked_rem(self, other: i16): Option<i16> {
    if other == 0 || (self == __i16_MIN && other == -1) {
        return Option.None
    }
    Option.Some(self % other)
}

/// `-self`, or `None` for the minimum value.
///
/// ```
/// let x: i16 = 5
/// assert_eq(x.checked_neg(), Option.Some(-5))
/// ```
fn i16.checked_neg(self): Option<i16> {
    if self == __i16_MIN {
        return Option.None
    }
    Option.Some(0 - self)
}

/// `-self`, wrapping around for the minimum value.
///
/// ```
/// let x: i16 = 1
/// assert_eq(x.wrapping_neg().wrapping_neg(), 1)
/// ```
fn i16.wrapping_neg(self): i16 {
    let zero: i16 = 0
    zero.wrapping_sub(self)
}

/// `self << n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: i16 = 1
/// assert_eq(x.checked_shl(2), Option.Some(4))
/// assert(x.checked_shl(200).is_none())
/// ```
fn i16.checked_shl(self, n: u32): Option<i16> {
    if n >= 16 {
        return Option.None
    }
    Option.Some(self << n)
}

/// `self >> n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: i16 = 8
/// assert_eq(x.checked_shr(2), Option.Some(2))
/// assert(x.checked_shr(200).is_none())
/// ```
fn i16.checked_shr(self, n: u32): Option<i16> {
    if n >= 16 {
        return Option.None
    }
    Option.Some(self >> n)
}

/// `self << (n % bits)`.
///
/// ```
/// let x: i16 = 1
/// assert_eq(x.wrapping_shl(3), 8)
/// ```
fn i16.wrapping_shl(self, n: u32): i16 {
    self << (n % 16)
}

/// `self >> (n % bits)`.
///
/// ```
/// let x: i16 = 16
/// assert_eq(x.wrapping_shr(2), 4)
/// ```
fn i16.wrapping_shr(self, n: u32): i16 {
    self >> (n % 16)
}

/// `self + other`, clamped to the range of the type.
///
/// ```
/// let x: i16 = 2
/// assert_eq(x.saturating_add(3), 5)
/// ```
fn i16.saturating_add(self, other: i16): i16 {
    match self.checked_add(other) {
        Option.Some(v) => v,
        Option.None => {
            if other > 0 {
                __i16_MAX
            } else {
                __i16_MIN
            }
        }
    }
}

/// `self - other`, clamped to the range of the type.
///
/// ```
/// let x: i16 = 5
/// assert_eq(x.saturating_sub(2), 3)
/// ```
fn i16.saturating_sub(self, other: i16): i16 {
    match self.checked_sub(other) {
        Option.Some(v) => v,
        Option.None => {
            if other > 0 {
                __i16_MIN
            } else {
                __i16_MAX
            }
        }
    }
}

/// `self * other`, clamped to the range of the type.
///
/// ```
/// let x: i16 = 2
/// assert_eq(x.saturating_mul(3), 6)
/// ```
fn i16.saturating_mul(self, other: i16): i16 {
    match self.checked_mul(other) {
        Option.Some(v) => v,
        Option.None => {
            if (self < 0) == (other < 0) {
                __i16_MAX
            } else {
                __i16_MIN
            }
        }
    }
}

/// `self` to the power `exp`, clamped to the range of the type.
///
/// ```
/// let x: i16 = 2
/// assert_eq(x.saturating_pow(3), 8)
/// ```
fn i16.saturating_pow(self, exp: u32): i16 {
    match self.checked_pow(exp) {
        Option.Some(v) => v,
        Option.None => {
            if self < 0 && exp % 2 == 1 {
                __i16_MIN
            } else {
                __i16_MAX
            }
        }
    }
}

/// `self + other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i16 = 1
/// assert_eq(x.overflowing_add(2), (3, false))
/// ```
fn i16.overflowing_add(self, other: i16): (i16, bool) {
    (self.wrapping_add(other), self.checked_add(other).is_none())
}

/// `self - other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i16 = 5
/// assert_eq(x.overflowing_sub(2), (3, false))
/// ```
fn i16.overflowing_sub(self, other: i16): (i16, bool) {
    (self.wrapping_sub(other), self.checked_sub(other).is_none())
}

/// `self * other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i16 = 3
/// assert_eq(x.overflowing_mul(4), (12, false))
/// ```
fn i16.overflowing_mul(self, other: i16): (i16, bool) {
    (self.wrapping_mul(other), self.checked_mul(other).is_none())
}

/// The quotient rounded so that the remainder is never negative. Division by 0 panics.
///
/// ```
/// let x: i16 = 7
/// assert_eq(x.div_euclid(2), 3)
/// ```
fn i16.div_euclid(self, other: i16): i16 {
    let q = self / other
    if self % other < 0 {
        if other > 0 {
            return q - 1
        }
        return q + 1
    }
    q
}

/// The remainder, never negative. Division by 0 panics.
///
/// ```
/// let x: i16 = 7
/// assert_eq(x.rem_euclid(4), 3)
/// ```
fn i16.rem_euclid(self, other: i16): i16 {
    let r = self % other
    if r < 0 {
        if other > 0 {
            return r + other
        }
        return r - other
    }
    r
}

/// The distance between `self` and `other`, as the unsigned type.
///
/// ```
/// let x: i16 = 5
/// assert_eq(x.abs_diff(9), 4)
/// ```
fn i16.abs_diff(self, other: i16): u16 {
    if self > other {
        return (self.wrapping_sub(other)) as u16
    }
    (other.wrapping_sub(self)) as u16
}

/// The absolute value as the unsigned type, so the minimum value is representable.
///
/// ```
/// let x: i16 = -4
/// assert_eq(x.unsigned_abs(), 4)
/// ```
fn i16.unsigned_abs(self): u16 {
    if self < 0 {
        let zero: i16 = 0
        return (zero.wrapping_sub(self)) as u16
    }
    self as u16
}

/// `-1`, `0`, or `1` by the sign of `self`.
///
/// ```
/// let x: i16 = -4
/// assert_eq(x.signum(), -1)
/// ```
fn i16.signum(self): i16 {
    if self > 0 {
        return 1
    }
    if self < 0 {
        return 0 - 1
    }
    0
}

/// Whether `self` is greater than 0.
///
/// ```
/// let x: i16 = 3
/// assert(x.is_positive())
/// ```
fn i16.is_positive(self): bool {
    self > 0
}

/// Whether `self` is less than 0.
///
/// ```
/// let x: i16 = -3
/// assert(x.is_negative())
/// assert(!x.is_positive())
/// ```
fn i16.is_negative(self): bool {
    self < 0
}

/// The number of 1 bits.
///
/// ```
/// let x: i16 = 7
/// assert_eq(x.count_ones(), 3)
/// ```
fn i16.count_ones(self): u32 {
    let mut v: u16 = self as u16
    let mut n: u32 = 0
    while v != 0 {
        n = n + (v & 1) as u32
        v = v >> 1
    }
    n
}

/// The number of 0 bits.
///
/// ```
/// let x: i16 = 7
/// assert_eq(x.count_zeros(), 16 - 3)
/// ```
fn i16.count_zeros(self): u32 {
    16 - self.count_ones()
}

/// The number of 0 bits before the first 1 bit, from the top.
///
/// ```
/// let x: i16 = 1
/// assert_eq(x.leading_zeros(), 16 - 1)
/// ```
fn i16.leading_zeros(self): u32 {
    let v: u16 = self as u16
    let mut n: u32 = 0
    let mut i: u32 = 16
    while i > 0 {
        i = i - 1
        if (v >> i) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The number of 0 bits after the last 1 bit, from the bottom.
///
/// ```
/// let x: i16 = 8
/// assert_eq(x.trailing_zeros(), 3)
/// ```
fn i16.trailing_zeros(self): u32 {
    let v: u16 = self as u16
    let mut n: u32 = 0
    while n < 16 {
        if (v >> n) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The bits rotated left by `n % bits` places.
///
/// ```
/// let x: i16 = 1
/// assert_eq(x.rotate_left(1), 2)
/// ```
fn i16.rotate_left(self, n: u32): i16 {
    let v: u16 = self as u16
    let k = n % 16
    if k == 0 {
        return self
    }
    let back: u32 = 16 - k
    ((v << k) | (v >> back)) as i16
}

/// The bits rotated right by `n % bits` places.
///
/// ```
/// let x: i16 = 2
/// assert_eq(x.rotate_right(1), 1)
/// ```
fn i16.rotate_right(self, n: u32): i16 {
    let v: u16 = self as u16
    let k = n % 16
    if k == 0 {
        return self
    }
    let back: u32 = 16 - k
    ((v >> k) | (v << back)) as i16
}

/// The bytes in the opposite order.
///
/// ```
/// let x: i16 = 1
/// assert_eq(x.swap_bytes().swap_bytes(), 1)
/// ```
fn i16.swap_bytes(self): i16 {
    let v: u16 = self as u16
    let mut r: u16 = 0
    let mut i: u32 = 0
    while i < 2 {
        let shift: u32 = 8 * i
        r = (r << 8) | ((v >> shift) & 255)
        i = i + 1
    }
    r as i16
}

/// The bits in the opposite order.
///
/// ```
/// let x: i16 = 1
/// assert_eq(x.reverse_bits().reverse_bits(), 1)
/// ```
fn i16.reverse_bits(self): i16 {
    let v: u16 = self as u16
    let mut r: u16 = 0
    let mut i: u32 = 0
    while i < 16 {
        r = (r << 1) | ((v >> i) & 1)
        i = i + 1
    }
    r as i16
}

/// The integer square root: the greatest `r` with `r * r <= self`. A negative `self` panics.
///
/// ```
/// let x: i16 = 17
/// assert_eq(x.isqrt(), 4)
/// ```
fn i16.isqrt(self): i16 {
    if self < 0 {
        panic("isqrt of a negative number")
    }
    let mut n: u16 = self as u16
    let mut result: u16 = 0
    let mut bit: u16 = 1 << 14
    while bit > n {
        bit = bit >> 2
    }
    while bit != 0 {
        if n >= result + bit {
            n = n - (result + bit)
            result = (result >> 1) + bit
        } else {
            result = result >> 1
        }
        bit = bit >> 2
    }
    result as i16
}

/// The base 2 logarithm rounded down. A `self` that is 0 or negative panics.
///
/// ```
/// let x: i16 = 8
/// assert_eq(x.ilog2(), 3)
/// ```
fn i16.ilog2(self): u32 {
    if self <= 0 {
        panic("ilog2 of a number that is not positive")
    }
    15 - self.leading_zeros()
}

/// The base 10 logarithm rounded down. A `self` that is 0 or negative panics.
///
/// ```
/// let x: i16 = 100
/// assert_eq(x.ilog10(), 2)
/// ```
fn i16.ilog10(self): u32 {
    if self <= 0 {
        panic("ilog10 of a number that is not positive")
    }
    let mut v = self
    let mut n: u32 = 0
    while v >= 10 {
        v = v / 10
        n = n + 1
    }
    n
}

/// The number in the text in base `radix` (2 to 36; any other radix panics). An optional leading `-` is allowed. Any failure (no digits, a character that is not a digit of the base, or a value out of range) is `ParseIntError.Invalid`.
fn __i16_parse_radix(s: str, radix: u32): Result<i16, ParseIntError> {
    if radix < 2 || radix > 36 {
        panic("parse_radix: radix must be 2 to 36")
    }
    let base: i16 = radix as i16
    let mut value: i16 = 0
    let mut seen_digit = false
    let mut negative = false
    let mut first = true
    for c in s.chars() {
        if first {
            first = false
            if c == '-' {
                negative = true
                continue
            }
        }
        match c.to_digit(radix) {
            Option.Some(d) => {
                let digit: i16 = d as i16
                let scaled = value.checked_mul(base)
                if scaled.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                let next = if negative { scaled.unwrap().checked_sub(digit) } else { scaled.unwrap().checked_add(digit) }
                if next.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                value = next.unwrap()
                seen_digit = true
            }
            Option.None => {
                return Result.Err(ParseIntError.Invalid)
            }
        }
    }
    if !seen_digit {
        return Result.Err(ParseIntError.Invalid)
    }
    Result.Ok(value)
}

/// The number written in base `radix` (2 to 36, lowercase digits; any other radix panics), with a leading `-` when negative.
///
/// ```
/// let x: i16 = 11
/// assert_eq(x.to_string_radix(2), String.from("1011"))
/// ```
fn i16.to_string_radix(self, radix: u32): String {
    if radix < 2 || radix > 36 {
        panic("to_string_radix: radix must be 2 to 36")
    }
    let mut out = String.new()
    if self < 0 {
        out.push('-')
    }
    let mut v: u16 = self.unsigned_abs()
    if v == 0 {
        out.push('0')
        return out
    }
    let base: u16 = radix as u16
    let mut digits = List<char>.new()
    while v > 0 {
        let d = (v % base) as u32
        if d < 10 {
            digits.push((48 + d) as char)
        } else {
            digits.push((87 + d) as char)
        }
        v = v / base
    }
    let mut i = digits.len()
    while i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    out
}

/// The bytes in little-endian order.
///
/// ```
/// let x: i16 = 1
/// assert_eq(x.to_le_bytes()[0], 1)
/// ```
fn i16.to_le_bytes(self): [u8; 2] {
    let v: u16 = self as u16
    [((v >> 0) & 255) as u8, ((v >> 8) & 255) as u8]
}

/// The bytes in big-endian order.
///
/// ```
/// let x: i16 = 1
/// assert_eq(x.to_be_bytes()[2 - 1], 1)
/// ```
fn i16.to_be_bytes(self): [u8; 2] {
    let v: u16 = self as u16
    [((v >> 8) & 255) as u8, ((v >> 0) & 255) as u8]
}

/// The bytes in the byte order of the target, which is little-endian on every supported platform.
///
/// ```
/// let x: i16 = 1
/// assert_eq(x.to_ne_bytes()[0], 1)
/// ```
fn i16.to_ne_bytes(self): [u8; 2] {
    self.to_le_bytes()
}

/// The value whose little-endian bytes are `b`.
fn __i16_from_le_bytes(b: [u8; 2]): i16 {
    let v: u16 = ((b[0] as u16) << 0) | ((b[1] as u16) << 8)
    v as i16
}

/// The value whose big-endian bytes are `b`.
fn __i16_from_be_bytes(b: [u8; 2]): i16 {
    let v: u16 = ((b[0] as u16) << 8) | ((b[1] as u16) << 0)
    v as i16
}

/// The value whose native-endian bytes are `b`.
fn __i16_from_ne_bytes(b: [u8; 2]): i16 {
    __i16_from_le_bytes(b)
}

// ---- i32 ----

const __i32_MIN: i32 = -2147483647 - 1
const __i32_MAX: i32 = 2147483647
const __i32_BITS: u32 = 32

/// `self` to the power `exp`. Overflow panics in a debug build and wraps in a release build, like `*`.
///
/// ```
/// let x: i32 = 3
/// assert_eq(x.pow(3), 27)
/// ```
fn i32.pow(self, exp: u32): i32 {
    let mut result: i32 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
///
/// ```
/// let x: i32 = 2
/// assert_eq(x.wrapping_pow(3), 8)
/// ```
fn i32.wrapping_pow(self, exp: u32): i32 {
    let mut result: i32 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result.wrapping_mul(base)
        }
        e = e >> 1
        if e > 0 {
            base = base.wrapping_mul(base)
        }
    }
    result
}

/// `self` to the power `exp`, or `None` on overflow.
///
/// ```
/// let x: i32 = 3
/// assert_eq(x.checked_pow(3), Option.Some(27))
/// ```
fn i32.checked_pow(self, exp: u32): Option<i32> {
    let mut result: i32 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            match result.checked_mul(base) {
                Option.Some(v) => {
                    result = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Option.Some(v) => {
                    base = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
    Option.Some(result)
}

/// `self / other`, or `None` when `other` is 0 or the quotient overflows.
///
/// ```
/// let x: i32 = 7
/// assert_eq(x.checked_div(2), Option.Some(3))
/// assert(x.checked_div(0).is_none())
/// ```
fn i32.checked_div(self, other: i32): Option<i32> {
    if other == 0 || (self == __i32_MIN && other == -1) {
        return Option.None
    }
    Option.Some(self / other)
}

/// `self % other`, or `None` when `other` is 0 or the division overflows.
///
/// ```
/// let x: i32 = 7
/// assert_eq(x.checked_rem(4), Option.Some(3))
/// assert(x.checked_rem(0).is_none())
/// ```
fn i32.checked_rem(self, other: i32): Option<i32> {
    if other == 0 || (self == __i32_MIN && other == -1) {
        return Option.None
    }
    Option.Some(self % other)
}

/// `-self`, or `None` for the minimum value.
///
/// ```
/// let x: i32 = 5
/// assert_eq(x.checked_neg(), Option.Some(-5))
/// ```
fn i32.checked_neg(self): Option<i32> {
    if self == __i32_MIN {
        return Option.None
    }
    Option.Some(0 - self)
}

/// `-self`, wrapping around for the minimum value.
///
/// ```
/// let x: i32 = 1
/// assert_eq(x.wrapping_neg().wrapping_neg(), 1)
/// ```
fn i32.wrapping_neg(self): i32 {
    let zero: i32 = 0
    zero.wrapping_sub(self)
}

/// `self << n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: i32 = 1
/// assert_eq(x.checked_shl(2), Option.Some(4))
/// assert(x.checked_shl(200).is_none())
/// ```
fn i32.checked_shl(self, n: u32): Option<i32> {
    if n >= 32 {
        return Option.None
    }
    Option.Some(self << n)
}

/// `self >> n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: i32 = 8
/// assert_eq(x.checked_shr(2), Option.Some(2))
/// assert(x.checked_shr(200).is_none())
/// ```
fn i32.checked_shr(self, n: u32): Option<i32> {
    if n >= 32 {
        return Option.None
    }
    Option.Some(self >> n)
}

/// `self << (n % bits)`.
///
/// ```
/// let x: i32 = 1
/// assert_eq(x.wrapping_shl(3), 8)
/// ```
fn i32.wrapping_shl(self, n: u32): i32 {
    self << (n % 32)
}

/// `self >> (n % bits)`.
///
/// ```
/// let x: i32 = 16
/// assert_eq(x.wrapping_shr(2), 4)
/// ```
fn i32.wrapping_shr(self, n: u32): i32 {
    self >> (n % 32)
}

/// `self + other`, clamped to the range of the type.
///
/// ```
/// let x: i32 = 2
/// assert_eq(x.saturating_add(3), 5)
/// ```
fn i32.saturating_add(self, other: i32): i32 {
    match self.checked_add(other) {
        Option.Some(v) => v,
        Option.None => {
            if other > 0 {
                __i32_MAX
            } else {
                __i32_MIN
            }
        }
    }
}

/// `self - other`, clamped to the range of the type.
///
/// ```
/// let x: i32 = 5
/// assert_eq(x.saturating_sub(2), 3)
/// ```
fn i32.saturating_sub(self, other: i32): i32 {
    match self.checked_sub(other) {
        Option.Some(v) => v,
        Option.None => {
            if other > 0 {
                __i32_MIN
            } else {
                __i32_MAX
            }
        }
    }
}

/// `self * other`, clamped to the range of the type.
///
/// ```
/// let x: i32 = 2
/// assert_eq(x.saturating_mul(3), 6)
/// ```
fn i32.saturating_mul(self, other: i32): i32 {
    match self.checked_mul(other) {
        Option.Some(v) => v,
        Option.None => {
            if (self < 0) == (other < 0) {
                __i32_MAX
            } else {
                __i32_MIN
            }
        }
    }
}

/// `self` to the power `exp`, clamped to the range of the type.
///
/// ```
/// let x: i32 = 2
/// assert_eq(x.saturating_pow(3), 8)
/// ```
fn i32.saturating_pow(self, exp: u32): i32 {
    match self.checked_pow(exp) {
        Option.Some(v) => v,
        Option.None => {
            if self < 0 && exp % 2 == 1 {
                __i32_MIN
            } else {
                __i32_MAX
            }
        }
    }
}

/// `self + other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i32 = 1
/// assert_eq(x.overflowing_add(2), (3, false))
/// ```
fn i32.overflowing_add(self, other: i32): (i32, bool) {
    (self.wrapping_add(other), self.checked_add(other).is_none())
}

/// `self - other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i32 = 5
/// assert_eq(x.overflowing_sub(2), (3, false))
/// ```
fn i32.overflowing_sub(self, other: i32): (i32, bool) {
    (self.wrapping_sub(other), self.checked_sub(other).is_none())
}

/// `self * other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i32 = 3
/// assert_eq(x.overflowing_mul(4), (12, false))
/// ```
fn i32.overflowing_mul(self, other: i32): (i32, bool) {
    (self.wrapping_mul(other), self.checked_mul(other).is_none())
}

/// The quotient rounded so that the remainder is never negative. Division by 0 panics.
///
/// ```
/// let x: i32 = 7
/// assert_eq(x.div_euclid(2), 3)
/// ```
fn i32.div_euclid(self, other: i32): i32 {
    let q = self / other
    if self % other < 0 {
        if other > 0 {
            return q - 1
        }
        return q + 1
    }
    q
}

/// The remainder, never negative. Division by 0 panics.
///
/// ```
/// let x: i32 = 7
/// assert_eq(x.rem_euclid(4), 3)
/// ```
fn i32.rem_euclid(self, other: i32): i32 {
    let r = self % other
    if r < 0 {
        if other > 0 {
            return r + other
        }
        return r - other
    }
    r
}

/// The distance between `self` and `other`, as the unsigned type.
///
/// ```
/// let x: i32 = 5
/// assert_eq(x.abs_diff(9), 4)
/// ```
fn i32.abs_diff(self, other: i32): u32 {
    if self > other {
        return (self.wrapping_sub(other)) as u32
    }
    (other.wrapping_sub(self)) as u32
}

/// The absolute value as the unsigned type, so the minimum value is representable.
///
/// ```
/// let x: i32 = -4
/// assert_eq(x.unsigned_abs(), 4)
/// ```
fn i32.unsigned_abs(self): u32 {
    if self < 0 {
        let zero: i32 = 0
        return (zero.wrapping_sub(self)) as u32
    }
    self as u32
}

/// `-1`, `0`, or `1` by the sign of `self`.
///
/// ```
/// let x: i32 = -4
/// assert_eq(x.signum(), -1)
/// ```
fn i32.signum(self): i32 {
    if self > 0 {
        return 1
    }
    if self < 0 {
        return 0 - 1
    }
    0
}

/// Whether `self` is greater than 0.
///
/// ```
/// let x: i32 = 3
/// assert(x.is_positive())
/// ```
fn i32.is_positive(self): bool {
    self > 0
}

/// Whether `self` is less than 0.
///
/// ```
/// let x: i32 = -3
/// assert(x.is_negative())
/// assert(!x.is_positive())
/// ```
fn i32.is_negative(self): bool {
    self < 0
}

/// The number of 1 bits.
///
/// ```
/// let x: i32 = 7
/// assert_eq(x.count_ones(), 3)
/// ```
fn i32.count_ones(self): u32 {
    let mut v: u32 = self as u32
    let mut n: u32 = 0
    while v != 0 {
        n = n + (v & 1) as u32
        v = v >> 1
    }
    n
}

/// The number of 0 bits.
///
/// ```
/// let x: i32 = 7
/// assert_eq(x.count_zeros(), 32 - 3)
/// ```
fn i32.count_zeros(self): u32 {
    32 - self.count_ones()
}

/// The number of 0 bits before the first 1 bit, from the top.
///
/// ```
/// let x: i32 = 1
/// assert_eq(x.leading_zeros(), 32 - 1)
/// ```
fn i32.leading_zeros(self): u32 {
    let v: u32 = self as u32
    let mut n: u32 = 0
    let mut i: u32 = 32
    while i > 0 {
        i = i - 1
        if (v >> i) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The number of 0 bits after the last 1 bit, from the bottom.
///
/// ```
/// let x: i32 = 8
/// assert_eq(x.trailing_zeros(), 3)
/// ```
fn i32.trailing_zeros(self): u32 {
    let v: u32 = self as u32
    let mut n: u32 = 0
    while n < 32 {
        if (v >> n) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The bits rotated left by `n % bits` places.
///
/// ```
/// let x: i32 = 1
/// assert_eq(x.rotate_left(1), 2)
/// ```
fn i32.rotate_left(self, n: u32): i32 {
    let v: u32 = self as u32
    let k = n % 32
    if k == 0 {
        return self
    }
    let back: u32 = 32 - k
    ((v << k) | (v >> back)) as i32
}

/// The bits rotated right by `n % bits` places.
///
/// ```
/// let x: i32 = 2
/// assert_eq(x.rotate_right(1), 1)
/// ```
fn i32.rotate_right(self, n: u32): i32 {
    let v: u32 = self as u32
    let k = n % 32
    if k == 0 {
        return self
    }
    let back: u32 = 32 - k
    ((v >> k) | (v << back)) as i32
}

/// The bytes in the opposite order.
///
/// ```
/// let x: i32 = 1
/// assert_eq(x.swap_bytes().swap_bytes(), 1)
/// ```
fn i32.swap_bytes(self): i32 {
    let v: u32 = self as u32
    let mut r: u32 = 0
    let mut i: u32 = 0
    while i < 4 {
        let shift: u32 = 8 * i
        r = (r << 8) | ((v >> shift) & 255)
        i = i + 1
    }
    r as i32
}

/// The bits in the opposite order.
///
/// ```
/// let x: i32 = 1
/// assert_eq(x.reverse_bits().reverse_bits(), 1)
/// ```
fn i32.reverse_bits(self): i32 {
    let v: u32 = self as u32
    let mut r: u32 = 0
    let mut i: u32 = 0
    while i < 32 {
        r = (r << 1) | ((v >> i) & 1)
        i = i + 1
    }
    r as i32
}

/// The integer square root: the greatest `r` with `r * r <= self`. A negative `self` panics.
///
/// ```
/// let x: i32 = 17
/// assert_eq(x.isqrt(), 4)
/// ```
fn i32.isqrt(self): i32 {
    if self < 0 {
        panic("isqrt of a negative number")
    }
    let mut n: u32 = self as u32
    let mut result: u32 = 0
    let mut bit: u32 = 1 << 30
    while bit > n {
        bit = bit >> 2
    }
    while bit != 0 {
        if n >= result + bit {
            n = n - (result + bit)
            result = (result >> 1) + bit
        } else {
            result = result >> 1
        }
        bit = bit >> 2
    }
    result as i32
}

/// The base 2 logarithm rounded down. A `self` that is 0 or negative panics.
///
/// ```
/// let x: i32 = 8
/// assert_eq(x.ilog2(), 3)
/// ```
fn i32.ilog2(self): u32 {
    if self <= 0 {
        panic("ilog2 of a number that is not positive")
    }
    31 - self.leading_zeros()
}

/// The base 10 logarithm rounded down. A `self` that is 0 or negative panics.
///
/// ```
/// let x: i32 = 100
/// assert_eq(x.ilog10(), 2)
/// ```
fn i32.ilog10(self): u32 {
    if self <= 0 {
        panic("ilog10 of a number that is not positive")
    }
    let mut v = self
    let mut n: u32 = 0
    while v >= 10 {
        v = v / 10
        n = n + 1
    }
    n
}

/// The number in the text in base `radix` (2 to 36; any other radix panics). An optional leading `-` is allowed. Any failure (no digits, a character that is not a digit of the base, or a value out of range) is `ParseIntError.Invalid`.
fn __i32_parse_radix(s: str, radix: u32): Result<i32, ParseIntError> {
    if radix < 2 || radix > 36 {
        panic("parse_radix: radix must be 2 to 36")
    }
    let base: i32 = radix as i32
    let mut value: i32 = 0
    let mut seen_digit = false
    let mut negative = false
    let mut first = true
    for c in s.chars() {
        if first {
            first = false
            if c == '-' {
                negative = true
                continue
            }
        }
        match c.to_digit(radix) {
            Option.Some(d) => {
                let digit: i32 = d as i32
                let scaled = value.checked_mul(base)
                if scaled.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                let next = if negative { scaled.unwrap().checked_sub(digit) } else { scaled.unwrap().checked_add(digit) }
                if next.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                value = next.unwrap()
                seen_digit = true
            }
            Option.None => {
                return Result.Err(ParseIntError.Invalid)
            }
        }
    }
    if !seen_digit {
        return Result.Err(ParseIntError.Invalid)
    }
    Result.Ok(value)
}

/// The number written in base `radix` (2 to 36, lowercase digits; any other radix panics), with a leading `-` when negative.
///
/// ```
/// let x: i32 = 11
/// assert_eq(x.to_string_radix(2), String.from("1011"))
/// ```
fn i32.to_string_radix(self, radix: u32): String {
    if radix < 2 || radix > 36 {
        panic("to_string_radix: radix must be 2 to 36")
    }
    let mut out = String.new()
    if self < 0 {
        out.push('-')
    }
    let mut v: u32 = self.unsigned_abs()
    if v == 0 {
        out.push('0')
        return out
    }
    let base: u32 = radix as u32
    let mut digits = List<char>.new()
    while v > 0 {
        let d = (v % base) as u32
        if d < 10 {
            digits.push((48 + d) as char)
        } else {
            digits.push((87 + d) as char)
        }
        v = v / base
    }
    let mut i = digits.len()
    while i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    out
}

/// The bytes in little-endian order.
///
/// ```
/// let x: i32 = 1
/// assert_eq(x.to_le_bytes()[0], 1)
/// ```
fn i32.to_le_bytes(self): [u8; 4] {
    let v: u32 = self as u32
    [((v >> 0) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 24) & 255) as u8]
}

/// The bytes in big-endian order.
///
/// ```
/// let x: i32 = 1
/// assert_eq(x.to_be_bytes()[4 - 1], 1)
/// ```
fn i32.to_be_bytes(self): [u8; 4] {
    let v: u32 = self as u32
    [((v >> 24) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 0) & 255) as u8]
}

/// The bytes in the byte order of the target, which is little-endian on every supported platform.
///
/// ```
/// let x: i32 = 1
/// assert_eq(x.to_ne_bytes()[0], 1)
/// ```
fn i32.to_ne_bytes(self): [u8; 4] {
    self.to_le_bytes()
}

/// The value whose little-endian bytes are `b`.
fn __i32_from_le_bytes(b: [u8; 4]): i32 {
    let v: u32 = ((b[0] as u32) << 0) | ((b[1] as u32) << 8) | ((b[2] as u32) << 16) | ((b[3] as u32) << 24)
    v as i32
}

/// The value whose big-endian bytes are `b`.
fn __i32_from_be_bytes(b: [u8; 4]): i32 {
    let v: u32 = ((b[0] as u32) << 24) | ((b[1] as u32) << 16) | ((b[2] as u32) << 8) | ((b[3] as u32) << 0)
    v as i32
}

/// The value whose native-endian bytes are `b`.
fn __i32_from_ne_bytes(b: [u8; 4]): i32 {
    __i32_from_le_bytes(b)
}

// ---- i64 ----

const __i64_MIN: i64 = -9223372036854775807 - 1
const __i64_MAX: i64 = 9223372036854775807
const __i64_BITS: u32 = 64

/// `self` to the power `exp`. Overflow panics in a debug build and wraps in a release build, like `*`.
///
/// ```
/// let x: i64 = 3
/// assert_eq(x.pow(3), 27)
/// ```
fn i64.pow(self, exp: u32): i64 {
    let mut result: i64 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
///
/// ```
/// let x: i64 = 2
/// assert_eq(x.wrapping_pow(3), 8)
/// ```
fn i64.wrapping_pow(self, exp: u32): i64 {
    let mut result: i64 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result.wrapping_mul(base)
        }
        e = e >> 1
        if e > 0 {
            base = base.wrapping_mul(base)
        }
    }
    result
}

/// `self` to the power `exp`, or `None` on overflow.
///
/// ```
/// let x: i64 = 3
/// assert_eq(x.checked_pow(3), Option.Some(27))
/// ```
fn i64.checked_pow(self, exp: u32): Option<i64> {
    let mut result: i64 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            match result.checked_mul(base) {
                Option.Some(v) => {
                    result = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Option.Some(v) => {
                    base = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
    Option.Some(result)
}

/// `self / other`, or `None` when `other` is 0 or the quotient overflows.
///
/// ```
/// let x: i64 = 7
/// assert_eq(x.checked_div(2), Option.Some(3))
/// assert(x.checked_div(0).is_none())
/// ```
fn i64.checked_div(self, other: i64): Option<i64> {
    if other == 0 || (self == __i64_MIN && other == -1) {
        return Option.None
    }
    Option.Some(self / other)
}

/// `self % other`, or `None` when `other` is 0 or the division overflows.
///
/// ```
/// let x: i64 = 7
/// assert_eq(x.checked_rem(4), Option.Some(3))
/// assert(x.checked_rem(0).is_none())
/// ```
fn i64.checked_rem(self, other: i64): Option<i64> {
    if other == 0 || (self == __i64_MIN && other == -1) {
        return Option.None
    }
    Option.Some(self % other)
}

/// `-self`, or `None` for the minimum value.
///
/// ```
/// let x: i64 = 5
/// assert_eq(x.checked_neg(), Option.Some(-5))
/// ```
fn i64.checked_neg(self): Option<i64> {
    if self == __i64_MIN {
        return Option.None
    }
    Option.Some(0 - self)
}

/// `-self`, wrapping around for the minimum value.
///
/// ```
/// let x: i64 = 1
/// assert_eq(x.wrapping_neg().wrapping_neg(), 1)
/// ```
fn i64.wrapping_neg(self): i64 {
    let zero: i64 = 0
    zero.wrapping_sub(self)
}

/// `self << n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: i64 = 1
/// assert_eq(x.checked_shl(2), Option.Some(4))
/// assert(x.checked_shl(200).is_none())
/// ```
fn i64.checked_shl(self, n: u32): Option<i64> {
    if n >= 64 {
        return Option.None
    }
    Option.Some(self << n)
}

/// `self >> n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: i64 = 8
/// assert_eq(x.checked_shr(2), Option.Some(2))
/// assert(x.checked_shr(200).is_none())
/// ```
fn i64.checked_shr(self, n: u32): Option<i64> {
    if n >= 64 {
        return Option.None
    }
    Option.Some(self >> n)
}

/// `self << (n % bits)`.
///
/// ```
/// let x: i64 = 1
/// assert_eq(x.wrapping_shl(3), 8)
/// ```
fn i64.wrapping_shl(self, n: u32): i64 {
    self << (n % 64)
}

/// `self >> (n % bits)`.
///
/// ```
/// let x: i64 = 16
/// assert_eq(x.wrapping_shr(2), 4)
/// ```
fn i64.wrapping_shr(self, n: u32): i64 {
    self >> (n % 64)
}

/// `self + other`, clamped to the range of the type.
///
/// ```
/// let x: i64 = 2
/// assert_eq(x.saturating_add(3), 5)
/// ```
fn i64.saturating_add(self, other: i64): i64 {
    match self.checked_add(other) {
        Option.Some(v) => v,
        Option.None => {
            if other > 0 {
                __i64_MAX
            } else {
                __i64_MIN
            }
        }
    }
}

/// `self - other`, clamped to the range of the type.
///
/// ```
/// let x: i64 = 5
/// assert_eq(x.saturating_sub(2), 3)
/// ```
fn i64.saturating_sub(self, other: i64): i64 {
    match self.checked_sub(other) {
        Option.Some(v) => v,
        Option.None => {
            if other > 0 {
                __i64_MIN
            } else {
                __i64_MAX
            }
        }
    }
}

/// `self * other`, clamped to the range of the type.
///
/// ```
/// let x: i64 = 2
/// assert_eq(x.saturating_mul(3), 6)
/// ```
fn i64.saturating_mul(self, other: i64): i64 {
    match self.checked_mul(other) {
        Option.Some(v) => v,
        Option.None => {
            if (self < 0) == (other < 0) {
                __i64_MAX
            } else {
                __i64_MIN
            }
        }
    }
}

/// `self` to the power `exp`, clamped to the range of the type.
///
/// ```
/// let x: i64 = 2
/// assert_eq(x.saturating_pow(3), 8)
/// ```
fn i64.saturating_pow(self, exp: u32): i64 {
    match self.checked_pow(exp) {
        Option.Some(v) => v,
        Option.None => {
            if self < 0 && exp % 2 == 1 {
                __i64_MIN
            } else {
                __i64_MAX
            }
        }
    }
}

/// `self + other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i64 = 1
/// assert_eq(x.overflowing_add(2), (3, false))
/// ```
fn i64.overflowing_add(self, other: i64): (i64, bool) {
    (self.wrapping_add(other), self.checked_add(other).is_none())
}

/// `self - other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i64 = 5
/// assert_eq(x.overflowing_sub(2), (3, false))
/// ```
fn i64.overflowing_sub(self, other: i64): (i64, bool) {
    (self.wrapping_sub(other), self.checked_sub(other).is_none())
}

/// `self * other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i64 = 3
/// assert_eq(x.overflowing_mul(4), (12, false))
/// ```
fn i64.overflowing_mul(self, other: i64): (i64, bool) {
    (self.wrapping_mul(other), self.checked_mul(other).is_none())
}

/// The quotient rounded so that the remainder is never negative. Division by 0 panics.
///
/// ```
/// let x: i64 = 7
/// assert_eq(x.div_euclid(2), 3)
/// ```
fn i64.div_euclid(self, other: i64): i64 {
    let q = self / other
    if self % other < 0 {
        if other > 0 {
            return q - 1
        }
        return q + 1
    }
    q
}

/// The remainder, never negative. Division by 0 panics.
///
/// ```
/// let x: i64 = 7
/// assert_eq(x.rem_euclid(4), 3)
/// ```
fn i64.rem_euclid(self, other: i64): i64 {
    let r = self % other
    if r < 0 {
        if other > 0 {
            return r + other
        }
        return r - other
    }
    r
}

/// The distance between `self` and `other`, as the unsigned type.
///
/// ```
/// let x: i64 = 5
/// assert_eq(x.abs_diff(9), 4)
/// ```
fn i64.abs_diff(self, other: i64): u64 {
    if self > other {
        return (self.wrapping_sub(other)) as u64
    }
    (other.wrapping_sub(self)) as u64
}

/// The absolute value as the unsigned type, so the minimum value is representable.
///
/// ```
/// let x: i64 = -4
/// assert_eq(x.unsigned_abs(), 4)
/// ```
fn i64.unsigned_abs(self): u64 {
    if self < 0 {
        let zero: i64 = 0
        return (zero.wrapping_sub(self)) as u64
    }
    self as u64
}

/// `-1`, `0`, or `1` by the sign of `self`.
///
/// ```
/// let x: i64 = -4
/// assert_eq(x.signum(), -1)
/// ```
fn i64.signum(self): i64 {
    if self > 0 {
        return 1
    }
    if self < 0 {
        return 0 - 1
    }
    0
}

/// Whether `self` is greater than 0.
///
/// ```
/// let x: i64 = 3
/// assert(x.is_positive())
/// ```
fn i64.is_positive(self): bool {
    self > 0
}

/// Whether `self` is less than 0.
///
/// ```
/// let x: i64 = -3
/// assert(x.is_negative())
/// assert(!x.is_positive())
/// ```
fn i64.is_negative(self): bool {
    self < 0
}

/// The number of 1 bits.
///
/// ```
/// let x: i64 = 7
/// assert_eq(x.count_ones(), 3)
/// ```
fn i64.count_ones(self): u32 {
    let mut v: u64 = self as u64
    let mut n: u32 = 0
    while v != 0 {
        n = n + (v & 1) as u32
        v = v >> 1
    }
    n
}

/// The number of 0 bits.
///
/// ```
/// let x: i64 = 7
/// assert_eq(x.count_zeros(), 64 - 3)
/// ```
fn i64.count_zeros(self): u32 {
    64 - self.count_ones()
}

/// The number of 0 bits before the first 1 bit, from the top.
///
/// ```
/// let x: i64 = 1
/// assert_eq(x.leading_zeros(), 64 - 1)
/// ```
fn i64.leading_zeros(self): u32 {
    let v: u64 = self as u64
    let mut n: u32 = 0
    let mut i: u32 = 64
    while i > 0 {
        i = i - 1
        if (v >> i) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The number of 0 bits after the last 1 bit, from the bottom.
///
/// ```
/// let x: i64 = 8
/// assert_eq(x.trailing_zeros(), 3)
/// ```
fn i64.trailing_zeros(self): u32 {
    let v: u64 = self as u64
    let mut n: u32 = 0
    while n < 64 {
        if (v >> n) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The bits rotated left by `n % bits` places.
///
/// ```
/// let x: i64 = 1
/// assert_eq(x.rotate_left(1), 2)
/// ```
fn i64.rotate_left(self, n: u32): i64 {
    let v: u64 = self as u64
    let k = n % 64
    if k == 0 {
        return self
    }
    let back: u32 = 64 - k
    ((v << k) | (v >> back)) as i64
}

/// The bits rotated right by `n % bits` places.
///
/// ```
/// let x: i64 = 2
/// assert_eq(x.rotate_right(1), 1)
/// ```
fn i64.rotate_right(self, n: u32): i64 {
    let v: u64 = self as u64
    let k = n % 64
    if k == 0 {
        return self
    }
    let back: u32 = 64 - k
    ((v >> k) | (v << back)) as i64
}

/// The bytes in the opposite order.
///
/// ```
/// let x: i64 = 1
/// assert_eq(x.swap_bytes().swap_bytes(), 1)
/// ```
fn i64.swap_bytes(self): i64 {
    let v: u64 = self as u64
    let mut r: u64 = 0
    let mut i: u32 = 0
    while i < 8 {
        let shift: u32 = 8 * i
        r = (r << 8) | ((v >> shift) & 255)
        i = i + 1
    }
    r as i64
}

/// The bits in the opposite order.
///
/// ```
/// let x: i64 = 1
/// assert_eq(x.reverse_bits().reverse_bits(), 1)
/// ```
fn i64.reverse_bits(self): i64 {
    let v: u64 = self as u64
    let mut r: u64 = 0
    let mut i: u32 = 0
    while i < 64 {
        r = (r << 1) | ((v >> i) & 1)
        i = i + 1
    }
    r as i64
}

/// The integer square root: the greatest `r` with `r * r <= self`. A negative `self` panics.
///
/// ```
/// let x: i64 = 17
/// assert_eq(x.isqrt(), 4)
/// ```
fn i64.isqrt(self): i64 {
    if self < 0 {
        panic("isqrt of a negative number")
    }
    let mut n: u64 = self as u64
    let mut result: u64 = 0
    let mut bit: u64 = 1 << 62
    while bit > n {
        bit = bit >> 2
    }
    while bit != 0 {
        if n >= result + bit {
            n = n - (result + bit)
            result = (result >> 1) + bit
        } else {
            result = result >> 1
        }
        bit = bit >> 2
    }
    result as i64
}

/// The base 2 logarithm rounded down. A `self` that is 0 or negative panics.
///
/// ```
/// let x: i64 = 8
/// assert_eq(x.ilog2(), 3)
/// ```
fn i64.ilog2(self): u32 {
    if self <= 0 {
        panic("ilog2 of a number that is not positive")
    }
    63 - self.leading_zeros()
}

/// The base 10 logarithm rounded down. A `self` that is 0 or negative panics.
///
/// ```
/// let x: i64 = 100
/// assert_eq(x.ilog10(), 2)
/// ```
fn i64.ilog10(self): u32 {
    if self <= 0 {
        panic("ilog10 of a number that is not positive")
    }
    let mut v = self
    let mut n: u32 = 0
    while v >= 10 {
        v = v / 10
        n = n + 1
    }
    n
}

/// The number in the text in base `radix` (2 to 36; any other radix panics). An optional leading `-` is allowed. Any failure (no digits, a character that is not a digit of the base, or a value out of range) is `ParseIntError.Invalid`.
fn __i64_parse_radix(s: str, radix: u32): Result<i64, ParseIntError> {
    if radix < 2 || radix > 36 {
        panic("parse_radix: radix must be 2 to 36")
    }
    let base: i64 = radix as i64
    let mut value: i64 = 0
    let mut seen_digit = false
    let mut negative = false
    let mut first = true
    for c in s.chars() {
        if first {
            first = false
            if c == '-' {
                negative = true
                continue
            }
        }
        match c.to_digit(radix) {
            Option.Some(d) => {
                let digit: i64 = d as i64
                let scaled = value.checked_mul(base)
                if scaled.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                let next = if negative { scaled.unwrap().checked_sub(digit) } else { scaled.unwrap().checked_add(digit) }
                if next.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                value = next.unwrap()
                seen_digit = true
            }
            Option.None => {
                return Result.Err(ParseIntError.Invalid)
            }
        }
    }
    if !seen_digit {
        return Result.Err(ParseIntError.Invalid)
    }
    Result.Ok(value)
}

/// The number written in base `radix` (2 to 36, lowercase digits; any other radix panics), with a leading `-` when negative.
///
/// ```
/// let x: i64 = 11
/// assert_eq(x.to_string_radix(2), String.from("1011"))
/// ```
fn i64.to_string_radix(self, radix: u32): String {
    if radix < 2 || radix > 36 {
        panic("to_string_radix: radix must be 2 to 36")
    }
    let mut out = String.new()
    if self < 0 {
        out.push('-')
    }
    let mut v: u64 = self.unsigned_abs()
    if v == 0 {
        out.push('0')
        return out
    }
    let base: u64 = radix as u64
    let mut digits = List<char>.new()
    while v > 0 {
        let d = (v % base) as u32
        if d < 10 {
            digits.push((48 + d) as char)
        } else {
            digits.push((87 + d) as char)
        }
        v = v / base
    }
    let mut i = digits.len()
    while i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    out
}

/// The bytes in little-endian order.
///
/// ```
/// let x: i64 = 1
/// assert_eq(x.to_le_bytes()[0], 1)
/// ```
fn i64.to_le_bytes(self): [u8; 8] {
    let v: u64 = self as u64
    [((v >> 0) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 24) & 255) as u8, ((v >> 32) & 255) as u8, ((v >> 40) & 255) as u8, ((v >> 48) & 255) as u8, ((v >> 56) & 255) as u8]
}

/// The bytes in big-endian order.
///
/// ```
/// let x: i64 = 1
/// assert_eq(x.to_be_bytes()[8 - 1], 1)
/// ```
fn i64.to_be_bytes(self): [u8; 8] {
    let v: u64 = self as u64
    [((v >> 56) & 255) as u8, ((v >> 48) & 255) as u8, ((v >> 40) & 255) as u8, ((v >> 32) & 255) as u8, ((v >> 24) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 0) & 255) as u8]
}

/// The bytes in the byte order of the target, which is little-endian on every supported platform.
///
/// ```
/// let x: i64 = 1
/// assert_eq(x.to_ne_bytes()[0], 1)
/// ```
fn i64.to_ne_bytes(self): [u8; 8] {
    self.to_le_bytes()
}

/// The value whose little-endian bytes are `b`.
fn __i64_from_le_bytes(b: [u8; 8]): i64 {
    let v: u64 = ((b[0] as u64) << 0) | ((b[1] as u64) << 8) | ((b[2] as u64) << 16) | ((b[3] as u64) << 24) | ((b[4] as u64) << 32) | ((b[5] as u64) << 40) | ((b[6] as u64) << 48) | ((b[7] as u64) << 56)
    v as i64
}

/// The value whose big-endian bytes are `b`.
fn __i64_from_be_bytes(b: [u8; 8]): i64 {
    let v: u64 = ((b[0] as u64) << 56) | ((b[1] as u64) << 48) | ((b[2] as u64) << 40) | ((b[3] as u64) << 32) | ((b[4] as u64) << 24) | ((b[5] as u64) << 16) | ((b[6] as u64) << 8) | ((b[7] as u64) << 0)
    v as i64
}

/// The value whose native-endian bytes are `b`.
fn __i64_from_ne_bytes(b: [u8; 8]): i64 {
    __i64_from_le_bytes(b)
}

// ---- i128 ----

const __i128_MIN: i128 = -170141183460469231731687303715884105727 - 1
const __i128_MAX: i128 = 170141183460469231731687303715884105727
const __i128_BITS: u32 = 128

/// `self` to the power `exp`. Overflow panics in a debug build and wraps in a release build, like `*`.
///
/// ```
/// let x: i128 = 3
/// assert_eq(x.pow(3), 27)
/// ```
fn i128.pow(self, exp: u32): i128 {
    let mut result: i128 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
///
/// ```
/// let x: i128 = 2
/// assert_eq(x.wrapping_pow(3), 8)
/// ```
fn i128.wrapping_pow(self, exp: u32): i128 {
    let mut result: i128 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result.wrapping_mul(base)
        }
        e = e >> 1
        if e > 0 {
            base = base.wrapping_mul(base)
        }
    }
    result
}

/// `self` to the power `exp`, or `None` on overflow.
///
/// ```
/// let x: i128 = 3
/// assert_eq(x.checked_pow(3), Option.Some(27))
/// ```
fn i128.checked_pow(self, exp: u32): Option<i128> {
    let mut result: i128 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            match result.checked_mul(base) {
                Option.Some(v) => {
                    result = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Option.Some(v) => {
                    base = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
    Option.Some(result)
}

/// `self / other`, or `None` when `other` is 0 or the quotient overflows.
///
/// ```
/// let x: i128 = 7
/// assert_eq(x.checked_div(2), Option.Some(3))
/// assert(x.checked_div(0).is_none())
/// ```
fn i128.checked_div(self, other: i128): Option<i128> {
    if other == 0 || (self == __i128_MIN && other == -1) {
        return Option.None
    }
    Option.Some(self / other)
}

/// `self % other`, or `None` when `other` is 0 or the division overflows.
///
/// ```
/// let x: i128 = 7
/// assert_eq(x.checked_rem(4), Option.Some(3))
/// assert(x.checked_rem(0).is_none())
/// ```
fn i128.checked_rem(self, other: i128): Option<i128> {
    if other == 0 || (self == __i128_MIN && other == -1) {
        return Option.None
    }
    Option.Some(self % other)
}

/// `-self`, or `None` for the minimum value.
///
/// ```
/// let x: i128 = 5
/// assert_eq(x.checked_neg(), Option.Some(-5))
/// ```
fn i128.checked_neg(self): Option<i128> {
    if self == __i128_MIN {
        return Option.None
    }
    Option.Some(0 - self)
}

/// `-self`, wrapping around for the minimum value.
///
/// ```
/// let x: i128 = 1
/// assert_eq(x.wrapping_neg().wrapping_neg(), 1)
/// ```
fn i128.wrapping_neg(self): i128 {
    let zero: i128 = 0
    zero.wrapping_sub(self)
}

/// `self << n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: i128 = 1
/// assert_eq(x.checked_shl(2), Option.Some(4))
/// assert(x.checked_shl(200).is_none())
/// ```
fn i128.checked_shl(self, n: u32): Option<i128> {
    if n >= 128 {
        return Option.None
    }
    Option.Some(self << n)
}

/// `self >> n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: i128 = 8
/// assert_eq(x.checked_shr(2), Option.Some(2))
/// assert(x.checked_shr(200).is_none())
/// ```
fn i128.checked_shr(self, n: u32): Option<i128> {
    if n >= 128 {
        return Option.None
    }
    Option.Some(self >> n)
}

/// `self << (n % bits)`.
///
/// ```
/// let x: i128 = 1
/// assert_eq(x.wrapping_shl(3), 8)
/// ```
fn i128.wrapping_shl(self, n: u32): i128 {
    self << (n % 128)
}

/// `self >> (n % bits)`.
///
/// ```
/// let x: i128 = 16
/// assert_eq(x.wrapping_shr(2), 4)
/// ```
fn i128.wrapping_shr(self, n: u32): i128 {
    self >> (n % 128)
}

/// `self + other`, clamped to the range of the type.
///
/// ```
/// let x: i128 = 2
/// assert_eq(x.saturating_add(3), 5)
/// ```
fn i128.saturating_add(self, other: i128): i128 {
    match self.checked_add(other) {
        Option.Some(v) => v,
        Option.None => {
            if other > 0 {
                __i128_MAX
            } else {
                __i128_MIN
            }
        }
    }
}

/// `self - other`, clamped to the range of the type.
///
/// ```
/// let x: i128 = 5
/// assert_eq(x.saturating_sub(2), 3)
/// ```
fn i128.saturating_sub(self, other: i128): i128 {
    match self.checked_sub(other) {
        Option.Some(v) => v,
        Option.None => {
            if other > 0 {
                __i128_MIN
            } else {
                __i128_MAX
            }
        }
    }
}

/// `self * other`, clamped to the range of the type.
///
/// ```
/// let x: i128 = 2
/// assert_eq(x.saturating_mul(3), 6)
/// ```
fn i128.saturating_mul(self, other: i128): i128 {
    match self.checked_mul(other) {
        Option.Some(v) => v,
        Option.None => {
            if (self < 0) == (other < 0) {
                __i128_MAX
            } else {
                __i128_MIN
            }
        }
    }
}

/// `self` to the power `exp`, clamped to the range of the type.
///
/// ```
/// let x: i128 = 2
/// assert_eq(x.saturating_pow(3), 8)
/// ```
fn i128.saturating_pow(self, exp: u32): i128 {
    match self.checked_pow(exp) {
        Option.Some(v) => v,
        Option.None => {
            if self < 0 && exp % 2 == 1 {
                __i128_MIN
            } else {
                __i128_MAX
            }
        }
    }
}

/// `self + other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i128 = 1
/// assert_eq(x.overflowing_add(2), (3, false))
/// ```
fn i128.overflowing_add(self, other: i128): (i128, bool) {
    (self.wrapping_add(other), self.checked_add(other).is_none())
}

/// `self - other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i128 = 5
/// assert_eq(x.overflowing_sub(2), (3, false))
/// ```
fn i128.overflowing_sub(self, other: i128): (i128, bool) {
    (self.wrapping_sub(other), self.checked_sub(other).is_none())
}

/// `self * other` wrapped, and whether it overflowed.
///
/// ```
/// let x: i128 = 3
/// assert_eq(x.overflowing_mul(4), (12, false))
/// ```
fn i128.overflowing_mul(self, other: i128): (i128, bool) {
    (self.wrapping_mul(other), self.checked_mul(other).is_none())
}

/// The quotient rounded so that the remainder is never negative. Division by 0 panics.
///
/// ```
/// let x: i128 = 7
/// assert_eq(x.div_euclid(2), 3)
/// ```
fn i128.div_euclid(self, other: i128): i128 {
    let q = self / other
    if self % other < 0 {
        if other > 0 {
            return q - 1
        }
        return q + 1
    }
    q
}

/// The remainder, never negative. Division by 0 panics.
///
/// ```
/// let x: i128 = 7
/// assert_eq(x.rem_euclid(4), 3)
/// ```
fn i128.rem_euclid(self, other: i128): i128 {
    let r = self % other
    if r < 0 {
        if other > 0 {
            return r + other
        }
        return r - other
    }
    r
}

/// The distance between `self` and `other`, as the unsigned type.
///
/// ```
/// let x: i128 = 5
/// assert_eq(x.abs_diff(9), 4)
/// ```
fn i128.abs_diff(self, other: i128): u128 {
    if self > other {
        return (self.wrapping_sub(other)) as u128
    }
    (other.wrapping_sub(self)) as u128
}

/// The absolute value as the unsigned type, so the minimum value is representable.
///
/// ```
/// let x: i128 = -4
/// assert_eq(x.unsigned_abs(), 4)
/// ```
fn i128.unsigned_abs(self): u128 {
    if self < 0 {
        let zero: i128 = 0
        return (zero.wrapping_sub(self)) as u128
    }
    self as u128
}

/// `-1`, `0`, or `1` by the sign of `self`.
///
/// ```
/// let x: i128 = -4
/// assert_eq(x.signum(), -1)
/// ```
fn i128.signum(self): i128 {
    if self > 0 {
        return 1
    }
    if self < 0 {
        return 0 - 1
    }
    0
}

/// Whether `self` is greater than 0.
///
/// ```
/// let x: i128 = 3
/// assert(x.is_positive())
/// ```
fn i128.is_positive(self): bool {
    self > 0
}

/// Whether `self` is less than 0.
///
/// ```
/// let x: i128 = -3
/// assert(x.is_negative())
/// assert(!x.is_positive())
/// ```
fn i128.is_negative(self): bool {
    self < 0
}

/// The number of 1 bits.
///
/// ```
/// let x: i128 = 7
/// assert_eq(x.count_ones(), 3)
/// ```
fn i128.count_ones(self): u32 {
    let mut v: u128 = self as u128
    let mut n: u32 = 0
    while v != 0 {
        n = n + (v & 1) as u32
        v = v >> 1
    }
    n
}

/// The number of 0 bits.
///
/// ```
/// let x: i128 = 7
/// assert_eq(x.count_zeros(), 128 - 3)
/// ```
fn i128.count_zeros(self): u32 {
    128 - self.count_ones()
}

/// The number of 0 bits before the first 1 bit, from the top.
///
/// ```
/// let x: i128 = 1
/// assert_eq(x.leading_zeros(), 128 - 1)
/// ```
fn i128.leading_zeros(self): u32 {
    let v: u128 = self as u128
    let mut n: u32 = 0
    let mut i: u32 = 128
    while i > 0 {
        i = i - 1
        if (v >> i) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The number of 0 bits after the last 1 bit, from the bottom.
///
/// ```
/// let x: i128 = 8
/// assert_eq(x.trailing_zeros(), 3)
/// ```
fn i128.trailing_zeros(self): u32 {
    let v: u128 = self as u128
    let mut n: u32 = 0
    while n < 128 {
        if (v >> n) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The bits rotated left by `n % bits` places.
///
/// ```
/// let x: i128 = 1
/// assert_eq(x.rotate_left(1), 2)
/// ```
fn i128.rotate_left(self, n: u32): i128 {
    let v: u128 = self as u128
    let k = n % 128
    if k == 0 {
        return self
    }
    let back: u32 = 128 - k
    ((v << k) | (v >> back)) as i128
}

/// The bits rotated right by `n % bits` places.
///
/// ```
/// let x: i128 = 2
/// assert_eq(x.rotate_right(1), 1)
/// ```
fn i128.rotate_right(self, n: u32): i128 {
    let v: u128 = self as u128
    let k = n % 128
    if k == 0 {
        return self
    }
    let back: u32 = 128 - k
    ((v >> k) | (v << back)) as i128
}

/// The bytes in the opposite order.
///
/// ```
/// let x: i128 = 1
/// assert_eq(x.swap_bytes().swap_bytes(), 1)
/// ```
fn i128.swap_bytes(self): i128 {
    let v: u128 = self as u128
    let mut r: u128 = 0
    let mut i: u32 = 0
    while i < 16 {
        let shift: u32 = 8 * i
        r = (r << 8) | ((v >> shift) & 255)
        i = i + 1
    }
    r as i128
}

/// The bits in the opposite order.
///
/// ```
/// let x: i128 = 1
/// assert_eq(x.reverse_bits().reverse_bits(), 1)
/// ```
fn i128.reverse_bits(self): i128 {
    let v: u128 = self as u128
    let mut r: u128 = 0
    let mut i: u32 = 0
    while i < 128 {
        r = (r << 1) | ((v >> i) & 1)
        i = i + 1
    }
    r as i128
}

/// The integer square root: the greatest `r` with `r * r <= self`. A negative `self` panics.
///
/// ```
/// let x: i128 = 17
/// assert_eq(x.isqrt(), 4)
/// ```
fn i128.isqrt(self): i128 {
    if self < 0 {
        panic("isqrt of a negative number")
    }
    let mut n: u128 = self as u128
    let mut result: u128 = 0
    let mut bit: u128 = 1 << 126
    while bit > n {
        bit = bit >> 2
    }
    while bit != 0 {
        if n >= result + bit {
            n = n - (result + bit)
            result = (result >> 1) + bit
        } else {
            result = result >> 1
        }
        bit = bit >> 2
    }
    result as i128
}

/// The base 2 logarithm rounded down. A `self` that is 0 or negative panics.
///
/// ```
/// let x: i128 = 8
/// assert_eq(x.ilog2(), 3)
/// ```
fn i128.ilog2(self): u32 {
    if self <= 0 {
        panic("ilog2 of a number that is not positive")
    }
    127 - self.leading_zeros()
}

/// The base 10 logarithm rounded down. A `self` that is 0 or negative panics.
///
/// ```
/// let x: i128 = 100
/// assert_eq(x.ilog10(), 2)
/// ```
fn i128.ilog10(self): u32 {
    if self <= 0 {
        panic("ilog10 of a number that is not positive")
    }
    let mut v = self
    let mut n: u32 = 0
    while v >= 10 {
        v = v / 10
        n = n + 1
    }
    n
}

/// The number in the text in base `radix` (2 to 36; any other radix panics). An optional leading `-` is allowed. Any failure (no digits, a character that is not a digit of the base, or a value out of range) is `ParseIntError.Invalid`.
fn __i128_parse_radix(s: str, radix: u32): Result<i128, ParseIntError> {
    if radix < 2 || radix > 36 {
        panic("parse_radix: radix must be 2 to 36")
    }
    let base: i128 = radix as i128
    let mut value: i128 = 0
    let mut seen_digit = false
    let mut negative = false
    let mut first = true
    for c in s.chars() {
        if first {
            first = false
            if c == '-' {
                negative = true
                continue
            }
        }
        match c.to_digit(radix) {
            Option.Some(d) => {
                let digit: i128 = d as i128
                let scaled = value.checked_mul(base)
                if scaled.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                let next = if negative { scaled.unwrap().checked_sub(digit) } else { scaled.unwrap().checked_add(digit) }
                if next.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                value = next.unwrap()
                seen_digit = true
            }
            Option.None => {
                return Result.Err(ParseIntError.Invalid)
            }
        }
    }
    if !seen_digit {
        return Result.Err(ParseIntError.Invalid)
    }
    Result.Ok(value)
}

/// The number written in base `radix` (2 to 36, lowercase digits; any other radix panics), with a leading `-` when negative.
///
/// ```
/// let x: i128 = 11
/// assert_eq(x.to_string_radix(2), String.from("1011"))
/// ```
fn i128.to_string_radix(self, radix: u32): String {
    if radix < 2 || radix > 36 {
        panic("to_string_radix: radix must be 2 to 36")
    }
    let mut out = String.new()
    if self < 0 {
        out.push('-')
    }
    let mut v: u128 = self.unsigned_abs()
    if v == 0 {
        out.push('0')
        return out
    }
    let base: u128 = radix as u128
    let mut digits = List<char>.new()
    while v > 0 {
        let d = (v % base) as u32
        if d < 10 {
            digits.push((48 + d) as char)
        } else {
            digits.push((87 + d) as char)
        }
        v = v / base
    }
    let mut i = digits.len()
    while i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    out
}

/// The bytes in little-endian order.
///
/// ```
/// let x: i128 = 1
/// assert_eq(x.to_le_bytes()[0], 1)
/// ```
fn i128.to_le_bytes(self): [u8; 16] {
    let v: u128 = self as u128
    [((v >> 0) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 24) & 255) as u8, ((v >> 32) & 255) as u8, ((v >> 40) & 255) as u8, ((v >> 48) & 255) as u8, ((v >> 56) & 255) as u8, ((v >> 64) & 255) as u8, ((v >> 72) & 255) as u8, ((v >> 80) & 255) as u8, ((v >> 88) & 255) as u8, ((v >> 96) & 255) as u8, ((v >> 104) & 255) as u8, ((v >> 112) & 255) as u8, ((v >> 120) & 255) as u8]
}

/// The bytes in big-endian order.
///
/// ```
/// let x: i128 = 1
/// assert_eq(x.to_be_bytes()[16 - 1], 1)
/// ```
fn i128.to_be_bytes(self): [u8; 16] {
    let v: u128 = self as u128
    [((v >> 120) & 255) as u8, ((v >> 112) & 255) as u8, ((v >> 104) & 255) as u8, ((v >> 96) & 255) as u8, ((v >> 88) & 255) as u8, ((v >> 80) & 255) as u8, ((v >> 72) & 255) as u8, ((v >> 64) & 255) as u8, ((v >> 56) & 255) as u8, ((v >> 48) & 255) as u8, ((v >> 40) & 255) as u8, ((v >> 32) & 255) as u8, ((v >> 24) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 0) & 255) as u8]
}

/// The bytes in the byte order of the target, which is little-endian on every supported platform.
///
/// ```
/// let x: i128 = 1
/// assert_eq(x.to_ne_bytes()[0], 1)
/// ```
fn i128.to_ne_bytes(self): [u8; 16] {
    self.to_le_bytes()
}

/// The value whose little-endian bytes are `b`.
fn __i128_from_le_bytes(b: [u8; 16]): i128 {
    let v: u128 = ((b[0] as u128) << 0) | ((b[1] as u128) << 8) | ((b[2] as u128) << 16) | ((b[3] as u128) << 24) | ((b[4] as u128) << 32) | ((b[5] as u128) << 40) | ((b[6] as u128) << 48) | ((b[7] as u128) << 56) | ((b[8] as u128) << 64) | ((b[9] as u128) << 72) | ((b[10] as u128) << 80) | ((b[11] as u128) << 88) | ((b[12] as u128) << 96) | ((b[13] as u128) << 104) | ((b[14] as u128) << 112) | ((b[15] as u128) << 120)
    v as i128
}

/// The value whose big-endian bytes are `b`.
fn __i128_from_be_bytes(b: [u8; 16]): i128 {
    let v: u128 = ((b[0] as u128) << 120) | ((b[1] as u128) << 112) | ((b[2] as u128) << 104) | ((b[3] as u128) << 96) | ((b[4] as u128) << 88) | ((b[5] as u128) << 80) | ((b[6] as u128) << 72) | ((b[7] as u128) << 64) | ((b[8] as u128) << 56) | ((b[9] as u128) << 48) | ((b[10] as u128) << 40) | ((b[11] as u128) << 32) | ((b[12] as u128) << 24) | ((b[13] as u128) << 16) | ((b[14] as u128) << 8) | ((b[15] as u128) << 0)
    v as i128
}

/// The value whose native-endian bytes are `b`.
fn __i128_from_ne_bytes(b: [u8; 16]): i128 {
    __i128_from_le_bytes(b)
}

// ---- isize ----

const __isize_MIN: isize = -9223372036854775807 - 1
const __isize_MAX: isize = 9223372036854775807
const __isize_BITS: u32 = 64

/// `self` to the power `exp`. Overflow panics in a debug build and wraps in a release build, like `*`.
///
/// ```
/// let x: isize = 3
/// assert_eq(x.pow(3), 27)
/// ```
fn isize.pow(self, exp: u32): isize {
    let mut result: isize = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
///
/// ```
/// let x: isize = 2
/// assert_eq(x.wrapping_pow(3), 8)
/// ```
fn isize.wrapping_pow(self, exp: u32): isize {
    let mut result: isize = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result.wrapping_mul(base)
        }
        e = e >> 1
        if e > 0 {
            base = base.wrapping_mul(base)
        }
    }
    result
}

/// `self` to the power `exp`, or `None` on overflow.
///
/// ```
/// let x: isize = 3
/// assert_eq(x.checked_pow(3), Option.Some(27))
/// ```
fn isize.checked_pow(self, exp: u32): Option<isize> {
    let mut result: isize = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            match result.checked_mul(base) {
                Option.Some(v) => {
                    result = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Option.Some(v) => {
                    base = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
    Option.Some(result)
}

/// `self / other`, or `None` when `other` is 0 or the quotient overflows.
///
/// ```
/// let x: isize = 7
/// assert_eq(x.checked_div(2), Option.Some(3))
/// assert(x.checked_div(0).is_none())
/// ```
fn isize.checked_div(self, other: isize): Option<isize> {
    if other == 0 || (self == __isize_MIN && other == -1) {
        return Option.None
    }
    Option.Some(self / other)
}

/// `self % other`, or `None` when `other` is 0 or the division overflows.
///
/// ```
/// let x: isize = 7
/// assert_eq(x.checked_rem(4), Option.Some(3))
/// assert(x.checked_rem(0).is_none())
/// ```
fn isize.checked_rem(self, other: isize): Option<isize> {
    if other == 0 || (self == __isize_MIN && other == -1) {
        return Option.None
    }
    Option.Some(self % other)
}

/// `-self`, or `None` for the minimum value.
///
/// ```
/// let x: isize = 5
/// assert_eq(x.checked_neg(), Option.Some(-5))
/// ```
fn isize.checked_neg(self): Option<isize> {
    if self == __isize_MIN {
        return Option.None
    }
    Option.Some(0 - self)
}

/// `-self`, wrapping around for the minimum value.
///
/// ```
/// let x: isize = 1
/// assert_eq(x.wrapping_neg().wrapping_neg(), 1)
/// ```
fn isize.wrapping_neg(self): isize {
    let zero: isize = 0
    zero.wrapping_sub(self)
}

/// `self << n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: isize = 1
/// assert_eq(x.checked_shl(2), Option.Some(4))
/// assert(x.checked_shl(200).is_none())
/// ```
fn isize.checked_shl(self, n: u32): Option<isize> {
    if n >= 64 {
        return Option.None
    }
    Option.Some(self << n)
}

/// `self >> n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: isize = 8
/// assert_eq(x.checked_shr(2), Option.Some(2))
/// assert(x.checked_shr(200).is_none())
/// ```
fn isize.checked_shr(self, n: u32): Option<isize> {
    if n >= 64 {
        return Option.None
    }
    Option.Some(self >> n)
}

/// `self << (n % bits)`.
///
/// ```
/// let x: isize = 1
/// assert_eq(x.wrapping_shl(3), 8)
/// ```
fn isize.wrapping_shl(self, n: u32): isize {
    self << (n % 64)
}

/// `self >> (n % bits)`.
///
/// ```
/// let x: isize = 16
/// assert_eq(x.wrapping_shr(2), 4)
/// ```
fn isize.wrapping_shr(self, n: u32): isize {
    self >> (n % 64)
}

/// `self + other`, clamped to the range of the type.
///
/// ```
/// let x: isize = 2
/// assert_eq(x.saturating_add(3), 5)
/// ```
fn isize.saturating_add(self, other: isize): isize {
    match self.checked_add(other) {
        Option.Some(v) => v,
        Option.None => {
            if other > 0 {
                __isize_MAX
            } else {
                __isize_MIN
            }
        }
    }
}

/// `self - other`, clamped to the range of the type.
///
/// ```
/// let x: isize = 5
/// assert_eq(x.saturating_sub(2), 3)
/// ```
fn isize.saturating_sub(self, other: isize): isize {
    match self.checked_sub(other) {
        Option.Some(v) => v,
        Option.None => {
            if other > 0 {
                __isize_MIN
            } else {
                __isize_MAX
            }
        }
    }
}

/// `self * other`, clamped to the range of the type.
///
/// ```
/// let x: isize = 2
/// assert_eq(x.saturating_mul(3), 6)
/// ```
fn isize.saturating_mul(self, other: isize): isize {
    match self.checked_mul(other) {
        Option.Some(v) => v,
        Option.None => {
            if (self < 0) == (other < 0) {
                __isize_MAX
            } else {
                __isize_MIN
            }
        }
    }
}

/// `self` to the power `exp`, clamped to the range of the type.
///
/// ```
/// let x: isize = 2
/// assert_eq(x.saturating_pow(3), 8)
/// ```
fn isize.saturating_pow(self, exp: u32): isize {
    match self.checked_pow(exp) {
        Option.Some(v) => v,
        Option.None => {
            if self < 0 && exp % 2 == 1 {
                __isize_MIN
            } else {
                __isize_MAX
            }
        }
    }
}

/// `self + other` wrapped, and whether it overflowed.
///
/// ```
/// let x: isize = 1
/// assert_eq(x.overflowing_add(2), (3, false))
/// ```
fn isize.overflowing_add(self, other: isize): (isize, bool) {
    (self.wrapping_add(other), self.checked_add(other).is_none())
}

/// `self - other` wrapped, and whether it overflowed.
///
/// ```
/// let x: isize = 5
/// assert_eq(x.overflowing_sub(2), (3, false))
/// ```
fn isize.overflowing_sub(self, other: isize): (isize, bool) {
    (self.wrapping_sub(other), self.checked_sub(other).is_none())
}

/// `self * other` wrapped, and whether it overflowed.
///
/// ```
/// let x: isize = 3
/// assert_eq(x.overflowing_mul(4), (12, false))
/// ```
fn isize.overflowing_mul(self, other: isize): (isize, bool) {
    (self.wrapping_mul(other), self.checked_mul(other).is_none())
}

/// The quotient rounded so that the remainder is never negative. Division by 0 panics.
///
/// ```
/// let x: isize = 7
/// assert_eq(x.div_euclid(2), 3)
/// ```
fn isize.div_euclid(self, other: isize): isize {
    let q = self / other
    if self % other < 0 {
        if other > 0 {
            return q - 1
        }
        return q + 1
    }
    q
}

/// The remainder, never negative. Division by 0 panics.
///
/// ```
/// let x: isize = 7
/// assert_eq(x.rem_euclid(4), 3)
/// ```
fn isize.rem_euclid(self, other: isize): isize {
    let r = self % other
    if r < 0 {
        if other > 0 {
            return r + other
        }
        return r - other
    }
    r
}

/// The distance between `self` and `other`, as the unsigned type.
///
/// ```
/// let x: isize = 5
/// assert_eq(x.abs_diff(9), 4)
/// ```
fn isize.abs_diff(self, other: isize): usize {
    if self > other {
        return (self.wrapping_sub(other)) as usize
    }
    (other.wrapping_sub(self)) as usize
}

/// The absolute value as the unsigned type, so the minimum value is representable.
///
/// ```
/// let x: isize = -4
/// assert_eq(x.unsigned_abs(), 4)
/// ```
fn isize.unsigned_abs(self): usize {
    if self < 0 {
        let zero: isize = 0
        return (zero.wrapping_sub(self)) as usize
    }
    self as usize
}

/// `-1`, `0`, or `1` by the sign of `self`.
///
/// ```
/// let x: isize = -4
/// assert_eq(x.signum(), -1)
/// ```
fn isize.signum(self): isize {
    if self > 0 {
        return 1
    }
    if self < 0 {
        return 0 - 1
    }
    0
}

/// Whether `self` is greater than 0.
///
/// ```
/// let x: isize = 3
/// assert(x.is_positive())
/// ```
fn isize.is_positive(self): bool {
    self > 0
}

/// Whether `self` is less than 0.
///
/// ```
/// let x: isize = -3
/// assert(x.is_negative())
/// assert(!x.is_positive())
/// ```
fn isize.is_negative(self): bool {
    self < 0
}

/// The number of 1 bits.
///
/// ```
/// let x: isize = 7
/// assert_eq(x.count_ones(), 3)
/// ```
fn isize.count_ones(self): u32 {
    let mut v: usize = self as usize
    let mut n: u32 = 0
    while v != 0 {
        n = n + (v & 1) as u32
        v = v >> 1
    }
    n
}

/// The number of 0 bits.
///
/// ```
/// let x: isize = 7
/// assert_eq(x.count_zeros(), 64 - 3)
/// ```
fn isize.count_zeros(self): u32 {
    64 - self.count_ones()
}

/// The number of 0 bits before the first 1 bit, from the top.
///
/// ```
/// let x: isize = 1
/// assert_eq(x.leading_zeros(), 64 - 1)
/// ```
fn isize.leading_zeros(self): u32 {
    let v: usize = self as usize
    let mut n: u32 = 0
    let mut i: u32 = 64
    while i > 0 {
        i = i - 1
        if (v >> i) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The number of 0 bits after the last 1 bit, from the bottom.
///
/// ```
/// let x: isize = 8
/// assert_eq(x.trailing_zeros(), 3)
/// ```
fn isize.trailing_zeros(self): u32 {
    let v: usize = self as usize
    let mut n: u32 = 0
    while n < 64 {
        if (v >> n) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The bits rotated left by `n % bits` places.
///
/// ```
/// let x: isize = 1
/// assert_eq(x.rotate_left(1), 2)
/// ```
fn isize.rotate_left(self, n: u32): isize {
    let v: usize = self as usize
    let k = n % 64
    if k == 0 {
        return self
    }
    let back: u32 = 64 - k
    ((v << k) | (v >> back)) as isize
}

/// The bits rotated right by `n % bits` places.
///
/// ```
/// let x: isize = 2
/// assert_eq(x.rotate_right(1), 1)
/// ```
fn isize.rotate_right(self, n: u32): isize {
    let v: usize = self as usize
    let k = n % 64
    if k == 0 {
        return self
    }
    let back: u32 = 64 - k
    ((v >> k) | (v << back)) as isize
}

/// The bytes in the opposite order.
///
/// ```
/// let x: isize = 1
/// assert_eq(x.swap_bytes().swap_bytes(), 1)
/// ```
fn isize.swap_bytes(self): isize {
    let v: usize = self as usize
    let mut r: usize = 0
    let mut i: u32 = 0
    while i < 8 {
        let shift: u32 = 8 * i
        r = (r << 8) | ((v >> shift) & 255)
        i = i + 1
    }
    r as isize
}

/// The bits in the opposite order.
///
/// ```
/// let x: isize = 1
/// assert_eq(x.reverse_bits().reverse_bits(), 1)
/// ```
fn isize.reverse_bits(self): isize {
    let v: usize = self as usize
    let mut r: usize = 0
    let mut i: u32 = 0
    while i < 64 {
        r = (r << 1) | ((v >> i) & 1)
        i = i + 1
    }
    r as isize
}

/// The integer square root: the greatest `r` with `r * r <= self`. A negative `self` panics.
///
/// ```
/// let x: isize = 17
/// assert_eq(x.isqrt(), 4)
/// ```
fn isize.isqrt(self): isize {
    if self < 0 {
        panic("isqrt of a negative number")
    }
    let mut n: usize = self as usize
    let mut result: usize = 0
    let mut bit: usize = 1 << 62
    while bit > n {
        bit = bit >> 2
    }
    while bit != 0 {
        if n >= result + bit {
            n = n - (result + bit)
            result = (result >> 1) + bit
        } else {
            result = result >> 1
        }
        bit = bit >> 2
    }
    result as isize
}

/// The base 2 logarithm rounded down. A `self` that is 0 or negative panics.
///
/// ```
/// let x: isize = 8
/// assert_eq(x.ilog2(), 3)
/// ```
fn isize.ilog2(self): u32 {
    if self <= 0 {
        panic("ilog2 of a number that is not positive")
    }
    63 - self.leading_zeros()
}

/// The base 10 logarithm rounded down. A `self` that is 0 or negative panics.
///
/// ```
/// let x: isize = 100
/// assert_eq(x.ilog10(), 2)
/// ```
fn isize.ilog10(self): u32 {
    if self <= 0 {
        panic("ilog10 of a number that is not positive")
    }
    let mut v = self
    let mut n: u32 = 0
    while v >= 10 {
        v = v / 10
        n = n + 1
    }
    n
}

/// The number in the text in base `radix` (2 to 36; any other radix panics). An optional leading `-` is allowed. Any failure (no digits, a character that is not a digit of the base, or a value out of range) is `ParseIntError.Invalid`.
fn __isize_parse_radix(s: str, radix: u32): Result<isize, ParseIntError> {
    if radix < 2 || radix > 36 {
        panic("parse_radix: radix must be 2 to 36")
    }
    let base: isize = radix as isize
    let mut value: isize = 0
    let mut seen_digit = false
    let mut negative = false
    let mut first = true
    for c in s.chars() {
        if first {
            first = false
            if c == '-' {
                negative = true
                continue
            }
        }
        match c.to_digit(radix) {
            Option.Some(d) => {
                let digit: isize = d as isize
                let scaled = value.checked_mul(base)
                if scaled.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                let next = if negative { scaled.unwrap().checked_sub(digit) } else { scaled.unwrap().checked_add(digit) }
                if next.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                value = next.unwrap()
                seen_digit = true
            }
            Option.None => {
                return Result.Err(ParseIntError.Invalid)
            }
        }
    }
    if !seen_digit {
        return Result.Err(ParseIntError.Invalid)
    }
    Result.Ok(value)
}

/// The number written in base `radix` (2 to 36, lowercase digits; any other radix panics), with a leading `-` when negative.
///
/// ```
/// let x: isize = 11
/// assert_eq(x.to_string_radix(2), String.from("1011"))
/// ```
fn isize.to_string_radix(self, radix: u32): String {
    if radix < 2 || radix > 36 {
        panic("to_string_radix: radix must be 2 to 36")
    }
    let mut out = String.new()
    if self < 0 {
        out.push('-')
    }
    let mut v: usize = self.unsigned_abs()
    if v == 0 {
        out.push('0')
        return out
    }
    let base: usize = radix as usize
    let mut digits = List<char>.new()
    while v > 0 {
        let d = (v % base) as u32
        if d < 10 {
            digits.push((48 + d) as char)
        } else {
            digits.push((87 + d) as char)
        }
        v = v / base
    }
    let mut i = digits.len()
    while i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    out
}

/// The bytes in little-endian order.
///
/// ```
/// let x: isize = 1
/// assert_eq(x.to_le_bytes()[0], 1)
/// ```
fn isize.to_le_bytes(self): [u8; 8] {
    let v: usize = self as usize
    [((v >> 0) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 24) & 255) as u8, ((v >> 32) & 255) as u8, ((v >> 40) & 255) as u8, ((v >> 48) & 255) as u8, ((v >> 56) & 255) as u8]
}

/// The bytes in big-endian order.
///
/// ```
/// let x: isize = 1
/// assert_eq(x.to_be_bytes()[8 - 1], 1)
/// ```
fn isize.to_be_bytes(self): [u8; 8] {
    let v: usize = self as usize
    [((v >> 56) & 255) as u8, ((v >> 48) & 255) as u8, ((v >> 40) & 255) as u8, ((v >> 32) & 255) as u8, ((v >> 24) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 0) & 255) as u8]
}

/// The bytes in the byte order of the target, which is little-endian on every supported platform.
///
/// ```
/// let x: isize = 1
/// assert_eq(x.to_ne_bytes()[0], 1)
/// ```
fn isize.to_ne_bytes(self): [u8; 8] {
    self.to_le_bytes()
}

/// The value whose little-endian bytes are `b`.
fn __isize_from_le_bytes(b: [u8; 8]): isize {
    let v: usize = ((b[0] as usize) << 0) | ((b[1] as usize) << 8) | ((b[2] as usize) << 16) | ((b[3] as usize) << 24) | ((b[4] as usize) << 32) | ((b[5] as usize) << 40) | ((b[6] as usize) << 48) | ((b[7] as usize) << 56)
    v as isize
}

/// The value whose big-endian bytes are `b`.
fn __isize_from_be_bytes(b: [u8; 8]): isize {
    let v: usize = ((b[0] as usize) << 56) | ((b[1] as usize) << 48) | ((b[2] as usize) << 40) | ((b[3] as usize) << 32) | ((b[4] as usize) << 24) | ((b[5] as usize) << 16) | ((b[6] as usize) << 8) | ((b[7] as usize) << 0)
    v as isize
}

/// The value whose native-endian bytes are `b`.
fn __isize_from_ne_bytes(b: [u8; 8]): isize {
    __isize_from_le_bytes(b)
}

// ---- u8 ----

const __u8_MIN: u8 = 0
const __u8_MAX: u8 = 255
const __u8_BITS: u32 = 8

/// `self` to the power `exp`. Overflow panics in a debug build and wraps in a release build, like `*`.
///
/// ```
/// let x: u8 = 3
/// assert_eq(x.pow(3), 27)
/// ```
fn u8.pow(self, exp: u32): u8 {
    let mut result: u8 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
///
/// ```
/// let x: u8 = 2
/// assert_eq(x.wrapping_pow(3), 8)
/// ```
fn u8.wrapping_pow(self, exp: u32): u8 {
    let mut result: u8 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result.wrapping_mul(base)
        }
        e = e >> 1
        if e > 0 {
            base = base.wrapping_mul(base)
        }
    }
    result
}

/// `self` to the power `exp`, or `None` on overflow.
///
/// ```
/// let x: u8 = 3
/// assert_eq(x.checked_pow(3), Option.Some(27))
/// ```
fn u8.checked_pow(self, exp: u32): Option<u8> {
    let mut result: u8 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            match result.checked_mul(base) {
                Option.Some(v) => {
                    result = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Option.Some(v) => {
                    base = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
    Option.Some(result)
}

/// `self / other`, or `None` when `other` is 0.
///
/// ```
/// let x: u8 = 7
/// assert_eq(x.checked_div(2), Option.Some(3))
/// assert(x.checked_div(0).is_none())
/// ```
fn u8.checked_div(self, other: u8): Option<u8> {
    if other == 0 {
        return Option.None
    }
    Option.Some(self / other)
}

/// `self % other`, or `None` when `other` is 0.
///
/// ```
/// let x: u8 = 7
/// assert_eq(x.checked_rem(4), Option.Some(3))
/// assert(x.checked_rem(0).is_none())
/// ```
fn u8.checked_rem(self, other: u8): Option<u8> {
    if other == 0 {
        return Option.None
    }
    Option.Some(self % other)
}

/// `-self`: `Some(0)` for 0 and `None` for every other value.
///
/// ```
/// let x: u8 = 0
/// assert_eq(x.checked_neg(), Option.Some(0))
/// let y: u8 = 1
/// assert(y.checked_neg().is_none())
/// ```
fn u8.checked_neg(self): Option<u8> {
    if self == 0 {
        return Option.Some(0)
    }
    Option.None
}

/// `-self`, wrapping around (two's complement).
///
/// ```
/// let x: u8 = 1
/// assert_eq(x.wrapping_neg().wrapping_neg(), 1)
/// ```
fn u8.wrapping_neg(self): u8 {
    let zero: u8 = 0
    zero.wrapping_sub(self)
}

/// `self << n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: u8 = 1
/// assert_eq(x.checked_shl(2), Option.Some(4))
/// assert(x.checked_shl(200).is_none())
/// ```
fn u8.checked_shl(self, n: u32): Option<u8> {
    if n >= 8 {
        return Option.None
    }
    Option.Some(self << n)
}

/// `self >> n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: u8 = 8
/// assert_eq(x.checked_shr(2), Option.Some(2))
/// assert(x.checked_shr(200).is_none())
/// ```
fn u8.checked_shr(self, n: u32): Option<u8> {
    if n >= 8 {
        return Option.None
    }
    Option.Some(self >> n)
}

/// `self << (n % bits)`.
///
/// ```
/// let x: u8 = 1
/// assert_eq(x.wrapping_shl(3), 8)
/// ```
fn u8.wrapping_shl(self, n: u32): u8 {
    self << (n % 8)
}

/// `self >> (n % bits)`.
///
/// ```
/// let x: u8 = 16
/// assert_eq(x.wrapping_shr(2), 4)
/// ```
fn u8.wrapping_shr(self, n: u32): u8 {
    self >> (n % 8)
}

/// `self + other`, clamped to the range of the type.
///
/// ```
/// let x: u8 = 2
/// assert_eq(x.saturating_add(3), 5)
/// ```
fn u8.saturating_add(self, other: u8): u8 {
    match self.checked_add(other) {
        Option.Some(v) => v,
        Option.None => __u8_MAX,
    }
}

/// `self - other`, clamped to the range of the type.
///
/// ```
/// let x: u8 = 5
/// assert_eq(x.saturating_sub(2), 3)
/// ```
fn u8.saturating_sub(self, other: u8): u8 {
    match self.checked_sub(other) {
        Option.Some(v) => v,
        Option.None => 0,
    }
}

/// `self * other`, clamped to the range of the type.
///
/// ```
/// let x: u8 = 2
/// assert_eq(x.saturating_mul(3), 6)
/// ```
fn u8.saturating_mul(self, other: u8): u8 {
    match self.checked_mul(other) {
        Option.Some(v) => v,
        Option.None => __u8_MAX,
    }
}

/// `self` to the power `exp`, clamped to the range of the type.
///
/// ```
/// let x: u8 = 2
/// assert_eq(x.saturating_pow(3), 8)
/// ```
fn u8.saturating_pow(self, exp: u32): u8 {
    match self.checked_pow(exp) {
        Option.Some(v) => v,
        Option.None => __u8_MAX,
    }
}

/// `self + other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u8 = 1
/// assert_eq(x.overflowing_add(2), (3, false))
/// ```
fn u8.overflowing_add(self, other: u8): (u8, bool) {
    (self.wrapping_add(other), self.checked_add(other).is_none())
}

/// `self - other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u8 = 5
/// assert_eq(x.overflowing_sub(2), (3, false))
/// ```
fn u8.overflowing_sub(self, other: u8): (u8, bool) {
    (self.wrapping_sub(other), self.checked_sub(other).is_none())
}

/// `self * other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u8 = 3
/// assert_eq(x.overflowing_mul(4), (12, false))
/// ```
fn u8.overflowing_mul(self, other: u8): (u8, bool) {
    (self.wrapping_mul(other), self.checked_mul(other).is_none())
}

/// `self / other`. Division by 0 panics.
///
/// ```
/// let x: u8 = 7
/// assert_eq(x.div_euclid(2), 3)
/// ```
fn u8.div_euclid(self, other: u8): u8 {
    self / other
}

/// `self % other`. Division by 0 panics.
///
/// ```
/// let x: u8 = 7
/// assert_eq(x.rem_euclid(4), 3)
/// ```
fn u8.rem_euclid(self, other: u8): u8 {
    self % other
}

/// The distance between `self` and `other`.
///
/// ```
/// let x: u8 = 5
/// assert_eq(x.abs_diff(9), 4)
/// ```
fn u8.abs_diff(self, other: u8): u8 {
    if self > other {
        return self - other
    }
    other - self
}

/// The number of 1 bits.
///
/// ```
/// let x: u8 = 7
/// assert_eq(x.count_ones(), 3)
/// ```
fn u8.count_ones(self): u32 {
    let mut v: u8 = self
    let mut n: u32 = 0
    while v != 0 {
        n = n + (v & 1) as u32
        v = v >> 1
    }
    n
}

/// The number of 0 bits.
///
/// ```
/// let x: u8 = 7
/// assert_eq(x.count_zeros(), 8 - 3)
/// ```
fn u8.count_zeros(self): u32 {
    8 - self.count_ones()
}

/// The number of 0 bits before the first 1 bit, from the top.
///
/// ```
/// let x: u8 = 1
/// assert_eq(x.leading_zeros(), 8 - 1)
/// ```
fn u8.leading_zeros(self): u32 {
    let v: u8 = self
    let mut n: u32 = 0
    let mut i: u32 = 8
    while i > 0 {
        i = i - 1
        if (v >> i) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The number of 0 bits after the last 1 bit, from the bottom.
///
/// ```
/// let x: u8 = 8
/// assert_eq(x.trailing_zeros(), 3)
/// ```
fn u8.trailing_zeros(self): u32 {
    let v: u8 = self
    let mut n: u32 = 0
    while n < 8 {
        if (v >> n) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The bits rotated left by `n % bits` places.
///
/// ```
/// let x: u8 = 1
/// assert_eq(x.rotate_left(1), 2)
/// ```
fn u8.rotate_left(self, n: u32): u8 {
    let v: u8 = self
    let k = n % 8
    if k == 0 {
        return self
    }
    let back: u32 = 8 - k
    ((v << k) | (v >> back)) as u8
}

/// The bits rotated right by `n % bits` places.
///
/// ```
/// let x: u8 = 2
/// assert_eq(x.rotate_right(1), 1)
/// ```
fn u8.rotate_right(self, n: u32): u8 {
    let v: u8 = self
    let k = n % 8
    if k == 0 {
        return self
    }
    let back: u32 = 8 - k
    ((v >> k) | (v << back)) as u8
}

/// The bytes in the opposite order. A type of one byte is unchanged.
///
/// ```
/// let x: u8 = 1
/// assert_eq(x.swap_bytes().swap_bytes(), 1)
/// ```
fn u8.swap_bytes(self): u8 {
    self
}

/// The bits in the opposite order.
///
/// ```
/// let x: u8 = 1
/// assert_eq(x.reverse_bits().reverse_bits(), 1)
/// ```
fn u8.reverse_bits(self): u8 {
    let v: u8 = self
    let mut r: u8 = 0
    let mut i: u32 = 0
    while i < 8 {
        r = (r << 1) | ((v >> i) & 1)
        i = i + 1
    }
    r as u8
}

/// Whether exactly one bit is set.
///
/// ```
/// let x: u8 = 8
/// assert(x.is_power_of_two())
/// let y: u8 = 6
/// assert(!y.is_power_of_two())
/// ```
fn u8.is_power_of_two(self): bool {
    self != 0 && self & (self - 1) == 0
}

/// The smallest power of two that is at least `self`, or `None` when it does not fit.
///
/// ```
/// let x: u8 = 5
/// assert_eq(x.checked_next_power_of_two(), Option.Some(8))
/// ```
fn u8.checked_next_power_of_two(self): Option<u8> {
    if self <= 1 {
        return Option.Some(1)
    }
    let top = 8 - (self - 1).leading_zeros()
    if top >= 8 {
        return Option.None
    }
    Option.Some(1 << top)
}

/// The smallest power of two that is at least `self`. It panics when the result does not fit.
///
/// ```
/// let x: u8 = 5
/// assert_eq(x.next_power_of_two(), 8)
/// ```
fn u8.next_power_of_two(self): u8 {
    match self.checked_next_power_of_two() {
        Option.Some(v) => v,
        Option.None => panic("next_power_of_two overflowed"),
    }
}

/// The integer square root: the greatest `r` with `r * r <= self`.
///
/// ```
/// let x: u8 = 17
/// assert_eq(x.isqrt(), 4)
/// ```
fn u8.isqrt(self): u8 {
    let mut n: u8 = self
    let mut result: u8 = 0
    let mut bit: u8 = 1 << 6
    while bit > n {
        bit = bit >> 2
    }
    while bit != 0 {
        if n >= result + bit {
            n = n - (result + bit)
            result = (result >> 1) + bit
        } else {
            result = result >> 1
        }
        bit = bit >> 2
    }
    result
}

/// The base 2 logarithm rounded down. A `self` that is 0 panics.
///
/// ```
/// let x: u8 = 8
/// assert_eq(x.ilog2(), 3)
/// ```
fn u8.ilog2(self): u32 {
    if self <= 0 {
        panic("ilog2 of a number that is not positive")
    }
    7 - self.leading_zeros()
}

/// The base 10 logarithm rounded down. A `self` that is 0 panics.
///
/// ```
/// let x: u8 = 100
/// assert_eq(x.ilog10(), 2)
/// ```
fn u8.ilog10(self): u32 {
    if self <= 0 {
        panic("ilog10 of a number that is not positive")
    }
    let mut v = self
    let mut n: u32 = 0
    while v >= 10 {
        v = v / 10
        n = n + 1
    }
    n
}

/// The number in the text in base `radix` (2 to 36; any other radix panics). Any failure (no digits, a character that is not a digit of the base, or a value out of range) is `ParseIntError.Invalid`.
fn __u8_parse_radix(s: str, radix: u32): Result<u8, ParseIntError> {
    if radix < 2 || radix > 36 {
        panic("parse_radix: radix must be 2 to 36")
    }
    let base: u8 = radix as u8
    let mut value: u8 = 0
    let mut seen_digit = false
    for c in s.chars() {
        match c.to_digit(radix) {
            Option.Some(d) => {
                let digit: u8 = d as u8
                let scaled = value.checked_mul(base)
                if scaled.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                let next = scaled.unwrap().checked_add(digit)
                if next.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                value = next.unwrap()
                seen_digit = true
            }
            Option.None => {
                return Result.Err(ParseIntError.Invalid)
            }
        }
    }
    if !seen_digit {
        return Result.Err(ParseIntError.Invalid)
    }
    Result.Ok(value)
}

/// The number written in base `radix` (2 to 36, lowercase digits; any other radix panics), with a leading `-` when negative.
///
/// ```
/// let x: u8 = 11
/// assert_eq(x.to_string_radix(2), String.from("1011"))
/// ```
fn u8.to_string_radix(self, radix: u32): String {
    if radix < 2 || radix > 36 {
        panic("to_string_radix: radix must be 2 to 36")
    }
    let mut out = String.new()
    let mut v: u8 = self
    if v == 0 {
        out.push('0')
        return out
    }
    let base: u8 = radix as u8
    let mut digits = List<char>.new()
    while v > 0 {
        let d = (v % base) as u32
        if d < 10 {
            digits.push((48 + d) as char)
        } else {
            digits.push((87 + d) as char)
        }
        v = v / base
    }
    let mut i = digits.len()
    while i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    out
}

/// The bytes in little-endian order.
///
/// ```
/// let x: u8 = 1
/// assert_eq(x.to_le_bytes()[0], 1)
/// ```
fn u8.to_le_bytes(self): [u8; 1] {
    let v: u8 = self
    [((v >> 0) & 255) as u8]
}

/// The bytes in big-endian order.
///
/// ```
/// let x: u8 = 1
/// assert_eq(x.to_be_bytes()[1 - 1], 1)
/// ```
fn u8.to_be_bytes(self): [u8; 1] {
    let v: u8 = self
    [((v >> 0) & 255) as u8]
}

/// The bytes in the byte order of the target, which is little-endian on every supported platform.
///
/// ```
/// let x: u8 = 1
/// assert_eq(x.to_ne_bytes()[0], 1)
/// ```
fn u8.to_ne_bytes(self): [u8; 1] {
    self.to_le_bytes()
}

/// The value whose little-endian bytes are `b`.
fn __u8_from_le_bytes(b: [u8; 1]): u8 {
    let v: u8 = ((b[0] as u8) << 0)
    v
}

/// The value whose big-endian bytes are `b`.
fn __u8_from_be_bytes(b: [u8; 1]): u8 {
    let v: u8 = ((b[0] as u8) << 0)
    v
}

/// The value whose native-endian bytes are `b`.
fn __u8_from_ne_bytes(b: [u8; 1]): u8 {
    __u8_from_le_bytes(b)
}

// ---- u16 ----

const __u16_MIN: u16 = 0
const __u16_MAX: u16 = 65535
const __u16_BITS: u32 = 16

/// `self` to the power `exp`. Overflow panics in a debug build and wraps in a release build, like `*`.
///
/// ```
/// let x: u16 = 3
/// assert_eq(x.pow(3), 27)
/// ```
fn u16.pow(self, exp: u32): u16 {
    let mut result: u16 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
///
/// ```
/// let x: u16 = 2
/// assert_eq(x.wrapping_pow(3), 8)
/// ```
fn u16.wrapping_pow(self, exp: u32): u16 {
    let mut result: u16 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result.wrapping_mul(base)
        }
        e = e >> 1
        if e > 0 {
            base = base.wrapping_mul(base)
        }
    }
    result
}

/// `self` to the power `exp`, or `None` on overflow.
///
/// ```
/// let x: u16 = 3
/// assert_eq(x.checked_pow(3), Option.Some(27))
/// ```
fn u16.checked_pow(self, exp: u32): Option<u16> {
    let mut result: u16 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            match result.checked_mul(base) {
                Option.Some(v) => {
                    result = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Option.Some(v) => {
                    base = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
    Option.Some(result)
}

/// `self / other`, or `None` when `other` is 0.
///
/// ```
/// let x: u16 = 7
/// assert_eq(x.checked_div(2), Option.Some(3))
/// assert(x.checked_div(0).is_none())
/// ```
fn u16.checked_div(self, other: u16): Option<u16> {
    if other == 0 {
        return Option.None
    }
    Option.Some(self / other)
}

/// `self % other`, or `None` when `other` is 0.
///
/// ```
/// let x: u16 = 7
/// assert_eq(x.checked_rem(4), Option.Some(3))
/// assert(x.checked_rem(0).is_none())
/// ```
fn u16.checked_rem(self, other: u16): Option<u16> {
    if other == 0 {
        return Option.None
    }
    Option.Some(self % other)
}

/// `-self`: `Some(0)` for 0 and `None` for every other value.
///
/// ```
/// let x: u16 = 0
/// assert_eq(x.checked_neg(), Option.Some(0))
/// let y: u16 = 1
/// assert(y.checked_neg().is_none())
/// ```
fn u16.checked_neg(self): Option<u16> {
    if self == 0 {
        return Option.Some(0)
    }
    Option.None
}

/// `-self`, wrapping around (two's complement).
///
/// ```
/// let x: u16 = 1
/// assert_eq(x.wrapping_neg().wrapping_neg(), 1)
/// ```
fn u16.wrapping_neg(self): u16 {
    let zero: u16 = 0
    zero.wrapping_sub(self)
}

/// `self << n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: u16 = 1
/// assert_eq(x.checked_shl(2), Option.Some(4))
/// assert(x.checked_shl(200).is_none())
/// ```
fn u16.checked_shl(self, n: u32): Option<u16> {
    if n >= 16 {
        return Option.None
    }
    Option.Some(self << n)
}

/// `self >> n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: u16 = 8
/// assert_eq(x.checked_shr(2), Option.Some(2))
/// assert(x.checked_shr(200).is_none())
/// ```
fn u16.checked_shr(self, n: u32): Option<u16> {
    if n >= 16 {
        return Option.None
    }
    Option.Some(self >> n)
}

/// `self << (n % bits)`.
///
/// ```
/// let x: u16 = 1
/// assert_eq(x.wrapping_shl(3), 8)
/// ```
fn u16.wrapping_shl(self, n: u32): u16 {
    self << (n % 16)
}

/// `self >> (n % bits)`.
///
/// ```
/// let x: u16 = 16
/// assert_eq(x.wrapping_shr(2), 4)
/// ```
fn u16.wrapping_shr(self, n: u32): u16 {
    self >> (n % 16)
}

/// `self + other`, clamped to the range of the type.
///
/// ```
/// let x: u16 = 2
/// assert_eq(x.saturating_add(3), 5)
/// ```
fn u16.saturating_add(self, other: u16): u16 {
    match self.checked_add(other) {
        Option.Some(v) => v,
        Option.None => __u16_MAX,
    }
}

/// `self - other`, clamped to the range of the type.
///
/// ```
/// let x: u16 = 5
/// assert_eq(x.saturating_sub(2), 3)
/// ```
fn u16.saturating_sub(self, other: u16): u16 {
    match self.checked_sub(other) {
        Option.Some(v) => v,
        Option.None => 0,
    }
}

/// `self * other`, clamped to the range of the type.
///
/// ```
/// let x: u16 = 2
/// assert_eq(x.saturating_mul(3), 6)
/// ```
fn u16.saturating_mul(self, other: u16): u16 {
    match self.checked_mul(other) {
        Option.Some(v) => v,
        Option.None => __u16_MAX,
    }
}

/// `self` to the power `exp`, clamped to the range of the type.
///
/// ```
/// let x: u16 = 2
/// assert_eq(x.saturating_pow(3), 8)
/// ```
fn u16.saturating_pow(self, exp: u32): u16 {
    match self.checked_pow(exp) {
        Option.Some(v) => v,
        Option.None => __u16_MAX,
    }
}

/// `self + other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u16 = 1
/// assert_eq(x.overflowing_add(2), (3, false))
/// ```
fn u16.overflowing_add(self, other: u16): (u16, bool) {
    (self.wrapping_add(other), self.checked_add(other).is_none())
}

/// `self - other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u16 = 5
/// assert_eq(x.overflowing_sub(2), (3, false))
/// ```
fn u16.overflowing_sub(self, other: u16): (u16, bool) {
    (self.wrapping_sub(other), self.checked_sub(other).is_none())
}

/// `self * other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u16 = 3
/// assert_eq(x.overflowing_mul(4), (12, false))
/// ```
fn u16.overflowing_mul(self, other: u16): (u16, bool) {
    (self.wrapping_mul(other), self.checked_mul(other).is_none())
}

/// `self / other`. Division by 0 panics.
///
/// ```
/// let x: u16 = 7
/// assert_eq(x.div_euclid(2), 3)
/// ```
fn u16.div_euclid(self, other: u16): u16 {
    self / other
}

/// `self % other`. Division by 0 panics.
///
/// ```
/// let x: u16 = 7
/// assert_eq(x.rem_euclid(4), 3)
/// ```
fn u16.rem_euclid(self, other: u16): u16 {
    self % other
}

/// The distance between `self` and `other`.
///
/// ```
/// let x: u16 = 5
/// assert_eq(x.abs_diff(9), 4)
/// ```
fn u16.abs_diff(self, other: u16): u16 {
    if self > other {
        return self - other
    }
    other - self
}

/// The number of 1 bits.
///
/// ```
/// let x: u16 = 7
/// assert_eq(x.count_ones(), 3)
/// ```
fn u16.count_ones(self): u32 {
    let mut v: u16 = self
    let mut n: u32 = 0
    while v != 0 {
        n = n + (v & 1) as u32
        v = v >> 1
    }
    n
}

/// The number of 0 bits.
///
/// ```
/// let x: u16 = 7
/// assert_eq(x.count_zeros(), 16 - 3)
/// ```
fn u16.count_zeros(self): u32 {
    16 - self.count_ones()
}

/// The number of 0 bits before the first 1 bit, from the top.
///
/// ```
/// let x: u16 = 1
/// assert_eq(x.leading_zeros(), 16 - 1)
/// ```
fn u16.leading_zeros(self): u32 {
    let v: u16 = self
    let mut n: u32 = 0
    let mut i: u32 = 16
    while i > 0 {
        i = i - 1
        if (v >> i) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The number of 0 bits after the last 1 bit, from the bottom.
///
/// ```
/// let x: u16 = 8
/// assert_eq(x.trailing_zeros(), 3)
/// ```
fn u16.trailing_zeros(self): u32 {
    let v: u16 = self
    let mut n: u32 = 0
    while n < 16 {
        if (v >> n) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The bits rotated left by `n % bits` places.
///
/// ```
/// let x: u16 = 1
/// assert_eq(x.rotate_left(1), 2)
/// ```
fn u16.rotate_left(self, n: u32): u16 {
    let v: u16 = self
    let k = n % 16
    if k == 0 {
        return self
    }
    let back: u32 = 16 - k
    ((v << k) | (v >> back)) as u16
}

/// The bits rotated right by `n % bits` places.
///
/// ```
/// let x: u16 = 2
/// assert_eq(x.rotate_right(1), 1)
/// ```
fn u16.rotate_right(self, n: u32): u16 {
    let v: u16 = self
    let k = n % 16
    if k == 0 {
        return self
    }
    let back: u32 = 16 - k
    ((v >> k) | (v << back)) as u16
}

/// The bytes in the opposite order.
///
/// ```
/// let x: u16 = 1
/// assert_eq(x.swap_bytes().swap_bytes(), 1)
/// ```
fn u16.swap_bytes(self): u16 {
    let v: u16 = self
    let mut r: u16 = 0
    let mut i: u32 = 0
    while i < 2 {
        let shift: u32 = 8 * i
        r = (r << 8) | ((v >> shift) & 255)
        i = i + 1
    }
    r as u16
}

/// The bits in the opposite order.
///
/// ```
/// let x: u16 = 1
/// assert_eq(x.reverse_bits().reverse_bits(), 1)
/// ```
fn u16.reverse_bits(self): u16 {
    let v: u16 = self
    let mut r: u16 = 0
    let mut i: u32 = 0
    while i < 16 {
        r = (r << 1) | ((v >> i) & 1)
        i = i + 1
    }
    r as u16
}

/// Whether exactly one bit is set.
///
/// ```
/// let x: u16 = 8
/// assert(x.is_power_of_two())
/// let y: u16 = 6
/// assert(!y.is_power_of_two())
/// ```
fn u16.is_power_of_two(self): bool {
    self != 0 && self & (self - 1) == 0
}

/// The smallest power of two that is at least `self`, or `None` when it does not fit.
///
/// ```
/// let x: u16 = 5
/// assert_eq(x.checked_next_power_of_two(), Option.Some(8))
/// ```
fn u16.checked_next_power_of_two(self): Option<u16> {
    if self <= 1 {
        return Option.Some(1)
    }
    let top = 16 - (self - 1).leading_zeros()
    if top >= 16 {
        return Option.None
    }
    Option.Some(1 << top)
}

/// The smallest power of two that is at least `self`. It panics when the result does not fit.
///
/// ```
/// let x: u16 = 5
/// assert_eq(x.next_power_of_two(), 8)
/// ```
fn u16.next_power_of_two(self): u16 {
    match self.checked_next_power_of_two() {
        Option.Some(v) => v,
        Option.None => panic("next_power_of_two overflowed"),
    }
}

/// The integer square root: the greatest `r` with `r * r <= self`.
///
/// ```
/// let x: u16 = 17
/// assert_eq(x.isqrt(), 4)
/// ```
fn u16.isqrt(self): u16 {
    let mut n: u16 = self
    let mut result: u16 = 0
    let mut bit: u16 = 1 << 14
    while bit > n {
        bit = bit >> 2
    }
    while bit != 0 {
        if n >= result + bit {
            n = n - (result + bit)
            result = (result >> 1) + bit
        } else {
            result = result >> 1
        }
        bit = bit >> 2
    }
    result
}

/// The base 2 logarithm rounded down. A `self` that is 0 panics.
///
/// ```
/// let x: u16 = 8
/// assert_eq(x.ilog2(), 3)
/// ```
fn u16.ilog2(self): u32 {
    if self <= 0 {
        panic("ilog2 of a number that is not positive")
    }
    15 - self.leading_zeros()
}

/// The base 10 logarithm rounded down. A `self` that is 0 panics.
///
/// ```
/// let x: u16 = 100
/// assert_eq(x.ilog10(), 2)
/// ```
fn u16.ilog10(self): u32 {
    if self <= 0 {
        panic("ilog10 of a number that is not positive")
    }
    let mut v = self
    let mut n: u32 = 0
    while v >= 10 {
        v = v / 10
        n = n + 1
    }
    n
}

/// The number in the text in base `radix` (2 to 36; any other radix panics). Any failure (no digits, a character that is not a digit of the base, or a value out of range) is `ParseIntError.Invalid`.
fn __u16_parse_radix(s: str, radix: u32): Result<u16, ParseIntError> {
    if radix < 2 || radix > 36 {
        panic("parse_radix: radix must be 2 to 36")
    }
    let base: u16 = radix as u16
    let mut value: u16 = 0
    let mut seen_digit = false
    for c in s.chars() {
        match c.to_digit(radix) {
            Option.Some(d) => {
                let digit: u16 = d as u16
                let scaled = value.checked_mul(base)
                if scaled.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                let next = scaled.unwrap().checked_add(digit)
                if next.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                value = next.unwrap()
                seen_digit = true
            }
            Option.None => {
                return Result.Err(ParseIntError.Invalid)
            }
        }
    }
    if !seen_digit {
        return Result.Err(ParseIntError.Invalid)
    }
    Result.Ok(value)
}

/// The number written in base `radix` (2 to 36, lowercase digits; any other radix panics), with a leading `-` when negative.
///
/// ```
/// let x: u16 = 11
/// assert_eq(x.to_string_radix(2), String.from("1011"))
/// ```
fn u16.to_string_radix(self, radix: u32): String {
    if radix < 2 || radix > 36 {
        panic("to_string_radix: radix must be 2 to 36")
    }
    let mut out = String.new()
    let mut v: u16 = self
    if v == 0 {
        out.push('0')
        return out
    }
    let base: u16 = radix as u16
    let mut digits = List<char>.new()
    while v > 0 {
        let d = (v % base) as u32
        if d < 10 {
            digits.push((48 + d) as char)
        } else {
            digits.push((87 + d) as char)
        }
        v = v / base
    }
    let mut i = digits.len()
    while i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    out
}

/// The bytes in little-endian order.
///
/// ```
/// let x: u16 = 1
/// assert_eq(x.to_le_bytes()[0], 1)
/// ```
fn u16.to_le_bytes(self): [u8; 2] {
    let v: u16 = self
    [((v >> 0) & 255) as u8, ((v >> 8) & 255) as u8]
}

/// The bytes in big-endian order.
///
/// ```
/// let x: u16 = 1
/// assert_eq(x.to_be_bytes()[2 - 1], 1)
/// ```
fn u16.to_be_bytes(self): [u8; 2] {
    let v: u16 = self
    [((v >> 8) & 255) as u8, ((v >> 0) & 255) as u8]
}

/// The bytes in the byte order of the target, which is little-endian on every supported platform.
///
/// ```
/// let x: u16 = 1
/// assert_eq(x.to_ne_bytes()[0], 1)
/// ```
fn u16.to_ne_bytes(self): [u8; 2] {
    self.to_le_bytes()
}

/// The value whose little-endian bytes are `b`.
fn __u16_from_le_bytes(b: [u8; 2]): u16 {
    let v: u16 = ((b[0] as u16) << 0) | ((b[1] as u16) << 8)
    v
}

/// The value whose big-endian bytes are `b`.
fn __u16_from_be_bytes(b: [u8; 2]): u16 {
    let v: u16 = ((b[0] as u16) << 8) | ((b[1] as u16) << 0)
    v
}

/// The value whose native-endian bytes are `b`.
fn __u16_from_ne_bytes(b: [u8; 2]): u16 {
    __u16_from_le_bytes(b)
}

// ---- u32 ----

const __u32_MIN: u32 = 0
const __u32_MAX: u32 = 4294967295
const __u32_BITS: u32 = 32

/// `self` to the power `exp`. Overflow panics in a debug build and wraps in a release build, like `*`.
///
/// ```
/// let x: u32 = 3
/// assert_eq(x.pow(3), 27)
/// ```
fn u32.pow(self, exp: u32): u32 {
    let mut result: u32 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
///
/// ```
/// let x: u32 = 2
/// assert_eq(x.wrapping_pow(3), 8)
/// ```
fn u32.wrapping_pow(self, exp: u32): u32 {
    let mut result: u32 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result.wrapping_mul(base)
        }
        e = e >> 1
        if e > 0 {
            base = base.wrapping_mul(base)
        }
    }
    result
}

/// `self` to the power `exp`, or `None` on overflow.
///
/// ```
/// let x: u32 = 3
/// assert_eq(x.checked_pow(3), Option.Some(27))
/// ```
fn u32.checked_pow(self, exp: u32): Option<u32> {
    let mut result: u32 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            match result.checked_mul(base) {
                Option.Some(v) => {
                    result = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Option.Some(v) => {
                    base = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
    Option.Some(result)
}

/// `self / other`, or `None` when `other` is 0.
///
/// ```
/// let x: u32 = 7
/// assert_eq(x.checked_div(2), Option.Some(3))
/// assert(x.checked_div(0).is_none())
/// ```
fn u32.checked_div(self, other: u32): Option<u32> {
    if other == 0 {
        return Option.None
    }
    Option.Some(self / other)
}

/// `self % other`, or `None` when `other` is 0.
///
/// ```
/// let x: u32 = 7
/// assert_eq(x.checked_rem(4), Option.Some(3))
/// assert(x.checked_rem(0).is_none())
/// ```
fn u32.checked_rem(self, other: u32): Option<u32> {
    if other == 0 {
        return Option.None
    }
    Option.Some(self % other)
}

/// `-self`: `Some(0)` for 0 and `None` for every other value.
///
/// ```
/// let x: u32 = 0
/// assert_eq(x.checked_neg(), Option.Some(0))
/// let y: u32 = 1
/// assert(y.checked_neg().is_none())
/// ```
fn u32.checked_neg(self): Option<u32> {
    if self == 0 {
        return Option.Some(0)
    }
    Option.None
}

/// `-self`, wrapping around (two's complement).
///
/// ```
/// let x: u32 = 1
/// assert_eq(x.wrapping_neg().wrapping_neg(), 1)
/// ```
fn u32.wrapping_neg(self): u32 {
    let zero: u32 = 0
    zero.wrapping_sub(self)
}

/// `self << n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: u32 = 1
/// assert_eq(x.checked_shl(2), Option.Some(4))
/// assert(x.checked_shl(200).is_none())
/// ```
fn u32.checked_shl(self, n: u32): Option<u32> {
    if n >= 32 {
        return Option.None
    }
    Option.Some(self << n)
}

/// `self >> n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: u32 = 8
/// assert_eq(x.checked_shr(2), Option.Some(2))
/// assert(x.checked_shr(200).is_none())
/// ```
fn u32.checked_shr(self, n: u32): Option<u32> {
    if n >= 32 {
        return Option.None
    }
    Option.Some(self >> n)
}

/// `self << (n % bits)`.
///
/// ```
/// let x: u32 = 1
/// assert_eq(x.wrapping_shl(3), 8)
/// ```
fn u32.wrapping_shl(self, n: u32): u32 {
    self << (n % 32)
}

/// `self >> (n % bits)`.
///
/// ```
/// let x: u32 = 16
/// assert_eq(x.wrapping_shr(2), 4)
/// ```
fn u32.wrapping_shr(self, n: u32): u32 {
    self >> (n % 32)
}

/// `self + other`, clamped to the range of the type.
///
/// ```
/// let x: u32 = 2
/// assert_eq(x.saturating_add(3), 5)
/// ```
fn u32.saturating_add(self, other: u32): u32 {
    match self.checked_add(other) {
        Option.Some(v) => v,
        Option.None => __u32_MAX,
    }
}

/// `self - other`, clamped to the range of the type.
///
/// ```
/// let x: u32 = 5
/// assert_eq(x.saturating_sub(2), 3)
/// ```
fn u32.saturating_sub(self, other: u32): u32 {
    match self.checked_sub(other) {
        Option.Some(v) => v,
        Option.None => 0,
    }
}

/// `self * other`, clamped to the range of the type.
///
/// ```
/// let x: u32 = 2
/// assert_eq(x.saturating_mul(3), 6)
/// ```
fn u32.saturating_mul(self, other: u32): u32 {
    match self.checked_mul(other) {
        Option.Some(v) => v,
        Option.None => __u32_MAX,
    }
}

/// `self` to the power `exp`, clamped to the range of the type.
///
/// ```
/// let x: u32 = 2
/// assert_eq(x.saturating_pow(3), 8)
/// ```
fn u32.saturating_pow(self, exp: u32): u32 {
    match self.checked_pow(exp) {
        Option.Some(v) => v,
        Option.None => __u32_MAX,
    }
}

/// `self + other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u32 = 1
/// assert_eq(x.overflowing_add(2), (3, false))
/// ```
fn u32.overflowing_add(self, other: u32): (u32, bool) {
    (self.wrapping_add(other), self.checked_add(other).is_none())
}

/// `self - other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u32 = 5
/// assert_eq(x.overflowing_sub(2), (3, false))
/// ```
fn u32.overflowing_sub(self, other: u32): (u32, bool) {
    (self.wrapping_sub(other), self.checked_sub(other).is_none())
}

/// `self * other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u32 = 3
/// assert_eq(x.overflowing_mul(4), (12, false))
/// ```
fn u32.overflowing_mul(self, other: u32): (u32, bool) {
    (self.wrapping_mul(other), self.checked_mul(other).is_none())
}

/// `self / other`. Division by 0 panics.
///
/// ```
/// let x: u32 = 7
/// assert_eq(x.div_euclid(2), 3)
/// ```
fn u32.div_euclid(self, other: u32): u32 {
    self / other
}

/// `self % other`. Division by 0 panics.
///
/// ```
/// let x: u32 = 7
/// assert_eq(x.rem_euclid(4), 3)
/// ```
fn u32.rem_euclid(self, other: u32): u32 {
    self % other
}

/// The distance between `self` and `other`.
///
/// ```
/// let x: u32 = 5
/// assert_eq(x.abs_diff(9), 4)
/// ```
fn u32.abs_diff(self, other: u32): u32 {
    if self > other {
        return self - other
    }
    other - self
}

/// The number of 1 bits.
///
/// ```
/// let x: u32 = 7
/// assert_eq(x.count_ones(), 3)
/// ```
fn u32.count_ones(self): u32 {
    let mut v: u32 = self
    let mut n: u32 = 0
    while v != 0 {
        n = n + (v & 1) as u32
        v = v >> 1
    }
    n
}

/// The number of 0 bits.
///
/// ```
/// let x: u32 = 7
/// assert_eq(x.count_zeros(), 32 - 3)
/// ```
fn u32.count_zeros(self): u32 {
    32 - self.count_ones()
}

/// The number of 0 bits before the first 1 bit, from the top.
///
/// ```
/// let x: u32 = 1
/// assert_eq(x.leading_zeros(), 32 - 1)
/// ```
fn u32.leading_zeros(self): u32 {
    let v: u32 = self
    let mut n: u32 = 0
    let mut i: u32 = 32
    while i > 0 {
        i = i - 1
        if (v >> i) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The number of 0 bits after the last 1 bit, from the bottom.
///
/// ```
/// let x: u32 = 8
/// assert_eq(x.trailing_zeros(), 3)
/// ```
fn u32.trailing_zeros(self): u32 {
    let v: u32 = self
    let mut n: u32 = 0
    while n < 32 {
        if (v >> n) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The bits rotated left by `n % bits` places.
///
/// ```
/// let x: u32 = 1
/// assert_eq(x.rotate_left(1), 2)
/// ```
fn u32.rotate_left(self, n: u32): u32 {
    let v: u32 = self
    let k = n % 32
    if k == 0 {
        return self
    }
    let back: u32 = 32 - k
    ((v << k) | (v >> back)) as u32
}

/// The bits rotated right by `n % bits` places.
///
/// ```
/// let x: u32 = 2
/// assert_eq(x.rotate_right(1), 1)
/// ```
fn u32.rotate_right(self, n: u32): u32 {
    let v: u32 = self
    let k = n % 32
    if k == 0 {
        return self
    }
    let back: u32 = 32 - k
    ((v >> k) | (v << back)) as u32
}

/// The bytes in the opposite order.
///
/// ```
/// let x: u32 = 1
/// assert_eq(x.swap_bytes().swap_bytes(), 1)
/// ```
fn u32.swap_bytes(self): u32 {
    let v: u32 = self
    let mut r: u32 = 0
    let mut i: u32 = 0
    while i < 4 {
        let shift: u32 = 8 * i
        r = (r << 8) | ((v >> shift) & 255)
        i = i + 1
    }
    r as u32
}

/// The bits in the opposite order.
///
/// ```
/// let x: u32 = 1
/// assert_eq(x.reverse_bits().reverse_bits(), 1)
/// ```
fn u32.reverse_bits(self): u32 {
    let v: u32 = self
    let mut r: u32 = 0
    let mut i: u32 = 0
    while i < 32 {
        r = (r << 1) | ((v >> i) & 1)
        i = i + 1
    }
    r as u32
}

/// Whether exactly one bit is set.
///
/// ```
/// let x: u32 = 8
/// assert(x.is_power_of_two())
/// let y: u32 = 6
/// assert(!y.is_power_of_two())
/// ```
fn u32.is_power_of_two(self): bool {
    self != 0 && self & (self - 1) == 0
}

/// The smallest power of two that is at least `self`, or `None` when it does not fit.
///
/// ```
/// let x: u32 = 5
/// assert_eq(x.checked_next_power_of_two(), Option.Some(8))
/// ```
fn u32.checked_next_power_of_two(self): Option<u32> {
    if self <= 1 {
        return Option.Some(1)
    }
    let top = 32 - (self - 1).leading_zeros()
    if top >= 32 {
        return Option.None
    }
    Option.Some(1 << top)
}

/// The smallest power of two that is at least `self`. It panics when the result does not fit.
///
/// ```
/// let x: u32 = 5
/// assert_eq(x.next_power_of_two(), 8)
/// ```
fn u32.next_power_of_two(self): u32 {
    match self.checked_next_power_of_two() {
        Option.Some(v) => v,
        Option.None => panic("next_power_of_two overflowed"),
    }
}

/// The integer square root: the greatest `r` with `r * r <= self`.
///
/// ```
/// let x: u32 = 17
/// assert_eq(x.isqrt(), 4)
/// ```
fn u32.isqrt(self): u32 {
    let mut n: u32 = self
    let mut result: u32 = 0
    let mut bit: u32 = 1 << 30
    while bit > n {
        bit = bit >> 2
    }
    while bit != 0 {
        if n >= result + bit {
            n = n - (result + bit)
            result = (result >> 1) + bit
        } else {
            result = result >> 1
        }
        bit = bit >> 2
    }
    result
}

/// The base 2 logarithm rounded down. A `self` that is 0 panics.
///
/// ```
/// let x: u32 = 8
/// assert_eq(x.ilog2(), 3)
/// ```
fn u32.ilog2(self): u32 {
    if self <= 0 {
        panic("ilog2 of a number that is not positive")
    }
    31 - self.leading_zeros()
}

/// The base 10 logarithm rounded down. A `self` that is 0 panics.
///
/// ```
/// let x: u32 = 100
/// assert_eq(x.ilog10(), 2)
/// ```
fn u32.ilog10(self): u32 {
    if self <= 0 {
        panic("ilog10 of a number that is not positive")
    }
    let mut v = self
    let mut n: u32 = 0
    while v >= 10 {
        v = v / 10
        n = n + 1
    }
    n
}

/// The number in the text in base `radix` (2 to 36; any other radix panics). Any failure (no digits, a character that is not a digit of the base, or a value out of range) is `ParseIntError.Invalid`.
fn __u32_parse_radix(s: str, radix: u32): Result<u32, ParseIntError> {
    if radix < 2 || radix > 36 {
        panic("parse_radix: radix must be 2 to 36")
    }
    let base: u32 = radix as u32
    let mut value: u32 = 0
    let mut seen_digit = false
    for c in s.chars() {
        match c.to_digit(radix) {
            Option.Some(d) => {
                let digit: u32 = d as u32
                let scaled = value.checked_mul(base)
                if scaled.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                let next = scaled.unwrap().checked_add(digit)
                if next.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                value = next.unwrap()
                seen_digit = true
            }
            Option.None => {
                return Result.Err(ParseIntError.Invalid)
            }
        }
    }
    if !seen_digit {
        return Result.Err(ParseIntError.Invalid)
    }
    Result.Ok(value)
}

/// The number written in base `radix` (2 to 36, lowercase digits; any other radix panics), with a leading `-` when negative.
///
/// ```
/// let x: u32 = 11
/// assert_eq(x.to_string_radix(2), String.from("1011"))
/// ```
fn u32.to_string_radix(self, radix: u32): String {
    if radix < 2 || radix > 36 {
        panic("to_string_radix: radix must be 2 to 36")
    }
    let mut out = String.new()
    let mut v: u32 = self
    if v == 0 {
        out.push('0')
        return out
    }
    let base: u32 = radix as u32
    let mut digits = List<char>.new()
    while v > 0 {
        let d = (v % base) as u32
        if d < 10 {
            digits.push((48 + d) as char)
        } else {
            digits.push((87 + d) as char)
        }
        v = v / base
    }
    let mut i = digits.len()
    while i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    out
}

/// The bytes in little-endian order.
///
/// ```
/// let x: u32 = 1
/// assert_eq(x.to_le_bytes()[0], 1)
/// ```
fn u32.to_le_bytes(self): [u8; 4] {
    let v: u32 = self
    [((v >> 0) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 24) & 255) as u8]
}

/// The bytes in big-endian order.
///
/// ```
/// let x: u32 = 1
/// assert_eq(x.to_be_bytes()[4 - 1], 1)
/// ```
fn u32.to_be_bytes(self): [u8; 4] {
    let v: u32 = self
    [((v >> 24) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 0) & 255) as u8]
}

/// The bytes in the byte order of the target, which is little-endian on every supported platform.
///
/// ```
/// let x: u32 = 1
/// assert_eq(x.to_ne_bytes()[0], 1)
/// ```
fn u32.to_ne_bytes(self): [u8; 4] {
    self.to_le_bytes()
}

/// The value whose little-endian bytes are `b`.
fn __u32_from_le_bytes(b: [u8; 4]): u32 {
    let v: u32 = ((b[0] as u32) << 0) | ((b[1] as u32) << 8) | ((b[2] as u32) << 16) | ((b[3] as u32) << 24)
    v
}

/// The value whose big-endian bytes are `b`.
fn __u32_from_be_bytes(b: [u8; 4]): u32 {
    let v: u32 = ((b[0] as u32) << 24) | ((b[1] as u32) << 16) | ((b[2] as u32) << 8) | ((b[3] as u32) << 0)
    v
}

/// The value whose native-endian bytes are `b`.
fn __u32_from_ne_bytes(b: [u8; 4]): u32 {
    __u32_from_le_bytes(b)
}

// ---- u64 ----

const __u64_MIN: u64 = 0
const __u64_MAX: u64 = 18446744073709551615
const __u64_BITS: u32 = 64

/// `self` to the power `exp`. Overflow panics in a debug build and wraps in a release build, like `*`.
///
/// ```
/// let x: u64 = 3
/// assert_eq(x.pow(3), 27)
/// ```
fn u64.pow(self, exp: u32): u64 {
    let mut result: u64 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
///
/// ```
/// let x: u64 = 2
/// assert_eq(x.wrapping_pow(3), 8)
/// ```
fn u64.wrapping_pow(self, exp: u32): u64 {
    let mut result: u64 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result.wrapping_mul(base)
        }
        e = e >> 1
        if e > 0 {
            base = base.wrapping_mul(base)
        }
    }
    result
}

/// `self` to the power `exp`, or `None` on overflow.
///
/// ```
/// let x: u64 = 3
/// assert_eq(x.checked_pow(3), Option.Some(27))
/// ```
fn u64.checked_pow(self, exp: u32): Option<u64> {
    let mut result: u64 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            match result.checked_mul(base) {
                Option.Some(v) => {
                    result = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Option.Some(v) => {
                    base = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
    Option.Some(result)
}

/// `self / other`, or `None` when `other` is 0.
///
/// ```
/// let x: u64 = 7
/// assert_eq(x.checked_div(2), Option.Some(3))
/// assert(x.checked_div(0).is_none())
/// ```
fn u64.checked_div(self, other: u64): Option<u64> {
    if other == 0 {
        return Option.None
    }
    Option.Some(self / other)
}

/// `self % other`, or `None` when `other` is 0.
///
/// ```
/// let x: u64 = 7
/// assert_eq(x.checked_rem(4), Option.Some(3))
/// assert(x.checked_rem(0).is_none())
/// ```
fn u64.checked_rem(self, other: u64): Option<u64> {
    if other == 0 {
        return Option.None
    }
    Option.Some(self % other)
}

/// `-self`: `Some(0)` for 0 and `None` for every other value.
///
/// ```
/// let x: u64 = 0
/// assert_eq(x.checked_neg(), Option.Some(0))
/// let y: u64 = 1
/// assert(y.checked_neg().is_none())
/// ```
fn u64.checked_neg(self): Option<u64> {
    if self == 0 {
        return Option.Some(0)
    }
    Option.None
}

/// `-self`, wrapping around (two's complement).
///
/// ```
/// let x: u64 = 1
/// assert_eq(x.wrapping_neg().wrapping_neg(), 1)
/// ```
fn u64.wrapping_neg(self): u64 {
    let zero: u64 = 0
    zero.wrapping_sub(self)
}

/// `self << n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: u64 = 1
/// assert_eq(x.checked_shl(2), Option.Some(4))
/// assert(x.checked_shl(200).is_none())
/// ```
fn u64.checked_shl(self, n: u32): Option<u64> {
    if n >= 64 {
        return Option.None
    }
    Option.Some(self << n)
}

/// `self >> n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: u64 = 8
/// assert_eq(x.checked_shr(2), Option.Some(2))
/// assert(x.checked_shr(200).is_none())
/// ```
fn u64.checked_shr(self, n: u32): Option<u64> {
    if n >= 64 {
        return Option.None
    }
    Option.Some(self >> n)
}

/// `self << (n % bits)`.
///
/// ```
/// let x: u64 = 1
/// assert_eq(x.wrapping_shl(3), 8)
/// ```
fn u64.wrapping_shl(self, n: u32): u64 {
    self << (n % 64)
}

/// `self >> (n % bits)`.
///
/// ```
/// let x: u64 = 16
/// assert_eq(x.wrapping_shr(2), 4)
/// ```
fn u64.wrapping_shr(self, n: u32): u64 {
    self >> (n % 64)
}

/// `self + other`, clamped to the range of the type.
///
/// ```
/// let x: u64 = 2
/// assert_eq(x.saturating_add(3), 5)
/// ```
fn u64.saturating_add(self, other: u64): u64 {
    match self.checked_add(other) {
        Option.Some(v) => v,
        Option.None => __u64_MAX,
    }
}

/// `self - other`, clamped to the range of the type.
///
/// ```
/// let x: u64 = 5
/// assert_eq(x.saturating_sub(2), 3)
/// ```
fn u64.saturating_sub(self, other: u64): u64 {
    match self.checked_sub(other) {
        Option.Some(v) => v,
        Option.None => 0,
    }
}

/// `self * other`, clamped to the range of the type.
///
/// ```
/// let x: u64 = 2
/// assert_eq(x.saturating_mul(3), 6)
/// ```
fn u64.saturating_mul(self, other: u64): u64 {
    match self.checked_mul(other) {
        Option.Some(v) => v,
        Option.None => __u64_MAX,
    }
}

/// `self` to the power `exp`, clamped to the range of the type.
///
/// ```
/// let x: u64 = 2
/// assert_eq(x.saturating_pow(3), 8)
/// ```
fn u64.saturating_pow(self, exp: u32): u64 {
    match self.checked_pow(exp) {
        Option.Some(v) => v,
        Option.None => __u64_MAX,
    }
}

/// `self + other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u64 = 1
/// assert_eq(x.overflowing_add(2), (3, false))
/// ```
fn u64.overflowing_add(self, other: u64): (u64, bool) {
    (self.wrapping_add(other), self.checked_add(other).is_none())
}

/// `self - other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u64 = 5
/// assert_eq(x.overflowing_sub(2), (3, false))
/// ```
fn u64.overflowing_sub(self, other: u64): (u64, bool) {
    (self.wrapping_sub(other), self.checked_sub(other).is_none())
}

/// `self * other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u64 = 3
/// assert_eq(x.overflowing_mul(4), (12, false))
/// ```
fn u64.overflowing_mul(self, other: u64): (u64, bool) {
    (self.wrapping_mul(other), self.checked_mul(other).is_none())
}

/// `self / other`. Division by 0 panics.
///
/// ```
/// let x: u64 = 7
/// assert_eq(x.div_euclid(2), 3)
/// ```
fn u64.div_euclid(self, other: u64): u64 {
    self / other
}

/// `self % other`. Division by 0 panics.
///
/// ```
/// let x: u64 = 7
/// assert_eq(x.rem_euclid(4), 3)
/// ```
fn u64.rem_euclid(self, other: u64): u64 {
    self % other
}

/// The distance between `self` and `other`.
///
/// ```
/// let x: u64 = 5
/// assert_eq(x.abs_diff(9), 4)
/// ```
fn u64.abs_diff(self, other: u64): u64 {
    if self > other {
        return self - other
    }
    other - self
}

/// The number of 1 bits.
///
/// ```
/// let x: u64 = 7
/// assert_eq(x.count_ones(), 3)
/// ```
fn u64.count_ones(self): u32 {
    let mut v: u64 = self
    let mut n: u32 = 0
    while v != 0 {
        n = n + (v & 1) as u32
        v = v >> 1
    }
    n
}

/// The number of 0 bits.
///
/// ```
/// let x: u64 = 7
/// assert_eq(x.count_zeros(), 64 - 3)
/// ```
fn u64.count_zeros(self): u32 {
    64 - self.count_ones()
}

/// The number of 0 bits before the first 1 bit, from the top.
///
/// ```
/// let x: u64 = 1
/// assert_eq(x.leading_zeros(), 64 - 1)
/// ```
fn u64.leading_zeros(self): u32 {
    let v: u64 = self
    let mut n: u32 = 0
    let mut i: u32 = 64
    while i > 0 {
        i = i - 1
        if (v >> i) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The number of 0 bits after the last 1 bit, from the bottom.
///
/// ```
/// let x: u64 = 8
/// assert_eq(x.trailing_zeros(), 3)
/// ```
fn u64.trailing_zeros(self): u32 {
    let v: u64 = self
    let mut n: u32 = 0
    while n < 64 {
        if (v >> n) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The bits rotated left by `n % bits` places.
///
/// ```
/// let x: u64 = 1
/// assert_eq(x.rotate_left(1), 2)
/// ```
fn u64.rotate_left(self, n: u32): u64 {
    let v: u64 = self
    let k = n % 64
    if k == 0 {
        return self
    }
    let back: u32 = 64 - k
    ((v << k) | (v >> back)) as u64
}

/// The bits rotated right by `n % bits` places.
///
/// ```
/// let x: u64 = 2
/// assert_eq(x.rotate_right(1), 1)
/// ```
fn u64.rotate_right(self, n: u32): u64 {
    let v: u64 = self
    let k = n % 64
    if k == 0 {
        return self
    }
    let back: u32 = 64 - k
    ((v >> k) | (v << back)) as u64
}

/// The bytes in the opposite order.
///
/// ```
/// let x: u64 = 1
/// assert_eq(x.swap_bytes().swap_bytes(), 1)
/// ```
fn u64.swap_bytes(self): u64 {
    let v: u64 = self
    let mut r: u64 = 0
    let mut i: u32 = 0
    while i < 8 {
        let shift: u32 = 8 * i
        r = (r << 8) | ((v >> shift) & 255)
        i = i + 1
    }
    r as u64
}

/// The bits in the opposite order.
///
/// ```
/// let x: u64 = 1
/// assert_eq(x.reverse_bits().reverse_bits(), 1)
/// ```
fn u64.reverse_bits(self): u64 {
    let v: u64 = self
    let mut r: u64 = 0
    let mut i: u32 = 0
    while i < 64 {
        r = (r << 1) | ((v >> i) & 1)
        i = i + 1
    }
    r as u64
}

/// Whether exactly one bit is set.
///
/// ```
/// let x: u64 = 8
/// assert(x.is_power_of_two())
/// let y: u64 = 6
/// assert(!y.is_power_of_two())
/// ```
fn u64.is_power_of_two(self): bool {
    self != 0 && self & (self - 1) == 0
}

/// The smallest power of two that is at least `self`, or `None` when it does not fit.
///
/// ```
/// let x: u64 = 5
/// assert_eq(x.checked_next_power_of_two(), Option.Some(8))
/// ```
fn u64.checked_next_power_of_two(self): Option<u64> {
    if self <= 1 {
        return Option.Some(1)
    }
    let top = 64 - (self - 1).leading_zeros()
    if top >= 64 {
        return Option.None
    }
    Option.Some(1 << top)
}

/// The smallest power of two that is at least `self`. It panics when the result does not fit.
///
/// ```
/// let x: u64 = 5
/// assert_eq(x.next_power_of_two(), 8)
/// ```
fn u64.next_power_of_two(self): u64 {
    match self.checked_next_power_of_two() {
        Option.Some(v) => v,
        Option.None => panic("next_power_of_two overflowed"),
    }
}

/// The integer square root: the greatest `r` with `r * r <= self`.
///
/// ```
/// let x: u64 = 17
/// assert_eq(x.isqrt(), 4)
/// ```
fn u64.isqrt(self): u64 {
    let mut n: u64 = self
    let mut result: u64 = 0
    let mut bit: u64 = 1 << 62
    while bit > n {
        bit = bit >> 2
    }
    while bit != 0 {
        if n >= result + bit {
            n = n - (result + bit)
            result = (result >> 1) + bit
        } else {
            result = result >> 1
        }
        bit = bit >> 2
    }
    result
}

/// The base 2 logarithm rounded down. A `self` that is 0 panics.
///
/// ```
/// let x: u64 = 8
/// assert_eq(x.ilog2(), 3)
/// ```
fn u64.ilog2(self): u32 {
    if self <= 0 {
        panic("ilog2 of a number that is not positive")
    }
    63 - self.leading_zeros()
}

/// The base 10 logarithm rounded down. A `self` that is 0 panics.
///
/// ```
/// let x: u64 = 100
/// assert_eq(x.ilog10(), 2)
/// ```
fn u64.ilog10(self): u32 {
    if self <= 0 {
        panic("ilog10 of a number that is not positive")
    }
    let mut v = self
    let mut n: u32 = 0
    while v >= 10 {
        v = v / 10
        n = n + 1
    }
    n
}

/// The number in the text in base `radix` (2 to 36; any other radix panics). Any failure (no digits, a character that is not a digit of the base, or a value out of range) is `ParseIntError.Invalid`.
fn __u64_parse_radix(s: str, radix: u32): Result<u64, ParseIntError> {
    if radix < 2 || radix > 36 {
        panic("parse_radix: radix must be 2 to 36")
    }
    let base: u64 = radix as u64
    let mut value: u64 = 0
    let mut seen_digit = false
    for c in s.chars() {
        match c.to_digit(radix) {
            Option.Some(d) => {
                let digit: u64 = d as u64
                let scaled = value.checked_mul(base)
                if scaled.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                let next = scaled.unwrap().checked_add(digit)
                if next.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                value = next.unwrap()
                seen_digit = true
            }
            Option.None => {
                return Result.Err(ParseIntError.Invalid)
            }
        }
    }
    if !seen_digit {
        return Result.Err(ParseIntError.Invalid)
    }
    Result.Ok(value)
}

/// The number written in base `radix` (2 to 36, lowercase digits; any other radix panics), with a leading `-` when negative.
///
/// ```
/// let x: u64 = 11
/// assert_eq(x.to_string_radix(2), String.from("1011"))
/// ```
fn u64.to_string_radix(self, radix: u32): String {
    if radix < 2 || radix > 36 {
        panic("to_string_radix: radix must be 2 to 36")
    }
    let mut out = String.new()
    let mut v: u64 = self
    if v == 0 {
        out.push('0')
        return out
    }
    let base: u64 = radix as u64
    let mut digits = List<char>.new()
    while v > 0 {
        let d = (v % base) as u32
        if d < 10 {
            digits.push((48 + d) as char)
        } else {
            digits.push((87 + d) as char)
        }
        v = v / base
    }
    let mut i = digits.len()
    while i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    out
}

/// The bytes in little-endian order.
///
/// ```
/// let x: u64 = 1
/// assert_eq(x.to_le_bytes()[0], 1)
/// ```
fn u64.to_le_bytes(self): [u8; 8] {
    let v: u64 = self
    [((v >> 0) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 24) & 255) as u8, ((v >> 32) & 255) as u8, ((v >> 40) & 255) as u8, ((v >> 48) & 255) as u8, ((v >> 56) & 255) as u8]
}

/// The bytes in big-endian order.
///
/// ```
/// let x: u64 = 1
/// assert_eq(x.to_be_bytes()[8 - 1], 1)
/// ```
fn u64.to_be_bytes(self): [u8; 8] {
    let v: u64 = self
    [((v >> 56) & 255) as u8, ((v >> 48) & 255) as u8, ((v >> 40) & 255) as u8, ((v >> 32) & 255) as u8, ((v >> 24) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 0) & 255) as u8]
}

/// The bytes in the byte order of the target, which is little-endian on every supported platform.
///
/// ```
/// let x: u64 = 1
/// assert_eq(x.to_ne_bytes()[0], 1)
/// ```
fn u64.to_ne_bytes(self): [u8; 8] {
    self.to_le_bytes()
}

/// The value whose little-endian bytes are `b`.
fn __u64_from_le_bytes(b: [u8; 8]): u64 {
    let v: u64 = ((b[0] as u64) << 0) | ((b[1] as u64) << 8) | ((b[2] as u64) << 16) | ((b[3] as u64) << 24) | ((b[4] as u64) << 32) | ((b[5] as u64) << 40) | ((b[6] as u64) << 48) | ((b[7] as u64) << 56)
    v
}

/// The value whose big-endian bytes are `b`.
fn __u64_from_be_bytes(b: [u8; 8]): u64 {
    let v: u64 = ((b[0] as u64) << 56) | ((b[1] as u64) << 48) | ((b[2] as u64) << 40) | ((b[3] as u64) << 32) | ((b[4] as u64) << 24) | ((b[5] as u64) << 16) | ((b[6] as u64) << 8) | ((b[7] as u64) << 0)
    v
}

/// The value whose native-endian bytes are `b`.
fn __u64_from_ne_bytes(b: [u8; 8]): u64 {
    __u64_from_le_bytes(b)
}

// ---- u128 ----

const __u128_MIN: u128 = 0
const __u128_MAX: u128 = 340282366920938463463374607431768211455
const __u128_BITS: u32 = 128

/// `self` to the power `exp`. Overflow panics in a debug build and wraps in a release build, like `*`.
///
/// ```
/// let x: u128 = 3
/// assert_eq(x.pow(3), 27)
/// ```
fn u128.pow(self, exp: u32): u128 {
    let mut result: u128 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
///
/// ```
/// let x: u128 = 2
/// assert_eq(x.wrapping_pow(3), 8)
/// ```
fn u128.wrapping_pow(self, exp: u32): u128 {
    let mut result: u128 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result.wrapping_mul(base)
        }
        e = e >> 1
        if e > 0 {
            base = base.wrapping_mul(base)
        }
    }
    result
}

/// `self` to the power `exp`, or `None` on overflow.
///
/// ```
/// let x: u128 = 3
/// assert_eq(x.checked_pow(3), Option.Some(27))
/// ```
fn u128.checked_pow(self, exp: u32): Option<u128> {
    let mut result: u128 = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            match result.checked_mul(base) {
                Option.Some(v) => {
                    result = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Option.Some(v) => {
                    base = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
    Option.Some(result)
}

/// `self / other`, or `None` when `other` is 0.
///
/// ```
/// let x: u128 = 7
/// assert_eq(x.checked_div(2), Option.Some(3))
/// assert(x.checked_div(0).is_none())
/// ```
fn u128.checked_div(self, other: u128): Option<u128> {
    if other == 0 {
        return Option.None
    }
    Option.Some(self / other)
}

/// `self % other`, or `None` when `other` is 0.
///
/// ```
/// let x: u128 = 7
/// assert_eq(x.checked_rem(4), Option.Some(3))
/// assert(x.checked_rem(0).is_none())
/// ```
fn u128.checked_rem(self, other: u128): Option<u128> {
    if other == 0 {
        return Option.None
    }
    Option.Some(self % other)
}

/// `-self`: `Some(0)` for 0 and `None` for every other value.
///
/// ```
/// let x: u128 = 0
/// assert_eq(x.checked_neg(), Option.Some(0))
/// let y: u128 = 1
/// assert(y.checked_neg().is_none())
/// ```
fn u128.checked_neg(self): Option<u128> {
    if self == 0 {
        return Option.Some(0)
    }
    Option.None
}

/// `-self`, wrapping around (two's complement).
///
/// ```
/// let x: u128 = 1
/// assert_eq(x.wrapping_neg().wrapping_neg(), 1)
/// ```
fn u128.wrapping_neg(self): u128 {
    let zero: u128 = 0
    zero.wrapping_sub(self)
}

/// `self << n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: u128 = 1
/// assert_eq(x.checked_shl(2), Option.Some(4))
/// assert(x.checked_shl(200).is_none())
/// ```
fn u128.checked_shl(self, n: u32): Option<u128> {
    if n >= 128 {
        return Option.None
    }
    Option.Some(self << n)
}

/// `self >> n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: u128 = 8
/// assert_eq(x.checked_shr(2), Option.Some(2))
/// assert(x.checked_shr(200).is_none())
/// ```
fn u128.checked_shr(self, n: u32): Option<u128> {
    if n >= 128 {
        return Option.None
    }
    Option.Some(self >> n)
}

/// `self << (n % bits)`.
///
/// ```
/// let x: u128 = 1
/// assert_eq(x.wrapping_shl(3), 8)
/// ```
fn u128.wrapping_shl(self, n: u32): u128 {
    self << (n % 128)
}

/// `self >> (n % bits)`.
///
/// ```
/// let x: u128 = 16
/// assert_eq(x.wrapping_shr(2), 4)
/// ```
fn u128.wrapping_shr(self, n: u32): u128 {
    self >> (n % 128)
}

/// `self + other`, clamped to the range of the type.
///
/// ```
/// let x: u128 = 2
/// assert_eq(x.saturating_add(3), 5)
/// ```
fn u128.saturating_add(self, other: u128): u128 {
    match self.checked_add(other) {
        Option.Some(v) => v,
        Option.None => __u128_MAX,
    }
}

/// `self - other`, clamped to the range of the type.
///
/// ```
/// let x: u128 = 5
/// assert_eq(x.saturating_sub(2), 3)
/// ```
fn u128.saturating_sub(self, other: u128): u128 {
    match self.checked_sub(other) {
        Option.Some(v) => v,
        Option.None => 0,
    }
}

/// `self * other`, clamped to the range of the type.
///
/// ```
/// let x: u128 = 2
/// assert_eq(x.saturating_mul(3), 6)
/// ```
fn u128.saturating_mul(self, other: u128): u128 {
    match self.checked_mul(other) {
        Option.Some(v) => v,
        Option.None => __u128_MAX,
    }
}

/// `self` to the power `exp`, clamped to the range of the type.
///
/// ```
/// let x: u128 = 2
/// assert_eq(x.saturating_pow(3), 8)
/// ```
fn u128.saturating_pow(self, exp: u32): u128 {
    match self.checked_pow(exp) {
        Option.Some(v) => v,
        Option.None => __u128_MAX,
    }
}

/// `self + other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u128 = 1
/// assert_eq(x.overflowing_add(2), (3, false))
/// ```
fn u128.overflowing_add(self, other: u128): (u128, bool) {
    (self.wrapping_add(other), self.checked_add(other).is_none())
}

/// `self - other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u128 = 5
/// assert_eq(x.overflowing_sub(2), (3, false))
/// ```
fn u128.overflowing_sub(self, other: u128): (u128, bool) {
    (self.wrapping_sub(other), self.checked_sub(other).is_none())
}

/// `self * other` wrapped, and whether it overflowed.
///
/// ```
/// let x: u128 = 3
/// assert_eq(x.overflowing_mul(4), (12, false))
/// ```
fn u128.overflowing_mul(self, other: u128): (u128, bool) {
    (self.wrapping_mul(other), self.checked_mul(other).is_none())
}

/// `self / other`. Division by 0 panics.
///
/// ```
/// let x: u128 = 7
/// assert_eq(x.div_euclid(2), 3)
/// ```
fn u128.div_euclid(self, other: u128): u128 {
    self / other
}

/// `self % other`. Division by 0 panics.
///
/// ```
/// let x: u128 = 7
/// assert_eq(x.rem_euclid(4), 3)
/// ```
fn u128.rem_euclid(self, other: u128): u128 {
    self % other
}

/// The distance between `self` and `other`.
///
/// ```
/// let x: u128 = 5
/// assert_eq(x.abs_diff(9), 4)
/// ```
fn u128.abs_diff(self, other: u128): u128 {
    if self > other {
        return self - other
    }
    other - self
}

/// The number of 1 bits.
///
/// ```
/// let x: u128 = 7
/// assert_eq(x.count_ones(), 3)
/// ```
fn u128.count_ones(self): u32 {
    let mut v: u128 = self
    let mut n: u32 = 0
    while v != 0 {
        n = n + (v & 1) as u32
        v = v >> 1
    }
    n
}

/// The number of 0 bits.
///
/// ```
/// let x: u128 = 7
/// assert_eq(x.count_zeros(), 128 - 3)
/// ```
fn u128.count_zeros(self): u32 {
    128 - self.count_ones()
}

/// The number of 0 bits before the first 1 bit, from the top.
///
/// ```
/// let x: u128 = 1
/// assert_eq(x.leading_zeros(), 128 - 1)
/// ```
fn u128.leading_zeros(self): u32 {
    let v: u128 = self
    let mut n: u32 = 0
    let mut i: u32 = 128
    while i > 0 {
        i = i - 1
        if (v >> i) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The number of 0 bits after the last 1 bit, from the bottom.
///
/// ```
/// let x: u128 = 8
/// assert_eq(x.trailing_zeros(), 3)
/// ```
fn u128.trailing_zeros(self): u32 {
    let v: u128 = self
    let mut n: u32 = 0
    while n < 128 {
        if (v >> n) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The bits rotated left by `n % bits` places.
///
/// ```
/// let x: u128 = 1
/// assert_eq(x.rotate_left(1), 2)
/// ```
fn u128.rotate_left(self, n: u32): u128 {
    let v: u128 = self
    let k = n % 128
    if k == 0 {
        return self
    }
    let back: u32 = 128 - k
    ((v << k) | (v >> back)) as u128
}

/// The bits rotated right by `n % bits` places.
///
/// ```
/// let x: u128 = 2
/// assert_eq(x.rotate_right(1), 1)
/// ```
fn u128.rotate_right(self, n: u32): u128 {
    let v: u128 = self
    let k = n % 128
    if k == 0 {
        return self
    }
    let back: u32 = 128 - k
    ((v >> k) | (v << back)) as u128
}

/// The bytes in the opposite order.
///
/// ```
/// let x: u128 = 1
/// assert_eq(x.swap_bytes().swap_bytes(), 1)
/// ```
fn u128.swap_bytes(self): u128 {
    let v: u128 = self
    let mut r: u128 = 0
    let mut i: u32 = 0
    while i < 16 {
        let shift: u32 = 8 * i
        r = (r << 8) | ((v >> shift) & 255)
        i = i + 1
    }
    r as u128
}

/// The bits in the opposite order.
///
/// ```
/// let x: u128 = 1
/// assert_eq(x.reverse_bits().reverse_bits(), 1)
/// ```
fn u128.reverse_bits(self): u128 {
    let v: u128 = self
    let mut r: u128 = 0
    let mut i: u32 = 0
    while i < 128 {
        r = (r << 1) | ((v >> i) & 1)
        i = i + 1
    }
    r as u128
}

/// Whether exactly one bit is set.
///
/// ```
/// let x: u128 = 8
/// assert(x.is_power_of_two())
/// let y: u128 = 6
/// assert(!y.is_power_of_two())
/// ```
fn u128.is_power_of_two(self): bool {
    self != 0 && self & (self - 1) == 0
}

/// The smallest power of two that is at least `self`, or `None` when it does not fit.
///
/// ```
/// let x: u128 = 5
/// assert_eq(x.checked_next_power_of_two(), Option.Some(8))
/// ```
fn u128.checked_next_power_of_two(self): Option<u128> {
    if self <= 1 {
        return Option.Some(1)
    }
    let top = 128 - (self - 1).leading_zeros()
    if top >= 128 {
        return Option.None
    }
    Option.Some(1 << top)
}

/// The smallest power of two that is at least `self`. It panics when the result does not fit.
///
/// ```
/// let x: u128 = 5
/// assert_eq(x.next_power_of_two(), 8)
/// ```
fn u128.next_power_of_two(self): u128 {
    match self.checked_next_power_of_two() {
        Option.Some(v) => v,
        Option.None => panic("next_power_of_two overflowed"),
    }
}

/// The integer square root: the greatest `r` with `r * r <= self`.
///
/// ```
/// let x: u128 = 17
/// assert_eq(x.isqrt(), 4)
/// ```
fn u128.isqrt(self): u128 {
    let mut n: u128 = self
    let mut result: u128 = 0
    let mut bit: u128 = 1 << 126
    while bit > n {
        bit = bit >> 2
    }
    while bit != 0 {
        if n >= result + bit {
            n = n - (result + bit)
            result = (result >> 1) + bit
        } else {
            result = result >> 1
        }
        bit = bit >> 2
    }
    result
}

/// The base 2 logarithm rounded down. A `self` that is 0 panics.
///
/// ```
/// let x: u128 = 8
/// assert_eq(x.ilog2(), 3)
/// ```
fn u128.ilog2(self): u32 {
    if self <= 0 {
        panic("ilog2 of a number that is not positive")
    }
    127 - self.leading_zeros()
}

/// The base 10 logarithm rounded down. A `self` that is 0 panics.
///
/// ```
/// let x: u128 = 100
/// assert_eq(x.ilog10(), 2)
/// ```
fn u128.ilog10(self): u32 {
    if self <= 0 {
        panic("ilog10 of a number that is not positive")
    }
    let mut v = self
    let mut n: u32 = 0
    while v >= 10 {
        v = v / 10
        n = n + 1
    }
    n
}

/// The number in the text in base `radix` (2 to 36; any other radix panics). Any failure (no digits, a character that is not a digit of the base, or a value out of range) is `ParseIntError.Invalid`.
fn __u128_parse_radix(s: str, radix: u32): Result<u128, ParseIntError> {
    if radix < 2 || radix > 36 {
        panic("parse_radix: radix must be 2 to 36")
    }
    let base: u128 = radix as u128
    let mut value: u128 = 0
    let mut seen_digit = false
    for c in s.chars() {
        match c.to_digit(radix) {
            Option.Some(d) => {
                let digit: u128 = d as u128
                let scaled = value.checked_mul(base)
                if scaled.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                let next = scaled.unwrap().checked_add(digit)
                if next.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                value = next.unwrap()
                seen_digit = true
            }
            Option.None => {
                return Result.Err(ParseIntError.Invalid)
            }
        }
    }
    if !seen_digit {
        return Result.Err(ParseIntError.Invalid)
    }
    Result.Ok(value)
}

/// The number written in base `radix` (2 to 36, lowercase digits; any other radix panics), with a leading `-` when negative.
///
/// ```
/// let x: u128 = 11
/// assert_eq(x.to_string_radix(2), String.from("1011"))
/// ```
fn u128.to_string_radix(self, radix: u32): String {
    if radix < 2 || radix > 36 {
        panic("to_string_radix: radix must be 2 to 36")
    }
    let mut out = String.new()
    let mut v: u128 = self
    if v == 0 {
        out.push('0')
        return out
    }
    let base: u128 = radix as u128
    let mut digits = List<char>.new()
    while v > 0 {
        let d = (v % base) as u32
        if d < 10 {
            digits.push((48 + d) as char)
        } else {
            digits.push((87 + d) as char)
        }
        v = v / base
    }
    let mut i = digits.len()
    while i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    out
}

/// The bytes in little-endian order.
///
/// ```
/// let x: u128 = 1
/// assert_eq(x.to_le_bytes()[0], 1)
/// ```
fn u128.to_le_bytes(self): [u8; 16] {
    let v: u128 = self
    [((v >> 0) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 24) & 255) as u8, ((v >> 32) & 255) as u8, ((v >> 40) & 255) as u8, ((v >> 48) & 255) as u8, ((v >> 56) & 255) as u8, ((v >> 64) & 255) as u8, ((v >> 72) & 255) as u8, ((v >> 80) & 255) as u8, ((v >> 88) & 255) as u8, ((v >> 96) & 255) as u8, ((v >> 104) & 255) as u8, ((v >> 112) & 255) as u8, ((v >> 120) & 255) as u8]
}

/// The bytes in big-endian order.
///
/// ```
/// let x: u128 = 1
/// assert_eq(x.to_be_bytes()[16 - 1], 1)
/// ```
fn u128.to_be_bytes(self): [u8; 16] {
    let v: u128 = self
    [((v >> 120) & 255) as u8, ((v >> 112) & 255) as u8, ((v >> 104) & 255) as u8, ((v >> 96) & 255) as u8, ((v >> 88) & 255) as u8, ((v >> 80) & 255) as u8, ((v >> 72) & 255) as u8, ((v >> 64) & 255) as u8, ((v >> 56) & 255) as u8, ((v >> 48) & 255) as u8, ((v >> 40) & 255) as u8, ((v >> 32) & 255) as u8, ((v >> 24) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 0) & 255) as u8]
}

/// The bytes in the byte order of the target, which is little-endian on every supported platform.
///
/// ```
/// let x: u128 = 1
/// assert_eq(x.to_ne_bytes()[0], 1)
/// ```
fn u128.to_ne_bytes(self): [u8; 16] {
    self.to_le_bytes()
}

/// The value whose little-endian bytes are `b`.
fn __u128_from_le_bytes(b: [u8; 16]): u128 {
    let v: u128 = ((b[0] as u128) << 0) | ((b[1] as u128) << 8) | ((b[2] as u128) << 16) | ((b[3] as u128) << 24) | ((b[4] as u128) << 32) | ((b[5] as u128) << 40) | ((b[6] as u128) << 48) | ((b[7] as u128) << 56) | ((b[8] as u128) << 64) | ((b[9] as u128) << 72) | ((b[10] as u128) << 80) | ((b[11] as u128) << 88) | ((b[12] as u128) << 96) | ((b[13] as u128) << 104) | ((b[14] as u128) << 112) | ((b[15] as u128) << 120)
    v
}

/// The value whose big-endian bytes are `b`.
fn __u128_from_be_bytes(b: [u8; 16]): u128 {
    let v: u128 = ((b[0] as u128) << 120) | ((b[1] as u128) << 112) | ((b[2] as u128) << 104) | ((b[3] as u128) << 96) | ((b[4] as u128) << 88) | ((b[5] as u128) << 80) | ((b[6] as u128) << 72) | ((b[7] as u128) << 64) | ((b[8] as u128) << 56) | ((b[9] as u128) << 48) | ((b[10] as u128) << 40) | ((b[11] as u128) << 32) | ((b[12] as u128) << 24) | ((b[13] as u128) << 16) | ((b[14] as u128) << 8) | ((b[15] as u128) << 0)
    v
}

/// The value whose native-endian bytes are `b`.
fn __u128_from_ne_bytes(b: [u8; 16]): u128 {
    __u128_from_le_bytes(b)
}

// ---- usize ----

const __usize_MIN: usize = 0
const __usize_MAX: usize = 18446744073709551615
const __usize_BITS: u32 = 64

/// `self` to the power `exp`. Overflow panics in a debug build and wraps in a release build, like `*`.
///
/// ```
/// let x: usize = 3
/// assert_eq(x.pow(3), 27)
/// ```
fn usize.pow(self, exp: u32): usize {
    let mut result: usize = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result * base
        }
        e = e >> 1
        if e > 0 {
            base = base * base
        }
    }
    result
}

/// `self` to the power `exp`, wrapping around on overflow.
///
/// ```
/// let x: usize = 2
/// assert_eq(x.wrapping_pow(3), 8)
/// ```
fn usize.wrapping_pow(self, exp: u32): usize {
    let mut result: usize = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            result = result.wrapping_mul(base)
        }
        e = e >> 1
        if e > 0 {
            base = base.wrapping_mul(base)
        }
    }
    result
}

/// `self` to the power `exp`, or `None` on overflow.
///
/// ```
/// let x: usize = 3
/// assert_eq(x.checked_pow(3), Option.Some(27))
/// ```
fn usize.checked_pow(self, exp: u32): Option<usize> {
    let mut result: usize = 1
    let mut base = self
    let mut e = exp
    while e > 0 {
        if e & 1 == 1 {
            match result.checked_mul(base) {
                Option.Some(v) => {
                    result = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        e = e >> 1
        if e > 0 {
            match base.checked_mul(base) {
                Option.Some(v) => {
                    base = v
                }
                Option.None => {
                    return Option.None
                }
            }
        }
    }
    Option.Some(result)
}

/// `self / other`, or `None` when `other` is 0.
///
/// ```
/// let x: usize = 7
/// assert_eq(x.checked_div(2), Option.Some(3))
/// assert(x.checked_div(0).is_none())
/// ```
fn usize.checked_div(self, other: usize): Option<usize> {
    if other == 0 {
        return Option.None
    }
    Option.Some(self / other)
}

/// `self % other`, or `None` when `other` is 0.
///
/// ```
/// let x: usize = 7
/// assert_eq(x.checked_rem(4), Option.Some(3))
/// assert(x.checked_rem(0).is_none())
/// ```
fn usize.checked_rem(self, other: usize): Option<usize> {
    if other == 0 {
        return Option.None
    }
    Option.Some(self % other)
}

/// `-self`: `Some(0)` for 0 and `None` for every other value.
///
/// ```
/// let x: usize = 0
/// assert_eq(x.checked_neg(), Option.Some(0))
/// let y: usize = 1
/// assert(y.checked_neg().is_none())
/// ```
fn usize.checked_neg(self): Option<usize> {
    if self == 0 {
        return Option.Some(0)
    }
    Option.None
}

/// `-self`, wrapping around (two's complement).
///
/// ```
/// let x: usize = 1
/// assert_eq(x.wrapping_neg().wrapping_neg(), 1)
/// ```
fn usize.wrapping_neg(self): usize {
    let zero: usize = 0
    zero.wrapping_sub(self)
}

/// `self << n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: usize = 1
/// assert_eq(x.checked_shl(2), Option.Some(4))
/// assert(x.checked_shl(200).is_none())
/// ```
fn usize.checked_shl(self, n: u32): Option<usize> {
    if n >= 64 {
        return Option.None
    }
    Option.Some(self << n)
}

/// `self >> n`, or `None` when `n` is the number of bits or more.
///
/// ```
/// let x: usize = 8
/// assert_eq(x.checked_shr(2), Option.Some(2))
/// assert(x.checked_shr(200).is_none())
/// ```
fn usize.checked_shr(self, n: u32): Option<usize> {
    if n >= 64 {
        return Option.None
    }
    Option.Some(self >> n)
}

/// `self << (n % bits)`.
///
/// ```
/// let x: usize = 1
/// assert_eq(x.wrapping_shl(3), 8)
/// ```
fn usize.wrapping_shl(self, n: u32): usize {
    self << (n % 64)
}

/// `self >> (n % bits)`.
///
/// ```
/// let x: usize = 16
/// assert_eq(x.wrapping_shr(2), 4)
/// ```
fn usize.wrapping_shr(self, n: u32): usize {
    self >> (n % 64)
}

/// `self + other`, clamped to the range of the type.
///
/// ```
/// let x: usize = 2
/// assert_eq(x.saturating_add(3), 5)
/// ```
fn usize.saturating_add(self, other: usize): usize {
    match self.checked_add(other) {
        Option.Some(v) => v,
        Option.None => __usize_MAX,
    }
}

/// `self - other`, clamped to the range of the type.
///
/// ```
/// let x: usize = 5
/// assert_eq(x.saturating_sub(2), 3)
/// ```
fn usize.saturating_sub(self, other: usize): usize {
    match self.checked_sub(other) {
        Option.Some(v) => v,
        Option.None => 0,
    }
}

/// `self * other`, clamped to the range of the type.
///
/// ```
/// let x: usize = 2
/// assert_eq(x.saturating_mul(3), 6)
/// ```
fn usize.saturating_mul(self, other: usize): usize {
    match self.checked_mul(other) {
        Option.Some(v) => v,
        Option.None => __usize_MAX,
    }
}

/// `self` to the power `exp`, clamped to the range of the type.
///
/// ```
/// let x: usize = 2
/// assert_eq(x.saturating_pow(3), 8)
/// ```
fn usize.saturating_pow(self, exp: u32): usize {
    match self.checked_pow(exp) {
        Option.Some(v) => v,
        Option.None => __usize_MAX,
    }
}

/// `self + other` wrapped, and whether it overflowed.
///
/// ```
/// let x: usize = 1
/// assert_eq(x.overflowing_add(2), (3, false))
/// ```
fn usize.overflowing_add(self, other: usize): (usize, bool) {
    (self.wrapping_add(other), self.checked_add(other).is_none())
}

/// `self - other` wrapped, and whether it overflowed.
///
/// ```
/// let x: usize = 5
/// assert_eq(x.overflowing_sub(2), (3, false))
/// ```
fn usize.overflowing_sub(self, other: usize): (usize, bool) {
    (self.wrapping_sub(other), self.checked_sub(other).is_none())
}

/// `self * other` wrapped, and whether it overflowed.
///
/// ```
/// let x: usize = 3
/// assert_eq(x.overflowing_mul(4), (12, false))
/// ```
fn usize.overflowing_mul(self, other: usize): (usize, bool) {
    (self.wrapping_mul(other), self.checked_mul(other).is_none())
}

/// `self / other`. Division by 0 panics.
///
/// ```
/// let x: usize = 7
/// assert_eq(x.div_euclid(2), 3)
/// ```
fn usize.div_euclid(self, other: usize): usize {
    self / other
}

/// `self % other`. Division by 0 panics.
///
/// ```
/// let x: usize = 7
/// assert_eq(x.rem_euclid(4), 3)
/// ```
fn usize.rem_euclid(self, other: usize): usize {
    self % other
}

/// The distance between `self` and `other`.
///
/// ```
/// let x: usize = 5
/// assert_eq(x.abs_diff(9), 4)
/// ```
fn usize.abs_diff(self, other: usize): usize {
    if self > other {
        return self - other
    }
    other - self
}

/// The number of 1 bits.
///
/// ```
/// let x: usize = 7
/// assert_eq(x.count_ones(), 3)
/// ```
fn usize.count_ones(self): u32 {
    let mut v: usize = self
    let mut n: u32 = 0
    while v != 0 {
        n = n + (v & 1) as u32
        v = v >> 1
    }
    n
}

/// The number of 0 bits.
///
/// ```
/// let x: usize = 7
/// assert_eq(x.count_zeros(), 64 - 3)
/// ```
fn usize.count_zeros(self): u32 {
    64 - self.count_ones()
}

/// The number of 0 bits before the first 1 bit, from the top.
///
/// ```
/// let x: usize = 1
/// assert_eq(x.leading_zeros(), 64 - 1)
/// ```
fn usize.leading_zeros(self): u32 {
    let v: usize = self
    let mut n: u32 = 0
    let mut i: u32 = 64
    while i > 0 {
        i = i - 1
        if (v >> i) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The number of 0 bits after the last 1 bit, from the bottom.
///
/// ```
/// let x: usize = 8
/// assert_eq(x.trailing_zeros(), 3)
/// ```
fn usize.trailing_zeros(self): u32 {
    let v: usize = self
    let mut n: u32 = 0
    while n < 64 {
        if (v >> n) & 1 == 1 {
            return n
        }
        n = n + 1
    }
    n
}

/// The bits rotated left by `n % bits` places.
///
/// ```
/// let x: usize = 1
/// assert_eq(x.rotate_left(1), 2)
/// ```
fn usize.rotate_left(self, n: u32): usize {
    let v: usize = self
    let k = n % 64
    if k == 0 {
        return self
    }
    let back: u32 = 64 - k
    ((v << k) | (v >> back)) as usize
}

/// The bits rotated right by `n % bits` places.
///
/// ```
/// let x: usize = 2
/// assert_eq(x.rotate_right(1), 1)
/// ```
fn usize.rotate_right(self, n: u32): usize {
    let v: usize = self
    let k = n % 64
    if k == 0 {
        return self
    }
    let back: u32 = 64 - k
    ((v >> k) | (v << back)) as usize
}

/// The bytes in the opposite order.
///
/// ```
/// let x: usize = 1
/// assert_eq(x.swap_bytes().swap_bytes(), 1)
/// ```
fn usize.swap_bytes(self): usize {
    let v: usize = self
    let mut r: usize = 0
    let mut i: u32 = 0
    while i < 8 {
        let shift: u32 = 8 * i
        r = (r << 8) | ((v >> shift) & 255)
        i = i + 1
    }
    r as usize
}

/// The bits in the opposite order.
///
/// ```
/// let x: usize = 1
/// assert_eq(x.reverse_bits().reverse_bits(), 1)
/// ```
fn usize.reverse_bits(self): usize {
    let v: usize = self
    let mut r: usize = 0
    let mut i: u32 = 0
    while i < 64 {
        r = (r << 1) | ((v >> i) & 1)
        i = i + 1
    }
    r as usize
}

/// Whether exactly one bit is set.
///
/// ```
/// let x: usize = 8
/// assert(x.is_power_of_two())
/// let y: usize = 6
/// assert(!y.is_power_of_two())
/// ```
fn usize.is_power_of_two(self): bool {
    self != 0 && self & (self - 1) == 0
}

/// The smallest power of two that is at least `self`, or `None` when it does not fit.
///
/// ```
/// let x: usize = 5
/// assert_eq(x.checked_next_power_of_two(), Option.Some(8))
/// ```
fn usize.checked_next_power_of_two(self): Option<usize> {
    if self <= 1 {
        return Option.Some(1)
    }
    let top = 64 - (self - 1).leading_zeros()
    if top >= 64 {
        return Option.None
    }
    Option.Some(1 << top)
}

/// The smallest power of two that is at least `self`. It panics when the result does not fit.
///
/// ```
/// let x: usize = 5
/// assert_eq(x.next_power_of_two(), 8)
/// ```
fn usize.next_power_of_two(self): usize {
    match self.checked_next_power_of_two() {
        Option.Some(v) => v,
        Option.None => panic("next_power_of_two overflowed"),
    }
}

/// The integer square root: the greatest `r` with `r * r <= self`.
///
/// ```
/// let x: usize = 17
/// assert_eq(x.isqrt(), 4)
/// ```
fn usize.isqrt(self): usize {
    let mut n: usize = self
    let mut result: usize = 0
    let mut bit: usize = 1 << 62
    while bit > n {
        bit = bit >> 2
    }
    while bit != 0 {
        if n >= result + bit {
            n = n - (result + bit)
            result = (result >> 1) + bit
        } else {
            result = result >> 1
        }
        bit = bit >> 2
    }
    result
}

/// The base 2 logarithm rounded down. A `self` that is 0 panics.
///
/// ```
/// let x: usize = 8
/// assert_eq(x.ilog2(), 3)
/// ```
fn usize.ilog2(self): u32 {
    if self <= 0 {
        panic("ilog2 of a number that is not positive")
    }
    63 - self.leading_zeros()
}

/// The base 10 logarithm rounded down. A `self` that is 0 panics.
///
/// ```
/// let x: usize = 100
/// assert_eq(x.ilog10(), 2)
/// ```
fn usize.ilog10(self): u32 {
    if self <= 0 {
        panic("ilog10 of a number that is not positive")
    }
    let mut v = self
    let mut n: u32 = 0
    while v >= 10 {
        v = v / 10
        n = n + 1
    }
    n
}

/// The number in the text in base `radix` (2 to 36; any other radix panics). Any failure (no digits, a character that is not a digit of the base, or a value out of range) is `ParseIntError.Invalid`.
fn __usize_parse_radix(s: str, radix: u32): Result<usize, ParseIntError> {
    if radix < 2 || radix > 36 {
        panic("parse_radix: radix must be 2 to 36")
    }
    let base: usize = radix as usize
    let mut value: usize = 0
    let mut seen_digit = false
    for c in s.chars() {
        match c.to_digit(radix) {
            Option.Some(d) => {
                let digit: usize = d as usize
                let scaled = value.checked_mul(base)
                if scaled.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                let next = scaled.unwrap().checked_add(digit)
                if next.is_none() {
                    return Result.Err(ParseIntError.Invalid)
                }
                value = next.unwrap()
                seen_digit = true
            }
            Option.None => {
                return Result.Err(ParseIntError.Invalid)
            }
        }
    }
    if !seen_digit {
        return Result.Err(ParseIntError.Invalid)
    }
    Result.Ok(value)
}

/// The number written in base `radix` (2 to 36, lowercase digits; any other radix panics), with a leading `-` when negative.
///
/// ```
/// let x: usize = 11
/// assert_eq(x.to_string_radix(2), String.from("1011"))
/// ```
fn usize.to_string_radix(self, radix: u32): String {
    if radix < 2 || radix > 36 {
        panic("to_string_radix: radix must be 2 to 36")
    }
    let mut out = String.new()
    let mut v: usize = self
    if v == 0 {
        out.push('0')
        return out
    }
    let base: usize = radix as usize
    let mut digits = List<char>.new()
    while v > 0 {
        let d = (v % base) as u32
        if d < 10 {
            digits.push((48 + d) as char)
        } else {
            digits.push((87 + d) as char)
        }
        v = v / base
    }
    let mut i = digits.len()
    while i > 0 {
        i = i - 1
        out.push(digits[i])
    }
    out
}

/// The bytes in little-endian order.
///
/// ```
/// let x: usize = 1
/// assert_eq(x.to_le_bytes()[0], 1)
/// ```
fn usize.to_le_bytes(self): [u8; 8] {
    let v: usize = self
    [((v >> 0) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 24) & 255) as u8, ((v >> 32) & 255) as u8, ((v >> 40) & 255) as u8, ((v >> 48) & 255) as u8, ((v >> 56) & 255) as u8]
}

/// The bytes in big-endian order.
///
/// ```
/// let x: usize = 1
/// assert_eq(x.to_be_bytes()[8 - 1], 1)
/// ```
fn usize.to_be_bytes(self): [u8; 8] {
    let v: usize = self
    [((v >> 56) & 255) as u8, ((v >> 48) & 255) as u8, ((v >> 40) & 255) as u8, ((v >> 32) & 255) as u8, ((v >> 24) & 255) as u8, ((v >> 16) & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 0) & 255) as u8]
}

/// The bytes in the byte order of the target, which is little-endian on every supported platform.
///
/// ```
/// let x: usize = 1
/// assert_eq(x.to_ne_bytes()[0], 1)
/// ```
fn usize.to_ne_bytes(self): [u8; 8] {
    self.to_le_bytes()
}

/// The value whose little-endian bytes are `b`.
fn __usize_from_le_bytes(b: [u8; 8]): usize {
    let v: usize = ((b[0] as usize) << 0) | ((b[1] as usize) << 8) | ((b[2] as usize) << 16) | ((b[3] as usize) << 24) | ((b[4] as usize) << 32) | ((b[5] as usize) << 40) | ((b[6] as usize) << 48) | ((b[7] as usize) << 56)
    v
}

/// The value whose big-endian bytes are `b`.
fn __usize_from_be_bytes(b: [u8; 8]): usize {
    let v: usize = ((b[0] as usize) << 56) | ((b[1] as usize) << 48) | ((b[2] as usize) << 40) | ((b[3] as usize) << 32) | ((b[4] as usize) << 24) | ((b[5] as usize) << 16) | ((b[6] as usize) << 8) | ((b[7] as usize) << 0)
    v
}

/// The value whose native-endian bytes are `b`.
fn __usize_from_ne_bytes(b: [u8; 8]): usize {
    __usize_from_le_bytes(b)
}
