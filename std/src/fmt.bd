// Formatting (spec/format.md).
//
// A string with `{...}` placeholders, `format`, and the output functions build their text in a `Formatter`. The
// compiler lowers each placeholder to a call that writes one value: `x.fmt(mut f)` for `Display`, `x.debug(mut f)`
// for `Debug`. Integers, floats, `bool`, `char`, `str`, and `String` are formatted by the functions below; a user
// type provides its own `fmt` and `debug` (written by hand, or generated by `: Debug` after the type's name).

use alloc.Allocator

/// A type that can be shown to a person: `{}` in a format string.
///
/// ```
/// struct Name {
///     text: String
/// }
///
/// Name: Display {
///     fn fmt(self, mut f: Formatter) {
///         f.pad(self.text)
///     }
/// }
///
/// fn main() {
///     let n = Name { text: String.from("ada") }
///     assert_eq(format("[{:>5}]", n), String.from("[  ada]"))
/// }
/// ```
interface Display {
    /// Writes the value to `f`. `f.pad(text)` applies the width, fill, alignment, and precision of the placeholder.
    ///
    /// ```
    /// struct Name {
    ///     text: String
    /// }
    ///
    /// Name: Display {
    ///     fn fmt(self, mut f: Formatter) {
    ///         f.pad(self.text)
    ///     }
    /// }
    ///
    /// fn main() {
    ///     let n = Name { text: String.from("ada") }
    ///     assert_eq(format("{}", n), String.from("ada"))
    ///     assert_eq(format("[{:>5}]", n), String.from("[  ada]"))
    /// }
    /// ```
    fn fmt(self, mut f: Formatter)
}

/// A type that can be shown to a programmer: `{:?}` in a format string.
///
/// ```
/// struct Name {
///     text: String
/// }
///
/// Name: Debug {
///     fn debug(self, mut f: Formatter) {
///         f.write_str("Name(")
///         f.write_str(self.text)
///         f.write_str(")")
///     }
/// }
///
/// fn main() {
///     let n = Name { text: String.from("ada") }
///     assert_eq(format("{:?}", n), String.from("Name(ada)"))
/// }
/// ```
interface Debug {
    /// Writes the value to `f`.
    ///
    /// ```
    /// struct Name {
    ///     text: String
    /// }
    ///
    /// Name: Debug {
    ///     fn debug(self, mut f: Formatter) {
    ///         f.write_str("Name(")
    ///         f.write_str(self.text)
    ///         f.write_str(")")
    ///     }
    /// }
    ///
    /// fn main() {
    ///     let n = Name { text: String.from("ada") }
    ///     assert_eq(format("{:?}", n), String.from("Name(ada)"))
    /// }
    /// ```
    fn debug(self, mut f: Formatter)
}

/// The text a formatting operation builds, plus the specifier of the placeholder being formatted.
///
/// ```
/// struct Tag {
///     name: String
/// }
///
/// Tag: Display {
///     fn fmt(self, mut f: Formatter) {
///         f.write_str("<")
///         f.write_str(self.name)
///         f.write_str(">")
///     }
/// }
///
/// fn main() {
///     let tag = Tag { name: String.from("b") }
///     assert_eq(format("{}", tag), String.from("<b>"))
/// }
/// ```
struct Formatter {
    priv out: String
    priv fill: char
    // 0 = not written, 1 = left, 2 = center, 3 = right.
    priv align: i32
    priv plus: bool
    priv alt: bool
    priv zero: bool
    priv has_width: bool
    priv width: usize
    priv has_precision: bool
    priv precision: usize
    // 10, 16 (lower-case hex), 17 (upper-case hex), 2, or 8.
    priv radix: i32
}

Formatter {
    /// An empty formatter with the default specifier.
    ///
    /// ```
    /// let f = Formatter.new()
    /// assert_eq(f.finish(), String.from(""))
    /// ```
    fn new(): Formatter {
        Formatter {
            out: String.new(),
            fill: ' ',
            align: 0,
            plus: false,
            alt: false,
            zero: false,
            has_width: false,
            width: 0,
            has_precision: false,
            precision: 0,
            radix: 10,
        }
    }

    /// The text written so far, ending the formatter.
    ///
    /// ```
    /// let mut f = Formatter.new()
    /// f.write_str("ok")
    /// assert_eq(f.finish(), String.from("ok"))
    /// ```
    fn finish(own self): String {
        self.out
    }

    /// Appends text as it is, ignoring the specifier.
    ///
    /// ```
    /// let mut f = Formatter.new()
    /// f.write_str("ab")
    /// assert_eq(f.finish(), String.from("ab"))
    /// ```
    fn write_str(mut self, s: str) {
        self.out.push_str(s)
    }

    /// Appends one character as it is, ignoring the specifier.
    ///
    /// ```
    /// let mut f = Formatter.new()
    /// f.write_char('z')
    /// assert_eq(f.finish(), String.from("z"))
    /// ```
    fn write_char(mut self, c: char) {
        self.out.push(c)
    }

    /// Sets the specifier of the next value.
    ///
    /// ```
    /// let mut f = Formatter.new()
    /// f.set_spec('*', 3, false, false, false, true, 5, false, 0, 10)
    /// f.pad("x")
    /// assert_eq(f.finish(), String.from("****x"))
    /// ```
    fn set_spec(
        mut self,
        fill: char,
        align: i32,
        plus: bool,
        alt: bool,
        zero: bool,
        has_width: bool,
        width: usize,
        has_precision: bool,
        precision: usize,
        radix: i32,
    ) {
        self.fill = fill
        self.align = align
        self.plus = plus
        self.alt = alt
        self.zero = zero
        self.has_width = has_width
        self.width = width
        self.has_precision = has_precision
        self.precision = precision
        self.radix = radix
    }

    /// Restores the default specifier.
    ///
    /// ```
    /// let mut f = Formatter.new()
    /// f.set_spec('*', 3, false, false, false, true, 5, false, 0, 10)
    /// f.reset_spec()
    /// f.pad("ab")
    /// assert_eq(f.finish(), String.from("ab"))
    /// ```
    fn reset_spec(mut self) {
        self.fill = ' '
        self.align = 0
        self.plus = false
        self.alt = false
        self.zero = false
        self.has_width = false
        self.has_precision = false
        self.radix = 10
    }

    /// The minimum width of the placeholder, if one was written.
    ///
    /// ```
    /// let mut f = Formatter.new()
    /// assert(f.width().is_none())
    /// f.set_spec('*', 3, false, false, false, true, 5, false, 0, 10)
    /// assert_eq(f.width(), Option.Some(5))
    /// ```
    fn width(self): Option<usize> {
        if self.has_width {
            Option.Some(self.width)
        } else {
            Option.None
        }
    }

    /// The precision of the placeholder, if one was written.
    ///
    /// ```
    /// let f = Formatter.new()
    /// assert(f.precision().is_none())
    /// ```
    fn precision(self): Option<usize> {
        if self.has_precision {
            Option.Some(self.precision)
        } else {
            Option.None
        }
    }

    /// The fill character of the placeholder (a space unless one was written).
    ///
    /// ```
    /// let f = Formatter.new()
    /// assert_eq(f.fill(), ' ')
    /// ```
    fn fill(self): char {
        self.fill
    }

    /// Whether the placeholder has the `#` flag.
    ///
    /// ```
    /// let f = Formatter.new()
    /// assert(!f.alternate())
    /// ```
    fn alternate(self): bool {
        self.alt
    }

    /// Whether the placeholder has the `+` flag.
    ///
    /// ```
    /// let f = Formatter.new()
    /// assert(!f.sign_plus())
    /// ```
    fn sign_plus(self): bool {
        self.plus
    }

    /// Writes `s` with the placeholder's precision (at most that many characters), width, fill, and alignment.
    /// Text is left-aligned unless the placeholder says otherwise.
    ///
    /// ```
    /// let mut f = Formatter.new()
    /// f.set_spec('*', 3, false, false, false, true, 5, false, 0, 10)
    /// f.pad("ab")
    /// assert_eq(f.finish(), String.from("***ab"))
    /// ```
    fn pad(mut self, s: str) {
        let mut bytes: usize = 0
        let mut chars: usize = 0
        for c in s.chars() {
            if self.has_precision && chars >= self.precision {
                break
            }
            bytes = bytes + __utf8_len(c)
            chars = chars + 1
        }
        self.pad_text(s[0..bytes], chars, 1)
    }

    /// Writes `s` with the placeholder's width, fill, and alignment, but not its precision.
    ///
    /// ```
    /// let mut f = Formatter.new()
    /// f.pad_plain("ab")
    /// assert_eq(f.finish(), String.from("ab"))
    /// ```
    fn pad_plain(mut self, s: str) {
        self.pad_text(s, __char_count(s), 1)
    }

    /// Writes a number as its sign, its radix prefix, and its digits. With the `0` flag the zeros go between the
    /// prefix and the digits; otherwise numbers are right-aligned unless the placeholder says otherwise.
    ///
    /// ```
    /// let mut f = Formatter.new()
    /// f.pad_number("-", "", "42")
    /// assert_eq(f.finish(), String.from("-42"))
    /// ```
    fn pad_number(mut self, sign: str, prefix: str, digits: str) {
        let n = sign.len() + prefix.len() + digits.len()
        if !self.has_width || self.width <= n {
            self.out.push_str(sign)
            self.out.push_str(prefix)
            self.out.push_str(digits)
            return
        }
        if self.zero {
            self.out.push_str(sign)
            self.out.push_str(prefix)
            let mut i = n
            while i < self.width {
                self.out.push('0')
                i = i + 1
            }
            self.out.push_str(digits)
            return
        }
        let mut whole = String.from(sign)
        whole.push_str(prefix)
        whole.push_str(digits)
        self.pad_text(whole, n, 3)
    }

    priv fn pad_text(mut self, text: str, chars: usize, default_align: i32) {
        if !self.has_width || self.width <= chars {
            self.out.push_str(text)
            return
        }
        let gap = self.width - chars
        let mut align = self.align
        if align == 0 {
            align = default_align
        }
        let mut left: usize = 0
        if align == 3 {
            left = gap
        } else if align == 2 {
            left = gap / 2
        }
        self.fill_n(left)
        self.out.push_str(text)
        self.fill_n(gap - left)
    }

    priv fn fill_n(mut self, n: usize) {
        let c = self.fill
        let mut i: usize = 0
        while i < n {
            self.out.push(c)
            i = i + 1
        }
    }
}

priv fn __utf8_len(c: char): usize {
    let v = c as u32
    if v < 128 {
        1
    } else if v < 2048 {
        2
    } else if v < 65536 {
        3
    } else {
        4
    }
}

priv fn __char_count(s: str): usize {
    let mut n: usize = 0
    for c in s.chars() {
        n = n + 1
    }
    n
}

// ----- integers ---------------------------------------------------------------------------------------------

priv fn __int_digits(mag: u64, radix: i32): String {
    let upper = radix == 17
    let mut base: u64 = 10
    if radix == 17 {
        base = 16
    } else {
        base = radix as u64
    }
    let mut reversed: List<char> = List<char>.new()
    let mut rest = mag
    if rest == 0 {
        reversed.push('0')
    }
    while rest > 0 {
        let d = (rest % base) as u8
        rest = rest / base
        if d < 10 {
            reversed.push((48 + d) as char)
        } else if upper {
            reversed.push((55 + d) as char)
        } else {
            reversed.push((87 + d) as char)
        }
    }
    let mut out = String.new()
    let mut i = reversed.len()
    while i > 0 {
        i = i - 1
        out.push(reversed[i])
    }
    out
}

priv fn __emit_int(negative: bool, mag: u64, mut f: Formatter) {
    let body = __int_digits(mag, f.radix)
    let mut sign = ""
    if negative {
        sign = "-"
    } else if f.plus {
        sign = "+"
    }
    let mut prefix = ""
    if f.alt {
        if f.radix == 16 || f.radix == 17 {
            prefix = "0x"
        } else if f.radix == 2 {
            prefix = "0b"
        } else if f.radix == 8 {
            prefix = "0o"
        }
    }
    f.pad_number(sign, prefix, body)
}

/// A signed integer of `bits` bits, widened to `i64`. In a radix other than ten a negative value shows its two's
/// complement in that many bits.
priv fn __fmt_i64(v: i64, bits: i32, mut f: Formatter) {
    if f.radix == 10 {
        let negative = v < 0
        let mut mag: u64 = v as u64
        if negative {
            mag = (0 - (v + 1)) as u64 + 1
        }
        __emit_int(negative, mag, mut f)
    } else {
        let mut mag = v as u64
        if bits < 64 {
            let one: u64 = 1
            mag = mag & ((one << (bits as u64)) - 1)
        }
        __emit_int(false, mag, mut f)
    }
}

priv fn __fmt_u64(v: u64, mut f: Formatter) {
    __emit_int(false, v, mut f)
}

// The 128-bit integers (spec/int128.md, I128-5). They have their own digits, because the 64-bit routines take a
// 64-bit magnitude; the sign and the radix rules are the same.

priv fn __int_digits128(mag: u128, radix: i32): String {
    let upper = radix == 17
    let mut base: u128 = 10
    if radix == 17 {
        base = 16
    } else {
        base = radix as u128
    }
    let mut reversed: List<char> = List<char>.new()
    let mut rest = mag
    if rest == 0 {
        reversed.push('0')
    }
    while rest > 0 {
        let d = (rest % base) as u8
        rest = rest / base
        if d < 10 {
            reversed.push((48 + d) as char)
        } else if upper {
            reversed.push((55 + d) as char)
        } else {
            reversed.push((87 + d) as char)
        }
    }
    let mut out = String.new()
    let mut i = reversed.len()
    while i > 0 {
        i = i - 1
        out.push(reversed[i])
    }
    out
}

priv fn __emit_int128(negative: bool, mag: u128, mut f: Formatter) {
    let body = __int_digits128(mag, f.radix)
    let mut sign = ""
    if negative {
        sign = "-"
    } else if f.plus {
        sign = "+"
    }
    let mut prefix = ""
    if f.alt {
        if f.radix == 16 || f.radix == 17 {
            prefix = "0x"
        } else if f.radix == 2 {
            prefix = "0b"
        } else if f.radix == 8 {
            prefix = "0o"
        }
    }
    f.pad_number(sign, prefix, body)
}

/// A signed 128-bit integer. In a radix other than ten a negative value shows its two's complement in `bits` bits.
priv fn __fmt_i128(v: i128, bits: i32, mut f: Formatter) {
    if f.radix == 10 {
        let negative = v < 0
        let mut mag: u128 = v as u128
        if negative {
            mag = (0 - (v + 1)) as u128 + 1
        }
        __emit_int128(negative, mag, mut f)
    } else {
        let mut mag = v as u128
        if bits < 128 {
            let one: u128 = 1
            mag = mag & ((one << (bits as u128)) - 1)
        }
        __emit_int128(false, mag, mut f)
    }
}

priv fn __fmt_u128(v: u128, mut f: Formatter) {
    __emit_int128(false, v, mut f)
}

// ----- floats -----------------------------------------------------------------------------------------------

/// The digits of a finite, non-negative float in positional notation: the shortest text that reads back as the
/// same number.
priv fn __float_shortest(a: f64, single: bool): String {
    let sci = __float_str(a, -1, single)
    let mut digits = String.new()
    let mut exp: i32 = 0
    let mut exp_negative = false
    let mut in_exp = false
    for c in sci.chars() {
        if in_exp {
            if c == '-' {
                exp_negative = true
            } else if c != '+' {
                exp = exp * 10 + ((c as u8) - 48) as i32
            }
        } else if c == 'e' {
            in_exp = true
        } else if c != '.' {
            digits.push(c)
        }
    }
    if exp_negative {
        exp = 0 - exp
    }
    let n = digits.len() as i32
    let mut out = String.new()
    if exp >= n - 1 {
        out.push_str(digits)
        let mut i = n - 1
        while i < exp {
            out.push('0')
            i = i + 1
        }
    } else if exp >= 0 {
        let split = (exp + 1) as usize
        out.push_str(digits[0..split])
        out.push('.')
        out.push_str(digits[split..digits.len()])
    } else {
        out.push_str("0.")
        let mut i = exp + 1
        while i < 0 {
            out.push('0')
            i = i + 1
        }
        out.push_str(digits)
    }
    out
}

priv fn __fmt_float(v: f64, single: bool, debug: bool, mut f: Formatter) {
    if v != v {
        f.pad_plain("NaN")
        return
    }
    let negative = v < 0.0
    let mut a = v
    if negative {
        a = 0.0 - v
    }
    let mut sign = ""
    if negative {
        sign = "-"
    } else if f.plus {
        sign = "+"
    }
    if a * 0.0 != 0.0 {
        f.pad_number(sign, "", "inf")
        return
    }
    let mut body = String.new()
    if f.has_precision {
        let mut p = f.precision
        if p > 100 {
            p = 100
        }
        body = __float_str(a, p as i32, single)
    } else {
        body = __float_shortest(a, single)
        if debug && body.find('.').is_none() {
            body.push_str(".0")
        }
    }
    f.pad_number(sign, "", body)
}

// ----- text -------------------------------------------------------------------------------------------------

priv fn __fmt_str(s: str, mut f: Formatter) {
    f.pad(s)
}

priv fn __fmt_char(c: char, mut f: Formatter) {
    let mut s = String.new()
    s.push(c)
    f.pad(s)
}

priv fn __fmt_bool(b: bool, mut f: Formatter) {
    if b {
        f.pad("true")
    } else {
        f.pad("false")
    }
}

priv fn __escape(c: char, quote: char, mut out: String) {
    if c == '\n' {
        out.push_str("\\n")
    } else if c == '\t' {
        out.push_str("\\t")
    } else if c == '\r' {
        out.push_str("\\r")
    } else if c == '\0' {
        out.push_str("\\0")
    } else if c == '\\' {
        out.push_str("\\\\")
    } else if c == quote {
        out.push('\\')
        out.push(c)
    } else {
        out.push(c)
    }
}

priv fn __debug_str(s: str, mut f: Formatter) {
    let mut q = String.new()
    q.push('"')
    for c in s.chars() {
        __escape(c, '"', mut q)
    }
    q.push('"')
    f.pad_plain(q)
}

priv fn __debug_char(c: char, mut f: Formatter) {
    let mut q = String.new()
    q.push('\'')
    __escape(c, '\'', mut q)
    q.push('\'')
    f.pad_plain(q)
}

// ----- boxing a built-in implementation (spec/existentials.md, AN14) ----------------------------------------
//
// The vtable entry of `any Display`/`any Debug` for a type whose implementation the compiler provides. A borrowed
// parameter is passed by address, as the vtable's `self` pointer is, so the entry is the instance of one of these
// for the boxed type.

priv fn __any_display<T: Display>(v: T, mut f: Formatter) {
    v.fmt(mut f)
}

priv fn __any_debug<T: Debug>(v: T, mut f: Formatter) {
    v.debug(mut f)
}

// ----- compound types ---------------------------------------------------------------------------------------

priv fn __debug_unit(mut f: Formatter) {
    f.write_str("()")
}

priv fn __debug_option<T: Debug>(o: Option<T>, mut f: Formatter) {
    match o {
        Option.Some(x) => {
            f.write_str("Some(")
            x.debug(mut f)
            f.write_str(")")
        }
        Option.None => {
            f.write_str("None")
        }
    }
}

priv fn __debug_result<T: Debug, E: Debug>(r: Result<T, E>, mut f: Formatter) {
    match r {
        Result.Ok(x) => {
            f.write_str("Ok(")
            x.debug(mut f)
            f.write_str(")")
        }
        Result.Err(e) => {
            f.write_str("Err(")
            e.debug(mut f)
            f.write_str(")")
        }
    }
}

priv fn __debug_list<T: Debug>(xs: List<T>, mut f: Formatter) {
    f.write_str("[")
    let mut i: usize = 0
    while i < xs.len() {
        if i > 0 {
            f.write_str(", ")
        }
        xs[i].debug(mut f)
        i = i + 1
    }
    f.write_str("]")
}

priv fn __debug_map<K: Debug, V: Debug, A: Allocator>(m: Map<K, V, A>, mut f: Formatter) {
    f.write_str("{{")
    let mut first = true
    for (key, value) in m {
        if !first {
            f.write_str(", ")
        }
        first = false
        key.debug(mut f)
        f.write_str(": ")
        value.debug(mut f)
    }
    f.write_str("}}")
}

priv fn __debug_heap<T: Debug>(h: Heap<T>, mut f: Formatter) {
    (*h).debug(mut f)
}

priv fn __debug_tuple2<A: Debug, B: Debug>(t: (A, B), mut f: Formatter) {
    f.write_str("(")
    t.0.debug(mut f)
    f.write_str(", ")
    t.1.debug(mut f)
    f.write_str(")")
}

priv fn __debug_tuple3<A: Debug, B: Debug, C: Debug>(t: (A, B, C), mut f: Formatter) {
    f.write_str("(")
    t.0.debug(mut f)
    f.write_str(", ")
    t.1.debug(mut f)
    f.write_str(", ")
    t.2.debug(mut f)
    f.write_str(")")
}

priv fn __debug_tuple4<A: Debug, B: Debug, C: Debug, D: Debug>(t: (A, B, C, D), mut f: Formatter) {
    f.write_str("(")
    t.0.debug(mut f)
    f.write_str(", ")
    t.1.debug(mut f)
    f.write_str(", ")
    t.2.debug(mut f)
    f.write_str(", ")
    t.3.debug(mut f)
    f.write_str(")")
}
