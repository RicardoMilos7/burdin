// The stage 0 standard library, written in Burdin.
//
// The compiler provides the primitives that need to reach the operating system or raw memory (file I/O,
// process control, the arguments, the environment, the working directory, and the memory helpers); everything a
// Burdin program can express is here.

use fmt.{Debug, Display, Formatter}
use reactor.__offload_raw

/// A type that is an error: `Display` is required, and a value of the type converts into the dynamic `Error`.
interface Error requires Display { }

/// The dynamic error of `Result<T>`: an owned box holding any error, the context messages `.context` added
/// (outermost first), and the frames a debug build records when the error was created and propagated
/// (`spec/errors.md`, ERR4 and ERR7).
struct Error {
    value: any Error
    frames: List<TraceFrame>
    /// The `message: ` prefixes of `.context`, outermost first; empty when none was added.
    context: String
}

/// One recorded error site: the function the error passed through and the source file, line, and column
/// (`spec/debug.md`, DBG3). A release build records no frames at all.
struct TraceFrame {
    func: String
    file: String
    line: i32
    col: i32
}

/// One field of a struct, as `Type.fields` describes it (`spec/reflection.md`, RFL2). `type_name` is the field's
/// type as the checker prints it. The names are `String`s because a struct cannot hold a view.
struct FieldInfo: Clone, Eq, Debug {
    name: String
    type_name: String
    index: usize
}

/// One variant of an enum, as `Type.variants` describes it (`spec/reflection.md`, RFL2). `arity` is the number
/// of fields the variant carries.
struct VariantInfo: Clone, Eq, Debug {
    name: String
    index: usize
    arity: usize
}

Error: Display {
    fn fmt(self, mut f: Formatter) {
        if self.context.len() > 0 {
            f.write_str(self.context)
            f.write_str(": ")
        }
        self.value.fmt(mut f)
    }
}

Error: Error { }

Error {
    /// Whether the error holds a `T`.
    fn is<T: Error>(self): bool {
        self.value.is<T>()
    }

    /// The value the error holds, when it is a `T`. It consumes the error.
    fn downcast<T: Error>(own self): Option<T> {
        self.value.downcast<T>()
    }

    /// Prints the recorded trace frames, one per line, to standard error (`spec/debug.md`, DBG3): each frame's
    /// `at <func> (<file>:<line>:<col>)` form. Nothing prints when there are no frames, which is every release
    /// build. The wrappers of `fn main(): Result<T>` and of a failing test call it after the message.
    fn print_trace(self) {
        for frame in self.frames {
            eprintln("{frame}")
        }
    }
}

TraceFrame: Display {
    fn fmt(self, mut f: Formatter) {
        f.write_str("at ")
        f.write_str(self.func)
        f.write_str(" (")
        f.write_str(self.file)
        f.write_str(":{self.line}:{self.col})")
    }
}

/// A dynamic error with no frames: what a release build records, and what an error with tracing disabled uses.
priv fn __error_plain(own value: any Error): Error {
    Error { value, frames: List<TraceFrame>.new(), context: String.new() }
}

/// A dynamic error with a creation frame (a debug build).
priv fn __error_at(own value: any Error, func: str, file: str, line: i32, col: i32): Error {
    let mut frames = List<TraceFrame>.new()
    frames.push(TraceFrame { func: func.to_string(), file: file.to_string(), line, col })
    Error { value, frames, context: String.new() }
}

/// A dynamic error with one more propagation frame (a debug build).
priv fn __error_frame(own e: Error, func: str, file: str, line: i32, col: i32): Error {
    let mut e = e
    e.frames.push(TraceFrame { func: func.to_string(), file: file.to_string(), line, col })
    e
}

/// `.context(message)`: keeps the boxed source error and its frames, and adds one more context message in front.
priv fn __error_context(own e: Error, message: str): Error {
    let context = if e.context.len() == 0 {
        message.to_string()
    } else {
        format("{message}: {e.context}")
    }
    Error { value: e.value, frames: e.frames, context }
}

/// The portable kind of an I/O failure (`spec/errors.md`, ERR11): what went wrong, without the platform's own
/// error code. An operating system code the compiler does not classify is `Other`; the code is still available
/// through `IoError.os_code()`.
enum IoErrorKind: Copy, Clone, Eq, Debug {
    NotFound
    PermissionDenied
    AlreadyExists
    IsADirectory
    NotADirectory
    DirectoryNotEmpty
    InvalidInput
    InvalidData
    UnexpectedEof
    Interrupted
    BrokenPipe
    WouldBlock
    TimedOut
    ConnectionRefused
    ConnectionReset
    ConnectionAborted
    NotConnected
    AddrInUse
    AddrNotAvailable
    NetworkUnreachable
    HostUnreachable
    Other
}

IoErrorKind: Display {
    fn fmt(self, mut f: Formatter) {
        f.write_str(match self {
            IoErrorKind.NotFound => "not found",
            IoErrorKind.PermissionDenied => "permission denied",
            IoErrorKind.AlreadyExists => "already exists",
            IoErrorKind.IsADirectory => "is a directory",
            IoErrorKind.NotADirectory => "not a directory",
            IoErrorKind.DirectoryNotEmpty => "directory not empty",
            IoErrorKind.InvalidInput => "invalid input",
            IoErrorKind.InvalidData => "invalid data",
            IoErrorKind.UnexpectedEof => "unexpected end of file",
            IoErrorKind.Interrupted => "interrupted",
            IoErrorKind.BrokenPipe => "broken pipe",
            IoErrorKind.WouldBlock => "would block",
            IoErrorKind.TimedOut => "timed out",
            IoErrorKind.ConnectionRefused => "connection refused",
            IoErrorKind.ConnectionReset => "connection reset",
            IoErrorKind.ConnectionAborted => "connection aborted",
            IoErrorKind.NotConnected => "not connected",
            IoErrorKind.AddrInUse => "address already in use",
            IoErrorKind.AddrNotAvailable => "address not available",
            IoErrorKind.NetworkUnreachable => "network unreachable",
            IoErrorKind.HostUnreachable => "host unreachable",
            IoErrorKind.Other => "other",
        })
    }
}

/// The error type of the I/O functions (`spec/errors.md`, ERR10). `kind` is the portable classification and
/// `os_code` is the operating system's own code when the system reported the failure; `std` itself detects a
/// few failures (such as removing a path that is not a directory) and stores `None` there. The reader and writer
/// interfaces report the failures that no system call observed (`spec/stdlib.md`, "Readers and writers"); they
/// carry no path and no code, and `kind()` classifies them too.
error enum IoError: Eq, Debug {
    Read { path: String, kind: IoErrorKind, os_code: Option<i32> } "cannot read {path}: {kind}"
    Write { path: String, kind: IoErrorKind, os_code: Option<i32> } "cannot write {path}: {kind}"
    Run { command: String, kind: IoErrorKind, os_code: Option<i32> } "cannot run {command}: {kind}"
    Net { op: String, addr: String, kind: IoErrorKind, os_code: Option<i32> } "cannot {op} {addr}: {kind}"
    UnexpectedEof "unexpected end of input"
    WriteZero "the writer accepted no bytes"
    InvalidData "the bytes are not valid text"
    Seek "seek to a position before the start"
    InvalidInput "invalid open options"
}

IoError {
    /// What went wrong, portably (`spec/errors.md`, ERR11).
    fn kind(self): IoErrorKind {
        match self {
            IoError.Read { path: _, kind, os_code: _ } => kind,
            IoError.Write { path: _, kind, os_code: _ } => kind,
            IoError.Run { command: _, kind, os_code: _ } => kind,
            IoError.Net { op: _, addr: _, kind, os_code: _ } => kind,
            IoError.UnexpectedEof => IoErrorKind.UnexpectedEof,
            IoError.InvalidData => IoErrorKind.InvalidData,
            IoError.WriteZero => IoErrorKind.Other,
            IoError.Seek => IoErrorKind.InvalidInput,
            IoError.InvalidInput => IoErrorKind.InvalidInput,
        }
    }

    /// The operating system's own error code: `errno` on Linux and macOS, the Win32 error code on Windows. `None`
    /// when `std` detected the failure itself and no system call reported it.
    fn os_code(self): Option<i32> {
        match self {
            IoError.Read { path: _, kind: _, os_code } => os_code,
            IoError.Write { path: _, kind: _, os_code } => os_code,
            IoError.Run { command: _, kind: _, os_code } => os_code,
            IoError.Net { op: _, addr: _, kind: _, os_code } => os_code,
            IoError.UnexpectedEof
            | IoError.WriteZero
            | IoError.InvalidData
            | IoError.Seek
            | IoError.InvalidInput => None,
        }
    }
}

/// The error type of `i32.parse` and the other integer parsers.
error enum ParseIntError: Eq, Debug {
    Invalid "invalid integer"
}

/// The error type of `assert`, `assert_eq`, and `assert_ne` in a `burdin test` build.
error enum AssertError {
    Failed { condition: String, location: String } "assertion failed: {condition} at {location}"
    FailedMsg { condition: String, message: String, location: String }
        "assertion failed: {condition} at {location}: {message}"
    FailedEq { condition: String, left: String, right: String, location: String } "assertion failed: {condition} at {location}: {left} != {right}"
    FailedEqMsg { condition: String, left: String, right: String, message: String, location: String } "assertion failed: {condition} at {location}: {left} != {right}: {message}"
    FailedNe { condition: String, left: String, right: String, location: String } "assertion failed: {condition} at {location}: {left} == {right}"
    FailedNeMsg { condition: String, left: String, right: String, message: String, location: String } "assertion failed: {condition} at {location}: {left} == {right}: {message}"
}

/// A borrowed C string: a pointer to NUL-terminated bytes. `CStr.to_string(ptr)` copies them into a `String`.
type CStr = CPtr<CChar>

/// Panics with `assertion failed` when `cond` is false. With a message, `assert(cond, "text {x}")` formats it
/// and panics with that instead.
fn assert(cond: bool) {
    if !cond {
        panic("assertion failed")
    }
}

/// Panics when the two values differ.
fn assert_eq<T: Eq>(a: T, b: T) {
    if a != b {
        panic("assertion failed: the two values differ")
    }
}

/// Panics when the two values are equal. With a message, `assert_ne(a, b, "text {x}")` formats it and panics
/// with that instead.
fn assert_ne<T: Eq>(a: T, b: T) {
    if a == b {
        panic("assertion failed: the two values are equal")
    }
}

/// `assert` for a condition that is checked only in a debug build: a release build drops the check without
/// evaluating the condition or formatting the message.
fn debug_assert(cond: bool) {
    if !cond {
        panic("assertion failed")
    }
}

/// `assert_eq` for a debug build; a release build drops the check without evaluating the values.
fn debug_assert_eq<T: Eq>(a: T, b: T) {
    if a != b {
        panic("assertion failed: the two values differ")
    }
}

/// `assert_ne` for a debug build; a release build drops the check without evaluating the values.
fn debug_assert_ne<T: Eq>(a: T, b: T) {
    if a == b {
        panic("assertion failed: the two values are equal")
    }
}

/// The test-mode `assert`: a false condition is an error instead of a panic, so `burdin test` reports the test
/// as failed and keeps running the others. `burdin test` binds this as `assert`; normal builds use the panicking
/// version above. The compiler appends the message (empty when none was written), the call's source text, and
/// the call's location at the call site (`spec/errors.md`, ERR9).
priv fn __test_assert(cond: bool, message: str, condition: str, location: str): Result<(), AssertError> {
    if cond {
        Ok(())
    } else if message.len() == 0 {
        Err(AssertError.Failed { condition: condition.to_string(), location: location.to_string() })
    } else {
        Err(AssertError.FailedMsg {
            condition: condition.to_string(),
            message: message.to_string(),
            location: location.to_string(),
        })
    }
}

/// The test-mode `assert_eq`. The compiler appends the message, the call's source text, and its location, as
/// for `assert`.
priv fn __test_assert_eq<T: Eq + Debug>(
    a: T,
    b: T,
    message: str,
    condition: str,
    location: str,
): Result<(), AssertError> {
    if a == b {
        Ok(())
    } else {
        let left = format("{a:?}")
        let right = format("{b:?}")
        if message.len() == 0 {
            Err(AssertError.FailedEq {
                condition: condition.to_string(),
                left,
                right,
                location: location.to_string(),
            })
        } else {
            Err(AssertError.FailedEqMsg {
                condition: condition.to_string(),
                left,
                right,
                message: message.to_string(),
                location: location.to_string(),
            })
        }
    }
}

/// The test-mode `assert_ne`. The compiler appends the message, the call's source text, and its location, as
/// for `assert`.
priv fn __test_assert_ne<T: Eq + Debug>(
    a: T,
    b: T,
    message: str,
    condition: str,
    location: str,
): Result<(), AssertError> {
    if a != b {
        Ok(())
    } else {
        let left = format("{a:?}")
        let right = format("{b:?}")
        if message.len() == 0 {
            Err(AssertError.FailedNe {
                condition: condition.to_string(),
                left,
                right,
                location: location.to_string(),
            })
        } else {
            Err(AssertError.FailedNeMsg {
                condition: condition.to_string(),
                left,
                right,
                message: message.to_string(),
                location: location.to_string(),
            })
        }
    }
}

/// Panics. `unreachable()` marks a branch the program promises never runs.
fn unreachable(): ! {
    panic("unreachable")
}

/// Panics with `not yet implemented`, for a function whose body is still to be written.
fn todo(): ! {
    panic("not yet implemented")
}

/// Panics with `not implemented`, for a function that is declared but not supported.
fn unimplemented(): ! {
    panic("not implemented")
}

/// The shim a call to a `blocking` extern goes through (`spec/io.md`, IO4). The compiler generates a thunk that
/// performs the C call from the arguments it marshals, then calls this function with the thunk and the block. The
/// thunk runs on the helper pool, so the calling task parks instead of holding a worker.
fn __offload_blocking(own code: CPtr<u8>, own env: CPtr<u8>) {
    unsafe {
        __offload_raw(code, env)
    }
}
