// The stage 0 standard library, written in Burdin; the compiler provides only the primitives that reach the system.
use alloc.{Allocator, Global}
use env.get
use fmt.{Debug, Display, Formatter}
use fs.append
use iter.Iterator
use marker.{Send, Sync}
use mem.drop
use reactor.offload_raw
use slice.{contains, sort}

/// A type that is an error: `Display` is required, and a value of the type converts into the dynamic `AnyError`.
///
/// ```
/// error enum Bad {
///     Oops "something went wrong"
/// }
/// let b = Bad.Oops
/// assert_eq(format("{}", b), String.from("something went wrong"))
/// ```
interface Error requires Display { }

/// The dynamic error of `Result<T>`: an owned box holding any error, the context messages `.context` added
/// (outermost first), and the frames a debug build records when the error was created and propagated
/// (`spec/errors.md`, ERR4 and ERR7).
///
/// ```
/// fn read_cfg(): Result<i32, IoError> {
///     Result.Err(IoError.Read { path: String.from("cfg.toml"), kind: IoErrorKind.NotFound, os_code: Option.None })
/// }
/// match read_cfg().context("loading") {
///     Result.Ok(_) => assert(false),
///     Result.Err(e) => assert_eq(format("{}", e), String.from("loading: cannot read cfg.toml: not found")),
/// }
/// ```
struct AnyError {
    value: any Error
    frames: List<TraceFrame>
    /// The `message: ` prefixes of `.context`, outermost first; empty when none was added.
    context: String
}

/// One recorded error site: the function the error passed through and the source file, line, and column
/// (`spec/debug.md`, DBG3). A release build records no frames at all.
///
/// ```
/// let frame = TraceFrame { func: String.from("main"), file: String.from("main.bd"), line: 3, col: 5 }
/// assert_eq(format("{}", frame), String.from("at main (main.bd:3:5)"))
/// ```
struct TraceFrame {
    func: String
    file: String
    line: i32
    col: i32
}

/// One field of a struct, as `Type.fields` describes it (`spec/reflection.md`, RFL2). `type_name` is the field's
/// type as the checker prints it. The names are `String`s because a struct cannot hold a view.
///
/// ```
/// struct Point {
///     x: i32
///     y: i32
/// }
/// let mut names = String.from("")
/// for field in Point.fields {
///     names.push_str(field.name)
/// }
/// assert_eq(names, String.from("xy"))
/// ```
struct FieldInfo: Clone, Eq, Debug {
    name: String
    type_name: String
    index: usize
}

/// One variant of an enum, as `Type.variants` describes it (`spec/reflection.md`, RFL2). `arity` is the number
/// of fields the variant carries.
///
/// ```
/// enum Shape {
///     Dot
///     Line(i32)
/// }
/// let mut total: usize = 0
/// for variant in Shape.variants {
///     total = total + variant.arity
/// }
/// assert_eq(total, 1)
/// ```
struct VariantInfo: Clone, Eq, Debug {
    name: String
    index: usize
    arity: usize
}

AnyError: Display {
    fn fmt(self, mut f: Formatter) {
        if self.context.len() > 0 {
            f.write_str(self.context)
            f.write_str(": ")
        }
        self.value.fmt(mut f)
    }
}

AnyError: Error { }

AnyError {
    /// Whether the error holds a `T`.
    ///
    /// ```
    /// fn read_cfg(): Result<i32, IoError> {
    ///     Result.Err(IoError.Read { path: String.from("cfg.toml"), kind: IoErrorKind.NotFound, os_code: Option.None })
    /// }
    /// match read_cfg().context("loading") {
    ///     Result.Ok(_) => assert(false),
    ///     Result.Err(e) => assert(e.is<IoError>()),
    /// }
    /// ```
    fn is<T: Error>(self): bool {
        self.value.is<T>()
    }

    /// The value the error holds, when it is a `T`. It consumes the error.
    ///
    /// ```
    /// fn read_cfg(): Result<i32, IoError> {
    ///     Result.Err(IoError.Read { path: String.from("cfg.toml"), kind: IoErrorKind.NotFound, os_code: Option.None })
    /// }
    /// match read_cfg().context("loading") {
    ///     Result.Ok(_) => assert(false),
    ///     Result.Err(e) => {
    ///         let inner = e.downcast<IoError>().unwrap()
    ///         assert_eq(inner.kind(), IoErrorKind.NotFound)
    ///     }
    /// }
    /// ```
    fn downcast<T: Error>(own self): Option<T> {
        self.value.downcast<T>()
    }

    /// Prints the recorded trace frames, one per line, to standard error (`spec/debug.md`, DBG3): each frame's
    /// `at <func> (<file>:<line>:<col>)` form. Nothing prints when there are no frames, which is every release
    /// build. The wrappers of `fn main(): Result<T>` and of a failing test call it after the message.
    ///
    /// ```
    /// fn read_cfg(): Result<i32, IoError> {
    ///     Result.Err(IoError.Read { path: String.from("cfg.toml"), kind: IoErrorKind.NotFound, os_code: Option.None })
    /// }
    /// match read_cfg().context("loading") {
    ///     Result.Ok(_) => assert(false),
    ///     Result.Err(e) => e.print_trace(),
    /// }
    /// ```
    fn print_trace(self) {
        for frame in self.frames {
            eprintln("{frame}")
        }
    }
}

TraceFrame: Display {
    fn fmt(self, mut f: Formatter) {
        f.write_str("at ")
        f.write_str(self.func)
        f.write_str(" (")
        f.write_str(self.file)
        f.write_str(":{self.line}:{self.col})")
    }
}

/// A dynamic error with no frames: what a release build records, and what an error with tracing disabled uses.
priv fn error_plain(own value: any Error): AnyError {
    AnyError { value, frames: List<TraceFrame>.new(), context: String.new() }
}

/// A dynamic error with a creation frame (a debug build).
priv fn error_at(own value: any Error, func: str, file: str, line: i32, col: i32): AnyError {
    let mut frames = List<TraceFrame>.new()
    frames.push(TraceFrame { func: func.to_string(), file: file.to_string(), line, col })
    AnyError { value, frames, context: String.new() }
}

/// A dynamic error with one more propagation frame (a debug build).
priv fn error_frame(own e: AnyError, func: str, file: str, line: i32, col: i32): AnyError {
    let mut e = e
    e.frames.push(TraceFrame { func: func.to_string(), file: file.to_string(), line, col })
    e
}

/// `.context(message)`: keeps the boxed source error and its frames, and adds one more context message in front.
priv fn error_context(own e: AnyError, message: str): AnyError {
    let context = if e.context.len() == 0 {
        message.to_string()
    } else {
        format("{message}: {e.context}")
    }
    AnyError { value: e.value, frames: e.frames, context }
}

/// The portable kind of an I/O failure (`spec/errors.md`, ERR11): what went wrong, without the platform's own
/// error code. An operating system code the compiler does not classify is `Other`; the code is still available
/// through `IoError.os_code()`.
///
/// ```
/// let kind = IoErrorKind.InvalidInput
/// assert(kind == IoErrorKind.InvalidInput)
/// assert(kind != IoErrorKind.Interrupted)
/// ```
enum IoErrorKind: Copy, Clone, Eq, Debug {
    NotFound
    PermissionDenied
    AlreadyExists
    IsADirectory
    NotADirectory
    DirectoryNotEmpty
    InvalidInput
    InvalidData
    UnexpectedEof
    Interrupted
    BrokenPipe
    WouldBlock
    TimedOut
    ConnectionRefused
    ConnectionReset
    ConnectionAborted
    NotConnected
    AddrInUse
    AddrNotAvailable
    NetworkUnreachable
    HostUnreachable
    Other
}

IoErrorKind: Display {
    fn fmt(self, mut f: Formatter) {
        f.write_str(match self {
            IoErrorKind.NotFound => "not found",
            IoErrorKind.PermissionDenied => "permission denied",
            IoErrorKind.AlreadyExists => "already exists",
            IoErrorKind.IsADirectory => "is a directory",
            IoErrorKind.NotADirectory => "not a directory",
            IoErrorKind.DirectoryNotEmpty => "directory not empty",
            IoErrorKind.InvalidInput => "invalid input",
            IoErrorKind.InvalidData => "invalid data",
            IoErrorKind.UnexpectedEof => "unexpected end of file",
            IoErrorKind.Interrupted => "interrupted",
            IoErrorKind.BrokenPipe => "broken pipe",
            IoErrorKind.WouldBlock => "would block",
            IoErrorKind.TimedOut => "timed out",
            IoErrorKind.ConnectionRefused => "connection refused",
            IoErrorKind.ConnectionReset => "connection reset",
            IoErrorKind.ConnectionAborted => "connection aborted",
            IoErrorKind.NotConnected => "not connected",
            IoErrorKind.AddrInUse => "address already in use",
            IoErrorKind.AddrNotAvailable => "address not available",
            IoErrorKind.NetworkUnreachable => "network unreachable",
            IoErrorKind.HostUnreachable => "host unreachable",
            IoErrorKind.Other => "other",
        })
    }
}

/// The error type of the I/O functions (`spec/errors.md`, ERR10). `kind` is the portable classification and
/// `os_code` is the operating system's own code when the system reported the failure; `std` itself detects a
/// few failures (such as removing a path that is not a directory) and stores `None` there. The reader and writer
/// interfaces report the failures that no system call observed (`spec/stdlib.md`, "Readers and writers"); they
/// carry no path and no code, and `kind()` classifies them too.
///
/// ```
/// let err = IoError.Read { path: String.from("cfg.toml"), kind: IoErrorKind.NotFound, os_code: Option.None }
/// assert_eq(err.kind(), IoErrorKind.NotFound)
/// ```
error enum IoError: Clone, Eq, Debug {
    Read { path: String, kind: IoErrorKind, os_code: Option<i32> } "cannot read {path}: {kind}"
    Write { path: String, kind: IoErrorKind, os_code: Option<i32> } "cannot write {path}: {kind}"
    Run { command: String, kind: IoErrorKind, os_code: Option<i32> } "cannot run {command}: {kind}"
    Net { op: String, addr: String, kind: IoErrorKind, os_code: Option<i32> } "cannot {op} {addr}: {kind}"
    UnexpectedEof "unexpected end of input"
    WriteZero "the writer accepted no bytes"
    InvalidData "the bytes are not valid text"
    Seek "seek to a position before the start"
    InvalidInput "invalid open options"
}

IoError {
    /// What went wrong, portably (`spec/errors.md`, ERR11).
    ///
    /// ```
    /// match read_to_string("burdin-doc-no-such-file.txt") {
    ///     Result.Ok(_) => assert(false),
    ///     Result.Err(e) => assert_eq(e.kind(), IoErrorKind.NotFound),
    /// }
    /// ```
    fn kind(self): IoErrorKind {
        match self {
            IoError.Read { path: _, kind, os_code: _ } => kind,
            IoError.Write { path: _, kind, os_code: _ } => kind,
            IoError.Run { command: _, kind, os_code: _ } => kind,
            IoError.Net { op: _, addr: _, kind, os_code: _ } => kind,
            IoError.UnexpectedEof => IoErrorKind.UnexpectedEof,
            IoError.InvalidData => IoErrorKind.InvalidData,
            IoError.WriteZero => IoErrorKind.Other,
            IoError.Seek => IoErrorKind.InvalidInput,
            IoError.InvalidInput => IoErrorKind.InvalidInput,
        }
    }

    /// The operating system's own error code: `errno` on Linux and macOS, the Win32 error code on Windows. `None`
    /// when `std` detected the failure itself and no system call reported it.
    ///
    /// ```
    /// match read_to_string("burdin-doc-no-such-file.txt") {
    ///     Result.Ok(_) => assert(false),
    ///     Result.Err(e) => assert(e.os_code().is_some()),
    /// }
    /// ```
    fn os_code(self): Option<i32> {
        match self {
            IoError.Read { path: _, kind: _, os_code } => os_code,
            IoError.Write { path: _, kind: _, os_code } => os_code,
            IoError.Run { command: _, kind: _, os_code } => os_code,
            IoError.Net { op: _, addr: _, kind: _, os_code } => os_code,
            IoError.UnexpectedEof
            | IoError.WriteZero
            | IoError.InvalidData
            | IoError.Seek
            | IoError.InvalidInput => Option.None,
        }
    }
}

/// The error type of `i32.parse` and the other integer parsers.
///
/// ```
/// match i32.parse("x") {
///     Result.Ok(_) => assert(false),
///     Result.Err(e) => assert_eq(e, ParseIntError.Invalid),
/// }
/// ```
error enum ParseIntError: Eq, Debug {
    Invalid "invalid integer"
}

/// The error type of `T.try_from(value)` for an integer `T` (spec/stdlib.md, "Conversions").
///
/// ```
/// let big: i32 = 300
/// match u8.try_from(big) {
///     Result.Ok(_) => assert(false),
///     Result.Err(e) => assert_eq(e, TryFromIntError.OutOfRange),
/// }
/// ```
error enum TryFromIntError: Eq, Debug {
    OutOfRange "out of range integral type conversion attempted"
}

/// The error type of `assert`, `assert_eq`, and `assert_ne` in a `burdin test` build.
///
/// ```
/// let e = AssertError.Failed { condition: String.from("x > 0"), location: String.from("main.bd:3:5") }
/// assert_eq(format("{}", e), String.from("assertion failed: x > 0 at main.bd:3:5"))
/// ```
error enum AssertError {
    Failed { condition: String, location: String } "assertion failed: {condition} at {location}"
    FailedMsg { condition: String, message: String, location: String }
        "assertion failed: {condition} at {location}: {message}"
    FailedEq { condition: String, left: String, right: String, location: String } "assertion failed: {condition} at {location}: {left} != {right}"
    FailedEqMsg { condition: String, left: String, right: String, message: String, location: String } "assertion failed: {condition} at {location}: {left} != {right}: {message}"
    FailedNe { condition: String, left: String, right: String, location: String } "assertion failed: {condition} at {location}: {left} == {right}"
    FailedNeMsg { condition: String, left: String, right: String, message: String, location: String } "assertion failed: {condition} at {location}: {left} == {right}: {message}"
}

/// A borrowed C string: a pointer to NUL-terminated bytes. `CStr.to_string(ptr)` copies them into a `String`.
///
/// ```
/// let owned = CString.from("hi")
/// let text = unsafe { CStr.to_string(owned.as_ptr()) }
/// assert_eq(text, String.from("hi"))
/// ```
type CStr = CPtr<CChar>

/// Panics with `assertion failed` when `cond` is false. With a message, `assert(cond, "text {x}")` formats it
/// and panics with that instead.
///
/// ```
/// assert(1 < 2)
/// ```
fn assert(cond: bool) {
    if !cond {
        panic("assertion failed")
    }
}

/// Panics when the two values differ.
///
/// ```
/// assert_eq(2 + 2, 4)
/// ```
fn assert_eq<T: Eq>(a: T, b: T) {
    if a != b {
        panic("assertion failed: the two values differ")
    }
}

/// Panics when the two values are equal. With a message, `assert_ne(a, b, "text {x}")` formats it and panics
/// with that instead.
///
/// ```
/// assert_ne(1, 2)
/// ```
fn assert_ne<T: Eq>(a: T, b: T) {
    if a == b {
        panic("assertion failed: the two values are equal")
    }
}

/// Records the `Debug` text of `value` as a snapshot, which `burdin test` compares with the one it keeps for this
/// call: in `snapshots/<module>__<test>.snap` next to the test's file, or in the call itself when the second
/// argument is an inline snapshot, `assert_snapshot(value, @"...")`. `display: true` records the `Display` text
/// instead. A missing or different snapshot fails the test; `burdin test --bless` accepts the new text
/// (`spec/test-runner.md`, "Snapshot tests"). Outside `burdin test` the call formats the value and does nothing
/// else. The compiler routes every call to `snapshot_debug` or `snapshot_display` with its location.
///
/// ```
/// assert_snapshot(42)
/// ```
fn assert_snapshot<T: Debug>(value: T) { }

/// `assert_snapshot(value)`: the `Debug` text, recorded for the runner with the call's `path:line:col`.
priv fn snapshot_debug<T: Debug>(value: T, location: str, inline: bool) {
    snapshot_record(format("{value:?}"), location, inline)
}

/// `assert_snapshot(value, display: true)`: the `Display` text.
priv fn snapshot_display<T: Display>(value: T, location: str, inline: bool) {
    snapshot_record(format("{value}"), location, inline)
}

/// Appends one record to the file `burdin test` names in `BURDIN_SNAPSHOTS`: a header line
/// `snapshot <inline 0|1> <byte length> <location>`, the text, and a newline. The runner compares the records
/// after the test process ends, so a test sees no difference between a matching and a differing snapshot.
priv fn snapshot_record(text: String, location: str, inline: bool) {
    match get("BURDIN_SNAPSHOTS") {
        Option.Some(path) => {
            let kind = if inline { 1 } else { 0 }
            let record = format("snapshot {kind} {text.len()} {location}\n{text}\n")
            match append(path, record.as_bytes()) {
                Result.Ok(()) => {}
                Result.Err(e) => panic("cannot record a snapshot in {path}: {e}"),
            }
        }
        Option.None => {}
    }
}

/// `assert` for a condition that is checked only in a debug build: a release build drops the check without
/// evaluating the condition or formatting the message.
///
/// ```
/// debug_assert(1 < 2)
/// ```
fn debug_assert(cond: bool) {
    if !cond {
        panic("assertion failed")
    }
}

/// `assert_eq` for a debug build; a release build drops the check without evaluating the values.
///
/// ```
/// debug_assert_eq(2 + 2, 4)
/// ```
fn debug_assert_eq<T: Eq>(a: T, b: T) {
    if a != b {
        panic("assertion failed: the two values differ")
    }
}

/// `assert_ne` for a debug build; a release build drops the check without evaluating the values.
///
/// ```
/// debug_assert_ne(1, 2)
/// ```
fn debug_assert_ne<T: Eq>(a: T, b: T) {
    if a == b {
        panic("assertion failed: the two values are equal")
    }
}

/// The test-mode `assert`: a false condition is an error instead of a panic, so `burdin test` reports the test
/// as failed and keeps running the others. `burdin test` binds this as `assert`; normal builds use the panicking
/// version above. The compiler appends the message (empty when none was written), the call's source text, and
/// the call's location at the call site (`spec/errors.md`, ERR9).
priv fn test_assert(cond: bool, message: str, condition: str, location: str): Result<(), AssertError> {
    if cond {
        Result.Ok(())
    } else if message.len() == 0 {
        Result.Err(AssertError.Failed { condition: condition.to_string(), location: location.to_string() })
    } else {
        Result.Err(AssertError.FailedMsg {
            condition: condition.to_string(),
            message: message.to_string(),
            location: location.to_string(),
        })
    }
}

/// The test-mode `assert_eq`. The compiler appends the message, the call's source text, and its location, as
/// for `assert`.
priv fn test_assert_eq<T: Eq + Debug>(
    a: T,
    b: T,
    message: str,
    condition: str,
    location: str,
): Result<(), AssertError> {
    if a == b {
        Result.Ok(())
    } else {
        let left = format("{a:?}")
        let right = format("{b:?}")
        if message.len() == 0 {
            Result.Err(AssertError.FailedEq {
                condition: condition.to_string(),
                left,
                right,
                location: location.to_string(),
            })
        } else {
            Result.Err(AssertError.FailedEqMsg {
                condition: condition.to_string(),
                left,
                right,
                message: message.to_string(),
                location: location.to_string(),
            })
        }
    }
}

/// The test-mode `assert_ne`. The compiler appends the message, the call's source text, and its location, as
/// for `assert`.
priv fn test_assert_ne<T: Eq + Debug>(
    a: T,
    b: T,
    message: str,
    condition: str,
    location: str,
): Result<(), AssertError> {
    if a != b {
        Result.Ok(())
    } else {
        let left = format("{a:?}")
        let right = format("{b:?}")
        if message.len() == 0 {
            Result.Err(AssertError.FailedNe {
                condition: condition.to_string(),
                left,
                right,
                location: location.to_string(),
            })
        } else {
            Result.Err(AssertError.FailedNeMsg {
                condition: condition.to_string(),
                left,
                right,
                message: message.to_string(),
                location: location.to_string(),
            })
        }
    }
}

/// Panics. `unreachable()` marks a branch the program promises never runs.
///
/// ```
/// fn pick(n: i32): i32 {
///     if n > 0 {
///         n
///     } else {
///         unreachable()
///     }
/// }
/// assert_eq(pick(3), 3)
/// ```
fn unreachable(): ! {
    panic("unreachable")
}

/// Panics with `not yet implemented`, for a function whose body is still to be written.
///
/// ```
/// fn pending(flag: bool): i32 {
///     if flag {
///         1
///     } else {
///         todo()
///     }
/// }
/// assert_eq(pending(true), 1)
/// ```
fn todo(): ! {
    panic("not yet implemented")
}

/// Panics with `not implemented`, for a function that is declared but not supported.
///
/// ```
/// fn pending(flag: bool): i32 {
///     if flag {
///         1
///     } else {
///         unimplemented()
///     }
/// }
/// assert_eq(pending(true), 1)
/// ```
fn unimplemented(): ! {
    panic("not implemented")
}

/// The shim a call to a `blocking` extern goes through (`spec/io.md`, IO4). The compiler generates a thunk that
/// performs the C call from the arguments it marshals, then calls this function with the thunk and the block. The
/// thunk runs on the helper pool, so the calling task parks instead of holding a worker.
priv fn offload_blocking(own code: CPtr<u8>, own env: CPtr<u8>) {
    unsafe {
        offload_raw(code, env)
    }
}

/// The error type of the `try_` allocating operations (spec/allocators.md, AL11). The variants are in the order the
/// compiler's fallible operations report them: `CapacityOverflow` is 0 and `OutOfMemory` is 1.
///
/// ```
/// let e = AllocError.OutOfMemory
/// assert_eq(e, AllocError.OutOfMemory)
/// assert(AllocError.CapacityOverflow != AllocError.OutOfMemory)
/// ```
error enum AllocError: Eq, Debug {
    CapacityOverflow "capacity overflow"
    OutOfMemory "out of memory"
}

/// A value that may be absent: `Some(T)` holds one, `None` holds nothing. The compiler knows this enum by name
/// (`?`, `orelse`, and the methods of the built-in types return it); the variants are `Option.None` and
/// `Option.Some(value)`, and `None` takes its type from the context.
///
/// ```
/// let a: Option<i32> = Option.Some(2)
/// let b: Option<i32> = Option.None
/// assert(a.is_some())
/// assert(b.is_none())
/// ```
enum Option<T>: Copy, Clone, Eq, Ord, Hash, Debug {
    None
    Some(T)
}

/// The outcome of an operation that can fail: `Ok(T)` holds the value, `Err(E)` the error. `Result<T>` with one
/// argument means `Result<T, AnyError>`. The compiler knows this enum by name, for `?`, `orelse`, and `context`.
///
/// ```
/// let a: Result<i32, String> = Result.Ok(2)
/// let b: Result<i32, String> = Result.Err(String.from("no"))
/// assert(a.is_ok())
/// assert(b.is_err())
/// ```
enum Result<T, E = AnyError>: Copy, Clone, Eq, Ord, Hash, Debug {
    Ok(T)
    Err(E)
}

/// The cell a `Shared<T>` points at: the number of live handles, then the value.
struct SharedCell<T> {
    strong: usize
    value: T
}

/// A reference-counted owner: a handle to a heap cell that holds a value and the number of handles. `clone` shares the
/// cell, and the last handle to drop drops the value and frees the cell (`spec/allocators.md`, AL8; `spec/shared.md`).
///
/// ```
/// let a = Shared.new(String.from("hi"))
/// let b = a.clone()
/// assert_eq(a.strong_count(), 2)
/// assert_eq(b.get().len(), 2)
/// ```
struct Shared<T> {
    cell: CPtr<SharedCell<T>>
}

Shared<T> {
    /// Moves `value` into a new cell whose count is one.
    ///
    /// ```
    /// let s = Shared.new(5)
    /// assert_eq(*s.get(), 5)
    /// ```
    fn new(own value: T): Shared<T> {
        unsafe {
            let cell = __alloc(SharedCell<T>.size(), 8) as CPtr<SharedCell<T>>
            (*cell).strong = 1
            __write(&(*cell).value as CPtr<T>, value)
            Shared { cell: cell }
        }
    }

    /// Borrows the value.
    ///
    /// ```
    /// let s = Shared.new(String.from("abc"))
    /// assert_eq(s.get().len(), 3)
    /// ```
    fn get(self): &T {
        unsafe { &(*self.cell).value }
    }

    /// The number of live handles.
    ///
    /// ```
    /// let s = Shared.new(1)
    /// let t = s.clone()
    /// assert_eq(t.strong_count(), 2)
    /// ```
    fn strong_count(self): usize {
        unsafe { __atomic_load_u64(&(*self.cell).strong as CPtr<u64>) as usize }
    }

    /// Another handle to the same cell: the count goes up and no value is copied, so `T` need not be `Clone`.
    ///
    /// ```
    /// let s = Shared.new(1)
    /// let t = s.clone()
    /// assert_eq(*t.get(), 1)
    /// ```
    fn clone(self): Shared<T> {
        unsafe {
            __atomic_add_u64(&(*self.cell).strong as CPtr<u64>, 1)
            Shared { cell: self.cell }
        }
    }
}

Shared<T>: Drop {
    fn drop(mut self) {
        unsafe {
            if __atomic_sub_u64(&(*self.cell).strong as CPtr<u64>, 1) == 1 {
                drop(__read(&(*self.cell).value as CPtr<T>))
                __dealloc(self.cell as CPtr<u8>, SharedCell<T>.size(), 8)
            }
        }
    }
}

unsafe Shared<T>: Send where T: Send + Sync { }

unsafe Shared<T>: Sync where T: Send + Sync { }

/// An owned, NUL-terminated copy of some bytes in the C heap, for passing text to C. It frees the buffer when dropped,
/// and `clone` copies it.
///
/// ```
/// let owned = CString.from("hi")
/// let copy = owned.clone()
/// let text = unsafe { CStr.to_string(copy.as_ptr()) }
/// assert_eq(text, String.from("hi"))
/// ```
struct CString {
    ptr: CPtr<CChar>
    len: usize
}

CString {
    /// Copies the bytes of `s` and appends a NUL.
    fn from(s: str): CString {
        let bytes = s.as_bytes()
        let n = bytes.len()
        unsafe {
            let ptr = __alloc(n + 1, 1) as CPtr<CChar>
            let mut i: usize = 0
            while i < n {
                *(ptr + i) = bytes[i] as CChar
                i = i + 1
            }
            *(ptr + n) = 0
            CString { ptr: ptr, len: n }
        }
    }

    /// The address of the NUL-terminated bytes; the `CString` must outlive its use.
    fn as_ptr(self): CPtr<CChar> {
        unsafe { self.ptr }
    }

    /// A deep copy of the NUL-terminated buffer.
    fn clone(self): CString {
        unsafe {
            let ptr = __alloc(self.len + 1, 1) as CPtr<CChar>
            let mut i: usize = 0
            while i <= self.len {
                *(ptr + i) = *(self.ptr + i)
                i = i + 1
            }
            CString { ptr: ptr, len: self.len }
        }
    }
}

CString: Drop {
    fn drop(mut self) {
        unsafe {
            __dealloc(self.ptr as CPtr<u8>, self.len + 1, 1)
        }
    }
}

/// A growable, owned array. `A` is where its buffer comes from (`Global` unless it was made with `new_in`).
struct List<T, A: Allocator = Global> {
    ptr: CPtr<T>
    len: usize
    cap: usize
    alloc: A
}

List<T, A>: Drop {
    fn drop(mut self) {
        unsafe {
            let mut i: usize = 0
            while i < self.len {
                drop(__read(self.ptr + i))
                i = i + 1
            }
            if self.cap > 0 {
                self.alloc.deallocate(self.ptr as CPtr<u8>, list_bytes(self.cap, T.size()), 8)
            }
        }
    }
}

priv fn list_bytes(n: usize, size: usize): usize {
    let bytes = n * size
    if bytes == 0 { 1 } else { bytes }
}

priv fn list_oob(index: usize, len: usize) {
    panic(format("index out of bounds: the index is {} and the length is {}", index, len))
}

List<T> {
    /// An empty list.
    fn new(): List<T> {
        List { ptr: unsafe { CPtr<T>.null() }, len: 0, cap: 0, alloc: Global { } }
    }

    /// An empty list with room for `n` elements.
    fn with_capacity(n: usize): List<T> {
        let mut out = List<T>.new()
        out.reserve_exact(n)
        out
    }

    /// `Ok` with room for `n` elements, or the reason there is none.
    fn try_with_capacity(n: usize): Result<List<T>, AllocError> {
        let mut out = List<T>.new()
        out.try_reserve_exact(n)?
        Result.Ok(out)
    }
}

List<T, A> {
    fn new_in(own alloc: A): List<T, A> {
        List { ptr: unsafe { CPtr<T>.null() }, len: 0, cap: 0, alloc: alloc }
    }

    fn with_capacity_in(n: usize, own alloc: A): List<T, A> {
        let mut out = List<T, A>.new_in(alloc)
        out.reserve_exact(n)
        out
    }

    fn try_with_capacity_in(n: usize, own alloc: A): Result<List<T, A>, AllocError> {
        let mut out = List<T, A>.new_in(alloc)
        out.try_reserve_exact(n)?
        Result.Ok(out)
    }

    fn len(self): usize { self.len }
    fn capacity(self): usize { self.cap }
    fn is_empty(self): bool { self.len == 0 }

    /// Moves the buffer to `cap` elements (`cap >= len`); `Err` leaves the list unchanged.
    priv fn set_capacity(mut self, cap: usize): Result<(), AllocError> {
        if cap == self.cap { return Result.Ok(()) }
        if T.size() > 0 && cap > 18446744073709551615 / T.size() { return Result.Err(AllocError.CapacityOverflow) }
        unsafe {
            if cap == 0 {
                self.alloc.deallocate(self.ptr as CPtr<u8>, list_bytes(self.cap, T.size()), 8)
                self.ptr = CPtr<T>.null()
                self.cap = 0
                return Result.Ok(())
            }
            let block = if self.cap == 0 {
                self.alloc.allocate(list_bytes(cap, T.size()), 8)
            } else {
                self.alloc.reallocate(self.ptr as CPtr<u8>, list_bytes(self.cap, T.size()), list_bytes(cap, T.size()), 8)
            }
            if block.is_null() { return Result.Err(AllocError.OutOfMemory) }
            self.ptr = block as CPtr<T>
            self.cap = cap
        }
        Result.Ok(())
    }

    priv fn want(self, additional: usize): Result<usize, AllocError> {
        if additional > 18446744073709551615 - self.len { return Result.Err(AllocError.CapacityOverflow) }
        Result.Ok(self.len + additional)
    }

    fn try_reserve(mut self, additional: usize): Result<(), AllocError> {
        let want = self.want(additional)?
        if want <= self.cap { return Result.Ok(()) }
        let doubled = self.cap * 2
        self.set_capacity(if doubled < want { want } else { doubled })
    }

    fn try_reserve_exact(mut self, additional: usize): Result<(), AllocError> {
        let want = self.want(additional)?
        if want <= self.cap { return Result.Ok(()) }
        self.set_capacity(want)
    }

    fn reserve(mut self, additional: usize) {
        match self.try_reserve(additional) {
            Result.Ok(_) => { },
            Result.Err(e) => panic(match e {
                AllocError.CapacityOverflow => "reserve: capacity overflow",
                AllocError.OutOfMemory => "out of memory",
            }),
        }
    }

    fn reserve_exact(mut self, additional: usize) {
        match self.try_reserve_exact(additional) {
            Result.Ok(_) => { },
            Result.Err(e) => panic(match e {
                AllocError.CapacityOverflow => "reserve: capacity overflow",
                AllocError.OutOfMemory => "out of memory",
            }),
        }
    }

    fn shrink_to_fit(mut self) {
        let n = self.len
        let _ = self.set_capacity(n)
    }

    fn push(mut self, own value: T) {
        if self.len == self.cap {
            let doubled = self.cap * 2
            match self.set_capacity(if doubled < 4 { 4 } else { doubled }) {
                Result.Ok(_) => { },
                Result.Err(_) => panic("out of memory"),
            }
        }
        unsafe { __write(self.ptr + self.len, value) }
        self.len = self.len + 1
    }

    fn pop(mut self): Option<T> {
        if self.len == 0 { return Option.None }
        self.len = self.len - 1
        Option.Some(unsafe { __read(self.ptr + self.len) })
    }

    fn as_slice(self): [T] { unsafe { __slice_raw(self.ptr, self.len) } }
    fn iter(self): [T] { unsafe { __slice_raw(self.ptr, self.len) } }

    fn get(self, index: usize): Option<&T> {
        if index < self.len { Option.Some(unsafe { &*(self.ptr + index) }) } else { Option.None }
    }
    fn get_mut(mut self, index: usize): Option<&mut T> {
        if index < self.len { Option.Some(unsafe { &mut *(self.ptr + index) }) } else { Option.None }
    }
    fn first(self): Option<&T> { self.get(0) }
    fn first_mut(mut self): Option<&mut T> { self.get_mut(0) }
    fn last(self): Option<&T> { if self.len == 0 { Option.None } else { self.get(self.len - 1) } }
    fn last_mut(mut self): Option<&mut T> {
        if self.len == 0 { return Option.None }
        let i = self.len - 1
        self.get_mut(i)
    }

    fn clear(mut self) { self.truncate(0) }

    fn truncate(mut self, len: usize) {
        if len >= self.len { return }
        let old = self.len
        self.len = len
        let mut i = len
        while i < old {
            unsafe { drop(__read(self.ptr + i)) }
            i = i + 1
        }
    }

    fn insert(mut self, index: usize, own value: T) {
        if index > self.len { list_oob(index, self.len) }
        if self.len == self.cap {
            let doubled = self.cap * 2
            match self.set_capacity(if doubled < 4 { 4 } else { doubled }) {
                Result.Ok(_) => { },
                Result.Err(_) => panic("out of memory"),
            }
        }
        unsafe {
            let mut i = self.len
            while i > index {
                __write(self.ptr + i, __read(self.ptr + (i - 1)))
                i = i - 1
            }
            __write(self.ptr + index, value)
        }
        self.len = self.len + 1
    }

    fn remove(mut self, index: usize): T {
        if index >= self.len { list_oob(index, self.len) }
        unsafe {
            let out = __read(self.ptr + index)
            let mut i = index
            while i + 1 < self.len {
                __write(self.ptr + i, __read(self.ptr + (i + 1)))
                i = i + 1
            }
            self.len = self.len - 1
            out
        }
    }

    fn swap(mut self, a: usize, b: usize) {
        if a >= self.len || b >= self.len { panic("swap: index out of bounds") }
        if a == b { return }
        unsafe {
            let x = __read(self.ptr + a)
            __write(self.ptr + a, __read(self.ptr + b))
            __write(self.ptr + b, x)
        }
    }

    fn swap_remove(mut self, index: usize): T {
        if index >= self.len { panic("swap_remove: index out of bounds") }
        unsafe {
            let out = __read(self.ptr + index)
            self.len = self.len - 1
            if index != self.len { __write(self.ptr + index, __read(self.ptr + self.len)) }
            out
        }
    }

    fn append(mut self, own other: List<T, A>) {
        let mut other = other
        self.reserve(other.len)
        unsafe {
            let mut i: usize = 0
            while i < other.len {
                __write(self.ptr + (self.len + i), __read(other.ptr + i))
                i = i + 1
            }
        }
        self.len = self.len + other.len
        other.len = 0
    }

    fn iter_mut(mut self): IterMut<T> { unsafe { __iter_mut_raw(self.ptr, self.len) } }

    /// Moves the elements from `at` on into a new list with the default allocator.
    fn split_off(mut self, at: usize): List<T> {
        if at > self.len { panic("split_off: index out of bounds") }
        let mut out = List<T>.with_capacity(self.len - at)
        unsafe {
            let mut i = at
            while i < self.len {
                __write(out.ptr + (i - at), __read(self.ptr + i))
                i = i + 1
            }
        }
        out.len = self.len - at
        self.len = at
        out
    }

    /// Removes `lo..hi` and returns the removed elements as an owning iterator.
    fn drain(mut self, range: Range<usize>): ListIntoIter<T> {
        self.drain_range(__range_start(range), __range_end(range))
    }

    /// `drain(lo..=hi)`.
    fn drain_inclusive(mut self, range: RangeInclusive<usize>): ListIntoIter<T> {
        let hi = __range_end(range)
        if hi >= self.len { panic("drain: range out of bounds") }
        self.drain_range(__range_start(range), hi + 1)
    }

    priv fn drain_range(mut self, lo: usize, hi: usize): ListIntoIter<T> {
        if lo > hi || hi > self.len { panic("drain: range out of bounds") }
        let mut out = List<T>.with_capacity(hi - lo)
        unsafe {
            let mut i = lo
            while i < hi {
                __write(out.ptr + (i - lo), __read(self.ptr + i))
                i = i + 1
            }
            out.len = hi - lo
            let mut j = hi
            while j < self.len {
                __write(self.ptr + (j - (hi - lo)), __read(self.ptr + j))
                j = j + 1
            }
        }
        self.len = self.len - (hi - lo)
        out.into_iter()
    }

    fn into_iter(own self): ListIntoIter<T, A> {
        let mut me = self
        let it = unsafe { ListIntoIter { ptr: me.ptr, len: me.len, cap: me.cap, pos: 0, alloc: __read(&me.alloc as CPtr<A>) } }
        // The iterator now owns the buffer and the allocator. Moving `me` over its own storage ends its life
        // without running its drop, so the allocator is dropped once (by the iterator), not twice.
        unsafe { __write(&me as CPtr<List<T, A>>, me) }
        it
    }
}

/// The owning iterator of a `List`: it yields the elements and drops the ones it did not yield.
struct ListIntoIter<T, A: Allocator = Global> {
    ptr: CPtr<T>
    len: usize
    cap: usize
    pos: usize
    alloc: A
}

ListIntoIter<T, A>: Drop {
    fn drop(mut self) {
        unsafe {
            while self.pos < self.len {
                drop(__read(self.ptr + self.pos))
                self.pos = self.pos + 1
            }
            if self.cap > 0 {
                self.alloc.deallocate(self.ptr as CPtr<u8>, list_bytes(self.cap, T.size()), 8)
            }
        }
    }
}

ListIntoIter<T, A>: Iterator<T> {
    fn next(mut self): Option<T> {
        if self.pos >= self.len { return Option.None }
        let at = self.pos
        self.pos = at + 1
        Option.Some(unsafe { __read(self.ptr + at) })
    }
}

/// A value that drop glue never drops: whoever holds one decides what becomes of the value inside, by reading it out
/// with `__read` or dropping it by hand.
struct ManuallyDrop<T> {
    value: T
}

/// The owning iterator of an array: it yields the elements in order and drops the ones it did not yield.
struct ArrayIntoIter<T, const N: usize> {
    data: ManuallyDrop<[T; N]>
    pos: usize
}

ArrayIntoIter<T, N>: Drop {
    fn drop(mut self) {
        unsafe {
            let base = &self.data.value as CPtr<[T; N]> as CPtr<T>
            while self.pos < N {
                drop(__read(base + self.pos))
                self.pos = self.pos + 1
            }
        }
    }
}

ArrayIntoIter<T, N>: Iterator<T> {
    fn next(mut self): Option<T> {
        if self.pos >= N { return Option.None }
        let at = self.pos
        self.pos = at + 1
        let base = unsafe { &self.data.value as CPtr<[T; N]> as CPtr<T> }
        Option.Some(unsafe { __read(base + at) })
    }
}

List<T, A> where T: Clone, A: Allocator {
    fn extend_from_slice(mut self, values: [T]) {
        for x in values {
            self.push(x.clone())
        }
    }
}

List<T, A> where T: Eq, A: Allocator {
    fn contains(self, value: T): bool {
        self.as_slice().contains(value)
    }
}

List<T, A> where T: Ord, A: Allocator {
    fn sort(mut self) {
        let mut view = self.as_slice()
        view.sort()
    }
}

List<T, A>: Debug where T: Debug, A: Allocator {
    fn debug(self, mut f: Formatter) {
        f.write_str("[")
        let mut first = true
        for x in self.iter() {
            if !first { f.write_str(", ") }
            first = false
            x.debug(mut f)
        }
        f.write_str("]")
    }
}

List<T, A>: Eq where T: Eq, A: Allocator {
    fn eq(self, other: List<T, A>): bool {
        if self.len != other.len { return false }
        let mine = self.as_slice()
        let theirs = other.as_slice()
        let mut i: usize = 0
        while i < self.len {
            if mine[i] != theirs[i] { return false }
            i = i + 1
        }
        true
    }
}

unsafe List<T, A>: Send where T: Send, A: Send { }
unsafe List<T, A>: Sync where T: Sync, A: Sync { }

unsafe ListIntoIter<T, A>: Send where T: Send, A: Send { }
unsafe ListIntoIter<T, A>: Sync where T: Sync, A: Sync { }
