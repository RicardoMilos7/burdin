// The process environment and working directory (issue #412; spec/stdlib.md, "Environment variables and the
// working directory").
//
// The compiler provides the primitives that reach the operating system; the functions here give them the shapes
// a program uses. On Unix an environment value and a path are bytes, so `get_bytes` and `current_dir_bytes` read
// values that are not UTF-8. On Windows the system stores UTF-16, and the primitives convert it to UTF-8; a value
// that is not valid Unicode is not representable, so the byte and text functions both report it as absent.

use bytes.Bytes
use encoding.from_utf8
use fmt.{Display, Formatter}
use std.Error

/// Why an environment or working-directory operation failed.
error enum EnvError {
    Name { name: String } "invalid environment variable name {name}"
    Value { name: String } "invalid value for environment variable {name}"
    Access { name: String } "cannot access environment variable {name}"
    WorkingDirectory "cannot read the working directory"
    SetWorkingDirectory "cannot set the working directory"
}

/// The process arguments, the program name first.
fn args(): List<String> {
    __args()
}

/// The value of the environment variable `name`, or `None` when it is unset or its value is not valid UTF-8.
/// `get_bytes` reads a value that is not UTF-8.
fn get(name: str): Option<String> {
    match __env_get(name) {
        Some(data) => match from_utf8(data[0..data.len()]) {
            Ok(text) => Some(text),
            Err(_) => None,
        },
        None => None,
    }
}

/// The bytes of the environment variable `name`, or `None` when it is unset. On Unix the bytes are the value
/// exactly; on Windows they are its UTF-8 encoding, and a value that is not valid Unicode is `None`.
fn get_bytes(name: str): Option<Bytes> {
    match __env_get(name) {
        Some(data) => Some(Bytes.from_list(data)),
        None => None,
    }
}

/// Sets the environment variable `name` to `value`, replacing an existing value.
fn set(name: str, value: str): Result<(), EnvError> {
    __env_status(__env_set(name, value), name)
}

/// Sets the environment variable `name` to arbitrary bytes. On Windows the bytes must be valid UTF-8. A name is
/// invalid when it is empty or contains `=`, and a value is invalid when it contains a NUL byte.
fn set_bytes(name: str, value: [u8]): Result<(), EnvError> {
    __env_status(__env_set_bytes(name, value), name)
}

/// Removes the environment variable `name`. Removing one that is unset succeeds.
fn remove(name: str): Result<(), EnvError> {
    match __env_remove(name) {
        0 => Ok(()),
        1 => Err(EnvError.Name { name: name.to_string() }),
        _ => Err(EnvError.Access { name: name.to_string() }),
    }
}

/// The working directory as text, or an error when it cannot be read or is not valid UTF-8.
fn current_dir(): Result<String, EnvError> {
    match __current_dir() {
        Some(data) => match from_utf8(data[0..data.len()]) {
            Ok(text) => Ok(text),
            Err(_) => Err(EnvError.WorkingDirectory),
        },
        None => Err(EnvError.WorkingDirectory),
    }
}

/// The working directory as bytes, or an error when it cannot be read. On Windows the bytes are UTF-8.
fn current_dir_bytes(): Result<Bytes, EnvError> {
    match __current_dir() {
        Some(data) => Ok(Bytes.from_list(data)),
        None => Err(EnvError.WorkingDirectory),
    }
}

/// Changes the working directory.
fn set_current_dir(path: str): Result<(), EnvError> {
    match __set_current_dir(path) {
        0 => Ok(()),
        _ => Err(EnvError.SetWorkingDirectory),
    }
}

/// Changes the working directory to arbitrary bytes. On Windows the bytes must be valid UTF-8.
fn set_current_dir_bytes(path: [u8]): Result<(), EnvError> {
    match __set_current_dir_bytes(path) {
        0 => Ok(()),
        _ => Err(EnvError.SetWorkingDirectory),
    }
}

/// Turns a primitive's status into the error value `set` and `set_bytes` report.
priv fn __env_status(status: i32, name: str): Result<(), EnvError> {
    match status {
        0 => Ok(()),
        1 => Err(EnvError.Name { name: name.to_string() }),
        2 => Err(EnvError.Value { name: name.to_string() }),
        _ => Err(EnvError.Access { name: name.to_string() }),
    }
}
