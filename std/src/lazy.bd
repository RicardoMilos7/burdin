// One-time initialization (issue #420; spec/stdlib.md, "Once and Lazy").
//
// `Once<T>` is a cell that is empty until it is set, once. `Lazy<T, F>` is a value that is computed by `F` the first
// time it is asked for. Both are ordinary values: Burdin has no mutable globals, so a cache lives in a struct or a
// local and is passed to whatever needs it. The concurrency-safe variants belong to stage 2 with threads.

use option.take

/// A cell that holds a value after it has been set, and never changes after that. The value sits in a list of at most
/// one element, so `get` can hand out a view of it.
///
/// ```
/// let mut cell: Once<String> = Once.new()
/// assert(cell.set(String.from("hello")))
/// assert_eq(cell.get().unwrap().len(), 5)
/// ```
struct Once<T> {
    value: List<T>
}

Once<T> {
    /// An empty cell.
    ///
    /// ```
    /// let cell: Once<i32> = Once.new()
    /// assert(!cell.is_set())
    /// ```
    fn new(): Once<T> {
        Once { value: List<T>.new() }
    }

    /// Whether the cell has been set.
    ///
    /// ```
    /// let mut cell: Once<i32> = Once.new()
    /// assert(!cell.is_set())
    /// cell.set(1)
    /// assert(cell.is_set())
    /// ```
    fn is_set(self): bool {
        self.value.len() > 0
    }

    /// The value, or `None` while the cell is empty.
    ///
    /// ```
    /// let mut cell: Once<i32> = Once.new()
    /// assert(cell.get().is_none())
    /// cell.set(3)
    /// assert_eq(*cell.get().unwrap(), 3)
    /// ```
    fn get(self): Option<&T> {
        if self.value.len() == 0 {
            return None
        }
        Some(&self.value[0])
    }

    /// Sets the cell and returns `true`. A cell that is already set keeps its value, and `value` is dropped: the
    /// result is `false`.
    ///
    /// ```
    /// let mut cell: Once<i32> = Once.new()
    /// assert(cell.set(1))
    /// assert(!cell.set(2))
    /// assert_eq(*cell.get().unwrap(), 1)
    /// ```
    fn set(mut self, own value: T): bool {
        if self.value.len() > 0 {
            return false
        }
        self.value.push(value)
        true
    }

    /// The value, setting the cell to the result of `init` first when it is empty. `init` runs at most once.
    ///
    /// ```
    /// let mut cell: Once<i32> = Once.new()
    /// let v = *cell.get_or_init(|| 7)
    /// assert_eq(v, 7)
    /// assert_eq(*cell.get_or_init(|| 8), 7)
    /// ```
    fn get_or_init<F: FnOnce(): T>(mut self, own init: F): &T {
        if self.value.len() == 0 {
            self.value.push(init())
        }
        &self.value[0]
    }

    /// Takes the value out and leaves the cell empty, so it can be set again.
    ///
    /// ```
    /// let mut cell: Once<i32> = Once.new()
    /// cell.set(4)
    /// assert_eq(cell.take(), Some(4))
    /// assert(!cell.is_set())
    /// ```
    fn take(mut self): Option<T> {
        self.value.pop()
    }
}

/// A value that `init` computes the first time `force` asks for it. Build one with `lazy(init)`.
///
/// ```
/// let mut answer = lazy(|| 6 * 7)
/// assert_eq(*answer.force(), 42)
/// ```
struct Lazy<T, F: FnOnce(): T> {
    value: List<T>
    init: Option<F>
}

Lazy<T, F> where F: FnOnce(): T {
    /// Whether the value has been computed.
    ///
    /// ```
    /// let mut v = lazy(|| 1)
    /// assert(!v.is_forced())
    /// v.force()
    /// assert(v.is_forced())
    /// ```
    fn is_forced(self): bool {
        self.value.len() > 0
    }

    /// The value, computed now if this is the first call. `init` runs at most once.
    ///
    /// ```
    /// let mut v = lazy(|| 5)
    /// assert_eq(*v.force(), 5)
    /// assert_eq(*v.force(), 5)
    /// ```
    fn force(mut self): &T {
        if self.value.len() == 0 {
            match self.init.take() {
                Some(f) => {
                    self.value.push(f())
                }
                None => panic("Lazy was initialized twice")
            }
        }
        &self.value[0]
    }

    /// The value if it has been computed, without computing it.
    ///
    /// ```
    /// let mut v = lazy(|| 2)
    /// assert(v.peek().is_none())
    /// v.force()
    /// assert_eq(*v.peek().unwrap(), 2)
    /// ```
    fn peek(self): Option<&T> {
        if self.value.len() == 0 {
            return None
        }
        Some(&self.value[0])
    }
}

/// A lazy value that is computed by `init` on first use.
///
/// ```
/// let mut answer = lazy(|| 6 * 7)
/// assert_eq(*answer.force(), 42)
/// ```
fn lazy<T, F: FnOnce(): T>(own init: F): Lazy<T, F> {
    Lazy { value: List<T>.new(), init: Some(init) }
}
