// Text helpers for `str` and `String` (spec/stdlib.md).
//
// They are extension methods (spec/extensions.md), so the prelude makes them visible everywhere and the compiler's own
// methods (`len`, `find`, `starts_with`, ...) win. Read-only `str` extensions apply directly to `String` receivers
// through the `String`-to-`str` borrow fallback (EX3), so `String` needs no duplicate wrappers.
//
// Offsets are byte offsets, and every function keeps UTF-8 intact: a match of a valid separator in valid text always
// starts and ends on a character boundary, and `trim` and `split_whitespace` walk whole characters. The split, lines,
// match, and character-index helpers return lazy iterators that yield `str` views (or `(usize, str)` / `(usize, char)`)
// with no per-piece allocation.

use iter.{DoubleEndedIterator, Iterator}
use mem
use unicode.{is_whitespace, len_utf8}

/// Whether the bytes of `needle` are in `text` at byte offset `at`. The caller keeps `at + needle.len()` within the
/// text. It compares bytes rather than slices of the text: a slice that splits a character panics (`spec/stdlib.md`),
/// and a valid needle starts with a byte that does not continue a character, so a match starts on a boundary.
priv fn matches_at(text: str, at: usize, needle: str): bool {
    let hay = text.as_bytes()
    let pat = needle.as_bytes()
    let mut k: usize = 0
    while k < pat.len() {
        if hay[at + k] != pat[k] {
            return false
        }
        k = k + 1
    }
    true
}

/// Whether `pat[0..pat_len]` matches `hay` at byte offset `at`.
priv fn matches_bytes(hay: [u8], at: usize, pat: [u8], pat_len: usize): bool {
    let mut k: usize = 0
    while k < pat_len {
        if hay[at + k] != pat[k] {
            return false
        }
        k = k + 1
    }
    true
}

/// The character that starts at byte `at` of `bytes` (valid UTF-8, with `at` on a character boundary) and the number
/// of bytes it takes.
priv fn decode_char(bytes: [u8], at: usize): (char, usize) {
    let b0 = bytes[at] as u32
    if b0 < 128 {
        return (b0 as char, 1)
    }
    if b0 < 224 {
        let c = ((b0 & 31) << 6) | ((bytes[at + 1] as u32) & 63)
        return (c as char, 2)
    }
    if b0 < 240 {
        let c = ((b0 & 15) << 12) | (((bytes[at + 1] as u32) & 63) << 6) | ((bytes[at + 2] as u32) & 63)
        return (c as char, 3)
    }
    let high = ((b0 & 7) << 18) | (((bytes[at + 1] as u32) & 63) << 12)
    let low = (((bytes[at + 2] as u32) & 63) << 6) | ((bytes[at + 3] as u32) & 63)
    ((high | low) as char, 4)
}

/// Encodes `c` into a 4-byte UTF-8 buffer on the stack and returns `(bytes, len)`.
priv fn encode_char_utf8(c: char): ([u8; 4], usize) {
    let code = c as u32
    if code < 128 {
        return ([code as u8, 0, 0, 0], 1)
    }
    if code < 2048 {
        return ([(192 | (code >> 6)) as u8, (128 | (code & 63)) as u8, 0, 0], 2)
    }
    if code < 65536 {
        return (
            [
                (224 | (code >> 12)) as u8,
                (128 | ((code >> 6) & 63)) as u8,
                (128 | (code & 63)) as u8,
                0,
            ],
            3,
        )
    }
    (
        [
            (240 | (code >> 18)) as u8,
            (128 | ((code >> 12) & 63)) as u8,
            (128 | ((code >> 6) & 63)) as u8,
            (128 | (code & 63)) as u8,
        ],
        4,
    )
}

/// The byte offset of the first occurrence of `needle` (non-empty) in `text` at or after `from`, or `text.len()` when
/// there is none. Uses a linear byte scan with O(1) extra space and O(n * m) worst-case time.
priv fn index_of(text: str, needle: str, from: usize): usize {
    let hay = text.as_bytes()
    let pat = needle.as_bytes()
    let hlen = hay.len()
    let n = pat.len()
    if n == 0 {
        return from
    }
    if n > hlen || from > hlen - n {
        return hlen
    }
    let b0 = pat[0]
    let limit = hlen - n
    if n == 1 {
        let mut i = from
        while i <= limit {
            if hay[i] == b0 {
                return i
            }
            i = i + 1
        }
        return hlen
    }
    let mut i = from
    while i <= limit {
        if hay[i] == b0 && matches_at(text, i, needle) {
            return i
        }
        i = i + 1
    }
    hlen
}

/// The byte offset of the last occurrence of `needle` (non-empty) in `text[0..end]`, or `None`.
priv fn rindex_of(text: str, needle: str, end: usize): Option<usize> {
    let n = needle.len()
    if n > end {
        return Option.None
    }
    let hay = text.as_bytes()
    let pat = needle.as_bytes()
    let b0 = pat[0]
    let mut i = end - n
    if n == 1 {
        loop {
            if hay[i] == b0 {
                return Option.Some(i)
            }
            if i == 0 {
                return Option.None
            }
            i = i - 1
        }
    }
    loop {
        if hay[i] == b0 && matches_at(text, i, needle) {
            return Option.Some(i)
        }
        if i == 0 {
            return Option.None
        }
        i = i - 1
    }
}

/// The byte offset of the first occurrence of `pat[0..pat_len]` (non-empty) in `hay[from..end]`, or `end` when none.
priv fn index_of_bytes(hay: [u8], pat: [u8], pat_len: usize, from: usize, end: usize): usize {
    if pat_len > end || from > end - pat_len {
        return end
    }
    let b0 = pat[0]
    let limit = end - pat_len
    if pat_len == 1 {
        let mut i = from
        while i <= limit {
            if hay[i] == b0 {
                return i
            }
            i = i + 1
        }
        return end
    }
    let mut i = from
    while i <= limit {
        if hay[i] == b0 && matches_bytes(hay, i, pat, pat_len) {
            return i
        }
        i = i + 1
    }
    end
}

/// The byte offset of the last occurrence of `pat[0..pat_len]` (non-empty) in `hay[from..end]`, or `None`.
priv fn rindex_of_bytes(hay: [u8], pat: [u8], pat_len: usize, from: usize, end: usize): Option<usize> {
    if end < from || end - from < pat_len {
        return Option.None
    }
    let b0 = pat[0]
    let mut i = end - pat_len
    if pat_len == 1 {
        loop {
            if hay[i] == b0 {
                return Option.Some(i)
            }
            if i == from {
                return Option.None
            }
            i = i - 1
        }
    }
    loop {
        if hay[i] == b0 && matches_bytes(hay, i, pat, pat_len) {
            return Option.Some(i)
        }
        if i == from {
            return Option.None
        }
        i = i - 1
    }
}

/// The text of `a` followed by the text of `b`, in a new string: the built-in `String + str` (`spec/operators.md`,
/// OP14). Both operands are borrowed.
// lint: allow(dead_code)
priv fn concat(a: str, b: str): String {
    let mut out = String.with_capacity(a.len() + b.len())
    out.push_str(a)
    out.push_str(b)
    out
}

// ---- Lazy text iterators ----

/// The lazy iterator of `chars()`: the text it reads and the byte range `front..back` not yet yielded. It decodes one
/// character per `next` or `next_back` and allocates nothing. `S` is the text it reads, so a `Chars<str>` holds a view
/// and is second-class like any view (`spec/memory-rules.md`, SC2): a local, a parameter, a return value, or a
/// temporary, never a field of a user struct, and the text stays borrowed until the iterator's last use.
///
/// ```
/// let mut it = "añ".chars()
/// assert_eq(it.next(), Option.Some('a'))
/// assert_eq(it.next(), Option.Some('ñ'))
/// assert_eq(it.next(), Option.None)
/// ```
struct Chars<S>: Clone {
    priv text: S
    priv front: usize
    priv back: usize
}

Chars<str>: Iterator<char> {
    /// The next character from the front, or `None` once the front meets the back.
    ///
    /// ```
    /// let mut it = "😀".chars()
    /// assert_eq(it.next(), Option.Some('😀'))
    /// assert_eq(it.next(), Option.None)
    /// ```
    fn next(mut self): Option<char> {
        if self.front >= self.back {
            return Option.None
        }
        let (c, width) = decode_char(self.text.as_bytes(), self.front)
        self.front = self.front + width
        Option.Some(c)
    }
}

Chars<str>: DoubleEndedIterator<char> {
    /// The next character from the back: it steps back over the continuation bytes (`10xxxxxx`) to the byte that
    /// starts the last character, and decodes forward from there.
    ///
    /// ```
    /// let mut it = "añ".chars()
    /// assert_eq(it.next_back(), Option.Some('ñ'))
    /// assert_eq(it.next_back(), Option.Some('a'))
    /// assert_eq(it.next_back(), Option.None)
    /// ```
    fn next_back(mut self): Option<char> {
        if self.front >= self.back {
            return Option.None
        }
        let bytes = self.text.as_bytes()
        let mut at = self.back - 1
        while at > self.front && (bytes[at] & 192) == 128 {
            at = at - 1
        }
        let (c, _) = decode_char(bytes, at)
        self.back = at
        Option.Some(c)
    }
}

/// The lazy iterator of `char_indices()`: yields `(byte_offset, char)` pairs from the front or back without allocating.
///
/// ```
/// let mut it = "añ".char_indices()
/// assert_eq(it.next(), Option.Some((0, 'a')))
/// assert_eq(it.next(), Option.Some((1, 'ñ')))
/// assert_eq(it.next(), Option.None)
/// ```
struct CharIndices<S>: Clone {
    priv text: S
    priv front: usize
    priv back: usize
}

CharIndices<str>: Iterator<(usize, char)> {
    /// The next `(byte_offset, char)` pair from the front.
    ///
    /// ```
    /// let mut it = "éx".char_indices()
    /// assert_eq(it.next(), Option.Some((0, 'é')))
    /// assert_eq(it.next(), Option.Some((2, 'x')))
    /// ```
    fn next(mut self): Option<(usize, char)> {
        if self.front >= self.back {
            return Option.None
        }
        let at = self.front
        let (c, width) = decode_char(self.text.as_bytes(), at)
        self.front = at + width
        Option.Some((at, c))
    }
}

CharIndices<str>: DoubleEndedIterator<(usize, char)> {
    /// The next `(byte_offset, char)` pair from the back.
    ///
    /// ```
    /// let mut it = "éx".char_indices()
    /// assert_eq(it.next_back(), Option.Some((2, 'x')))
    /// assert_eq(it.next_back(), Option.Some((0, 'é')))
    /// ```
    fn next_back(mut self): Option<(usize, char)> {
        if self.front >= self.back {
            return Option.None
        }
        let bytes = self.text.as_bytes()
        let mut at = self.back - 1
        while at > self.front && (bytes[at] & 192) == 128 {
            at = at - 1
        }
        let (c, _) = decode_char(bytes, at)
        self.back = at
        Option.Some((at, c))
    }
}

/// The lazy iterator of `split(sep)`: yields `str` views of the pieces between occurrences of `sep`, in order, with no
/// allocation. It borrows both the text and the separator (second-class, `spec/memory-rules.md`, SC2/RT3a).
///
/// ```
/// let mut it = "a::b".split("::")
/// assert_eq(it.next().unwrap(), "a")
/// assert_eq(it.next().unwrap(), "b")
/// assert(it.next().is_none())
/// ```
struct Split<S>: Clone {
    priv text: S
    priv sep: S
    priv pos: usize
    priv done: bool
}

Split<str>: Iterator<str> {
    /// The next piece before `sep`, or the remaining tail on the last step.
    ///
    /// ```
    /// let mut it = "a,b".split(",")
    /// assert_eq(it.next().unwrap(), "a")
    /// assert_eq(it.next().unwrap(), "b")
    /// ```
    fn next(mut self): Option<str> {
        if self.done {
            return Option.None
        }
        let at = index_of(self.text, self.sep, self.pos)
        if at >= self.text.len() {
            self.done = true
            return Option.Some(self.text[self.pos..self.text.len()])
        }
        let piece = self.text[self.pos..at]
        self.pos = at + self.sep.len()
        Option.Some(piece)
    }
}

/// The lazy iterator of `rsplit(sep)`: scans backward from the end and yields `str` views, last piece first, with no
/// allocation.
///
/// ```
/// let mut it = "a::b::c".rsplit("::")
/// assert_eq(it.next().unwrap(), "c")
/// assert_eq(it.next().unwrap(), "b")
/// assert_eq(it.next().unwrap(), "a")
/// assert(it.next().is_none())
/// ```
struct RSplit<S>: Clone {
    priv text: S
    priv sep: S
    priv end: usize
    priv done: bool
}

RSplit<str>: Iterator<str> {
    /// The next piece from the back, scanning backward for `sep`.
    ///
    /// ```
    /// let mut it = "a,b".rsplit(",")
    /// assert_eq(it.next().unwrap(), "b")
    /// assert_eq(it.next().unwrap(), "a")
    /// ```
    fn next(mut self): Option<str> {
        if self.done {
            return Option.None
        }
        match rindex_of(self.text, self.sep, self.end) {
            Option.Some(at) => {
                let piece = self.text[at + self.sep.len()..self.end]
                self.end = at
                Option.Some(piece)
            }
            Option.None => {
                self.done = true
                Option.Some(self.text[0..self.end])
            }
        }
    }
}

/// The lazy iterator of `split_char(c)`: yields `str` views between occurrences of `c`, from the front or back, with
/// no allocation.
///
/// ```
/// let mut it = "a,b".split_char(',')
/// assert_eq(it.next().unwrap(), "a")
/// assert_eq(it.next().unwrap(), "b")
/// assert(it.next().is_none())
/// ```
struct SplitChar<S>: Clone {
    priv text: S
    priv sep: [u8; 4]
    priv sep_len: usize
    priv front: usize
    priv back: usize
    priv done: bool
}

SplitChar<str>: Iterator<str> {
    /// The next piece from the front.
    ///
    /// ```
    /// let mut it = "añb".split_char('ñ')
    /// assert_eq(it.next().unwrap(), "a")
    /// assert_eq(it.next().unwrap(), "b")
    /// ```
    fn next(mut self): Option<str> {
        if self.done {
            return Option.None
        }
        let at = index_of_bytes(self.text.as_bytes(), self.sep[0..4], self.sep_len, self.front, self.back)
        if at >= self.back {
            self.done = true
            return Option.Some(self.text[self.front..self.back])
        }
        let piece = self.text[self.front..at]
        self.front = at + self.sep_len
        Option.Some(piece)
    }
}

SplitChar<str>: DoubleEndedIterator<str> {
    /// The next piece from the back.
    ///
    /// ```
    /// let mut it = "a,b,c".split_char(',')
    /// assert_eq(it.next_back().unwrap(), "c")
    /// assert_eq(it.next().unwrap(), "a")
    /// ```
    fn next_back(mut self): Option<str> {
        if self.done {
            return Option.None
        }
        match rindex_of_bytes(self.text.as_bytes(), self.sep[0..4], self.sep_len, self.front, self.back) {
            Option.Some(at) => {
                let piece = self.text[at + self.sep_len..self.back]
                self.back = at
                Option.Some(piece)
            }
            Option.None => {
                self.done = true
                Option.Some(self.text[self.front..self.back])
            }
        }
    }
}

/// The lazy iterator of `rsplit_char(c)`: scans backward from the end and yields `str` views between occurrences of
/// `c`, last piece first, with no allocation.
///
/// ```
/// let mut it = "a,b,c".rsplit_char(',')
/// assert_eq(it.next().unwrap(), "c")
/// assert_eq(it.next().unwrap(), "b")
/// assert_eq(it.next().unwrap(), "a")
/// ```
struct RSplitChar<S>: Clone {
    priv text: S
    priv sep: [u8; 4]
    priv sep_len: usize
    priv front: usize
    priv back: usize
    priv done: bool
}

RSplitChar<str>: Iterator<str> {
    /// The next piece from the back.
    ///
    /// ```
    /// let mut it = "añb".rsplit_char('ñ')
    /// assert_eq(it.next().unwrap(), "b")
    /// assert_eq(it.next().unwrap(), "a")
    /// ```
    fn next(mut self): Option<str> {
        if self.done {
            return Option.None
        }
        match rindex_of_bytes(self.text.as_bytes(), self.sep[0..4], self.sep_len, self.front, self.back) {
            Option.Some(at) => {
                let piece = self.text[at + self.sep_len..self.back]
                self.back = at
                Option.Some(piece)
            }
            Option.None => {
                self.done = true
                Option.Some(self.text[self.front..self.back])
            }
        }
    }
}

RSplitChar<str>: DoubleEndedIterator<str> {
    /// The next piece from the front.
    ///
    /// ```
    /// let mut it = "a,b,c".rsplit_char(',')
    /// assert_eq(it.next_back().unwrap(), "a")
    /// ```
    fn next_back(mut self): Option<str> {
        if self.done {
            return Option.None
        }
        let at = index_of_bytes(self.text.as_bytes(), self.sep[0..4], self.sep_len, self.front, self.back)
        if at >= self.back {
            self.done = true
            return Option.Some(self.text[self.front..self.back])
        }
        let piece = self.text[self.front..at]
        self.front = at + self.sep_len
        Option.Some(piece)
    }
}

/// The lazy iterator of `split_whitespace()`: yields `str` views of each non-white-space run, from the front or back,
/// with no allocation.
///
/// ```
/// let mut it = " a  b ".split_whitespace()
/// assert_eq(it.next().unwrap(), "a")
/// assert_eq(it.next().unwrap(), "b")
/// assert(it.next().is_none())
/// ```
struct SplitWhitespace<S>: Clone {
    priv text: S
    priv front: usize
    priv back: usize
}

SplitWhitespace<str>: Iterator<str> {
    /// The next non-white-space word from the front.
    ///
    /// ```
    /// let mut it = "  hi\tthere ".split_whitespace()
    /// assert_eq(it.next().unwrap(), "hi")
    /// assert_eq(it.next().unwrap(), "there")
    /// ```
    fn next(mut self): Option<str> {
        let bytes = self.text.as_bytes()
        while self.front < self.back {
            let (c, width) = decode_char(bytes, self.front)
            if !c.is_whitespace() {
                break
            }
            self.front = self.front + width
        }
        if self.front >= self.back {
            return Option.None
        }
        let start = self.front
        while self.front < self.back {
            let (c, width) = decode_char(bytes, self.front)
            if c.is_whitespace() {
                break
            }
            self.front = self.front + width
        }
        Option.Some(self.text[start..self.front])
    }
}

SplitWhitespace<str>: DoubleEndedIterator<str> {
    /// The next non-white-space word from the back.
    ///
    /// ```
    /// let mut it = "  hi\tthere ".split_whitespace()
    /// assert_eq(it.next_back().unwrap(), "there")
    /// assert_eq(it.next_back().unwrap(), "hi")
    /// ```
    fn next_back(mut self): Option<str> {
        let bytes = self.text.as_bytes()
        while self.front < self.back {
            let mut at = self.back - 1
            while at > self.front && (bytes[at] & 192) == 128 {
                at = at - 1
            }
            let (c, _) = decode_char(bytes, at)
            if !c.is_whitespace() {
                break
            }
            self.back = at
        }
        if self.front >= self.back {
            return Option.None
        }
        let end = self.back
        while self.front < self.back {
            let mut at = self.back - 1
            while at > self.front && (bytes[at] & 192) == 128 {
                at = at - 1
            }
            let (c, _) = decode_char(bytes, at)
            if c.is_whitespace() {
                break
            }
            self.back = at
        }
        Option.Some(self.text[self.back..end])
    }
}

/// The lazy iterator of `lines()`: yields `str` views split at `\n`, stripping a preceding `\r` and ignoring a final
/// trailing newline, from the front or back, with no allocation.
///
/// ```
/// let mut it = "a\r\nb\n".lines()
/// assert_eq(it.next().unwrap(), "a")
/// assert_eq(it.next().unwrap(), "b")
/// assert(it.next().is_none())
/// ```
struct Lines<S>: Clone {
    priv text: S
    priv front: usize
    priv back: usize
}

Lines<str>: Iterator<str> {
    /// The next line from the front.
    ///
    /// ```
    /// let mut it = "x\ny".lines()
    /// assert_eq(it.next().unwrap(), "x")
    /// assert_eq(it.next().unwrap(), "y")
    /// ```
    fn next(mut self): Option<str> {
        if self.front >= self.back {
            return Option.None
        }
        let bytes = self.text.as_bytes()
        let start = self.front
        let mut i = start
        while i < self.back {
            if bytes[i] == 10 {
                let mut end = i
                if end > start && bytes[end - 1] == 13 {
                    end = end - 1
                }
                self.front = i + 1
                return Option.Some(self.text[start..end])
            }
            i = i + 1
        }
        self.front = self.back
        Option.Some(self.text[start..self.back])
    }
}

Lines<str>: DoubleEndedIterator<str> {
    /// The next line from the back.
    ///
    /// ```
    /// let mut it = "a\nb\n".lines()
    /// assert_eq(it.next_back().unwrap(), "b")
    /// assert_eq(it.next_back().unwrap(), "a")
    /// ```
    fn next_back(mut self): Option<str> {
        if self.front >= self.back {
            return Option.None
        }
        let bytes = self.text.as_bytes()
        let mut end = self.back
        if bytes[end - 1] == 10 {
            end = end - 1
            if end > self.front && bytes[end - 1] == 13 {
                end = end - 1
            }
        }
        let mut i = end
        while i > self.front {
            i = i - 1
            if bytes[i] == 10 {
                let start = i + 1
                self.back = i + 1
                return Option.Some(self.text[start..end])
            }
        }
        let start = self.front
        self.back = self.front
        Option.Some(self.text[start..end])
    }
}

/// The lazy iterator of `match_indices(needle)` and `find_all(needle)`: yields `(byte_offset, matched_str)` pairs for
/// every non-overlapping occurrence of `needle`, with no allocation.
///
/// ```
/// let mut it = "abcabc".match_indices("bc")
/// assert_eq(it.next().unwrap().0, 1)
/// assert_eq(it.next().unwrap().0, 4)
/// assert(it.next().is_none())
/// ```
struct MatchIndices<S>: Clone {
    priv text: S
    priv needle: S
    priv pos: usize
}

MatchIndices<str>: Iterator<(usize, str)> {
    /// The next `(byte_offset, matched_str)` pair.
    ///
    /// ```
    /// let mut it = "abab".find_all("ab")
    /// assert_eq(it.next().unwrap().1, "ab")
    /// ```
    fn next(mut self): Option<(usize, str)> {
        let at = index_of(self.text, self.needle, self.pos)
        if at >= self.text.len() {
            return Option.None
        }
        let end = at + self.needle.len()
        self.pos = end
        Option.Some((at, self.text[at..end]))
    }
}

// ---- str ----
// Every read-only `str` extension also applies directly to `String` receivers (`spec/extensions.md`, EX3).

/// The characters (Unicode scalar values) of the text, in order, as a lazy iterator. It decodes one character at a
/// time and allocates nothing; `to_list()` (or `to_char_list()`) builds a list when one is needed. The iterator
/// borrows the text (a view, second-class), so the text cannot change while it is live.
///
/// ```
/// let mut count = 0
/// for c in "añ😀".chars() {
///     count = count + 1
/// }
/// assert_eq(count, 3)
/// assert_eq("añ".chars().rev().to_list()[0], 'ñ')
/// ```
fn str.chars(self): Chars<str> {
    Chars { text: self, front: 0, back: self.len() }
}

/// Whether the text has no bytes.
///
/// ```
/// assert("".is_empty())
/// assert(!"x".is_empty())
/// ```
fn str.is_empty(self): bool {
    self.len() == 0
}

/// Whether `needle` occurs in the text. The empty string occurs everywhere.
///
/// ```
/// assert("hello".contains("ell"))
/// ```
fn str.contains(self, needle: str): bool {
    needle.len() == 0 || index_of(self, needle, 0) < self.len()
}

/// Whether the text ends with `suffix`.
///
/// ```
/// assert("file.bd".ends_with(".bd"))
/// ```
fn str.ends_with(self, suffix: str): bool {
    suffix.len() <= self.len() && matches_at(self, self.len() - suffix.len(), suffix)
}

/// The text without leading and trailing white space (`char.is_whitespace`).
///
/// ```
/// assert_eq("  hi  ".trim(), "hi")
/// ```
fn str.trim(self): str {
    self.trim_start().trim_end()
}

/// The text without leading white space.
///
/// ```
/// assert_eq("  hi".trim_start(), "hi")
/// ```
fn str.trim_start(self): str {
    let mut at: usize = 0
    for c in self.chars() {
        if !c.is_whitespace() {
            return self[at..self.len()]
        }
        at = at + c.len_utf8()
    }
    self[self.len()..self.len()]
}

/// The text without trailing white space.
///
/// ```
/// assert_eq("hi  ".trim_end(), "hi")
/// ```
fn str.trim_end(self): str {
    let bytes = self.as_bytes()
    let mut end = bytes.len()
    while end > 0 {
        let mut at = end - 1
        while at > 0 && (bytes[at] & 192) == 128 {
            at = at - 1
        }
        let (c, _) = decode_char(bytes, at)
        if !c.is_whitespace() {
            return self[0..end]
        }
        end = at
    }
    self[0..0]
}

/// The pieces between occurrences of `sep`, in order, as a lazy iterator of `str` views:
/// `"a,b,,c".split(",")` yields `"a"`, `"b"`, `""`, `"c"`. An empty `sep` panics.
///
/// ```
/// let parts: List<String> = "a::b".split("::").collect()
/// assert_eq(parts[1], String.from("b"))
/// ```
fn str.split(self, sep: str): Split<str> {
    if sep.len() == 0 {
        panic("split: the separator is empty")
    }
    Split { text: self, sep: sep, pos: 0, done: false }
}

/// The pieces between occurrences of the character `c`, in order, as a lazy double-ended iterator of `str` views.
///
/// ```
/// assert_eq("a,b".split_char(',').count(), 2)
/// ```
fn str.split_char(self, c: char): SplitChar<str> {
    let (sep, sep_len) = encode_char_utf8(c)
    SplitChar { text: self, sep: sep, sep_len: sep_len, front: 0, back: self.len(), done: false }
}

/// The pieces between occurrences of `sep`, last piece first, as a lazy iterator of `str` views. Scans backward
/// without allocating. An empty `sep` panics.
///
/// ```
/// assert_eq("a::b::c".rsplit("::").next().unwrap(), "c")
/// ```
fn str.rsplit(self, sep: str): RSplit<str> {
    if sep.len() == 0 {
        panic("split: the separator is empty")
    }
    RSplit { text: self, sep: sep, end: self.len(), done: false }
}

/// The pieces between occurrences of the character `c`, last piece first, as a lazy double-ended iterator of `str`
/// views.
///
/// ```
/// assert_eq("a,b,c".rsplit_char(',').next().unwrap(), "c")
/// ```
fn str.rsplit_char(self, c: char): RSplitChar<str> {
    let (sep, sep_len) = encode_char_utf8(c)
    RSplitChar { text: self, sep: sep, sep_len: sep_len, front: 0, back: self.len(), done: false }
}

/// The runs of non-white-space characters, in order, as a lazy double-ended iterator of `str` views.
///
/// ```
/// assert_eq(" a  b ".split_whitespace().count(), 2)
/// ```
fn str.split_whitespace(self): SplitWhitespace<str> {
    SplitWhitespace { text: self, front: 0, back: self.len() }
}

/// The lines of the text, split at a line feed, with a carriage return before it removed, as a lazy double-ended
/// iterator of `str` views. A final line break does not start a new line.
///
/// ```
/// assert_eq("a\nb".lines().count(), 2)
/// ```
fn str.lines(self): Lines<str> {
    Lines { text: self, front: 0, back: self.len() }
}

/// A copy with every occurrence of `from` replaced by `to`. An empty `from` panics.
///
/// ```
/// assert_eq("a-b-c".replace("-", "+"), String.from("a+b+c"))
/// ```
fn str.replace(self, from: str, to: str): String {
    if from.len() == 0 {
        panic("replace: the pattern is empty")
    }
    let first = index_of(self, from, 0)
    if first >= self.len() {
        return String.from(self)
    }
    let mut out = String.with_capacity(self.len())
    out.push_str(self[0..first])
    out.push_str(to)
    let mut start = first + from.len()
    loop {
        let at = index_of(self, from, start)
        if at >= self.len() {
            break
        }
        out.push_str(self[start..at])
        out.push_str(to)
        start = at + from.len()
    }
    out.push_str(self[start..self.len()])
    out
}

/// The text after `prefix`, or `None` when it does not start with `prefix`. The result is a view of the text
/// (`spec/stdlib.md`, "String bytes and UTF-8 validation").
///
/// ```
/// assert("file.bd".strip_prefix("file").unwrap() == ".bd")
/// ```
fn str.strip_prefix(self, prefix: str): Option<str> {
    if self.starts_with(prefix) {
        return Option.Some(self[prefix.len()..self.len()])
    }
    Option.None
}

/// The text before `suffix`, or `None` when it does not end with `suffix`; a view of the text.
///
/// ```
/// assert("file.bd".strip_suffix(".bd").unwrap() == "file")
/// ```
fn str.strip_suffix(self, suffix: str): Option<str> {
    if self.ends_with(suffix) {
        return Option.Some(self[0..self.len() - suffix.len()])
    }
    Option.None
}

/// The text `count` times in a row.
///
/// ```
/// assert_eq("ab".repeat(2), String.from("abab"))
/// ```
fn str.repeat(self, count: usize): String {
    if count == 0 || self.len() == 0 {
        return String.new()
    }
    let mut out = String.with_capacity(self.len() * count)
    let mut i: usize = 0
    while i < count {
        out.push_str(self)
        i = i + 1
    }
    out
}

// ---- Characters of a text ----
//
// The scope of Unicode support is the scalar value: these helpers count, index, and rebuild text by `char`. They do
// not normalize and they do not group characters into grapheme clusters, so `é` written as `e` plus a combining
// accent is two characters.

/// The number of characters (Unicode scalar values) in the text; `len` counts bytes.
///
/// ```
/// assert_eq("héllo".char_count(), 5)
/// ```
fn str.char_count(self): usize {
    let bytes = self.as_bytes()
    let mut n: usize = 0
    let mut i: usize = 0
    while i < bytes.len() {
        if (bytes[i] & 192) != 128 {
            n = n + 1
        }
        i = i + 1
    }
    n
}

/// Whether byte offset `i` is the start of a character or the end of the text.
///
/// ```
/// assert("abc".is_char_boundary(1))
/// assert(!"é".is_char_boundary(1))
/// ```
fn str.is_char_boundary(self, i: usize): bool {
    let bytes = self.as_bytes()
    if i == 0 || i == bytes.len() {
        return true
    }
    if i > bytes.len() {
        return false
    }
    (bytes[i] & 192) != 128
}

/// The `n`th character (counting from 0), or `None` when the text is shorter.
///
/// ```
/// assert_eq("abc".nth_char(1), Option.Some('b'))
/// ```
fn str.nth_char(self, n: usize): Option<char> {
    let bytes = self.as_bytes()
    let mut i: usize = 0
    let mut at: usize = 0
    while at < bytes.len() {
        let (c, width) = decode_char(bytes, at)
        if i == n {
            return Option.Some(c)
        }
        i = i + 1
        at = at + width
    }
    Option.None
}

/// The characters as a list.
///
/// ```
/// let chars = "ab".to_char_list()
/// assert_eq(chars[0], 'a')
/// ```
fn str.to_char_list(self): List<char> {
    let bytes = self.as_bytes()
    let n = bytes.len()
    let mut out = List<char>.with_capacity(n)
    let mut at: usize = 0
    while at < n {
        let (c, width) = decode_char(bytes, at)
        out.push(c)
        at = at + width
    }
    out
}

/// Each character with the byte offset where it starts, as a lazy double-ended iterator.
///
/// ```
/// let pairs = "ab".char_indices().to_list()
/// assert_eq(pairs[1].0, 1)
/// assert_eq(pairs[1].1, 'b')
/// ```
fn str.char_indices(self): CharIndices<str> {
    CharIndices { text: self, front: 0, back: self.len() }
}

/// A copy with the characters in the opposite order.
///
/// ```
/// assert_eq("abc".reverse_chars(), String.from("cba"))
/// ```
fn str.reverse_chars(self): String {
    let mut out = String.with_capacity(self.len())
    for c in self.chars().rev() {
        out.push(c)
    }
    out
}

/// The characters from index `start` up to (not including) `end`, counting characters, not bytes. An index past the
/// end stops at the end.
///
/// ```
/// assert_eq("hello".slice_chars(1, 3), String.from("el"))
/// ```
fn str.slice_chars(self, start: usize, end: usize): String {
    if start >= end {
        return String.new()
    }
    let bytes = self.as_bytes()
    let mut i: usize = 0
    let mut at: usize = 0
    let mut start_byte = bytes.len()
    let mut end_byte = bytes.len()
    while at < bytes.len() {
        if i == start {
            start_byte = at
        }
        if i == end {
            end_byte = at
            break
        }
        let (_, width) = decode_char(bytes, at)
        at = at + width
        i = i + 1
    }
    if start_byte >= end_byte {
        return String.new()
    }
    String.from(self[start_byte..end_byte])
}

/// The characters of the list as a string.
///
/// ```
/// let mut chars = List<char>.new()
/// chars.push('h')
/// chars.push('i')
/// assert_eq(chars.collect_string(), String.from("hi"))
/// ```
fn List<char>.collect_string(self): String {
    let mut cap: usize = 0
    for c in self {
        cap = cap + c.len_utf8()
    }
    let mut out = String.with_capacity(cap)
    for c in self {
        out.push(c)
    }
    out
}

// ---- Capacity and editing (issue #714) ----
//
// `capacity`, `reserve`, `shrink_to_fit`, `insert_str`, `replace_range`, and `String.with_capacity` are provided by
// the compiler; the other operations are written here on top of them. Every byte index is a character boundary, and
// an index that is out of range or splits a character panics with the message of the operation.

/// Makes the string empty and keeps its buffer.
///
/// ```
/// let mut s = String.from("x")
/// s.clear()
/// assert(s.is_empty())
/// ```
fn String.clear(mut self) {
    self.truncate(0)
}

/// Shortens the string to `len` bytes, which must be a character boundary. A longer length panics.
///
/// ```
/// let mut s = String.from("hello")
/// s.truncate(2)
/// assert_eq(s, String.from("he"))
/// ```
fn String.truncate(mut self, len: usize) {
    let end = self.len()
    self.replace_range(len, end, "")
}

/// Removes and returns the last character, or `None` when the string is empty.
///
/// ```
/// let mut s = String.from("ab")
/// assert_eq(s.pop(), Option.Some('b'))
/// assert_eq(s, String.from("a"))
/// ```
fn String.pop(mut self): Option<char> {
    if self.len() == 0 {
        return Option.None
    }
    let bytes = self.as_bytes()
    let mut at = bytes.len() - 1
    while at > 0 && (bytes[at] & 192) == 128 {
        at = at - 1
    }
    let (c, _) = decode_char(bytes, at)
    self.truncate(at)
    Option.Some(c)
}

/// Inserts the character `c` at byte index `at`, which must be a character boundary. A later byte moves right by
/// the character's UTF-8 length.
///
/// ```
/// let mut s = String.from("ac")
/// s.insert(1, 'b')
/// assert_eq(s, String.from("abc"))
/// ```
fn String.insert(mut self, at: usize, c: char) {
    let (buf, len) = encode_char_utf8(c)
    let text = unsafe { __view_as_text(buf[0..len]) }
    self.insert_str(at, text)
}

/// Removes and returns the character that starts at byte index `at`.
///
/// ```
/// let mut s = String.from("abc")
/// assert_eq(s.remove(1), 'b')
/// assert_eq(s, String.from("ac"))
/// ```
fn String.remove(mut self, at: usize): char {
    if at >= self.len() || !self.is_char_boundary(at) {
        panic("remove: the index is out of bounds or not a character boundary")
    }
    let (c, width) = decode_char(self.as_bytes(), at)
    self.replace_range(at, at + width, "")
    c
}

/// Keeps the characters `f` accepts, in order, and drops the others.
///
/// ```
/// let mut s = String.from("a1b2")
/// s.retain(|c| c != '1')
/// assert_eq(s, String.from("ab2"))
/// ```
fn String.retain<F: FnMut(char): bool>(mut self, own f: F) {
    let mut f = f
    let mut kept = String.with_capacity(self.len())
    for c in self.chars() {
        if f(c) {
            kept.push(c)
        }
    }
    mem.swap(mut self, mut kept)
}

/// Removes the bytes `from..to` and returns them as a new string. Both ends must be character boundaries; the
/// string keeps its buffer and the text after `to` moves left.
///
/// ```
/// let mut s = String.from("hello")
/// let middle = s.drain(1, 3)
/// assert_eq(middle, String.from("el"))
/// assert_eq(s, String.from("hlo"))
/// ```
fn String.drain(mut self, from: usize, to: usize): String {
    if from > to || to > self.len() || !self.is_char_boundary(from) || !self.is_char_boundary(to) {
        panic("drain: the range is out of bounds or not on character boundaries")
    }
    let removed = String.from(self[from..to])
    self.replace_range(from, to, "")
    removed
}

/// Splits the string at byte index `at`, which must be a character boundary: the string keeps the text before it
/// and the returned string holds the rest.
///
/// ```
/// let mut s = String.from("hello")
/// let tail = s.split_off(2)
/// assert_eq(s, String.from("he"))
/// assert_eq(tail, String.from("llo"))
/// ```
fn String.split_off(mut self, at: usize): String {
    if at > self.len() || !self.is_char_boundary(at) {
        panic("split_off: the index is out of bounds or not a character boundary")
    }
    let out = String.from(self[at..self.len()])
    self.truncate(at)
    out
}

/// The strings of the list with `sep` between them: `["a", "b"].join(", ")` is `"a, b"`.
///
/// ```
/// let mut parts = List<String>.new()
/// parts.push(String.from("a"))
/// parts.push(String.from("b"))
/// assert_eq(parts.join(", "), String.from("a, b"))
/// ```
fn List<String>.join(self, sep: str): String {
    if self.len() == 0 {
        return String.new()
    }
    let mut cap: usize = sep.len() * (self.len() - 1)
    for part in self {
        cap = cap + part.len()
    }
    let mut out = String.with_capacity(cap)
    let mut first = true
    for part in self {
        if !first {
            out.push_str(sep)
        }
        out.push_str(part.as_str())
        first = false
    }
    out
}

// ---- Bytes, searching, and checked slicing (issue #713) ----

/// The UTF-8 bytes of the text; each byte is a `u8`. `bytes` is the iterator spelling of `as_bytes`.
///
/// ```
/// assert_eq("AB".bytes()[1], 66)
/// ```
fn str.bytes(self): [u8] {
    self.as_bytes()
}

/// The bytes as an owned list; the string is consumed.
///
/// ```
/// let bytes = String.from("AB").into_bytes()
/// assert_eq(bytes[0], 65)
/// assert_eq(bytes.len(), 2)
/// ```
fn String.into_bytes(own self): List<u8> {
    let mut out = List<u8>.with_capacity(self.len())
    out.extend_from_slice(self.as_bytes())
    out
}

/// Whether `needle` occurs in the text: the same as `contains`, under the name that says the needle is text.
///
/// ```
/// assert("hello".contains_str("ell"))
/// ```
fn str.contains_str(self, needle: str): bool {
    self.contains(needle)
}

/// The byte offset of the last occurrence of `c`, or `None`.
///
/// ```
/// assert_eq("abcabc".rfind('b'), Option.Some(4))
/// ```
fn str.rfind(self, c: char): Option<usize> {
    let (pat, pat_len) = encode_char_utf8(c)
    rindex_of_bytes(self.as_bytes(), pat[0..4], pat_len, 0, self.len())
}

/// The byte offset of the last occurrence of `needle`, or `None`. The empty needle matches at the end.
///
/// ```
/// assert_eq("abcabc".rfind_str("bc"), Option.Some(4))
/// ```
fn str.rfind_str(self, needle: str): Option<usize> {
    if needle.len() == 0 {
        return Option.Some(self.len())
    }
    rindex_of(self, needle, self.len())
}

/// Every non-overlapping occurrence of `needle`, in order, as a lazy iterator of `(byte_offset, matched_str)` pairs.
/// An empty needle panics (as `split` and `replace` do), because every position would match.
///
/// ```
/// assert_eq("abcabc".match_indices("bc").count(), 2)
/// ```
fn str.match_indices(self, needle: str): MatchIndices<str> {
    if needle.len() == 0 {
        panic("match_indices: the pattern is empty")
    }
    MatchIndices { text: self, needle: needle, pos: 0 }
}

/// The same as `match_indices`: every occurrence, with its byte offset, as a lazy iterator.
///
/// ```
/// let mut hits = "abcabc".find_all("bc")
/// assert_eq(hits.next().unwrap().0, 1)
/// assert_eq(hits.next().unwrap().0, 4)
/// ```
fn str.find_all(self, needle: str): MatchIndices<str> {
    self.match_indices(needle)
}

/// The bytes `from..to` as a view, or `None` when the range is reversed, past the end, or either end splits a
/// character. It is `s[from..to]` without the panic (`spec/stdlib.md`, "Slicing and character boundaries").
///
/// ```
/// assert("hello".get(1, 3).unwrap() == "el")
/// assert("hello".get(1, 9).is_none())
/// ```
fn str.get(self, from: usize, to: usize): Option<str> {
    if from > to || to > self.len() {
        return Option.None
    }
    if !self.is_char_boundary(from) || !self.is_char_boundary(to) {
        return Option.None
    }
    Option.Some(self[from..to])
}

/// Appends every `char` `iter` yields: `text.extend_iter(other.chars())`.
///
/// ```
/// let mut s = String.from("ab")
/// s.extend_iter(['c', 'd'].into_iter())
/// assert_eq(s, String.from("abcd"))
/// ```
fn String.extend_iter<I: Iterator<char>>(mut self, own iter: I) {
    let mut iter = iter
    loop {
        match iter.next() {
            Option.Some(c) => self.push(c),
            Option.None => break,
        }
    }
}
