// Text helpers for `str` and `String` (spec/stdlib.md).
//
// They are extension methods (spec/extensions.md), so the prelude makes them visible everywhere and the compiler's own
// methods (`len`, `find`, `starts_with`, ...) win. Offsets are byte offsets, and every function keeps UTF-8 intact: a
// match of a valid separator in valid text always starts and ends on a character boundary, and `trim` walks whole
// characters. The pieces a function returns are `String`s, because a `List` cannot hold views.

use iter.Iterator
use mem
use unicode.{is_whitespace, len_utf8}

/// The byte offset of the first occurrence of `needle` in `text` at or after `from`, or `text.len()` when there is none.
priv fn __index_of(text: str, needle: str, from: usize): usize {
    let n = needle.len()
    let mut i = from
    while i + n <= text.len() {
        if text[i..i + n] == needle {
            return i
        }
        i = i + 1
    }
    text.len()
}

/// A copy of `text[from..to]`.
priv fn __copy(text: str, from: usize, to: usize): String {
    String.from(text[from..to])
}

/// The pieces of `text` between occurrences of `sep`, in order.
priv fn __split(text: str, sep: str): List<String> {
    if sep.len() == 0 {
        panic("split: the separator is empty")
    }
    let mut out = List<String>.new()
    let mut start: usize = 0
    loop {
        let at = __index_of(text, sep, start)
        if at >= text.len() {
            break
        }
        out.push(__copy(text, start, at))
        start = at + sep.len()
    }
    out.push(__copy(text, start, text.len()))
    out
}

/// A string holding the one character `c`.
priv fn __one(c: char): String {
    let mut s = String.new()
    s.push(c)
    s
}

/// The strings of `parts` in the opposite order.
priv fn __reverse_strings(own parts: List<String>): List<String> {
    let mut parts = parts
    let mut out = List<String>.new()
    loop {
        match parts.pop() {
            Some(x) => out.push(x),
            None => break,
        }
    }
    out
}

// ---- str ----

/// Whether the text has no bytes.
fn str.is_empty(self): bool {
    self.len() == 0
}

/// Whether `needle` occurs in the text. The empty string occurs everywhere.
fn str.contains(self, needle: str): bool {
    needle.len() == 0 || __index_of(self, needle, 0) < self.len()
}

/// Whether the text ends with `suffix`.
fn str.ends_with(self, suffix: str): bool {
    suffix.len() <= self.len() && self[self.len() - suffix.len()..self.len()] == suffix
}

/// The text without leading and trailing white space (`char.is_whitespace`).
fn str.trim(self): str {
    let mut start: usize = 0
    let mut end: usize = 0
    let mut at: usize = 0
    let mut seen = false
    for c in self.chars() {
        let next = at + c.len_utf8()
        if !c.is_whitespace() {
            if !seen {
                start = at
                seen = true
            }
            end = next
        }
        at = next
    }
    self[start..end]
}

/// The text without leading white space.
fn str.trim_start(self): str {
    let mut at: usize = 0
    for c in self.chars() {
        if !c.is_whitespace() {
            return self[at..self.len()]
        }
        at = at + c.len_utf8()
    }
    self[self.len()..self.len()]
}

/// The text without trailing white space.
fn str.trim_end(self): str {
    let mut end: usize = 0
    let mut at: usize = 0
    for c in self.chars() {
        at = at + c.len_utf8()
        if !c.is_whitespace() {
            end = at
        }
    }
    self[0..end]
}

/// The pieces between occurrences of `sep`, in order: `"a,b,,c".split(",")` is `["a", "b", "", "c"]`. An empty `sep`
/// panics.
fn str.split(self, sep: str): List<String> {
    __split(self, sep)
}

/// The pieces between occurrences of the character `c`, in order.
fn str.split_char(self, c: char): List<String> {
    __split(self, __one(c).as_str())
}

/// The pieces between occurrences of `sep`, last piece first.
fn str.rsplit(self, sep: str): List<String> {
    __reverse_strings(__split(self, sep))
}

/// The pieces between occurrences of the character `c`, last piece first.
fn str.rsplit_char(self, c: char): List<String> {
    __reverse_strings(__split(self, __one(c).as_str()))
}

/// The runs of non-white-space characters, in order.
fn str.split_whitespace(self): List<String> {
    let mut out = List<String>.new()
    let mut word = String.new()
    for c in self.chars() {
        if c.is_whitespace() {
            if word.len() > 0 {
                out.push(word)
                word = String.new()
            }
        } else {
            word.push(c)
        }
    }
    if word.len() > 0 {
        out.push(word)
    }
    out
}

/// The lines of the text, split at a line feed, with a carriage return before it removed. A final line break does not
/// start a new line.
fn str.lines(self): List<String> {
    let mut out = List<String>.new()
    let mut start: usize = 0
    let mut i: usize = 0
    while i < self.len() {
        if self[i..i + 1] == "\n" {
            let mut end = i
            if end > start && self[end - 1..end] == "\r" {
                end = end - 1
            }
            out.push(__copy(self, start, end))
            start = i + 1
        }
        i = i + 1
    }
    if start < self.len() {
        out.push(__copy(self, start, self.len()))
    }
    out
}

/// A copy with every occurrence of `from` replaced by `to`. An empty `from` panics.
fn str.replace(self, from: str, to: str): String {
    if from.len() == 0 {
        panic("replace: the pattern is empty")
    }
    let mut out = String.new()
    let mut start: usize = 0
    loop {
        let at = __index_of(self, from, start)
        if at >= self.len() {
            break
        }
        out.push_str(self[start..at])
        out.push_str(to)
        start = at + from.len()
    }
    out.push_str(self[start..self.len()])
    out
}

/// The text after `prefix`, or `None` when it does not start with `prefix`. The result is a view of the text
/// (`spec/stdlib.md`, "String bytes and UTF-8 validation").
fn str.strip_prefix(self, prefix: str): Option<str> {
    if self.starts_with(prefix) {
        return Some(self[prefix.len()..self.len()])
    }
    None
}

/// The text before `suffix`, or `None` when it does not end with `suffix`; a view of the text.
fn str.strip_suffix(self, suffix: str): Option<str> {
    if self.ends_with(suffix) {
        return Some(self[0..self.len() - suffix.len()])
    }
    None
}

/// The text `count` times in a row.
fn str.repeat(self, count: usize): String {
    let mut out = String.new()
    let mut i: usize = 0
    while i < count {
        out.push_str(self)
        i = i + 1
    }
    out
}

// ---- String ----

/// Whether the string has no bytes.
fn String.is_empty(self): bool {
    self.len() == 0
}

/// Whether `needle` occurs in the string.
fn String.contains(self, needle: str): bool {
    self.as_str().contains(needle)
}

/// Whether the string ends with `suffix`.
fn String.ends_with(self, suffix: str): bool {
    self.as_str().ends_with(suffix)
}

/// The string without leading and trailing white space.
fn String.trim(self): str {
    self.as_str().trim()
}

/// The string without leading white space.
fn String.trim_start(self): str {
    self.as_str().trim_start()
}

/// The string without trailing white space.
fn String.trim_end(self): str {
    self.as_str().trim_end()
}

/// The pieces between occurrences of `sep`, in order.
fn String.split(self, sep: str): List<String> {
    __split(self.as_str(), sep)
}

/// The pieces between occurrences of the character `c`, in order.
fn String.split_char(self, c: char): List<String> {
    __split(self.as_str(), __one(c).as_str())
}

/// The pieces between occurrences of `sep`, last piece first.
fn String.rsplit(self, sep: str): List<String> {
    __reverse_strings(__split(self.as_str(), sep))
}

/// The pieces between occurrences of the character `c`, last piece first.
fn String.rsplit_char(self, c: char): List<String> {
    __reverse_strings(__split(self.as_str(), __one(c).as_str()))
}

/// The runs of non-white-space characters, in order.
fn String.split_whitespace(self): List<String> {
    self.as_str().split_whitespace()
}

/// The lines of the string.
fn String.lines(self): List<String> {
    self.as_str().lines()
}

/// A copy with every occurrence of `from` replaced by `to`.
fn String.replace(self, from: str, to: str): String {
    self.as_str().replace(from, to)
}

/// The string after `prefix`, or `None`; a view of the string.
fn String.strip_prefix(self, prefix: str): Option<str> {
    self.as_str().strip_prefix(prefix)
}

/// The string before `suffix`, or `None`; a view of the string.
fn String.strip_suffix(self, suffix: str): Option<str> {
    self.as_str().strip_suffix(suffix)
}

/// The string `count` times in a row.
fn String.repeat(self, count: usize): String {
    self.as_str().repeat(count)
}

// ---- Characters of a text ----
//
// The scope of Unicode support is the scalar value: these helpers count, index, and rebuild text by `char`. They do
// not normalize and they do not group characters into grapheme clusters, so `é` written as `e` plus a combining
// accent is two characters.

/// The number of characters (Unicode scalar values) in the text; `len` counts bytes.
fn str.char_count(self): usize {
    let mut n: usize = 0
    for c in self.chars() {
        n = n + 1
    }
    n
}

/// Whether byte offset `i` is the start of a character or the end of the text.
fn str.is_char_boundary(self, i: usize): bool {
    let mut at: usize = 0
    for c in self.chars() {
        if at == i {
            return true
        }
        at = at + c.len_utf8()
    }
    at == i
}

/// The `n`th character (counting from 0), or `None` when the text is shorter.
fn str.nth_char(self, n: usize): Option<char> {
    let mut i: usize = 0
    for c in self.chars() {
        if i == n {
            return Some(c)
        }
        i = i + 1
    }
    None
}

/// The characters as a list.
fn str.to_char_list(self): List<char> {
    let mut out = List<char>.new()
    for c in self.chars() {
        out.push(c)
    }
    out
}

/// Each character with the byte offset where it starts.
fn str.char_indices(self): List<(usize, char)> {
    let mut out = List<(usize, char)>.new()
    let mut at: usize = 0
    for c in self.chars() {
        out.push((at, c))
        at = at + c.len_utf8()
    }
    out
}

/// A copy with the characters in the opposite order.
fn str.reverse_chars(self): String {
    let mut chars = self.to_char_list()
    let mut out = String.new()
    loop {
        match chars.pop() {
            Some(c) => out.push(c),
            None => break,
        }
    }
    out
}

/// The characters from index `start` up to (not including) `end`, counting characters, not bytes. An index past the
/// end stops at the end.
fn str.slice_chars(self, start: usize, end: usize): String {
    let mut out = String.new()
    let mut i: usize = 0
    for c in self.chars() {
        if i >= end {
            break
        }
        if i >= start {
            out.push(c)
        }
        i = i + 1
    }
    out
}

/// The characters of the list as a string.
fn List<char>.collect_string(self): String {
    let mut out = String.new()
    for c in self {
        out.push(c)
    }
    out
}

/// The number of characters in the string.
fn String.char_count(self): usize {
    self.as_str().char_count()
}

/// Whether byte offset `i` is the start of a character or the end of the string.
fn String.is_char_boundary(self, i: usize): bool {
    self.as_str().is_char_boundary(i)
}

/// The `n`th character, or `None`.
fn String.nth_char(self, n: usize): Option<char> {
    self.as_str().nth_char(n)
}

/// The characters as a list.
fn String.to_char_list(self): List<char> {
    self.as_str().to_char_list()
}

/// Each character with the byte offset where it starts.
fn String.char_indices(self): List<(usize, char)> {
    self.as_str().char_indices()
}

/// A copy with the characters in the opposite order.
fn String.reverse_chars(self): String {
    self.as_str().reverse_chars()
}

/// The characters from index `start` up to `end`.
fn String.slice_chars(self, start: usize, end: usize): String {
    self.as_str().slice_chars(start, end)
}

// ---- join ----

// ---- Capacity and editing (issue #714) ----
//
// `capacity`, `reserve`, `shrink_to_fit`, `insert_str`, `replace_range`, and `String.with_capacity` are provided by
// the compiler; the other operations are written here on top of them. Every byte index is a character boundary, and
// an index that is out of range or splits a character panics with the message of the operation.

/// Makes the string empty and keeps its buffer.
fn String.clear(mut self) {
    self.truncate(0)
}

/// Shortens the string to `len` bytes, which must be a character boundary. A longer length panics.
fn String.truncate(mut self, len: usize) {
    let end = self.len()
    self.replace_range(len, end, "")
}

/// Removes and returns the last character, or `None` when the string is empty.
fn String.pop(mut self): Option<char> {
    let pairs = self.char_indices()
    if pairs.len() == 0 {
        return None
    }
    let last = pairs[pairs.len() - 1]
    self.truncate(last.0)
    Some(last.1)
}

/// Inserts the character `c` at byte index `at`, which must be a character boundary. A later byte moves right by
/// the character's UTF-8 length.
fn String.insert(mut self, at: usize, c: char) {
    self.insert_str(at, __one(c).as_str())
}

/// Removes and returns the character that starts at byte index `at`.
fn String.remove(mut self, at: usize): char {
    for pair in self.char_indices() {
        let (offset, c) = pair
        if offset == at {
            self.replace_range(at, at + c.len_utf8(), "")
            return c
        }
    }
    panic("remove: the index is out of bounds or not a character boundary")
}

/// Keeps the characters `f` accepts, in order, and drops the others.
fn String.retain<F: FnMut(char): bool>(mut self, own f: F) {
    let mut f = f
    let mut kept = String.new()
    for c in self.chars() {
        if f(c) {
            kept.push(c)
        }
    }
    mem.swap(mut self, mut kept)
}

/// Removes the bytes `from..to` and returns them as a new string. Both ends must be character boundaries; the
/// string keeps its buffer and the text after `to` moves left.
fn String.drain(mut self, from: usize, to: usize): String {
    if from > to || to > self.len() || !self.is_char_boundary(from) || !self.is_char_boundary(to) {
        panic("drain: the range is out of bounds or not on character boundaries")
    }
    let removed = String.from(self[from..to])
    self.replace_range(from, to, "")
    removed
}

/// Splits the string at byte index `at`, which must be a character boundary: the string keeps the text before it
/// and the returned string holds the rest.
fn String.split_off(mut self, at: usize): String {
    if at > self.len() || !self.is_char_boundary(at) {
        panic("split_off: the index is out of bounds or not a character boundary")
    }
    let out = String.from(self[at..self.len()])
    self.truncate(at)
    out
}

/// The strings of the list with `sep` between them: `["a", "b"].join(", ")` is `"a, b"`.
fn List<String>.join(self, sep: str): String {
    let mut out = String.new()
    let mut first = true
    for part in self {
        if !first {
            out.push_str(sep)
        }
        out.push_str(part.as_str())
        first = false
    }
    out
}

// ---- Bytes, searching, and checked slicing (issue #713) ----

/// The UTF-8 bytes of the text; each byte is a `u8`. `bytes` is the iterator spelling of `as_bytes`.
fn str.bytes(self): [u8] {
    self.as_bytes()
}

/// The UTF-8 bytes of the string.
fn String.bytes(self): [u8] {
    self.as_bytes()
}

/// The bytes as an owned list; the string is consumed.
fn String.into_bytes(own self): List<u8> {
    let mut out = List<u8>.new()
    for byte in self.as_bytes() {
        out.push(byte)
    }
    out
}

/// Whether `needle` occurs in the text: the same as `contains`, under the name that says the needle is text.
fn str.contains_str(self, needle: str): bool {
    self.contains(needle)
}

/// Whether `needle` occurs in the string.
fn String.contains_str(self, needle: str): bool {
    self.contains(needle)
}

/// The byte offset of the last occurrence of `c`, or `None`.
fn str.rfind(self, c: char): Option<usize> {
    let mut at: usize = 0
    let mut found: Option<usize> = None
    for current in self.chars() {
        if current == c {
            found = Some(at)
        }
        at = at + current.len_utf8()
    }
    found
}

/// The byte offset of the last occurrence of `c` in the string, or `None`.
fn String.rfind(self, c: char): Option<usize> {
    self.as_str().rfind(c)
}

/// The byte offset of the last occurrence of `needle`, or `None`. The empty needle matches at the end.
fn str.rfind_str(self, needle: str): Option<usize> {
    let n = needle.len()
    if n == 0 {
        return Some(self.len())
    }
    if n > self.len() {
        return None
    }
    let mut i = self.len() - n
    loop {
        if self[i..i + n] == needle {
            return Some(i)
        }
        if i == 0 {
            return None
        }
        i = i - 1
    }
}

/// The byte offset of the last occurrence of `needle` in the string, or `None`.
fn String.rfind_str(self, needle: str): Option<usize> {
    self.as_str().rfind_str(needle)
}

/// Every non-overlapping occurrence of `needle`, in order: its byte offset and the matched text. An empty needle
/// panics (as `split` and `replace` do), because every position would match.
fn str.match_indices(self, needle: str): List<(usize, String)> {
    if needle.len() == 0 {
        panic("match_indices: the pattern is empty")
    }
    let mut out = List<(usize, String)>.new()
    let mut start: usize = 0
    loop {
        let at = __index_of(self, needle, start)
        if at >= self.len() {
            break
        }
        out.push((at, String.from(self[at..at + needle.len()])))
        start = at + needle.len()
    }
    out
}

/// Every non-overlapping occurrence of `needle` in the string.
fn String.match_indices(self, needle: str): List<(usize, String)> {
    self.as_str().match_indices(needle)
}

/// The same as `match_indices`: every occurrence, with its byte offset.
fn str.find_all(self, needle: str): List<(usize, String)> {
    self.match_indices(needle)
}

/// Every occurrence of `needle` in the string.
fn String.find_all(self, needle: str): List<(usize, String)> {
    self.as_str().find_all(needle)
}

/// The bytes `from..to` as a view, or `None` when the range is reversed, past the end, or either end splits a
/// character. `s[a..b]` stays the unchecked byte slice (`spec/stdlib.md`).
fn str.get(self, from: usize, to: usize): Option<str> {
    if from > to || to > self.len() {
        return None
    }
    if !self.is_char_boundary(from) || !self.is_char_boundary(to) {
        return None
    }
    Some(self[from..to])
}

/// The bytes `from..to` of the string as a view, or `None` when the range is invalid or splits a character.
fn String.get(self, from: usize, to: usize): Option<str> {
    self.as_str().get(from, to)
}

/// Appends every `char` `iter` yields: `text.extend_iter(other.chars())`.
fn String.extend_iter<I: Iterator<char>>(mut self, own iter: I) {
    let mut iter = iter
    loop {
        match iter.next() {
            Some(c) => self.push(c),
            None => break,
        }
    }
}
