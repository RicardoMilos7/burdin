// Text helpers for `str` and `String` (spec/stdlib.md).
//
// They are extension methods (spec/extensions.md), so the prelude makes them visible everywhere and the compiler's own
// methods (`len`, `find`, `starts_with`, ...) win. Offsets are byte offsets, and every function keeps UTF-8 intact: a
// match of a valid separator in valid text always starts and ends on a character boundary, and `trim` walks whole
// characters. The pieces a function returns are `String`s, because a `List` cannot hold views.

use iter.{DoubleEndedIterator, Iterator}
use mem
use unicode.{is_whitespace, len_utf8}

/// Whether the bytes of `needle` are in `text` at byte offset `at`. The caller keeps `at + needle.len()` within the
/// text. It compares bytes rather than slices of the text: a slice that splits a character panics (`spec/stdlib.md`),
/// and a valid needle starts with a byte that does not continue a character, so a match starts on a boundary.
priv fn matches_at(text: str, at: usize, needle: str): bool {
    let hay = text.as_bytes()
    let pat = needle.as_bytes()
    let mut k: usize = 0
    while k < pat.len() {
        if hay[at + k] != pat[k] {
            return false
        }
        k = k + 1
    }
    true
}

/// The character that starts at byte `at` of `bytes` (valid UTF-8, with `at` on a character boundary) and the number
/// of bytes it takes.
priv fn decode_char(bytes: [u8], at: usize): (char, usize) {
    let b0 = bytes[at] as u32
    if b0 < 128 {
        return (b0 as char, 1)
    }
    if b0 < 224 {
        let c = ((b0 & 31) << 6) | ((bytes[at + 1] as u32) & 63)
        return (c as char, 2)
    }
    if b0 < 240 {
        let c = ((b0 & 15) << 12) | (((bytes[at + 1] as u32) & 63) << 6) | ((bytes[at + 2] as u32) & 63)
        return (c as char, 3)
    }
    let high = ((b0 & 7) << 18) | (((bytes[at + 1] as u32) & 63) << 12)
    let low = (((bytes[at + 2] as u32) & 63) << 6) | ((bytes[at + 3] as u32) & 63)
    ((high | low) as char, 4)
}

/// The lazy iterator of `chars()`: the text it reads and the byte range `front..back` not yet yielded. It decodes one
/// character per `next` or `next_back` and allocates nothing. `S` is the text it reads, so a `Chars<str>` holds a view
/// and is second-class like any view (`spec/memory-rules.md`, SC2): a local, a parameter, a return value, or a
/// temporary, never a field of a user struct, and the text stays borrowed until the iterator's last use.
///
/// ```
/// let mut it = "añ".chars()
/// assert_eq(it.next(), Option.Some('a'))
/// assert_eq(it.next(), Option.Some('ñ'))
/// assert_eq(it.next(), Option.None)
/// ```
struct Chars<S>: Clone {
    priv text: S
    priv front: usize
    priv back: usize
}

Chars<str>: Iterator<char> {
    /// The next character from the front, or `None` once the front meets the back.
    ///
    /// ```
    /// let mut it = "😀".chars()
    /// assert_eq(it.next(), Option.Some('😀'))
    /// assert_eq(it.next(), Option.None)
    /// ```
    fn next(mut self): Option<char> {
        if self.front >= self.back {
            return Option.None
        }
        let (c, width) = decode_char(self.text.as_bytes(), self.front)
        self.front = self.front + width
        Option.Some(c)
    }
}

Chars<str>: DoubleEndedIterator<char> {
    /// The next character from the back: it steps back over the continuation bytes (`10xxxxxx`) to the byte that
    /// starts the last character, and decodes forward from there.
    ///
    /// ```
    /// let mut it = "añ".chars()
    /// assert_eq(it.next_back(), Option.Some('ñ'))
    /// assert_eq(it.next_back(), Option.Some('a'))
    /// assert_eq(it.next_back(), Option.None)
    /// ```
    fn next_back(mut self): Option<char> {
        if self.front >= self.back {
            return Option.None
        }
        let bytes = self.text.as_bytes()
        let mut at = self.back - 1
        while at > self.front && (bytes[at] & 192) == 128 {
            at = at - 1
        }
        let (c, _) = decode_char(bytes, at)
        self.back = at
        Option.Some(c)
    }
}

/// The characters (Unicode scalar values) of the text, in order, as a lazy iterator. It decodes one character at a
/// time and allocates nothing; `to_list()` (or `to_char_list()`) builds a list when one is needed. The iterator
/// borrows the text (a view, second-class), so the text cannot change while it is live.
///
/// ```
/// let mut count = 0
/// for c in "añ😀".chars() {
///     count = count + 1
/// }
/// assert_eq(count, 3)
/// assert_eq("añ".chars().rev().to_list()[0], 'ñ')
/// ```
fn str.chars(self): Chars<str> {
    Chars { text: self, front: 0, back: self.len() }
}

/// The characters of the string, in order, as a lazy iterator that borrows the string (see `str.chars`).
///
/// ```
/// assert_eq(String.from("añ").chars().count(), 2)
/// ```
fn String.chars(self): Chars<str> {
    self.as_str().chars()
}

/// The byte offset of the first occurrence of `needle` in `text` at or after `from`, or `text.len()` when there is none.
priv fn index_of(text: str, needle: str, from: usize): usize {
    let n = needle.len()
    let mut i = from
    while i + n <= text.len() {
        if matches_at(text, i, needle) {
            return i
        }
        i = i + 1
    }
    text.len()
}

/// A copy of `text[from..to]`.
priv fn copy_text(text: str, from: usize, to: usize): String {
    String.from(text[from..to])
}

/// The text of `a` followed by the text of `b`, in a new string: the built-in `String + str` (`spec/operators.md`,
/// OP14). Both operands are borrowed.
priv fn concat(a: str, b: str): String {
    let mut out = String.with_capacity(a.len() + b.len())
    out.push_str(a)
    out.push_str(b)
    out
}

/// The pieces of `text` between occurrences of `sep`, in order.
priv fn split_text(text: str, sep: str): List<String> {
    if sep.len() == 0 {
        panic("split: the separator is empty")
    }
    let mut out = List<String>.new()
    let mut start: usize = 0
    loop {
        let at = index_of(text, sep, start)
        if at >= text.len() {
            break
        }
        out.push(copy_text(text, start, at))
        start = at + sep.len()
    }
    out.push(copy_text(text, start, text.len()))
    out
}

/// A string holding the one character `c`.
priv fn one(c: char): String {
    let mut s = String.new()
    s.push(c)
    s
}

/// The strings of `parts` in the opposite order.
priv fn reverse_strings(own parts: List<String>): List<String> {
    let mut parts = parts
    let mut out = List<String>.new()
    loop {
        match parts.pop() {
            Option.Some(x) => out.push(x),
            Option.None => break,
        }
    }
    out
}

// ---- str ----

/// Whether the text has no bytes.
///
/// ```
/// assert("".is_empty())
/// assert(!"x".is_empty())
/// ```
fn str.is_empty(self): bool {
    self.len() == 0
}

/// Whether `needle` occurs in the text. The empty string occurs everywhere.
///
/// ```
/// assert("hello".contains("ell"))
/// ```
fn str.contains(self, needle: str): bool {
    needle.len() == 0 || index_of(self, needle, 0) < self.len()
}

/// Whether the text ends with `suffix`.
///
/// ```
/// assert("file.bd".ends_with(".bd"))
/// ```
fn str.ends_with(self, suffix: str): bool {
    suffix.len() <= self.len() && matches_at(self, self.len() - suffix.len(), suffix)
}

/// The text without leading and trailing white space (`char.is_whitespace`).
///
/// ```
/// assert_eq("  hi  ".trim(), "hi")
/// ```
fn str.trim(self): str {
    let mut start: usize = 0
    let mut end: usize = 0
    let mut at: usize = 0
    let mut seen = false
    for c in self.chars() {
        let next = at + c.len_utf8()
        if !c.is_whitespace() {
            if !seen {
                start = at
                seen = true
            }
            end = next
        }
        at = next
    }
    self[start..end]
}

/// The text without leading white space.
///
/// ```
/// assert_eq("  hi".trim_start(), "hi")
/// ```
fn str.trim_start(self): str {
    let mut at: usize = 0
    for c in self.chars() {
        if !c.is_whitespace() {
            return self[at..self.len()]
        }
        at = at + c.len_utf8()
    }
    self[self.len()..self.len()]
}

/// The text without trailing white space.
///
/// ```
/// assert_eq("hi  ".trim_end(), "hi")
/// ```
fn str.trim_end(self): str {
    let mut end: usize = 0
    let mut at: usize = 0
    for c in self.chars() {
        at = at + c.len_utf8()
        if !c.is_whitespace() {
            end = at
        }
    }
    self[0..end]
}

/// The pieces between occurrences of `sep`, in order: `"a,b,,c".split(",")` is `["a", "b", "", "c"]`. An empty `sep`
/// panics.
///
/// ```
/// assert_eq("a::b".split("::")[1], String.from("b"))
/// ```
fn str.split(self, sep: str): List<String> {
    split_text(self, sep)
}

/// The pieces between occurrences of the character `c`, in order.
///
/// ```
/// assert_eq("a,b".split_char(',').len(), 2)
/// ```
fn str.split_char(self, c: char): List<String> {
    split_text(self, one(c).as_str())
}

/// The pieces between occurrences of `sep`, last piece first.
///
/// ```
/// assert_eq("a::b::c".rsplit("::")[0], String.from("c"))
/// ```
fn str.rsplit(self, sep: str): List<String> {
    reverse_strings(split_text(self, sep))
}

/// The pieces between occurrences of the character `c`, last piece first.
///
/// ```
/// assert_eq("a,b,c".rsplit_char(',')[0], String.from("c"))
/// ```
fn str.rsplit_char(self, c: char): List<String> {
    reverse_strings(split_text(self, one(c).as_str()))
}

/// The runs of non-white-space characters, in order.
///
/// ```
/// assert_eq(" a  b ".split_whitespace().len(), 2)
/// ```
fn str.split_whitespace(self): List<String> {
    let mut out = List<String>.new()
    let mut word = String.new()
    for c in self.chars() {
        if c.is_whitespace() {
            if word.len() > 0 {
                out.push(word)
                word = String.new()
            }
        } else {
            word.push(c)
        }
    }
    if word.len() > 0 {
        out.push(word)
    }
    out
}

/// The lines of the text, split at a line feed, with a carriage return before it removed. A final line break does not
/// start a new line.
///
/// ```
/// assert_eq("a\nb".lines().len(), 2)
/// ```
fn str.lines(self): List<String> {
    let mut out = List<String>.new()
    let bytes = self.as_bytes()
    let mut start: usize = 0
    let mut i: usize = 0
    while i < bytes.len() {
        if bytes[i] == 10 {
            let mut end = i
            if end > start && bytes[end - 1] == 13 {
                end = end - 1
            }
            out.push(copy_text(self, start, end))
            start = i + 1
        }
        i = i + 1
    }
    if start < self.len() {
        out.push(copy_text(self, start, self.len()))
    }
    out
}

/// A copy with every occurrence of `from` replaced by `to`. An empty `from` panics.
///
/// ```
/// assert_eq("a-b-c".replace("-", "+"), String.from("a+b+c"))
/// ```
fn str.replace(self, from: str, to: str): String {
    if from.len() == 0 {
        panic("replace: the pattern is empty")
    }
    let mut out = String.new()
    let mut start: usize = 0
    loop {
        let at = index_of(self, from, start)
        if at >= self.len() {
            break
        }
        out.push_str(self[start..at])
        out.push_str(to)
        start = at + from.len()
    }
    out.push_str(self[start..self.len()])
    out
}

/// The text after `prefix`, or `None` when it does not start with `prefix`. The result is a view of the text
/// (`spec/stdlib.md`, "String bytes and UTF-8 validation").
///
/// ```
/// assert("file.bd".strip_prefix("file").unwrap() == ".bd")
/// ```
fn str.strip_prefix(self, prefix: str): Option<str> {
    if self.starts_with(prefix) {
        return Option.Some(self[prefix.len()..self.len()])
    }
    Option.None
}

/// The text before `suffix`, or `None` when it does not end with `suffix`; a view of the text.
///
/// ```
/// assert("file.bd".strip_suffix(".bd").unwrap() == "file")
/// ```
fn str.strip_suffix(self, suffix: str): Option<str> {
    if self.ends_with(suffix) {
        return Option.Some(self[0..self.len() - suffix.len()])
    }
    Option.None
}

/// The text `count` times in a row.
///
/// ```
/// assert_eq("ab".repeat(2), String.from("abab"))
/// ```
fn str.repeat(self, count: usize): String {
    let mut out = String.new()
    let mut i: usize = 0
    while i < count {
        out.push_str(self)
        i = i + 1
    }
    out
}

// ---- String ----

/// Whether the string has no bytes.
///
/// ```
/// assert(String.new().is_empty())
/// assert(!String.from("x").is_empty())
/// ```
fn String.is_empty(self): bool {
    self.len() == 0
}

/// Whether `needle` occurs in the string.
///
/// ```
/// assert(String.from("hello").contains("ell"))
/// ```
fn String.contains(self, needle: str): bool {
    self.as_str().contains(needle)
}

/// Whether the string ends with `suffix`.
///
/// ```
/// assert(String.from("file.bd").ends_with(".bd"))
/// ```
fn String.ends_with(self, suffix: str): bool {
    self.as_str().ends_with(suffix)
}

/// The string without leading and trailing white space.
///
/// ```
/// assert_eq(String.from("  hi  ").trim(), "hi")
/// ```
fn String.trim(self): str {
    self.as_str().trim()
}

/// The string without leading white space.
///
/// ```
/// assert_eq(String.from("  hi").trim_start(), "hi")
/// ```
fn String.trim_start(self): str {
    self.as_str().trim_start()
}

/// The string without trailing white space.
///
/// ```
/// assert_eq(String.from("hi  ").trim_end(), "hi")
/// ```
fn String.trim_end(self): str {
    self.as_str().trim_end()
}

/// The pieces between occurrences of `sep`, in order.
///
/// ```
/// let parts = String.from("a::b").split("::")
/// assert_eq(parts[1], String.from("b"))
/// ```
fn String.split(self, sep: str): List<String> {
    split_text(self.as_str(), sep)
}

/// The pieces between occurrences of the character `c`, in order.
///
/// ```
/// assert_eq(String.from("a,b").split_char(',').len(), 2)
/// ```
fn String.split_char(self, c: char): List<String> {
    split_text(self.as_str(), one(c).as_str())
}

/// The pieces between occurrences of `sep`, last piece first.
///
/// ```
/// let parts = String.from("a::b::c").rsplit("::")
/// assert_eq(parts[0], String.from("c"))
/// ```
fn String.rsplit(self, sep: str): List<String> {
    reverse_strings(split_text(self.as_str(), sep))
}

/// The pieces between occurrences of the character `c`, last piece first.
///
/// ```
/// let parts = String.from("a,b,c").rsplit_char(',')
/// assert_eq(parts[0], String.from("c"))
/// ```
fn String.rsplit_char(self, c: char): List<String> {
    reverse_strings(split_text(self.as_str(), one(c).as_str()))
}

/// The runs of non-white-space characters, in order.
///
/// ```
/// let words = String.from(" a  b ").split_whitespace()
/// assert_eq(words.len(), 2)
/// assert_eq(words[0], String.from("a"))
/// ```
fn String.split_whitespace(self): List<String> {
    self.as_str().split_whitespace()
}

/// The lines of the string.
///
/// ```
/// let lines = String.from("a\nb").lines()
/// assert_eq(lines.len(), 2)
/// assert_eq(lines[1], String.from("b"))
/// ```
fn String.lines(self): List<String> {
    self.as_str().lines()
}

/// A copy with every occurrence of `from` replaced by `to`.
///
/// ```
/// assert_eq(String.from("a-b-c").replace("-", "+"), String.from("a+b+c"))
/// ```
fn String.replace(self, from: str, to: str): String {
    self.as_str().replace(from, to)
}

/// The string after `prefix`, or `None`; a view of the string.
///
/// ```
/// assert(String.from("file.bd").strip_prefix("file").unwrap() == ".bd")
/// assert(String.from("file.bd").strip_prefix("x").is_none())
/// ```
fn String.strip_prefix(self, prefix: str): Option<str> {
    self.as_str().strip_prefix(prefix)
}

/// The string before `suffix`, or `None`; a view of the string.
///
/// ```
/// assert(String.from("file.bd").strip_suffix(".bd").unwrap() == "file")
/// assert(String.from("file.bd").strip_suffix(".rs").is_none())
/// ```
fn String.strip_suffix(self, suffix: str): Option<str> {
    self.as_str().strip_suffix(suffix)
}

/// The string `count` times in a row.
///
/// ```
/// assert_eq(String.from("ab").repeat(3), String.from("ababab"))
/// ```
fn String.repeat(self, count: usize): String {
    self.as_str().repeat(count)
}

// ---- Characters of a text ----
//
// The scope of Unicode support is the scalar value: these helpers count, index, and rebuild text by `char`. They do
// not normalize and they do not group characters into grapheme clusters, so `é` written as `e` plus a combining
// accent is two characters.

/// The number of characters (Unicode scalar values) in the text; `len` counts bytes.
///
/// ```
/// assert_eq("héllo".char_count(), 5)
/// ```
fn str.char_count(self): usize {
    let bytes = self.as_bytes()
    let mut n: usize = 0
    let mut at: usize = 0
    while at < bytes.len() {
        let (_, width) = decode_char(bytes, at)
        n = n + 1
        at = at + width
    }
    n
}

/// Whether byte offset `i` is the start of a character or the end of the text.
///
/// ```
/// assert("abc".is_char_boundary(1))
/// assert(!"é".is_char_boundary(1))
/// ```
fn str.is_char_boundary(self, i: usize): bool {
    let bytes = self.as_bytes()
    let mut at: usize = 0
    while at < bytes.len() {
        if at == i {
            return true
        }
        let (_, width) = decode_char(bytes, at)
        at = at + width
    }
    at == i
}

/// The `n`th character (counting from 0), or `None` when the text is shorter.
///
/// ```
/// assert_eq("abc".nth_char(1), Option.Some('b'))
/// ```
fn str.nth_char(self, n: usize): Option<char> {
    let bytes = self.as_bytes()
    let mut i: usize = 0
    let mut at: usize = 0
    while at < bytes.len() {
        let (c, width) = decode_char(bytes, at)
        if i == n {
            return Option.Some(c)
        }
        i = i + 1
        at = at + width
    }
    Option.None
}

/// The characters as a list.
///
/// ```
/// let chars = "ab".to_char_list()
/// assert_eq(chars[0], 'a')
/// ```
fn str.to_char_list(self): List<char> {
    let bytes = self.as_bytes()
    let n = bytes.len()
    let mut out = List<char>.with_capacity(n)
    let mut at: usize = 0
    while at < n {
        let (c, width) = decode_char(bytes, at)
        out.push(c)
        at = at + width
    }
    out
}

/// Each character with the byte offset where it starts.
///
/// ```
/// let pairs = "ab".char_indices()
/// assert_eq(pairs[1].0, 1)
/// assert_eq(pairs[1].1, 'b')
/// ```
fn str.char_indices(self): List<(usize, char)> {
    let bytes = self.as_bytes()
    let mut out = List<(usize, char)>.new()
    let mut at: usize = 0
    while at < bytes.len() {
        let (c, width) = decode_char(bytes, at)
        out.push((at, c))
        at = at + width
    }
    out
}

/// A copy with the characters in the opposite order.
///
/// ```
/// assert_eq("abc".reverse_chars(), String.from("cba"))
/// ```
fn str.reverse_chars(self): String {
    let mut chars = self.to_char_list()
    let mut out = String.new()
    loop {
        match chars.pop() {
            Option.Some(c) => out.push(c),
            Option.None => break,
        }
    }
    out
}

/// The characters from index `start` up to (not including) `end`, counting characters, not bytes. An index past the
/// end stops at the end.
///
/// ```
/// assert_eq("hello".slice_chars(1, 3), String.from("el"))
/// ```
fn str.slice_chars(self, start: usize, end: usize): String {
    let mut out = String.new()
    let mut i: usize = 0
    for c in self.chars() {
        if i >= end {
            break
        }
        if i >= start {
            out.push(c)
        }
        i = i + 1
    }
    out
}

/// The characters of the list as a string.
///
/// ```
/// let mut chars = List<char>.new()
/// chars.push('h')
/// chars.push('i')
/// assert_eq(chars.collect_string(), String.from("hi"))
/// ```
fn List<char>.collect_string(self): String {
    let mut out = String.new()
    for c in self {
        out.push(c)
    }
    out
}

/// The number of characters in the string.
///
/// ```
/// assert_eq(String.from("héllo").char_count(), 5)
/// ```
fn String.char_count(self): usize {
    self.as_str().char_count()
}

/// Whether byte offset `i` is the start of a character or the end of the string.
///
/// ```
/// assert(String.from("abc").is_char_boundary(1))
/// assert(!String.from("é").is_char_boundary(1))
/// ```
fn String.is_char_boundary(self, i: usize): bool {
    self.as_str().is_char_boundary(i)
}

/// The `n`th character, or `None`.
///
/// ```
/// assert_eq(String.from("abc").nth_char(1), Option.Some('b'))
/// assert(String.from("abc").nth_char(5).is_none())
/// ```
fn String.nth_char(self, n: usize): Option<char> {
    self.as_str().nth_char(n)
}

/// The characters as a list.
///
/// ```
/// let chars = String.from("ab").to_char_list()
/// assert_eq(chars[0], 'a')
/// assert_eq(chars.len(), 2)
/// ```
fn String.to_char_list(self): List<char> {
    self.as_str().to_char_list()
}

/// Each character with the byte offset where it starts.
///
/// ```
/// let pairs = String.from("ab").char_indices()
/// assert_eq(pairs[1].0, 1)
/// assert_eq(pairs[1].1, 'b')
/// ```
fn String.char_indices(self): List<(usize, char)> {
    self.as_str().char_indices()
}

/// A copy with the characters in the opposite order.
///
/// ```
/// assert_eq(String.from("abc").reverse_chars(), String.from("cba"))
/// ```
fn String.reverse_chars(self): String {
    self.as_str().reverse_chars()
}

/// The characters from index `start` up to `end`.
///
/// ```
/// assert_eq(String.from("hello").slice_chars(1, 3), String.from("el"))
/// ```
fn String.slice_chars(self, start: usize, end: usize): String {
    self.as_str().slice_chars(start, end)
}

// ---- join ----

// ---- Capacity and editing (issue #714) ----
//
// `capacity`, `reserve`, `shrink_to_fit`, `insert_str`, `replace_range`, and `String.with_capacity` are provided by
// the compiler; the other operations are written here on top of them. Every byte index is a character boundary, and
// an index that is out of range or splits a character panics with the message of the operation.

/// Makes the string empty and keeps its buffer.
///
/// ```
/// let mut s = String.from("x")
/// s.clear()
/// assert(s.is_empty())
/// ```
fn String.clear(mut self) {
    self.truncate(0)
}

/// Shortens the string to `len` bytes, which must be a character boundary. A longer length panics.
///
/// ```
/// let mut s = String.from("hello")
/// s.truncate(2)
/// assert_eq(s, String.from("he"))
/// ```
fn String.truncate(mut self, len: usize) {
    let end = self.len()
    self.replace_range(len, end, "")
}

/// Removes and returns the last character, or `None` when the string is empty.
///
/// ```
/// let mut s = String.from("ab")
/// assert_eq(s.pop(), Option.Some('b'))
/// assert_eq(s, String.from("a"))
/// ```
fn String.pop(mut self): Option<char> {
    let pairs = self.char_indices()
    if pairs.len() == 0 {
        return Option.None
    }
    let last = pairs[pairs.len() - 1]
    self.truncate(last.0)
    Option.Some(last.1)
}

/// Inserts the character `c` at byte index `at`, which must be a character boundary. A later byte moves right by
/// the character's UTF-8 length.
///
/// ```
/// let mut s = String.from("ac")
/// s.insert(1, 'b')
/// assert_eq(s, String.from("abc"))
/// ```
fn String.insert(mut self, at: usize, c: char) {
    self.insert_str(at, one(c).as_str())
}

/// Removes and returns the character that starts at byte index `at`.
///
/// ```
/// let mut s = String.from("abc")
/// assert_eq(s.remove(1), 'b')
/// assert_eq(s, String.from("ac"))
/// ```
fn String.remove(mut self, at: usize): char {
    for pair in self.char_indices() {
        let (offset, c) = pair
        if offset == at {
            self.replace_range(at, at + c.len_utf8(), "")
            return c
        }
    }
    panic("remove: the index is out of bounds or not a character boundary")
}

/// Keeps the characters `f` accepts, in order, and drops the others.
///
/// ```
/// let mut s = String.from("a1b2")
/// s.retain(|c| c != '1')
/// assert_eq(s, String.from("ab2"))
/// ```
fn String.retain<F: FnMut(char): bool>(mut self, own f: F) {
    let mut f = f
    let mut kept = String.new()
    for c in self.chars() {
        if f(c) {
            kept.push(c)
        }
    }
    mem.swap(mut self, mut kept)
}

/// Removes the bytes `from..to` and returns them as a new string. Both ends must be character boundaries; the
/// string keeps its buffer and the text after `to` moves left.
///
/// ```
/// let mut s = String.from("hello")
/// let middle = s.drain(1, 3)
/// assert_eq(middle, String.from("el"))
/// assert_eq(s, String.from("hlo"))
/// ```
fn String.drain(mut self, from: usize, to: usize): String {
    if from > to || to > self.len() || !self.is_char_boundary(from) || !self.is_char_boundary(to) {
        panic("drain: the range is out of bounds or not on character boundaries")
    }
    let removed = String.from(self[from..to])
    self.replace_range(from, to, "")
    removed
}

/// Splits the string at byte index `at`, which must be a character boundary: the string keeps the text before it
/// and the returned string holds the rest.
///
/// ```
/// let mut s = String.from("hello")
/// let tail = s.split_off(2)
/// assert_eq(s, String.from("he"))
/// assert_eq(tail, String.from("llo"))
/// ```
fn String.split_off(mut self, at: usize): String {
    if at > self.len() || !self.is_char_boundary(at) {
        panic("split_off: the index is out of bounds or not a character boundary")
    }
    let out = String.from(self[at..self.len()])
    self.truncate(at)
    out
}

/// The strings of the list with `sep` between them: `["a", "b"].join(", ")` is `"a, b"`.
///
/// ```
/// let mut parts = List<String>.new()
/// parts.push(String.from("a"))
/// parts.push(String.from("b"))
/// assert_eq(parts.join(", "), String.from("a, b"))
/// ```
fn List<String>.join(self, sep: str): String {
    let mut out = String.new()
    let mut first = true
    for part in self {
        if !first {
            out.push_str(sep)
        }
        out.push_str(part.as_str())
        first = false
    }
    out
}

// ---- Bytes, searching, and checked slicing (issue #713) ----

/// The UTF-8 bytes of the text; each byte is a `u8`. `bytes` is the iterator spelling of `as_bytes`.
///
/// ```
/// assert_eq("AB".bytes()[1], 66)
/// ```
fn str.bytes(self): [u8] {
    self.as_bytes()
}

/// The UTF-8 bytes of the string.
///
/// ```
/// let s = String.from("AB")
/// assert_eq(s.bytes().len(), 2)
/// assert_eq(s.bytes()[1], 66)
/// ```
fn String.bytes(self): [u8] {
    self.as_bytes()
}

/// The bytes as an owned list; the string is consumed.
///
/// ```
/// let bytes = String.from("AB").into_bytes()
/// assert_eq(bytes[0], 65)
/// assert_eq(bytes.len(), 2)
/// ```
fn String.into_bytes(own self): List<u8> {
    let mut out = List<u8>.new()
    for byte in self.as_bytes() {
        out.push(byte)
    }
    out
}

/// Whether `needle` occurs in the text: the same as `contains`, under the name that says the needle is text.
///
/// ```
/// assert("hello".contains_str("ell"))
/// ```
fn str.contains_str(self, needle: str): bool {
    self.contains(needle)
}

/// Whether `needle` occurs in the string.
///
/// ```
/// assert(String.from("hello").contains_str("ell"))
/// ```
fn String.contains_str(self, needle: str): bool {
    self.contains(needle)
}

/// The byte offset of the last occurrence of `c`, or `None`.
///
/// ```
/// assert_eq("abcabc".rfind('b'), Option.Some(4))
/// ```
fn str.rfind(self, c: char): Option<usize> {
    let mut at: usize = 0
    let mut found: Option<usize> = Option.None
    for current in self.chars() {
        if current == c {
            found = Option.Some(at)
        }
        at = at + current.len_utf8()
    }
    found
}

/// The byte offset of the last occurrence of `c` in the string, or `None`.
///
/// ```
/// assert_eq(String.from("abcabc").rfind('b'), Option.Some(4))
/// ```
fn String.rfind(self, c: char): Option<usize> {
    self.as_str().rfind(c)
}

/// The byte offset of the last occurrence of `needle`, or `None`. The empty needle matches at the end.
///
/// ```
/// assert_eq("abcabc".rfind_str("bc"), Option.Some(4))
/// ```
fn str.rfind_str(self, needle: str): Option<usize> {
    let n = needle.len()
    if n == 0 {
        return Option.Some(self.len())
    }
    if n > self.len() {
        return Option.None
    }
    let mut i = self.len() - n
    loop {
        if matches_at(self, i, needle) {
            return Option.Some(i)
        }
        if i == 0 {
            return Option.None
        }
        i = i - 1
    }
}

/// The byte offset of the last occurrence of `needle` in the string, or `None`.
///
/// ```
/// assert_eq(String.from("abcabc").rfind_str("bc"), Option.Some(4))
/// ```
fn String.rfind_str(self, needle: str): Option<usize> {
    self.as_str().rfind_str(needle)
}

/// Every non-overlapping occurrence of `needle`, in order: its byte offset and the matched text. An empty needle
/// panics (as `split` and `replace` do), because every position would match.
///
/// ```
/// assert_eq("abcabc".match_indices("bc").len(), 2)
/// ```
fn str.match_indices(self, needle: str): List<(usize, String)> {
    if needle.len() == 0 {
        panic("match_indices: the pattern is empty")
    }
    let mut out = List<(usize, String)>.new()
    let mut start: usize = 0
    loop {
        let at = index_of(self, needle, start)
        if at >= self.len() {
            break
        }
        out.push((at, String.from(self[at..at + needle.len()])))
        start = at + needle.len()
    }
    out
}

/// Every non-overlapping occurrence of `needle` in the string.
///
/// ```
/// let s = String.from("abcabc")
/// assert_eq(s.match_indices("bc").len(), 2)
/// ```
fn String.match_indices(self, needle: str): List<(usize, String)> {
    self.as_str().match_indices(needle)
}

/// The same as `match_indices`: every occurrence, with its byte offset.
///
/// ```
/// let hits = "abcabc".find_all("bc")
/// assert_eq(hits.len(), 2)
/// assert_eq(hits[1].0, 4)
/// ```
fn str.find_all(self, needle: str): List<(usize, String)> {
    self.match_indices(needle)
}

/// Every occurrence of `needle` in the string.
///
/// ```
/// let s = String.from("abcabc")
/// let hits = s.find_all("bc")
/// assert_eq(hits.len(), 2)
/// assert_eq(hits[1].0, 4)
/// ```
fn String.find_all(self, needle: str): List<(usize, String)> {
    self.as_str().find_all(needle)
}

/// The bytes `from..to` as a view, or `None` when the range is reversed, past the end, or either end splits a
/// character. It is `s[from..to]` without the panic (`spec/stdlib.md`, "Slicing and character boundaries").
///
/// ```
/// assert("hello".get(1, 3).unwrap() == "el")
/// assert("hello".get(1, 9).is_none())
/// ```
fn str.get(self, from: usize, to: usize): Option<str> {
    if from > to || to > self.len() {
        return Option.None
    }
    if !self.is_char_boundary(from) || !self.is_char_boundary(to) {
        return Option.None
    }
    Option.Some(self[from..to])
}

/// The bytes `from..to` of the string as a view, or `None` when the range is invalid or splits a character.
///
/// ```
/// let s = String.from("hello")
/// assert(s.get(1, 3).unwrap() == "el")
/// assert(s.get(1, 9).is_none())
/// ```
fn String.get(self, from: usize, to: usize): Option<str> {
    self.as_str().get(from, to)
}

/// Appends every `char` `iter` yields: `text.extend_iter(other.chars())`.
///
/// ```
/// let mut s = String.from("ab")
/// s.extend_iter(['c', 'd'].into_iter())
/// assert_eq(s, String.from("abcd"))
/// ```
fn String.extend_iter<I: Iterator<char>>(mut self, own iter: I) {
    let mut iter = iter
    loop {
        match iter.next() {
            Option.Some(c) => self.push(c),
            Option.None => break,
        }
    }
}
