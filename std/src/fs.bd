// Directories, metadata, and walking (issue #411), and files and file handles (issue #702); `spec/stdlib.md`,
// "Directories, metadata, and walking" and "Files and file handles".
//
// The compiler's primitives (`__read_dir`, `__create_dir`, `__remove_dir`, `__remove_file`, `__rename`,
// `__metadata`, `__canonicalize`, and the `__file_*` handle operations) reach the operating system; the signatures,
// the error values, the recursive helpers, the glob matcher, and the file handle are Burdin. Every function is
// impure: a constant evaluation that reaches one fails with E0224.

use fmt.{Debug, Formatter}
use iter.Iterator
use path.Path
use reactor.offload
use rw.{Read, Seek, SeekFrom, Write}
use sort.sort_by
use std.{IoError, IoErrorKind}
use text.truncate

/// The kind of entry a path names.
///
/// ```
/// create_dir("burdin-doc-kind").unwrap()
/// let kind = metadata("burdin-doc-kind").unwrap().kind
/// assert(kind == FileKind.Dir)
/// remove_dir("burdin-doc-kind").unwrap()
/// ```
enum FileKind: Copy, Clone, Eq, Debug {
    File
    Dir
    Symlink
    Other
}

/// What the system reports about one path: the entry itself, without following a symbolic link.
///
/// ```
/// write("burdin-doc-meta-struct.txt", "abcd".as_bytes()).unwrap()
/// let m = metadata("burdin-doc-meta-struct.txt").unwrap()
/// assert_eq(m.size, 4)
/// assert(m.kind == FileKind.File)
/// remove_file("burdin-doc-meta-struct.txt").unwrap()
/// ```
struct Metadata: Clone, Copy, Eq, Debug {
    /// The size in bytes.
    size: u64
    /// The system's mode bits: the file kind and the permission bits, as `stat` reports them.
    mode: u32
    /// The modification time, in seconds since the Unix epoch.
    modified: i64
    /// The access time, in seconds since the Unix epoch.
    accessed: i64
    kind: FileKind
}

Metadata {
    /// Whether the entry is a regular file.
    ///
    /// ```
    /// write("burdin-doc-is-file.txt", "x".as_bytes()).unwrap()
    /// assert(metadata("burdin-doc-is-file.txt").unwrap().is_file())
    /// remove_file("burdin-doc-is-file.txt").unwrap()
    /// ```
    fn is_file(self): bool {
        self.kind == FileKind.File
    }

    /// Whether the entry is a directory.
    ///
    /// ```
    /// create_dir("burdin-doc-is-dir").unwrap()
    /// assert(metadata("burdin-doc-is-dir").unwrap().is_dir())
    /// remove_dir("burdin-doc-is-dir").unwrap()
    /// ```
    fn is_dir(self): bool {
        self.kind == FileKind.Dir
    }

    /// Whether the entry is a symbolic link.
    ///
    /// ```
    /// write("burdin-doc-symlink-check.txt", "x".as_bytes()).unwrap()
    /// let m = metadata("burdin-doc-symlink-check.txt").unwrap()
    /// assert(!m.is_symlink())
    /// remove_file("burdin-doc-symlink-check.txt").unwrap()
    /// ```
    fn is_symlink(self): bool {
        self.kind == FileKind.Symlink
    }
}

/// The names of the entries in the directory `path`, in the order the system returns them, without `.` and `..`.
/// Sort the list for a deterministic order. The names are not paths; join them with `Path.join`.
///
/// ```
/// create_dir("burdin-doc-list").unwrap()
/// write("burdin-doc-list/one.txt", "x".as_bytes()).unwrap()
/// let names = read_dir("burdin-doc-list").unwrap()
/// assert_eq(names.len(), 1)
/// assert_eq(names[0], String.from("one.txt"))
/// remove_dir_all("burdin-doc-list").unwrap()
/// ```
fn read_dir(path: str): Result<List<String>, IoError> {
    match offload(|| __read_dir(path)) {
        Result.Ok(names) => Result.Ok(names),
        Result.Err(code) => Result.Err(IoError.Read {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Option.Some(code),
        }),
    }
}

/// Creates one directory. The parent must exist, and an existing directory is an error (`create_dir_all` treats
/// an existing directory as success).
///
/// ```
/// create_dir("burdin-doc-make-dir").unwrap()
/// assert(metadata("burdin-doc-make-dir").unwrap().is_dir())
/// remove_dir("burdin-doc-make-dir").unwrap()
/// ```
fn create_dir(path: str): Result<(), IoError> {
    match offload(|| __create_dir(path)) {
        Result.Ok(_) => Result.Ok(()),
        Result.Err(code) => Result.Err(IoError.Write {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Option.Some(code),
        }),
    }
}

/// Creates `path` and every missing parent. An existing directory is success; a path that exists as a file is an
/// error.
///
/// ```
/// create_dir_all("burdin-doc-make/a/b").unwrap()
/// assert(exists("burdin-doc-make/a/b"))
/// remove_dir_all("burdin-doc-make").unwrap()
/// ```
fn create_dir_all(path: str): Result<(), IoError> {
    match create_dir(path) {
        Result.Ok(()) => Result.Ok(()),
        Result.Err(failure) => {
            match metadata(path) {
                Result.Ok(info) if info.is_dir() => return Result.Ok(()),
                _ => {}
            }
            match Path.new(path).parent() {
                Option.Some(parent) if parent.as_str().len() > 0 => {
                    create_dir_all(parent.as_str())?;
                    create_dir(path)
                }
                _ => Result.Err(failure),
            }
        }
    }
}

/// Removes an empty directory. A non-empty directory is an error; `remove_dir_all` removes it with its contents.
///
/// ```
/// create_dir("burdin-doc-remove-dir").unwrap()
/// remove_dir("burdin-doc-remove-dir").unwrap()
/// assert(!exists("burdin-doc-remove-dir"))
/// ```
fn remove_dir(path: str): Result<(), IoError> {
    match offload(|| __remove_dir(path)) {
        Result.Ok(_) => Result.Ok(()),
        Result.Err(code) => Result.Err(IoError.Write {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Option.Some(code),
        }),
    }
}

/// Removes a file or a symbolic link. A directory is an error; `remove_dir_all` removes a directory.
///
/// ```
/// write("burdin-doc-remove.txt", "x".as_bytes()).unwrap()
/// remove_file("burdin-doc-remove.txt").unwrap()
/// assert(!exists("burdin-doc-remove.txt"))
/// ```
fn remove_file(path: str): Result<(), IoError> {
    match offload(|| __remove_file(path)) {
        Result.Ok(_) => Result.Ok(()),
        Result.Err(code) => Result.Err(IoError.Write {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Option.Some(code),
        }),
    }
}

/// Removes a directory and everything under it. A symbolic link is removed as a link, never followed.
///
/// ```
/// create_dir_all("burdin-doc-rm-all/inner").unwrap()
/// write("burdin-doc-rm-all/inner/f.txt", "x".as_bytes()).unwrap()
/// remove_dir_all("burdin-doc-rm-all").unwrap()
/// assert(!exists("burdin-doc-rm-all"))
/// ```
fn remove_dir_all(path: str): Result<(), IoError> {
    let info = match metadata(path) {
        Result.Ok(info) => info,
        Result.Err(failure) => return Result.Err(failure),
    }
    if !info.is_dir() {
        // `std` sees the kind itself here; no system call failed.
        return Result.Err(IoError.Write { path: path.to_string(), kind: IoErrorKind.NotADirectory, os_code: Option.None })
    }
    remove_entry(path)
}

/// Removes one entry: a file, a link, an empty directory, or a non-empty directory with its contents. Trying the
/// two removals first keeps a link a link: `remove_dir` then `remove_file` succeed for it before any listing, so
/// its target is never walked.
priv fn remove_entry(path: str): Result<(), IoError> {
    if remove_dir(path).is_ok() {
        return Result.Ok(())
    }
    if remove_file(path).is_ok() {
        return Result.Ok(())
    }
    // Both removals failed. A link that could not be removed is an error rather than a directory to walk.
    let info = match metadata(path) {
        Result.Ok(info) => info,
        Result.Err(failure) => return Result.Err(failure),
    }
    if info.is_symlink() {
        return Result.Err(IoError.Write { path: path.to_string(), kind: IoErrorKind.Other, os_code: Option.None })
    }
    let names = match read_dir(path) {
        Result.Ok(names) => names,
        Result.Err(failure) => return Result.Err(failure),
    }
    for name in names {
        let child = Path.new(path).join(name.as_str())
        remove_entry(child.as_str())?
    }
    remove_dir(path)
}

/// Renames a file or a directory, replacing an existing `to`. The error names `to`.
///
/// ```
/// write("burdin-doc-old-name.txt", "x".as_bytes()).unwrap()
/// rename("burdin-doc-old-name.txt", "burdin-doc-new-name.txt").unwrap()
/// assert(!exists("burdin-doc-old-name.txt"))
/// assert(exists("burdin-doc-new-name.txt"))
/// remove_file("burdin-doc-new-name.txt").unwrap()
/// ```
fn rename(from: str, to: str): Result<(), IoError> {
    match offload(|| __rename(from, to)) {
        Result.Ok(_) => Result.Ok(()),
        Result.Err(code) => Result.Err(IoError.Write {
            path: to.to_string(),
            kind: __io_kind(code),
            os_code: Option.Some(code),
        }),
    }
}

/// What the system reports about `path`. The entry itself is read (`lstat` on Unix), so a symbolic link reports
/// its own kind; on Windows the CRT's `_stat64` follows a link, so its size and times may describe the target.
///
/// ```
/// write("burdin-doc-metadata.txt", "abc".as_bytes()).unwrap()
/// let m = metadata("burdin-doc-metadata.txt").unwrap()
/// assert_eq(m.size, 3)
/// assert(m.is_file())
/// remove_file("burdin-doc-metadata.txt").unwrap()
/// ```
fn metadata(path: str): Result<Metadata, IoError> {
    match offload(|| __metadata(path)) {
        Result.Ok((size, mode, modified, accessed, flags)) => Result.Ok(Metadata {
            size,
            mode: mode as u32,
            modified,
            accessed,
            kind: file_kind(flags),
        }),
        Result.Err(code) => Result.Err(IoError.Read {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Option.Some(code),
        }),
    }
}

priv fn file_kind(flags: u64): FileKind {
    if flags & 4 != 0 {
        FileKind.Symlink
    } else if flags & 2 != 0 {
        FileKind.Dir
    } else if flags & 1 != 0 {
        FileKind.File
    } else {
        FileKind.Other
    }
}

/// The absolute path that names `path`, with `.` and `..` resolved and the system's separators. The path must
/// exist. On Unix this is `realpath`, which also resolves symbolic links; on Windows it is `_fullpath`, which
/// only normalizes the text and keeps a link's name.
///
/// ```
/// let p = canonicalize(".").unwrap()
/// assert(p.len() > 0)
/// ```
fn canonicalize(path: str): Result<String, IoError> {
    match offload(|| __canonicalize(path)) {
        Result.Ok(text) => Result.Ok(text),
        Result.Err(code) => Result.Err(IoError.Read {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Option.Some(code),
        }),
    }
}

/// Every file and directory under `root`, recursively, as a path relative to `root` with the system's separator.
/// `root` itself is not included, a symbolic link is listed but not followed, and the result is sorted. A
/// directory that cannot be read makes the whole walk fail.
///
/// ```
/// create_dir_all("burdin-doc-walk/sub").unwrap()
/// write("burdin-doc-walk/a.bd", "x".as_bytes()).unwrap()
/// write("burdin-doc-walk/sub/b.bd", "y".as_bytes()).unwrap()
/// assert_eq(walk("burdin-doc-walk").unwrap().len(), 3)
/// remove_dir_all("burdin-doc-walk").unwrap()
/// ```
fn walk(root: str): Result<List<String>, IoError> {
    let mut out = offload(|| walk_now(root, "", false))?
    out.sort_by(|a, b| a.cmp(*b))
    Result.Ok(out)
}

/// The entries under `root` whose relative path matches `pattern`, recursively, sorted as `walk` sorts them.
/// `*` matches any run of characters inside one path segment, `?` matches one character inside a segment, and
/// `**` matches across segments; a `**` followed by a separator also matches no segment at all, so `**/*.bd`
/// finds a file at the top level too. Both `/` and `\` are separators in a pattern. A directory whose path no match
/// can start with is not read, so `src/*.bd` reads only `root` and `src`.
///
/// ```
/// create_dir_all("burdin-doc-glob/sub").unwrap()
/// write("burdin-doc-glob/a.bd", "x".as_bytes()).unwrap()
/// write("burdin-doc-glob/sub/b.bd", "y".as_bytes()).unwrap()
/// write("burdin-doc-glob/sub/c.txt", "z".as_bytes()).unwrap()
/// assert_eq(walk_glob("burdin-doc-glob", "**/*.bd").unwrap().len(), 2)
/// remove_dir_all("burdin-doc-glob").unwrap()
/// ```
fn walk_glob(root: str, pattern: str): Result<List<String>, IoError> {
    let mut out = offload(|| walk_now(root, pattern, true))?
    out.sort_by(|a, b| a.cmp(*b))
    Result.Ok(out)
}

// The walk runs as one `offload` and calls the primitives directly, so an entry costs its system calls and no
// helper-thread round trip. It keeps two buffers for the whole walk: `full`, the path of the current entry, which a
// level extends by a name and cuts back, and `name`, which `__dir_next` overwrites. The relative path is the tail of
// `full` after `base`, so an entry allocates only the copy `out` keeps (issue #1021).
priv fn walk_now(root: str, pattern: str, glob: bool): Result<List<String>, IoError> {
    let start = Path.new(root)
    // `join` decides whether a separator goes between the root and a name; joining a one-byte name shows where the
    // names start. The text before them is `root` itself, or `root` and a separator.
    let mut full = String.from(start.join("_").as_str())
    let base = full.len() - 1
    full.truncate(root.len())
    let mut name = String.new()
    let mut out = List<String>.new()
    walk_level(mut full, base, start.separator(), pattern.as_bytes(), glob, mut name, mut out)?
    Result.Ok(out)
}

/// An open directory listing; dropping it closes the handle, on every return.
priv struct DirHandle {
    id: u64
}

DirHandle: Drop {
    fn drop(mut self) {
        __dir_close(self.id)
    }
}

priv fn read_error(path: str, code: i32): IoError {
    IoError.Read { path: path.to_string(), kind: __io_kind(code), os_code: Option.Some(code) }
}

/// Lists the directory `full` names and walks into each subdirectory, adding the relative paths to `out` (every one,
/// or with `glob` those that match `pattern`). `full` comes back as it was.
priv fn walk_level(
    mut full: String,
    base: usize,
    sep: char,
    pattern: [u8],
    glob: bool,
    mut name: String,
    mut out: List<String>,
): Result<(), IoError> {
    let dir = match __dir_open(full.as_str()) {
        Result.Ok(id) => DirHandle { id: id },
        Result.Err(code) => return Result.Err(read_error(full.as_str(), code)),
    }
    let dir_end = full.len()
    if dir_end != base {
        full.push(sep)
    }
    let start = full.len()
    // The loop takes no view of `full` or `name`: a view used in a loop is live for the whole loop (RF2), which would
    // forbid the `mut` passes. `walk_entry` takes them.
    loop {
        match __dir_next(dir.id, mut name) {
            Result.Ok(true) => {}
            Result.Ok(false) => break,
            Result.Err(code) => {
                full.truncate(dir_end)
                return Result.Err(walk_error(full, code))
            }
        }
        if walk_entry(mut full, start, base, name, pattern, glob, mut out)? {
            walk_level(mut full, base, sep, pattern, glob, mut name, mut out)?
        }
    }
    full.truncate(dir_end)
    Result.Ok(())
}

/// Puts `name` after the directory's path in `full`, reads its metadata, and adds its relative path to `out` when it
/// is kept. The result says whether to walk into it: a directory, and with `glob` one a match can lie under.
priv fn walk_entry(
    mut full: String,
    start: usize,
    base: usize,
    name: String,
    pattern: [u8],
    glob: bool,
    mut out: List<String>,
): Result<bool, IoError> {
    full.truncate(start)
    full.push_str(name.as_str())
    let path = full.as_str()
    let flags = match __metadata(path) {
        Result.Ok((_, _, _, _, flags)) => flags,
        Result.Err(code) => return Result.Err(read_error(path, code)),
    }
    let rel = path[base..path.len()]
    if !glob || glob_match(pattern, 0, rel.as_bytes(), 0) {
        out.push(String.from(rel))
    }
    // A symbolic link is listed but never followed: its kind is `Symlink`, not `Dir`.
    let is_dir = file_kind(flags) == FileKind.Dir
    Result.Ok(is_dir && (!glob || glob_may_descend(pattern, 0, rel.as_bytes(), 0)))
}

priv fn walk_error(path: String, code: i32): IoError {
    read_error(path.as_str(), code)
}

priv const GLOB_STAR: u8 = 42
priv const GLOB_QUESTION: u8 = 63

priv fn glob_sep(b: u8): bool {
    b == 47 || b == 92
}

/// The offset of the character after the one at `i`: the pattern's `*` and `?` step over whole UTF-8 characters, so
/// every offset the matcher compares at is a character boundary.
priv fn glob_next(text: [u8], i: usize): usize {
    let b = text[i]
    let width: usize = if b >= 240 { 4 } else if b >= 224 { 3 } else if b >= 192 { 2 } else { 1 }
    if i + width > text.len() { text.len() } else { i + width }
}

/// Whether `text[ti..]` matches `pattern[pi..]`, with `*`, `?`, and `**` as `walk_glob` describes. Both are bytes:
/// a literal character matches byte for byte.
priv fn glob_match(pattern: [u8], pi: usize, text: [u8], ti: usize): bool {
    if pi == pattern.len() {
        return ti == text.len()
    }
    let pc = pattern[pi]
    if pc == GLOB_STAR {
        if pi + 1 < pattern.len() && pattern[pi + 1] == GLOB_STAR {
            // `**/` matches zero path segments: try the rest of the pattern at the same position.
            if pi + 2 < pattern.len() && glob_sep(pattern[pi + 2]) {
                if glob_match(pattern, pi + 3, text, ti) {
                    return true
                }
            }
            let mut k = ti
            loop {
                if glob_match(pattern, pi + 2, text, k) {
                    return true
                }
                if k == text.len() {
                    return false
                }
                k = glob_next(text, k)
            }
        }
        let mut k = ti
        loop {
            if glob_match(pattern, pi + 1, text, k) {
                return true
            }
            if k == text.len() || glob_sep(text[k]) {
                return false
            }
            k = glob_next(text, k)
        }
    }
    if ti == text.len() {
        return false
    }
    if pc == GLOB_QUESTION {
        return !glob_sep(text[ti]) && glob_match(pattern, pi + 1, text, glob_next(text, ti))
    }
    if glob_sep(pc) {
        return glob_sep(text[ti]) && glob_match(pattern, pi + 1, text, ti + 1)
    }
    pc == text[ti] && glob_match(pattern, pi + 1, text, ti + 1)
}

/// Whether a path under the directory `text[ti..]` (the directory, a separator, and more) could match
/// `pattern[pi..]`. A `**` can match anything, so it answers yes; otherwise the directory's path must match a prefix
/// of the pattern that ends where a separator can follow. `walk_glob` skips a directory this rejects.
priv fn glob_may_descend(pattern: [u8], pi: usize, text: [u8], ti: usize): bool {
    if pi == pattern.len() {
        return false
    }
    let pc = pattern[pi]
    if pc == GLOB_STAR {
        if pi + 1 < pattern.len() && pattern[pi + 1] == GLOB_STAR {
            return true
        }
        let mut k = ti
        loop {
            if glob_may_descend(pattern, pi + 1, text, k) {
                return true
            }
            if k == text.len() || glob_sep(text[k]) {
                return false
            }
            k = glob_next(text, k)
        }
    }
    if ti == text.len() {
        // The directory's path is used up; the separator that follows it must match next.
        return glob_sep(pc)
    }
    if pc == GLOB_QUESTION {
        return !glob_sep(text[ti]) && glob_may_descend(pattern, pi + 1, text, glob_next(text, ti))
    }
    if glob_sep(pc) {
        return glob_sep(text[ti]) && glob_may_descend(pattern, pi + 1, text, ti + 1)
    }
    pc == text[ti] && glob_may_descend(pattern, pi + 1, text, ti + 1)
}

/// The entries of one directory, read lazily (`read_dir_iter`). Each item is a name, or the error that ended the
/// listing; the iterator yields nothing after an error. Dropping it closes the directory.
///
/// ```
/// create_dir("burdin-doc-entries").unwrap()
/// write("burdin-doc-entries/one.txt", "x".as_bytes()).unwrap()
/// let mut names = read_dir_iter("burdin-doc-entries").unwrap()
/// assert_eq(names.next().unwrap().unwrap(), String.from("one.txt"))
/// assert(names.next().is_none())
/// remove_dir_all("burdin-doc-entries").unwrap()
/// ```
struct ReadDir {
    priv dir: DirHandle
    priv path: String
    priv done: bool
}

ReadDir: Iterator<Result<String, IoError>> {
    fn next(mut self): Option<Result<String, IoError>> {
        if self.done {
            return Option.None
        }
        let id = self.dir.id
        let mut name = String.new()
        let name_ptr = unsafe { (&mut name) as CPtr<String> }
        let step = unsafe {
            offload(|| unsafe {
                __dir_next(id, mut *name_ptr)
            })
        }
        match step {
            Result.Ok(true) => Option.Some(Result.Ok(name)),
            Result.Ok(false) => {
                self.done = true
                Option.None
            }
            Result.Err(code) => {
                self.done = true
                Option.Some(Result.Err(read_error(self.path.as_str(), code)))
            }
        }
    }
}

/// The names in the directory `path`, read one at a time as the iterator is advanced, so a caller that stops early
/// does not read the rest. The names and their order are `read_dir`'s; opening a missing path or a file is an error
/// here, and a failure later in the listing is an `Err` item.
///
/// ```
/// create_dir("burdin-doc-read-dir-iter").unwrap()
/// write("burdin-doc-read-dir-iter/a.txt", "x".as_bytes()).unwrap()
/// write("burdin-doc-read-dir-iter/b.txt", "y".as_bytes()).unwrap()
/// let mut count = 0
/// for name in read_dir_iter("burdin-doc-read-dir-iter").unwrap() {
///     assert(name.unwrap().ends_with(".txt"))
///     count = count + 1
/// }
/// assert_eq(count, 2)
/// remove_dir_all("burdin-doc-read-dir-iter").unwrap()
/// ```
fn read_dir_iter(path: str): Result<ReadDir, IoError> {
    match offload(|| __dir_open(path)) {
        Result.Ok(id) => Result.Ok(ReadDir { dir: DirHandle { id: id }, path: path.to_string(), done: false }),
        Result.Err(code) => Result.Err(read_error(path, code)),
    }
}

Path {
    /// The names in this directory (`read_dir`).
    ///
    /// ```
    /// create_dir("burdin-doc-path-list").unwrap()
    /// write("burdin-doc-path-list/one.txt", "x".as_bytes()).unwrap()
    /// assert_eq(Path.unix("burdin-doc-path-list").read_dir().unwrap().len(), 1)
    /// remove_dir_all("burdin-doc-path-list").unwrap()
    /// ```
    fn read_dir(self): Result<List<String>, IoError> {
        read_dir(self.as_str())
    }

    /// The names in this directory, read lazily (`read_dir_iter`).
    ///
    /// ```
    /// create_dir("burdin-doc-path-iter").unwrap()
    /// write("burdin-doc-path-iter/one.txt", "x".as_bytes()).unwrap()
    /// assert_eq(Path.unix("burdin-doc-path-iter").read_dir_iter().unwrap().count(), 1)
    /// remove_dir_all("burdin-doc-path-iter").unwrap()
    /// ```
    fn read_dir_iter(self): Result<ReadDir, IoError> {
        read_dir_iter(self.as_str())
    }

    /// This path's metadata (`metadata`).
    ///
    /// ```
    /// write("burdin-doc-path-metadata.txt", "abc".as_bytes()).unwrap()
    /// let m = Path.unix("burdin-doc-path-metadata.txt").metadata().unwrap()
    /// assert(m.is_file())
    /// remove_file("burdin-doc-path-metadata.txt").unwrap()
    /// ```
    fn metadata(self): Result<Metadata, IoError> {
        metadata(self.as_str())
    }

    /// This path's absolute, normalized form (`canonicalize`).
    ///
    /// ```
    /// let p = Path.unix(".").canonicalize().unwrap()
    /// assert(p.len() > 0)
    /// ```
    fn canonicalize(self): Result<String, IoError> {
        canonicalize(self.as_str())
    }

    /// Every entry under this path (`walk`).
    ///
    /// ```
    /// create_dir_all("burdin-doc-pwalk/sub").unwrap()
    /// write("burdin-doc-pwalk/a.bd", "x".as_bytes()).unwrap()
    /// assert_eq(Path.unix("burdin-doc-pwalk").walk().unwrap().len(), 2)
    /// remove_dir_all("burdin-doc-pwalk").unwrap()
    /// ```
    fn walk(self): Result<List<String>, IoError> {
        walk(self.as_str())
    }

    /// The entries under this path that match `pattern` (`walk_glob`).
    ///
    /// ```
    /// create_dir_all("burdin-doc-pglob/sub").unwrap()
    /// write("burdin-doc-pglob/a.bd", "x".as_bytes()).unwrap()
    /// write("burdin-doc-pglob/sub/b.bd", "y".as_bytes()).unwrap()
    /// assert_eq(Path.unix("burdin-doc-pglob").walk_glob("**/*.bd").unwrap().len(), 2)
    /// remove_dir_all("burdin-doc-pglob").unwrap()
    /// ```
    fn walk_glob(self, pattern: str): Result<List<String>, IoError> {
        walk_glob(self.as_str(), pattern)
    }
}

// ---- files and file handles (issue #702; spec/stdlib.md, "Files and file handles") ----

/// The kind of a file failure. The primitives report 0 when no system call gave a code, which is `Other`
/// (`spec/errors.md`, ERR10-ERR11).
priv fn io_error_kind(code: i32): IoErrorKind {
    if code > 0 { __io_kind(code) } else { IoErrorKind.Other }
}

/// The OS code of a file failure, when the primitive reported one.
priv fn io_error_code(code: i32): Option<i32> {
    if code > 0 { Option.Some(code) } else { Option.None }
}

/// The options that open a file. Every option starts off; `open` rejects a set with no access and the combinations
/// the systems disagree on (`IoError.InvalidInput`).
///
/// ```
/// let mut options = OpenOptions.new()
/// options.read(true)
/// assert(options.open("burdin-doc-missing-file.txt").is_err())
/// ```
struct OpenOptions {
    priv read: bool
    priv write: bool
    priv append: bool
    priv truncate: bool
    priv create: bool
    priv create_new: bool
}

OpenOptions {
    /// No options: `open` reports `IoError.InvalidInput` until an access mode is set.
    ///
    /// ```
    /// let options = OpenOptions.new()
    /// assert(options.open("burdin-doc-no-access.txt").is_err())
    /// ```
    fn new(): OpenOptions {
        OpenOptions { read: false, write: false, append: false, truncate: false, create: false, create_new: false }
    }

    /// Allows reading.
    ///
    /// ```
    /// write("burdin-doc-options-read.txt", "hi".as_bytes()).unwrap()
    /// let mut options = OpenOptions.new()
    /// options.read(true)
    /// let f = options.open("burdin-doc-options-read.txt").unwrap()
    /// f.close().unwrap()
    /// remove_file("burdin-doc-options-read.txt").unwrap()
    /// ```
    fn read(mut self, on: bool) {
        self.read = on
    }

    /// Allows writing.
    ///
    /// ```
    /// let mut options = OpenOptions.new()
    /// options.write(true)
    /// options.create(true)
    /// let f = options.open("burdin-doc-options-write.txt").unwrap()
    /// f.close().unwrap()
    /// remove_file("burdin-doc-options-write.txt").unwrap()
    /// ```
    fn write(mut self, on: bool) {
        self.write = on
    }

    /// Every write goes to the end of the file. A file opened only for appending is opened for writing.
    ///
    /// ```
    /// write("burdin-doc-options-append.txt", "a".as_bytes()).unwrap()
    /// let mut options = OpenOptions.new()
    /// options.append(true)
    /// let mut f = options.open("burdin-doc-options-append.txt").unwrap()
    /// f.write("b".as_bytes()).unwrap()
    /// f.close().unwrap()
    /// assert_eq(read_to_string("burdin-doc-options-append.txt").unwrap(), String.from("ab"))
    /// remove_file("burdin-doc-options-append.txt").unwrap()
    /// ```
    fn append(mut self, on: bool) {
        self.append = on
    }

    /// Empties an existing file when it is opened. Needs write or append access, and cannot be combined with
    /// append.
    ///
    /// ```
    /// write("burdin-doc-truncate.txt", "long text".as_bytes()).unwrap()
    /// let mut options = OpenOptions.new()
    /// options.write(true)
    /// options.truncate(true)
    /// let f = options.open("burdin-doc-truncate.txt").unwrap()
    /// f.close().unwrap()
    /// assert_eq(read_to_string("burdin-doc-truncate.txt").unwrap(), String.from(""))
    /// remove_file("burdin-doc-truncate.txt").unwrap()
    /// ```
    fn truncate(mut self, on: bool) {
        self.truncate = on
    }

    /// Creates the file when it is missing.
    ///
    /// ```
    /// let mut options = OpenOptions.new()
    /// options.create(true)
    /// options.write(true)
    /// let f = options.open("burdin-doc-options-create.txt").unwrap()
    /// f.close().unwrap()
    /// assert(exists("burdin-doc-options-create.txt"))
    /// remove_file("burdin-doc-options-create.txt").unwrap()
    /// ```
    fn create(mut self, on: bool) {
        self.create = on
    }

    /// Creates the file when it is missing and fails when it exists. It implies `create`, so `create` need not be
    /// set too.
    ///
    /// ```
    /// let mut options = OpenOptions.new()
    /// options.create_new(true)
    /// options.write(true)
    /// let f = options.open("burdin-doc-create-new.txt").unwrap()
    /// f.close().unwrap()
    /// assert(options.open("burdin-doc-create-new.txt").is_err())
    /// remove_file("burdin-doc-create-new.txt").unwrap()
    /// ```
    fn create_new(mut self, on: bool) {
        self.create_new = on
    }

    /// Opens `path` with these options. A set with no access mode, `truncate` without write or append access, and
    /// `append` with `truncate` are `IoError.InvalidInput`. A failure of the system call is `IoError.Read` when the
    /// options only read, and `IoError.Write` otherwise.
    ///
    /// ```
    /// let mut options = OpenOptions.new()
    /// options.create(true)
    /// options.write(true)
    /// let f = options.open("burdin-doc-options-open.txt").unwrap()
    /// f.close().unwrap()
    /// remove_file("burdin-doc-options-open.txt").unwrap()
    /// ```
    fn open(self, path: str): Result<File, IoError> {
        if !self.read && !self.write && !self.append {
            return Result.Err(IoError.InvalidInput)
        }
        if self.truncate && !self.write && !self.append {
            return Result.Err(IoError.InvalidInput)
        }
        if self.truncate && self.append {
            return Result.Err(IoError.InvalidInput)
        }
        let read = self.read
        let write = self.write
        let append = self.append
        let truncate = self.truncate
        let create = self.create
        let create_new = self.create_new
        match offload(|| __file_open(path, read, write, append, truncate, create, create_new)) {
            Result.Ok(fd) => Result.Ok(File { fd: fd, path: path.to_string() }),
            Result.Err(_) => {
                let code = __file_error()
                let changes = self.write || self.append || self.truncate || self.create || self.create_new
                if changes {
                    Result.Err(IoError.Write {
                        path: path.to_string(),
                        kind: io_error_kind(code),
                        os_code: io_error_code(code),
                    })
                } else {
                    Result.Err(IoError.Read {
                        path: path.to_string(),
                        kind: io_error_kind(code),
                        os_code: io_error_code(code),
                    })
                }
            }
        }
    }
}

/// An open file. It reads and writes through the unbuffered system descriptor, so wrap it in a `BufReader` or a
/// `BufWriter` for many small operations. Dropping it closes it (`Drop`); `close` reports the error the drop would
/// discard. The bytes are never translated: on every system the file is binary.
///
/// ```
/// let mut f = File.create("burdin-doc-file.txt").unwrap()
/// f.write("abc".as_bytes()).unwrap()
/// f.close().unwrap()
/// assert_eq(read_to_string("burdin-doc-file.txt").unwrap(), String.from("abc"))
/// remove_file("burdin-doc-file.txt").unwrap()
/// ```
struct File {
    priv fd: i32
    /// The path the handle was opened with, named by every error the handle reports.
    priv path: String
}

File {
    /// Opens `path` for reading.
    ///
    /// ```
    /// write("burdin-doc-file-open.txt", "x".as_bytes()).unwrap()
    /// let f = File.open("burdin-doc-file-open.txt").unwrap()
    /// f.close().unwrap()
    /// remove_file("burdin-doc-file-open.txt").unwrap()
    /// ```
    fn open(path: str): Result<File, IoError> {
        let mut options = OpenOptions.new()
        options.read(true)
        options.open(path)
    }

    /// Opens `path` for writing, creating it when it is missing and emptying it when it exists.
    ///
    /// ```
    /// let f = File.create("burdin-doc-file-create.txt").unwrap()
    /// f.close().unwrap()
    /// assert(exists("burdin-doc-file-create.txt"))
    /// remove_file("burdin-doc-file-create.txt").unwrap()
    /// ```
    fn create(path: str): Result<File, IoError> {
        let mut options = OpenOptions.new()
        options.write(true)
        options.create(true)
        options.truncate(true)
        options.open(path)
    }

    /// Makes the file's contents durable: `fsync` on Unix, `_commit` on Windows.
    ///
    /// ```
    /// let f = File.create("burdin-doc-sync.txt").unwrap()
    /// f.sync_all().unwrap()
    /// f.close().unwrap()
    /// remove_file("burdin-doc-sync.txt").unwrap()
    /// ```
    fn sync_all(self): Result<(), IoError> {
        let fd = self.fd
        match offload(|| __file_sync(fd)) {
            Result.Ok(()) => Result.Ok(()),
            Result.Err(_) => {
                let code = __file_error()
                Result.Err(IoError.Write {
                    path: self.path.clone(),
                    kind: io_error_kind(code),
                    os_code: io_error_code(code),
                })
            }
        }
    }

    /// Sets the file's length. The bytes past `size` are removed, and a shorter file is extended with zero bytes.
    ///
    /// ```
    /// let mut f = File.create("burdin-doc-set-len.txt").unwrap()
    /// f.write("hello".as_bytes()).unwrap()
    /// f.set_len(2).unwrap()
    /// f.close().unwrap()
    /// assert_eq(read_to_string("burdin-doc-set-len.txt").unwrap(), String.from("he"))
    /// remove_file("burdin-doc-set-len.txt").unwrap()
    /// ```
    fn set_len(mut self, size: u64): Result<(), IoError> {
        let fd = self.fd
        match offload(|| __file_set_len(fd, size)) {
            Result.Ok(()) => Result.Ok(()),
            Result.Err(_) => {
                let code = __file_error()
                Result.Err(IoError.Write {
                    path: self.path.clone(),
                    kind: io_error_kind(code),
                    os_code: io_error_code(code),
                })
            }
        }
    }

    /// Closes the file and reports a failure that `Drop` would discard. The handle is moved, so it cannot be used
    /// again. The rebinding marks the descriptor closed, so the drop that follows does not close it a second time
    /// (a second close is an invalid descriptor, which the Windows CRT treats as a fatal parameter error).
    ///
    /// ```
    /// let f = File.create("burdin-doc-close.txt").unwrap()
    /// f.close().unwrap()
    /// remove_file("burdin-doc-close.txt").unwrap()
    /// ```
    fn close(own self): Result<(), IoError> {
        let mut me = self
        let fd = me.fd
        me.fd = -1
        match __file_close(fd) {
            Result.Ok(()) => Result.Ok(()),
            Result.Err(_) => {
                let code = __file_error()
                Result.Err(IoError.Write {
                    path: me.path.clone(),
                    kind: io_error_kind(code),
                    os_code: io_error_code(code),
                })
            }
        }
    }
}

File: Read {
    fn read(mut self, mut buf: List<u8>, max: usize): Result<usize, IoError> {
        let fd = self.fd
        let buf_ptr = unsafe { (&mut buf) as CPtr<List<u8>> }
        match unsafe {
            offload(|| unsafe {
                __file_read(fd, mut *buf_ptr, max)
            })
        } {
            Result.Ok(n) => Result.Ok(n),
            Result.Err(_) => {
                let code = __file_error()
                Result.Err(IoError.Read {
                    path: self.path.clone(),
                    kind: io_error_kind(code),
                    os_code: io_error_code(code),
                })
            }
        }
    }
}

File: Write {
    fn write(mut self, data: [u8]): Result<usize, IoError> {
        let fd = self.fd
        match offload(|| __file_write(fd, data)) {
            Result.Ok(n) => Result.Ok(n),
            Result.Err(_) => {
                let code = __file_error()
                Result.Err(IoError.Write {
                    path: self.path.clone(),
                    kind: io_error_kind(code),
                    os_code: io_error_code(code),
                })
            }
        }
    }

    /// Does nothing: a file handle writes through to the system, so there is no buffer to push out.
    fn flush(mut self): Result<(), IoError> {
        Result.Ok(())
    }
}

File: Seek {
    fn seek(mut self, from: SeekFrom): Result<u64, IoError> {
        let (offset, whence) = match from {
            SeekFrom.Start(n) => (n as i64, 0),
            SeekFrom.End(d) => (d, 2),
            SeekFrom.Current(d) => (d, 1),
        }
        let fd = self.fd
        match offload(|| __file_seek(fd, offset, whence)) {
            Result.Ok(position) => Result.Ok(position as u64),
            Result.Err(_) => Result.Err(IoError.Seek),
        }
    }
}

File: Drop {
    fn drop(mut self) {
        if self.fd >= 0 {
            let closed = __file_close(self.fd)
            match closed {
                Result.Ok(()) => {}
                Result.Err(_) => {}
            }
        }
    }
}

/// Reads the whole file at `path` as bytes. The buffer is sized from the file's metadata, so a file that does not
/// change while it is read is read into one allocation, with one byte of room for the read that sees its end.
///
/// ```
/// write("burdin-doc-read-bytes.txt", "hi".as_bytes()).unwrap()
/// let bytes = read("burdin-doc-read-bytes.txt").unwrap()
/// assert_eq(bytes.to_text(), Result.Ok(String.from("hi")))
/// remove_file("burdin-doc-read-bytes.txt").unwrap()
/// ```
fn read(path: str): Result<List<u8>, IoError> {
    let mut file = File.open(path)?
    // The size is only a hint: a file that grew since is read on, growing the buffer like `read_to_end`.
    let size = match metadata(path) {
        Result.Ok(info) if info.is_file() => info.size as usize,
        _ => 0,
    }
    let mut bytes = List<u8>.with_capacity(size + 1)
    loop {
        let room = bytes.capacity() - bytes.len()
        let n = file.read(mut bytes, if room > 0 { room } else { 65536 })?
        if n == 0 {
            return Result.Ok(bytes)
        }
    }
}

/// Writes `data` to `path`, creating the file when it is missing and replacing its contents when it exists.
///
/// ```
/// write("burdin-doc-write.txt", "hi".as_bytes()).unwrap()
/// assert_eq(read_to_string("burdin-doc-write.txt").unwrap(), String.from("hi"))
/// remove_file("burdin-doc-write.txt").unwrap()
/// ```
fn write(path: str, data: [u8]): Result<(), IoError> {
    let mut file = File.create(path)?
    file.write_all(data)
}

/// Appends `data` to `path`. The file is created when it is missing.
///
/// ```
/// write("burdin-doc-append.txt", "a".as_bytes()).unwrap()
/// append("burdin-doc-append.txt", "b".as_bytes()).unwrap()
/// assert_eq(read_to_string("burdin-doc-append.txt").unwrap(), String.from("ab"))
/// remove_file("burdin-doc-append.txt").unwrap()
/// ```
fn append(path: str, data: [u8]): Result<(), IoError> {
    let mut options = OpenOptions.new()
    options.write(true)
    options.append(true)
    options.create(true)
    let mut file = options.open(path)?
    file.write_all(data)
}

/// Copies every byte of `from` to `to`, creating or replacing `to`, and returns how many bytes it copied. The
/// destination's permissions are not copied; only the bytes are. The bytes go through one 64 KiB buffer, and the
/// whole copy runs as one `offload`, so a chunk costs its two system calls and no helper-thread round trip. It is `copy_file` rather than `copy` because the
/// reader/writer `copy` in `std.rw` already owns the unqualified name in the prelude.
///
/// ```
/// write("burdin-doc-copy-from.txt", "copy me".as_bytes()).unwrap()
/// let n = copy_file("burdin-doc-copy-from.txt", "burdin-doc-copy-to.txt").unwrap()
/// assert_eq(n, 7)
/// assert_eq(read_to_string("burdin-doc-copy-to.txt").unwrap(), String.from("copy me"))
/// remove_file("burdin-doc-copy-from.txt").unwrap()
/// remove_file("burdin-doc-copy-to.txt").unwrap()
/// ```
fn copy_file(from: str, to: str): Result<u64, IoError> {
    let source = File.open(from)?
    let destination = File.create(to)?
    let (sfd, dfd) = (source.fd, destination.fd)
    match offload(|| copy_fds(sfd, dfd)) {
        Result.Ok(total) => Result.Ok(total),
        Result.Err(CopyFailure.Read(code)) => Result.Err(IoError.Read {
            path: from.to_string(),
            kind: io_error_kind(code),
            os_code: io_error_code(code),
        }),
        Result.Err(CopyFailure.Write(code)) => Result.Err(IoError.Write {
            path: to.to_string(),
            kind: io_error_kind(code),
            os_code: io_error_code(code),
        }),
        Result.Err(CopyFailure.WriteZero) => Result.Err(IoError.WriteZero),
    }
}

/// Why `copy_fds` stopped: the failing side and the code `__file_error` reported, or a write that took nothing.
priv enum CopyFailure {
    Read(i32)
    Write(i32)
    WriteZero
}

/// Copies the rest of the descriptor `from` into `to` through one buffer, calling the primitives directly: it runs
/// on a helper thread as one `offload` (`copy_file`).
priv fn copy_fds(from: i32, to: i32): Result<u64, CopyFailure> {
    let mut chunk = List<u8>.with_capacity(65536)
    let mut total: u64 = 0
    loop {
        chunk.clear()
        let n = match __file_read(from, mut chunk, 65536) {
            Result.Ok(n) => n,
            Result.Err(_) => return Result.Err(CopyFailure.Read(__file_error())),
        }
        if n == 0 {
            return Result.Ok(total)
        }
        let mut done: usize = 0
        while done < n {
            match __file_write(to, chunk[done..n]) {
                Result.Ok(0) => return Result.Err(CopyFailure.WriteZero),
                Result.Ok(k) => done = done + k,
                Result.Err(_) => return Result.Err(CopyFailure.Write(__file_error())),
            }
        }
        total = total + (n as u64)
    }
}

/// Whether something exists at `path` (`Path.exists`).
///
/// ```
/// assert(!exists("burdin-doc-exists.txt"))
/// write("burdin-doc-exists.txt", "x".as_bytes()).unwrap()
/// assert(exists("burdin-doc-exists.txt"))
/// remove_file("burdin-doc-exists.txt").unwrap()
/// ```
fn exists(path: str): bool {
    Path.new(path).exists()
}
