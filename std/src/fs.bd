// Directories, metadata, and walking (issue #411), and files and file handles (issue #702); `spec/stdlib.md`,
// "Directories, metadata, and walking" and "Files and file handles".
//
// The compiler's primitives (`__read_dir`, `__create_dir`, `__remove_dir`, `__remove_file`, `__rename`,
// `__metadata`, `__canonicalize`, and the `__file_*` handle operations) reach the operating system; the signatures,
// the error values, the recursive helpers, the glob matcher, and the file handle are Burdin. Every function is
// impure: a comptime evaluation that reaches one fails with E0224.

use fmt.{Debug, Formatter}
use path.Path
use reactor.__offload
use rw.{Read, Seek, SeekFrom, Write}
use sort.sort_by
use std.{IoError, IoErrorKind}
use text.to_char_list

/// The kind of entry a path names.
enum FileKind: Copy, Clone, Eq, Debug {
    File
    Dir
    Symlink
    Other
}

/// What the system reports about one path: the entry itself, without following a symbolic link.
struct Metadata: Clone, Copy, Eq, Debug {
    /// The size in bytes.
    size: u64
    /// The system's mode bits: the file kind and the permission bits, as `stat` reports them.
    mode: u32
    /// The modification time, in seconds since the Unix epoch.
    modified: i64
    /// The access time, in seconds since the Unix epoch.
    accessed: i64
    kind: FileKind
}

Metadata {
    /// Whether the entry is a regular file.
    fn is_file(self): bool {
        self.kind == FileKind.File
    }

    /// Whether the entry is a directory.
    fn is_dir(self): bool {
        self.kind == FileKind.Dir
    }

    /// Whether the entry is a symbolic link.
    fn is_symlink(self): bool {
        self.kind == FileKind.Symlink
    }
}

/// The names of the entries in the directory `path`, in the order the system returns them, without `.` and `..`.
/// Sort the list for a deterministic order. The names are not paths; join them with `Path.join`.
fn read_dir(path: str): Result<List<String>, IoError> {
    match __offload(|| __read_dir(path)) {
        Ok(names) => Ok(names),
        Err(code) => Err(IoError.Read {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Some(code),
        }),
    }
}

/// Creates one directory. The parent must exist, and an existing directory is an error (`create_dir_all` treats
/// an existing directory as success).
fn create_dir(path: str): Result<(), IoError> {
    match __offload(|| __create_dir(path)) {
        Ok(_) => Ok(()),
        Err(code) => Err(IoError.Write {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Some(code),
        }),
    }
}

/// Creates `path` and every missing parent. An existing directory is success; a path that exists as a file is an
/// error.
fn create_dir_all(path: str): Result<(), IoError> {
    match create_dir(path) {
        Ok(()) => Ok(()),
        Err(failure) => {
            match metadata(path) {
                Ok(info) if info.is_dir() => return Ok(()),
                _ => {}
            }
            match Path.new(path).parent() {
                Some(parent) if parent.as_str().len() > 0 => {
                    create_dir_all(parent.as_str())?;
                    create_dir(path)
                }
                _ => Err(failure),
            }
        }
    }
}

/// Removes an empty directory. A non-empty directory is an error; `remove_dir_all` removes it with its contents.
fn remove_dir(path: str): Result<(), IoError> {
    match __offload(|| __remove_dir(path)) {
        Ok(_) => Ok(()),
        Err(code) => Err(IoError.Write {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Some(code),
        }),
    }
}

/// Removes a file or a symbolic link. A directory is an error; `remove_dir_all` removes a directory.
fn remove_file(path: str): Result<(), IoError> {
    match __offload(|| __remove_file(path)) {
        Ok(_) => Ok(()),
        Err(code) => Err(IoError.Write {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Some(code),
        }),
    }
}

/// Removes a directory and everything under it. A symbolic link is removed as a link, never followed.
fn remove_dir_all(path: str): Result<(), IoError> {
    let info = match metadata(path) {
        Ok(info) => info,
        Err(failure) => return Err(failure),
    }
    if !info.is_dir() {
        // `std` sees the kind itself here; no system call failed.
        return Err(IoError.Write { path: path.to_string(), kind: IoErrorKind.NotADirectory, os_code: None })
    }
    __remove_entry(path)
}

/// Removes one entry: a file, a link, an empty directory, or a non-empty directory with its contents. Trying the
/// two removals first keeps a link a link: `remove_dir` then `remove_file` succeed for it before any listing, so
/// its target is never walked.
priv fn __remove_entry(path: str): Result<(), IoError> {
    if remove_dir(path).is_ok() {
        return Ok(())
    }
    if remove_file(path).is_ok() {
        return Ok(())
    }
    // Both removals failed. A link that could not be removed is an error rather than a directory to walk.
    let info = match metadata(path) {
        Ok(info) => info,
        Err(failure) => return Err(failure),
    }
    if info.is_symlink() {
        return Err(IoError.Write { path: path.to_string(), kind: IoErrorKind.Other, os_code: None })
    }
    let names = match read_dir(path) {
        Ok(names) => names,
        Err(failure) => return Err(failure),
    }
    for name in names {
        let child = Path.new(path).join(name.as_str())
        __remove_entry(child.as_str())?
    }
    remove_dir(path)
}

/// Renames a file or a directory, replacing an existing `to`. The error names `to`.
fn rename(from: str, to: str): Result<(), IoError> {
    match __offload(|| __rename(from, to)) {
        Ok(_) => Ok(()),
        Err(code) => Err(IoError.Write {
            path: to.to_string(),
            kind: __io_kind(code),
            os_code: Some(code),
        }),
    }
}

/// What the system reports about `path`. The entry itself is read (`lstat` on Unix), so a symbolic link reports
/// its own kind; on Windows the CRT's `_stat64` follows a link, so its size and times may describe the target.
fn metadata(path: str): Result<Metadata, IoError> {
    match __offload(|| __metadata(path)) {
        Ok((size, mode, modified, accessed, flags)) => Ok(Metadata {
            size,
            mode: mode as u32,
            modified,
            accessed,
            kind: __file_kind(flags),
        }),
        Err(code) => Err(IoError.Read {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Some(code),
        }),
    }
}

priv fn __file_kind(flags: u64): FileKind {
    if flags & 4 != 0 {
        FileKind.Symlink
    } else if flags & 2 != 0 {
        FileKind.Dir
    } else if flags & 1 != 0 {
        FileKind.File
    } else {
        FileKind.Other
    }
}

/// The absolute path that names `path`, with `.` and `..` resolved and the system's separators. The path must
/// exist. On Unix this is `realpath`, which also resolves symbolic links; on Windows it is `_fullpath`, which
/// only normalizes the text and keeps a link's name.
fn canonicalize(path: str): Result<String, IoError> {
    match __offload(|| __canonicalize(path)) {
        Ok(text) => Ok(text),
        Err(code) => Err(IoError.Read {
            path: path.to_string(),
            kind: __io_kind(code),
            os_code: Some(code),
        }),
    }
}

/// Every file and directory under `root`, recursively, as a path relative to `root` with the system's separator.
/// `root` itself is not included, a symbolic link is listed but not followed, and the result is sorted. A
/// directory that cannot be read makes the whole walk fail.
fn walk(root: str): Result<List<String>, IoError> {
    let mut out = List<String>.new()
    match __walk(root, "", mut out) {
        Ok(()) => {}
        Err(failure) => return Err(failure),
    }
    out.sort_by(|a, b| a.cmp(*b))
    Ok(out)
}

/// The entries under `root` whose relative path matches `pattern`, recursively, sorted as `walk` sorts them.
/// `*` matches any run of characters inside one path segment, `?` matches one character inside a segment, and
/// `**` matches across segments; a `**` followed by a separator also matches no segment at all, so `**/*.bd`
/// finds a file at the top level too. Both `/` and `\` are separators in a pattern.
fn walk_glob(root: str, pattern: str): Result<List<String>, IoError> {
    let all = walk(root)?
    let pat = pattern.to_char_list()
    let mut out = List<String>.new()
    for rel in all {
        if __glob_match(pat, 0, rel.to_char_list(), 0) {
            out.push(rel.clone())
        }
    }
    Ok(out)
}

priv fn __walk(root: str, prefix: str, mut out: List<String>): Result<(), IoError> {
    let dir = if prefix.len() == 0 {
        root.to_string()
    } else {
        Path.new(root).join(prefix).as_str().to_string()
    }
    let names = match read_dir(dir.as_str()) {
        Ok(names) => names,
        Err(failure) => return Err(failure),
    }
    for name in names {
        let rel = if prefix.len() == 0 {
            name.clone()
        } else {
            let mut rel = String.from(prefix)
            rel.push(Path.new(root).separator())
            rel.push_str(name.as_str())
            rel
        }
        let full = Path.new(root).join(rel.as_str())
        let info = match metadata(full.as_str()) {
            Ok(info) => info,
            Err(failure) => return Err(failure),
        }
        out.push(rel.clone())
        if info.is_dir() && !info.is_symlink() {
            __walk(root, rel.as_str(), mut out)?
        }
    }
    Ok(())
}

priv fn __glob_sep(c: char): bool {
    c == '/' || c == '\\'
}

/// Whether `text[ti..]` matches `pattern[pi..]`, with `*`, `?`, and `**` as `walk_glob` describes.
priv fn __glob_match(pattern: List<char>, pi: usize, text: List<char>, ti: usize): bool {
    if pi == pattern.len() {
        return ti == text.len()
    }
    let pc = pattern[pi]
    if pc == '*' {
        if pi + 1 < pattern.len() && pattern[pi + 1] == '*' {
            // `**/` matches zero path segments: try the rest of the pattern at the same position.
            if pi + 2 < pattern.len() && __glob_sep(pattern[pi + 2]) {
                if __glob_match(pattern, pi + 3, text, ti) {
                    return true
                }
            }
            let mut k = ti
            loop {
                if __glob_match(pattern, pi + 2, text, k) {
                    return true
                }
                if k == text.len() {
                    return false
                }
                k = k + 1
            }
        }
        let mut k = ti
        loop {
            if __glob_match(pattern, pi + 1, text, k) {
                return true
            }
            if k == text.len() || __glob_sep(text[k]) {
                return false
            }
            k = k + 1
        }
    }
    if ti == text.len() {
        return false
    }
    if pc == '?' {
        return !__glob_sep(text[ti]) && __glob_match(pattern, pi + 1, text, ti + 1)
    }
    if __glob_sep(pc) {
        return __glob_sep(text[ti]) && __glob_match(pattern, pi + 1, text, ti + 1)
    }
    pc == text[ti] && __glob_match(pattern, pi + 1, text, ti + 1)
}

Path {
    /// The names in this directory (`read_dir`).
    fn read_dir(self): Result<List<String>, IoError> {
        read_dir(self.as_str())
    }

    /// This path's metadata (`metadata`).
    fn metadata(self): Result<Metadata, IoError> {
        metadata(self.as_str())
    }

    /// This path's absolute, normalized form (`canonicalize`).
    fn canonicalize(self): Result<String, IoError> {
        canonicalize(self.as_str())
    }

    /// Every entry under this path (`walk`).
    fn walk(self): Result<List<String>, IoError> {
        walk(self.as_str())
    }

    /// The entries under this path that match `pattern` (`walk_glob`).
    fn walk_glob(self, pattern: str): Result<List<String>, IoError> {
        walk_glob(self.as_str(), pattern)
    }
}

// ---- files and file handles (issue #702; spec/stdlib.md, "Files and file handles") ----

/// The kind of a file failure. The primitives report 0 when no system call gave a code, which is `Other`
/// (`spec/errors.md`, ERR10-ERR11).
priv fn __io_error_kind(code: i32): IoErrorKind {
    if code > 0 { __io_kind(code) } else { IoErrorKind.Other }
}

/// The OS code of a file failure, when the primitive reported one.
priv fn __io_error_code(code: i32): Option<i32> {
    if code > 0 { Some(code) } else { None }
}

/// The options that open a file. Every option starts off; `open` rejects a set with no access and the combinations
/// the systems disagree on (`IoError.InvalidInput`).
struct OpenOptions {
    priv read: bool
    priv write: bool
    priv append: bool
    priv truncate: bool
    priv create: bool
    priv create_new: bool
}

OpenOptions {
    /// No options: `open` reports `IoError.InvalidInput` until an access mode is set.
    fn new(): OpenOptions {
        OpenOptions { read: false, write: false, append: false, truncate: false, create: false, create_new: false }
    }

    /// Allows reading.
    fn read(mut self, on: bool) {
        self.read = on
    }

    /// Allows writing.
    fn write(mut self, on: bool) {
        self.write = on
    }

    /// Every write goes to the end of the file. A file opened only for appending is opened for writing.
    fn append(mut self, on: bool) {
        self.append = on
    }

    /// Empties an existing file when it is opened. Needs write or append access, and cannot be combined with
    /// append.
    fn truncate(mut self, on: bool) {
        self.truncate = on
    }

    /// Creates the file when it is missing.
    fn create(mut self, on: bool) {
        self.create = on
    }

    /// Creates the file when it is missing and fails when it exists. It implies `create`, so `create` need not be
    /// set too.
    fn create_new(mut self, on: bool) {
        self.create_new = on
    }

    /// Opens `path` with these options. A set with no access mode, `truncate` without write or append access, and
    /// `append` with `truncate` are `IoError.InvalidInput`. A failure of the system call is `IoError.Read` when the
    /// options only read, and `IoError.Write` otherwise.
    fn open(self, path: str): Result<File, IoError> {
        if !self.read && !self.write && !self.append {
            return Err(IoError.InvalidInput)
        }
        if self.truncate && !self.write && !self.append {
            return Err(IoError.InvalidInput)
        }
        if self.truncate && self.append {
            return Err(IoError.InvalidInput)
        }
        let read = self.read
        let write = self.write
        let append = self.append
        let truncate = self.truncate
        let create = self.create
        let create_new = self.create_new
        match __offload(|| __file_open(path, read, write, append, truncate, create, create_new)) {
            Ok(fd) => Ok(File { fd: fd, path: path.to_string() }),
            Err(_) => {
                let code = __file_error()
                let changes = self.write || self.append || self.truncate || self.create || self.create_new
                if changes {
                    Err(IoError.Write {
                        path: path.to_string(),
                        kind: __io_error_kind(code),
                        os_code: __io_error_code(code),
                    })
                } else {
                    Err(IoError.Read {
                        path: path.to_string(),
                        kind: __io_error_kind(code),
                        os_code: __io_error_code(code),
                    })
                }
            }
        }
    }
}

/// An open file. It reads and writes through the unbuffered system descriptor, so wrap it in a `BufReader` or a
/// `BufWriter` for many small operations. Dropping it closes it (`Drop`); `close` reports the error the drop would
/// discard. The bytes are never translated: on every system the file is binary.
struct File {
    priv fd: i32
    /// The path the handle was opened with, named by every error the handle reports.
    priv path: String
}

File {
    /// Opens `path` for reading.
    fn open(path: str): Result<File, IoError> {
        let mut options = OpenOptions.new()
        options.read(true)
        options.open(path)
    }

    /// Opens `path` for writing, creating it when it is missing and emptying it when it exists.
    fn create(path: str): Result<File, IoError> {
        let mut options = OpenOptions.new()
        options.write(true)
        options.create(true)
        options.truncate(true)
        options.open(path)
    }

    /// Makes the file's contents durable: `fsync` on Unix, `_commit` on Windows.
    fn sync_all(self): Result<(), IoError> {
        let fd = self.fd
        match __offload(|| __file_sync(fd)) {
            Ok(()) => Ok(()),
            Err(_) => {
                let code = __file_error()
                Err(IoError.Write {
                    path: self.path.clone(),
                    kind: __io_error_kind(code),
                    os_code: __io_error_code(code),
                })
            }
        }
    }

    /// Sets the file's length. The bytes past `size` are removed, and a shorter file is extended with zero bytes.
    fn set_len(mut self, size: u64): Result<(), IoError> {
        let fd = self.fd
        match __offload(|| __file_set_len(fd, size)) {
            Ok(()) => Ok(()),
            Err(_) => {
                let code = __file_error()
                Err(IoError.Write {
                    path: self.path.clone(),
                    kind: __io_error_kind(code),
                    os_code: __io_error_code(code),
                })
            }
        }
    }

    /// Closes the file and reports a failure that `Drop` would discard. The handle is moved, so it cannot be used
    /// again. The rebinding marks the descriptor closed, so the drop that follows does not close it a second time
    /// (a second close is an invalid descriptor, which the Windows CRT treats as a fatal parameter error).
    fn close(own self): Result<(), IoError> {
        let mut me = self
        let fd = me.fd
        me.fd = -1
        match __file_close(fd) {
            Ok(()) => Ok(()),
            Err(_) => {
                let code = __file_error()
                Err(IoError.Write {
                    path: me.path.clone(),
                    kind: __io_error_kind(code),
                    os_code: __io_error_code(code),
                })
            }
        }
    }
}

File: Read {
    fn read(mut self, mut buf: List<u8>, max: usize): Result<usize, IoError> {
        let fd = self.fd
        let buf_ptr = unsafe { (&mut buf) as CPtr<List<u8>> }
        match unsafe {
            __offload(|| unsafe {
                __file_read(fd, mut *buf_ptr, max)
            })
        } {
            Ok(n) => Ok(n),
            Err(_) => {
                let code = __file_error()
                Err(IoError.Read {
                    path: self.path.clone(),
                    kind: __io_error_kind(code),
                    os_code: __io_error_code(code),
                })
            }
        }
    }
}

File: Write {
    fn write(mut self, data: [u8]): Result<usize, IoError> {
        let fd = self.fd
        match __offload(|| __file_write(fd, data)) {
            Ok(n) => Ok(n),
            Err(_) => {
                let code = __file_error()
                Err(IoError.Write {
                    path: self.path.clone(),
                    kind: __io_error_kind(code),
                    os_code: __io_error_code(code),
                })
            }
        }
    }

    /// Does nothing: a file handle writes through to the system, so there is no buffer to push out.
    fn flush(mut self): Result<(), IoError> {
        Ok(())
    }
}

File: Seek {
    fn seek(mut self, from: SeekFrom): Result<u64, IoError> {
        let (offset, whence) = match from {
            SeekFrom.Start(n) => (n as i64, 0),
            SeekFrom.End(d) => (d, 2),
            SeekFrom.Current(d) => (d, 1),
        }
        let fd = self.fd
        match __offload(|| __file_seek(fd, offset, whence)) {
            Ok(position) => Ok(position as u64),
            Err(_) => Err(IoError.Seek),
        }
    }
}

File: Drop {
    fn drop(mut self) {
        if self.fd >= 0 {
            let closed = __file_close(self.fd)
            match closed {
                Ok(()) => {}
                Err(_) => {}
            }
        }
    }
}

/// Reads the whole file at `path` as bytes.
fn read(path: str): Result<List<u8>, IoError> {
    let mut file = File.open(path)?
    let mut bytes = List<u8>.new()
    file.read_to_end(mut bytes)?
    Ok(bytes)
}

/// Writes `data` to `path`, creating the file when it is missing and replacing its contents when it exists.
fn write(path: str, data: [u8]): Result<(), IoError> {
    let mut file = File.create(path)?
    file.write_all(data)
}

/// Appends `data` to `path`. The file is created when it is missing.
fn append(path: str, data: [u8]): Result<(), IoError> {
    let mut options = OpenOptions.new()
    options.write(true)
    options.append(true)
    options.create(true)
    let mut file = options.open(path)?
    file.write_all(data)
}

/// Copies every byte of `from` to `to`, creating or replacing `to`, and returns how many bytes it copied. The
/// destination's permissions are not copied; only the bytes are. It is `copy_file` rather than `copy` because the
/// reader/writer `copy` in `std.rw` already owns the unqualified name in the prelude.
fn copy_file(from: str, to: str): Result<u64, IoError> {
    let mut source = File.open(from)?
    let mut destination = File.create(to)?
    let mut chunk = List<u8>.new()
    let mut total: u64 = 0
    loop {
        chunk.clear()
        let n = source.read(mut chunk, 65536)?
        if n == 0 {
            return Ok(total)
        }
        destination.write_all(chunk[0..chunk.len()])?
        total = total + (n as u64)
    }
}

/// Whether something exists at `path` (`Path.exists`).
fn exists(path: str): bool {
    Path.new(path).exists()
}
